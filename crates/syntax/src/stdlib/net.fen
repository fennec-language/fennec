## `std.net`: the network, through the `Net` capability, which `main` names like `Fs`. Every
## call waits until it's done, with no `async`: a server gives each connection its own
## `parallel` task. `net.connect(host, port)` gives a `Connection` and `net.listen(port)` a
## `Server`, and `server.serve(respond)` answers HTTP with a function or a `Router`. Connecting
## gives up after 30 seconds unless `timeout=` says otherwise.
##
## `Connection`, `Server` and `UdpSocket` are `shared`: a second name for one is the same socket.
## Each manages its own sides, so it takes no lock. Each is lent by a `with`, `net.connect`,
## `net.listen`, `net.udp` or `server.accept`, and closed when its block ends.
##
## In a test, `Net` is a fake that never touches the network: the test's own servers are at
## `localhost`, and its clients reach them in memory. Nothing else runs while a test waits, so a
## test's server is done once no connection is waiting.

from std import json
from std.crypto import Secret
from std.intrinsics import stop, text_byte, text_part, text_same_at, text_size
from std.url import decode_query, unquote

## A failure of the network, with a case for each way it fails. `message()` says it in words.
export error NetError:
    ## No host has that name.
    NotFound(host: str)
    ## The host is there, but nothing listens on that port.
    Refused(host: str, port: int)
    ## Nothing came in time.
    TimedOut(after: Duration)
    ## The other side hung up while this side wrote, or the connection was closed already.
    Closed
    ## A narrowed `Net` doesn't reach that host or port.
    Denied(reason: str)
    ## TLS failed: a certificate didn't check out, or the handshake broke off.
    Tls(reason: str)
    ## A response's status, for callers that turn one into an error. The client never fails
    ## with it.
    Status(code: int)
    ## Any other failure, said in words.
    Other(reason: str)

    ## What went wrong, in words.
    def message(self) -> str:
        match self:
            case .NotFound(host):
                return f"there's no host called `{host}`"
            case .Refused(host, port):
                return f"`{host}` refused a connection on port {port}"
            case .TimedOut(after):
                return f"gave up after {after.as_seconds()}s"
            case .Closed:
                return "the other side closed the connection"
            case Denied(reason) | Tls(reason) | Other(reason):
                return reason
            case .Status(code):
                return f"the response's status was {code}"

## What a server answered. A 404 is an answer like any other, so `ok()` says which it was. Its
## `text()`, written in Rust, gives the body as text, with anything that isn't text replaced.
export struct Response:
    status: int
    ## By their names in lower case. A header sent twice has its values joined with `, `, as HTTP
    ## says they can be.
    headers = dict[str, str]()
    body = bytes([])
    ## Each `Set-Cookie` header's value, in order: the one header whose values can't be joined.
    set_cookies = list[str]()

    ## A 404, for a path nothing's at, or a route's parameter its handler doesn't take.
    def not_found() -> Response:
        return NOT_FOUND

    ## Whether the status is one of the 200s.
    def ok(self) -> bool:
        return self.status >= 200 and self.status < 300

    ## The body read as JSON into a `T`, as `json.loads[T]` reads text: what an API sent back.
    ## Text that isn't JSON, or doesn't fit `T`, fails with a `ParseError` saying where.
    def json[T: Deserializable](self) -> T fails ParseError:
        return json.native_loads[T](self.text(), names=None, extra=None)?

## What a server shows to prove who it is: its certificate chain and its private key, as the text
## of their PEM files. The program reads those with its own `Fs`, so no file access is hidden in
## `std.net`, and the key is a `Secret`, so it can't be printed, logged or saved by accident.
##
## ```fennec
## from std.crypto import Secret
## from std.net import Certificate
##
## fs.write_text("cert.pem", "-----BEGIN CERTIFICATE-----")?
## fs.write_text("key.pem", "-----BEGIN PRIVATE KEY-----")?
## key = Secret.of(fs.read_text("key.pem")?)
## certificate = Certificate(chain=fs.read_text("cert.pem")?, key=key)
## assert certificate.chain.startswith("-----BEGIN CERTIFICATE")
## ```
export struct Certificate:
    chain: str
    key: Secret[str]

## One end of a TCP connection. Its methods, written in Rust: `read(n)` gives up to `n` bytes,
## or empty bytes once the other side is done; `read_line()` gives the next line without its
## ending, or `None` at the end; `write(data)` sends `bytes` or a `str`; and `close()`. Reads
## wait as long as it takes, unless given `timeout=`.
##
## Tasks writing to one connection at once each have their `write` arrive whole only when it
## goes out in one piece, as a line does, with room in the socket's buffer: bigger writes can
## cut into each other. To send many tasks' messages down one connection, as a chat hub fans out
## to its members, give the connection one writer task and have the others send it what to write.
export shared Connection:
    _handle: int
    ## Which of the program's connections it is, counted from 1 as they're made: what it prints as.
    _label: int
    ## The other side's address, like `"127.0.0.1:52811"`.
    peer: str

    ## `Connection(#3)`, its label, rather than its handle, which is random so that nothing could
    ## guess it, and so would print differently every run.
    def str(self, ref out: StrWriter):
        out.write(f"Connection(#{self._label})")

    ## Each line it's sent, until the other side is done. A failure of the connection fails the
    ## loop, rather than looking like the end.
    def lines(self) -> Iterator[str] fails NetError:
        while True:
            line = self.read_line()?
            if line is None: return
            yield line

    ## This connection as a `Writer`, from `std.io`, for code written for any stream. A failure
    ## of the network comes through as an `IoError`, with the network's own words in a note.
    def writer(self) -> ConnectionWriter:
        return ConnectionWriter(_conn=self)

    ## This connection as a `Reader`, from `std.io`, buffered as the connection is.
    def reader(self) -> ConnectionReader:
        return ConnectionReader(_conn=self)

## A connection as a `Writer`, from `conn.writer()`. Each write is sent at once, so `flush` has
## nothing to do.
export struct ConnectionWriter:
    _conn: Connection

    def write(self, data: bytes) fails IoError:
        self._conn.write(data) except why:
            fail io_failure(why)

    def write_text(self, text: str) fails IoError:
        self._conn.write(text) except why:
            fail io_failure(why)

    def write_line(self, text: str) fails IoError:
        self._conn.write(text + "\n") except why:
            fail io_failure(why)

    def flush(self) fails IoError:
        pass

## A connection as a `Reader`, from `conn.reader()`.
export struct ConnectionReader:
    _conn: Connection

    def read_chunk(self, size: int) -> bytes fails IoError:
        return self._conn.read(size) except why:
            fail io_failure(why)

    def read_line(self) -> str? fails IoError:
        return self._conn.read_line() except why:
            fail io_failure(why)

    def lines(self) -> Iterator[str] fails IoError:
        while True:
            line = self.read_line()?
            if line is None: return
            yield line

## A failure of the network as the `IoError` a stream fails with, keeping what the network said.
def io_failure(why: NetError) -> IoError:
    mut failure = IoError.Other(reason=why.message())
    failure.add_note(f"the network failed: {why.message()}")
    return failure

## One datagram, and the address it came from, like `"127.0.0.1:52811"`, which `send_to` answers.
export struct Packet:
    data: bytes
    sender: str

## A UDP port. Looping over it gives each packet as it arrives. Its methods, written in Rust:
## `receive()` gives the next `Packet`, waiting as long as it takes unless given `timeout=`;
## `send_to(data, address)` sends `bytes` or a `str` to an address like `"127.0.0.1:9001"`; and
## `close()`.
export shared UdpSocket:
    _handle: int
    ## Which of the program's UDP sockets it is, counted from 1: what it prints as.
    _label: int
    ## The port it listens on: the one asked for, or the one the system picked for port 0.
    port: int

    ## `UdpSocket(#1)`, its label, rather than its random handle.
    def str(self, ref out: StrWriter):
        out.write(f"UdpSocket(#{self._label})")

    ## Each packet as it arrives, until the socket is closed or fails.
    def iter(self) -> Iterator[Packet]:
        while True:
            packet = self.receive() except .NotFound() | .Refused() | .TimedOut(
            ) | .Closed | .Denied() | .Tls() | .Status() | .Other(): None
            if packet is None: return
            yield packet

## The network, given to `main` or a test, as `Fs` is. Its methods written in Rust are `get`,
## `post` and `request`, and a test's `script` and `requests`. Only `main` and tests are given
## one: it can't be made.
export struct Net:
    _given: int

    ## A connection to `host` on `port`, lent for a `with` block and closed when it ends:
    ## `with net.connect("example.com", 443, tls=True)? as conn:`. With `tls=True` it's TLS, its
    ## certificate checked against what the system trusts and `host`. Connecting gives up after
    ## `timeout`.
    def connect(
        self,
        host: str,
        port: int,
        tls = False,
        timeout = 30s,
    ) -> with Connection fails NetError:
        conn = self._connect(host, port, tls=tls, timeout=timeout)?
        lend conn except:
            conn.close()
        conn.close()

    ## A server listening on `port`, or on a port the system picks for 0, lent for a `with` block
    ## and closed when it ends. With `tls=`, each connection is TLS, shown by that certificate.
    ## Connections wait for the server to take them in a queue as long as the system allows:
    ## 4,096 by default on Linux, where connections past it wait, and may time out, until there's
    ## room, but 128 on macOS, where they're reset. `sudo sysctl kern.ipc.somaxconn=4096` raises
    ## the Mac's.
    def listen(self, port: int, tls: Certificate? = None) -> with Server fails NetError:
        server = listened(self, port=port, tls=tls)?
        lend server except:
            server.close()
        server.close()

    ## A UDP socket on `port`, or on a port the system picks for 0, lent for a `with` block and
    ## closed when it ends.
    def udp(self, port = 0) -> with UdpSocket fails NetError:
        socket = self._udp(port=port)?
        lend socket except:
            socket.close()
        socket.close()

## A TCP port being listened on. Looping over it gives each connection as it arrives, and
## `accept()` waits for the next one.
export shared Server:
    _handle: int
    ## Which of the program's servers it is, counted from 1: what it prints as.
    _label: int
    ## The port it listens on: the one asked for, or the one the system picked for port 0.
    port: int

    ## `Server(#1)`, its label, rather than its random handle.
    def str(self, ref out: StrWriter):
        out.write(f"Server(#{self._label})")

    ## The next connection, lent for a `with` block and closed when it ends. It waits for one as
    ## long as it takes, or up to `timeout`.
    def accept(self, timeout: Duration? = None) -> with Connection fails NetError:
        conn = accepted(self, timeout=timeout)?
        lend conn except:
            conn.close()
        conn.close()

    ## Each connection as it arrives, until the server is closed or fails. Each is closed when the
    ## loop goes on to the next.
    def iter(self) -> Iterator[Connection]:
        while True:
            conn = accepted(self, timeout=None) except .NotFound() | .Refused() | .TimedOut(
            ) | .Closed | .Denied() | .Tls() | .Status() | .Other(): return
            yield conn
            conn.close()

    ## Has the server drain when the program's asked to stop, by SIGTERM or Ctrl-C say: it takes no
    ## more connections, and a connection waiting for its next message ends, while one partway
    ## through a message goes on. Those still running after `grace` are cut short. The loop over the
    ## server then ends, and the program goes on past it.
    def stop_on(self, signals: Signals, grace = 20s):
        _ = signals
        self._stop_on(grace)

    ## Answers HTTP/1.1 with `respond`, a function or a `Router`, each connection its own task,
    ## until the server is closed. A connection is kept open for more requests unless either side
    ## says to close it. Each request, head and body, has to come whole within `timeout`, however
    ## steadily its bytes come, or the connection's closed: a client sending a byte at a time can't
    ## hold it open for longer. So a server taking big uploads over slow links gives a longer
    ## `timeout`. A request that's too big, or isn't HTTP, is answered with the 4xx status that
    ## says so, without calling `respond`. Given `until=signals`, it stops when the program's asked
    ## to, as `stop_on` says: requests being answered are finished, within `grace`, and then it
    ## returns.
    def serve(
        self,
        respond: Router | (Request) -> Response,
        timeout = 30s,
        until: Signals? = None,
        grace = 20s,
    ):
        if until is not None:
            self.stop_on(until, grace=grace)
        answer = answerer(respond)
        for connection in parallel(self):
            _ = answer_all(connection, answer, timeout)

## The function `serve` answers each request with: the one it was given, or its router's.
def answerer(respond: Router | (Request) -> Response) -> (Request) -> Response:
    if respond is Router:
        router = respond
        return (request) => router.respond(request)
    return respond

## An HTTP request a server was sent: its method, like `"GET"`, its path without the query, the
## query's parameters, its headers by their names in lower case, and its body. `raw_path` is the
## path as it was sent, its percent-escapes still in it, which a `Router` matches against, so an
## escaped `/` in a parameter stays in that parameter. It's empty in a request made by hand, and
## then the router matches `path`.
export struct Request:
    method: str
    path: str
    query = dict[str, str]()
    headers = dict[str, str]()
    body = bytes([])
    raw_path = ""

    ## The body as text, or empty text when it isn't UTF-8.
    def text(self) -> str:
        return self.body.decode() except InvalidValue(): ""

## The most parameters a route can have, as `{id}` in `/notes/{id}`.
MOST_ROUTE_PARAMETERS = 8

## Where a route's parameters are in a request's path, for its handler to read. A `Router` makes
## one for each request it routes, holding only places in the path, so nothing is decoded or
## parsed until a handler asks for it.
export struct Captured:
    _path: str
    _starts: array[int, 8]
    _ends: array[int, 8]

    ## The parameters at `starts` up to `ends` in `path`, in the order the route names them.
    def of(path: str, starts: array[int, 8], ends: array[int, 8]) -> Captured:
        return Captured(_path=path, _starts=starts, _ends=ends)

    ## Parameter `at`, its percent-escapes decoded as a request's path's are.
    def text_at(self, at: int) -> str:
        start = self._starts[at]
        end = self._ends[at]
        mut place = start
        while place < end:
            # A `%` starts an escape, and only then is there anything to decode.
            if text_byte(self._path, place) == 37: return unquote(text_part(self._path, start, end))
            place += 1
        return text_part(self._path, start, end)

## A route's handler as a `Router` keeps it, given the route's parameters as `Captured`. One that
## doesn't take what a parameter holds, like `abc` for an `int`, gives `Response.not_found()`.
export type Routed = (Request, Captured) -> Response

## One place in a router's tree: the segments that can follow it, by their text, the parameter that
## can, and what answers each method there.
struct RouteNode:
    statics = list[str]()
    children = list[int]()
    parameter = -1
    methods = list[str]()
    handlers = list[Routed]()
    ## The 405 for a method this place doesn't take, made as each route is added.
    refused = Response(status=405)

## The 404 a router answers a path no route has with, made once.
NOT_FOUND = Response(status=404, body="there's nothing here".encode())

## Sends each request to the handler of the route its method and path match:
##
## ```fennec
## from std.net import Request, Response, Router
##
## mut router = Router()
## router.handle(
##     "GET /notes/{id}",
##     (request, found) => Response(status=200, body=f"{request.method} {found.text_at(0)}".encode()),
## )
## answer = router.respond(Request(method="GET", path="/notes/7"))
## assert answer.status == 200 and answer.text() == "GET 7"
## assert router.respond(Request(method="GET", path="/elsewhere")).status == 404
## ```
##
## `server.serve(router)` answers each request a server gets with it.
##
## A route's `{name}` matches one segment of the path. `router.get(path, handler)`, and `post`,
## `put`, `patch` and `delete`, add a route checked where it's written: the handler takes each
## parameter by name, as a `str`, an `int` or a sized int, and a segment that doesn't read as its
## type, like `abc` for an `int`, answers 404, as a path no route has. A path a route has with a
## method it doesn't take is a 405, saying the ones it takes in `Allow`, and a `HEAD` is answered
## by a route's `GET` when it has no `HEAD`. A segment written out matches before a parameter does, and a `/` at a path's end is
## passed over. Routes go into a tree as they're added, so finding one walks the path once.
export struct Router:
    _nodes = [RouteNode()]

    ## Answers a route with `handler`, which takes the route's parameters as `Captured`. The route
    ## is its method and its path, as in `"GET /notes/{id}"`: the path is `/` and its segments,
    ## each written out or a `{name}` that matches any one.
    def handle(ref self, route: str, handler: Routed):
        space = route.find(" ") else -1
        if space < 0:
            stop(f"the route `{route}` needs its method first, as in `GET /`")
            return
        method = route[:space]
        path = route[space + 1:]
        mut node = 0
        mut parameters = 0
        for segment in path.split("/"):
            if segment == "": continue
            if segment.startswith("{") and segment.endswith("}"):
                parameters += 1
                if parameters > MOST_ROUTE_PARAMETERS:
                    stop(f"the route `{path}` has more than {MOST_ROUTE_PARAMETERS} parameters")
                if self._nodes[node].parameter < 0:
                    self._nodes.append(RouteNode())
                    self._nodes[node].parameter = len(self._nodes) - 1
                node = self._nodes[node].parameter
                continue
            mut child = -1
            for at, written in enumerate(self._nodes[node].statics):
                if written == segment:
                    child = self._nodes[node].children[at]
            if child < 0:
                self._nodes.append(RouteNode())
                child = len(self._nodes) - 1
                self._nodes[node].statics.append(segment)
                self._nodes[node].children.append(child)
            node = child
        if method in self._nodes[node].methods:
            stop(f"`{route}` is routed twice")
        self._nodes[node].methods.append(method)
        self._nodes[node].handlers.append(handler)
        allowed = ", ".join(sorted(self._nodes[node].methods))
        self._nodes[node].refused = Response(
            status=405,
            headers={"allow": allowed},
            body=f"this takes {allowed}".encode(),
        )

    ## The node a static segment from `start` up to `end` of `path` leads to from `node`, or -1.
    def _static(self, node: int, path: str, start: int, end: int) -> int:
        for at in range(len(self._nodes[node].statics)):
            written = self._nodes[node].statics[at]
            if text_size(written) == end - start and text_same_at(path, start, written):
                return self._nodes[node].children[at]
        return -1

    ## The response to `request`: its route's handler's, a 404 for a path no route has or a
    ## parameter its handler doesn't take, or a 405 for a method its path doesn't take.
    def respond(self, request: Request) -> Response:
        path = request.raw_path if request.raw_path != "" else request.path
        size = text_size(path)
        mut node = 0
        mut starts = array[int, 8]()
        mut ends = array[int, 8]()
        mut found = 0
        mut at = 0
        while at < size:
            if text_byte(path, at) != 47: return Response.not_found()
            start = at + 1
            mut end = start
            while end < size and text_byte(path, end) != 47:
                end += 1
            if end == start and end == size:
                # The path's last `/`, after a segment or alone, as in `/`.
                break
            next = self._static(node, path=path, start=start, end=end)
            if next >= 0:
                node = next
            elif self._nodes[node].parameter >= 0 and end > start and found < MOST_ROUTE_PARAMETERS:
                starts[found] = start
                ends[found] = end
                found += 1
                node = self._nodes[node].parameter
            else:
                return Response.not_found()
            at = end
        if len(self._nodes[node].methods) == 0: return Response.not_found()
        mut asked = request.method
        if asked == "HEAD" and "HEAD" not in self._nodes[node].methods:
            asked = "GET"
        for place in range(len(self._nodes[node].methods)):
            if self._nodes[node].methods[place] == asked:
                handler = self._nodes[node].handlers[place]
                return handler(request, Captured.of(path, starts=starts, ends=ends))
        return self._nodes[node].refused

## The most a request's headers may hold, in lines and in bytes, and the most its body may be.
MOST_HEADERS = 100
MOST_HEADER_BYTES = 16384
MOST_BODY = 10485760

## The most blank lines passed over before a request line.
MOST_BLANK_LINES = 8

## What a request's head held, as `read_head` read it, or why it held none.
enum Head:
    ## The request line, then each header line, without their endings.
    Lines(lines: list[str])
    ## The stream ended, or held only blank lines, before a request line came.
    Ended
    ## The stream ended after the request line, before the blank line that ends a head.
    Unended
    ## The request line alone was over the most bytes a head may hold.
    LongFirst
    ## The head was over the most bytes in all, or had over the most header lines.
    TooBig

## A request's head read from `connection` in one call: its request line, past up to `most_blank`
## blank lines before it, then each header line up to the blank one, within `most_bytes` in all
## and `most_lines` header lines. Each line is read as `read_line(timeout=, crlf=True)` reads one,
## and what follows the head is left for its body and the next request.
def read_head(
    connection: Connection,
    most_bytes: int,
    most_lines: int,
    most_blank: int,
    timeout: Duration,
) -> Head fails NetError:
    return connection._read_head(most_bytes, most_lines, most_blank, timeout=timeout)?

## What reading a request gave: one to answer, one the server answers itself, or the end.
enum RequestRead:
    Got(request: Request, keep: bool)
    Bad(status: int, reason: str)
    Done

## Answers each request on a connection until it's closed or asks to be.
def answer_all(
    connection: Connection,
    respond: (Request) -> Response,
    timeout: Duration,
) fails NetError:
    while True:
        match next_request(connection, timeout)?:
            case .Got(request, keep):
                # A server draining answers this request, then closes.
                still = keep and not connection.draining()
                write_response(connection, respond(request), still, request.method == "HEAD")?
                if not still:
                    connection.close()
                    return
            case .Bad(status, reason):
                write_response(
                    connection,
                    Response(status=status, body=reason.encode()),
                    False,
                    False,
                )?
                connection.close()
                return
            case .Done:
                connection.close()
                return

## What reading a request's body came to: the body, or the status and reason to refuse it with.
enum BodyRead:
    Read(body: bytes)
    Refused(status: int, reason: str)

## A request's body, as long as its `content-length`, `written`, says. It's read whole into room
## made once at its size, after taking its share of the room every server's bodies have: past
## 256 MiB held at once it's refused unread, so many clients each sending a big body at once can't
## take the program's memory.
def read_body(connection: Connection, written: str, timeout: Duration) -> BodyRead fails NetError:
    if not only_digits(written):
        return .Refused(status=400, reason="the content length isn't a number")
    length = int(written) except InvalidValue(): return .Refused(
        status=400,
        reason="the content length isn't a number",
    )
    if length > MOST_BODY: return .Refused(status=413, reason="the body is too big")
    if not connection._room_for_body(length):
        return .Refused(
            status=503,
            reason="the server is reading as many bodies as it holds at once: try again",
        )
    body = connection._body(length, timeout=timeout)?
    if len(body) < length: return .Refused(status=400, reason="the body ended early")
    return .Read(body=body)

## The runtime's words for a line ended by a bare line feed, which it won't read.
BARE_LINE_FEED = "a line ended without a carriage return"

## What a request line longer than a whole head may be is refused with: a 414, as HTTP/1.1 has a
## server answer a target longer than it takes.
LONG_REQUEST_LINE = "the request line is too long"

## The next request, its head read in one call with its limits, and a line ended by a bare line
## feed answered with a 400 rather than dropped: a proxy that takes one and a server that doesn't
## would read where a request ends differently. A request line longer than a whole head gets
## a 414, and a head too big in all a 431, before either is taken apart.
def next_request(connection: Connection, timeout: Duration) -> RequestRead fails NetError:
    # The whole request, its head and body, has to come within `timeout`, not each read of it, so
    # a client sending a byte at a time can't hold the connection for longer than that.
    connection._reads_within(timeout)
    head = read_head(
        connection,
        most_bytes=MOST_HEADER_BYTES,
        most_lines=MOST_HEADERS,
        most_blank=MOST_BLANK_LINES,
        timeout=timeout,
    ) except error:
        match error:
            case .Other(reason=reason):
                if reason == BARE_LINE_FEED:
                    return .Bad(status=400, reason="a line ended without a carriage return")
            case _:
                pass
        fail error
    return match head:
        case .Lines(lines=lines):
            read_request(connection, lines, timeout)?
        case .Ended:
            .Done
        case .Unended:
            .Bad(status=400, reason="the headers didn't end")
        case .LongFirst:
            .Bad(status=414, reason=LONG_REQUEST_LINE)
        case .TooBig:
            .Bad(status=431, reason="the headers are too big")

## The request whose head is `lines`, its request line and then its header lines, each within the
## head's limits already, read with its body.
def read_request(
    connection: Connection,
    lines: list[str],
    timeout: Duration,
) -> RequestRead fails NetError:
    start_line = request_line(lines[0]) else return .Bad(status=400, reason=NOT_A_REQUEST_LINE)
    mut target = start_line.target
    # A target is ASCII, as HTTP has it: a byte past 127 reaches the program as something a proxy
    # in front didn't see, once it's read as text.
    if not is_token(start_line.method) or target == "" or not is_plain_target(target):
        return .Bad(status=400, reason=NOT_A_REQUEST_LINE)
    # A target is a path, `*` for an `OPTIONS` of the server as a whole, or a whole `http` or
    # `https` URL, as a proxy sends one, whose host then stands for the `host` header, as HTTP/1.1
    # says. Anything else would reach the program as a path no one asked for.
    mut host: str? = None
    if not target.startswith("/") and not (target == "*" and start_line.method == "OPTIONS"):
        whole = whole_target(target) else return .Bad(
            status=400,
            reason="the target isn't a path or a URL",
        )
        target = whole.rest
        host = whole.host
    mut headers: dict[str, str] = {}
    # The headers that frame the request are kept as they're read, so none is looked up after.
    mut sent_length: str? = None
    mut coding: str? = None
    mut asked = ""
    for at in range(1, len(lines)):
        line = lines[at]
        colon = header_colon(line)
        if colon < 0: return .Bad(status=400, reason=header_fault(line))
        # The name and the value are read where they are in the line, each cut out once.
        name = lowered_part(line, colon)
        value = value_after(line, colon)
        # Two of these would let two servers read two different requests from the same bytes. Only
        # they're looked for before they're set, so any other header is looked up once.
        match name:
            case "content-length":
                if sent_length is not None: return twice(name)
                sent_length = value
            case "transfer-encoding":
                if coding is not None: return twice(name)
                coding = value
            case "host":
                if name in headers: return twice(name)
            case "connection":
                asked = value.lower()
            case _:
                pass
        headers[name] = value
    if coding is not None:
        # Both, or a coding that isn't plainly `chunked`, is where two servers in a row disagree on
        # where the body ends: one goes by the length and one by the chunks, and a request hides
        # in what's left.
        if sent_length is not None:
            return .Bad(status=400, reason="there's both a transfer-encoding and a content-length")
        if coding.lower() != "chunked":
            return .Bad(status=400, reason="the only transfer-encoding taken is `chunked`")
        return .Bad(status=501, reason="chunked bodies aren't taken yet")
    mut body = bytes([])
    if sent_length is not None:
        match read_body(connection, sent_length, timeout)?:
            case .Read(read):
                body = read
            case .Refused(status, reason):
                return .Bad(status=status, reason=reason)
    if host is not None:
        headers["host"] = host
    keep = asked != "close" if start_line.version == "HTTP/1.1" else asked == "keep-alive"
    mut path = target
    # Most targets have no query: they share one kept empty one, with no dict made for it.
    mut query = NO_QUERY
    at = target.find("?")
    if at is not None:
        path = target[:at]
        query = decode_query(target[at + 1:])
    decoded = unquote(path)
    # `%00` decodes to a NUL, which no path or query has a use for, and which a file name or C
    # code would take as where the text ends.
    if decoded.find("\x00") is not None: return .Bad(status=400, reason="the path holds a NUL byte")
    for name, value in query.items():
        if name.find("\x00") is not None or value.find("\x00") is not None:
            return .Bad(status=400, reason="the query holds a NUL byte")
    return .Got(
        request=Request(
            method=start_line.method,
            path=decoded,
            query=query,
            headers=headers,
            body=body,
            raw_path=path,
        ),
        keep=keep,
    )

## What a request line that isn't one is refused with.
NOT_A_REQUEST_LINE = "that isn't an HTTP/1.1 request line"

## A request line's three parts.
struct RequestLine:
    method: str
    target: str
    version: str

## The three parts of `line`, a request line, cut out where they are between its two spaces, with
## no list made of them. `None` when there's no space before the version, or the version isn't
## HTTP/1.1 or HTTP/1.0. The version is the line's last 8 bytes after a space, so the line is read
## only as far as its first space: a space in the target is refused with the target's other bytes,
## by `is_plain_target`.
def request_line(line: str) -> RequestLine?:
    size = text_size(line)
    target_end = size - 9
    first_space = next_space(line, 0)
    if first_space >= target_end or text_byte(line, target_end) != 32: return None
    version = text_part(line, target_end + 1, size)
    if version != "HTTP/1.1" and version != "HTTP/1.0": return None
    return RequestLine(
        method=text_part(line, 0, first_space),
        target=text_part(line, first_space + 1, target_end),
        version=version,
    )

## An empty query, kept for the run: what a request whose target has no `?` holds. A request
## that changes its query changes a copy of its own.
NO_QUERY: dict[str, str] = {}

## Where the first space in `text` at or after `start` is, or `text`'s size when there's none.
def next_space(text: str, start: int) -> int:
    size = text_size(text)
    for at in range(start, size):
        if text_byte(text, at) == 32: return at
    return size

## The refusal of a request with more than one header `name`, which is one of those that frame it.
def twice(name: str) -> RequestRead:
    return .Bad(status=400, reason=f"there's more than one `{name}` header")

## A request's target written as a whole URL: its host, and the rest from its path on.
struct WholeTarget:
    host: str
    rest: str

## The host of a whole `http` or `https` URL, and the rest from the `/` or `?` after it, which is
## `/` when there's none, or `None` when `target` isn't one. A user before the host is refused, as
## HTTP says it should be, since it could make the URL read as another host's.
def whole_target(target: str) -> WholeTarget?:
    lower = target.lower()
    mut start = 0
    if lower.startswith("http://"):
        start = 7
    elif lower.startswith("https://"):
        start = 8
    else:
        return None
    size = text_size(target)
    mut end = size
    for at in range(start, size):
        b = text_byte(target, at)
        if b == 47 or b == 63:
            end = at
            break
    host = text_part(target, start, end)
    if host == "" or host.find("@") is not None: return None
    rest = text_part(target, end, size)
    return WholeTarget(host=host, rest=rest if rest.startswith("/") else f"/{rest}")

## Where the `:` is in `line`, a header line taken whole: its name a token before the `:`, and
## no control character but a tab after it. -1 when the line is anything else, which
## `header_fault` then says, so a header that's well made is read over once.
def header_colon(line: str) -> int:
    size = text_size(line)
    mut colon = -1
    for at in range(size):
        byte = text_byte(line, at)
        if byte == 58:
            colon = at
            break
        # A name is mostly lower-case letters and `-`, tested here before the rest of a token's bytes.
        if (byte < 97 or byte > 122) and byte != 45 and not is_token_byte(byte): return -1
    if colon <= 0: return -1
    for at in range(colon + 1, size):
        byte = text_byte(line, at)
        if (byte < 32 and byte != 9) or byte == 127: return -1
    return colon

## Why `line` isn't a header line `header_colon` takes, its checks in the order they're said.
def header_fault(line: str) -> str:
    # A line that starts with a space would continue the last header, which some read as a new
    # one, and a control character is read differently by different servers.
    if text_byte(line, 0) == 32 or text_byte(line, 0) == 9 or has_control(line, True):
        return "a header has a character it can't have"
    colon = line.find(":") else return "a header has no `:`"
    if not is_token_part(line, start=0, end=colon): return "a header's name isn't one"
    # `header_colon` refuses only what's above.
    return "a header has a character it can't have"

## Whether `text` is what HTTP calls a token, as a method or a header's name has to be.
def is_token(text: str) -> bool:
    return is_token_part(text, start=0, end=text_size(text))

## Whether the bytes of `text` from `start` up to `end` are a token, read where they are.
def is_token_part(text: str, start: int, end: int) -> bool:
    if end <= start: return False
    for at in range(start, end):
        byte = text_byte(text, at)
        # Mostly lower-case letters and `-`, tested here before the rest of a token's bytes.
        if (byte < 97 or byte > 122) and byte != 45 and not is_token_byte(byte): return False
    return True

## Whether `byte` may be in a token.
def is_token_byte(byte: int) -> bool:
    if (byte >= 97 and byte <= 122) or (byte >= 65 and byte <= 90) or (byte >= 48 and byte <= 57):
        return True
    return (
        byte == 45
        or byte == 95
        or byte == 46
        or byte == 33
        or byte == 35
        or byte == 36
        or byte == 37
        or byte == 38
        or byte == 39
        or byte == 42
        or byte == 43
        or byte == 94
        or byte == 96
        or byte == 124
        or byte == 126
    )

## The first `end` bytes of `line`, a header's name, in lower case: cut out once, and made lower
## only when it has a capital, as a name already lower, like one HTTP/2 sends, needs nothing more.
def lowered_part(line: str, end: int) -> str:
    for at in range(end):
        b = text_byte(line, at)
        if b >= 65 and b <= 90: return text_part(line, 0, end).lower()
    return text_part(line, 0, end)

## What follows `colon` in `line`, a header's value, with the spaces and tabs around it left out,
## as HTTP has them: cut out once, where `strip` cut it out and then again.
def value_after(line: str, colon: int) -> str:
    mut start = colon + 1
    mut end = text_size(line)
    while start < end and (text_byte(line, start) == 32 or text_byte(line, start) == 9):
        start += 1
    while end > start and (text_byte(line, end - 1) == 32 or text_byte(line, end - 1) == 9):
        end -= 1
    return text_part(line, start, end)

## Whether `text` has a control character in it, which a tab isn't if `tab` says so.
def has_control(text: str, tab: bool) -> bool:
    for at in range(text_size(text)):
        b = text_byte(text, at)
        if (b < 32 and not (tab and b == 9)) or b == 127: return True
    return False

## Whether `text` can be a request's target: ASCII with no control character or space, read over
## once. A space would make the request line more than three parts.
def is_plain_target(text: str) -> bool:
    for at in range(text_size(text)):
        byte = text_byte(text, at)
        if byte <= 32 or byte >= 127: return False
    return True

## Whether `text` is one or more digits and nothing else.
def only_digits(text: str) -> bool:
    size = text_size(text)
    if size == 0: return False
    for at in range(size):
        b = text_byte(text, at)
        if b < 48 or b > 57: return False
    return True

## Writes a response, saying the connection closes after it when it does. The answer to a `HEAD`
## says how long its body is and doesn't send it. A header that can't be written, as a value from
## outside with a line break would start a header of its own, makes it a 500 instead.
def write_response(
    connection: Connection,
    response: Response,
    keep: bool,
    head_only: bool,
) fails NetError:
    mut head = f"HTTP/1.1 {response.status} {reason_phrase(response.status)}\r\n"
    for name, value in response.headers.items():
        if not is_token(name) or has_control(value, True):
            refused = Response(status=500, body="a response header can't be written".encode())
            write_response(connection, refused, keep, head_only)?
            return
        # The server writes how the body's sent and whether the connection stays itself. A
        # `transfer-encoding` beside its `content-length` would have a client read the body as
        # chunks, which it isn't, and take what follows for the next response.
        if not is_framing(name):
            head += f"{name}: {value}\r\n"
    if keep:
        head += f"content-length: {len(response.body)}\r\n\r\n"
    else:
        head += f"content-length: {len(response.body)}\r\nconnection: close\r\n\r\n"
    # The head and the body in one write, so a small response goes in one packet: written apart,
    # the body waits for the client to acknowledge the head, which it may hold back for 40 ms.
    if len(response.body) > 0 and not head_only:
        connection.write(head.encode() + response.body)?
    else:
        connection.write(head)?

## Whether `name` is a header the server writes itself, in any case: `content-length`,
## `connection` or `transfer-encoding`. Only a name as long as one of them is made lower to see.
def is_framing(name: str) -> bool:
    size = text_size(name)
    if size != 14 and size != 10 and size != 17: return False
    lower = name.lower()
    return lower == "content-length" or lower == "connection" or lower == "transfer-encoding"

## The words that go with a status.
def reason_phrase(status: int) -> str:
    match status:
        case 200:
            return "OK"
        case 201:
            return "Created"
        case 204:
            return "No Content"
        case 301:
            return "Moved Permanently"
        case 302:
            return "Found"
        case 304:
            return "Not Modified"
        case 400:
            return "Bad Request"
        case 401:
            return "Unauthorized"
        case 403:
            return "Forbidden"
        case 404:
            return "Not Found"
        case 405:
            return "Method Not Allowed"
        case 413:
            return "Content Too Large"
        case 414:
            return "URI Too Long"
        case 431:
            return "Request Header Fields Too Large"
        case 500:
            return "Internal Server Error"
        case 501:
            return "Not Implemented"
        case 503:
            return "Service Unavailable"
        case _:
            return "Unknown"

## The next connection a server takes, waiting up to `timeout` when there's one.
def accepted(server: Server, timeout: Duration?) -> Connection fails NetError:
    if timeout is None: return server._accept()?
    return server._accept(timeout=timeout)?

## A server listening on `port`, with TLS when there's a certificate.
def listened(net: Net, port: int, tls: Certificate?) -> Server fails NetError:
    if tls is None: return net._listen(port)?
    return net._listen(port, tls=tls)?
