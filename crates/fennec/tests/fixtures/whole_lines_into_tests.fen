## Each line a test and its tasks print reaches the test's capture whole, however many threads
## print at once: a `print` arrives in pieces, and no piece of one line lands inside another.
from std.concurrent import Crashed

def chatter(stdout: Stdout, name: str):
    for at in range(300):
        stdout.print(name, at)

def with_task(stdout: Stdout) fails Crashed:
    with launch(() => chatter(stdout, "task"))?:
        chatter(stdout, "test")
    return

def looped(stdout: Stdout, numbers: list[int]):
    for n in parallel(numbers):
        stdout.print("item", n)

test "a launched task's lines and the test's own each arrive whole"(stdout: Stdout):
    with_task(stdout) except why:
        stdout.print(f"crashed {why}")
    tasks = [f"task {n}" for n in range(300)]
    tests = [f"test {n}" for n in range(300)]
    lines = stdout.sorted_lines()
    assert lines.len() == 600
    for line in lines:
        assert line in tasks or line in tests

test "a parallel loop's lines each arrive whole, wherever they ran"(stdout: Stdout):
    looped(stdout, [n for n in range(300)])
    items = [f"item {n}" for n in range(300)]
    lines = stdout.sorted_lines()
    assert lines.len() == 300
    for line in lines:
        assert line in items
