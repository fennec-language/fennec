## The machine operations the standard library stands on. Each engine supplies the body. Only
## the standard library can import this module: a program uses `int`, `float` and `str`, which
## are written on top of it.
from std.collections import Id, Table

@intrinsic
def int_add(a: int, b: int) -> int

@intrinsic
def int_sub(a: int, b: int) -> int

@intrinsic
def int_mul(a: int, b: int) -> int

@intrinsic
def int_floordiv(a: int, b: int) -> int

@intrinsic
def int_rem(a: int, b: int) -> int

@intrinsic
def int_neg(a: int) -> int

@intrinsic
def int_eq(a: int, b: int) -> bool

@intrinsic
def int_lt(a: int, b: int) -> bool

@intrinsic
def int_and(a: int, b: int) -> int

@intrinsic
def int_or(a: int, b: int) -> int

@intrinsic
def int_xor(a: int, b: int) -> int

@intrinsic
def int_not(a: int) -> int

@intrinsic
def int_shl(a: int, by: int) -> int

@intrinsic
def int_shr(a: int, by: int) -> int

@intrinsic
def int_wrapping_add(a: int, b: int) -> int

@intrinsic
def int_wrapping_sub(a: int, b: int) -> int

@intrinsic
def int_wrapping_mul(a: int, b: int) -> int

@intrinsic
def int_to_float(a: int) -> float

@intrinsic
def int_hash(a: int) -> int

@intrinsic
def float_add(a: float, b: float) -> float

@intrinsic
def float_sub(a: float, b: float) -> float

@intrinsic
def float_mul(a: float, b: float) -> float

@intrinsic
def float_div(a: float, b: float) -> float

@intrinsic
def float_neg(a: float) -> float

@intrinsic
def float_eq(a: float, b: float) -> bool

@intrinsic
def float_lt(a: float, b: float) -> bool

@intrinsic
def float_to_int(a: float) -> int

@intrinsic
def float_bits(a: float) -> int

## The byte at a place in a text's bytes, or -1 past its end.
@intrinsic
def text_byte(text: str, at: int) -> int

## How many bytes a text has.
@intrinsic
def text_size(text: str) -> int

## The part of a text between two places in its bytes, each where a character starts or at its end.
@intrinsic
def text_part(text: str, start: int, end: int) -> str

## The character with a code, which has to be one.
@intrinsic
def text_of_code(code: int) -> str

## A type's name as it's written. Only native code has types as it runs.
@intrinsic
def type_name[T]() -> str

## An `Id`'s slot in its `Table`.
@intrinsic
def id_slot[T](id: Id[T]) -> int

## An `Id`'s generation: how many times its slot had been used again when it was handed out.
@intrinsic
def id_generation[T](id: Id[T]) -> int

## The `Id` of a slot and generation, which the `Table` it's used with may never have handed out.
@intrinsic
def id_of[T](slot: int, generation: int) -> Id[T]

## Each of a `Table`'s slots, by its generation, or `-1 - generation` for a free one.
@intrinsic
def table_slots[T](table: Table[T]) -> list[int]

## A `Table` with the slots `table_slots` says, and `items` in the ones that aren't free, in order.
@intrinsic
def table_from[T](slots: list[int], items: list[T]) -> Table[T]
