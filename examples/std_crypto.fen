# `std.crypto` hashes text or bytes, signs them with HMAC, and compares secrets in time that
# doesn't depend on where they differ. Every result is written as lowercase hex, and each hash's
# `_digest` form gives the digest's own bytes instead. A hash takes its data whole or in chunks,
# from a list or from an iterator, like a file's chunks as it's read.
from std.crypto import blake3, blake3_digest, derive_key, equal, hmac_sha256, hmac_sha256_digest, keyed_blake3, keyed_blake3_digest, sha256, sha256_digest

## A save file with a tag that shows it wasn't edited by hand.
struct Save:
    level: int
    tag: str

def sign(key: str, level: int) -> Save:
    return Save(level=level, tag=keyed_blake3(key, f"level {level}"))

## Text in pieces of `size` characters, one at a time, as a file's chunks come.
def pieces(text: str, size: int) -> Iterator[str]:
    mut at = 0
    while at < len(text):
        yield text[at:at + size]
        at = at + size

def untouched(key: str, save: Save) -> bool:
    # Comparing the tags in constant time doesn't tell a forger how close a guess was.
    return equal(keyed_blake3(key, f"level {save.level}"), save.tag)

test "the same text always has the same hash" for text: str:
    assert blake3(text) == blake3(text.encode())
    assert len(blake3(text)) == 64 and len(sha256(text)) == 64
    assert sha256(text) == sha256(text.encode())

test "SHA-256 matches the standard":
    assert sha256("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    assert sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

test "HMAC-SHA256 matches RFC 4231":
    signed = hmac_sha256("Jefe", "what do ya want for nothing?")
    assert signed == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
    assert (
        hmac_sha256(bytes([11 for _ in range(20)]), "Hi There")
        == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"
    )

test "BLAKE3 matches its reference":
    assert blake3("") == "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262"

test "a hash of chunks is the hash of them joined" for text: str:
    assert blake3(pieces(text, 3)) == blake3(text) and sha256(pieces(text, 5)) == sha256(text)
    assert blake3([text.encode(), text.encode()]) == blake3(text + text)
    assert sha256(list[bytes]()) == sha256("") and blake3(pieces("", 4)) == blake3("")

test "a digest is the hash's own bytes, which the hex form spells" for text: str:
    assert len(sha256_digest(text)) == 32 and len(blake3_digest(text)) == 32
    assert sha256_digest(text).hex() == sha256(text) and blake3_digest(text).hex() == blake3(text)
    assert sha256_digest(text.encode()) == sha256_digest(text)
    key = derive_key("fennec example 2026-11-14 digests", "a secret")
    assert keyed_blake3_digest(key, text).hex() == keyed_blake3(key, text)
    assert hmac_sha256_digest(text, "data").hex() == hmac_sha256(text, "data")

test "a digest takes chunks, as the hex form does" for text: str:
    assert sha256_digest(pieces(text, 5)) == sha256_digest(text)
    assert blake3_digest([text.encode(), text.encode()]) == blake3_digest(text + text)
    assert sha256_digest(list[str]()) == sha256_digest("")

test "HMAC-SHA256's digest matches RFC 4231, and keys another HMAC as bytes":
    signed = hmac_sha256_digest("Jefe", "what do ya want for nothing?")
    assert signed.hex() == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
    # Keying with the digest's 32 bytes is not keying with its 64 hex digits.
    assert hmac_sha256_digest(signed, "next") != hmac_sha256_digest(signed.hex(), "next")
    assert hmac_sha256_digest(signed, "next").hex() == hmac_sha256(signed, "next")

test "equal compares every byte":
    assert equal("secret", "secret") and not equal("secret", "secreT")
    assert not equal("secret", "secrets") and equal("", "")
    assert equal(bytes([1, 2]), bytes([1, 2]))

def main(stdout: Stdout):
    # The same text gives the same hash on every machine, so a hash names its content.
    stdout.print(blake3("fennec"))
    stdout.print(sha256("fennec"))
    stdout.print(blake3("fennec") == blake3("fennec"), blake3("fennec") == blake3("Fennec"))
    # In chunks, it's the same hash, while only a chunk at a time is held.
    stdout.print(
        blake3(pieces("fennec", 4)) == blake3("fennec"),
        sha256(["fen", "nec"]) == sha256("fennec"),
    )

    # A key derived from a secret, for one purpose only.
    key = derive_key("fennec example 2026-10-30 save files", "the player's secret")
    save = sign(key, 3)
    stdout.print(untouched(key, save))
    stdout.print(untouched(key, Save(level=99, tag=save.tag)))
    stdout.print(hmac_sha256("server key", "user=ash"))
