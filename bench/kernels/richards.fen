## Richards from Are We Fast Yet: an operating system's scheduler, passing packets between tasks of
## four kinds. Tasks and packets link to each other by their place in a list, -1 being none.

NONE = -1
IDLE = 0
WORKER = 1
HANDLER_A = 2
HANDLER_B = 3
DEVICE_A = 4
DEVICE_B = 5
DEVICE_PACKET = 0
WORK_PACKET = 1

enum Kind:
    Idle
    Worker
    Handler
    Device

struct Packet:
    link: int
    id: int
    kind: int
    a2: array[int, 4]
    a1 = 0

struct Task:
    kind: Kind
    priority: int
    link: int
    queue: int
    held = False
    suspended = True
    runnable = False
    v1 = 0
    v2 = 0

struct Scheduler:
    tasks: list[Task]
    packets: list[Packet]
    newest = NONE
    current = NONE
    queued = 0
    holds = 0

    def add_task(ref self, kind: Kind, priority: int, queue: int, v1: int, v2: int):
        self.tasks.append(
            Task(
                kind=kind,
                priority=priority,
                link=self.newest,
                queue=queue,
                runnable=queue != NONE,
                v1=v1,
                v2=v2,
            ),
        )
        self.newest = len(self.tasks) - 1

    def add_packet(ref self, link: int, id: int, kind: int) -> int:
        self.packets.append(Packet(link=link, id=id, kind=kind, a2=array[int, 4]()))
        return len(self.packets) - 1

    def schedule(ref self):
        mut at = self.newest
        while at != NONE:
            if self.tasks[at].held or (self.tasks[at].suspended and not self.tasks[at].runnable):
                at = self.tasks[at].link
            else:
                self.current = at
                at = self.run(at)

    def run(ref self, at: int) -> int:
        mut packet = NONE
        if self.tasks[at].suspended and self.tasks[at].runnable:
            packet = self.tasks[at].queue
            self.tasks[at].queue = self.packets[packet].link
            self.tasks[at].suspended = False
            self.tasks[at].runnable = self.tasks[at].queue != NONE
        match self.tasks[at].kind:
            case .Idle:
                return self.run_idle(at)
            case .Worker:
                return self.run_worker(at, packet=packet)
            case .Handler:
                return self.run_handler(at, packet=packet)
            case .Device:
                return self.run_device(at, packet=packet)

    def release(ref self, id: int) -> int:
        self.tasks[id].held = False
        if self.tasks[id].priority > self.tasks[self.current].priority: return id
        return self.current

    def hold_current(ref self) -> int:
        self.holds += 1
        self.tasks[self.current].held = True
        return self.tasks[self.current].link

    def suspend_current(ref self) -> int:
        self.tasks[self.current].suspended = True
        return self.current

    def send(ref self, packet: int) -> int:
        to = self.packets[packet].id
        self.queued += 1
        self.packets[packet].link = NONE
        self.packets[packet].id = self.current
        if self.tasks[to].queue == NONE:
            self.tasks[to].queue = packet
            self.tasks[to].runnable = True
            if self.tasks[to].priority > self.tasks[self.current].priority: return to
        else:
            self.tasks[to].queue = self.appended(packet, queue=self.tasks[to].queue)
        return self.current

    def appended(ref self, packet: int, queue: int) -> int:
        self.packets[packet].link = NONE
        if queue == NONE: return packet
        mut last = queue
        while self.packets[last].link != NONE:
            last = self.packets[last].link
        self.packets[last].link = packet
        return queue

    def run_idle(ref self, at: int) -> int:
        self.tasks[at].v2 -= 1
        if self.tasks[at].v2 == 0: return self.hold_current()
        state = self.tasks[at].v1
        if state & 1 == 0:
            self.tasks[at].v1 = state >> 1
            return self.release(DEVICE_A)
        # 53_256 is 0xD008.
        self.tasks[at].v1 = (state >> 1) ^ 53_256
        return self.release(DEVICE_B)

    def run_device(ref self, at: int, packet: int) -> int:
        if packet != NONE:
            self.tasks[at].v1 = packet
            return self.hold_current()
        waiting = self.tasks[at].v1
        if waiting == NONE: return self.suspend_current()
        self.tasks[at].v1 = NONE
        return self.send(waiting)

    def run_worker(ref self, at: int, packet: int) -> int:
        if packet == NONE: return self.suspend_current()
        handler = HANDLER_B if self.tasks[at].v1 == HANDLER_A else HANDLER_A
        self.tasks[at].v1 = handler
        self.packets[packet].id = handler
        self.packets[packet].a1 = 0
        for i in range(4):
            mut next = self.tasks[at].v2 + 1
            if next > 26:
                next = 1
            self.tasks[at].v2 = next
            self.packets[packet].a2[i] = next
        return self.send(packet)

    def run_handler(ref self, at: int, packet: int) -> int:
        if packet != NONE:
            if self.packets[packet].kind == WORK_PACKET:
                self.tasks[at].v1 = self.appended(packet, queue=self.tasks[at].v1)
            else:
                self.tasks[at].v2 = self.appended(packet, queue=self.tasks[at].v2)
        work = self.tasks[at].v1
        if work != NONE:
            count = self.packets[work].a1
            if count < 4:
                device = self.tasks[at].v2
                if device != NONE:
                    self.tasks[at].v2 = self.packets[device].link
                    self.packets[device].a1 = self.packets[work].a2[count]
                    self.packets[work].a1 = count + 1
                    return self.send(device)
            else:
                self.tasks[at].v1 = self.packets[work].link
                return self.send(work)
        return self.suspend_current()

def simulate() -> (int, int):
    mut scheduler = Scheduler(tasks=[], packets=[])
    scheduler.add_task(.Idle, priority=0, queue=NONE, v1=1, v2=10000)
    scheduler.tasks[IDLE].suspended = False
    work = scheduler.add_packet(NONE, id=WORKER, kind=WORK_PACKET)
    work_queue = scheduler.add_packet(work, id=WORKER, kind=WORK_PACKET)
    scheduler.add_task(.Worker, priority=1000, queue=work_queue, v1=HANDLER_A, v2=0)
    mut queue = NONE
    for _ in range(3):
        queue = scheduler.add_packet(queue, id=DEVICE_A, kind=DEVICE_PACKET)
    scheduler.add_task(.Handler, priority=2000, queue=queue, v1=NONE, v2=NONE)
    queue = NONE
    for _ in range(3):
        queue = scheduler.add_packet(queue, id=DEVICE_B, kind=DEVICE_PACKET)
    scheduler.add_task(.Handler, priority=3000, queue=queue, v1=NONE, v2=NONE)
    scheduler.add_task(.Device, priority=4000, queue=NONE, v1=NONE, v2=0)
    scheduler.add_task(.Device, priority=5000, queue=NONE, v1=NONE, v2=0)
    scheduler.schedule()
    return (scheduler.queued, scheduler.holds)

def main(stdout: Stdout):
    mut queued = 0
    mut holds = 0
    for _ in range(25):
        one, other = simulate()
        queued = one
        holds = other
    stdout.print(queued, holds)
