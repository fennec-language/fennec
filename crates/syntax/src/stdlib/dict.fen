## `dict`'s methods written in Fennec. Reading, writing and walking its pairs are machine
## operations the compiler gives.
extend dict[K: Hashable, V]:
    ## Adds every pair of `more`, replacing the values of keys it already has.
    ##
    ## ```fennec
    ## mut ages = {"ana": 31, "bo": 40}
    ## ages.update({"bo": 41, "cy": 25})
    ## assert ages == {"ana": 31, "bo": 41, "cy": 25}
    ## ```
    def update(ref self, more: dict[K, V]):
        for key, value in more.items():
            self[key] = value

    ## The value of `key`, adding `default` as its value when it has none.
    ##
    ## ```fennec
    ## mut seen: dict[str, int] = {}
    ## assert seen.setdefault("a", 1) == 1
    ## assert seen.setdefault("a", 2) == 1
    ## assert seen == {"a": 1}
    ## ```
    def setdefault(ref self, key: K, default: V) -> V:
        if key in self: return self[key]
        self[key] = default
        return default

    ## Takes `key` out, giving back its value, or `None` when it isn't there: `pop` for a key that
    ## may be missing, as `get` is to `self[key]`.
    ##
    ## ```fennec
    ## mut ages = {"ana": 31}
    ## assert ages.remove("ana") == 31
    ## assert ages.remove("ana") is None
    ## ```
    def remove(ref self, key: K) -> V?:
        if key not in self: return None
        return self.pop(key)

    ## Takes out `key`, if it's there, and does nothing if not: `remove` for a line that only takes
    ## it out.
    ##
    ## ```fennec
    ## mut ages = {"ana": 31, "bo": 40}
    ## ages.discard("ana")
    ## ages.discard("cy")
    ## assert ages == {"bo": 40}
    ## ```
    def discard(ref self, key: K):
        _ = self.remove(key)

extend dict[K: Hashable & Serializable, V: Serializable]:
    ## Writes the dict for `json.dumps`, `pack.dumps` and the rest, which call it.
    ## ```fennec
    ## from std import json
    ## assert json.dumps({"a": 1}) == "{\"a\": 1}"
    ## ```
    def serialize(self, ref out: Serializer):
        out.map(self.items())

## A key that came twice as a message names it: in backticks, cut to its first 20 characters and
## `…` past 40, since a key from outside can be as long as it likes, with its control characters
## written as escapes, as `std.string`'s `quoted_input` writes them, which a core file can't import.
def twice_key[K](key: K) -> str:
    full = f"{key}"
    cut = full if len(full) <= 40 else full[0:20] + "…"
    hex = "0123456789abcdef"
    mut text = ""
    for c in cut:
        code = c.code()
        if c == "\n":
            text += "\\n"
        elif c == "\r":
            text += "\\r"
        elif c == "\t":
            text += "\\t"
        elif code < 32 or (code >= 127 and code < 160):
            text += "\\u{" + hex[code // 16] + hex[code % 16] + "}"
        else:
            text += c
    return f"`{text}`"

extend dict[K: Hashable & Deserializable, V: Deserializable]:
    ## A key that comes twice fails, naming it, rather than the last one winning: two readers that
    ## disagree on which wins would let a value past a check that read the other.
    ##
    ## ```fennec
    ## from std import json
    ## assert json.loads[dict[str, int]]("{\"a\": 1}")? == {"a": 1}
    ## assert json.loads[dict[str, int]]("{\"a\": 1, \"a\": 2}") fails ParseError()
    ## ```
    def deserialize(ref src: Deserializer) -> dict[K, V] fails ParseError:
        mut found = dict[K, V]()
        count = src.map_count()?
        if count >= 0:
            # Read straight into the dict, with no list of pairs on the way.
            for _ in range(count):
                key = src.value[K]()?
                before = len(found)
                found[key] = src.value[V]()?
                if len(found) == before: fail src.here(f"has {twice_key(key)} twice")
            src.end_map()
            return found
        for key, value in src.map[K, V]()?:
            before = len(found)
            found[key] = value
            if len(found) == before: fail src.here(f"has {twice_key(key)} twice")
        return found

## `dict`'s methods the compiler gives. Each is declared here for its signature and its doc, and a
## test holds it to the checker's own.
extend dict[K: Hashable, V]:
    ## How many keys it has.
    @intrinsic
    def len(self) -> int

    ## Takes out `key` and gives back its value. A key that isn't there stops the program, as
    ## `ages[key]` does: `remove(key)` gives `None` instead.
    @intrinsic
    def pop(ref self, key: K) -> V

    ## The value of `key`, or `None` when it has none: `ages.get(name) else 0`.
    @intrinsic
    def get(self, key: K) -> V?

    ## The keys, in the order they were added.
    @intrinsic
    def keys(self) -> list[K]

    ## The values, in the order their keys were added.
    @intrinsic
    def values(self) -> list[V]

    ## Each key and its value, in the order the keys were added.
    @intrinsic
    def items(self) -> list[(K, V)]

    ## Takes out every key.
    @intrinsic
    def clear(ref self)
