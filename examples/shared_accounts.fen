# A `shared` value is one cell that every name for it reaches. It's reached only inside `lock`:
# `lock x as ref y:` changes it and `lock x as y:` reads it. To change several together, one
# `lock` takes them all, in an order every block agrees on, and the block changes them through the
# names it gives them: `ref` ones to write, the rest to read.

struct Account:
    total = 0

    def add(ref self, amount: int):
        self.total += amount

    def balance(self) -> int:
        return self.total

def transfer(source: shared Account, target: shared Account, amount: int) -> bool:
    lock source, target as ref paying, ref paid:
        if paying.total < amount: return False
        paying.total -= amount
        paid.add(amount)
    return True

def main(stdout: Stdout):
    shared savings = Account(total=100)
    shared checking = Account()
    same = checking
    stdout.print(
        transfer(savings, target=checking, amount=30),
        transfer(checking, target=savings, amount=50),
    )
    lock same as ref held:
        held.add(5)
    mut summary = ""
    lock savings, checking as seen, other:
        summary = f"{seen.total} and {other.balance()}"
    stdout.print(summary)
