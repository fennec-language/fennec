# `checksum.fen` without `parallel`: the same numbers stirred and added up one after another.

def stirred(n: int) -> int:
    mut x = n % 2_147_483_646 + 1
    for _ in range(100):
        x = x * 48_271 % 2_147_483_647
    return x % 1_000

def main(stdout: Stdout):
    stdout.print(sum(stirred(n) for n in range(2_000_000)))
