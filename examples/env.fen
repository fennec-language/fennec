# `Env` reads the environment variables the program was started with. In a test, `Env` is a
# fake holding only what the test set, so a test never depends on the machine it runs on.

## Where to keep settings: `$XDG_CONFIG_HOME`, or `.config` in the home folder when that's unset.
def config_folder(env: Env) -> str:
    chosen = env.get("XDG_CONFIG_HOME") else ""
    if chosen != "": return chosen
    home = env.get("HOME") else ""
    f"{home}/.config"

test "the config folder is XDG_CONFIG_HOME when it's set"(env: Env):
    env.set("XDG_CONFIG_HOME", "/tmp/settings")
    assert config_folder(env) == "/tmp/settings"

test "the config folder falls back to the home folder"(env: Env):
    env.set("HOME", "/home/fox")
    assert config_folder(env) == "/home/fox/.config"

test "a fake Env holds only what the test set"(env: Env):
    assert env.get("PATH") is None
    env.set("B", "2")
    env.set("A", "1")
    env.set("B", "3")
    assert env.all() == {"A": "1", "B": "3"}
    assert [name for name, _ in env.all().items()] == ["A", "B"]

def main(stdout: Stdout, env: Env):
    # A variable that isn't set is `None`, not an empty string.
    missing = env.get("FENNEC_NO_SUCH_VARIABLE")
    stdout.print(missing is None)
    stdout.print(config_folder(env).endswith("/.config") or env.get("XDG_CONFIG_HOME") is not None)
