# A `shared` value can hold others, but never in a cycle. Its lock comes first: a lock body for
# the bank can take an account's, and nothing can take them the other way round.

shared Account:
    total = 0

    def add(ref self, amount: int):
        self.total += amount

shared Bank:
    accounts: list[Account]

    def deposit(ref self, at: int, amount: int):
        self.accounts[at].add(amount)

    def total(self) -> int:
        sum(account.total for account in self.accounts)

def main(stdout: Stdout):
    first = Account(total=1)
    bank = Bank(accounts=[first, Account(total=2)])
    bank.deposit(0, amount=10)
    with bank as ref held:
        held.accounts[1].add(5)
        with held.accounts[0] as ref inner:
            inner.total += 100
    stdout.print(bank.total(), first.total)
