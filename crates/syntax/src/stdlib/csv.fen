# `std.csv`: CSV text, rows of fields separated by commas, as RFC 4180 describes. A field
# holding a comma, a quote or a line break is written in quotes, with its quotes doubled. Lines
# can end in `\n`, `\r\n` or `\r`, and blank lines aren't rows, so `dumps` refuses a row with no fields.
# Every field is text.
from std.io import Reader, Writer, read_all

## The rows of `text`. Text that isn't CSV fails with a `ParseError`.
export def loads(text: str, delimiter = ",") -> list[list[str]]:
    return [row for _, row in rows_in(text, delimiter)?]

## The rows after the first as dicts, with the first row's fields as their keys. A row
## with a different number of fields fails with a `ParseError`.
export def records(text: str, delimiter = ",") -> list[dict[str, str]]:
    rows = rows_in(text, delimiter)?
    if len(rows) == 0: return []
    _, names = rows[0]
    if len(set(names)) != len(names):
        fail parse_problem("the first row has the same name twice", 1, 1)
    mut found = list[dict[str, str]]()
    for line, row in rows[1:]:
        if len(row) != len(names):
            problem = f"the first row sets {len(names)} as the number of fields, but this row has {len(row)}"
            fail parse_problem(problem, line, 1)
        found.append({name: field for name, field in zip(names, row)})
    return found

## CSV text of `rows`, each ending in `\n`. A row with no fields fails with an `InvalidValue`:
## CSV can't write one, since a blank line isn't a row, and it would be lost. Every field is
## written as it is, so what's read back is what was given. A spreadsheet opening the file may
## run a field that starts with `=`, `+`, `-` or `@` as a formula: a program writing text from
## outside for a spreadsheet puts something in front of such a field itself, like a `'`.
export def dumps(rows: list[list[str]], delimiter = ",") -> str fails InvalidValue:
    wrong = delimiter_problem(delimiter)
    if wrong != "": fail InvalidValue(message=wrong)
    mut lines = list[str]()
    for at, row in enumerate(rows):
        if len(row) == 0:
            fail InvalidValue(message=f"row {at} has no fields, which CSV can't write")
        lines.append(written_row(row, delimiter))
    return "".join(lines)

## CSV text with `names` as its first row, then each record's value for each name, which
## is empty when it has none. Other keys aren't written.
export def dumps_records(
    names: list[str],
    entries: list[dict[str, str]],
    delimiter = ",",
) -> str fails InvalidValue:
    mut rows = [names]
    for record in entries:
        rows.append([(record.get(name) else "") for name in names])
    return dumps(rows, delimiter)?

## One row and the newline after it. A row of one empty field is written in quotes,
## since a blank line isn't a row.
def written_row(row: list[str], delimiter: str) -> str:
    if row == [""]: return "\"\"\n"
    return delimiter.join([quoted_field(field, delimiter) for field in row]) + "\n"

def quoted_field(field: str, delimiter: str) -> str:
    # One starting with U+FEFF would be taken for the text's byte order mark and lost.
    special = (
        delimiter in field
        or "\"" in field
        or "\n" in field
        or "\r" in field
        or field.startswith("\ufeff")
    )
    if not special: return field
    return "\"" + field.replace("\"", "\"\"") + "\""

## What's wrong with `delimiter`, or "". It's one character, since a longer one would never be
## found and every line would be one field; and not a quote or a line break, which CSV gives
## meanings of their own, so `dumps` would write rows that read back as others.
def delimiter_problem(delimiter: str) -> str:
    if len(delimiter) != 1: return "a delimiter is one character"
    if delimiter == "\"" or delimiter == "\n" or delimiter == "\r":
        return "a delimiter can't be a quote or a line break"
    return ""

def parse_problem(problem: str, line: int, column: int) -> ParseError:
    return ParseError(
        message=f"{problem} at line {line}, column {column}",
        line=line,
        column=column,
    )

## Each row, with the line it starts on. It goes through the characters once, since
## finding a character by its position can mean walking from the start.
def rows_in(text: str, delimiter: str) -> list[(int, list[str])]:
    wrong = delimiter_problem(delimiter)
    if wrong != "": fail parse_problem(wrong, 1, 1)
    mut rows = []
    mut row = []
    mut field = ""
    mut line = 1
    mut column = 0
    mut marked = False
    mut row_line = 1
    mut quote_line = 1
    mut quote_column = 1
    # Inside quotes, just past a quote that may turn out to be a doubled one, and whether
    # this field had quotes, which makes it a field even when it's empty.
    mut in_quotes = False
    mut after_quote = False
    mut was_quoted = False
    mut after_return = False
    for c in text:
        column += 1
        if in_quotes:
            if c == "\"":
                in_quotes = False
                after_quote = True
            else:
                field += c
                if c == "\n":
                    line += 1
                    column = 0
            continue
        if after_return:
            after_return = False
            if c == "\n":
                column = 0
                continue
        # Only the text's first character can be its byte order mark: a second is a field's own.
        if line == 1 and column == 1 and c.code() == 65279 and not marked:
            marked = True
            column = 0
            continue
        if after_quote and c == "\"":
            field += c
            after_quote = False
            in_quotes = True
        elif c == delimiter:
            row.append(field)
            field = ""
            after_quote = False
            was_quoted = False
        elif c == "\n" or c == "\r":
            if len(row) > 0 or field != "" or was_quoted:
                row.append(field)
                rows.append((row_line, row))
            row = []
            field = ""
            after_quote = False
            was_quoted = False
            line += 1
            column = 0
            row_line = line
            after_return = c == "\r"
        elif after_quote:
            fail parse_problem("a field can't go on after its closing quote", line, column)
        elif c == "\"":
            if field != "":
                fail parse_problem(
                    "a quote in a field needs the whole field in quotes",
                    line,
                    column,
                )
            in_quotes = True
            was_quoted = True
            quote_line = line
            quote_column = column
        else:
            field += c
    if in_quotes: fail parse_problem("this quote never ends", quote_line, quote_column)
    if len(row) > 0 or field != "" or was_quoted:
        row.append(field)
        rows.append((row_line, row))
    return rows

## Writes `rows` as CSV to `out`, any `Writer` from `std.io`, as `dumps` gives them.
export def dump[W: Writer](
    rows: list[list[str]],
    ref out: W,
    delimiter = ",",
) fails InvalidValue | IoError:
    out.write_text(dumps(rows, delimiter)?)?

## The rows of what's left in `src`, any `Reader` from `std.io`, as `loads` reads them.
export def load[R: Reader](ref src: R, delimiter = ",") -> list[
    list[str]
] fails ParseError | IoError:
    data = read_all(ref src)?
    text = data.decode() except InvalidValue(): fail ParseError(
        message="the CSV isn't UTF-8 text",
        line=1,
        column=1,
    )
    return loads(text, delimiter)?
