## `dict`'s methods written in Fennec. Reading, writing and walking its pairs are machine
## operations the engines provide.
extend dict[K: Hashable, V]:
    ## Adds every pair of `more`, replacing the values of keys it already has.
    def update(ref self, more: dict[K, V]):
        for key, value in more.items():
            self[key] = value

    ## The value of `key`, adding `default` as its value when it has none.
    def setdefault(ref self, key: K, default: V) -> V:
        if key in self: return self[key]
        self[key] = default
        return default

    ## Takes `key` out, giving back its value, or `None` when it isn't there: `pop` for a key that
    ## may be missing, as `get` is to `self[key]`.
    def remove(ref self, key: K) -> V?:
        if key not in self: return None
        return self.pop(key)

extend dict[K: Hashable & Serializable, V: Serializable]:
    def serialize(self, ref out: Serializer):
        out.map(self.items())

## A key that came twice as a message names it: in backticks, cut to its first 20 characters and
## `…` past 40, since a key from outside can be as long as it likes, with its control characters
## written as escapes, as `std.string`'s `quoted_input` writes them, which a core file can't import.
def twice_key[K](key: K) -> str:
    full = f"{key}"
    cut = full if len(full) <= 40 else full[0:20] + "…"
    hex = "0123456789abcdef"
    mut text = ""
    for c in cut:
        code = c.code()
        if c == "\n":
            text += "\\n"
        elif c == "\r":
            text += "\\r"
        elif c == "\t":
            text += "\\t"
        elif code < 32 or (code >= 127 and code < 160):
            text += "\\u{" + hex[code // 16] + hex[code % 16] + "}"
        else:
            text += c
    return f"`{text}`"

extend dict[K: Hashable & Deserializable, V: Deserializable]:
    ## A key that comes twice fails, naming it, rather than the last one winning: two readers that
    ## disagree on which wins would let a value past a check that read the other.
    def deserialize(ref src: Deserializer) -> dict[K, V] fails ParseError:
        mut found = dict[K, V]()
        count = src.map_count()?
        if count >= 0:
            # Read straight into the dict, with no list of pairs on the way.
            for _ in range(count):
                key = src.value[K]()?
                before = len(found)
                found[key] = src.value[V]()?
                if len(found) == before: fail src.here(f"has {twice_key(key)} twice")
            src.end_map()
            return found
        for key, value in src.map[K, V]()?:
            before = len(found)
            found[key] = value
            if len(found) == before: fail src.here(f"has {twice_key(key)} twice")
        return found
