## Fennec's front end, written in Fennec.
##
## This mirrors the Rust front end in `crates/syntax`, file for file: `lexer.fen` turns source
## text into tokens, and `dump.fen` prints them in the same text as `fennec dev tokens`, so
## the two can be compared line by line.

from dump import dump_tokens

## Fennec programs can't read their command-line arguments yet, so this reads its work from
## `inputs.txt` in the current folder: one `tokens <path>` line per file to dump.
def main(stdout: Stdout, fs: Fs):
    request = fs.read_text("inputs.txt")?
    for line in request.lines():
        space = line.find(" ")
        if space is None:
            continue
        mode = line[:space]
        path = line[space + 1:]
        source = fs.read_text(path)?
        stdout.print(f"== {path}")
        if mode == "tokens":
            stdout.write(dump_tokens(source))
