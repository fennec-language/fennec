# A dict entry found in the bucket loop and used after its `break`, inside a loop over the buckets.
def tally(starts: list[int], order: list[int], limit: int) -> int:
    mut counts = dict[int, int]()
    mut seen = 0
    for cell in range(len(starts) - 1):
        for at in range(starts[cell], starts[cell + 1]):
            value = order[at]
            counts[value] = (counts.get(value) else 0) + 1
            found = counts.get(value) else 0
            if found > limit:
                counts[value] = found + 100
                break
            seen += 1
        seen += (counts.get(cell) else 0)
    return seen + len(counts)

def main(stdout: Stdout):
    stdout.print(tally([0, 4, 7], order=[3, 3, 3, 1, 1, 1, 1], limit=2))
    stdout.print(tally([0, 4, 7], order=[3, 3, 3, 1, 1, 1, 1], limit=9))
    stdout.print(tally([0, 4, 9], order=[3, 3, 3, 1, 1, 1, 1], limit=9))
