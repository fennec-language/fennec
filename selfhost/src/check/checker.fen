## The checker's passes over a program. Mirrors `crates/check/src/checker.rs`, starting with
## the declarations: every written type in a signature, field, test input or typed name has
## to mean something, and every type parameter's bounds have to be interfaces.

from span import Diagnostic
from ast import Module, FnDef, Generic, Field, TypeExpr, Stmt, StmtKind, Expr, ExprKind
from check.program import Program, FnEntry, TypeKind, built_in_types, unknown_type

## Checks a module against the standard library's modules. Returns every problem found,
## in source order.
def check(module: Module, library: list[Module]) -> list[Diagnostic]:
    mut checker = Checker()
    for source in library:
        checker.program.add(source, True)
    checker.program.add(module, False)
    checker.diagnostics += checker.program.problems
    checker.check_all()
    sorted_diagnostics(checker.diagnostics)

struct Checker:
    program: Program = Program()
    diagnostics = list[Diagnostic]()

    def check_all(ref self):
        self.check_declarations()
        for key, entry in self.program.functions.items():
            if not entry.prelude:
                self.check_function(entry.function, self.program.generics_of(entry))
        for test in self.program.tests:
            for input in test.inputs:
                self.check_written(input.ty, [])
            self.check_body(test.body, [])
        # A standard library type's fields mean its library's types, though the program has
        # one of the same name.
        own = self.program.types
        library = self.program.std_types()
        for name, info in own.items():
            if info.kind == .StructKind or not info.prelude:
                if info.prelude:
                    self.program.types = library
                generics = self.program.type_params(name)
                self.check_fields(info.type_def.fields, generics)
                for case in info.type_def.cases:
                    self.check_fields(case.fields, generics)
                self.program.types = own

    ## Reports types written in signatures and interfaces that don't mean anything, and
    ## type parameters bound to something that isn't an interface.
    def check_declarations(ref self):
        for key, entry in self.program.functions.items():
            if entry.prelude:
                continue
            function = entry.function
            names = generic_names(self.program.generics_of(entry))
            for param in function.params:
                self.check_param(param.ty, names)
            self.check_written(function.ret, names)
            self.check_written(function.fails, names)
            self.check_bounds(function.generics)
        for name, interface in self.program.interfaces.items():
            for method in interface.methods:
                # A method's own type parameters are types inside it, beside `Self`.
                own = ["Self"] + generic_names(method.generics)
                for param in method.params:
                    self.check_param(param.ty, own)
                self.check_written(method.ret, own)
                self.check_written(method.fails, own)
        for name, info in self.program.types.items():
            if not info.prelude:
                self.check_bounds(info.type_def.generics)

    ## Bounds that aren't interfaces, as in `T: Enemy`.
    def check_bounds(ref self, generics: list[Generic]):
        for generic in generics:
            for bound in generic.bounds:
                if not self.program.is_interface(bound.name):
                    self.diagnostics.append(
                        Diagnostic(
                            message=f"`{bound.name}` isn't an interface",
                            span=bound.span,
                            help="a type parameter can be bound to an interface, like `T: Ordered` or `T: Shape`",
                        ),
                    )

    ## A function's return type, and every type written in its body. A function defined
    ## inside another sees that one's type parameters, and has its return type checked but
    ## not its parameters' types, as the Rust checker does.
    def check_function(ref self, function: FnDef, generics: list[Generic]):
        self.check_written(function.ret, generic_names(generics))
        self.check_arrow(function)
        self.check_body(function.body, generics)

    ## `-> None` or `-> nothing`: no arrow already means a `def` gives back nothing.
    def check_arrow(ref self, function: FnDef):
        ret = function.ret
        arrow = function.arrow
        if ret is None or arrow is None:
            return
        if ret.name in ["None", "nothing"] and ret.args.len() == 0 and not ret.optional:
            self.diagnostics.append(Diagnostic(
                message=f"`{function.name}` gives back nothing, so it has no arrow",
                span=arrow.to(ret.span),
                help="a `def` with no `->` gives back nothing: remove the arrow and what follows it",
            ))

    def check_fields(ref self, fields: list[Field], generics: list[str]):
        for field in fields:
            self.check_written(field.ty, generics)
            # A default like `list[Token]()` says the field's type.
            default = field.default
            if field.ty is None and default is not None:
                self.check_written(made_type(default), generics)

    ## A parameter's type. An interface alone is fine here, since each call gives it a type of
    ## its own.
    def check_param(ref self, written: TypeExpr?, generics: list[str]):
        if written is None:
            return
        by_itself = written.args.len() == 0 and not written.optional
        if not by_itself or written.name in generics or not self.program.is_interface(written.name):
            self.check_written(written, generics)

    def check_written(ref self, written: TypeExpr?, generics: list[str]):
        if written is None:
            return
        _ = self.program.resolve_in(written, generics) else as problem:
            self.diagnostics.append(problem)
            return

    ## The types written inside a body: typed names, the types a call gives in brackets, and
    ## the bodies of nested functions.
    def check_body(ref self, stmts: list[Stmt], generics: list[Generic]):
        names = generic_names(generics)
        for stmt in stmts:
            match stmt.kind:
                case .Expr(expr): self.check_expr(expr, generics)
                case .Assign(target, _, value, _, ty):
                    self.check_written(ty, names)
                    self.check_expr(target, generics)
                    self.check_expr(value, generics)
                case .If(branches, otherwise):
                    for cond, body in branches:
                        self.check_expr(cond, generics)
                        self.check_body(body, generics)
                    if otherwise is not None:
                        self.check_body(otherwise, generics)
                case .While(cond, body):
                    self.check_expr(cond, generics)
                    self.check_body(body, generics)
                case .For(_, _, iter, body):
                    self.check_fields_of(iter, generics)
                    self.check_expr(iter, generics)
                    self.check_body(body, generics)
                case .With(value, _, body):
                    self.check_expr(value, generics)
                    self.check_body(body, generics)
                case .Return(value):
                    if value is not None:
                        self.check_expr(value, generics)
                case .Fail(value): self.check_expr(value, generics)
                case .Lend(value, otherwise):
                    self.check_expr(value, generics)
                    self.check_body(otherwise, generics)
                case .Yield(value): self.check_expr(value, generics)
                case .Assert(value): self.check_expr(value, generics)
                case .Def(function): self.check_function(function, generics + function.generics)
                case _: pass

    ## The types a call gives in brackets anywhere in `expr`, like `Draft` in
    ## `json.loads[Draft](text)` or `Token` in `list[Token]()`, and the bodies of its `match`es.
    def check_expr(ref self, expr: Expr, generics: list[Generic]):
        match expr.kind:
            case .Call(callee, args):
                match callee.kind:
                    case .Index(object, index):
                        if self.takes_types(object):
                            for written in bracket_types(index):
                                self.check_written(written, generic_names(generics))
                        self.check_expr(object, generics)
                        self.check_expr(index, generics)
                    case .Attr(object, _, _):
                        self.check_static_types(object)
                        self.check_expr(callee, generics)
                    case _: self.check_expr(callee, generics)
                for arg in args:
                    self.check_expr(arg.value, generics)
            case .FStr(parts):
                for part in parts:
                    match part:
                        case .Code(code, _): self.check_expr(code, generics)
                        case _: pass
            case .List(items): self.check_exprs(items, generics)
            case .Tuple(items): self.check_exprs(items, generics)
            case .Set(items): self.check_exprs(items, generics)
            case .Dict(pairs):
                for key, value in pairs:
                    self.check_expr(key, generics)
                    self.check_expr(value, generics)
            case .Comprehension(_, elem, value, _, iter, cond):
                self.check_expr(elem, generics)
                if value is not None:
                    self.check_expr(value, generics)
                self.check_expr(iter, generics)
                if cond is not None:
                    self.check_expr(cond, generics)
            case .Unary(_, operand): self.check_expr(operand, generics)
            case .Binary(_, lhs, rhs):
                self.check_expr(lhs, generics)
                self.check_expr(rhs, generics)
            case .Cond(then, cond, otherwise):
                self.check_expr(then, generics)
                self.check_expr(cond, generics)
                self.check_expr(otherwise, generics)
            case .Else(value, default):
                self.check_expr(value, generics)
                self.check_expr(default, generics)
            case .Try(value, context):
                self.check_expr(value, generics)
                if context is not None:
                    self.check_expr(context, generics)
            case .Attr(object, _, _): self.check_expr(object, generics)
            case .Index(object, index):
                self.check_expr(object, generics)
                self.check_expr(index, generics)
            case .Slice(object, start, end):
                self.check_expr(object, generics)
                if start is not None:
                    self.check_expr(start, generics)
                if end is not None:
                    self.check_expr(end, generics)
            case .Lambda(_, body): self.check_expr(body, generics)
            case .Match(subject, arms):
                self.check_expr(subject, generics)
                for arm in arms:
                    if arm.guard is not None:
                        self.check_expr(arm.guard, generics)
                    self.check_body(arm.body, generics)
            case _: pass

    def check_exprs(ref self, exprs: list[Expr], generics: list[Generic]):
        for expr in exprs:
            self.check_expr(expr, generics)

    ## Whether a call on `object[...]` takes the types in its brackets, as the Rust checker
    ## reads them: a type, `list`, `dict` or `set`, a function, or a method or module function.
    ## `Deque[int].of(items)`: a static method, with its type's parameters written in brackets,
    ## one for each.
    def check_static_types(ref self, object: Expr):
        match object.kind:
            case .Index(written, index):
                match written.kind:
                    case .Name(name) if name in self.program.types:
                        given = bracket_types(index).len()
                        params = self.program.type_params(name)
                        if given != params.len():
                            mut takes = f"{params.len()} types"
                            if params.len() == 1:
                                takes = "1 type"
                            listed = ", ".join(params)
                            self.diagnostics.append(
                                Diagnostic(
                                    message=f"`{name}` takes {takes} in brackets, but this gives {given}",
                                    span=index.span,
                                    help=f"write one type for each of its parameters, as `{name}[{listed}]`",
                                ),
                            )
                    case _: pass
            case _: pass

    ## `for field in fields(T):`, when `fields` is the language's own: `T` has to be a type.
    def check_fields_of(ref self, iter: Expr, generics: list[Generic]):
        match iter.kind:
            case .Call(callee, args):
                match callee.kind:
                    case .Name(called) if called == "fields" and called not in self.program.functions:
                        if args.len() == 1 and args[0].name is None and not args[0].is_mut:
                            match args[0].value.kind:
                                case .Name(of):
                                    if (
                                        of not in built_in_types()
                                        and of not in generic_names(generics)
                                        and of not in self.program.types
                                        and of not in self.program.aliases
                                    ):
                                        self.diagnostics.append(unknown_type(of, iter.span))
                                case _: pass
                    case _: pass
            case _: pass

    def takes_types(self, object: Expr) -> bool:
        match object.kind:
            case .Name(name):
                name in ["list", "dict", "set"] or name[0] >= "A" and name[0] <= "Z" or name in self.program.functions
            case .Attr(_, _, _): True
            case _: False

def generic_names(generics: list[Generic]) -> list[str]:
    [generic.name for generic in generics]

## Diagnostics in source order, then by message, with exact repeats dropped.
def sorted_diagnostics(diagnostics: list[Diagnostic]) -> list[Diagnostic]:
    mut unique = []
    for diagnostic in sorted(diagnostics, key=d => (d.span.start, d.message)):
        if unique.len() == 0 or unique[-1] != diagnostic:
            unique.append(diagnostic)
    unique

## The types written in a call's brackets, like `str, int` in `f[str, int]`, or none if what's
## there isn't all types.
def bracket_types(index: Expr) -> list[TypeExpr]:
    match index.kind:
        # `f[str, int]` has two types; `f[(int, int)]` has one, a tuple, whose span starts at
        # its `(` rather than at its first item.
        case .Tuple(items) if items.len() > 0 and items[0].span.start == index.span.start:
            return as_types(items, sizes=False) else []
        case _: pass
    one = as_type(index)
    if one is None:
        return []
    [one]

## The type a default makes with its type arguments, like `list[Token]` for `list[Token]()`.
def made_type(default: Expr) -> TypeExpr?:
    match default.kind:
        case .Call(callee, _):
            match callee.kind:
                case .Index(_, _): as_type(callee)
                case _: None
        case _: None

## An expression read as a type: `Token`, or `list[Token]`, or `dict[str, int]`.
def as_type(expr: Expr) -> TypeExpr?:
    match expr.kind:
        case .Name(name): TypeExpr(name=name, args=[], optional=False, span=expr.span)
        case .Index(object, index):
            match object.kind:
                case .Name(name):
                    mut args = []
                    match index.kind:
                        # `dict[str, int]` has two types; `list[(int, int)]` has one, a tuple,
                        # whose span starts at its `(` rather than at its first item.
                        case .Tuple(items) if items.len() > 0 and items[0].span.start == index.span.start:
                            found = as_types(items, sizes=True)
                            if found is None:
                                return None
                            args = found
                        case _:
                            found = as_type(index)
                            if found is None:
                                return None
                            args.append(found)
                    TypeExpr(name=name, args=args, optional=False, span=expr.span)
                case _: None
        case .Tuple(items):
            found = as_types(items, sizes=False)
            if found is None:
                return None
            TypeExpr(name="tuple", args=found, optional=False, span=expr.span)
        case _: None


## A type in brackets with others, or a number there: an array's size, `16` in
## `array[float, 16]`.
def as_type_or_size(item: Expr) -> TypeExpr?:
    match item.kind:
        case .Int(size): TypeExpr(name=f"{size}", args=[], optional=False, span=item.span)
        case _: as_type(item)

def as_types(items: list[Expr], sizes: bool) -> list[TypeExpr]?:
    mut types = []
    for item in items:
        found = as_type_or_size(item) if sizes else as_type(item)
        if found is None:
            return None
        types.append(found)
    types
