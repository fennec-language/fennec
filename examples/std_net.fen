# decision: `std.net` is shaped like Python's `socket` and `requests`, and every call blocks.

# `std.net` reaches the network through the `Net` capability. Every call waits until it's
# done. In a test, `Net` is a fake: the test's own servers are at `localhost`, and its
# clients reach them in memory, so a test can play both sides.
from std.net import Connection, NetError, Response
from std.time import Duration

def reason[T](run: () -> T fails NetError) -> str:
    error = failure_of(run) else:
        return "it worked"
    error.message()

## The next line a connection is sent, or "" once the other side is done.
def line_of(conn: Connection) -> str fails NetError:
    conn.read_line()? else ""

## Every line a connection is sent, until the other side is done.
def lines_of(conn: Connection) -> list[str] fails NetError:
    list(conn.lines()?)

## Connects to `host` and hangs up, to see how connecting goes.
def connecting(net: Net, host: str, port: int) fails NetError:
    with net.connect(host, port)? as _:
        pass

## Listens on `port` and stops, to see how listening goes.
def listening(net: Net, port: int) fails NetError:
    with net.listen(port)? as _:
        pass

test "a line goes there and back"(net: Net):
    with net.listen(9000)? as server:
        with net.connect("localhost", 9000)? as client:
            client.write("hello\n")?
            with server.accept()? as conn:
                assert conn.read_line()? == "hello"
                conn.write("hello yourself\n")?
            assert client.read_line()? == "hello yourself"
            assert client.read_line()? is None

test "lines gives each line until the other side is done"(net: Net):
    with net.listen(9000)? as server:
        with net.connect("localhost", 9000)? as client:
            assert client.peer == "localhost:9000"
            client.write("one\ntwo\n")?
        with server.accept()? as conn:
            assert list(conn.lines()?) == ["one", "two"]

test "looping over a server gives each connection as it comes"(net: Net):
    with net.listen(0)? as server:
        with net.connect("localhost", server.port)? as first:
            with net.connect("localhost", server.port)? as second:
                first.write("first\n")?
                second.write("second\n")?
                mut heard = list[str]()
                for conn in server:
                    heard.append(line_of(conn)?)
                    if heard.len() == 2: break
                assert heard == ["first", "second"]

test "a server gives each connection its own task"(net: Net):
    with net.listen(9000)? as server:
        for name in ["ash", "kit"]:
            with net.connect("localhost", 9000)? as client:
                client.write(f"{name}\n")?
        # In a test, a server's loop ends once no connection is waiting.
        heard = [lines_of(conn) else [] for conn in parallel(server)]
        assert heard == [["ash"], ["kit"]]

test "bytes go as they are"(net: Net):
    with net.listen(9000)? as server:
        with net.connect("localhost", 9000, timeout=Duration.seconds(5.0))? as client:
            client.write(bytes([0, 255, 10, 7]))?
            with server.accept()? as conn:
                assert conn.read(2)? == bytes([0, 255])
                assert conn.read(10)? == bytes([10, 7])

test "a failure is a case of NetError"(net: Net):
    assert connecting(net, host="localhost", port=9001) fails.Refused(host="localhost", port=9001)

test "failures are NetError values"(net: Net):
    assert (
        reason(() => connecting(net, host="localhost", port=9001)?)
        == "`localhost` refused a connection on port 9001"
    )
    assert reason(() => connecting(net, host="example.com", port=80)?).startswith(
        "the test's fake `Net` reaches only",
    )
    with net.listen(9000)? as _:
        assert reason(() => listening(net, port=9000)?) == "port 9000 is already in use"

test "a packet goes to a port, and an answer goes to who sent it"(net: Net):
    with net.udp(port=9001)? as first:
        with net.udp()? as second:
            second.send_to("ping", "localhost:9001")?
            packet = first.receive()?
            assert packet.data == "ping".encode()
            assert packet.sender == f"localhost:{second.port}"
            first.send_to("pong".encode(), packet.sender)?
            assert second.receive()?.data == "pong".encode()

test "a packet sent where nothing listens is lost"(net: Net):
    with net.udp()? as socket:
        socket.send_to("gone", "localhost:9")?

test "a request gets what the test scripted, and says what was sent"(net: Net):
    net.script(
        "GET https://api.example.com/weather?city=Oslo",
        Response(status=200, body="sunny".encode()),
    )
    answer = net.get("https://api.example.com/weather", params={"city": "Oslo"})?
    assert answer.ok()
    assert answer.text() == "sunny"
    assert net.requests() == ["GET https://api.example.com/weather?city=Oslo"]

## What a weather API sends back.
struct Weather:
    city: str
    degrees: float

test "an answer's body is read as JSON into a struct"(net: Net):
    net.script(
        "GET https://api.example.com/weather?city=Oslo",
        Response(status=200, body="{\"city\": \"Oslo\", \"degrees\": -3.5}".encode()),
    )
    found = net.get("https://api.example.com/weather", params={"city": "Oslo"})?.json[Weather]()?
    assert found.city == "Oslo" and found.degrees == -3.5
    problem = failure_of(() => Response(status=200, body="{\"city\": 3}".encode()).json[Weather]()?)
    assert problem is not None
    assert problem.message == "`city` should be a str, but it's an int"

test "a status that isn't a 200 is still an answer"(net: Net):
    net.script("POST https://example.com/a", Response(status=404))
    answer = net.post("https://example.com/a", body="data")?
    assert answer.status == 404
    assert not answer.ok()

test "a request nothing scripted fails and says so"(net: Net):
    assert (
        "no answer for `DELETE https://example.com/`"
        in reason(() => net.request("delete", "https://example.com/")?)
    )

def main(stdout: Stdout, net: Net):
    # Port 0 lets the system pick a free port. One task can play both sides, since a small
    # write waits only until the system has it.
    with net.listen(0)? as server:
        with net.connect("127.0.0.1", server.port)? as client:
            client.write("ping\n".encode())?
            with server.accept()? as conn:
                stdout.print(conn.read_line()?)
                conn.write("pong\n")?
                stdout.print(client.read_line()?)
                # The server's end is still open but sends nothing more, so a read with a
                # timeout gives up.
                _ = client.read_line(timeout=Duration.millis(50)) else as why:
                    match why:
                        case .TimedOut(after=after):
                            stdout.print("nothing came in", after.as_millis(), "ms")
                        case _:
                            stdout.print("something came")
                    ""
