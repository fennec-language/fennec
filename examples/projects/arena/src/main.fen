## A small arena, split over several files.

from std.math import Vec3

from combat.damage import Dodged
import combat.damage
from enemies import Enemy, wave
import physics

def main(stdout: Stdout):
    mut enemies = wave(3)
    enemies.append(Enemy(name="boss", position=Vec3(x=9.0), rank=.Boss, health=250))
    for enemy in enemies:
        stdout.print(enemy.describe())

    mut body = physics.Body(position=Vec3.zero, velocity=Vec3(x=2.0, y=1.0))
    for _ in range(3):
        physics.step(ref body, 0.5)
    stdout.print(body.position)

    hit_value = combat.damage.hit(ref enemies[0], 30) except Dodged(): -1
    stdout.print(hit_value)
    stdout.print(enemies[0].health)
    for amount in [0, 50]:
        left = combat.damage.hit(ref enemies[3], amount) except why:
            case combat.damage.Dodged(name):
                stdout.print(f"the {name} dodged")
                continue
            case _:
                error = why
                stdout.print(f"no luck: {error}")
                continue
        stdout.print(f"the boss has {left} left")

    stdout.print(sum(enemy.health for enemy in enemies))
    stdout.print([enemy.is_down() for enemy in enemies])
