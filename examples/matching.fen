enum Shape:
    Circle(radius: float)
    Rect(width: float, height: float)
    Point

def name_int(n: int) -> str:
    match n:
        case 0:
            return "zero"
        case -1:
            return "minus one"
        case _:
            return "something else"

def name_float(x: float) -> str:
    match x:
        case 0.5:
            return "a half"
        case -0.5:
            return "minus a half"
        case _:
            return "something else"

def name_str(text: str) -> str:
    match text:
        case "fox":
            return "a fox"
        case _:
            return "not a fox"

def name_bool(flag: bool) -> str:
    match flag:
        case True:
            return "yes"
        case False:
            return "no"

def name_maybe(n: int?) -> str:
    match n:
        case None:
            return "nothing"
        case _:
            return "something"

def width(shape: Shape) -> str:
    match shape:
        # A pattern can name fewer fields than the case has.
        case .Rect(width):
            return f"{width} wide"
        case .Point:
            return "a point"
        case _:
            return "no width"

def main(stdout: Stdout):
    stdout.print(
        name_int(0),
        name_int(-1),
        name_int(1),
        name_float(0.5),
        name_float(-0.5),
        name_float(1.5),
    )
    stdout.print(name_maybe(None), name_maybe(0))
    stdout.print(name_str("fox"), name_str("cat"), name_bool(True), name_bool(False))
    stdout.print(width(.Rect(width=2.0, height=1.0)), width(.Point), width(.Circle(radius=1.0)))

    # A tuple pattern has as many parts as the tuple it matches.
    pair = (0, 4)
    match pair:
        case (0, y):
            stdout.print(f"on the y axis at {y}")
        case (x, y):
            stdout.print(f"at {x}, {y}")
    triple = (2, 3, 1)
    match triple:
        case (0, y, _):
            stdout.print(f"on the y axis at {y}")
        case _:
            stdout.print("three numbers")
    empty = ()
    match empty:
        case ():
            stdout.print("no numbers")
