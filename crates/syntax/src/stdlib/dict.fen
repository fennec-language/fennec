## `dict`'s methods written in Fennec. Reading, writing and walking its pairs are machine
## operations the engines provide.
extend dict[K: Hashable, V]:
    ## Adds every pair of `more`, replacing the values of keys it already has.
    def update(ref self, more: dict[K, V]):
        for key, value in more.items():
            self[key] = value

    ## The value of `key`, adding `default` as its value when it has none.
    def setdefault(ref self, key: K, default: V) -> V:
        if key in self: return self[key]
        self[key] = default
        default

    ## Takes `key` out, giving back its value, or `None` when it isn't there: `pop` for a key that
    ## may be missing, as `get` is to `self[key]`.
    def remove(ref self, key: K) -> V?:
        if key not in self: return None
        self.pop(key)

extend dict[K: Hashable & Serializable, V: Serializable]:
    def serialize(self, ref out: Serializer):
        out.map(self.items())

extend dict[K: Hashable & Deserializable, V: Deserializable]:
    def deserialize(ref src: Deserializer) -> dict[K, V] fails ParseError:
        mut found = dict[K, V]()
        count = src.map_count()?
        if count >= 0:
            # Read straight into the dict, with no list of pairs on the way.
            for _ in range(count):
                key = src.value[K]()?
                found[key] = src.value[V]()?
            src.end_map()
            return found
        for key, value in src.map[K, V]()?:
            found[key] = value
        found
