# Loops over the same buckets side by side and one inside another, all leaning on one check.
def scan(starts: list[int], order: list[int]) -> int:
    mut total = 0
    for cell in range(len(starts) - 1):
        for at in range(starts[cell], starts[cell + 1]):
            total += order[at]
            for again in range(starts[cell], starts[cell + 1]):
                total += order[again] * order[at]
        for back in range(starts[cell], starts[cell + 1]):
            total -= order[back]
    return total

def main(stdout: Stdout):
    stdout.print(scan([0, 2, 3, 6], order=[1, 2, 3, 4, 5, 6]))
    stdout.print(scan([0, 2, 3, 7], order=[1, 2, 3, 4, 5, 6]))
