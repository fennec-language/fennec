# `shared` values holding blocks, changed from every worker: by method and by field under `lock`, read, given
# strings and lists from outside, handing them back, through what holds a handle, and with a
# constant and a long literal stored inside. What crosses a lock's edge is copied, and everything
# a value holds has to stay readable from every thread, or these come out wrong.

DEFAULTS = ["one with a really rather long string in it", "two"]

struct Point:
    x: int
    name: str

struct Unit:
    x: int

struct Log:
    lines = list[str]()
    count = 0
    name = "a log with a long enough name to have a block"
    seen = {"start": 0}

    def add(ref self, line: str):
        self.lines.append(line)
        self.count += 1
        self.seen[line] = self.count

    def size(self) -> int:
        return len(self.lines)

struct Board:
    points = [Point(x=0, name="the very first point on this board")]
    best = Point(x=0, name="the best point on this board so far")

    def put(ref self, point: Point):
        self.points.append(point)
        if point.x > self.best.x:
            self.best = point

    def top(self) -> Point:
        return self.best

struct Table:
    rows = list[str]()
    kept = list[str]()

    def fill(ref self):
        self.rows = DEFAULTS
        self.kept.append("a literal that is much too long to fit inside a header")

    def rows_now(self) -> list[str]:
        return self.rows

struct Grid:
    cells = [[1, 2], [3, 4]]
    maybe: int? = None

    def bump(ref self, row: int, by: list[int]):
        self.cells[row].append(by[0])
        self.cells[row][0] += len(by)
        self.maybe = len(self.cells[row])

struct Box:
    items = [1, 2, 3]
    total = 0

struct Purse:
    notes = list[str]()
    total = 0
    biggest = Point(x=0, name="the biggest note so far in this purse")

struct Holder:
    box: shared Box
    name: str

def touch(holder: Holder, n: int) -> int:
    lock holder.box as ref held:
        held.items[0] = n
        held.total += 1
        return held.total * 0 + len(holder.name)

def units_of(count: int) -> list[Unit]:
    return [Unit(n) for n in range(count)]

def logs(stdout: Stdout):
    shared log = Log()
    mut units = units_of(4000)
    for ref unit in parallel(units):
        lock log as ref held:
            held.add(f"unit number {unit.x} with a long line of text here")
            unit.x = held.size() % 1 + unit.x
    walked = sum(unit.x for unit in parallel(units))
    lock log as held:
        stdout.print(held.count, len(held.lines), held.size(), len(held.seen))
        stdout.print(held.name, walked)

def boards(stdout: Stdout):
    shared board = Board()
    mut units = units_of(3000)
    for ref unit in parallel(units):
        lock board as ref held:
            held.put(Point(x=unit.x, name=f"point {unit.x} with a long enough name"))
            kept = held.top()
            unit.x = kept.x % 1 + unit.x
    lock board as held:
        stdout.print(len(held.points), held.top().x, held.best.name)
    stdout.print(sum(unit.x for unit in parallel(units)))

def tables(stdout: Stdout):
    shared table = Table()
    mut units = units_of(2000)
    for ref unit in parallel(units):
        lock table as ref held:
            held.fill()
            unit.x += len(held.rows_now())
    lock table as held:
        stdout.print(held.rows, len(held.kept), len(DEFAULTS))
    stdout.print(sum(unit.x for unit in parallel(units)))

def grids(stdout: Stdout):
    shared grid = Grid()
    given = [5, 6, 7]
    mut units = units_of(2000)
    for ref unit in parallel(units):
        lock grid as ref held:
            held.bump(unit.x % 2, given)
        unit.x += len(given)
    lock grid as held:
        stdout.print(len(held.cells[0]), len(held.cells[1]), held.cells[0][0], held.maybe, given)
    stdout.print(sum(unit.x for unit in parallel(units)))

def holders(stdout: Stdout):
    shared one = Box()
    shared two = Box()
    held = [
        Holder(box=one, name="the first holder of them all, quite long"),
        Holder(box=two, name="b"),
    ]
    mut units = units_of(2000)
    for ref unit in parallel(units):
        unit.x += touch(held[unit.x % 2], unit.x)
    lock one, two as first, second:
        stdout.print(first.total, second.total, first.total)
    stdout.print(sum(unit.x for unit in parallel(units)))
    mut both = 0
    lock one, two as first, second:
        both = len(first.items) + len(second.items)
    stdout.print(both)

def passed_along(from_purse: shared Purse, to_purse: shared Purse, n: int):
    lock from_purse, to_purse as ref source, ref target:
        made = f"a note made here, long enough to be a block {n}"
        source.notes.append(made)
        source.total += 1
        target.notes = [note for note in source.notes if len(note) % 2 == 0]
        target.total += len(source.notes) % 1
        if n > source.biggest.x:
            source.biggest = Point(x=n, name=f"the biggest note, number {n}, in this purse")
            target.biggest = source.biggest
        source.notes = [made]

def read_across(mine: shared Purse, other: shared Purse) -> int:
    mut seen = 0
    lock mine, other as ref held, looked:
        held.notes = looked.notes
        seen = len(held.notes) % 1
    return seen

def purses(stdout: Stdout):
    shared one = Purse()
    shared two = Purse()
    mut units = units_of(2000)
    for ref unit in parallel(units):
        if unit.x % 2 == 0:
            passed_along(one, to_purse=two, n=unit.x)
        else:
            passed_along(two, to_purse=one, n=unit.x)
        unit.x += read_across(one, other=two)
    walked = sum(unit.x for unit in parallel(units))
    lock one, two as first, second:
        stdout.print(
            first.total + second.total,
            first.biggest.x,
            second.biggest.x,
            first.biggest.name,
        )
        # How many there are depends on the order the bodies ran in; what each one says doesn't.
        damaged = [note for note in first.notes + second.notes if note[0:6] != "a note"]
        stdout.print(damaged, walked)

struct Tally:
    total = 0
    point = 0.5

def counted_with_text(tally: shared Tally, log: shared Log, n: int):
    lock tally, log as ref counting, ref logging:
        counting.total += 1
        logging.lines.append(f"line {counting.total % 1} from body number {n % 1} of them all")
        logging.count += 1

def mixed(stdout: Stdout):
    shared tally = Tally()
    shared log = Log()
    mut units = units_of(2000)
    for ref unit in parallel(units):
        counted_with_text(tally, log=log, n=unit.x)
        lock log, tally as held, seen:
            unit.x += len(held.lines) % 1 + seen.total % 1
    lock tally, log as counted, held:
        stdout.print(counted.total, held.count, len(held.lines), held.lines[0])

def main(stdout: Stdout):
    logs(stdout)
    mixed(stdout)
    purses(stdout)
    boards(stdout)
    tables(stdout)
    grids(stdout)
    holders(stdout)
