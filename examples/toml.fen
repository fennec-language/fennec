# decision: JSON and TOML read into plain values.
# decision: Bad text fails with `ParseError`.

from std import json, toml

struct Kit:
    name: str
    version: str
    fennec: str
    description: str
    authors: list[str]
    license: str
    capabilities: list[str]
    released: str

struct Dependency:
    version: str
    path = ""

struct Bin:
    name: str
    main: str

struct Release:
    profile: bool
    budget_mb: int
    scale: float

struct Build:
    release: Release

## A `kit.toml`.
struct Manifest:
    kit: Kit
    dependencies: dict[str, Dependency]
    bin: list[Bin]
    build: Build

## The kinds of value TOML knows.
struct Sample:
    speed = 0
    angle = 0.0
    at = ""
    empty = list[int]()

struct Window:
    title = "Fox Run"
    width = 1280
    height = 720
    vsync = True

def kit_toml() -> str:
    "\n".join([
        "# The kit a Fennec project describes itself with.",
        "[kit]",
        "name = \"fox-run\"",
        "version = \"0.3.1\"",
        "fennec = \"0.1\"",
        "description = \"\"\"",
        "A small game about a fennec fox \\",
        "    who runs very fast.\"\"\"",
        "authors = [\"Ash <ash@example.com>\", 'Kit']",
        "license = 'MIT OR Apache-2.0'",
        "capabilities = [\"Stdout\", \"Fs\"]",
        "released = 2026-10-30",
        "",
        "[dependencies]",
        "vecmath = { version = \"1.2\" }",
        "sprites = { version = \"0.4\", path = \"../sprites\" }",
        "",
        "[[bin]]",
        "name = \"game\"",
        "main = \"src/main.fen\"",
        "",
        "[[bin]]",
        "name = \"editor\"",
        "main = \"tools/editor.fen\"",
        "",
        "[build.release]",
        "profile = true",
        "budget_mb = 1_024",
        "scale = 1.5e0",
    ])

def describe(text: str) -> str:
    sample = toml.loads[Sample](text) else as why:
        match why:
            case ParseError(message=message):
                return f"couldn't read it: {message}"
    f"read {sample}"

def main(stdout: Stdout):
    manifest = toml.loads[Manifest](kit_toml())?
    stdout.print(manifest.kit.name, manifest.kit.version, "for Fennec", manifest.kit.fennec)
    stdout.print(manifest.kit.description)
    stdout.print(manifest.kit.authors, manifest.kit.released)
    for name, dependency in manifest.dependencies.items():
        stdout.print("needs", name, dependency.version)
        if dependency.path != "":
            stdout.print("  from", dependency.path)
    for bin in manifest.bin:
        stdout.print(bin.name, "starts at", bin.main)
    stdout.print(manifest.build.release)

    stdout.write(toml.dumps(manifest))
    stdout.print("---")
    stdout.write(toml.dumps(Window()))
    stdout.print(toml.loads[Manifest](toml.dumps(manifest))? == manifest)

    stdout.print(describe("speed = 0x10\nangle = -0.5\nat = 07:30:00\nempty = []"))
    stdout.print(describe("name = \"fox\"\nname = \"kit\""))
    stdout.print(describe("[kit]\nversion = 1.2.3"))
    stdout.print(describe("[kit\nname = \"fox\""))
    stdout.print(describe("title = \"never ends\nname = \"fox\""))
    stdout.print(describe("[kit]\nname = \"fox\"\n[kit]"))

## Why `text` can't be read as a `Sample`, or "" if it can.
def why_not(text: str) -> str:
    _ = toml.loads[Sample](text) else as why:
        match why:
            case ParseError(message=message):
                return message
    ""

test "tables a header or a dotted key names count toward how deep TOML may nest"():
    for deep in [600, 1000000]:
        assert "nest more than 500 deep" in why_not("[" + "a." * deep + "a]\n")
        assert "nest more than 500 deep" in why_not("a." * deep + "a = 1\n")
        assert (
            "nest more than 500 deep" in why_not("[" + "a." * 300 + "a]\n" + "b." * 300 + "b = 1\n")
        )
    # As deep as it may go, it's read, and only then found not to be a `Sample`.
    assert why_not("[" + "a." * 400 + "a]\n") == "`Sample` has no field \"a\", but the text has one"

test "inline tables in inline tables count toward how deep TOML may nest"():
    for deep in [600, 1000000]:
        assert (
            "nest more than 500 deep" in why_not("a = " + "{a = " * deep + "1" + "}" * deep + "\n")
        )
        assert (
            "nest more than 500 deep"
            in why_not("a = " + "{a = [" * deep + "1" + "]}" * deep + "\n")
        )

test "TOML may nest 500 deep and no deeper, however it's written"():
    fits = "`Sample` has no field \"a\", but the text has one"
    # A header names as many tables as its key has parts.
    assert why_not("[" + "a." * 499 + "a]\n") == fits
    assert "nest more than 500 deep" in why_not("[" + "a." * 500 + "a]\n")
    # A dotted key's parts before its last are tables the value is in.
    assert why_not("a." * 500 + "a = 1\n") == fits
    assert "nest more than 500 deep" in why_not("a." * 501 + "a = 1\n")
    # Arrays and inline tables count, empty ones too.
    assert why_not("a = " + "[" * 500 + "]" * 500 + "\n") == fits
    assert "nest more than 500 deep" in why_not("a = " + "[" * 501 + "]" * 501 + "\n")
    assert why_not("a = " + "{a = " * 499 + "{}" + "}" * 499 + "\n") == fits
    assert "nest more than 500 deep" in why_not("a = " + "{a = " * 500 + "{}" + "}" * 500 + "\n")

test "a JSON read that fails leaves nothing behind for the next read"():
    assert (
        failure_of(() => json.loads[Sample]("not json", names=.CamelCase, extra=.Ignore)?)
        is not None
    )
    assert (
        why_not("speed = 1\nother = 2\n") == "`Sample` has no field \"other\", but the text has one"
    )
