# A dict's value handed on by `ref` inside the loop written twice.
def note(ref seen: list[int], value: int):
    seen.append(value)
    return

def scan(ref groups: dict[int, list[int]], starts: list[int], order: list[int]):
    for at in range(starts[0], starts[1]):
        value = order[at]
        key = value % 2
        if key not in groups:
            groups[key] = []
        note(ref groups[key], value=value)
    return

def main(stdout: Stdout):
    mut groups = dict[int, list[int]]()
    scan(ref groups, starts=[0, 4], order=[5, 6, 7, 8])
    kept = groups
    scan(ref groups, starts=[1, 3], order=[5, 6, 7, 8])
    stdout.print(groups, kept)
