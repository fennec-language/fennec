## Small helpers whose names `main.fen` reuses for its own values.

error Missing:
    value: int

def total(items: list[int]) -> int:
    return sum(items)

def first(items: list[int]) -> int:
    return items[0]

def scale() -> int:
    return 1

def index() -> int:
    return 0

def count() -> int:
    return 0

def size() -> int:
    return 0

def step() -> int:
    return 0

def find(items: list[int], value: int) -> int fails Missing:
    for at in range(len(items)):
        if items[at] == value: return at
    fail Missing(value)

test "find gives the position":
    assert find([1, 2], 2)? == 1
