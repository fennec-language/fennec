## A dict keyed by a plain struct, like a grid's cells.

struct Cell:
    x: int
    y: int

def main(stdout: Stdout):
    mut seen: dict[Cell, int] = {}
    for i in range(5_000):
        cell = Cell(x=i * 31 % 101, y=i * 17 % 103)
        seen[cell] = seen.get(cell, 0) + 1
    stdout.print(seen.len(), seen[Cell(x=0, y=0)])
