error NotFound:
    name: str

error TooWeak:
    level: int

struct Player:
    name: str
    level = 1

def find(players: list[Player], name: str) -> Player?:
    for player in players:
        if player.name == name: return player
    return None

def require(players: list[Player], name: str) -> Player fails NotFound:
    player = find(players, name)
    if player is None: fail NotFound(name)
    return player

def challenge(players: list[Player], name: str) -> str fails NotFound | TooWeak:
    player = require(players, name)?
    if player.level < 5: fail TooWeak(player.level)
    return f"{player.name} accepts the challenge"

def main(stdout: Stdout):
    players = [Player(name="Ash", level=7), Player(name="Kit")]

    # A chain ending in `else` stops at the first missing step and gives the default.
    stdout.print(find(players, "Kit").level else 0)
    stdout.print(find(players, "Vex").level else 0)

    for name in ["Ash", "Kit", "Vex"]:
        message = challenge(players, name) except why:
            case TooWeak(level):
                stdout.print(f"{name} is only level {level}")
                continue
            case _:
                error = why
                stdout.print(f"no luck: {error}")
                continue
        stdout.print(message)

    nobody = Player(name="nobody", level=-1)
    require_value = require(players, "Vex") except NotFound(): nobody
    level = (require_value).level
    stdout.print(level)
    found = require(players, "Ash").expect("Ash was added above")
    stdout.print(found.name)
    _ = challenge(players, "Kit") except why:
        stdout.print(why == TooWeak(level=1))
        ""
