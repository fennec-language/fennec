# JSON has no NaN, so writing one is a bug in the program, and `json.dumps` stops saying where.
from std import json

struct Reading:
    label: str
    values: list[float]

def main(stdout: Stdout):
    broken = float("nan") except InvalidValue(): 0.0
    readings = [Reading(label="a", values=[1.0]), Reading(label="b", values=[2.0, broken])]
    stdout.print(json.dumps(readings))
