## `std.sql`: what every database gives, so code written against it works with any of them. A
## query is a template string, `t"..."`, and each `{}` in it is a `SqlValue`, which the database
## is given apart from the query's text, as a parameter. So a value is never part of the text, and
## SQL injection can't be written. Rows come back as any type that loads, a struct's fields
## matched to the columns by name, as `json.loads[T]` matches keys:
##
## ```fennec
## struct Entry:
##     path: str
##     size: int
##
## rows = db.query[Entry](t"select path, size from entries where size > {least}")?
## ```
##
## `std.sqlite` is the first database under it. A driver turns what its database sends back into
## `SqlRows`, and `rows_as` reads them into the type asked for, the same way for every driver.

from std.intrinsics import new_tag
from std.string import quoted_input

## What can go into a query, as a parameter. A `bool` goes in as 1 or 0.
export type SqlValue = int | float | str | bytes | bool

## How a database failed. `message()` says it in words.
export error SqlError:
    ## A rule of the table's refused a change: a `unique` or `primary key` already taken, a
    ## `not null`, a `check` or a foreign key.
    Constraint(reason: str)
    ## Another writer held the database for longer than the wait.
    Busy(reason: str)
    ## A row's column doesn't fit the field it's read into, or a field has no column.
    Column(name: str, reason: str)
    ## Anything else: a query the database refused, or a file it couldn't open or read.
    Failed(reason: str)

    ## What went wrong, in words.
    def message(self) -> str:
        match self:
            case .Column(name, reason):
                return f"column `{name}`: {reason}"
            case Constraint(reason) | Busy(reason) | Failed(reason):
                return reason

## A database, or a transaction in one: what runs queries.
export interface Sql:
    ## Runs a query that changes something, like an `insert`, and gives how many rows it changed.
    def execute(self, query: Template[SqlValue]) -> int fails SqlError

    ## Runs a query and gives each row it found as a `T`.
    def query[T: Deserializable](self, query: Template[SqlValue]) -> list[T] fails SqlError

## What a query found, as a driver hands it over: each row's cells in column order, one row after
## another. `kinds` says what each cell holds: 0 for null, 1 an int, 2 a float, 3 text and 4
## bytes, and `at` where it is in the list of its kind. A driver fills one and gives it to
## `rows_as`, which reads each row into the type the query asked for.
export struct SqlRows:
    columns: list[str]
    kinds: list[int]
    at: list[int]
    ints: list[int]
    floats: list[float]
    texts: list[str]
    blobs: list[bytes]

## Each row as a `T`: a struct's fields by the columns' names, or a single column as a value of
## its own. A column that doesn't fit, a field with no column and a column with no field each fail
## with `SqlError.Column`, naming it.
export def rows_as[T: Deserializable](rows: SqlRows) -> list[T] fails SqlError:
    width = len(rows.columns)
    count = 0 if width == 0 else len(rows.kinds) // width
    mut src = SqlRowReader(_rows=rows, _width=width)
    mut found = list[T]()
    for row in range(count):
        src._row = row
        src._cell = 0
        src._in_record = False
        value = T.deserialize(ref src) except err:
            # A field with no column says so with no line, and its name as the message.
            if err.line < 0:
                fail .Column(name=err.message, reason="the query gives no column for this field")
            fail .Column(name=src._column(), reason=err.message)
        found.append(value)
    return found

## Reads a row into a value, through its `deserialize`: a struct's fields by the columns' names,
## or a single column as a value of its own.
struct SqlRowReader:
    _rows: SqlRows
    _width: int
    _row = 0
    ## The column being read, in the row.
    _cell = 0
    _in_record = False
    _type = ""
    _field = 0
    ## The fields the row being read has filled, so a second column for one is refused.
    _filled = list[int]()

    def _column(self) -> str:
        return self._rows.columns[self._cell] if self._cell < self._width else ""

    def _bad(self, message: str) -> ParseError:
        return ParseError(message=message, line=self._row + 1, column=self._cell + 1)

    ## Where the cell being read is, in the lists of `SqlRows`, after checking there's one.
    def _here(self) -> int fails ParseError:
        if not self._in_record and self._width != 1:
            fail self._bad(
                f"a row of {self._width} columns can't be read as one value: read it into a struct",
            )
        return self._row * self._width + self._cell

    def _kind(self) -> int fails ParseError:
        return self._rows.kinds[self._here()?]

    def _wrong(self, kind: int, wanted: str) -> ParseError:
        held = ["null", "an int", "a float", "text", "bytes"][kind]
        return self._bad(f"it holds {held}, not {wanted}")

    def int(ref self) -> int fails ParseError:
        kind = self._kind()?
        if kind != 1: fail self._wrong(kind, "an int")
        return self._rows.ints[self._rows.at[self._here()?]]

    def float(ref self) -> float fails ParseError:
        kind = self._kind()?
        at = self._rows.at[self._here()?]
        if kind == 1: return float(self._rows.ints[at])
        if kind != 2: fail self._wrong(kind, "a float")
        return self._rows.floats[at]

    def bool(ref self) -> bool fails ParseError:
        kind = self._kind()?
        if kind != 1: fail self._wrong(kind, "a bool")
        n = self._rows.ints[self._rows.at[self._here()?]]
        if n != 0 and n != 1: fail self._bad(f"it holds {n}, and a bool is 0 or 1")
        return n == 1

    def text(ref self) -> str fails ParseError:
        kind = self._kind()?
        if kind != 3: fail self._wrong(kind, "text")
        return self._rows.texts[self._rows.at[self._here()?]]

    def bytes(ref self) -> bytes fails ParseError:
        kind = self._kind()?
        at = self._rows.at[self._here()?]
        if kind == 3: return self._rows.texts[at].encode()
        if kind != 4: fail self._wrong(kind, "bytes")
        return self._rows.blobs[at]

    def none(ref self) -> bool fails ParseError:
        return self._kind()? == 0

    def value[T: Deserializable](ref self) -> T fails ParseError:
        return T.deserialize(ref self)?

    def sequence[T: Deserializable](ref self) -> list[T] fails ParseError:
        fail self._bad("a column holds one value, not a list")

    def map[K: Deserializable, V: Deserializable](ref self) -> list[(K, V)] fails ParseError:
        fail self._bad("a column holds one value, not a dict")

    def items(ref self, name: str, count: int) fails ParseError:
        fail self._bad(f"a column holds one value, not a `{name}`")

    def item[T: Deserializable](ref self) -> T fails ParseError:
        fail self._bad("a column holds one value, not a tuple")

    def end_items(ref self) fails ParseError:
        pass

    def record(ref self, name: str) fails ParseError:
        if self._in_record: fail self._bad(f"a column holds one value, not a `{name}`")
        self._in_record = True
        self._type = name
        self._cell = -1
        self._filled = list[int]()

    def next_field(ref self, fields: list[(str, str)]) -> bool fails ParseError:
        self._cell += 1
        if self._cell >= self._width: return False
        name = self._column()
        for at, field in enumerate(fields):
            if field[0] != "" and field[0] == name:
                # Which of two columns to believe would be a guess, as JSON refuses a key twice.
                if at in self._filled: fail self._bad("the query gives this column twice")
                self._filled.append(at)
                self._field = at
                return True
        fail self._bad(f"`{self._type}` has no field called `{name}`")

    def field_at(self) -> int:
        return self._field

    def missing(self, name: str) -> ParseError:
        return ParseError(message=name, line=-1, column=0)

    def rule(self, message: str) -> ParseError:
        return self._bad(message)

    def at_item(self, at: int, message: str) -> ParseError:
        return self._bad(f"item {at} {message}")

    def here(self, message: str) -> ParseError:
        return self._bad(message)

    def saw_id(ref self, kind: str, position: int):
        pass

    def saw_table(ref self, kind: str, count: int):
        pass

    def tag(ref self, kind: str) -> int:
        return new_tag()

    ## A null in a field that isn't optional fails, saying so, rather than taking its default.
    def none_next(ref self) -> bool:
        return False

    def exact(self) -> bool:
        return False

    def ordered(ref self, name: str) -> bool fails ParseError:
        return False

    def end_ordered(ref self):
        pass

    def map_count(ref self) -> int fails ParseError:
        return -1

    def end_map(ref self):
        pass

    ## A case with no data, by its name as text.
    def enum_case(ref self, name: str, cases: list[(str, bool)]) -> int fails ParseError:
        held = self.text()?
        for at, case_name in enumerate(cases):
            if case_name[0] == held:
                if case_name[1]:
                    fail self._bad(f"`{name}.{held}` has data, which a column can't hold")
                return at
        fail self._bad(f"{quoted_input(held)} isn't a case of `{name}`")

    def end_case(ref self) fails ParseError:
        pass

    def member(ref self, names: list[str]) -> int fails ParseError:
        union = " | ".join(names)
        fail self._bad(f"a column can't hold a `{union}` yet")

    def end_member(ref self) fails ParseError:
        pass
