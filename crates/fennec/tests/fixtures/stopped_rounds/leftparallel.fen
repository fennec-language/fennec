# A round's handler launches a task and waits for it at its own block's end, when the serving
# task's block ends and stops it. The round is cancelled and leaves its task behind. The task had
# long finished a `parallel` call whose pieces sleep, and was asleep.
from std.concurrent import Crashed
from std.net import NetError, Request, Response, Server

def slept(number: int, clock: Clock, stdout: Stdout) -> int:
    clock.sleep(3ms)
    stdout.print("slept", number)
    return number

def napping(clock: Clock, stdout: Stdout):
    found = [slept(number, clock=clock, stdout=stdout) for number in parallel([1, 2, 3, 4, 5, 6])]
    stdout.print("the napping one counted", len(found))
    clock.sleep(2h)
    stdout.print("the napping one never said")

def waited(clock: Clock, stdout: Stdout) fails Crashed:
    with launch(() => napping(clock, stdout=stdout))?:
        pass

def answered(request: Request, clock: Clock, stdout: Stdout) -> Response:
    if request.path == "/slow":
        stdout.print("the slow one began")
        waited(clock, stdout=stdout) except why:
            stdout.print("the slow one's task crashed", f"{why}")
        stdout.print("the slow one's block ended")
    return Response(status=200, body=f"hello {request.path}".encode())

def serving(server: Server, clock: Clock, stdout: Stdout):
    server.serve((request) => answered(request, clock=clock, stdout=stdout))
    stdout.print("the server never said")

def main(net: Net, clock: Clock, stdout: Stdout) fails NetError | Crashed:
    with net.listen(0)? as server:
        port = server.port
        with net.connect("127.0.0.1", port)? as slow:
            slow.write("GET /slow HTTP/1.1\r\nhost: here\r\n\r\n")?
            with launch(() => serving(server, clock=clock, stdout=stdout), stop_after=400ms)?:
                got = net.get(f"http://127.0.0.1:{port}/one")?
                stdout.print(got.text())
    stdout.print("the server is over")
