# Shared values changed from every worker: by a method under `lock`, by fields under it, read, and
# two taken in opposite orders by the same body, which stays out of a deadlock because one `lock`
# takes them both in one order.

struct Counter:
    total = 0
    peak = 0.5

    def add(ref self, amount: int):
        self.total += amount
        self.peak = self.peak * 1.0

    def seen(self) -> int:
        return self.total

struct Unit:
    x: int

def main(stdout: Stdout):
    shared first = Counter()
    shared second = Counter(total=5)
    mut units = [Unit(n % 100) for n in range(50_000)]
    for ref unit in parallel(units):
        lock first as ref counting:
            counting.add(unit.x)
        lock first, second as ref firsts, ref seconds:
            firsts.total += 1
            seconds.total += 2
        lock second, first as ref seconds, ref firsts:
            seconds.total += firsts.total % 2
            seconds.total -= firsts.total % 2
        lock first, second as counted, other:
            unit.x += counted.total % 1 + other.seen() % 1
    walked = sum(unit.x for unit in parallel(units))
    lock first, second as counted, other:
        stdout.print(counted.total, other.total, counted.peak, walked)
