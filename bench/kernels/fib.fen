## Naive recursive Fibonacci: the cost of a call and of checked integer math.

def fib(n: int) -> int:
    if n < 2: return n
    fib(n - 1) + fib(n - 2)

def main(stdout: Stdout, clock: Clock, args: Args):
    started = clock.now()
    stdout.print(fib(35))
    if args.len() > 0:
        stdout.print("kernel-ns", (clock.now() - started).nanos)
