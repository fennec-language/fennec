## The machine operations the standard library stands on. Each engine supplies the body. Only
## the standard library can import this module: a program uses `int`, `float` and `str`, which
## are written on top of it.
from std.collections import Id, Table

@intrinsic
export def int_add(a: int, b: int) -> int

@intrinsic
export def int_sub(a: int, b: int) -> int

@intrinsic
export def int_mul(a: int, b: int) -> int

@intrinsic
export def int_floordiv(a: int, b: int) -> int

@intrinsic
export def int_rem(a: int, b: int) -> int

@intrinsic
export def int_neg(a: int) -> int

@intrinsic
export def int_eq(a: int, b: int) -> bool

@intrinsic
export def int_lt(a: int, b: int) -> bool

@intrinsic
export def int_and(a: int, b: int) -> int

@intrinsic
export def int_or(a: int, b: int) -> int

@intrinsic
export def int_xor(a: int, b: int) -> int

@intrinsic
export def int_not(a: int) -> int

@intrinsic
export def int_shl(a: int, by: int) -> int

@intrinsic
export def int_shr(a: int, by: int) -> int

@intrinsic
export def int_wrapping_add(a: int, b: int) -> int

@intrinsic
export def int_wrapping_sub(a: int, b: int) -> int

@intrinsic
export def int_wrapping_mul(a: int, b: int) -> int

@intrinsic
export def int_to_float(a: int) -> float

@intrinsic
export def int_hash(a: int) -> int

@intrinsic
export def float_add(a: float, b: float) -> float

@intrinsic
export def float_sub(a: float, b: float) -> float

@intrinsic
export def float_mul(a: float, b: float) -> float

@intrinsic
export def float_div(a: float, b: float) -> float

@intrinsic
export def float_neg(a: float) -> float

@intrinsic
export def float_eq(a: float, b: float) -> bool

@intrinsic
export def float_lt(a: float, b: float) -> bool

@intrinsic
export def float_to_int(a: float) -> int

@intrinsic
export def float_bits(a: float) -> int

## The float with these bits, as `float_bits` gives them.
@intrinsic
export def float_of_bits(bits: int) -> float

## The byte at a place in a text's bytes, or -1 past its end.
@intrinsic
export def text_byte(text: str, at: int) -> int

## How many bytes a text has.
@intrinsic
export def text_size(text: str) -> int

## The part of a text between two places in its bytes, each where a character starts or at its end.
@intrinsic
export def text_part(text: str, start: int, end: int) -> str

## The character with a code, which has to be one.
@intrinsic
export def text_of_code(code: int) -> str

## A type's name as it's written. Only native code has types as it runs.
@intrinsic
export def type_name[T]() -> str

## The text in bytes `start` up to `end` of `data`, made straight from them, or the empty text when
## they aren't UTF-8, which bytes that are there never decode to. Both places have to be inside it.
@intrinsic
export def bytes_text(data: bytes, start: int, end: int) -> str

## From byte `at` of a text, the first that's `"`, `\` or a control character, or the text's
## size: where a JSON reader has to look closer.
@intrinsic
export def text_plain_end(text: str, at: int) -> int

## From byte `at` of a text, the first JSON writes escaped, or that starts a character it might:
## `"`, `\`, a control character, DEL or 194. Or the text's size.
@intrinsic
export def text_escape_at(text: str, at: int) -> int

## Whether a text's bytes from byte `start` on begin with all of `word`'s. False when `start` is
## negative or `word` would run past the text's end. Neither is copied.
@intrinsic
export def text_same_at(text: str, start: int, word: str) -> bool

## A byte builder, which a binary format writes into in place: empty, with room to grow. Only std
## writes into one, with the intrinsics below, and copies it to its exact size, `data[0:len(data)]`,
## before anything else sees it.
@intrinsic
export def bytes_builder() -> bytes

## Adds a byte, from 0 to 255, at a builder's end.
@intrinsic
export def bytes_push(ref data: bytes, byte: int)

## Adds a whole word at a builder's end, low byte first.
@intrinsic
export def bytes_push_word(ref data: bytes, bits: int)

## Adds a text's bytes at a builder's end.
@intrinsic
export def bytes_push_text(ref data: bytes, text: str)

## Adds bytes at a builder's end.
@intrinsic
export def bytes_push_bytes(ref data: bytes, more: bytes)

## Writes byte `at` of a builder again, which has to be one it holds.
@intrinsic
export def bytes_set(ref data: bytes, at: int, byte: int)

## A number for a type's shape: its fields in order, with their names and types, and its cases.
## It changes when any of them does, so a format that saves no names can refuse to read data
## written for another shape. Only native code has types as it runs.
@intrinsic
export def shape_hash[T]() -> int

## What a type's values save as, with every struct's field names and every enum's case names, as
## text `std.pack` writes beside the data, so bytes from an earlier version of the type load by
## name. Only native code has types as it runs.
@intrinsic
export def layout[T]() -> str

## Whether the kit's `pack.lock` has a type's layout as it is now, so `std.pack` can leave the
## layout out of what it writes and a reader still finds it.
@intrinsic
export def shape_locked[T]() -> bool

## The kit's `pack.lock`: a line for each layout its types have had, the shape's number in hex,
## then the layout. Empty when it has none.
@intrinsic
export def pack_lock() -> str

## A number that's the same for equal `Id`s and differs for others, to look one up by.
@intrinsic
export def id_key[T](id: Id[T]) -> int

## The `Id` of the item at `position` in a `Table` with the tag `tag` that nothing's been taken
## out of.
@intrinsic
export def id_at[T](position: int, tag: int) -> Id[T]

## The tag of the `Table` an `Id` is from.
@intrinsic
export def id_tag[T](id: Id[T]) -> int

## A `Table`'s tag, which its `Id`s have and no other `Table`'s do.
@intrinsic
export def table_tag[T](table: Table[T]) -> int

## A tag no `Table` has had.
@intrinsic
export def new_tag() -> int

## An empty `Table` with the tag `tag`.
@intrinsic
export def table_tagged[T](tag: int) -> Table[T]

## Each slot of a `Table` as it holds it: its generation where it has an item, and `-1` less
## the generation where the item was taken out.
@intrinsic
export def table_slots[T](table: Table[T]) -> list[int]

## A `Table` of a tag with these slots, as `table_slots` gives them, holding `items` in its slots
## in use, in order. There have to be as many items as slots in use, each generation has to fit
## in 32 bits, and a load checks both first.
@intrinsic
export def table_of_slots[T](tag: int, slots: list[int], items: list[T]) -> Table[T]

## The `Id` of a slot and generation in one number, as `id_key` gives it, into a `Table` of a tag.
@intrinsic
export def id_of_key[T](key: int, tag: int) -> Id[T]

## Ends the program, saying `message`, as a failed `assert` does.
@intrinsic
export def stop(message: str)

## A new channel holding up to `size` messages, by its number.
@intrinsic
export def channel_new(size: int) -> int

## A new channel to every listener, keeping the last `size` messages, by its number. Sending on
## it never waits: when it's full, the oldest message goes.
@intrinsic
export def channel_new_every(size: int) -> int

## Starts listening to channel `channel` from the next message sent, giving back the number to
## receive from in its place. A listener that falls behind fails, unless `drop_oldest`, when it
## goes on from the oldest message kept. Of a channel to one receiver, it's the channel's own.
@intrinsic
export def channel_listen(channel: int, drop_oldest: bool) -> int

## Sends `message` on channel `channel`, waiting while it's full, for at most `timeout_ns`, or as
## long as it takes when that's -1. 0 is sent, 1 closed and 2 timed out.
@intrinsic
export def channel_send[T](channel: int, message: T, timeout_ns: int) -> int

## The next message on channel `channel`, waiting as `channel_send` does. `why` is set to 0 for a
## message, 1 when it's closed and empty, and 2 when it timed out, which give back `None`.
@intrinsic
export def channel_receive[T](channel: int, timeout_ns: int, ref why: int) -> T?

## Closes channel `channel`: sends then fail, and receives take what's left, then fail.
@intrinsic
export def channel_close(channel: int)

## Lets go of channel `channel` and what's left in it, at the end of its `with` block.
@intrinsic
export def channel_free(channel: int)

## Marks `cleanup`, a function taking nothing, to run if the caller crashes before
## `crash_cleanup_done(cleanup)`: a `with` source's `else:`, for a block that crashes. It gives
## back how it failed, as text, said with the crash, or nothing when it didn't.
@intrinsic
export def crash_cleanup(cleanup: () -> str)

## Ends what `crash_cleanup(cleanup)` started, where the block ends or fails another way.
@intrinsic
export def crash_cleanup_done(cleanup: () -> str)

## Starts `task` beside the caller, and gives back its handle for `launch_end`. `task` is a
## closure taking nothing, which may fail.
@intrinsic
export def launch[F](task: F) -> int

## Where the `with launch` block ends: waits for task `task`, cutting its waits short after
## `stop_after_ns`, or never when that's -1, or at once when `failed`. `why` is set to 0 for a task
## that ended or was stopped, 1 for one that crashed, and 2 for one that failed, whose failure it
## gives back.
@intrinsic
export def launch_end[E](task: int, stop_after_ns: int, failed: bool, ref why: int) -> E?

## Whether the generator asking was let go right after the `yield` before this, and goes on
## only to leave: written in after each `yield` in a `with` source's block, so leaving runs the
## source's cleanup. Outside a generator, it's `False`.
@intrinsic
export def abandoning() -> bool
