## Enums held in blocks, as one that holds itself is, compare by case first: another case is
## unequal with no call, and the same case compares its fields, here a string, a list, a float, a
## itself and nothing at all. `!=` is the opposite, and a value is equal to itself.
enum Tok:
    Name(text: str)
    Punct(text: str)
    Parts(items: list[int])
    Float(value: float)
    Wrapped(inner: Tok)
    Eof

def main(stdout: Stdout):
    long = "a name long enough to need a block of its own"
    tokens = [
        Tok.Name("x"), Tok.Punct("("), Tok.Name(long), Tok.Parts([1, 2]), Tok.Float(0.0), Tok.Eof,
        Tok.Wrapped(.Name("x")),
    ]
    for token in tokens:
        stdout.print(
            token == .Punct("("),
            token == .Name("x"),
            token == .Name(long),
            token != .Parts([1, 2]),
            token == .Float(-0.0),
            token == .Eof,
            token == .Wrapped(.Name("x")),
            token == token,
        )
