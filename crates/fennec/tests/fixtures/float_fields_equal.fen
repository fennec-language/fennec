## Floats inside an enum's case and a struct's fields compare as Fennec compares floats: NaN equals
## NaN, -0.0 equals 0.0, and anything else by value. An enum of another case is unequal. A key found
## equal hashes alike, so a dict finds it, and takes it as the key it already has.
enum Reading:
    Value(x: float)
    Missing
    Named(name: str, x: float)

struct Point:
    x: float
    label: str
    y: float

def main(stdout: Stdout):
    nan = float("nan") else 0.0
    other_nan = 0.0 - nan
    zero = 0.0
    negative_zero = -0.0
    long = "a label long enough to need a block of its own"
    stdout.print(
        Reading.Value(nan) == .Value(other_nan),
        Reading.Value(zero) == .Value(negative_zero),
        Reading.Value(1.0) == .Value(2.0),
        Reading.Value(1.0) == .Missing,
        Reading.Missing == .Missing,
    )
    stdout.print(
        Reading.Named(long, nan) == .Named(long, other_nan),
        Reading.Named("a", zero) == .Named("a", negative_zero),
        Reading.Named("a", 1.0) == .Named("b", 1.0),
        Reading.Named(long, 1.0) == .Value(1.0),
    )
    stdout.print(
        Point(x=nan, label=long, y=negative_zero) == Point(x=other_nan, label=long, y=zero),
        Point(x=1.0, label="p", y=2.0) == Point(x=1.0, label="q", y=2.0),
        Point(x=1.0, label="p", y=2.0) == Point(x=1.0, label="p", y=2.5),
    )
    mut readings = {Reading.Value(nan): "nan", Reading.Value(zero): "zero", Reading.Missing: "missing"}
    readings[Reading.Value(other_nan)] = "nan again"
    readings[Reading.Value(negative_zero)] = "zero again"
    stdout.print(readings.len(), readings[Reading.Value(nan)], readings[Reading.Value(zero)])
    mut points = {Point(x=nan, label=long, y=zero): 1}
    points[Point(x=other_nan, label=long, y=negative_zero)] = 2
    stdout.print(points.len(), points[Point(x=nan, label=long, y=negative_zero)], Point(x=1.0, label=long, y=zero) in points)
