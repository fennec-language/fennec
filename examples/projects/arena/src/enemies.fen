## Enemies and where they come from.

from std.math import Vec3

## How much of a threat an enemy is.
export enum Rank:
    Grunt
    Boss

    ## The rank's name, as a message shows it.
    def label(self) -> str:
        match self:
            case .Grunt:
                return "grunt"
            case .Boss:
                return "boss"

## One enemy in the arena.
export struct Enemy:
    ## What messages call it.
    name: str
    ## Where it stands.
    position: Vec3
    ## How strong it is.
    rank = Rank.Grunt
    ## What it has left before it's beaten.
    health = 100

    ## A line saying who it is, where it is and how healthy.
    def describe(self) -> str:
        return f"{self.name} ({self.rank.label()}) at {self.position.x} with {self.health} health"

## A new enemy of the lowest rank.
export def spawn(name: str, position: Vec3, health: int) -> Enemy:
    return Enemy(name=name, position=position, health=health)

def wave(size: int) -> list[Enemy]:
    return [spawn(f"grunt {at + 1}", Vec3(x=float(at)), 100) for at in range(size)]

test "a wave has as many enemies as asked":
    assert len(wave(4)) == 4
