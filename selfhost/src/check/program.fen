## A program's declarations: its functions, methods, types and aliases, together with the
## standard library's. Function bodies are looked at later, one function at a time.
## Mirrors `crates/check/src/program.rs`.

from span import Span, Diagnostic
from ast import Module, Item, FnDef, TypeDef, TypeExpr, Interface, TestDef
from check.types import Type, optional_type

enum TypeKind:
    StructKind
    EnumKind
    ErrorKind

struct TypeInfo:
    kind: TypeKind
    type_def: TypeDef
    ## Whether it comes from the standard library rather than the program.
    prelude: bool

struct FnEntry:
    function: FnDef
    ## The type a method belongs to.
    owner: str?
    prelude: bool

## How deeply type aliases may refer to each other, which also stops an alias naming itself.
def alias_depth() -> int:
    16

## Every declaration in a program, keyed the way the signature table is: `name` for a
## function, `Type.name` for a method.
struct Program:
    types: dict[str, TypeInfo] = {}
    functions: dict[str, FnEntry] = {}
    tests: list[TestDef] = []
    interfaces: dict[str, Interface] = {}
    aliases: dict[str, TypeExpr] = {}

    def add(mut self, module: Module, prelude: bool):
        for item in module.items:
            match item:
                case .Function(function):
                    self.functions[function.name] = FnEntry(function=function, owner=None, prelude=prelude)
                case .Struct(type_def): self.add_type(type_def, .StructKind, prelude)
                case .Enum(type_def): self.add_type(type_def, .EnumKind, prelude)
                case .Error(type_def): self.add_type(type_def, .ErrorKind, prelude)
                case .TypeAlias(name, ty, _): self.aliases[name] = ty
                case .Test(test): self.tests.append(test)
                case .Interface(interface): self.interfaces[interface.name] = interface
                case .Import(_): pass

    def add_type(mut self, type_def: TypeDef, kind: TypeKind, prelude: bool):
        for method in type_def.methods:
            entry = FnEntry(function=method, owner=type_def.name, prelude=prelude)
            self.functions[f"{type_def.name}.{method.name}"] = entry
        self.types[type_def.name] = TypeInfo(kind=kind, type_def=type_def, prelude=prelude)

    ## The type a written type means, with these type parameters in scope. An interface
    ## stands for a type parameter of its own, so `list[Shape]` is a list of any one type
    ## that fits `Shape`.
    def resolve_in(self, written: TypeExpr, generics: list[str]) -> Type:
        self.resolve_within(written, generics, alias_depth())?

    def resolve_within(self, written: TypeExpr, generics: list[str], depth: int) -> Type:
        name = written.name
        builtin = name in [
            "int", "float", "bool", "str", "Path", "None", "list", "SoaList", "set", "dict", "tuple",
            "Id", "IdMap", "Stdout", "Fs",
        ]
        is_generic = name in generics or name in self.interfaces
        if not builtin and not is_generic and name not in self.types and name not in self.aliases:
            fail unknown_type(name, written.span)
        wanted = type_arg_count(name, len(written.args))
        if len(written.args) != wanted:
            fail wrong_type_args(written, wanted)
        mut args = []
        for arg in written.args:
            args.append(self.resolve_within(arg, generics, depth)?)
        mut ty = Type.Unknown
        if builtin:
            ty = builtin_type(name, args)
        elif is_generic:
            ty = Type.Param(name)
        elif name in self.types:
            ty = Type.Named(name)
        else:
            alias = self.aliases[name]
            if depth == 0:
                fail Diagnostic(message=f"the type alias `{name}` refers to itself", span=written.span)
            ty = self.resolve_within(alias, generics, depth - 1)?
        optional_type(ty) if written.optional else ty

## How many types a built-in type takes in brackets. A tuple takes however many it's given.
def type_arg_count(name: str, given: int) -> int:
    if name in ["list", "set", "SoaList", "Id", "IdMap"]:
        return 1
    if name == "dict":
        return 2
    if name == "tuple":
        return given
    0

def builtin_type(name: str, args: list[Type]) -> Type:
    match name:
        case "int": Type.Int
        case "float": Type.Float
        case "bool": Type.Bool
        case "str": Type.Str
        case "None": Type.NoneType
        case "list": Type.List(args[0])
        case "SoaList": Type.List(args[0])
        case "set": Type.Set(args[0])
        case "dict": Type.Dict(args[0], args[1])
        case "tuple": Type.Tuple(args)
        case "Id": Type.Id(args[0])
        case "IdMap": Type.IdMap(args[0])
        case _: Type.Named(name)

def wrong_type_args(written: TypeExpr, wanted: int) -> Diagnostic:
    name = written.name
    mut example = name
    if name == "dict":
        example = "dict[str, int]"
    elif name in ["list", "set", "SoaList"]:
        example = f"{name}[int]"
    elif name in ["Id", "IdMap"]:
        example = f"{name}[Enemy]"
    mut message = f"`{name}` doesn't take types in brackets"
    if wanted == 1:
        message = f"`{name}` needs 1 type in brackets"
    elif wanted > 1:
        message = f"`{name}` needs {wanted} types in brackets"
    Diagnostic(message=message, span=written.span, help=f"write it like `{example}`")

def unknown_type(name: str, span: Span) -> Diagnostic:
    mut help = f"declare it, like `struct {name}:`, or check the spelling"
    if name in ["f32", "f64", "double"]:
        help = "write `float`"
    elif name in ["i32", "i64", "usize", "long"]:
        help = "write `int`"
    elif name in ["string", "String"]:
        help = "write `str`"
    elif name in ["boolean", "Bool"]:
        help = "write `bool`"
    elif name in ["List", "Dict", "Set"]:
        help = f"write `{name.lower()}`"
    elif name == "Optional":
        help = "write `?` after the type, like `Enemy?`"
    Diagnostic(message=f"`{name}` isn't a type", span=span, help=help)
