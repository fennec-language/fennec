from std.collections import Table

def total(map: Table[str], start: int) -> int:
    mut count = start
    for id, name in map.items():
        count += len(name)
    return count

def main(stdout: Stdout):
    mut map = Table[str]()
    for n in range(50):
        _ = map.add("name " + str(n))
    gone = map.add("gone")
    _ = map.remove(gone)
    results = sorted([total(map, n) for n in parallel(range(64))])
    stdout.print(results[0], results[63], len(map))
    maps = [map, map, map, map]
    mut each = maps
    for ref held in parallel(each):
        _ = held.add("more")
        mut sizes = 0
        for name in held.values():
            sizes += len(name)
        _ = held.add(str(sizes))
    stdout.print(len(each[0]), len(map))
