# An echo server run from inside a launched task, asked five lines and a stop by `main`: six
# rounds. For the test that what a round leaves is found wherever the server runs.
from std.concurrent import Crashed
from std.net import NetError, Server

# The server, in a task of its own: each round echoes one line, until one says to stop.
def serve(server: Server) fails NetError:
    for conn in parallel(server):
        line = conn.read_line()? else ""
        if line == "stop": break
        conn.write(f"{line}, as a text long enough for a block of its own\n")?

def asked(net: Net, port: int, line: str) -> str fails NetError:
    with net.connect("127.0.0.1", port)? as conn:
        conn.write(f"{line}\n")?
        return conn.read_line()? else ""

def main(net: Net, stdout: Stdout) fails NetError | Crashed:
    with net.listen(0)? as server:
        with launch(() => serve(server)?)?:
            for line in ["a", "b", "c", "d", "e", "stop"]:
                stdout.print(asked(net, port=server.port, line=line)?)
