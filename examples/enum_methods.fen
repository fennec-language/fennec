# Enums with methods, enums that come back from the runtime, inside structs and dicts, and
# changed in place in a list. `match` also takes apart structs and bools natively.

struct Cell:
    row: int
    col: int

enum Light:
    Red
    Amber(blinking: bool)
    Green(seconds: float)

    def next(self) -> Light:
        match self:
            case .Red:
                .Green(30.0)
            case .Green(_):
                .Amber(False)
            case .Amber(True):
                .Red
            case .Amber(_):
                .Amber(True)

    def wait(self) -> float:
        match self:
            case .Green(seconds):
                seconds
            case _:
                1.5

    def cycle(mut self):
        self = self.next()

struct Junction:
    at: Cell
    light: Light

def main(stdout: Stdout):
    mut light = Light.Red
    for i in range(5):
        stdout.print(light, light.wait())
        light.cycle()
    lights = {"a": Light.Green(2.5), "b": .Amber(True)}
    got = lights["a"]
    stdout.print(got, got.wait(), got == .Green(2.5), got.next())
    junctions = {"j": Junction(at=Cell(1, col=2), light=.Amber(False))}
    j = junctions["j"]
    stdout.print(j.light.next(), j.at.row, j)
    mut every_light = [Light.Red, .Green(1.0), .Amber(False)]
    for mut each_light in every_light:
        each_light = each_light.next()
    stdout.print(every_light)
    every_light.append(.Green(-0.0))
    stdout.print(every_light[-1] == .Green(0.0), every_light[-1] == .Green(-0.0), every_light.len())
    cell = Cell(3, col=4)
    picked = match cell:
        case Cell(0, column):
            column
        case Cell(row_number, 4):
            row_number * 100
        case _:
            -1
    stdout.print(picked)
    flag = cell.row > 2
    said = match flag:
        case True:
            "yes"
        case False:
            "no"
    stdout.print(said)
    stdout.print(Junction(at=cell, light=.Red) == Junction(at=Cell(3, col=4), light=Light.Red))
