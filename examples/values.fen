def add_bonus(ref scores: list[int], bonus: int):
    for ref score in scores:
        score += bonus

def main(stdout: Stdout):
    original = [1, 2, 3]
    mut changed = original
    changed.append(4)
    stdout.print(original)
    stdout.print(changed)

    mut scores = [10, 20, 30]
    add_bonus(ref scores, 5)
    stdout.print(scores)
