# decision: `A | B` is a union: a value that's exactly one of those types.

struct Circle:
    radius: float

    def area(self) -> float:
        3.0 * self.radius * self.radius

struct Square:
    side: float

    def area(self) -> float:
        self.side * self.side

type Shape = Circle | Square

## What a shape is, by `match`, which handles each type in the union.
def named(shape: Shape) -> str:
    match shape:
        case Circle(radius):
            f"a circle of radius {radius}"
        case Square(side):
            f"a square of side {side}"

## A number one more, or text in capitals: `is` narrows the value to one type.
def bumped(value: int | str) -> str:
    if value is int: return f"{value + 1}"
    value.upper()

def main(stdout: Stdout):
    shapes: list[Shape] = [Circle(radius=1.0), Square(side=2.0)]
    # Every type in the union has `area`, so the union does too.
    stdout.print(sum(shape.area() for shape in shapes))
    for shape in shapes:
        stdout.print(named(shape))
        if shape is Circle:
            stdout.print("its radius is", shape.radius)
    stdout.print(bumped(41), bumped("fox"))
    picked: Shape = Square(side=2.0)
    stdout.print(picked == shapes[1], picked == shapes[0])
