# decision: A function that can fail says so with `fails Name`, and every exit is visible.

# One error can list several cases, each failing its own way. A case is made like an enum's,
# `fail`ed like any error, and matched by its name inside `Err(...)`.

error NetError:
    NotFound(host: str)
    Refused(host: str, port: int)
    Closed

def connect(host: str, port: int) -> int:
    if host == "": fail NetError.NotFound(host)
    if port == 0: fail NetError.Closed
    if port < 0: fail NetError.Refused(host, port)
    port

def described(host: str, port: int) -> str:
    match connect(host, port):
        case Err(Refused(host, port)):
            f"refused by {host}:{port}"
        case Err(NotFound(host)):
            f"no host called \"{host}\""
        case Err(error):
            f"failed: {error}"
        case Ok(port):
            f"connected on {port}"

def main(stdout: Stdout):
    stdout.print(described("db", 5432))
    stdout.print(described("db", -1))
    stdout.print(described("db", 0))
    stdout.print(described("", 80))
