# For the test that hashing a password in a task parks the task while a thread of its own does the
# work: a launched task hashes one, and a server's handler hashes and checks one for each of
# several clients at once. Run under `FENNEC_COUNTS`, no wait may have blocked its thread.
from std.concurrent import Crashed
from std.crypto import PasswordError, Secret, check_password, hash_password
from std.net import NetError, Request, Response

CLIENTS = 12

# Signs a client up: its password hashed, then checked against what was kept.
def signed_up(entropy: Entropy, request: Request) -> Response:
    password = request.text()
    stored = hash_password(Secret.of(password), entropy)
    matches = check_password(Secret.of(password), stored) except PasswordError(): False
    return Response(status=201 if matches else 500)

# A client's sign-up: the status it got, or why it got none.
def asked(net: Net, port: int, number: int) -> str:
    got = net.post(f"http://127.0.0.1:{port}/signup", body=f"password {number}") except why:
        return why.message()
    return f"{got.status}"

def hashed(entropy: Entropy, stdout: Stdout):
    stored = hash_password(Secret.of("in a task"), entropy)
    matches = check_password(Secret.of("in a task"), stored) except PasswordError(): False
    stdout.print("a task's hash checks:", matches)

def main(net: Net, entropy: Entropy, stdout: Stdout) fails NetError | Crashed:
    with launch(() => hashed(entropy, stdout))?:
        pass
    with net.listen(0)? as server:
        port = server.port
        with launch(() => server.serve((request) => signed_up(entropy, request)))?:
            statuses = [asked(net, port=port, number=number) for number in parallel(range(CLIENTS))]
            signed = len([status for status in statuses if status == "201"])
            stdout.print(signed, "of", CLIENTS, "signed up")
            for other in sorted(set([status for status in statuses if status != "201"])):
                stdout.print("also:", other)
            server.close()
