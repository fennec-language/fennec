## Structs that hold lists and dicts, read and changed where they are, native.

struct Point:
    x: int
    y: float

struct Item:
    id: int
    tags: list[str]
    near: list[int]

struct Bag:
    items: list[Item]
    points: list[Point]
    counts: dict[str, int]
    numbers: list[int]
    spot: Point
    name: str
    total = 0

    def add(ref self, id: int, tag: str) -> int:
        self.items.append(Item(id=id, tags=[tag], near=[]))
        self.total += id
        return len(self.items) - 1

    def tag_of(self, at: int) -> str:
        return self.items[at].tags[0]

    def bump(ref self) -> int:
        self.total += 1
        return self.total

    def link(ref self, first: int, second: int):
        self.items[first].near.append(second)
        self.items[second].near.append(first)

    def first_big(ref self) -> int:
        for ref point in self.points:
            if point.x > 3:
                point.x = 0
                return point.x + 1
        return -1

    def mean_near(ref self) -> int:
        for ref point in self.points:
            point.x += len(self.numbers) + len(self.points)
        self.numbers.remove_where((n) => n == len(self.numbers))
        self.items[0].near.remove_where((n) => n > len(self.items))
        return self.points[0].x

enum Shape:
    Dot
    Line(length: int)
    Group(parts: list[Shape], names: list[str])

def describe(shape: Shape) -> int:
    match shape:
        case .Dot:
            return 1
        case .Line(length):
            return length * 10
        case .Group(parts, names):
            mut total = len(names)
            for part in parts:
                total += describe(part)
            return total

def kind_of(shape: Shape) -> str:
    match shape:
        case .Dot | .Line(_):
            return "small"
        case _:
            return "big"

def fresh() -> Bag:
    return Bag(
        items=[],
        points=[Point(x=1, y=0.5)],
        counts={},
        numbers=[3, 1, 2],
        spot=Point(x=0, y=0.0),
        name="bag",
    )

def total_near(bag: Bag) -> int:
    sum_of = sum(len(item.near) for item in bag.items)
    return sum_of

def main(stdout: Stdout):
    mut bag = fresh()
    stdout.print(bag.add(5, "five"), bag.add(7, "seven"), bag.total, bag.tag_of(1))
    bag.link(0, second=1)
    stdout.print(total_near(bag), bag.items[0].near, bag.items[1].tags)

    bag.points[0].x = 4
    bag.points[0].y += 1.5
    bag.points.append(Point(x=9, y=9.0))
    bag.numbers[0] = 8
    bag.numbers[1] += 10
    bag.counts["a"] = 1
    bag.counts["a"] += 1
    bag.counts["b"] = bag.counts["a"] * 3
    bag.spot.x = 6
    bag.spot.y = 2.5
    bag.name = bag.name + "!"
    bag.items[0].id = 50
    bag.items[1].tags[0] = "VII"
    bag.items[1].tags.append("more")
    bag.items[bag.bump() - bag.total].id += 1
    stdout.print(bag.points[0].x, bag.points[0].y, len(bag.points), bag.numbers, bag.counts)
    stdout.print(bag.spot.x, bag.spot.y, bag.name, bag.items[0].id, bag.items[1].tags, bag.total)

    kept = bag
    bag.items[0].near.append(100)
    bag.numbers.append(4)
    bag.counts["c"] = 1
    bag.items[1].id = -1
    stdout.print(kept.items[0].near, bag.items[0].near, kept.numbers, bag.numbers)
    stdout.print(len(kept.counts), len(bag.counts), kept.items[1].id, bag.items[1].id, kept == bag)

    last = bag.items.pop() else return
    stdout.print(bag.numbers.pop(), bag.numbers, last.id, len(bag.items))
    bag.numbers.insert(0, 42)
    bag.numbers.remove(8)
    bag.numbers.sort()
    stdout.print(bag.numbers, sorted(bag.numbers), 42 in bag.numbers, "a" in bag.counts)
    bag.numbers.remove_where((n) => n > 40)
    stdout.print(bag.numbers, (bag.counts.get("zz") else 0), (bag.counts.get("a") else 0))
    for key in bag.counts:
        stdout.print(key)
    for point in bag.points:
        stdout.print(point.x)
    for ref point in bag.points:
        point.x += 1
    stdout.print(bag.points[1].x, sum(bag.numbers), [n * 2 for n in bag.numbers])
    floats = [0.0, 1.5]
    stdout.print(0.0 in floats, -1.0 in floats, 1.5 in floats, 2.5 not in floats)
    bag.numbers.clear()
    stdout.print(bag.numbers, bag)
    stdout.print(fresh().numbers[2], len(fresh().name))
    mut more = fresh()
    more.numbers.append(4)
    more.points.append(Point(x=7, y=1.0))
    _ = more.add(1, "one")
    more.items[0].near.append(50)
    stdout.print(more.first_big(), more.points, len(more.points))
    stdout.print(more.mean_near(), more.numbers, more.items[0].near, more.points)
    _ = more.points.pop()
    stdout.print(more.points, more.first_big())
    stdout.print(
        describe(.Group(parts=[Shape.Dot, Shape.Line(length=2)], names=["a"])),
        describe(.Dot),
    )
    stdout.print(kind_of(.Dot), kind_of(.Line(length=1)), kind_of(.Group(parts=[], names=[])))
