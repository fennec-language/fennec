## `std.net`: the network, through the `Net` capability, which `main` names like `Fs`. Every
## call waits until it's done, with no `async`: a server gives each connection its own
## `parallel` task. `net.connect(host, port)` gives a `Connection` and `net.listen(port)` a
## `Server`, and `server.serve(respond)` answers HTTP with a function. Connecting gives up after
## 30 seconds unless `timeout=` says otherwise.
##
## `Connection`, `Server` and `UdpSocket` are `shared`: a second name for one is the same socket.
## Each manages its own sides, so it takes no lock. Each is lent by a `with`, `net.connect`,
## `net.listen`, `net.udp` or `server.accept`, and closed when its block ends.
##
## In a test, `Net` is a fake that never touches the network: the test's own servers are at
## `localhost`, and its clients reach them in memory. Nothing else runs while a test waits, so a
## test's server is done once no connection is waiting.

from std import json
from std.crypto import Secret
from std.intrinsics import text_byte, text_size
from std.url import decode_query, unquote

## A failure of the network, with a case for each way it fails. `message()` says it in words.
export error NetError:
    ## No host has that name.
    NotFound(host: str)
    ## The host is there, but nothing listens on that port.
    Refused(host: str, port: int)
    ## Nothing came in time.
    TimedOut(after: Duration)
    ## The other side hung up while this side wrote, or the connection was closed already.
    Closed
    ## A narrowed `Net` doesn't reach that host or port.
    Denied(reason: str)
    ## TLS failed: a certificate didn't check out, or the handshake broke off.
    Tls(reason: str)
    ## A response's status, for callers that turn one into an error. The client never fails
    ## with it.
    Status(code: int)
    ## Any other failure, said in words.
    Other(reason: str)

    ## What went wrong, in words.
    def message(self) -> str:
        match self:
            case .NotFound(host):
                f"there's no host called `{host}`"
            case .Refused(host, port):
                f"`{host}` refused a connection on port {port}"
            case .TimedOut(after):
                f"gave up after {after.as_seconds()}s"
            case .Closed:
                "the other side closed the connection"
            case Denied(reason) | Tls(reason) | Other(reason):
                reason
            case .Status(code):
                f"the response's status was {code}"

## What a server answered. A 404 is an answer like any other, so `ok()` says which it was. Its
## `text()`, written in Rust, gives the body as text, with anything that isn't text replaced.
export struct Response:
    status: int
    ## By their names in lower case. A header sent twice has its values joined with `, `, as HTTP
    ## says they can be.
    headers = dict[str, str]()
    body = bytes([])
    ## Each `Set-Cookie` header's value, in order: the one header whose values can't be joined.
    set_cookies = list[str]()

    ## Whether the status is one of the 200s.
    def ok(self) -> bool:
        self.status >= 200 and self.status < 300

    ## The body read as JSON into a `T`, as `json.loads[T]` reads text: what an API sent back.
    ## Text that isn't JSON, or doesn't fit `T`, fails with a `ParseError` saying where.
    def json[T: Deserializable](self) -> T fails ParseError:
        json.native_loads[T](self.text(), names=None, extra=None)?

## What a server shows to prove who it is: its certificate chain and its private key, as the text
## of their PEM files. The program reads those with its own `Fs`, so no file access is hidden in
## `std.net`, and the key is a `Secret`, so it can't be printed, logged or saved by accident.
##
## ```fennec
## key = Secret.of(fs.read_text("key.pem")?)
## certificate = Certificate(chain=fs.read_text("cert.pem")?, key=key)
## ```
export struct Certificate:
    chain: str
    key: Secret[str]

## One end of a TCP connection. Its methods, written in Rust: `read(n)` gives up to `n` bytes,
## or empty bytes once the other side is done; `read_line()` gives the next line without its
## ending, or `None` at the end; `write(data)` sends `bytes` or a `str`; and `close()`. Reads
## wait as long as it takes, unless given `timeout=`.
export shared Connection:
    _handle: int
    ## The other side's address, like `"127.0.0.1:52811"`.
    peer: str

    ## Each line it's sent, until the other side is done. A failure of the connection fails the
    ## loop, rather than looking like the end.
    def lines(self) -> Iterator[str] fails NetError:
        while True:
            line = self.read_line()?
            if line is None: return
            yield line

    ## This connection as a `Writer`, from `std.io`, for code written for any stream. A failure
    ## of the network comes through as an `IoError`, with the network's own words in a note.
    def writer(self) -> ConnectionWriter:
        ConnectionWriter(_conn=self)

    ## This connection as a `Reader`, from `std.io`, buffered as the connection is.
    def reader(self) -> ConnectionReader:
        ConnectionReader(_conn=self)

## A connection as a `Writer`, from `conn.writer()`. Each write is sent at once, so `flush` has
## nothing to do.
export struct ConnectionWriter:
    _conn: Connection

    def write(self, data: bytes) fails IoError:
        self._conn.write(data) else as why:
            fail io_failure(why)

    def write_text(self, text: str) fails IoError:
        self._conn.write(text) else as why:
            fail io_failure(why)

    def write_line(self, text: str) fails IoError:
        self._conn.write(text + "\n") else as why:
            fail io_failure(why)

    def flush(self) fails IoError:
        pass

## A connection as a `Reader`, from `conn.reader()`.
export struct ConnectionReader:
    _conn: Connection

    def read_chunk(self, size: int) -> bytes fails IoError:
        self._conn.read(size) else as why:
            fail io_failure(why)

    def read_line(self) -> str? fails IoError:
        self._conn.read_line() else as why:
            fail io_failure(why)

    def lines(self) -> Iterator[str] fails IoError:
        while True:
            line = self.read_line()?
            if line is None: return
            yield line

## A failure of the network as the `IoError` a stream fails with, keeping what the network said.
def io_failure(why: NetError) -> IoError:
    mut failure = IoError(reason=why.message())
    failure.add_note(f"the network failed: {why.message()}")
    failure

## One datagram, and the address it came from, like `"127.0.0.1:52811"`, which `send_to` answers.
export struct Packet:
    data: bytes
    sender: str

## A UDP port. Looping over it gives each packet as it arrives. Its methods, written in Rust:
## `receive()` gives the next `Packet`, waiting as long as it takes unless given `timeout=`;
## `send_to(data, address)` sends `bytes` or a `str` to an address like `"127.0.0.1:9001"`; and
## `close()`.
export shared UdpSocket:
    _handle: int
    ## The port it listens on: the one asked for, or the one the system picked for port 0.
    port: int

    ## Each packet as it arrives, until the socket is closed or fails.
    def iter(self) -> Iterator[Packet]:
        while True:
            packet = self.receive() else None
            if packet is None: return
            yield packet

## The network, given to `main` or a test, as `Fs` is. Its methods written in Rust are `get`,
## `post` and `request`, and a test's `script` and `requests`. Only `main` and tests are given
## one: it can't be made.
export struct Net:
    _given: int

    ## A connection to `host` on `port`, lent for a `with` block and closed when it ends:
    ## `with net.connect("example.com", 443, tls=True)? as conn:`. With `tls=True` it's TLS, its
    ## certificate checked against what the system trusts and `host`. Connecting gives up after
    ## `timeout`.
    def connect(
        self,
        host: str,
        port: int,
        tls = False,
        timeout = 30s,
    ) -> with Connection fails NetError:
        conn = self._connect(host, port, tls=tls, timeout=timeout)?
        lend conn else:
            conn.close()
        conn.close()

    ## A server listening on `port`, or on a port the system picks for 0, lent for a `with` block
    ## and closed when it ends. With `tls=`, each connection is TLS, shown by that certificate.
    def listen(self, port: int, tls: Certificate? = None) -> with Server fails NetError:
        server = listened(self, port=port, tls=tls)?
        lend server else:
            server.close()
        server.close()

    ## A UDP socket on `port`, or on a port the system picks for 0, lent for a `with` block and
    ## closed when it ends.
    def udp(self, port = 0) -> with UdpSocket fails NetError:
        socket = self._udp(port=port)?
        lend socket else:
            socket.close()
        socket.close()

## A TCP port being listened on. Looping over it gives each connection as it arrives, and
## `accept()` waits for the next one.
export shared Server:
    _handle: int
    ## The port it listens on: the one asked for, or the one the system picked for port 0.
    port: int

    ## The next connection, lent for a `with` block and closed when it ends. It waits for one as
    ## long as it takes, or up to `timeout`.
    def accept(self, timeout: Duration? = None) -> with Connection fails NetError:
        conn = accepted(self, timeout=timeout)?
        lend conn else:
            conn.close()
        conn.close()

    ## Each connection as it arrives, until the server is closed or fails. Each is closed when the
    ## loop goes on to the next.
    def iter(self) -> Iterator[Connection]:
        while True:
            match accepted(self, timeout=None):
                case Ok(conn):
                    yield conn
                    conn.close()
                case Err(_):
                    return

    ## Has the server drain when the program's asked to stop, by SIGTERM or Ctrl-C say: it takes no
    ## more connections, and a connection waiting for its next message ends, while one partway
    ## through a message goes on. Those still running after `grace` are cut short. The loop over the
    ## server then ends, and the program goes on past it.
    def stop_on(self, signals: Signals, grace = 20s):
        _ = signals
        self._stop_on(grace)

    ## Answers HTTP/1.1 with `respond`, each connection its own task, until the server is closed. A
    ## connection is kept open for more requests unless either side says to close it, and one that
    ## sends nothing for `timeout` is closed. A request that's too big, or isn't HTTP, is answered
    ## with the 4xx status that says so, without calling `respond`. Given `until=signals`, it stops
    ## when the program's asked to, as `stop_on` says: requests being answered are finished, within
    ## `grace`, and then it returns.
    def serve(
        self,
        respond: (Request) -> Response,
        timeout = 30s,
        until: Signals? = None,
        grace = 20s,
    ):
        if until is not None:
            self.stop_on(until, grace=grace)
        for connection in parallel(self):
            _ = answer_all(connection, respond, timeout)

## An HTTP request a server was sent: its method, like `"GET"`, its path without the query, the
## query's parameters, its headers by their names in lower case, and its body.
export struct Request:
    method: str
    path: str
    query = dict[str, str]()
    headers = dict[str, str]()
    body = bytes([])

    ## The body as text, or empty text when it isn't UTF-8.
    def text(self) -> str:
        self.body.decode() else ""

## The most a request's headers may hold, in lines and in bytes, and the most its body may be.
MOST_HEADERS = 100
MOST_HEADER_BYTES = 16384
MOST_BODY = 10485760

## The most blank lines passed over before a request line.
MOST_BLANK_LINES = 8

## What reading a request gave: one to answer, one the server answers itself, or the end.
enum RequestRead:
    Got(request: Request, keep: bool)
    Bad(status: int, reason: str)
    Done

## Answers each request on a connection until it's closed or asks to be.
def answer_all(
    connection: Connection,
    respond: (Request) -> Response,
    timeout: Duration,
) fails NetError:
    while True:
        match next_request(connection, timeout)?:
            case .Got(request, keep):
                # A server draining answers this request, then closes.
                still = keep and not connection.draining()
                write_response(connection, respond(request), still, request.method == "HEAD")?
                if not still:
                    connection.close()
                    return
            case .Bad(status, reason):
                write_response(
                    connection,
                    Response(status=status, body=reason.encode()),
                    False,
                    False,
                )?
                connection.close()
                return
            case .Done:
                connection.close()
                return

## The runtime's words for a line it won't read: one too long, and one ended by a bare line feed.
LONG_LINE = "a line was longer than 1048576 bytes"
BARE_LINE_FEED = "a line ended without a carriage return"

## The next request, with a line the runtime won't read answered rather than dropped. A line too
## long gets a 431. One ended by a bare line feed gets a 400: a proxy that takes one and a server
## that doesn't would read where a request ends differently.
def next_request(connection: Connection, timeout: Duration) -> RequestRead fails NetError:
    match read_request(connection, timeout):
        case Ok(read):
            return read
        case Err(error):
            match error:
                case .Other(reason):
                    if reason == LONG_LINE:
                        return .Bad(status=431, reason="a line of the request is too long")
                    if reason == BARE_LINE_FEED:
                        return .Bad(status=400, reason="a line ended without a carriage return")
                case _:
                    pass
            fail error

## The next request on a connection.
def read_request(connection: Connection, timeout: Duration) -> RequestRead fails NetError:
    mut first = connection.read_line(timeout=timeout, crlf=True)? else return .Done
    # A blank line or two before a request line is passed over, as HTTP/1.1 says a server should:
    # some clients send one after a body.
    mut blank = 0
    while first == "" and blank < MOST_BLANK_LINES:
        blank += 1
        first = connection.read_line(timeout=timeout, crlf=True)? else return .Done
    if first == "": return .Done
    parts = first.split(" ")
    if parts.len() != 3 or (parts[2] != "HTTP/1.1" and parts[2] != "HTTP/1.0"):
        return .Bad(status=400, reason="that isn't an HTTP/1.1 request line")
    if not is_token(parts[0]) or parts[1] == "" or has_control(parts[1], False):
        return .Bad(status=400, reason="that isn't an HTTP/1.1 request line")
    mut headers: dict[str, str] = {}
    mut size = first.len()
    mut lines = 0
    while True:
        line = connection.read_line(timeout=timeout, crlf=True)? else return .Bad(
            status=400,
            reason="the headers didn't end",
        )
        if line == "": break
        size += line.len()
        lines += 1
        if lines > MOST_HEADERS or size > MOST_HEADER_BYTES:
            return .Bad(status=431, reason="the headers are too big")
        # A line that starts with a space would continue the last header, which some read as a
        # new one, and a control character is read differently by different servers.
        if text_byte(line, 0) == 32 or text_byte(line, 0) == 9 or has_control(line, True):
            return .Bad(status=400, reason="a header has a character it can't have")
        colon = line.find(":") else return .Bad(status=400, reason="a header has no `:`")
        if not is_token(line[:colon]): return .Bad(status=400, reason="a header's name isn't one")
        name = line[:colon].lower()
        # Two of these would let two servers read two different requests from the same bytes.
        if (
            name in headers
            and (name == "content-length" or name == "transfer-encoding" or name == "host")
        ):
            return .Bad(status=400, reason=f"there's more than one `{name}` header")
        headers[name] = line[colon + 1:].strip()
    if "transfer-encoding" in headers:
        return .Bad(status=501, reason="chunked bodies aren't taken yet")
    mut body = bytes([])
    if "content-length" in headers:
        written = headers["content-length"]
        if not only_digits(written):
            return .Bad(status=400, reason="the content length isn't a number")
        length = int(written) else return .Bad(
            status=400,
            reason="the content length isn't a number",
        )
        if length > MOST_BODY: return .Bad(status=413, reason="the body is too big")
        while body.len() < length:
            more = connection.read(length - body.len(), timeout=timeout)?
            if more.len() == 0: return .Bad(status=400, reason="the body ended early")
            body = body + more
    version = parts[2]
    asked = (headers.get("connection") else "").lower()
    keep = asked != "close" if version == "HTTP/1.1" else asked == "keep-alive"
    target = parts[1]
    mut path = target
    mut query: dict[str, str] = {}
    at = target.find("?")
    if at is not None:
        path = target[:at]
        query = decode_query(target[at + 1:])
    .Got(
        request=Request(
            method=parts[0],
            path=unquote(path),
            query=query,
            headers=headers,
            body=body,
        ),
        keep=keep,
    )

## Whether `text` is what HTTP calls a token, as a method or a header's name has to be.
def is_token(text: str) -> bool:
    size = text_size(text)
    if size == 0: return False
    for at in range(size):
        b = text_byte(text, at)
        letter = (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57)
        if (
            not letter
            and not (
                b == 45
                or b == 95
                or b == 46
                or b == 33
                or b == 35
                or b == 36
                or b == 37
                or b == 38
                or b == 39
                or b == 42
                or b == 43
                or b == 94
                or b == 96
                or b == 124
                or b == 126
            )
        ):
            return False
    True

## Whether `text` has a control character in it, which a tab isn't if `tab` says so.
def has_control(text: str, tab: bool) -> bool:
    for at in range(text_size(text)):
        b = text_byte(text, at)
        if (b < 32 and not (tab and b == 9)) or b == 127: return True
    False

## Whether `text` is one or more digits and nothing else.
def only_digits(text: str) -> bool:
    size = text_size(text)
    if size == 0: return False
    for at in range(size):
        b = text_byte(text, at)
        if b < 48 or b > 57: return False
    True

## Writes a response, saying the connection closes after it when it does. The answer to a `HEAD`
## says how long its body is and doesn't send it. A header that can't be written, as a value from
## outside with a line break would start a header of its own, makes it a 500 instead.
def write_response(
    connection: Connection,
    response: Response,
    keep: bool,
    head_only: bool,
) fails NetError:
    mut head = f"HTTP/1.1 {response.status} {reason_phrase(response.status)}\r\n"
    for name, value in response.headers.items():
        if not is_token(name) or has_control(value, True):
            refused = Response(status=500, body="a response header can't be written".encode())
            write_response(connection, refused, keep, head_only)?
            return
        lower = name.lower()
        if lower != "content-length" and lower != "connection":
            head += f"{name}: {value}\r\n"
    head += f"content-length: {response.body.len()}\r\n"
    if not keep:
        head += "connection: close\r\n"
    head += "\r\n"
    connection.write(head)?
    if response.body.len() > 0 and not head_only:
        connection.write(response.body)?

## The words that go with a status.
def reason_phrase(status: int) -> str:
    match status:
        case 200:
            "OK"
        case 201:
            "Created"
        case 204:
            "No Content"
        case 301:
            "Moved Permanently"
        case 302:
            "Found"
        case 304:
            "Not Modified"
        case 400:
            "Bad Request"
        case 401:
            "Unauthorized"
        case 403:
            "Forbidden"
        case 404:
            "Not Found"
        case 405:
            "Method Not Allowed"
        case 413:
            "Content Too Large"
        case 431:
            "Request Header Fields Too Large"
        case 500:
            "Internal Server Error"
        case 501:
            "Not Implemented"
        case 503:
            "Service Unavailable"
        case _:
            "Unknown"

## The next connection a server takes, waiting up to `timeout` when there's one.
def accepted(server: Server, timeout: Duration?) -> Connection fails NetError:
    if timeout is None: return server._accept()?
    server._accept(timeout=timeout)?

## A server listening on `port`, with TLS when there's a certificate.
def listened(net: Net, port: int, tls: Certificate?) -> Server fails NetError:
    if tls is None: return net._listen(port)?
    net._listen(port, tls=tls)?
