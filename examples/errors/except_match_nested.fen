error LoadError:
    Missing(path: str)
    Damaged(line: int)

def load(path: str) -> int fails LoadError:
    if path == "": fail .Missing(path)
    return 7

def main(stdout: Stdout):
    score = load("save.txt") except why:
        match why:
            case .Missing(path):
                0
            case .Damaged(line):
                line
    stdout.print(score)
