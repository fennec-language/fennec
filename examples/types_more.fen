from std.collections import Table
from std.layout import SoaList

error NotANumber:
    text: str

enum Light:
    Red
    Green

    def default() -> Light:
        return .Red

enum Coin:
    Heads
    Tails

struct Money:
    cents: int

    def <(self, other: Money) -> bool:
        return self.cents < other.cents

    def /(self, parts: int) -> Money:
        return Money(cents=self.cents // parts)

    def %(self, parts: int) -> Money:
        return Money(cents=self.cents % parts)

struct Score:
    value: int where value >= 0

struct Player:
    name: str

    def greet(self) -> str:
        return f"hi, {self.name}"

def find(name: str) -> Player?:
    if name == "Kit": return Player(name="Kit")
    return None

def parse(text: str) -> int fails NotANumber:
    if not text.isdigit(): fail NotANumber(text=text)
    return int(text) except InvalidValue(): 0

def call(make: () -> int) -> int:
    return make()

def combine(join: (int, int) -> int, left_value: int, right_value: int) -> int:
    return join(left_value, right_value)

def main(stdout: Stdout):
    # A named constructor that takes nothing can be used without parentheses.
    stdout.print(Light.default(), Light.default, Light.Green)
    # A case name that only one enum has needs no type in front of it.
    stdout.print([.Heads, .Tails], .Green)

    # Types with their own `<` get the other comparisons from it.
    small = Money(cents=5)
    big = Money(cents=9)
    stdout.print(small <= big, big <= small, small >= big, big >= small, small <= small)
    stdout.print(big / 2, big % 2)

    # `where` rules: literals are checked as the program is read; anything else can fail.
    for value in [5, -1]:
        score = Score(value=value) except why:
            stdout.print(why)
            continue
        stdout.print(score)

    # A method call on a value that might be None needs `else` to end the chain.
    stdout.print(
        find("Vex").greet() else "nobody",
        find("Kit").greet() else "nobody",
        find("Kit") is not None,
        find("Vex") is not None,
    )

    # Arrow functions can take no arguments, or several, when passed for a parameter with a
    # function type.
    stdout.print(
        call(() => 42),
        combine((left_value, right_value) => left_value + right_value, left_value=2, right_value=3),
        combine((first, second) => second, left_value=1, right_value=2),
    )

    # Collections can end with a comma.
    stdout.print({"a": 1}, {1, 2}, [1], (1,))

    # A function can return a result it made itself.
    _ = parse("twelve") except why:
        parse_value = parse("12") except NotANumber(): -1
        stdout.print(parse_value, why)
        -1

    # `and` and `or` stop as soon as they know the answer.
    stdout.print(True or 1 // 0 == 0, False and 1 // 0 == 0, True and False, False or True)

    # An Id stops working once its item is removed, even after its slot is reused.
    mut enemies = Table[str]()
    ash = enemies.add("ash")
    _ = enemies.remove(ash)
    kit = enemies.add("kit")
    stdout.print(enemies.get(ash), enemies[kit])

    stdout.print(SoaList[int](), len(SoaList[int]()))
