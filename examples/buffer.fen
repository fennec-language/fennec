## `Buffer[T]`: the growable, counted run of slots that lists are built on. It fills slots in
## order, so reading one nothing wrote is an ordinary out-of-range failure.

def main(stdout: Stdout):
    mut squares = Buffer[int](capacity=2)
    stdout.print(squares.len(), squares.capacity())
    for i in range(5):
        squares.push(i * i)
    # Pushing into a full buffer doubles what it needs.
    stdout.print(squares.len(), squares.capacity(), squares[4])
    squares[0] = 100
    stdout.print(squares.pop(), squares.len())
    squares.reserve(20)
    stdout.print(squares.capacity())
    squares.truncate(2)
    stdout.print(squares.len(), squares.capacity())
    for square in squares:
        stdout.print(square)
    mut names = Buffer[str]()
    names.push("fox")
    names.push("fennec")
    stdout.print(names[1], names.len(), names.capacity())
