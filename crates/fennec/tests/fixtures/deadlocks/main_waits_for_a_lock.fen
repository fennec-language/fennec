# Main waits to take a lock a task holds while it counts: never a deadlock. The task says it's
# started and then takes the lock, so main's lock nearly always waits for the count to end. Both
# add to the tally, so what main prints is the same whichever takes the lock first.
from std.concurrent import Closed, Crashed, Sender, channel

struct Tally:
    seen = 0

def counted(turns: int) -> int:
    mut total = 0
    for turn in range(turns):
        total = (total + turn * 7) % 1000003
    return total

def holds(tally: shared Tally, started: Sender[int]):
    started.send(1) except Closed():
        return
    lock tally as ref held:
        held.seen += counted(turns=40000000)

def main(stdout: Stdout) fails Crashed:
    shared tally = Tally()
    with channel[int](size=1) as started:
        sender = started.sender()
        with launch(() => holds(tally, started=sender))?:
            _ = started.receive() else -1
            lock tally as ref held:
                held.seen += 1
    lock tally as held:
        stdout.print("seen", held.seen)
