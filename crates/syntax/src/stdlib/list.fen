## `list`'s methods written in Fennec. Growing, shrinking and reading a slot are machine
## operations the engines provide.
extend list[T]:
    ## Adds every item of `more` to the end, in order.
    def extend(ref self, more: list[T]):
        for item in more:
            self.append(item)

    ## The item at `at`, counting from the end when it's negative as `self[at]` does, or `None`
    ## when there's no item there, where `self[at]` would stop the program.
    def get(self, at: int) -> T?:
        size = self.len()
        if at >= size or at < -size: return None
        self[at]

    ## Reverses the items in place.
    def reverse(ref self):
        mut low = 0
        mut high = self.len() - 1
        while low < high:
            held = self[low]
            self[low] = self[high]
            self[high] = held
            low += 1
            high -= 1

## Methods for lists whose items can be compared with `==`.
extend list[T: Eq]:
    ## How many items equal `item`.
    def count(self, item: T) -> int:
        mut found = 0
        for each in self:
            if each == item:
                found += 1
        found

    ## Where `item` first is, or None when it isn't there.
    def index(self, item: T) -> int?:
        for at, each in enumerate(self):
            if each == item: return at
        None
