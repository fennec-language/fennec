# A listener of a channel to `.Every` that nothing more is sent to: main waits for good. The one
# message sent before it listened is kept, but isn't its to hear.
from std.concurrent import Closed, channel

def main(stdout: Stdout) fails Closed:
    with channel[int](size=4, to=.Every) as hits:
        hits.send(7)?
        listening = hits.inbox()
        stdout.print("listening")
        heard = listening.receive() else -1
        stdout.print(heard)
