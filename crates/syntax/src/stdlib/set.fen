## `set`'s methods written in Fennec. Adding, removing and walking its items are machine
## operations the engines provide. A new set keeps `self`'s items first, in their order.
extend set[T: Hashable]:
    ## Adds every item of `more`.
    def update(ref self, more: set[T]):
        for item in more:
            self.add(item)

    ## The items in either set.
    def union(self, other: set[T]) -> set[T]:
        mut found = set(self)
        found.update(other)
        return found

    ## The items in both sets.
    def intersection(self, other: set[T]) -> set[T]:
        return {item for item in self if item in other}

    ## The items of this set that aren't in `other`.
    def difference(self, other: set[T]) -> set[T]:
        return {item for item in self if item not in other}

    ## Whether every item is in `other`.
    def is_subset(self, other: set[T]) -> bool:
        return all(item in other for item in self)

    ## Whether every item of `other` is in this set.
    def is_superset(self, other: set[T]) -> bool:
        return other.is_subset(self)

    ## Whether the sets have no items in common.
    def is_disjoint(self, other: set[T]) -> bool:
        return not any(item in other for item in self)

extend set[T: Hashable & Serializable]:
    def serialize(self, ref out: Serializer):
        out.sequence([item for item in self])

extend set[T: Hashable & Deserializable]:
    def deserialize(ref src: Deserializer) -> set[T] fails ParseError:
        mut found = set[T]()
        for item in src.sequence[T]()?:
            found.add(item)
        return found
