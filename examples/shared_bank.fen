# A `shared` value can hold others, but never in a cycle. One lock is never taken inside another,
# so the bank's accounts are read out of it first, under its lock, and then taken together in one
# `lock`, which can't be taken in opposite orders.

struct Account:
    total = 0

    def add(ref self, amount: int):
        self.total += amount

struct Bank:
    accounts: list[shared Account]

def accounts_of(bank: shared Bank) -> list[shared Account]:
    lock bank as held:
        return held.accounts

def deposit(bank: shared Bank, at: int, amount: int):
    accounts = accounts_of(bank)
    lock accounts[at] as ref account:
        account.add(amount)

def total(bank: shared Bank) -> int:
    mut found = 0
    for account in accounts_of(bank):
        lock account as held:
            found += held.total
    return found

def main(stdout: Stdout):
    shared first = Account(total=1)
    shared second = Account(total=2)
    shared bank = Bank(accounts=[first, second])
    deposit(bank, at=0, amount=10)
    lock first, second as ref inner, ref other:
        other.add(5)
        inner.total += 100
    banked = total(bank)
    lock first as held:
        stdout.print(banked, held.total)
