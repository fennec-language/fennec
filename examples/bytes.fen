# decision: `bytes` is binary data, a run of ints from 0 to 255.

# `bytes` is binary data: a run of ints from 0 to 255. Text becomes bytes with `encode`,
# as UTF-8, and comes back with `decode`, which fails on bytes that aren't text.

def checksum(data: bytes) -> int:
    sum(byte for byte in data) % 256

def main(stdout: Stdout):
    data = "héllo".encode()
    stdout.print(data, data.len(), "bytes, but", "héllo".len(), "characters")
    stdout.print(data[0], data[-1], data[1:3], 104 in data)
    stdout.print(checksum(data), [byte for byte in data[:2]])

    header = bytes([137, 80, 78, 71])
    stdout.print(header + bytes([13, 10]), header == bytes([137, 80, 78, 71]), bytes() < header)

    text = data.decode() else as why:
        why.message
    stdout.print("decoded", text)
    _ = header.decode() else:
        stdout.print("the header isn't text")
        ""

test "bytes are written and read as hex, as in Python":
    header = bytes([137, 80, 78, 71])
    assert header.hex() == "89504e47"
    assert header.hex(" ") == "89 50 4e 47"
    assert bytes().hex() == ""
    assert bytes.fromhex("89504E47")? == header
    assert bytes.fromhex("89 50 4e 47")? == header

test "fromhex fails on text that isn't pairs of hex digits":
    for text in ["8", "zz", "8 9"]:
        error = failure_of(() => bytes.fromhex(text))
        assert error is not None
        assert error.message.startswith("`fromhex` needs two hex digits for each byte")
