# A cache many threads read and a few write: a dict from strings to numbers, under the read lock nearly
# always.
shared Cache:
    values = dict[str, int]()

    def get(self, key: str) -> int?:
        self.values.get(key)

    def put(mut self, key: str, value: int):
        self.values[key] = value

KEYS = 1000

def name(n: int) -> str:
    f"a key with a long enough name to have a block, number {n % KEYS}"

def work(cache: Cache, n: int) -> int:
    key = name(n)
    found = cache.get(key)
    if found is None:
        cache.put(key, n % KEYS)
        return 0
    found

def main(stdout: Stdout):
    cache = Cache()
    ops = [n for n in range(1000000)]
    total = sum(work(cache, n) for n in parallel(ops))
    stdout.print(total >= 0)
