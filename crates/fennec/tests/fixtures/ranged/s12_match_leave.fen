# Ways out of the loop written twice from inside a `match` and a handler, giving back strings.
error Small:
    value: int

enum Shape:
    Dot
    Line(length: int)
    Box(wide: int, tall: int)

def checked(value: int) -> int fails Small:
    if value < 0: fail Small(value=value)
    return value * 2

def scan(starts: list[int], order: list[int], shapes: list[Shape]) -> str:
    mut text = ""
    for at in range(starts[0], starts[1]):
        value = order[at]
        match shapes[value]:
            case .Dot: text += "."
            case .Line(length):
                if length > 3: return text + f"|{length}"
                text += "-"
            case .Box(wide, tall):
                doubled = checked(wide - tall) except why:
                    text += f"!{why.value}"
                    break
                text += f"#{doubled}"
    return text + "."

def main(stdout: Stdout):
    shapes = [Shape.Dot, Shape.Line(length=2), Shape.Box(wide=5, tall=2), Shape.Line(length=9), Shape.Box(wide=1, tall=2)]
    stdout.print(scan([0, 3], order=[0, 1, 2, 3, 4], shapes=shapes))
    stdout.print(scan([0, 5], order=[0, 1, 2, 3, 4], shapes=shapes))
    stdout.print(scan([0, 4], order=[0, 2, 4, 1, 3], shapes=shapes))
    stdout.print(scan([3, 5], order=[0, 2, 4, 1, 3], shapes=shapes))
