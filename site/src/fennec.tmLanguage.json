{
  "name": "fennec",
  "displayName": "Fennec",
  "scopeName": "source.fennec",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#variants" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.fennec", "match": "//.*$" },
        { "name": "comment.block.fennec", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.fennec",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.fennec", "match": "\\\\." },
        {
          "name": "meta.interpolation.fennec",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.fennec" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.fennec" } },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.fennec",
      "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?(i8|i16|i32|i64|u8|u16|u32|u64|usize|f32|f64)?\\b"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "storage.type.function.fennec" },
            "2": { "name": "entity.name.function.fennec" }
          }
        },
        {
          "match": "\\b(struct|enum|error|class|interface|type)\\s+([A-Z]\\w*)",
          "captures": {
            "1": { "name": "storage.type.fennec" },
            "2": { "name": "entity.name.type.fennec" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.fennec", "match": "\\b(if|else|match|for|in|while|loop|return|break|continue)\\b" },
        { "name": "keyword.control.import.fennec", "match": "\\b(import|from|export)\\b" },
        { "name": "storage.type.fennec", "match": "\\b(fn|const|let|struct|enum|error|class|interface|impl|type|resource|extern)\\b" },
        { "name": "storage.modifier.fennec", "match": "\\b(inout|noalloc|unsafe|weak|mutating)\\b" },
        { "name": "keyword.other.fennec", "match": "\\b(test|assert)\\b" },
        { "name": "constant.language.fennec", "match": "\\b(true|false)\\b" },
        { "name": "variable.language.self.fennec", "match": "\\bself\\b" },
        { "name": "support.type.primitive.fennec", "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|usize|f32|f64|bool)\\b" }
      ]
    },
    "variants": {
      "match": "(?<![\\w)\\]])\\.([A-Z]\\w*)",
      "captures": { "1": { "name": "variable.other.enummember.fennec" } }
    },
    "types": {
      "name": "entity.name.type.fennec",
      "match": "\\b[A-Z][A-Za-z0-9]*\\b"
    },
    "calls": {
      "match": "\\b([a-z_]\\w*)(?=\\s*\\()",
      "captures": { "1": { "name": "entity.name.function.call.fennec" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.fennec", "match": "->|=>" },
        { "name": "keyword.operator.fennec", "match": "\\?\\?|\\?\\.|\\?|==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|[-+*/%<>=!]" }
      ]
    }
  }
}
