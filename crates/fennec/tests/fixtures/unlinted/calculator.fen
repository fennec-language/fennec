# A calculator over syntax trees, compiled to plain machine code: the trees are boxed,
# `match` is a switch, and `==` compares trees and plain values natively.

struct Range:
    low: int
    high: int

enum Sign:
    Plus
    Minus

enum Calc:
    Lit(value: int)
    Arg
    Op(sign: Sign, left: Calc, right: Calc)
    Times(left: Calc, right: Calc)
    Clamp(range: Range, inner: Calc)

def run(calc: Calc, arg: int) -> int:
    match calc:
        case .Lit(n):
            return n
        case .Arg:
            return arg
        case .Op(.Plus, a, b):
            return run(a, arg) + run(b, arg)
        case .Op(_, a, b):
            return run(a, arg) - run(b, arg)
        case .Times(a, b):
            return run(a, arg) * run(b, arg)
        case .Clamp(Range(-50, high), inner):
            return min(max(run(inner, arg), -50), high)
        case .Clamp(bounds, inner):
            return min(max(run(inner, arg), bounds.low), bounds.high)

def fold(calc: Calc) -> Calc:
    match calc:
        case .Times(.Lit(0), _):
            return .Lit(0)
        case .Times(.Lit(1), b):
            return fold(b)
        case .Op(.Plus, .Lit(0), b):
            return fold(b)
        case .Op(sign, a, b):
            return .Op(sign, left=fold(a), right=fold(b))
        case .Times(a, b):
            return .Times(fold(a), right=fold(b))
        case .Clamp(bounds, inner):
            return .Clamp(bounds, fold(inner))
        case other:
            return other

def grow(depth: int, seed: int) -> Calc:
    if depth == 0: return Calc.Arg if seed % 3 == 0 else .Lit(seed % 7)
    a = grow(depth - 1, seed=seed * 5 + 1)
    b = grow(depth - 1, seed=seed * 3 + 2)
    match seed % 6:
        case 0:
            return .Op(.Plus, left=a, right=b)
        case 1:
            return .Op(.Minus, left=.Lit(0), right=b)
        case 2:
            return .Times(.Lit(1), right=a)
        case 3:
            return .Clamp(Range(low=-50, high=50), .Times(a, right=b))
        case 4:
            return .Times(.Lit(0), right=a)
        case _:
            return .Op(.Minus, left=a, right=b)

def main(stdout: Stdout):
    calc = grow(10, seed=1)
    folded = fold(calc)
    mut same = 0
    for arg in range(-5, 6):
        if run(calc, arg) == run(folded, arg):
            same += 1
    stdout.print(same, run(calc, 3), run(folded, 3))
    stdout.print(
        fold(folded) == folded,
        calc == folded,
        grow(10, seed=1) == calc,
        calc != grow(10, seed=2),
    )
    stdout.print(Range(low=1, high=2) == Range(low=1, high=2), Sign.Plus == .Minus)
