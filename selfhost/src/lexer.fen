## Source text to tokens. Mirrors `crates/syntax/src/lexer.rs`.

from span import Diagnostic, Span
from token import FPart, Tok, Token, is_keyword, is_three_char_punct, is_two_char_punct

def is_digit(c: str) -> bool:
    return c != "" and c >= "0" and c <= "9"

def is_letter(c: str) -> bool:
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z")

## How many bytes `c` takes in UTF-8.
def utf8_width(c: str) -> int:
    return len(c.encode())

## How many bytes `text` takes in UTF-8.
def byte_length(text: str) -> int:
    return len(text.encode())

## The byte offset of each character, plus one past the end. Spans count bytes, but Fennec
## strings index by character.
def byte_offsets(chars: list[str]) -> list[int]:
    mut offsets = [0]
    mut at = 0
    for c in chars:
        at += utf8_width(c)
        offsets.append(at)
    return offsets

## Source text to tokens. Indentation becomes `Indent` and `Dedent` tokens, as in Python,
## and line breaks inside brackets are ignored. `base` is added to every span, for code
## lexed out of an f-string.
def lex(source: str, base: int) -> list[Token] fails Diagnostic:
    chars = list(source)
    mut lexer = Lexer(chars=chars, offsets=byte_offsets(chars), base=base)
    lexer.run()?
    return lexer.tokens

struct Lexer:
    chars: list[str]
    offsets: list[int]
    base: int
    pos = 0
    tokens = list[Token]()
    indents = [0]
    ## How many brackets are open; line breaks inside brackets don't end a statement.
    depth = 0
    at_line_start = True

    def run(ref self) fails Diagnostic:
        while True:
            if self.at_line_start and self.depth == 0 and not self.indentation()?: break
            c = self.peek(0)
            if c == "": break
            start = self.pos
            if c == " " or c == "\r":
                self.pos += 1
            elif c == "\t":
                fail self.tab_error(start)
            elif c == "\n":
                self.pos += 1
                if self.depth == 0:
                    self.newline(start)
                    self.at_line_start = True
            elif c == "#":
                self.skip_comment()
            elif c == "\"" and self.triple_at(0):
                self.triple(start, "")?
            elif (c == "r" or c == "f" or c == "t") and self.triple_at(1):
                self.triple(start, c)?
            elif c == "\"":
                self.string(start)?
            elif c == "f" and self.peek(1) == "\"":
                self.fstring(start, template=False)?
            elif c == "t" and self.peek(1) == "\"":
                self.fstring(start, template=True)?
            elif c == "r" and self.peek(1) == "\"":
                self.raw_string(start)?
            elif is_digit(c):
                self.number(start)?
            elif is_letter(c) or c == "_":
                self.word(start)
            else:
                self.punct(start)?
        self.finish()

    ## The character `ahead` places on, or an empty string past the end.
    def peek(self, ahead: int) -> str:
        at = self.pos + ahead
        if at < len(self.chars): return self.chars[at]
        return ""

    ## The byte offset of character `at`, shifted by `base`.
    def offset(self, at: int) -> int:
        return self.offsets[at] + self.base

    ## The span from character `start` to the current position.
    def span(self, start: int) -> Span:
        return Span(start=self.offset(start), end=self.offset(self.pos))

    def text(self, start: int, end: int) -> str:
        return "".join(self.chars[start:end])

    def push(ref self, tok: Tok, start: int):
        self.tokens.append(Token(tok=tok, span=self.span(start)))

    def newline(ref self, start: int):
        if len(self.tokens) > 0 and self.tokens[-1].tok != .Newline:
            self.push(.Newline, start)

    def tab_error(self, start: int) -> Diagnostic:
        span = Span(start=self.offset(start), end=self.offset(start) + 1)
        return Diagnostic(message="tabs aren't allowed", span=span, help="indent with 4 spaces")

    def skip_comment(ref self):
        while self.peek(0) != "" and self.peek(0) != "\n":
            self.pos += 1

    ## Measures the indentation at the start of a line and emits `Indent` or `Dedent` tokens.
    ## Blank and comment-only lines are skipped. Returns false at the end of the file.
    def indentation(ref self) -> bool fails Diagnostic:
        while True:
            line_start = self.pos
            mut width = 0
            while self.peek(0) == " " or self.peek(0) == "\t":
                if self.peek(0) == "\t": fail self.tab_error(self.pos)
                width += 1
                self.pos += 1
            c = self.peek(0)
            if c == "":
                return False
            elif c == "\n" or c == "\r":
                self.pos += 1
            elif c == "#":
                self.skip_comment()
            else:
                self.at_line_start = False
                self.set_indent(width, line_start=line_start)?
                return True
        return False

    def set_indent(ref self, width: int, line_start: int) fails Diagnostic:
        if width > self.indents[-1]:
            self.indents.append(width)
            self.push(.Indent, line_start)
            return
        while width < self.indents[-1]:
            _ = self.indents.pop()
            self.push(.Dedent, line_start)
        if width != self.indents[-1]:
            fail Diagnostic(
                message="this line's indentation doesn't match any block above it",
                span=self.span(line_start),
                help="line it up with the block it belongs to",
            )

    def finish(ref self):
        self.pos = len(self.chars)
        self.newline(self.pos)
        while len(self.indents) > 1:
            _ = self.indents.pop()
            self.push(.Dedent, self.pos)
        self.push(.Eof, self.pos)

    def word(ref self, start: int):
        while is_letter(self.peek(0)) or is_digit(self.peek(0)) or self.peek(0) == "_":
            self.pos += 1
        word = self.text(start, self.pos)
        if is_keyword(word):
            self.push(.Keyword(word), start)
        else:
            self.push(.Name(word), start)

    def number(ref self, start: int) fails Diagnostic:
        self.digits()
        mut is_float = False
        if self.peek(0) == "." and is_digit(self.peek(1)):
            is_float = True
            self.pos += 1
            self.digits()
        if self.peek(0) == "e" or self.peek(0) == "E":
            is_float = True
            self.pos += 1
            if self.peek(0) == "+" or self.peek(0) == "-":
                self.pos += 1
            self.digits()
        text = self.text(start, self.pos).replace("_", "")
        if is_letter(self.peek(0)):
            # A duration, in one part or several from the largest unit down: `1h30min`.
            mut numbers = [text]
            mut units = [self.unit()]
            while is_digit(self.peek(0)):
                part_start = self.pos
                self.digits()
                if self.peek(0) == "." and is_digit(self.peek(1)):
                    self.pos += 1
                    self.digits()
                numbers.append(self.text(part_start, self.pos).replace("_", ""))
                units.append(self.unit())
            nanos = duration(
                self.text(start, self.pos),
                numbers=numbers,
                units=units,
                span=self.span(start),
            )?
            self.push(.Duration(nanos), start)
            return
        if is_float:
            value = float.parse(text) except InvalidValue():
                fail Diagnostic(message="this isn't a valid number", span=self.span(start))
            self.push(.Float(value), start)
        else:
            value = int.parse(text) except InvalidValue():
                fail Diagnostic(
                    message="this number is too big for an int",
                    span=self.span(start),
                    help="ints are 64-bit: the largest is 9_223_372_036_854_775_807",
                )
            self.push(.Int(value), start)

    ## The letters of a duration's unit, like `ms`.
    def unit(ref self) -> str:
        start = self.pos
        while is_letter(self.peek(0)):
            self.pos += 1
        return self.text(start, self.pos)

    def digits(ref self):
        while is_digit(self.peek(0)) or self.peek(0) == "_":
            self.pos += 1

    def punct(ref self, start: int) fails Diagnostic:
        c = self.peek(0)
        pair = c + self.peek(1)
        triple = pair + self.peek(2)
        if pair == ":=":
            fail self.walrus(start)
        if is_three_char_punct(triple):
            self.pos += 3
            self.push(.Punct(triple), start)
            return
        if is_two_char_punct(pair):
            self.pos += 2
            self.push(.Punct(pair), start)
            return
        if c not in "()[]{},:.?+-*/%=<>&|^~@":
            fail self.unexpected(start)
        if c in "([{":
            self.depth += 1
        elif c in ")]}" and self.depth > 0:
            self.depth -= 1
        self.pos += 1
        self.push(.Punct(c), start)

    ## A character no token starts with, at character `start`. Where it's a habit from Python,
    ## what to write instead: `;` between statements, a string in `'`s, a `\` that goes on to the
    ## next line, `!r` in an f-string's `{}`, or `!` for `not`.
    def unexpected(self, start: int) -> Diagnostic:
        character = self.peek(0)
        one = Span(start=self.offset(start), end=self.offset(start) + utf8_width(character))
        rest = self.text(start, len(self.chars)).rstrip()
        if character == ";":
            return Diagnostic(message="Fennec doesn't use `;`", span=one, help="put each statement on its own line")
        if character == "'":
            return self.single_quoted(start, one)
        if character == "\\" and self.ends_line(start + 1):
            return Diagnostic(
                message="Fennec doesn't go on to the next line with `\\`",
                span=one,
                help="put what goes on in brackets, which can span lines, as `total = (1 +` with `2)` on the next line",
            )
        if rest in ["!r", "!s", "!a"]:
            return Diagnostic(
                message=f"an f-string has no `{rest}`",
                span=Span(start=self.offset(start), end=self.offset(start) + 2),
                help="`{name}` shows the value as `str(name)` does, and a format goes after `:`, as `{price:.2f}`",
            )
        if character == "!":
            return Diagnostic(message="Fennec writes `not`, not `!`", span=one, help="write `not done`")
        return Diagnostic(message=f"unexpected character `{character}`", span=one)

    ## A string in `'`s from character `start`: the text up to the closing `'` on its line, in
    ## `"`s, when it can go in them as it is.
    def single_quoted(self, start: int, one: Span) -> Diagnostic:
        mut at = start + 1
        while at < len(self.chars) and self.chars[at] != "'" and self.chars[at] != "\n":
            at += 1
        text = self.text(start + 1, at)
        plain = "\"" not in text and "\\" not in text and "{" not in text and "}" not in text
        if at < len(self.chars) and self.chars[at] == "'" and plain:
            return Diagnostic(
                message="a string is written in double quotes",
                span=Span(start=self.offset(start), end=self.offset(at + 1)),
                help=f"write `\"{text}\"`",
            )
        return Diagnostic(message="a string is written in double quotes", span=one, help="write it in `\"`s, as `\"text\"`")

    ## Whether only spaces, tabs and `\r` come between character `at` and the line's end.
    def ends_line(self, at: int) -> bool:
        mut after = at
        while after < len(self.chars) and self.chars[after] in [" ", "\t", "\r"]:
            after += 1
        return after == len(self.chars) or self.chars[after] == "\n"

    ## `:=`, Python's way to name a value inside an expression, at character `start`.
    def walrus(self, start: int) -> Diagnostic:
        mut help = "give the value a name on a line of its own first, then use the name"
        if len(self.tokens) > 0:
            match self.tokens[-1].tok:
                case .Name(name):
                    help = f"give `{name}` its value on a line of its own first, as `{name} = ...`, then use it"
                case _:
                    pass
        return Diagnostic(
            message="Fennec doesn't have `:=`",
            span=Span(start=self.offset(start), end=self.offset(start) + 2),
            help=help,
        )

    def string(ref self, start: int) fails Diagnostic:
        self.pos += 1
        mut text = ""
        while self.peek(0) != "\"":
            c = self.peek(0)
            if c == "" or c == "\n":
                fail self.unterminated(start)
            elif c == "\\":
                text += self.escape(start)?
            else:
                text += c
                self.pos += 1
        self.pos += 1
        self.push(.Str(text), start)

    ## `r"..."`: backslashes are kept as written, for patterns like `r"\d+"`.
    def raw_string(ref self, start: int) fails Diagnostic:
        self.pos += 2
        mut text = ""
        while self.peek(0) != "\"":
            c = self.peek(0)
            if c == "" or c == "\n": fail self.unterminated(start)
            text += c
            self.pos += 1
        self.pos += 1
        self.push(.Str(text), start)

    def unterminated(self, start: int) -> Diagnostic:
        return Diagnostic(
            message="this string never ends",
            span=Span(start=self.offset(start), end=self.offset(start) + 1),
            help="close it with `\"` on the same line",
        )

    ## Whether `"""` starts `ahead` characters on.
    def triple_at(self, ahead: int) -> bool:
        return self.peek(ahead) == "\"" and self.peek(ahead + 1) == "\"" and self.peek(ahead + 2) == "\""

    ## The character at `at`, or an empty string past the end.
    def char_at(self, at: int) -> str:
        if at < len(self.chars): return self.chars[at]
        return ""

    ## Where the closing `"""` of the string starting at `start` is: a backslash escapes what follows
    ## it, but not in a raw one.
    def triple_end(self, start: int, kind: str) -> int fails Diagnostic:
        mut end = self.pos + len(kind) + 3
        while not self.triple_at(end - self.pos):
            character = self.char_at(end)
            if character == "": fail self.unclosed_triple(start, prefix=len(kind))
            end += 2 if character == "\\" and kind != "r" else 1
        return end

    ## The closing `"""` at `end` alone on its line: the spaces before it, and where the text ends,
    ## with the newline before them. Otherwise none, and the text ends at `end`.
    def closing_indent(self, content: int, end: int) -> (int, int):
        mut newline = end - 1
        while newline >= content and self.char_at(newline) != "\n":
            newline -= 1
        if newline < content: return (0, end)
        for at in range(newline + 1, end):
            if self.char_at(at) != " ": return (0, end)
        return (end - newline - 1, newline + 1)

    ## A string between `"""`s, which may span lines, after the letter `kind` of `r"""`, `f"""` or
    ## `t"""`, or none. Read as `triple` in `crates/syntax/src/lexer.rs` reads it.
    def triple(ref self, start: int, kind: str) fails Diagnostic:
        content = self.pos + len(kind) + 3
        end = self.triple_end(start, kind)?
        first = content + 1 if self.char_at(content) == "\n" else content
        indent, body_end = self.closing_indent(content, end=end)
        self.pos = first
        formatted = kind == "f" or kind == "t"
        mut text = ""
        mut parts = list[FPart]()
        # Text right after the opening `"""` has no spaces of its own to take off.
        mut line_start = first != content
        while self.pos < body_end:
            if line_start:
                line_start = False
                mut spaces = 0
                while self.pos + spaces < body_end and self.char_at(self.pos + spaces) == " ":
                    spaces += 1
                if self.char_at(self.pos + spaces) == "\n":
                    self.pos += spaces if spaces < indent else indent
                elif spaces < indent:
                    fail self.under_indented(self.pos + spaces, indent=indent)
                else:
                    self.pos += indent
                continue
            character = self.peek(0)
            if character == "\n":
                text += "\n"
                self.pos += 1
                line_start = True
            elif character == "\\" and kind != "r" and self.peek(1) == "\n":
                fail Diagnostic(
                    message="a `\\` can't end a line in a string",
                    span=self.span(self.pos),
                    help="write `\\n` for a newline, or take the `\\` out",
                )
            elif character == "\\" and kind != "r":
                text += self.escape(start)?
            elif formatted and (character == "{" or character == "}") and self.peek(1) == character:
                text += character
                self.pos += 2
            elif formatted and character == "{":
                self.brace_on_its_line()?
                mut part = self.fstring_code(start)?
                # `{hp=}` shows what's written and then its value: `hp=100`.
                match part:
                    case .Code(source, offset, spec):
                        shown = shown_as_written(source)
                        if shown is not None:
                            text += source
                            part = .Code(shown, offset, spec)
                    case .Text(_):
                        pass
                if text != "":
                    parts.append(FPart.Text(text))
                    text = ""
                parts.append(part)
            elif formatted and character == "}":
                fail Diagnostic(
                    message="`}` without a matching `{`",
                    span=self.span(self.pos),
                    help="write `}}` for a literal brace",
                )
            else:
                text += character
                self.pos += 1
        self.pos = end + 3
        if not formatted:
            self.push(.Str(text), start)
            return
        if text != "":
            parts.append(FPart.Text(text))
        self.push(.TStr(parts) if kind == "t" else .FStr(parts), start)

    ## A `{` in a `"""` string closes on its own line and holds no `"`, as in a string on one line.
    def brace_on_its_line(self) fails Diagnostic:
        mut nesting = 0
        mut at = self.pos + 1
        while not (self.char_at(at) == "}" and nesting == 0):
            character = self.char_at(at)
            if character == "" or character == "\n":
                fail Diagnostic(
                    message="this `{` isn't closed on its line",
                    span=self.span(self.pos),
                    help="close it with `}` on the same line, or write `{{` for a brace",
                )
            elif character == "\"":
                fail Diagnostic(
                    message="a `\"` can't go inside `{}` in a string",
                    span=Span(start=self.offset(at), end=self.offset(at) + 1),
                    help="give the value a name before the string, and write the name in the `{}`",
                )
            elif character in "([{":
                nesting += 1
            elif character in ")]}" and nesting > 0:
                nesting -= 1
            at += 1

    ## A `"""` with no `"""` after it, named by the line it's on, which may be far above where the
    ## file ends.
    def unclosed_triple(self, start: int, prefix: int) -> Diagnostic:
        mut line = 1
        for character in self.chars[0:start]:
            if character == "\n": line += 1
        return Diagnostic(
            message=f"the `\"\"\"` on line {line} is never closed",
            span=Span(start=self.offset(start), end=self.offset(start) + prefix + 3),
            help="close it with `\"\"\"`",
        )

    ## A line of a `"""` string with fewer spaces before it than the closing `"""` has, at its first
    ## character.
    def under_indented(self, at: int, indent: int) -> Diagnostic:
        return Diagnostic(
            message="this line is indented less than the closing `\"\"\"`",
            span=Span(start=self.offset(at), end=self.offset(at + 1)),
            help=f"indent it at least {indent} spaces, as far as the closing `\"\"\"` is, or move the closing `\"\"\"` left",
        )

    ## Reads a backslash escape and returns the character it stands for.
    def escape(ref self, start: int) -> str fails Diagnostic:
        at = self.pos
        self.pos += 1
        c = self.peek(0)
        if c == "" or c == "\n": fail self.unterminated(start)
        if c == "x" or c == "u" or c == "U": return self.code_escape(c, at)?
        replacement = match c:
            case "n":
                "\n"
            case "t":
                "\t"
            case "r":
                "\r"
            case "0":
                "\0"
            case "\\":
                "\\"
            case "\"":
                "\""
            case "{":
                "{"
            case "}":
                "}"
            case _:
                fail Diagnostic(
                    message=f"`\\{c}` isn't an escape Fennec knows",
                    span=self.span(at),
                    help="the escapes are \\n, \\t, \\r, \\0, \\\\, \\\", \\xhh, \\uhhhh and \\Uhhhhhhhh; to keep backslashes as written, use a raw string like r\"\\d+\"",
                )
        self.pos += 1
        return replacement

    ## `\x41`, `\u00e9` or `\U0001f98a`: a character written as its code in hex, with two,
    ## four or eight digits. `at` is where the backslash is.
    def code_escape(ref self, letter: str, at: int) -> str fails Diagnostic:
        digits = 2 if letter == "x" else (4 if letter == "u" else 8)
        self.pos += 1
        mut code = 0
        for _ in range(digits):
            c = self.peek(0).lower()
            value = "0123456789abcdef".find(c)
            if c == "" or value is None:
                example = match letter:
                    case "x":
                        "\\x41"
                    case "u":
                        "\\u00e9"
                    case _:
                        "\\U0001f98a"
                fail Diagnostic(
                    message=f"`\\{letter}` needs {digits} hex digits, like `{example}`",
                    span=self.span(at),
                )
            code = code * 16 + value
            self.pos += 1
        character = str.from_code(code) except InvalidValue():
            fail Diagnostic(
                message=f"`{self.text(at, self.pos)}` isn't the code of a character",
                span=self.span(at),
            )
        return character

    ## An f-string, or a template string when `template`: the same text and `{}`s, built as a
    ## `Template` instead of joined.
    def fstring(ref self, start: int, template: bool) fails Diagnostic:
        self.pos += 2
        mut parts = []
        mut text = ""
        while self.peek(0) != "\"":
            c = self.peek(0)
            if c == "" or c == "\n":
                fail self.unterminated(start)
            elif c == "\\":
                text += self.escape(start)?
            elif (c == "{" or c == "}") and self.peek(1) == c:
                text += c
                self.pos += 2
            elif c == "{":
                mut part = self.fstring_code(start)?
                # `{hp=}` shows what's written and then its value: `hp=100`.
                match part:
                    case .Code(source, offset, spec):
                        shown = shown_as_written(source)
                        if shown is not None:
                            text += source
                            part = .Code(shown, offset, spec)
                    case .Text(_):
                        pass
                if text != "":
                    parts.append(FPart.Text(text))
                    text = ""
                parts.append(part)
            elif c == "}":
                fail Diagnostic(
                    message="`}` without a matching `{`",
                    span=self.span(self.pos),
                    help="write `}}` for a literal brace",
                )
            else:
                text += c
                self.pos += 1
        self.pos += 1
        if text != "":
            parts.append(FPart.Text(text))
        self.push(.TStr(parts) if template else .FStr(parts), start)

    ## Reads `{expression}` or `{expression:spec}` inside an f-string.
    def fstring_code(ref self, start: int) -> FPart fails Diagnostic:
        self.pos += 1
        code_start = self.pos
        mut nesting = 0
        mut spec_start = None
        while not (self.peek(0) == "}" and nesting == 0):
            c = self.peek(0)
            if c == "" or c == "\n" or c == "\"":
                fail self.unterminated(start)
            elif c in "([{":
                nesting += 1
            elif c in ")]}" and nesting > 0:
                nesting -= 1
            elif c == ":" and nesting == 0 and spec_start is None:
                spec_start = self.pos
            self.pos += 1
        end = self.pos
        self.pos += 1
        code_end = spec_start else end
        spec = self.text(spec_start + 1, end) if spec_start is not None else None
        return .Code(self.text(code_start, code_end), self.offset(code_start), spec)

## What an f-string's `{expression=}` shows: written out with its `=`, as in Python, the
## expression before the `=`, or `None` for a plain `{expression}`. A `=` that ends `==`, `!=`,
## `<=` or `>=` is the comparison's own.
def shown_as_written(source: str) -> str?:
    trimmed = source.rstrip()
    if not trimmed.endswith("="): return None
    before = trimmed.removesuffix("=")
    if (
        before.strip() == ""
        or before.endswith("=")
        or before.endswith("!")
        or before.endswith("<")
        or before.endswith(">")
    ):
        return None
    return before

## How many nanoseconds a unit of time is, or 0 when it isn't one. Minutes are `min`, so `m`
## is never a unit.
def unit_nanos(unit: str) -> int:
    match unit:
        case "ns":
            return 1
        case "us":
            return 1_000
        case "ms":
            return 1_000_000
        case "s":
            return 1_000_000_000
        case "min":
            return 60_000_000_000
        case "h":
            return 3_600_000_000_000
        case _:
            return 0

## The nanoseconds a duration literal stands for, from its parts: each a number and a unit,
## the largest unit first, worked out from the digits as written.
def duration(
    written: str,
    numbers: list[str],
    units: list[str],
    span: Span,
) -> int fails Diagnostic:
    help = "a duration ends in `ns`, `us`, `ms`, `s`, `min` or `h`, like `30s`, `1.5s`, `200ms` or `1h30min`"
    mut total = 0
    mut previous = 0
    for at, number in enumerate(numbers):
        unit = units[at]
        if unit == "":
            fail Diagnostic(message=f"`{written}` ends without a unit", span=span, help=help)
        per = unit_nanos(unit)
        if per == 0:
            mut why = help
            if unit == "m":
                why = "minutes are `min`, like `5min`"
            fail Diagnostic(
                message=f"`{written}` uses `{unit}`, which isn't a unit of time",
                span=span,
                help=why,
            )
        if at > 0 and per >= previous:
            fail Diagnostic(
                message=f"`{written}` has its units out of order",
                span=span,
                help="write each unit once, the largest first, like `1h30min`",
            )
        previous = per
        total += part_nanos(written, number=number, per=per, span=span)?
    return total

## The nanoseconds in `number` of a unit `per` nanoseconds long.
def part_nanos(written: str, number: str, per: int, span: Span) -> int fails Diagnostic:
    mut digits = 0
    mut places = 0
    mut exponent = ""
    mut in_fraction = False
    mut in_exponent = False
    for c in number:
        if in_exponent:
            exponent += c
        elif c == "e" or c == "E":
            in_exponent = True
        elif c == ".":
            in_fraction = True
        else:
            digits = digits * 10 + c.code() - "0".code()
            if in_fraction:
                places += 1
    mut shift = 0 - places
    if exponent != "":
        value = int.parse(exponent) except InvalidValue():
            fail Diagnostic(
                message=f"`{written}` is too long for a duration",
                span=span,
                help="a duration holds up to about 292 years of nanoseconds",
            )
        shift += value
    mut nanos = digits * per
    while shift > 0:
        nanos *= 10
        shift -= 1
    mut ten = 1
    while shift < 0:
        ten *= 10
        shift += 1
    if nanos % ten != 0:
        fail Diagnostic(
            message=f"`{written}` isn't a whole number of nanoseconds",
            span=span,
            help="a duration counts whole nanoseconds: write fewer decimal places",
        )
    return nanos // ten
