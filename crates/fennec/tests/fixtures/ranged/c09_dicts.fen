# Dicts and sets read, put to and walked inside the loop written twice.
def scan(starts: list[int], order: list[int]) -> int:
    mut counts = dict[int, int]()
    mut seen = set[int]()
    mut total = 0
    for at in range(starts[0], starts[1]):
        value = order[at]
        counts[value] = (counts.get(value) else 0) + 1
        if value in seen:
            total += 100
        seen.add(value)
        for key, count in counts.items():
            total += key * count
        if value in counts and counts[value] > 1:
            _ = counts.pop(value)
    return total + len(counts) + len(seen)

def main(stdout: Stdout):
    stdout.print(scan([0, 7], order=[3, 1, 3, 3, 1, 3, 2]))
