def count(text: str, wanted: str, xs: list[int]) -> int:
    return sum(1 if text[x] == wanted else 0 for x in parallel(xs))

def main(stdout: Stdout):
    xs = [n for n in range(6_000)]
    accented = "é" * 6_000
    wide = "日" * 6_000
    stdout.print(count(accented, wanted="é", xs=xs), count(accented, wanted="é", xs=xs))
    stdout.print(count(wide, wanted="日", xs=xs), count(wide, wanted="日", xs=xs))
