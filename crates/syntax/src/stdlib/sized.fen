        return u16((int(self) * int(other)) % 65536)

    ## `self + other`, or the nearest end of u16 when it's past one.
    def saturating_add(self, other: u16) -> u16:
        whole = int(self) + int(other)
        if whole < 0: return u16(0)
        if whole > 65535: return u16(65535)
        return u16(whole)

    ## `self - other`, or the nearest end of u16 when it's past one.
    def saturating_sub(self, other: u16) -> u16:
        whole = int(self) - int(other)
        if whole < 0: return u16(0)
