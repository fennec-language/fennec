## `list`'s methods written in Fennec. Growing, shrinking and reading a slot are machine
## operations the engines provide.
extend list[T]:
    ## Adds every item of `more` to the end, in order.
    def extend(ref self, more: list[T]):
        for item in more:
            self.append(item)

    ## The item at `at`, counting from the end when it's negative as `self[at]` does, or `None`
    ## when there's no item there, where `self[at]` would stop the program.
    def get(self, at: int) -> T?:
        size = len(self)
        if at >= size or at < -size: return None
        return self[at]

    ## Reverses the items in place.
    def reverse(ref self):
        mut low = 0
        mut high = len(self) - 1
        while low < high:
            held = self[low]
            self[low] = self[high]
            self[high] = held
            low += 1
            high -= 1

    ## Swaps the items at `i` and `j`, in place, counting from the end when either is negative, as
    ## `self[at]` does. Each has to be there. It's how two items of one list change places, since
    ## `f(ref xs[i], ref xs[j])` is refused: `i` and `j` may be the same.
    def swap(ref self, i: int, j: int):
        held = self[i]
        self[i] = self[j]
        self[j] = held

## Methods for lists whose items can be compared with `==`.
extend list[T: Eq]:
    ## How many items equal `item`.
    def count(self, item: T) -> int:
        mut found = 0
        for each in self:
            if each == item:
                found += 1
        return found

    ## Where `item` first is, or None when it isn't there.
    def index(self, item: T) -> int?:
        for at, each in enumerate(self):
            if each == item: return at
        return None

extend list[T: Serializable]:
    def serialize(self, ref out: Serializer):
        out.sequence(self)

extend list[T: Deserializable]:
    def deserialize(ref src: Deserializer) -> list[T] fails ParseError:
        return src.sequence[T]()?
