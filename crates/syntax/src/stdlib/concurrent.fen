## `std.concurrent`: channels between tasks, and the ends of one that `with launch(...)` hands out.
##
## ```fennec
## from std.concurrent import channel
##
## with channel[str](size=64) as jobs:
##     jobs.send("first")?
##     job = jobs.receive()?
## ```
##
## A channel holds at most its `size` messages, so `send` waits while it's full, and `receive`
## waits while it's empty. Both take `timeout=`. A channel closes when its `with` block ends,
## and anything still waiting on it then wakes as `Closed`.
from std.intrinsics import channel_close, channel_free, channel_listen, channel_new, channel_new_every, channel_receive, channel_send
from std.time import Duration

## A `send` on a channel that's closed, or a `receive` on one that's closed and empty.
export error Closed:
    pass

## A `send` or `receive` that waited its `timeout=` and got nowhere.
export error Timeout:
    waited: Duration

## A launched task that crashed, as its `with launch` block gives back where it ends.
export error Crashed:
    why: str

## A channel holding up to `size` messages of type `T`, lent for a `with` block, and closed when it
## ends: `with channel[Job](size=64) as jobs:`. It's the only way to make a `Channel`.
export def channel[T](size: int, to: Delivery? = None) -> with Channel[T]:
    mut number = 0
    delivery: Delivery = to else .One
    match delivery:
        case .One:
            number = channel_new(size)
        case .Every:
            number = channel_new_every(size)
    made = Channel[T](_channel=number)
    lend made else:
        channel_close(made._channel)
        channel_free(made._channel)
    channel_close(made._channel)
    channel_free(made._channel)

## Who a channel's messages go to: each to `.One` receiver, as a work queue, or every message to
## `.Every` listener.
export enum Delivery:
    One
    Every

## What a listener of a channel to `.Every` does when it falls behind, and its next message has
## gone: `.Fail` loudly, or with `.DropOldest`, go on from the oldest message kept.
export enum Behind:
    Fail
    DropOldest

## A channel for messages of type `T`, which every task inside its `with` block can send on and
## receive from. Hand one end to a task with `sender()` or `inbox()`.
export struct Channel[T]:
    _channel: int

    ## Sends `message`, waiting while the channel is full, for at most `timeout` when it's given.
    def send(self, message: T, timeout: Duration? = None) fails Closed | Timeout:
        sent(channel_send[T](self._channel, message, nanos_of(timeout)), timeout)?

    ## The next message, waiting while the channel is empty, for at most `timeout` when it's
    ## given.
    def receive(self, timeout: Duration? = None) -> T fails Closed | Timeout:
        received[T](self._channel, timeout)?

    ## Each message until the channel is closed and empty, as `for message in channel`. On a
    ## channel to `.Every`, each loop is a listener of its own, from the next message sent.
    def iter(self) -> Iterator[T]:
        listener = channel_listen(self._channel, False)
        while True:
            message = received[T](listener, None) else return
            yield message

    ## As `iter`, saying what to do when this listener of a channel to `.Every` falls behind.
    def listen(self, when_behind: Behind? = None) -> Iterator[T]:
        behind: Behind = when_behind else .Fail
        listener = channel_listen(self._channel, behind == .DropOldest)
        while True:
            message = received[T](listener, None) else return
            yield message

    ## The sending end, to hand to a task.
    def sender(self) -> Sender[T]:
        Sender[T](_channel=self._channel)

    ## The receiving end, to hand to a task.
    def inbox(self) -> Inbox[T]:
        Inbox[T](_channel=self._channel)

## The receiving end of a channel: a task's inbox, as `with launch` makes it.
export struct Inbox[T]:
    _channel: int

    ## The next message, waiting while there's none, for at most `timeout` when it's given.
    def receive(self, timeout: Duration? = None) -> T fails Closed | Timeout:
        received[T](self._channel, timeout)?

    ## Each message until the channel is closed and empty, as `for message in inbox`.
    def iter(self) -> Iterator[T]:
        while True:
            message = received[T](self._channel, None) else return
            yield message

## The sending end of a channel, as `with launch(...) as sender:` gives it.
export struct Sender[T]:
    _channel: int

    ## Sends `message`, waiting while the channel is full, for at most `timeout` when it's given.
    def send(self, message: T, timeout: Duration? = None) fails Closed | Timeout:
        sent(channel_send[T](self._channel, message, nanos_of(timeout)), timeout)?

## How long to wait, in nanoseconds, as the runtime takes it: -1 for as long as it takes. A
## negative `timeout` has already run out, so it doesn't wait at all.
def nanos_of(timeout: Duration?) -> int:
    if timeout is None: return -1
    max(timeout.nanos, 0)

## What a send's answer means: 0 sent, 1 closed, 2 timed out.
def sent(answer: int, timeout: Duration?) fails Closed | Timeout:
    if answer == 1: fail Closed()
    if answer == 2: fail Timeout(waited=timeout else Duration())

## The next message on channel `channel`, or why there isn't one.
def received[T](channel: int, timeout: Duration?) -> T fails Closed | Timeout:
    mut why = 0
    got = channel_receive[T](channel, nanos_of(timeout), ref why)
    if why == 2: fail Timeout(waited=timeout else Duration())
    got else fail Closed()
