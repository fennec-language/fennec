from std import base64
from std.collections import Id
from std.intrinsics import new_tag, stop, text_byte, text_of_code, text_part, text_size, type_name
from std.json import IdsSeen, article, escape_of, float_text, tables_in
from std.string import cut_input, quoted_input

## How deeply arrays and inline tables may nest, so bad input can't overflow the stack.
TOML_MOST_DEEP = 500

## A value of a TOML document.
enum TomlValue:
    Text(text: str)
    Int(n: int)
    Float(x: float)
    Bool(b: bool)
    List(items: list[TomlValue])
    Table(table: TomlTable)
    ## An array of tables, from `[[name]]` headers.
    Tables(tables: list[TomlTable])

## A table, with how it came to exist while the document is read.
struct TomlTable:
    keys = list[str]()
    values = list[TomlValue]()
    ## Defined by its own `[name]` header.
    header = False
    ## Made by a dotted key like `a.b = 1`.
    dotted = False
    ## Written whole on one line, so it's a value: nothing can add to it.
    inline = False

    def place_of(self, key: str) -> int:
        mut at = 0
        for name in self.keys:
            if name == key: return at
            at += 1
        return -1

    def add(ref self, key: str, value: TomlValue):
        self.keys.append(key)
        self.values.append(value)

def joined_keys(keys: list[str]) -> str:
    return ".".join(keys)

## Reads a TOML document into its values.
struct TomlParser:
    source: str
    at = 0

    def byte(self) -> int:
        return text_byte(self.source, self.at)

    def starts(self, word: str) -> bool:
        for place in range(text_size(word)):
            if text_byte(self.source, self.at + place) != text_byte(word, place): return False
        return True

    ## What's next, for a message: "`x`", or "the end of the text".
    def found(self) -> str:
        b = self.byte()
        if b < 0: return "the end of the text"
        if b == 10: return "the end of the line"
        mut size = 1
        if b >= 240:
            size = 4
        elif b >= 224:
            size = 3
        elif b >= 192:
            size = 2
        c = text_part(self.source, self.at, self.at + size)
        return f"`{c}`"

    def bad(self, message: str) -> ParseError:
        return self.bad_at(message, self.at)

    def bad_at(self, message: str, place: int) -> ParseError:
        mut line = 1
        mut column = 1
        mut at = 0
        while at < place:
            b = text_byte(self.source, at)
            if b == 10:
                line += 1
                column = 1
            elif b < 128 or b >= 192:
                column += 1
            at += 1
        return ParseError(
            message=f"{message}, at line {line}, column {column}",
            line=line,
            column=column,
        )

    def skip_spaces(ref self):
        while self.byte() == 32 or self.byte() == 9:
            self.at += 1

    def skip_comment(ref self):
        if self.byte() == 35:
            while self.byte() >= 0 and self.byte() != 10:
                self.at += 1

    ## Skips spaces, line breaks and comments, as between the items of a multi-line array.
    def skip_blank_lines(ref self):
        while True:
            b = self.byte()
            while b == 32 or b == 9 or b == 10 or b == 13 or b == 11 or b == 12:
                self.at += 1
                b = self.byte()
            if b != 35: return
            self.skip_comment()

    ## After a header or key/value pair, only spaces and a comment can come before the line ends.
    def end_of_line(ref self) fails ParseError:
        self.skip_spaces()
        self.skip_comment()
        if self.byte() == 13:
            self.at += 1
        if self.byte() == 10:
            self.at += 1
        elif self.byte() >= 0:
            fail self.bad(f"expected the end of the line, but found {self.found()}")

    def document(ref self) -> TomlTable fails ParseError:
        mut root = TomlTable()
        mut current = list[str]()
        while True:
            self.skip_blank_lines()
            b = self.byte()
            if b < 0: return root
            if b == 91:
                current = self.header(ref root)?
            else:
                at = self.at
                keys = self.key_path()?
                value = self.after_key(self.deeper(len(current), keys, at)?)?
                insert(ref root, current, 0, keys, value, (self, at))?
            self.end_of_line()?

    ## How deep the value after `keys`, which start at `at`, is in a table `depth` tables deep:
    ## each part of a dotted key before its last is a table the value is in.
    def deeper(self, depth: int, keys: list[str], at: int) -> int fails ParseError:
        deeper = depth + len(keys) - 1
        if deeper > TOML_MOST_DEEP: fail self.too_deep_at(at)
        return deeper

    def too_deep(self) -> ParseError:
        return self.too_deep_at(self.at)

    def too_deep_at(self, place: int) -> ParseError:
        return self.bad_at(f"arrays and tables nest more than {TOML_MOST_DEEP} deep here", place)

    ## `= value`, after a key.
    def after_key(ref self, depth: int) -> TomlValue fails ParseError:
        self.skip_spaces()
        if self.byte() != 61: fail self.bad(f"expected `=` after the key, but found {self.found()}")
        self.at += 1
        self.skip_spaces()
        return self.value(depth)?

    ## `[a.b]` or `[[a.b]]`. Gives back the path of the table it starts.
    def header(ref self, ref root: TomlTable) -> list[str] fails ParseError:
        at = self.at
        self.at += 1
        array = self.byte() == 91
        if array:
            self.at += 1
        self.skip_spaces()
        keys = self.key_path()?
        # A header's tables nest as deep as its key has parts, so they count as nesting does.
        if len(keys) > TOML_MOST_DEEP: fail self.too_deep_at(at)
        self.skip_spaces()
        closing = "]]" if array else "]"
        if not self.starts(closing):
            fail self.bad(f"expected `{closing}` to end the header, but found {self.found()}")
        self.at += text_size(closing)
        define(ref root, keys, 0, array, (self, at))?
        return keys

    ## A key, or several joined by dots: `name`, `"quoted key"`, `kit.version`.
    def key_path(ref self) -> list[str] fails ParseError:
        mut keys = list[str]()
        while True:
            keys.append(self.simple_key()?)
            self.skip_spaces()
            if self.byte() != 46: return keys
            self.at += 1
            self.skip_spaces()

    def simple_key(ref self) -> str fails ParseError:
        b = self.byte()
        if b == 34: return self.basic_string()?
        if b == 39: return self.literal_string()?
        start = self.at
        mut c = b
        while (
            (c >= 97 and c <= 122)
            or (c >= 65 and c <= 90)
            or (c >= 48 and c <= 57)
            or c == 95
            or c == 45
        ):
            self.at += 1
            c = self.byte()
        if self.at == start: fail self.bad(f"expected a key, but found {self.found()}")
        return text_part(self.source, start, self.at)

    ## The value here, inside `depth` arrays and tables, so an array or inline table starting here
    ## is `depth + 1` deep.
    def value(ref self, depth: int) -> TomlValue fails ParseError:
        b = self.byte()
        if (b == 91 or b == 123) and depth >= TOML_MOST_DEEP: fail self.too_deep()
        if self.starts("\"\"\""): return .Text(text=self.multi_line(34)?)
        if self.starts("'''"): return .Text(text=self.multi_line(39)?)
        if b == 34: return .Text(text=self.basic_string()?)
        if b == 39: return .Text(text=self.literal_string()?)
        if b == 91: return self.array(depth)?
        if b == 123: return self.inline_table(depth)?
        if b >= 48 and b <= 57 and self.is_date_or_time(): return .Text(text=self.date_or_time()?)
        if (b >= 48 and b <= 57) or b == 43 or b == 45 or b == 105 or b == 110:
            return self.number()?
        if b == 116 or b == 102:
            at = self.at
            mut c = b
            while (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57):
                self.at += 1
                c = self.byte()
            word = text_part(self.source, at, self.at)
            if word == "true": return .Bool(b=True)
            if word == "false": return .Bool(b=False)
            fail self.bad_at(f"{quoted_input(word)} isn't a TOML value", at)
        fail self.bad(f"expected a value, but found {self.found()}")

    ## `"text"`, with backslash escapes, on one line.
    def basic_string(ref self) -> str fails ParseError:
        start = self.at
        self.at += 1
        mut out = ""
        while True:
            b = self.byte()
            if b == 34:
                self.at += 1
                return out
            if b == 92:
                out += self.escape()?
            elif b == 10 or b == 13 or b < 0:
                fail self.bad_at(
                    "this string never ends on its line; use `\"\"\"` for text over several lines",
                    start,
                )
            else:
                out += self.plain_char()?

    ## `'text'`, taken exactly as written, on one line.
    def literal_string(ref self) -> str fails ParseError:
        start = self.at
        self.at += 1
        mut out = ""
        while True:
            b = self.byte()
            if b == 39:
                self.at += 1
                return out
            if b == 10 or b == 13 or b < 0:
                fail self.bad_at(
                    "this string never ends on its line; use `'''` for text over several lines",
                    start,
                )
            out += self.plain_char()?

    ## `"""text"""` or `'''text'''`. A line break right after the opening quotes is dropped.
    def multi_line(ref self, quote: int) -> str fails ParseError:
        start = self.at
        self.at += 3
        if self.starts("\r\n"):
            self.at += 2
        elif self.byte() == 10:
            self.at += 1
        mut out = ""
        while True:
            b = self.byte()
            if b == quote:
                mut quotes = 0
                while self.byte() == quote:
                    quotes += 1
                    self.at += 1
                if quotes >= 3:
                    if quotes > 5: fail self.bad("too many quotes end this string")
                    for _ in range(quotes - 3):
                        out += text_of_code(quote)
                    return out
                for _ in range(quotes):
                    out += text_of_code(quote)
            elif b == 92 and quote == 34:
                mut after = self.at + 1
                while text_byte(self.source, after) == 32 or text_byte(self.source, after) == 9:
                    after += 1
                if text_byte(self.source, after) == 10 or text_byte(self.source, after) == 13:
                    self.at = after
                    mut c = self.byte()
                    while c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12:
                        self.at += 1
                        c = self.byte()
                else:
                    out += self.escape()?
            elif b == 10 or b == 13:
                out += text_of_code(b)
                self.at += 1
            elif b < 0:
                fail self.bad_at("this string never ends", start)
            else:
                out += self.plain_char()?

    ## A character inside a string, which can't be a control character other than a tab.
    def plain_char(ref self) -> str fails ParseError:
        b = self.byte()
        if (
            (b < 32 and b != 9)
            or b == 127
            or (b == 194 and text_byte(self.source, self.at + 1) < 160)
        ):
            fail self.bad("a string can't hold a control character; write an escape like `\\u0007`")
        mut size = 1
        if b >= 240:
            size = 4
        elif b >= 224:
            size = 3
        elif b >= 192:
            size = 2
        part = text_part(self.source, self.at, self.at + size)
        self.at += size
        return part

    def escape(ref self) -> str fails ParseError:
        at = self.at
        self.at += 1
        b = self.byte()
        if b < 0: fail self.bad_at("this string never ends", at)
        if b == 117 or b == 85:
            self.at += 1
            return self.hex_char(4 if b == 117 else 8)?
        self.at += 1
        match b:
            case 98:
                return "\x08"
            case 116:
                return "\t"
            case 110:
                return "\n"
            case 102:
                return "\x0c"
            case 114:
                return "\r"
            case 101:
                return "\x1b"
            case 34:
                return "\""
            case 92:
                return "\\"
            case _:
                self.at -= 1
                other = self.found()
                self.at += 1
                fail self.bad_at(f"`\\{other[1:-1]}` isn't a TOML escape", at)

    def hex_char(ref self, digits: int) -> str fails ParseError:
        start = self.at
        mut code = 0
        for _ in range(digits):
            b = self.byte()
            if b >= 48 and b <= 57:
                code = code * 16 + b - 48
            elif b >= 97 and b <= 102:
                code = code * 16 + b - 87
            elif b >= 65 and b <= 70:
                code = code * 16 + b - 55
            else:
                fail self.bad(f"`\\u` needs {digits} hex digits")
            self.at += 1
        if code > 1114111 or (code >= 55296 and code < 57344):
            hex = hex_upper(code)
            fail self.bad_at(f"`{hex}` isn't a character", start)
        return text_of_code(code)

    def array(ref self, depth: int) -> TomlValue fails ParseError:
        self.at += 1
        mut items = list[TomlValue]()
        while True:
            self.skip_blank_lines()
            if self.byte() == 93:
                self.at += 1
                return .List(items=items)
            items.append(self.value(depth + 1)?)
            self.skip_blank_lines()
            if self.byte() == 93:
                self.at += 1
                return .List(items=items)
            if self.byte() != 44:
                fail self.bad(f"expected `,` or `]` after the value, but found {self.found()}")
            self.at += 1

    ## `{ name = "fennec", version = "0.1" }`.
    def inline_table(ref self, depth: int) -> TomlValue fails ParseError:
        self.at += 1
        mut table = TomlTable()
        self.skip_blank_lines()
        if self.byte() == 125:
            self.at += 1
            table.inline = True
            return .Table(table=table)
        while True:
            self.skip_blank_lines()
            at = self.at
            if depth >= TOML_MOST_DEEP: fail self.too_deep()
            keys = self.key_path()?
            # What's in an inline table is a table deeper than the table is.
            item = self.after_key(self.deeper(depth + 1, keys, at)?)?
            insert(ref table, list[str](), 0, keys, item, (self, at))?
            self.skip_blank_lines()
            if self.byte() == 125:
                self.at += 1
                table.inline = True
                return .Table(table=table)
            if self.byte() != 44:
                fail self.bad(f"expected `,` or `}}` after the value, but found {self.found()}")
            self.at += 1

    def digit_at(self, place: int) -> bool:
        b = text_byte(self.source, self.at + place)
        return b >= 48 and b <= 57

    ## Whether a value starts like a date (`1979-05-27`) or a time (`07:32`).
    def is_date_or_time(self) -> bool:
        date = (
            self.digit_at(0)
            and self.digit_at(1)
            and self.digit_at(2)
            and self.digit_at(3)
            and text_byte(self.source, self.at + 4) == 45
        )
        return (
            date
            or (self.digit_at(0) and self.digit_at(1) and text_byte(self.source, self.at + 2) == 58)
        )

    ## Reads exactly `width` digits making a number from `low` to `high`.
    def field(ref self, width: int, low: int, high: int) -> bool:
        mut n = 0
        for place in range(width):
            if not self.digit_at(place): return False
            n = n * 10 + text_byte(self.source, self.at + place) - 48
        self.at += width
        return n >= low and n <= high

    ## A date, a time, or both, with an optional offset. Kept as written.
    def date_or_time(ref self) -> str fails ParseError:
        start = self.at
        if text_byte(self.source, self.at + 4) == 45:
            if not self.field(4, 0, 9999) or self.byte() != 45:
                fail self.bad_at("this isn't a valid date", start)
            self.at += 1
            if not self.field(2, 1, 12) or self.byte() != 45:
                fail self.bad_at("this isn't a valid date", start)
            self.at += 1
            if not self.field(2, 1, 31): fail self.bad_at("this isn't a valid date", start)
            if not real_day(text_part(self.source, start, self.at)):
                fail self.bad_at("this isn't a valid date: that month has no such day", start)
            b = self.byte()
            next_digit = self.digit_at(1)
            if not (b == 84 or b == 116 or (b == 32 and next_digit)):
                return text_part(self.source, start, self.at)
            self.at += 1
        if not self.field(2, 0, 23) or self.byte() != 58:
            fail self.bad_at("this isn't a valid time", start)
        self.at += 1
        if not self.field(2, 0, 59): fail self.bad_at("this isn't a valid time", start)
        if self.byte() == 58:
            self.at += 1
            if not self.field(2, 0, 60): fail self.bad_at("this isn't a valid time", start)
        if self.byte() == 46:
            self.at += 1
            place = self.at
            while self.digit_at(0):
                self.at += 1
            if self.at == place: fail self.bad_at("this isn't a valid time", start)
        b = self.byte()
        if b == 90 or b == 122:
            self.at += 1
        elif b == 43 or b == 45:
            self.at += 1
            if not self.field(2, 0, 23) or self.byte() != 58:
                fail self.bad_at("this isn't a valid time offset", start)
            self.at += 1
            if not self.field(2, 0, 59): fail self.bad_at("this isn't a valid time offset", start)
        return text_part(self.source, start, self.at)

    def number(ref self) -> TomlValue fails ParseError:
        at = self.at
        mut b = self.byte()
        while (
            (b >= 97 and b <= 122)
            or (b >= 65 and b <= 90)
            or (b >= 48 and b <= 57)
            or b == 95
            or b == 43
            or b == 45
            or b == 46
        ):
            self.at += 1
            b = self.byte()
        token = text_part(self.source, at, self.at)
        lead = text_byte(token, 0)
        signed = lead == 43 or lead == 45
        negative = lead == 45
        unsigned = text_part(token, 1 if signed else 0, text_size(token))
        unknown = f"{quoted_input(token)} isn't a number TOML knows"
        if unsigned == "inf": return .Float(x=-1e308 * 10.0 if negative else 1e308 * 10.0)
        if unsigned == "nan": return .Float(x=1e308 * 10.0 - 1e308 * 10.0)
        if text_size(unsigned) >= 2 and text_byte(unsigned, 0) == 48:
            kind = text_byte(unsigned, 1)
            radix = 16 if kind == 120 else (8 if kind == 111 else (2 if kind == 98 else 10))
            if radix != 10:
                digits = text_part(unsigned, 2, text_size(unsigned))
                if signed or not digits_ok(digits, radix): fail self.bad_at(unknown, at)
                n = radix_int(digits, radix)
                if n < 0: fail self.bad_at(f"{quoted_input(token)} is too big for an int", at)
                return .Int(n=n)
        if has_any(unsigned, 46, 101, 69):
            if not float_ok(unsigned): fail self.bad_at(unknown, at)
            x = float(without_underscores(token)) except InvalidValue(): fail self.bad_at(
                unknown,
                at,
            )
            # TOML writes `inf` for that. A number too big for a float didn't say it.
            if x == 1e308 * 10.0 or x == -1e308 * 10.0:
                fail self.bad_at(f"{quoted_input(token)} is too big for a float", at)
            return .Float(x=x)
        if not whole_ok(unsigned): fail self.bad_at(unknown, at)
        n = int(without_underscores(token)) except InvalidValue(): fail self.bad_at(
            f"{quoted_input(token)} is too big for an int",
            at,
        )
        return .Int(n=n)

def hex_upper(code: int) -> str:
    digits = "0123456789ABCDEF"
    mut out = ""
    mut rest = code
    while rest > 0:
        out = digits[rest % 16] + out
        rest = rest // 16
    return out

def has_any(text: str, a: int, b: int, c: int) -> bool:
    for at in range(text_size(text)):
        byte = text_byte(text, at)
        if byte == a or byte == b or byte == c: return True
    return False

def without_underscores(text: str) -> str:
    mut out = ""
    mut start = 0
    size = text_size(text)
    for at in range(size):
        if text_byte(text, at) == 95:
            out += text_part(text, start, at)
            start = at + 1
    return out + text_part(text, start, size)

def digit_value(b: int) -> int:
    if b >= 48 and b <= 57: return b - 48
    if b >= 97 and b <= 122: return b - 87
    if b >= 65 and b <= 90: return b - 55
    return 99

## Digits in a radix, with each underscore between two digits.
def digits_ok(digits: str, radix: int) -> bool:
    size = text_size(digits)
    if size == 0 or text_byte(digits, 0) == 95 or text_byte(digits, size - 1) == 95: return False
    for at in range(size):
        b = text_byte(digits, at)
        if b == 95:
            if text_byte(digits, at + 1) == 95: return False
        elif digit_value(b) >= radix:
            return False
    return True

## The whole part of a decimal number: no leading zeros.
def whole_ok(digits: str) -> bool:
    return digits_ok(digits, 10) and (digits == "0" or text_byte(digits, 0) != 48)

## `3.14`, `5e+22` or `6.626e-34`, without its sign.
def float_ok(text: str) -> bool:
    size = text_size(text)
    mut end = size
    mut exponent = -1
    for at in range(size):
        b = text_byte(text, at)
        if (b == 101 or b == 69) and exponent < 0:
            exponent = at
            end = at
    if exponent >= 0:
        mut digits = exponent + 1
        while text_byte(text, digits) == 43 or text_byte(text, digits) == 45:
            digits += 1
        if not digits_ok(text_part(text, digits, size), 10): return False
    mut dot = -1
    for at in range(end):
        if text_byte(text, at) == 46 and dot < 0:
            dot = at
    if dot < 0: return whole_ok(text_part(text, 0, end))
    return whole_ok(text_part(text, 0, dot)) and digits_ok(text_part(text, dot + 1, end), 10)

## An int in a radix, or -1 if it's too big.
def radix_int(digits: str, radix: int) -> int:
    mut value = 0
    for at in range(text_size(digits)):
        b = text_byte(digits, at)
        if b != 95:
            digit = digit_value(b)
            if value > (9223372036854775807 - digit) // radix: return -1
            value = value * radix + digit
    return value

## The error for a key that has a value, or a table somewhere a dotted key can't add to.
def no_table(parser: TomlParser, key: str, at: int, dotted: bool, inner_dotted: bool) -> ParseError:
    if dotted and not inner_dotted:
        return parser.bad_at(
            f"`{cut_input(key)}` is a table defined elsewhere, so a dotted key can't add to it",
            at,
        )
    return parser.bad_at(f"`{cut_input(key)}` already has a value, so it can't hold a table", at)

## Adds `keys = value` under the table a header named, making the tables that dotted keys name.
def insert(
    ref table: TomlTable,
    path: list[str],
    step: int,
    keys: list[str],
    value: TomlValue,
    where: (TomlParser, int),
) fails ParseError:
    parser, at = where
    if step < len(path):
        key = path[step]
        place = table.place_of(key)
        match table.values[place]:
            case .Table(inner):
                mut child = inner
                insert(ref child, path, step + 1, keys, value, where)?
                table.values[place] = .Table(table=child)
            case .Tables(tables):
                mut children = tables
                mut last = children[len(children) - 1]
                insert(ref last, path, step + 1, keys, value, where)?
                children[len(children) - 1] = last
                table.values[place] = .Tables(tables=children)
            case _:
                fail parser.bad_at("this table can't be found again", at)
        return
    insert_dotted(ref table, keys, 0, value, where)?

def insert_dotted(
    ref table: TomlTable,
    keys: list[str],
    step: int,
    value: TomlValue,
    where: (TomlParser, int),
) fails ParseError:
    parser, at = where
    key = keys[step]
    if step == len(keys) - 1:
        if table.place_of(key) >= 0:
            fail parser.bad_at(f"`{cut_input(joined_keys(keys))}` is defined twice", at)
        table.add(key, value)
        return
    mut place = table.place_of(key)
    if place < 0:
        table.add(key, .Table(table=TomlTable(dotted=True)))
        place = len(table.values) - 1
    match table.values[place]:
        case .Table(inner):
            if inner.inline: fail no_table(parser, key, at, False, False)
            if not inner.dotted: fail no_table(parser, key, at, True, False)
            mut child = inner
            insert_dotted(ref child, keys, step + 1, value, where)?
            table.values[place] = .Table(table=child)
        case .Tables(_):
            fail no_table(parser, key, at, True, False)
        case _:
            fail no_table(parser, key, at, False, False)

## Starts the table a header names, going through what its path names on the way.
def define(
    ref table: TomlTable,
    keys: list[str],
    step: int,
    array: bool,
    where: (TomlParser, int),
) fails ParseError:
    parser, at = where
    key = keys[step]
    place = table.place_of(key)
    if step < len(keys) - 1:
        mut held = place
        if held < 0:
            table.add(key, .Table(table=TomlTable()))
            held = len(table.values) - 1
        match table.values[held]:
            case .Table(inner):
                if inner.inline: fail no_table(parser, key, at, False, False)
                mut child = inner
                define(ref child, keys, step + 1, array, where)?
                table.values[held] = .Table(table=child)
            case .Tables(tables):
                mut children = tables
                mut last = children[len(children) - 1]
                define(ref last, keys, step + 1, array, where)?
                children[len(children) - 1] = last
                table.values[held] = .Tables(tables=children)
            case _:
                fail no_table(parser, key, at, False, False)
        return
    name = joined_keys(keys)
    if place < 0:
        if array:
            table.add(key, .Tables(tables=[TomlTable(header=True)]))
        else:
            table.add(key, .Table(table=TomlTable(header=True)))
        return
    shown = f"[[{name}]]" if array else f"[{name}]"
    match table.values[place]:
        case .Tables(tables):
            if not array:
                fail parser.bad_at(
                    f"`{cut_input(name)}` is already defined as something else, so it can't be `{cut_input(shown)}`",
                    at,
                )
            mut children = tables
            children.append(TomlTable(header=True))
            table.values[place] = .Tables(tables=children)
        case .Table(inner):
            if array or inner.inline:
                fail parser.bad_at(
                    f"`{cut_input(name)}` is already defined as something else, so it can't be `{cut_input(shown)}`",
                    at,
                )
            if inner.header or inner.dotted:
                fail parser.bad_at(f"the table `[{cut_input(name)}]` is defined twice", at)
            mut child = inner
            child.header = True
            table.values[place] = .Table(table=child)
        case _:
            fail parser.bad_at(
                f"`{cut_input(name)}` is already defined as something else, so it can't be `{cut_input(shown)}`",
                at,
            )

## Where a reader is in a table it's reading.
struct TomlFrame:
    table: TomlTable
    owner: str
    at = 0

## Reads what a TOML document holds, once it's been read.
struct TomlReader:
    _here: TomlValue
    _frames = list[TomlFrame]()
    _path = list[str]()
    _fields = list[(str, str)]()
    _place = 0
    _in_key = False
    _ids = IdsSeen()
    _tags = dict[str, int]()
    ## The items of each tuple being read, inside one another, and how many have been read.
    _tuples = list[(list[TomlValue], int)]()

    def _where(self) -> str:
        if len(self._path) == 0: return "the text"
        return f"`{self._dotted()}`"

    def _dotted(self) -> str:
        mut out = ""
        for part in self._path:
            if out != "" and text_byte(part, 0) != 91:
                out += "."
            out += part
        return out

    def _found(self) -> str:
        match self._here:
            case .Text(_):
                return "a str"
            case .Int(_):
                return "an int"
            case .Float(_):
                return "a float"
            case .Bool(_):
                return "a bool"
            case .List(_):
                return "a list"
            case .Tables(_):
                return "a list"
            case .Table(_):
                return "a table"

    def _misfit(self, wanted: str) -> ParseError:
        return ParseError(
            message=f"{self._where()} should be {article(wanted)}, but it's {self._found()}",
            line=0,
            column=0,
        )

    def int(ref self) -> int fails ParseError:
        match self._here:
            case .Int(n):
                return n
            case .Text(text):
                if self._in_key:
                    return int(text) except InvalidValue(): fail ParseError(
                        message=f"{self._where()} has the key \"{cut_input(text)}\", which isn't an int",
                        line=0,
                        column=0,
                    )
                fail self._misfit("int")
            case _:
                fail self._misfit("int")

    def float(ref self) -> float fails ParseError:
        match self._here:
            case .Float(x):
                return x
            case .Int(n):
                return float(n)
            case _:
                fail self._misfit("float")

    def bool(ref self) -> bool fails ParseError:
        match self._here:
            case .Bool(b):
                return b
            case _:
                fail self._misfit("bool")

    def text(ref self) -> str fails ParseError:
        match self._here:
            case .Text(text):
                return text
            case _:
                fail self._misfit("str")

    def bytes(ref self) -> bytes fails ParseError:
        match self._here:
            case .Text(text):
                return base64.decode(text) except InvalidValue(): fail ParseError(
                    message=f"{self._where()} should be bytes, written in base64",
                    line=0,
                    column=0,
                )
            case _:
                fail self._misfit("bytes")

    def none(ref self) -> bool fails ParseError:
        return False

    def value[T: Deserializable](ref self) -> T fails ParseError:
        return T.deserialize(ref self)?

    def sequence[T: Deserializable](ref self) -> list[T] fails ParseError:
        mut found = list[T]()
        match self._here:
            case .List(items):
                mut count = 0
                for item in items:
                    self._path.append(f"[{count}]")
                    count += 1
                    self._here = item
                    found.append(T.deserialize(ref self)?)
                    _ = self._path.pop()
            case .Tables(tables):
                mut count = 0
                for table in tables:
                    self._path.append(f"[{count}]")
                    count += 1
                    self._here = .Table(table=table)
                    found.append(T.deserialize(ref self)?)
                    _ = self._path.pop()
            case _:
                fail self._misfit(f"list[{type_name[T]()}]")
        return found

    def map[K: Deserializable, V: Deserializable](ref self) -> list[(K, V)] fails ParseError:
        mut found = list[(K, V)]()
        match self._here:
            case .Table(table):
                mut at = 0
                for key in table.keys:
                    self._here = .Text(text=key)
                    self._in_key = True
                    read = K.deserialize(ref self)?
                    self._in_key = False
                    self._path.append(f"[\"{cut_input(key)}\"]")
                    self._here = table.values[at]
                    found.append((read, V.deserialize(ref self)?))
                    _ = self._path.pop()
                    at += 1
            case _:
                fail self._misfit(f"dict[{type_name[K]()}, {type_name[V]()}]")
        return found

    def record(ref self, name: str) fails ParseError:
        match self._here:
            case .Table(table):
                self._frames.append(TomlFrame(table=table, owner=name))
            case _:
                mut wanted = name
                at = name.find(".")
                if at is not None:
                    wanted = name[:at]
                fail self._misfit(wanted)

    def next_field(ref self, fields: list[(str, str)]) -> bool fails ParseError:
        self._fields = fields
        top = len(self._frames) - 1
        frame = self._frames[top]
        if frame.at > 0:
            _ = self._path.pop()
        if frame.at >= len(frame.table.keys):
            _ = self._frames.pop()
            return False
        key = frame.table.keys[frame.at]
        self._frames[top].at = frame.at + 1
        mut at = 0
        for saved, own in fields:
            if saved == key:
                self._place = at
                self._path.append(key)
                self._here = frame.table.values[frame.at]
                return True
            at += 1
        owner = f"`{frame.owner}`"
        where = self._where()
        for saved, own in fields:
            if own == key:
                if saved == "":
                    fail ParseError(
                        message=f"{owner} doesn't save `{own}`, which has `@skip`, but {where} has it",
                        line=0,
                        column=0,
                    )
                fail ParseError(
                    message=f"{owner} saves `{own}` as \"{saved}\", but {where} has \"{key}\"",
                    line=0,
                    column=0,
                )
        fail ParseError(
            message=f"{owner} has no field \"{key}\", but {where} has one",
            line=0,
            column=0,
        )

    def field_at(self) -> int:
        return self._place

    def missing(self, name: str) -> ParseError:
        joined = self._dotted()
        if joined == "": return ParseError(message=f"`{name}` is missing", line=0, column=0)
        return ParseError(message=f"`{joined}.{name}` is missing", line=0, column=0)

    def rule(self, message: str) -> ParseError:
        return ParseError(message=f"in {self._where()}, {message}", line=0, column=0)

    def here(self, message: str) -> ParseError:
        return ParseError(message=f"{self._where()} {message}", line=0, column=0)

    def saw_id(ref self, kind: str, position: int):
        self._ids.id(kind, self._where(), position)

    def saw_table(ref self, kind: str, count: int):
        self._ids.table(kind, self._where(), count)

    def tag(ref self, kind: str) -> int:
        found = self._tags.get(kind) else 0
        if found > 0: return found
        made = new_tag()
        self._tags[kind] = made
        return made

    def none_next(ref self) -> bool:
        return False

    def exact(self) -> bool:
        return False

    def ordered(ref self, name: str) -> bool fails ParseError:
        return False

    def end_ordered(ref self):
        pass

    def map_count(ref self) -> int fails ParseError:
        return -1

    def end_map(ref self):
        pass

    def items(ref self, name: str, count: int) fails ParseError:
        match self._here:
            case .List(items) if len(items) == count:
                self._tuples.append((items, 0))
            case _:
                fail self._misfit(name)

    def item[T: Deserializable](ref self) -> T fails ParseError:
        top = self._tuples.pop() else fail self._misfit("a tuple")
        items, read = top
        self._here = items[read]
        self._tuples.append((items, read + 1))
        self._path.append(f"[{read}]")
        found = T.deserialize(ref self)?
        _ = self._path.pop()
        return found

    def end_items(ref self) fails ParseError:
        _ = self._tuples.pop()

    def at_item(self, at: int, message: str) -> ParseError:
        return ParseError(message=f"`{self._dotted()}[{at}]` {message}", line=0, column=0)

    def enum_case(ref self, name: str, cases: list[(str, bool)]) -> int fails ParseError:
        match self._here:
            case .Text(key):
                mut at = 0
                for case_name, has_data in cases:
                    if case_name == key:
                        if has_data:
                            fail ParseError(
                                message=f"{self._where()} is `{name}.{case_name}`, which needs its fields",
                                line=0,
                                column=0,
                            )
                        return at
                    at += 1
                fail ParseError(
                    message=f"{self._where()} is \"{key}\", which isn't a case of `{name}`",
                    line=0,
                    column=0,
                )
            case .Table(table):
                if len(table.keys) != 1: fail self._misfit(name)
                key = table.keys[0]
                inner = table.values[0]
                match inner:
                    case .Table(fields):
                        mut at = 0
                        for case_name, has_data in cases:
                            if case_name == key:
                                if not has_data and len(fields.keys) > 0:
                                    fail ParseError(
                                        message=f"`{name}.{case_name}` has no field \"{cut_input(fields.keys[0])}\", but {self._where()} has one",
                                        line=0,
                                        column=0,
                                    )
                                self._here = inner
                                return at
                            at += 1
                        fail ParseError(
                            message=f"{self._where()} is \"{key}\", which isn't a case of `{name}`",
                            line=0,
                            column=0,
                        )
                    case _:
                        fail self._misfit(name)
            case _:
                fail self._misfit(name)

    def end_case(ref self) fails ParseError:
        pass

    def member(ref self, names: list[str]) -> int fails ParseError:
        union = " | ".join(names)
        match self._here:
            case .Table(table):
                if len(table.keys) != 1: fail self._misfit(union)
                key = table.keys[0]
                mut at = 0
                for name in names:
                    if name == key:
                        self._here = table.values[0]
                        self._path.append(key)
                        return at
                    at += 1
                fail ParseError(
                    message=f"{self._where()} is \"{key}\", which is none of `{union}`",
                    line=0,
                    column=0,
                )
            case _:
                fail self._misfit(union)

    def end_member(ref self) fails ParseError:
        _ = self._path.pop()

## `text` read as a `T`, through its own `def deserialize`.
export def native_loads[T: Deserializable](text: str) -> T fails ParseError:
    mut parser = TomlParser(source=text)
    root = parser.document()?
    mut src = TomlReader(_here=.Table(table=root))
    value = T.deserialize(ref src)?
    found = src._ids.problem()
    if found != "": fail ParseError(message=found, line=0, column=0)
    return value

## Builds what's being written as a document's values, then writes them out.
struct TomlWriter:
    _done = TomlValue.Bool(b=False)
    _tables = list[TomlTable]()
    _wraps = list[str]()
    _after_case = False
    ## The member each union being written is, innermost last.
    _members = list[str]()
    ## Where each `Id` is in its `Table`, as `JsonWriter` keeps it.
    _id_tables = dict[str, dict[(int, int), int]]()
    _found = False
    _wants_tables = False
    _optional = False
    ## The items of each tuple being written, innermost last.
    _tuples = list[list[TomlValue]]()

    def int(ref self, value: int):
        self._done = .Int(n=value)

    def float(ref self, value: float):
        self._done = .Float(x=value)

    def bool(ref self, value: bool):
        self._done = .Bool(b=value)

    def text(ref self, value: str):
        self._done = .Text(text=value)

    def bytes(ref self, value: bytes):
        self._done = .Text(text=base64.encode(value))

    def none(ref self):
        assert False

    def value[T: Serializable](ref self, x: T):
        x.serialize(ref self)

    def sequence[T: Serializable](ref self, items: list[T]):
        self._optional = False
        mut built = list[TomlValue]()
        for item in items:
            item.serialize(ref self)
            built.append(self._done)
        self._done = .List(items=built)

    def map[K: Serializable, V: Serializable](ref self, pairs: list[(K, V)]):
        mut table = TomlTable()
        for key, value in pairs:
            key.serialize(ref self)
            name = key_text(self._done)
            value.serialize(ref self)
            table.add(name, self._done)
        self._done = .Table(table=table)

    def record(ref self, name: str, count: int):
        self._optional = False
        self._tables.append(TomlTable())
        self._wraps.append("")

    def field[T: Serializable](ref self, name: str, x: T):
        x.serialize(ref self)
        self._tables[len(self._tables) - 1].add(name, self._done)

    def renamed[T: Serializable](ref self, name: str, x: T):
        self.field(name, x)

    def items(ref self, name: str, count: int):
        self._optional = False
        self._tuples.append(list[TomlValue]())

    def item[T: Serializable](ref self, x: T):
        x.serialize(ref self)
        mut items = self._tuples.pop() else list[TomlValue]()
        items.append(self._done)
        self._tuples.append(items)

    def end_items(ref self):
        items = self._tuples.pop() else list[TomlValue]()
        self._done = .List(items=items)

    def end(ref self):
        if self._after_case:
            self._after_case = False
            return
        table = self._tables.pop(-1)
        wrap = self._wraps.pop(-1)
        self._done = .Table(table=table)
        if wrap != "":
            mut outer = TomlTable()
            outer.add(wrap, self._done)
            self._done = .Table(table=outer)
            self._after_case = True

    def enum_case(ref self, name: str, case_name: str, at: int):
        self._done = .Text(text=case_name)

    def case_record(ref self, name: str, case_name: str, at: int, count: int):
        self._tables.append(TomlTable())
        self._wraps.append(case_name)

    def member(ref self, name: str, at: int):
        self._optional = False
        self._members.append(name)

    def end_member(ref self):
        mut outer = TomlTable()
        outer.add(self._members.pop(-1), self._done)
        self._done = .Table(table=outer)

    def table[T: Serializable](ref self, kind: str, tag: int, ids: list[Id[T]], items: list[T]):
        self.sequence(items)

    def exact(self) -> bool:
        return False

    def slots[T: Serializable](ref self, kind: str, tag: int, slots: list[int], items: list[T]):
        # Never asked for: `exact` says no.
        pass

    def id(ref self, kind: str, key: int, tag: int):
        optional = self._optional
        self._optional = False
        if not self._found:
            self._wants_tables = True
            self._done = .Int(n=0)
            return
        positions = self._id_tables.get(kind) else dict[(int, int), int]()
        position = positions.get((key, tag)) else -1
        if position < 0 and optional:
            stop(
                "TOML has no None, so an optional Id whose item has gone can't be saved; leave it out",
            )
        self._done = .Int(n=position)

    def some[T: Serializable](ref self, x: T):
        self._optional = True
        x.serialize(ref self)
        self._optional = False

def key_text(key: TomlValue) -> str:
    match key:
        case .Text(text):
            return text
        case .Int(n):
            return str(n)
        case _:
            return ""

## A string in double quotes, with the escapes TOML shares with JSON.
def quoted_text(text: str) -> str:
    mut out = "\""
    size = text_size(text)
    mut start = 0
    mut at = 0
    while at < size:
        b = text_byte(text, at)
        if b < 32 or b == 34 or b == 92 or b == 127:
            out += text_part(text, start, at)
            out += escape_of(b)
            at += 1
            start = at
        elif b == 194 and text_byte(text, at + 1) < 160:
            out += text_part(text, start, at)
            out += escape_of(text_byte(text, at + 1))
            at += 2
            start = at
        else:
            at += 1
    out += text_part(text, start, size)
    return out + "\""

def table_key(key: str) -> str:
    size = text_size(key)
    if size == 0: return quoted_text(key)
    for at in range(size):
        b = text_byte(key, at)
        if not (
            (b >= 97 and b <= 122)
            or (b >= 65 and b <= 90)
            or (b >= 48 and b <= 57)
            or b == 95
            or b == 45
        ):
            return quoted_text(key)
    return key

## A value written on one line: inside an array or inline table, or after `key =`.
def one_line(value: TomlValue) -> str:
    match value:
        case .Text(text):
            return quoted_text(text)
        case .Int(n):
            return str(n)
        case .Float(x):
            return float_text(x)
        case .Bool(b):
            return "true" if b else "false"
        case .List(items):
            return "[" + ", ".join([one_line(item) for item in items]) + "]"
        case .Tables(tables):
            return "[" + ", ".join([one_line(.Table(table=table)) for table in tables]) + "]"
        case .Table(table):
            return inline_text(table)

def inline_text(table: TomlTable) -> str:
    if len(table.keys) == 0: return "{}"
    mut parts = list[str]()
    mut at = 0
    for key in table.keys:
        parts.append(f"{table_key(key)} = {one_line(table.values[at])}")
        at += 1
    return "{ " + ", ".join(parts) + " }"

## The tables a list holds, if it's a non-empty list of nothing else.
def all_tables(items: list[TomlValue]) -> list[TomlTable]?:
    if len(items) == 0: return None
    mut tables = list[TomlTable]()
    for item in items:
        match item:
            case .Table(table):
                tables.append(table)
            case _:
                return None
    return tables

## A table's plain keys under its header, then its tables and arrays of tables.
## `text`, followed by a table, and the tables it holds, as TOML text under the header `path`.
def write_table(text: str, path: list[str], table: TomlTable, array: bool) -> str:
    mut out = text
    mut plain = list[int]()
    mut nested = list[int]()
    mut at = 0
    for value in table.values:
        match value:
            case .Table(_):
                nested.append(at)
            case .Tables(_):
                nested.append(at)
            case .List(items):
                if all_tables(items) is None:
                    plain.append(at)
                else:
                    nested.append(at)
            case _:
                plain.append(at)
        at += 1
    if len(path) > 0 and (array or len(plain) > 0 or len(nested) == 0):
        if out != "":
            out += "\n"
        name = ".".join([table_key(key) for key in path])
        out += f"[[{name}]]\n" if array else f"[{name}]\n"
    for place in plain:
        out += f"{table_key(table.keys[place])} = {one_line(table.values[place])}\n"
    for place in nested:
        mut under = list[str]()
        for key in path:
            under.append(key)
        under.append(table.keys[place])
        match table.values[place]:
            case .Table(inner):
                out = write_table(out, under, inner, False)
            case .Tables(tables):
                for inner in tables:
                    out = write_table(out, under, inner, True)
            case .List(items):
                for inner in all_tables(items) else list[TomlTable]():
                    out = write_table(out, under, inner, True)
            case _:
                pass
    return out

## `value` as TOML text, through its own `def serialize`.
export def native_dumps[T: Serializable](value: T) -> str:
    mut out = TomlWriter()
    value.serialize(ref out)
    if out._wants_tables:
        out = TomlWriter(_id_tables=tables_in(value), _found=True)
        value.serialize(ref out)
    mut text = ""
    match out._done:
        case .Table(table):
            text = write_table(text, list[str](), table, False)
        case _:
            assert False
    return text

## Whether a `YYYY-MM-DD` that's in range is a day its month really has.
def real_day(date: str) -> bool:
    parts = date.split("-")
    year = int(parts[0]) except InvalidValue(): 0
    month = int(parts[1]) except InvalidValue(): 0
    day = int(parts[2]) except InvalidValue(): 0
    leap = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
    if month == 2: return day <= (29 if leap else 28)
    if month == 4 or month == 6 or month == 9 or month == 11: return day <= 30
    return True
