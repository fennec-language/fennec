## Hitting enemies, in a module one folder down.

from std.math import Vec3

from enemies import Enemy
import enemies

## Whether an enemy is down is about damage, so it's written here, as `Enemy`'s own method.
extend Enemy:
    ## Whether it has no health left.
    def is_down(self) -> bool:
        self.health <= 0

error Dodged:
    name: str

def hit(ref enemy: enemies.Enemy, amount: int) -> int fails Dodged:
    if amount == 0: fail Dodged(enemy.name)
    enemy.health -= amount
    enemy.health

test "hitting takes health away":
    mut enemy = enemies.spawn("dummy", Vec3.zero, 100)
    assert hit(ref enemy, 10)? == 90
