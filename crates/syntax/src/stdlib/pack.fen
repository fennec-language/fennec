## `std.pack`: a compact binary format for anything that saves, through the same `serialize` and
## `deserialize` as JSON and TOML. Fields go in the order they're written, with no names, so
## the bytes say nothing of the type they were written from but its shape: they start with
## `FPK1` and a number for the type's shape, and loading into a type whose shape differs fails
## at once rather than reading the bytes as something else. Changing a field, its type or its
## place, or a case of an enum, changes the shape.
##
## ```fennec
## from std import pack
##
## data = pack.dumps(world)
## back = pack.loads[World](data)?
## ```
##
## Loading checks every length against what's left and against `Limits` before it takes
## anything, so bytes that aren't what `dumps` wrote fail with a `ParseError` rather than nesting
## too deep or asking for more than they hold.
##
## A `Table` is saved as JSON saves it, as its items in order, with each `Id` as where its item is,
## and loading makes a new `Table`. With `exact=True` it's saved slot for slot instead: the slots
## taken out, their generations, and each `Id` as its slot and generation. Loading then gives the
## same slots, so a replay's later `add`s hand out the same `Id`s, and an `Id` whose item had gone
## is still gone. Either way an `Id` has to be in a `Table` saved with it, one of each type.

from std.intrinsics import bytes_builder, bytes_push, bytes_push_bytes, bytes_push_text, bytes_push_word, bytes_set, bytes_text, float_bits, float_of_bits, new_tag, shape_hash, text_byte, text_size, type_name
from std.json import IdsSeen, found_tables

## How far a load may go. Bytes that ask for more fail to load.
export struct Limits:
    ## How deeply lists, dicts, structs and cases may nest.
    depth = 64
    ## The most bytes one text or `bytes` may hold, and the most items a load may read in all.
    length = 16_000_000

## `value` as bytes, which `loads` reads back into the same type. With `exact`, its `Table`s are
## saved slot for slot.
export def dumps[T: Serializable](value: T, exact = False) -> bytes:
    mut out = PackWriter(_exact=exact)
    out._header(shape_hash[T]())
    value.serialize(ref out)
    if not out._wants_tables: return out._done()
    # It holds `Id`s, so where each one's item is comes first, and every one's checked.
    found = found_tables(value, exact)
    mut again = PackWriter(_exact=exact, _tables=found.positions(), _tags=found.tags(), _found=True)
    again._header(shape_hash[T]())
    value.serialize(ref again)
    again._done()

## A `T` from bytes `dumps` wrote for a `T`. It fails if they were written for another shape of
## type, if they end too soon or go on past it, or if they go past `limits`.
export def loads[T: Deserializable](data: bytes, limits: Limits? = None) -> T fails ParseError:
    held = limits else Limits()
    mut src = PackReader(_data=data, _most_deep=held.depth, _longest=held.length)
    match read_value[T](ref src):
        case Ok(value):
            value
        case Err(_):
            # Read again keeping track of where it is, which a load that works never pays for.
            mut again = PackReader(
                _data=data,
                _most_deep=held.depth,
                _longest=held.length,
                _explain=True,
            )
            read_value[T](ref again)?

def read_value[T: Deserializable](ref src: PackReader) -> T fails ParseError:
    src._header(shape_hash[T](), type_name[T]())?
    value = T.deserialize(ref src)?
    if src._at != src._data.len(): fail src._fail("there's more after the value")
    problem = src._ids.problem()
    if problem != "": fail ParseError(message=problem if src._explain else "", line=0, column=0)
    value

## The bits a varint takes, 7 at a time, with the top 7 cleared after an arithmetic shift so it
## goes down as an unsigned number would.
LOW_57 = 144115188075855871

## The top bit of an int cleared, for a shift by 1 that goes down as an unsigned number would.
LOW_63 = 9223372036854775807

## Writes what a value's `serialize` gives it as bytes.
export struct PackWriter:
    ## What's written so far, in a builder with room to grow.
    _out = bytes_builder()
    _exact = False
    ## Where each `Id` is in its `Table`, by the name of its type and then its `id_key` and tag,
    ## and each `Table`'s tag, once what's written has been gone through. Until then an `Id` asks
    ## for them.
    _tables = dict[str, dict[(int, int), int]]()
    _tags = dict[str, int]()
    _found = False
    _wants_tables = False
    ## Whether what's being written is in an optional, and where its byte that says it's there is,
    ## for an `Id` that's saved as missing.
    _optional = False
    _some_at = 0

    ## The bytes written, at their exact size, which is all anything but this writer sees of them.
    def _done(self) -> bytes:
        self._out[0:self._out.len()]

    def _header(ref self, shape: int):
        # `FPK1`, or `FPKE` for `Table`s slot for slot.
        for b in [70, 80, 75, 69 if self._exact else 49]:
            bytes_push(ref self._out, b)
        self._word(shape)

    ## A whole word, low byte first.
    def _word(ref self, bits: int):
        bytes_push_word(ref self._out, bits)

    ## A number as unsigned, 7 bits a byte, low first, with the top bit of each saying more come.
    def _varint(ref self, n: int):
        mut rest = n
        while rest < 0 or rest >= 128:
            bytes_push(ref self._out, (rest & 127) | 128)
            rest = (rest >> 7) & LOW_57
        bytes_push(ref self._out, rest)

    def int(ref self, value: int):
        # Zigzag: small numbers either side of 0 take one byte.
        self._varint((value << 1) ^ (value >> 63))

    def float(ref self, value: float):
        self._word(float_bits(value))

    def bool(ref self, value: bool):
        bytes_push(ref self._out, 1 if value else 0)

    def text(ref self, value: str):
        self._varint(text_size(value))
        bytes_push_text(ref self._out, value)

    def bytes(ref self, value: bytes):
        self._varint(value.len())
        bytes_push_bytes(ref self._out, value)

    def none(ref self):
        bytes_push(ref self._out, 0)

    def some[T: Serializable](ref self, x: T):
        self._some_at = self._out.len()
        bytes_push(ref self._out, 1)
        self._optional = True
        x.serialize(ref self)
        self._optional = False

    def value[T: Serializable](ref self, x: T):
        x.serialize(ref self)

    def sequence[T: Serializable](ref self, items: list[T]):
        self._optional = False
        self._varint(items.len())
        for item in items:
            item.serialize(ref self)

    def map[K: Serializable, V: Serializable](ref self, pairs: list[(K, V)]):
        self._optional = False
        self._varint(pairs.len())
        for key, value in pairs:
            key.serialize(ref self)
            value.serialize(ref self)

    def record(ref self, name: str, count: int):
        self._optional = False

    def field[T: Serializable](ref self, name: str, x: T):
        x.serialize(ref self)

    def renamed[T: Serializable](ref self, name: str, x: T):
        x.serialize(ref self)

    def end(ref self):
        pass

    def case(ref self, name: str, case: str, at: int):
        self._varint(at)

    def case_record(ref self, name: str, case: str, at: int, count: int):
        self._optional = False
        self._varint(at)

    def member(ref self, name: str, at: int):
        self._optional = False
        self._varint(at)

    def end_member(ref self):
        pass

    def table[T: Serializable](ref self, kind: str, tag: int, ids: list[Id[T]], items: list[T]):
        self.sequence(items)

    def exact(self) -> bool:
        self._exact

    def slots[T: Serializable](ref self, kind: str, tag: int, slots: list[int], items: list[T]):
        self.sequence(slots)
        self.sequence(items)

    def id(ref self, kind: str, key: int, tag: int):
        optional = self._optional
        self._optional = False
        if not self._found:
            self._wants_tables = True
            return
        if self._exact:
            if tag == (self._tags.get(kind) else 0):
                self.int(key >> 32)
                self.int(key & 4294967295)
                return
        else:
            positions = self._tables.get(kind) else dict[(int, int), int]()
            position = positions.get((key, tag)) else -1
            if position >= 0:
                self.int(position)
                return
        # Going through it found nothing wrong, so it's optional: it's saved as missing.
        if optional:
            bytes_set(ref self._out, self._some_at, 0)

## Reads bytes `PackWriter` wrote, for a value's `deserialize`.
export struct PackReader:
    _data: bytes
    _at = 0
    _depth = 0
    _most_deep = 64
    _longest = 16_000_000
    ## How many more items this load may read.
    _items_left = 16_000_000
    ## The next field of each struct being read, innermost last, and the one just read.
    _next = list[int]()
    _field = 0
    _exact = False
    ## Each `Id` and `Table` read, checked once everything has been.
    _ids = IdsSeen(_whole="the data")
    ## The tag each `Table` of a type gets, new for each load.
    _tags = dict[str, int]()
    ## Whether to keep track of where it is, for a message, and where.
    _explain = False
    _path = list[str]()

    def _fail(self, message: str) -> ParseError:
        self._fail_at(self._at, message)

    ## The error for what starts at byte `at`.
    def _fail_at(self, at: int, message: str) -> ParseError:
        ParseError(message=f"{message}, at byte {at}", line=0, column=0)

    def _header(ref self, shape: int, name: str) fails ParseError:
        self._items_left = self._longest
        if self._data.len() < 12: fail self._fail("these aren't bytes `std.pack` wrote")
        for at, b in enumerate([70, 80, 75]):
            if self._data[at] != b: fail self._fail("these aren't bytes `std.pack` wrote")
        mode = self._data[3]
        if mode != 49 and mode != 69: fail self._fail("these aren't bytes `std.pack` wrote")
        self._exact = mode == 69
        self._at = 4
        if self._word()? != shape:
            self._at = 4
            fail self._fail(f"this was packed from a different `{name}`")

    def _byte(ref self) -> int fails ParseError:
        if self._at >= self._data.len(): fail self._fail("the data ends too soon")
        b = self._data[self._at]
        self._at += 1
        b

    def _word(ref self) -> int fails ParseError:
        if self._at + 8 > self._data.len(): fail self._fail("the data ends too soon")
        mut bits = 0
        for at in range(8):
            bits = bits | (self._data[self._at + at] << (8 * at))
        self._at += 8
        bits

    def _varint(ref self) -> int fails ParseError:
        # Most take one byte, read here with no call.
        at = self._at
        if at < self._data.len():
            b = self._data[at]
            if b < 128:
                self._at = at + 1
                return b
        first = self._byte()?
        mut n = first & 127
        mut shift = 7
        while True:
            b = self._byte()?
            if shift == 63 and b > 1: fail self._fail("a number is too long")
            n = n | ((b & 127) << shift)
            if b < 128: return n
            shift += 7
            if shift > 63: fail self._fail("a number is too long")
        n

    ## A count of what follows, which may be no more than the limit.
    def _length(ref self) -> int fails ParseError:
        start = self._at
        n = self._varint()?
        if n < 0 or n > self._longest:
            fail self._fail_at(start, f"a length is over the limit of {self._longest}")
        n

    ## The next `n` bytes, which have to be there.
    def _run(ref self) -> bytes fails ParseError:
        n = self._length()?
        if n > self._data.len() - self._at: fail self._fail("the data ends too soon")
        part = self._data[self._at:self._at + n]
        self._at += n
        part

    def _deeper(ref self) fails ParseError:
        self._depth += 1
        if self._depth > self._most_deep:
            fail self._fail(f"it nests deeper than the limit of {self._most_deep}")

    ## Counts `n` items against the limit on items, before any is read.
    def _items(ref self, n: int) fails ParseError:
        self._items_left -= n
        if self._items_left < 0:
            fail self._fail(f"it holds more than the limit of {self._longest} items")

    def int(ref self) -> int fails ParseError:
        z = self._varint()?
        ((z >> 1) & LOW_63) ^ (0 - (z & 1))

    def float(ref self) -> float fails ParseError:
        float_of_bits(self._word()?)

    def bool(ref self) -> bool fails ParseError:
        b = self._byte()?
        if b > 1: fail self._fail_at(self._at - 1, "a bool should be 0 or 1")
        b == 1

    def text(ref self) -> str fails ParseError:
        start = self._at
        n = self._length()?
        if n > self._data.len() - self._at: fail self._fail("the data ends too soon")
        # Made straight from the bytes, which bytes that aren't UTF-8 never come out empty from.
        text = bytes_text(self._data, self._at, self._at + n)
        if n > 0 and text_size(text) == 0: fail self._fail_at(start, "a text isn't UTF-8")
        self._at += n
        text

    def bytes(ref self) -> bytes fails ParseError:
        self._run()?

    def none(ref self) -> bool fails ParseError:
        b = self._byte()?
        if b > 1: fail self._fail_at(self._at - 1, "an optional should start with 0 or 1")
        b == 0

    def value[T: Deserializable](ref self) -> T fails ParseError:
        T.deserialize(ref self)?

    def sequence[T: Deserializable](ref self) -> list[T] fails ParseError:
        n = self._length()?
        self._items(n)?
        self._deeper()?
        mut found = list[T]()
        for at in range(n):
            if self._explain:
                self._path.append(f"[{at}]")
            found.append(T.deserialize(ref self)?)
            if self._explain:
                _ = self._path.pop()
        self._depth -= 1
        found

    def map[K: Deserializable, V: Deserializable](ref self) -> list[(K, V)] fails ParseError:
        n = self._length()?
        self._items(n)?
        self._deeper()?
        mut found = list[(K, V)]()
        for at in range(n):
            if self._explain:
                self._path.append(f"[{at}]")
            key = K.deserialize(ref self)?
            value = V.deserialize(ref self)?
            found.append((key, value))
            if self._explain:
                _ = self._path.pop()
        self._depth -= 1
        found

    def record(ref self, name: str) fails ParseError:
        self._deeper()?
        self._next.append(0)
        if self._explain:
            self._path.append("")

    def next_field(ref self, fields: list[(str, str)]) -> bool fails ParseError:
        at = self._next[self._next.len() - 1]
        # Fields that aren't saved come last, with no name in the text.
        if at < fields.len() and fields[at][0] != "":
            self._next[self._next.len() - 1] = at + 1
            self._field = at
            if self._explain:
                self._path[self._path.len() - 1] = fields[at][0]
            return True
        _ = self._next.pop()
        self._depth -= 1
        if self._explain:
            _ = self._path.pop()
        False

    ## Where the reader is, as messages say it.
    def _where(self) -> str:
        mut out = ""
        for part in self._path:
            if out != "" and text_byte(part, 0) != 91:
                out += "."
            out += part
        "the data" if out == "" else f"`{out}`"

    def field_at(self) -> int:
        self._field

    def missing(self, name: str) -> ParseError:
        self._fail(f"`{name}` is missing")

    def rule(self, message: str) -> ParseError:
        self._fail(message)

    def at_item(self, at: int, message: str) -> ParseError:
        self._fail(f"item {at} {message}")

    def here(self, message: str) -> ParseError:
        self._fail(f"{self._where()} {message}")

    def saw_id(ref self, kind: str, position: int):
        self._ids.id(kind, self._where() if self._explain else "", position)

    def saw_table(ref self, kind: str, count: int):
        self._ids.table(kind, self._where() if self._explain else "", count)

    def tag(ref self, kind: str) -> int:
        found = self._tags.get(kind) else 0
        if found > 0: return found
        made = new_tag()
        self._tags[kind] = made
        made

    def none_next(ref self) -> bool:
        False

    def ordered(ref self, name: str) -> bool fails ParseError:
        # Read again for a message, it goes through `record`, which keeps track of names.
        if self._explain: return False
        self._deeper()?
        True

    def end_ordered(ref self):
        self._depth -= 1

    def map_count(ref self) -> int fails ParseError:
        # Read again for a message, it goes through `map`, which keeps track of where it is.
        if self._explain: return -1
        n = self._length()?
        self._items(n)?
        self._deeper()?
        n

    def end_map(ref self):
        self._depth -= 1

    def exact(self) -> bool:
        self._exact

    def case(ref self, name: str, cases: list[(str, bool)]) -> int fails ParseError:
        start = self._at
        at = self._varint()?
        if at < 0 or at >= cases.len(): fail self._fail_at(start, f"`{name}` has no case {at}")
        at

    def end_case(ref self) fails ParseError:
        pass

    def member(ref self, names: list[str]) -> int fails ParseError:
        start = self._at
        at = self._varint()?
        if at < 0 or at >= names.len():
            union = " | ".join(names)
            fail self._fail_at(start, f"`{union}` has no member {at}")
        self._deeper()?
        at

    def end_member(ref self) fails ParseError:
        self._depth -= 1
