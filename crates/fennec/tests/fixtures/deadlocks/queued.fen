# A waiting call with more items than workers, whose early ranges receive on a channel its later
# ranges, still queued, send to, 50 calls a run. At 1 thread every range after the first is queued
# while the first parks. Never a deadlock. (From Fable 5.2's review of the phase 2 design.)
from std.concurrent import Channel, Closed, channel

def part(at: int, half: int, pipe: Channel[int]) -> int:
    if at < half:
        got = pipe.receive() else -1
        return got
    pipe.send(at) except Closed():
        return -100
    return 0

def all_parts(pipe: Channel[int]) -> int:
    got = [part(at, half=8, pipe=pipe) for at in parallel(range(16))]
    return sum(got)

def main(stdout: Stdout):
    mut total = 0
    for turn in range(50):
        with channel[int](size=1) as pipe:
            total += all_parts(pipe)
    stdout.print(total)
