## A file's own names may reuse names from other files it hasn't imported by name.
## Each name below is bound one way only, so each way is checked.

import tools

def main(stdout: Stdout):
    total = tools.total([1, 2, 3])
    first, scale = (tools.first([4, 5]), 2)
    stdout.print(total, first * scale)
    stdout.print([count * 2 for count in [1, 2]])
    stdout.print(sorted([3, 1, 2], key=size => -size))
    for step in [10]:
        stdout.print(step)
    stdout.print(located([7, 8], 8))
    stdout.print(scaled(3, scale=4))

## Where `wanted` is in `values`, or why it can't be found.
def located(values: list[int], wanted: int) -> str:
    index = tools.find(values, wanted) except why:
        case tools.Missing(value):
            return f"{value} is missing"
        case _:
            return f"{why}"
    return f"found at {index}"

def scaled(first: int, scale: int) -> int:
    return first * scale
