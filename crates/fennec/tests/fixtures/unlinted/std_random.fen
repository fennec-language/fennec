# decision: `Random` is a seeded value.

from std.random import Random

struct Enemy:
    name: str
    health: int

## Rolls `count` dice with `sides` sides each.
def roll(ref rng: Random, count: int, sides: int) -> int:
    return sum(rng.randint(1, high=sides) for _ in range(count))

test "the same seed gives the same numbers" for seed: int:
    mut a = Random(seed=seed)
    mut b = Random(seed=seed)
    assert [a.randint(0, high=99) for _ in range(5)] == [b.randint(0, high=99) for _ in range(5)]

test "randint stays in its range" for seed: int, low: int:
    mut rng = Random(seed=seed)
    value = rng.randint(low, high=low + 5)
    assert low <= value <= low + 5

test "shuffling keeps every item" for seed: int, items: list[int]:
    mut rng = Random(seed=seed)
    mut shuffled = items
    rng.shuffle(ref shuffled)
    assert sorted(shuffled) == sorted(items)

def main(stdout: Stdout):
    mut rng = Random(seed=42)
    stdout.print([rng.randint(1, high=6) for _ in range(10)])
    stdout.print(roll(ref rng, 3, 6), rng.random(), rng.uniform(-1.0, high=1.0))

    enemies = [
        Enemy(name="goblin", health=7),
        Enemy(name="orc", health=15),
        Enemy(name="troll", health=30),
    ]
    stdout.print(rng.choice(enemies).name)

    mut deck = ["ace", "king", "queen", "jack", "ten"]
    rng.shuffle(ref deck)
    stdout.print(deck)
    stdout.print(rng)

    # A replay starts again from the same seed and sees the same numbers.
    mut replay = Random(seed=42)
    stdout.print([replay.randint(1, high=6) for _ in range(10)])

    # Picked up partway: the number after seed 7's first three, from 0 to 9.
    mut later = Random(seed=7, drawn=3)
    value = later.randint(0, high=9)
    stdout.print(value, later.drawn)
    mut wide = Random(seed=-1)
    stdout.print(wide.randint(-9_223_372_036_854_775_807, high=9_223_372_036_854_775_807))
