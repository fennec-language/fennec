# decision: A function that can fail says so with `fails Name`, and every exit is visible.

# `-> T fails E` gives back a `T` or fails with an `E`, and nothing else can escape it: a
# failure of another kind is handled inside, or becomes an `E`.

error LoadError:
    Missing(name: str)
    BadRow(line: int)

def amount(value: float, line: int) -> float fails LoadError:
    if value < 0.0: return Err(LoadError.BadRow(line))
    value

def total(rows: list[float]) -> float fails LoadError:
    if rows.len() == 0: fail .Missing("rows")
    sum([amount(value, line + 1)? for line, value in enumerate(rows)])

def report(rows: list[float]) -> str:
    found = total(rows) else as why:
        match why:
            case .BadRow(line):
                return f"row {line} is negative"
            case .Missing(name):
                return f"no {name}"
    f"total {found}"

def main(stdout: Stdout):
    stdout.print(report([1.5, 2.25]))
    stdout.print(report([1.5, -1.0, 3.0]))
    stdout.print(report([]))
