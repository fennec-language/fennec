# The standard library's collections are written in their natural shape: a `SortedMap` is an
# object, a `SortedSet` or a `Deque` is an array, and a `Grid` is an array of rows. They read
# back the same way, so the JSON doesn't change when how they're stored inside does.
from std import json
from std.collections import Deque, Grid, SortedMap, SortedSet

struct Board:
    cells: Grid[int]
    scores: SortedMap[str, int]
    seen: SortedSet[int]
    queue: Deque[str]

def failure[T](found: Result[T, ParseError]) -> str:
    match found:
        case Err(error):
            error.message
        case _:
            "loaded"

test "each collection is written as what it holds":
    mut scores = SortedMap[str, int]()
    scores["vex"] = 3
    scores["ash"] = 1
    assert json.dumps(scores) == "{\"ash\": 1, \"vex\": 3}"
    assert json.dumps(SortedSet.of([3, 1, 2])) == "[1, 2, 3]"
    mut queue = Deque.of(["a", "b", "c"])
    queue.popleft()
    queue.append("d")
    assert json.dumps(queue) == "[\"b\", \"c\", \"d\"]"
    assert json.dumps(Grid.of([[1, 2], [3, 4]])) == "[[1, 2], [3, 4]]"

test "they read back the same":
    scores = json.loads[SortedMap[str, int]]("{\"vex\": 3, \"ash\": 1}")?
    assert scores.items() == [("ash", 1), ("vex", 3)]
    seen = json.loads[SortedSet[int]]("[3, 1, 3]")?
    assert seen.items() == [1, 3]
    queue = json.loads[Deque[str]]("[\"x\", \"y\"]")?
    assert queue.items() == ["x", "y"]
    grid = json.loads[Grid[int]]("[[1, 2, 3], [4, 5, 6]]")?
    assert grid.width == 3 and grid.height == 2 and grid[(2, 1)] == 6

test "a struct holding them round-trips":
    mut cells = Grid.filled(width=2, height=2, value=0)
    cells[(1, 0)] = 7
    mut scores = SortedMap[str, int]()
    scores["kit"] = 2
    board = Board(cells=cells, scores=scores, seen=SortedSet.of([4, 2]), queue=Deque.of(["go"]))
    text = json.dumps(board)
    assert (
        text
        == "{\"cells\": [[0, 7], [0, 0]], \"scores\": {\"kit\": 2}, \"seen\": [2, 4], \"queue\": [\"go\"]}"
    )
    loaded = json.loads[Board](text)?
    assert loaded == board

test "rows that don't line up say where":
    assert (
        failure(json.loads[Grid[int]]("[[1, 2], [3]]"))
        == "`[1]` has 1 cell, but the first row has 2"
    )
    assert (
        failure(
            json.loads[Board](
                "{\"cells\": [[1], [2, 3]], \"scores\": {}, \"seen\": [], \"queue\": []}",
            ),
        )
        == "`cells[1]` has 2 cells, but the first row has 1"
    )
    assert (
        failure(json.loads[SortedSet[int]]("[1, \"two\"]"))
        == "`[1]` should be an int, but it's a str"
    )

def main(stdout: Stdout):
    mut scores = SortedMap[str, int]()
    for name in ["vex", "ash", "kit"]:
        scores[name] = name.len()
    stdout.print(json.dumps(scores))
    stdout.print(json.dumps(Grid.of([["#", "."], [".", "#"]])))
