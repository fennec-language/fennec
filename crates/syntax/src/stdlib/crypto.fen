## What `blake3(chunks)` and `sha256(chunks)` are written with, and their `_digest` forms, which give
## the digest's own bytes rather than hex: each chunk, text or `bytes`, is given to the hash in
## turn, so a file far bigger than memory hashes in a few kilobytes, as
## `blake3(file.chunks(1_000_000)?)` does. The checker sends a call here when what's hashed is a list
## or an iterator of chunks.
from std import crypto

def blake3_of_str_chunks(chunks: Iterator[str]) -> str:
    handle = crypto._start("blake3")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def blake3_of_str_list(chunks: list[str]) -> str:
    handle = crypto._start("blake3")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def blake3_of_bytes_chunks(chunks: Iterator[bytes]) -> str:
    handle = crypto._start("blake3")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def blake3_of_bytes_list(chunks: list[bytes]) -> str:
    handle = crypto._start("blake3")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def sha256_of_str_chunks(chunks: Iterator[str]) -> str:
    handle = crypto._start("sha256")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def sha256_of_str_list(chunks: list[str]) -> str:
    handle = crypto._start("sha256")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def sha256_of_bytes_chunks(chunks: Iterator[bytes]) -> str:
    handle = crypto._start("sha256")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def sha256_of_bytes_list(chunks: list[bytes]) -> str:
    handle = crypto._start("sha256")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def blake3_digest_of_str_chunks(chunks: Iterator[str]) -> bytes:
    handle = crypto._start("blake3")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end_digest(handle)

def blake3_digest_of_str_list(chunks: list[str]) -> bytes:
    handle = crypto._start("blake3")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end_digest(handle)

def blake3_digest_of_bytes_chunks(chunks: Iterator[bytes]) -> bytes:
    handle = crypto._start("blake3")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end_digest(handle)

def blake3_digest_of_bytes_list(chunks: list[bytes]) -> bytes:
    handle = crypto._start("blake3")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end_digest(handle)

def sha256_digest_of_str_chunks(chunks: Iterator[str]) -> bytes:
    handle = crypto._start("sha256")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end_digest(handle)

def sha256_digest_of_str_list(chunks: list[str]) -> bytes:
    handle = crypto._start("sha256")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end_digest(handle)

def sha256_digest_of_bytes_chunks(chunks: Iterator[bytes]) -> bytes:
    handle = crypto._start("sha256")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end_digest(handle)

def sha256_digest_of_bytes_list(chunks: list[bytes]) -> bytes:
    handle = crypto._start("sha256")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end_digest(handle)

## Something that has to stay secret, like a password, a token or a key: `Secret[str]` or
## `Secret[bytes]`. Printing one, putting it in an f-string, making text of it with `str()`, and
## saving it are compile errors, and so is showing anything that holds one. What it holds comes out
## only through `expose_secret()`, so searching for that name finds every place a secret is read.
## `==` on two compares what they hold in constant time.
##
## ```fennec
## token = env.secret("API_TOKEN")?
## headers = {"authorization": f"Bearer {token.expose_secret()}"}
## ```
export struct Secret[T]:
    _value: T

    ## A secret holding `value`.
    def of(value: T) -> Secret[T]:
        return Secret(_value=value)

    ## What it holds, to use where it's needed, like a request's header. The name says a secret
    ## is being read, here and nowhere else.
    def expose_secret(self) -> T:
        return self._value

    ## Two secrets are equal when what they hold is, compared in time that depends only on
    ## their lengths, as `equal` compares, so how long it takes never says where they differ.
    def ==(self, other: Secret[T]) -> bool:
        return crypto.equal(self._value, other._value)

    ## However it's printed, as through a generic function's `T`, it shows only that it's there.
    def str(self, ref out: StrWriter):
        out.write("Secret(hidden)")

## A secret loads as what it holds, so a password in a request's body comes in as a `Secret` and
## never sits in a plain `str` first. Loading brings a secret in; saving one is refused where it's
## written, since that would let it out.
extend Secret[T: Deserializable]:
    def deserialize(ref src: Deserializer) -> Secret[T] fails ParseError:
        return Secret.of(src.value[T]()?)

## Why a stored password can't be checked: it isn't an Argon2id hash as `hash_password` writes
## one, or its settings are below the least that's checked or past the most worth the memory.
export error PasswordError:
    reason: str

    def message(self) -> str:
        return self.reason

## `password` stretched with Argon2id under a fresh 16-byte salt from `entropy`, as text to keep,
## like `$argon2id$v=19$m=19456,t=2,p=1$<salt>$<hash>`. The settings are OWASP's floor, 19 MiB and
## two passes, and they travel with the hash, so they can be raised later. In a task it's worked
## out on a thread of its own while the task waits parked, a thread to a core and at most 8 at
## once, so a burst of sign-ups neither stalls a server nor takes all the memory. Inside a `lock`
## it's worked out where it is.
export def hash_password(password: Secret[str], entropy: Entropy) -> str:
    return crypto._hash_password(password.expose_secret(), entropy.bytes(16))

## Whether `password` is the one `stored` was made from by `hash_password`, compared in time that
## doesn't depend on where they differ. A stored hash that isn't one fails with `PasswordError`
## before anything's hashed, and so does one whose settings are below OWASP's floor, 19 MiB with
## two passes or 46 MiB with one, or past what's worth checking, 256 MiB, 8 passes or 4 lanes: a
## hash made with settings that high elsewhere is refused, so a stored hash can't be used to take
## all the memory or time there is. For a name nobody has, check against a hash made up for it,
## so a missing name takes as long to refuse as a wrong password. In a task it's worked out as
## `hash_password` is.
export def check_password(password: Secret[str], stored: str) -> bool fails PasswordError:
    problem = crypto._password_problem(stored)
    if problem != "": fail PasswordError(reason=problem)
    return crypto._check_password(password.expose_secret(), stored)
