---
// Fennec's mark: Scout's head, drawn on a 100-unit grid. The source of truth is
// public/brand/fennec-mark.svg; this inlines the same paths so the page needs no extra request.
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: cls } = Astro.props;
const ear = 'M25 60 C13 45 5 23 6 6 Q6.3 1.5 10.4 3.2 C26 9.5 42 25 49 46 Z';
const earIn = 'M28.5 50.5 C21 40 15.8 27 14.6 14.6 C24.6 20.4 34.6 30 40.4 41.4 Z';
const mirror = 'matrix(-1 0 0 1 100 0)';
---

<svg class={cls} width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
  <g transform="translate(0 6)">
    <path fill="#f28c28" d={ear} /><path fill="#fce3c4" d={earIn} />
    <g class="ear-r"><path fill="#f28c28" transform={mirror} d={ear} /><path fill="#fce3c4" transform={mirror} d={earIn} /></g>
    <path fill="#f28c28" d="M50 41 C61 41 70 47 73.5 56 L83 63.5 L73.8 67.2 C70.4 79 61 87.5 50 87.5 C39 87.5 29.6 79 26.2 67.2 L17 63.5 L26.5 56 C30 47 39 41 50 41 Z" />
    <path fill="#fce3c4" d="M28.8 68.6 C35.4 64.8 43.4 65.6 50 69.6 C56.6 65.6 64.6 64.8 71.2 68.6 C68.4 80.2 60 86.2 50 86.2 C40 86.2 31.6 80.2 28.8 68.6 Z" />
    <g class="eyes">
      <g fill="#1d1a36"><circle cx="40.6" cy="60" r="5.6" /><circle cx="59.4" cy="60" r="5.6" /></g>
      <g fill="#fff"><circle cx="42.6" cy="58" r="1.7" /><circle cx="61.4" cy="58" r="1.7" /></g>
    </g>
    <path fill="#1d1a36" d="M46.4 68.6 Q50 67 53.6 68.6 Q52.7 72.2 50 73.2 Q47.3 72.2 46.4 68.6 Z" />
    <path fill="none" stroke="#1d1a36" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M50 73.2 L50 75 M45.8 74.8 Q47.9 77.4 50 75 Q52.1 77.4 54.2 74.8" />
  </g>
</svg>
