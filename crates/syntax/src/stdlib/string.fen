# `std.string`: wrapping and indenting text, as Python's `textwrap` does. Most of what's done
# to text is a method of `str`.

## `text`'s words in lines of at most `width` characters, as many on each line as fit. Words
## are what's between spaces, tabs and line breaks, and a word longer than `width` is broken
## across lines. Text with no words gives no lines.
export def wrap(text: str, width: int) -> list[str]:
    mut lines = list[str]()
    mut line = ""
    for word in text.split():
        mut rest = word
        while rest.len() > width and width > 0:
            if line != "":
                lines.append(line)
                line = ""
            lines.append(rest[:width])
            rest = rest[width:]
        if rest == "": continue
        if line == "":
            line = rest
        elif line.len() + 1 + rest.len() <= width:
            line = line + " " + rest
        else:
            lines.append(line)
            line = rest
    if line != "":
        lines.append(line)
    lines

## `text` wrapped to `width`, as `wrap` does it, with its lines joined by line breaks.
export def fill(text: str, width: int) -> str:
    "\n".join(wrap(text, width=width))

## `text` with the spaces and tabs every line starts with taken off, so text indented to sit
## inside code can be written flush. Lines of only spaces and tabs don't count, and come out
## empty.
export def dedent(text: str) -> str:
    lines = text.split("\n")
    mut common: str? = None
    for line in lines:
        if line.strip() == "": continue
        lead = line[:line.len() - line.lstrip().len()]
        match common:
            case None:
                common = lead
            case shared:
                mut size = 0
                while size < lead.len() and size < shared.len() and lead[size] == shared[size]:
                    size += 1
                common = shared[:size]
    cut = (common else "").len()
    "\n".join(["" if line.strip() == "" else line[cut:] for line in lines])

## `text` with `prefix` before each line that isn't empty or only spaces and tabs.
export def indent(text: str, prefix: str) -> str:
    "\n".join([line if line.strip() == "" else prefix + line for line in text.split("\n")])
