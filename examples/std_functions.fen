# Standard library functions can be written in Fennec. Each belongs to its module, so a program
# can use the same name for something else.
from std.math import lerp as blend

def lerp(text: str) -> str:
    text + " is mine"

def main(stdout: Stdout):
    stdout.print(blend(0.0, 10.0, 0.5))
    stdout.print(blend(0.0, 4.0, 0.25))
    stdout.print(lerp("this lerp"))
    stdout.print(max([1.0, 3.0], key=n => blend(0.0, n, -1.0)))

test "a std function written in Fennec works in a test":
    assert blend(0.0, 2.0, 0.5) == 1.0
    assert blend(1.0, 3.0, 0.5) == 2.0
