# `float.parse(text)` of a price like "1234.56", done OPS times on inputs that vary.
# `fennec-bench ops` counts its instructions per operation beside its Rust twin's.

OPS = 20_000

def main(stdout: Stdout, args: Args):
    # No arguments are given, so this is 0, but the compiler can't know it.
    shift = len(args)
    texts = [f"{i * 37}.{i + 10}" for i in range(shift, shift + 16)]
    mut total = 0.0
    for at in range(OPS):
        number = float.parse(texts[(at + shift) % 16]) except InvalidValue(): -1.0
        total += number
    stdout.print(total)
    return
