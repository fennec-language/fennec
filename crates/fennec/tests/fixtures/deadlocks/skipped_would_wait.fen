# A waiting call of many ranges. The first fails once another range has said it started, and every
# other range says so, then waits to receive on a channel nobody sends to. The ranges the failure
# kept from starting never run, so which ranges are left waiting is the run's own, and at least one
# always is: a first range that failed after only working a while sometimes failed before any other
# had started, under load, and the call ended.
from std.concurrent import Channel, Closed, channel

error Boom:
    at: int

def part(at: int, started: Channel[int], pipe: Channel[int]) -> int fails Boom:
    if at == 0:
        _ = started.receive()
        fail Boom(at=at)
    started.send(at) except Closed():
        return -1
    got = pipe.receive() else -1
    return got

def all_parts(started: Channel[int], pipe: Channel[int]) -> int fails Boom:
    got = [part(at, started=started, pipe=pipe)? for at in parallel(range(64))]
    return sum(got)

def main(stdout: Stdout):
    with channel[int](size=64) as started:
        with channel[int](size=1) as pipe:
            total = all_parts(started, pipe=pipe) except why:
                stdout.print("the call failed:", why)
                return
            stdout.print(total)
