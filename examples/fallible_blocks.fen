## Fallible functions that give back strings, lists and structs, used every way a result can be.

error TooBig:
    limit: int

error Wrapped:
    why: str

struct Node:
    value: int
    next: Node?
    names: list[str]

def word(n: int) -> str fails TooBig:
    if n > 2: fail TooBig(limit=2)
    f"w{n}"

def words(n: int) -> list[str] fails TooBig:
    spelled = [word(i)? for i in range(n)]
    spelled

def node(n: int) -> Node fails TooBig:
    if n > 3: fail TooBig(limit=3)
    if n == 0: return Node(value=0, next=None, names=[])
    inner = node(n - 1)?
    Node(value=n, next=inner, names=words(n)?)

def wrapped(n: int) -> str fails Wrapped:
    text = word(n)? from Wrapped(why="word failed")
    text + "!"

struct Maker:
    made = 0

    def make(ref self, n: int) -> str fails TooBig:
        self.made += 1
        if n > 2: fail TooBig(limit=n)
        word(n)?

    def twice(ref self, n: int) -> list[str] fails TooBig:
        [self.make(n)?, self.make(n + 1)?]

## "ok" and what a call gave, or "err" and what it failed with.
def shown[E](run: () -> str fails E) -> str:
    found = run() else as why:
        return f"err {why}"
    f"ok {found}"

def main(stdout: Stdout):
    stdout.print(word(1) else "none", word(9) else "none")
    stdout.print(words(2) else [], words(9) else ["failed"])
    stdout.print(
        (node(2) else Node(value=-1, next=None, names=[])).value,
        (node(9) else Node(value=-1, next=None, names=[])).value,
    )
    stdout.print(wrapped(1) else "failed", wrapped(9) else "failed")

    stdout.print(shown(() => word(1)?))
    stdout.print(shown(() => word(5)?))
    stdout.print(shown(() => wrapped(5)?))

    stdout.print(words(1) else [])
    stdout.print(failure_of(() => words(9)?))

    mut maker = Maker()
    for n in [1, 2, 5]:
        made = maker.twice(n) else as why:
            stdout.print(why, maker.made)
            continue
        stdout.print(made, maker.made)
