struct Pool:
    items: list[int]

    def len(self) -> int:
        return len(self.items)

    def is_live(self, i: int) -> int:
        return i

    def [](ref self, i: int) -> int:
        return self.items[i]

def main(stdout: Stdout):
    mut pool = Pool(items=[1])
    for ref item in pool:
        item += 1
    stdout.print(len(pool))
