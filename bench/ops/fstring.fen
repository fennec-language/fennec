# `f"user-{at}"`, an f-string with one int, done OPS times on inputs that vary.
# `fennec-bench ops` counts its instructions per operation beside its Rust twin's.

OPS = 20_000

def main(stdout: Stdout, args: Args):
    # No arguments are given, so this is 0, but the compiler can't know it.
    shift = len(args)
    mut total = 0
    for at in range(OPS):
        text = f"user-{at + shift}"
        total += len(text)
    stdout.print(total)
    return
