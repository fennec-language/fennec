# Nothing after `lend` can fail: the caller's block has succeeded by then, so the failure would
# have nowhere to go. Finishing that can fail is a method the caller calls, like `tx.commit()?`.
error SaveError:
    why: str

def flush() -> int fails SaveError:
    1

def saving() -> with int fails SaveError:
    lend 1
    flush()?

def main(stdout: Stdout):
    with saving()? as n:
        stdout.print(n)
