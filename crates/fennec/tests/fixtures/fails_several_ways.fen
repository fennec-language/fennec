# Errors with cases and plain ones together after `fails`, each picked out by a case or by its
# type in a match, widened as `?` passes them up, through a function value, and failing `main`.

error ParseError:
    NotANumber(text: str)
    Empty

error RangeError:
    TooBig(value: int, limit: int)

error Missing:
    key: str

def parse(text: str) -> int fails ParseError:
    if text == "": fail .Empty
    return int(text) except InvalidValue(): fail .NotANumber(text)

def in_range(value: int, limit: int) -> int fails RangeError:
    if value > limit: fail .TooBig(value, limit)
    return value

def level(text: str) -> int fails ParseError | RangeError:
    return in_range(parse(text)?, limit=9)?

def lookup(table: dict[str, str], key: str) -> int fails Missing | ParseError | RangeError:
    found = table.get(key) else fail Missing(key=key)
    return level(found)?

def said(table: dict[str, str], key: str) -> str:
    value = lookup(table, key) except why:
        case Missing(key):
            return f"no {key}"
        case .NotANumber(text):
            return f"bad {text}"
        case .Empty:
            return "empty"
        case .TooBig(value, limit):
            return f"{value}>{limit}"
    return f"ok {value}"

## A level, or -1 for text that isn't one.
def level_or_minus_one(text: str) -> int:
    found = level(text) except .NotANumber() | .Empty | .TooBig(): -1
    return found

def through(
    read: (str) -> int fails ParseError | RangeError,
    text: str,
) -> int fails ParseError | RangeError:
    return read(text)?

def main(stdout: Stdout):
    table = {"a": "3", "b": "x", "c": "", "d": "12"}
    for key in ["a", "b", "c", "d", "e"]:
        stdout.print(said(table, key))
    results = [level_or_minus_one(text) for text in ["1", "q", "99"]]
    kept = [level_or_minus_one(text) for text in ["5", "", "50"]]
    stdout.print(len(results), len(kept), [level_or_minus_one(t) for t in ["8", "z", "10"]])
    through_value = through(level, "6") except .NotANumber() | .Empty | .TooBig(): 0
    through_value2 = through(level, "") except .NotANumber() | .Empty | .TooBig(): 0
    through_value3 = through(text => level(text)?, "77") except .NotANumber() | .Empty | .TooBig(
    ): 0
    stdout.print(through_value, through_value2, through_value3)
    stdout.print(lookup(table, "d")?)
