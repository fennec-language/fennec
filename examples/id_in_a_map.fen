# `id in map`: whether an `Id` still names something. An `Id` from a slot that's been used again doesn't, nor does one from another `Table`.
from std.collections import Table

struct Unit:
    health = 1

def main(stdout: Stdout):
    mut units = Table[Unit]()
    first = units.add(Unit())
    second = units.add(Unit(health=2))
    stdout.print(first in units, second not in units)
    gone = units.remove(first)
    stdout.print(first in units, second in units, first not in units, gone is None)
    third = units.add(Unit(health=3))
    stdout.print(first in units, third in units)
    mut others = Table[Unit]()
    stranger = others.add(Unit(health=4))
    stdout.print(stranger in units, units.get(stranger) is None, stranger in others)
