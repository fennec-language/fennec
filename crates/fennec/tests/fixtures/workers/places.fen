struct Inner:
    tags: list[int]

    def grow(ref self, value: int):
        self.tags.append(value)

struct Unit:
    hp: int
    tags: list[int]
    inner: Inner

    def grow(ref self, value: int):
        self.tags.append(value)
        self.hp += value

def unit(hp: int) -> Unit:
    return Unit(hp, [hp], Inner([hp]))

def changed(captured: list[Unit], at: int) -> int:
    mut copy = captured
    copy[at % 2].grow(at)
    copy[at % 2].inner.grow(at)
    return len(copy[at % 2].tags) + len(copy[at % 2].inner.tags) + copy[at % 2].hp

def main(stdout: Stdout):
    captured = [unit(1), unit(2)]
    xs = [n for n in range(2000)]
    total = sum(changed(captured, x) for x in parallel(xs))
    stdout.print(total)
    for one in captured:
        stdout.print(one.hp, one.tags, one.inner.tags)
