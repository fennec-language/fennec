## `std.concurrent`: channels between tasks, and the ends of one that `with launch(...)` hands out.
##
## ```fennec
## from std.concurrent import channel
##
## with channel[str](size=64) as jobs:
##     jobs.send("first")?
##     job = jobs.receive()?
## ```
##
## A channel holds at most its `size` messages, so `send` waits while it's full, and `receive`
## waits while it's empty. Both take `timeout=`. A channel closes when its `with` block ends,
## and anything still waiting on it then wakes as `Closed`.
from std.intrinsics import channel_close, channel_free, channel_listen, channel_new, channel_new_every, channel_receive, channel_send
from std.time import Duration

## A `send` on a channel that's closed, or a `receive` on one that's closed and empty.
export error Closed:
    pass

## A `send` or `receive` that waited its `timeout=` and got nowhere.
export error Timeout:
    waited: Duration

## A launched task that crashed, as its `with launch` block gives back where it ends.
export error Crashed:
    why: str

## A channel holding up to `size` messages of type `T`, lent for a `with` block, and closed when it
## ends: `with channel[Job](size=64) as jobs:`. It's the only way to make a `Channel`.
export def channel[T](size: int, to: Delivery? = None) -> with Channel[T]:
    mut number = 0
    delivery: Delivery = to else .One
    match delivery:
        case .One:
            number = channel_new(size)
        case .Every:
            number = channel_new_every(size)
    made = Channel[T](_channel=number)
    lend made else:
        channel_close(made._channel)
        channel_free(made._channel)
    channel_close(made._channel)
    channel_free(made._channel)

## Who a channel's messages go to: each to `.One` receiver, as a work queue, or every message to
## `.Every` listener.
export enum Delivery:
    One
    Every

## What a listener of a channel to `.Every` does when it falls behind, and its next message has
## gone: `.Fail` loudly, or with `.DropOldest`, go on from the oldest message kept.
export enum Behind:
    Fail
    DropOldest

## A channel for messages of type `T`, which every task inside its `with` block can send on and
## receive from. Hand one end to a task with `sender()` or `inbox()`.
export struct Channel[T]:
    _channel: int

    ## Sends `message`, waiting while the channel is full, for at most `timeout` when it's given.
    def send(self, message: T, timeout: Duration? = None) fails Closed | Timeout:
        sent(channel_send[T](self._channel, message, nanos_of(timeout)), timeout)?

    ## The next message, waiting while the channel is empty, for at most `timeout` when it's
    ## given.
    def receive(self, timeout: Duration? = None) -> T fails Closed | Timeout:
        received[T](self._channel, timeout)?

    ## Each message until the channel is closed and empty, as `for message in channel`. On a
    ## channel to `.Every`, each loop is a listener of its own, from the next message sent.
    def iter(self) -> Iterator[T]:
        listener = channel_listen(self._channel, False)
        while True:
            message = received[T](listener, None) else return
            yield message

    ## As `iter`, saying what to do when this listener of a channel to `.Every` falls behind.
    def listen(self, when_behind: Behind? = None) -> Iterator[T]:
        behind: Behind = when_behind else .Fail
        listener = channel_listen(self._channel, behind == .DropOldest)
        while True:
            message = received[T](listener, None) else return
            yield message

    ## The sending end, to hand to a task.
    def sender(self) -> Sender[T]:
        Sender[T](_channel=self._channel)

    ## The receiving end, to hand to a task.
    def inbox(self) -> Inbox[T]:
        Inbox[T](_channel=self._channel)

## The receiving end of a channel: a task's inbox, as `with launch` makes it.
export struct Inbox[T]:
    _channel: int

    ## The next message, waiting while there's none, for at most `timeout` when it's given.
    def receive(self, timeout: Duration? = None) -> T fails Closed | Timeout:
        received[T](self._channel, timeout)?

    ## Each message until the channel is closed and empty, as `for message in inbox`.
    def iter(self) -> Iterator[T]:
        while True:
            message = received[T](self._channel, None) else return
            yield message

## The sending end of a channel, as `with launch(...) as sender:` gives it.
export struct Sender[T]:
    _channel: int

    ## Sends `message`, waiting while the channel is full, for at most `timeout` when it's given.
    def send(self, message: T, timeout: Duration? = None) fails Closed | Timeout:
        sent(channel_send[T](self._channel, message, nanos_of(timeout)), timeout)?

## How long to wait, in nanoseconds, as the runtime takes it: -1 for as long as it takes. A
## negative `timeout` has already run out, so it doesn't wait at all.
def nanos_of(timeout: Duration?) -> int:
    if timeout is None: return -1
    max(timeout.nanos, 0)

## What a send's answer means: 0 sent, 1 closed, 2 timed out.
def sent(answer: int, timeout: Duration?) fails Closed | Timeout:
    if answer == 1: fail Closed()
    if answer == 2: fail Timeout(waited=timeout else Duration())

## The next message on channel `channel`, or why there isn't one.
def received[T](channel: int, timeout: Duration?) -> T fails Closed | Timeout:
    mut why = 0
    got = channel_receive[T](channel, nanos_of(timeout), ref why)
    if why == 2: fail Timeout(waited=timeout else Duration())
    got else fail Closed()

## A value a pool keeps: one it can put back as it was after a block that failed with it, and
## close.
export interface Pooled:
    ## Puts the value back as it was before a block that failed or crashed with it, or says it
    ## can't, and the pool opens another in its place.
    def reset(self) -> bool

    ## Closes it, when the pool ends or replaces it.
    def close(self)

## A failure that can say what went wrong, as every error in `std` can.
export interface Explained:
    def message(self) -> str

## Why a pool couldn't lend a value.
export error PoolError:
    ## None came free within the pool's `wait`.
    Timeout(waited: Duration)
    ## Opening one failed, saying why.
    Open(reason: str)
    ## The pool has ended.
    Closed

    def message(self) -> str:
        match self:
            case .Timeout(waited):
                f"no value came free in {waited.as_seconds()}s"
            case .Open(reason):
                reason
            case .Closed:
                "the pool has ended"

## A pool of up to `size` values, each kept by a task of its own and lent to one `with` block at a
## time by `take()`: `with pool[Db](size=10, open=() => connected(net))? as dbs:`. One value is
## opened now, so a pool that can't open any fails here, and the rest when they're first needed.
## Given `first`, an open value, the pool starts with it rather than opening one. A borrower
## waits up to `wait` for one to come free, first come first served. A block that
## fails or crashes hands its value back to be `reset()`, and one that can't be reset is closed
## and opened again when it's next needed, so the pool never shrinks.
export def pool[T: Pooled, E: Explained](
    open: () -> T fails E,
    size = 10,
    wait = 30s,
    first: T? = None,
) -> with Pool[T] fails PoolError | Crashed:
    if size < 1: fail PoolError.Open(reason=f"a pool needs at least one value, not {size}")
    mut started = first
    if started is None:
        started = opened(open)?
    begun = started else fail PoolError.Closed
    with channel[PoolNote[T]](size=size * 4 + 16) as notes:
        inbox = notes.inbox()
        sender = notes.sender()
        with launch(() => run_pool(0, inbox, sender, size, open, begun))?:
            made = Pool[T](_notes=sender, _wait=wait)
            lend made else:
                told(sender, PoolNote[T](kind=STOP))
            told(sender, PoolNote[T](kind=STOP))

## Lends one value at a time from the pool, by `take()`.
export struct Pool[T]:
    _notes: Sender[PoolNote[T]]
    _wait: Duration

    ## A value from the pool for a `with` block, waiting up to the pool's `wait` for one to come
    ## free. It goes back when the block ends; after a block that failed or crashed, it's reset
    ## first, or replaced.
    def take(self) -> with T fails PoolError:
        borrowed = self.borrowed()?
        lend borrowed.value else:
            borrowed.give_back(False)
        borrowed.give_back(True)

    ## A value from the pool, waiting as `take()` does, for a library's own `with` source to lend
    ## and then `give_back`, as `take()` does. Prefer `take()`.
    def borrowed(self) -> Borrowed[T] fails PoolError:
        with channel[Lent[T]](size=1) as reply:
            self._notes.send(PoolNote[T](kind=WANT, reply=reply.sender())) else fail .Closed
            lent = reply.receive(timeout=self._wait) else fail .Timeout(waited=self._wait)
            if lent.failure != "": fail .Open(reason=lent.failure)
            value = lent.value else fail .Closed
            back = lent.back else fail .Closed
            return Borrowed[T](value=value, _back=back)
        fail .Closed

## A value `Pool.borrowed()` gave, until it's given back.
export struct Borrowed[T]:
    value: T
    _back: Sender[Given[T]]

    ## Hands the value back to its keeper, saying whether the block that had it succeeded: one
    ## that didn't has it reset, or replaced.
    def give_back(self, succeeded: bool):
        told(self._back, Given[T](value=self.value, succeeded=succeeded))

## What a borrower is lent: the value and where to give it back, or why it couldn't be opened.
struct Lent[T]:
    value: T?
    back: Sender[Given[T]]?
    failure: str

## A value given back to its keeper, and whether the block that had it succeeded.
struct Given[T]:
    value: T
    succeeded: bool

## What a keeper is told: lend your value to `reply`, or stop when there's none.
struct KeeperOrder[T]:
    reply: Sender[Lent[T]]?

## What the pool's dispatcher hears, of the kinds below.
struct PoolNote[T]:
    kind: int
    keeper = 0
    reply: Sender[Lent[T]]? = None
    orders: Sender[KeeperOrder[T]]? = None

## A borrower wants a value.
WANT = 0
## A keeper has started, and here's where to send it orders.
HELLO = 1
## A keeper's value is open and free.
FREE = 2
## A keeper is free, with no value open.
EMPTY = 3
## The pool has ended.
STOP = 4

## What `open` gives, or its failure as a `PoolError`.
def opened[T, E: Explained](open: () -> T fails E) -> T fails PoolError:
    value = open() else as failure:
        fail PoolError.Open(reason=failure.message())
    value

## Sends `message` if `to` still takes it: the other side may have gone, which is fine.
def told[T](to: Sender[T], message: T):
    to.send(message) else return

## Whether `to` took `message`: the other side may have gone.
def delivered[T](to: Sender[T], message: T) -> bool:
    to.send(message) else return False
    True

## The pool's tasks: a keeper for each value, each launched inside the last so they all run at
## once, then the dispatcher that hands them out. Each `with launch` ends once its keeper has
## stopped, which it's told to when the pool ends.
def run_pool[T: Pooled, E: Explained](
    number: int,
    notes: Inbox[PoolNote[T]],
    sends: Sender[PoolNote[T]],
    size: int,
    open: () -> T fails E,
    first: T,
) fails Crashed:
    if number == size:
        dispatch[T](notes, size)
        return
    with launch(() => keep[T, E](number, sends, open, first))?:
        run_pool[T, E](number + 1, notes, sends, size, open, first)?

## Hands each borrower a keeper, first come first served: one whose value is open if there's one,
## or else one that'll open its value, or else the next that comes free.
def dispatch[T](notes: Inbox[PoolNote[T]], size: int):
    mut keepers: dict[int, Sender[KeeperOrder[T]]] = {}
    mut open_free: list[int] = []
    mut empty_free: list[int] = []
    mut waiting: list[Sender[Lent[T]]] = []
    mut stopping = False
    for note in notes:
        if note.kind == STOP:
            stopping = True
        elif note.kind == WANT:
            reply = note.reply else continue
            if open_free.len() > 0:
                told(keepers[open_free.pop(0)], KeeperOrder[T](reply=reply))
            elif empty_free.len() > 0:
                told(keepers[empty_free.pop(0)], KeeperOrder[T](reply=reply))
            else:
                waiting.append(reply)
        else:
            keeper = note.keeper
            if note.kind == HELLO:
                keepers[keeper] = note.orders else continue
            if waiting.len() > 0 and not stopping:
                told(keepers[keeper], KeeperOrder[T](reply=waiting.pop(0)))
            elif note.kind == EMPTY or (note.kind == HELLO and keeper != 0):
                empty_free.append(keeper)
            else:
                open_free.append(keeper)
        # Every keeper has to have started to be told to stop.
        if stopping and keepers.len() == size:
            for _, orders in keepers.items():
                told(orders, KeeperOrder[T](reply=None))
            return

## Keeper `number`: keeps one value, opening it when it's first needed, and lends it to each
## borrower it's sent in turn. The first keeper starts with the value the pool opened.
def keep[T: Pooled, E: Explained](
    number: int,
    notes: Sender[PoolNote[T]],
    open: () -> T fails E,
    first: T,
):
    mut held: T? = None
    if number == 0:
        held = first
    with channel[KeeperOrder[T]](size=1) as orders, channel[Given[T]](size=1) as given:
        told(notes, PoolNote[T](kind=HELLO, keeper=number, orders=orders.sender()))
        for order in orders:
            reply = order.reply else break
            if held is None:
                held = open() else as failure:
                    told(reply, Lent[T](value=None, back=None, failure=failure.message()))
                    told(notes, PoolNote[T](kind=EMPTY, keeper=number))
                    continue
            value = held else continue
            # A borrower that stopped waiting takes nothing, so the value goes to the next.
            if delivered(reply, Lent[T](value=value, back=given.sender(), failure="")):
                back = given.receive() else Given[T](value=value, succeeded=False)
                if back.succeeded or back.value.reset():
                    held = back.value
                else:
                    back.value.close()
                    held = None
            told(notes, PoolNote[T](kind=FREE if held is not None else EMPTY, keeper=number))
    if held is not None:
        held.close()
