from std.json import quoted
from std.string import escaped

## How much a log entry matters, least first.
##
## ```fennec
## from std.log import Log, LogLevel
## log = Log(out=stdout, level=.Warn)
## log.info("not written")
## log.warn("disk almost full")
## ```
## ```output
## WARN disk almost full
## ```
export enum LogLevel:
    Debug
    Info
    Warn
    Error

    ## How much it matters, from 0 for `Debug` to 3 for `Error`.
    ## ```fennec
    ## from std.log import LogLevel
    ## assert LogLevel.Debug.rank() < LogLevel.Error.rank()
    ## ```
    def rank(self) -> int:
        match self:
            case .Debug:
                return 0
            case .Info:
                return 1
            case .Warn:
                return 2
            case .Error:
                return 3

    ## How an entry of this level starts, like `WARN`.
    ## ```fennec
    ## from std.log import LogLevel
    ## assert LogLevel.Warn.label() == "WARN"
    ## ```
    def label(self) -> str:
        match self:
            case .Debug:
                return "DEBUG"
            case .Info:
                return "INFO"
            case .Warn:
                return "WARN"
            case .Error:
                return "ERROR"

## How each entry is written.
##
## ```fennec
## from std.log import Log, LogFormat
## Log(out=stdout, format=.Json).info("saved", fields={"file": "a.txt"})
## ```
## ```output
## {"level": "INFO", "message": "saved", "file": "a.txt"}
## ```
export enum LogFormat:
    ## `INFO saved file=a.txt`, for people.
    Text
    ## `{"level": "INFO", "message": "saved", "file": "a.txt"}`, one object a line, for tools
    ## that collect logs.
    Json

## Where a program's log entries go, and which ones it wants. There's nothing global: a
## function that logs takes a `Log`, so its signature says so, and a kit logs however the
## program that uses it chose. Each entry is one line, like `INFO saved file=a.txt size=12`.
## Give it a `Clock` and each line starts with the seconds since the clock started.
## `format=.Json` writes each entry as a JSON object instead.
##
## ```fennec
## from std.log import Log
## log = Log(out=stdout)
## log.info("saved", fields={"file": "a.txt", "size": "12"})
## ```
## ```output
## INFO saved file=a.txt size=12
## ```
export struct Log:
    out: Stdout
    level = LogLevel.Info
    format = LogFormat.Text
    clock: Clock? = None
    fields = dict[str, str]()

    ## An entry that matters least, written only when the log's `level` is `Debug`.
    ## ```fennec
    ## from std.log import Log, LogLevel
    ## Log(out=stdout, level=.Debug).debug("cache warm")
    ## ```
    ## ```output
    ## DEBUG cache warm
    ## ```
    def debug(self, message: str, fields: dict[str, str]? = None):
        self.write(.Debug, message, fields)

    ## An entry saying what happened.
    ## ```fennec
    ## from std.log import Log
    ## Log(out=stdout).info("started")
    ## ```
    ## ```output
    ## INFO started
    ## ```
    def info(self, message: str, fields: dict[str, str]? = None):
        self.write(.Info, message, fields)

    ## An entry about something that may need looking at.
    ## ```fennec
    ## from std.log import Log
    ## Log(out=stdout).warn("slow request", fields={"ms": "900"})
    ## ```
    ## ```output
    ## WARN slow request ms=900
    ## ```
    def warn(self, message: str, fields: dict[str, str]? = None):
        self.write(.Warn, message, fields)

    ## An entry about something that went wrong.
    ## ```fennec
    ## from std.log import Log
    ## Log(out=stdout).error("couldn't save")
    ## ```
    ## ```output
    ## ERROR couldn't save
    ## ```
    def error(self, message: str, fields: dict[str, str]? = None):
        self.write(.Error, message, fields)

    ## Whether an entry of this level would be written, for when making one takes work.
    ##
    ## ```fennec
    ## from std.log import Log, LogLevel
    ## log = Log(out=stdout)
    ## assert log.enabled(.Error) and not log.enabled(.Debug)
    ## ```
    def enabled(self, level: LogLevel) -> bool:
        return level.rank() >= self.level.rank()

    ## A log that adds these fields to every entry, like the request it's handling. Its own
    ## value replaces this log's for a field they both have.
    ##
    ## ```fennec
    ## from std.log import Log
    ## request_log = Log(out=stdout).with_fields({"request": "7"})
    ## request_log.info("answered")
    ## ```
    ## ```output
    ## INFO answered request=7
    ## ```
    def with_fields(self, fields: dict[str, str]) -> Log:
        mut all_fields = {name: value for name, value in self.fields.items()}
        all_fields.update(fields)
        return copy(self, fields=all_fields)

    ## An entry of `level`, which `debug`, `info`, `warn` and `error` write.
    ## ```fennec
    ## from std.log import Log, LogLevel
    ## Log(out=stdout).write(.Info, "saved", None)
    ## ```
    ## ```output
    ## INFO saved
    ## ```
    def write(self, level: LogLevel, message: str, fields: dict[str, str]?):
        if not self.enabled(level): return
        mut all_fields = {name: value for name, value in self.fields.items()}
        if fields is not None:
            all_fields.update(fields)
        mut seconds = ""
        if self.clock is not None:
            seconds = f"{float(self.clock.now().nanos) / 1_000_000_000.0:.3f}"
        line = match self.format:
            case .Text:
                Log._text(level, message, all_fields, seconds)
            case .Json:
                Log._json(level, message, all_fields, seconds)
        self.out.print(line)

    def _text(level: LogLevel, message: str, fields: dict[str, str], seconds: str) -> str:
        mut parts = [level.label(), Log._one_line(message)]
        if seconds != "":
            parts = [seconds] + parts
        for name, value in fields.items():
            parts.append(f"{Log._one_line(name)}={Log._value(value)}")
        return " ".join(parts)

    ## One JSON object. The time is a number of seconds, and a field can't replace `time`,
    ## `level` or `message`.
    def _json(level: LogLevel, message: str, fields: dict[str, str], seconds: str) -> str:
        mut parts = []
        if seconds != "":
            parts.append(f"\"time\": {seconds}")
        parts.append(f"\"level\": {quoted(level.label())}")
        parts.append(f"\"message\": {quoted(message)}")
        for name, value in fields.items():
            if name != "time" and name != "level" and name != "message":
                parts.append(f"{quoted(name)}: {quoted(value)}")
        return "{" + ", ".join(parts) + "}"

    ## Text that can't start another line, so an entry can't pretend to be two, or send a terminal
    ## its codes: a backslash doubled, then each control character written as an escape, as `\n`
    ## or `\u{1b}`.
    def _one_line(text: str) -> str:
        return escaped(text.replace("\\", "\\\\"))

    ## A field's value, in quotes if it couldn't be told apart from what follows it.
    def _value(value: str) -> str:
        text = Log._one_line(value)
        plain = text != "" and " " not in text and "=" not in text and "\"" not in text
        if plain: return text
        return "\"" + text.replace("\"", "\\\"") + "\""
