## `std.postgres`: a Postgres database over the network, written in Fennec on `std.net`, under
## `std.sql`. Queries are templates, and each value goes to the server apart from the query's
## text, as a parameter. Rows read into any type that loads, by the columns' names.
##
## ```fennec
## with postgres.connect(net, entropy, "postgres://hoard@localhost/hoard", password=secret)? as db:
##     with db.transaction()? as tx:
##         _ = tx.execute(t"insert into entries values ({path}, {size})")?
##         rows = tx.query[Entry](t"select path, size from entries where size > {least}")?
##     with db.borrow()? as conn:
##         _ = conn.execute(t"delete from entries where path = {path}")?
## ```
##
## `connect` lends a pool of connections, 10 unless `pool_size=` says, each kept by a task of its
## own in `std.concurrent`. A connection runs one query at a time, so `transaction()` and
## `borrow()` each lend one to a block, waiting up to `wait=`, `30s` unless it's set, for one to
## come free. Its connections are TLS unless `tls=False` says otherwise.
##
## Underneath, `startup`, `password` and `terminate` give the bytes a client sends, and a `PgReader`
## is fed the bytes a server sends and gives back each whole message, with no network of their
## own, so the same code runs against a socket or against bytes a test wrote.

from std import base64, crypto
from std.concurrent import Pool, Timeout, pool
from std.crypto import Secret
from std.intrinsics import bytes_text
from std.net import Connection, NetError
from std.sql import SqlError, SqlRows, SqlValue, rows_as
from std.time import Duration
from std.url import parse, unquote

## The protocol's version, 3.0, as a startup message gives it.
PROTOCOL = 196608

## The most SCRAM rounds a server may ask for. Postgres uses 4096 unless it's told otherwise.
MOST_ROUNDS = 1_000_000

## The longest message a reader takes, so a server can't make it hold more than this.
LONGEST = 1073741824

## A message a Postgres server sends.
export enum PgMessage:
    ## The client is in.
    AuthOk
    ## The server wants the password as it is.
    AuthCleartext
    ## The server wants SASL, with one of these mechanisms, like `SCRAM-SHA-256`.
    AuthSasl(mechanisms: list[str])
    ## The server's next SASL message.
    AuthSaslContinue(data: bytes)
    ## The server's last SASL message, which proves it knows the password too.
    AuthSaslFinal(data: bytes)
    ## A way to sign in this client doesn't speak, by its number.
    AuthOther(code: int)
    ## One of the server's settings, like `server_version`.
    Setting(name: str, value: str)
    ## What cancels this connection's query from another connection.
    BackendKey(process: int, secret: int)
    ## Ready for the next query: `I` idle, `T` in a transaction, `E` in a failed one.
    Ready(status: str)
    ## A failure, by its fields' codes: `C` the SQLSTATE, `M` the message, `S` how bad.
    Failed(fields: dict[str, str])
    ## A notice, by its fields' codes, as a failure's.
    Notice(fields: dict[str, str])
    ## The columns rows will have: each one's name and its type's number.
    Columns(names: list[str], types: list[int])
    ## A row's cells, as text. A cell that's null has `False` in `present` and empty bytes.
    Row(cells: list[bytes], present: list[bool])
    ## A query finished, saying what it did, like `INSERT 0 1`.
    Done(tag: str)
    ParseComplete
    BindComplete
    NoData
    EmptyQuery
    ## Any other message, by its type byte.
    Other(kind: int)

## The startup message: the protocol's version, then who's signing in and to which database.
export def startup(user: str, database: str) -> bytes:
    mut out = PgWriter()
    out.int32(PROTOCOL)
    for name, value in [("user", user), ("database", database)]:
        out.text(name)
        out.text(value)
    out.byte(0)
    return out.done(-1)

## The password, as it is, for a server that asks for it that way.
export def password(text: str) -> bytes:
    mut out = PgWriter()
    out.text(text)
    return out.done(112)

## The first SASL message: the mechanism chosen, then its first message.
export def sasl_first(mechanism: str, data: bytes) -> bytes:
    mut out = PgWriter()
    out.text(mechanism)
    out.int32(len(data))
    out.bytes(data)
    return out.done(112)

## A later SASL message.
export def sasl_next(data: bytes) -> bytes:
    mut out = PgWriter()
    out.bytes(data)
    return out.done(112)

## Says the client is done, before it closes the connection.
export def terminate() -> bytes:
    return PgWriter().done(88)

## Writes a message's body, then gives the message: its type byte, unless it's the startup
## message, which has none, then its length, then the body.
struct PgWriter:
    _body = list[int]()

    def byte(ref self, value: int):
        self._body.append(value)

    def int16(ref self, n: int):
        self._body.append((n >> 8) & 255)
        self._body.append(n & 255)

    def int32(ref self, n: int):
        for shift in [24, 16, 8, 0]:
            self._body.append((n >> shift) & 255)

    def bytes(ref self, data: bytes):
        for each in data:
            self._body.append(each)

    ## Text, then the zero byte that ends it.
    def text(ref self, text: str):
        self.bytes(text.encode())
        self._body.append(0)

    ## The message of type `kind`, or the startup message for -1.
    def done(self, kind: int) -> bytes:
        size = len(self._body) + 4
        mut head = list[int]() if kind < 0 else [kind]
        for shift in [24, 16, 8, 0]:
            head.append((size >> shift) & 255)
        return bytes(head + self._body)

## Reads a server's messages from the bytes it's sent so far: `feed` takes more, and `next` gives
## the next whole message, or `None` until there's enough for one.
export struct PgReader:
    _data = bytes([])
    _at = 0

    ## Adds bytes the server sent.
    def feed(ref self, more: bytes):
        self._data = self._data[self._at:len(self._data)] + more
        self._at = 0

    ## The next whole message, or `None` until there's enough for one. A message that isn't what a
    ## server sends fails with `SqlError.Failed`.
    def next(ref self) -> PgMessage? fails SqlError:
        if len(self._data) - self._at < 5: return None
        kind = self._data[self._at]
        size = int32_at(self._data, self._at + 1)
        if size < 4 or size > LONGEST:
            fail .Failed(reason=f"the server sent a message {size} bytes long")
        if len(self._data) - self._at < 1 + size: return None
        body = self._data[self._at + 5:self._at + 1 + size]
        self._at += 1 + size
        return message(kind, body)?

## The message of type `kind` with `body`.
def message(kind: int, body: bytes) -> PgMessage fails SqlError:
    mut part = PgBody(_data=body)
    found = known(kind, ref part)?
    # A message read as its fields says has nothing after them. An unknown one's body is skipped.
    if part._at != len(body) and part._known:
        fail SqlError.Failed(reason="the server sent a message with bytes after its fields")
    return found

## The message of type `kind`, read from `part`.
def known(kind: int, ref part: PgBody) -> PgMessage fails SqlError:
    body = part._data
    # `R`, `S`, `K`, `Z`, `E`, `N`, `T`, `D`, `C`, `1`, `2`, `n`, `I`
    if kind == 82: return authentication(ref part)?
    if kind == 83:
        name = part.text()?
        return .Setting(name=name, value=part.text()?)
    if kind == 75:
        process = part.int32()?
        return .BackendKey(process=process, secret=part.int32()?)
    if kind == 90:
        if len(body) != 1:
            fail SqlError.Failed(reason="the server sent a ready message that isn't one byte")
        part._at = 1
        return .Ready(status=bytes_text(body, 0, 1))
    if kind == 69: return .Failed(fields=part.fields()?)
    if kind == 78: return .Notice(fields=part.fields()?)
    if kind == 84: return columns(ref part)?
    if kind == 68: return row(ref part)?
    if kind == 67: return PgMessage.Done(tag=part.text()?)
    if kind == 49: return .ParseComplete
    if kind == 50: return .BindComplete
    if kind == 110: return .NoData
    if kind == 73: return .EmptyQuery
    part._known = False
    return .Other(kind=kind)

def authentication(ref part: PgBody) -> PgMessage fails SqlError:
    code = part.int32()?
    if code == 0: return .AuthOk
    if code == 3: return .AuthCleartext
    if code == 10:
        mut mechanisms = list[str]()
        while True:
            mechanism = part.text()?
            if mechanism == "": break
            mechanisms.append(mechanism)
        return .AuthSasl(mechanisms=mechanisms)
    if code == 11: return .AuthSaslContinue(data=part.rest())
    if code == 12: return .AuthSaslFinal(data=part.rest())
    part._known = False
    return .AuthOther(code=code)

def columns(ref part: PgBody) -> PgMessage fails SqlError:
    count = part.count()?
    mut names = list[str]()
    mut types = list[int]()
    for _ in range(count):
        names.append(part.text()?)
        # The table and column it's from, then its type, size, modifier and format.
        _ = part.int32()?
        _ = part.int16()?
        types.append(part.int32()?)
        _ = part.int16()?
        _ = part.int32()?
        _ = part.int16()?
    return .Columns(names=names, types=types)

def row(ref part: PgBody) -> PgMessage fails SqlError:
    count = part.count()?
    mut cells = list[bytes]()
    mut present = list[bool]()
    for _ in range(count):
        size = part.int32()?
        # -1 is null, and nothing else below zero means anything.
        if size < -1: fail SqlError.Failed(reason=f"the server sent a cell {size} bytes long")
        present.append(size >= 0)
        cells.append(part.take(size)? if size >= 0 else bytes([]))
    return .Row(cells=cells, present=present)

## The body of one message, read from its start.
struct PgBody:
    _data: bytes
    _at = 0
    ## Whether its kind is one this reads all of, so bytes left after it are wrong.
    _known = True

    def _short(self) -> SqlError:
        return SqlError.Failed(reason="the server sent a message that ends too soon")

    def int16(ref self) -> int fails SqlError:
        if len(self._data) - self._at < 2: fail self._short()
        n = (self._data[self._at] << 8) | self._data[self._at + 1]
        self._at += 2
        return n - 65536 if n >= 32768 else n

    def int32(ref self) -> int fails SqlError:
        if len(self._data) - self._at < 4: fail self._short()
        n = int32_at(self._data, self._at)
        self._at += 4
        return n

    ## How many of something follow, which can't be below zero.
    def count(ref self) -> int fails SqlError:
        n = self.int16()?
        if n < 0: fail SqlError.Failed(reason=f"the server sent a count of {n}")
        return n

    def take(ref self, size: int) -> bytes fails SqlError:
        if size < 0 or len(self._data) - self._at < size: fail self._short()
        taken = self._data[self._at:self._at + size]
        self._at += size
        return taken

    ## Text up to the zero byte that ends it.
    def text(ref self) -> str fails SqlError:
        mut end = self._at
        while end < len(self._data) and self._data[end] != 0:
            end += 1
        if end >= len(self._data): fail self._short()
        text = bytes_text(self._data, self._at, end)
        if text == "" and end > self._at:
            fail SqlError.Failed(reason="the server sent text that isn't UTF-8")
        self._at = end + 1
        return text

    ## What's left.
    def rest(ref self) -> bytes:
        taken = self._data[self._at:len(self._data)]
        self._at = len(self._data)
        return taken

    ## A failure's or a notice's fields: each a one-letter code and its text, ended by a zero byte.
    def fields(ref self) -> dict[str, str] fails SqlError:
        mut found = dict[str, str]()
        while self._at < len(self._data) and self._data[self._at] != 0:
            code = bytes_text(self._data, self._at, self._at + 1)
            self._at += 1
            found[code] = self.text()?
        # The zero byte that ends them has to be there.
        if self._at >= len(self._data): fail self._short()
        self._at += 1
        return found

## The signed int32 at `at`, high byte first.
def int32_at(data: bytes, at: int) -> int:
    n = (data[at] << 24) | (data[at + 1] << 16) | (data[at + 2] << 8) | data[at + 3]
    return n - 4294967296 if n >= 2147483648 else n

## Signing in with SCRAM-SHA-256 (RFC 5802 and 7677), with no network of its own: `first` gives
## the client's first message, `answer` reads the server's first and gives the client's proof that
## it knows the password, and `check` reads the server's last, which proves the server knows it
## too. The password never crosses the network.
export struct PgScram:
    _password: Secret[str]
    _first_bare: str
    _nonce: str
    _server_key = bytes([])
    _signed = ""

    ## Starts signing in with the password `secret`, and `nonce`, text the server never saw before,
    ## which a driver makes from 18 or more bytes of `Entropy`. Postgres takes the user from the
    ## startup message, so `user` is usually left empty.
    def started(secret: Secret[str], nonce: str, user = "") -> PgScram:
        return PgScram(_password=secret, _first_bare=f"n={user},r={nonce}", _nonce=nonce)

    ## The client's first message, with no channel binding.
    def first(self) -> bytes:
        return f"n,,{self._first_bare}".encode()

    ## The client's last message, answering the server's first: the server's nonce, which has to
    ## start with ours, and the proof.
    def answer(ref self, server_first: bytes) -> bytes fails SqlError:
        said = server_first.decode() except InvalidValue(): fail SqlError.Failed(
            reason="the server's SCRAM message isn't text",
        )
        mut nonce = ""
        mut salt = bytes([])
        mut rounds = 0
        for part in said.split(","):
            if part.startswith("r="):
                nonce = part[2:len(part)]
            if part.startswith("s="):
                salt = base64.decode(part[2:len(part)]) except InvalidValue(): fail SqlError.Failed(
                    reason="the server's SCRAM salt isn't base64",
                )
            if part.startswith("i="):
                rounds = int(part[2:len(part)]) except InvalidValue(): fail SqlError.Failed(
                    reason="the server's SCRAM rounds aren't a number",
                )
        if not nonce.startswith(self._nonce) or nonce == self._nonce:
            fail SqlError.Failed(reason="the server's SCRAM nonce doesn't extend ours")
        if len(salt) == 0 or rounds < 4096:
            fail SqlError.Failed(reason="the server's SCRAM salt or rounds are too weak")
        # Each round is work done here, so a server can't ask for hours of it.
        if rounds > MOST_ROUNDS:
            fail SqlError.Failed(
                reason=f"the server asks for {rounds} SCRAM rounds, over the limit of {MOST_ROUNDS}",
            )
        salted = salted_password(self._password.expose_secret().encode(), salt, rounds)
        client_key = mac(salted, "Client Key".encode())
        stored = unhex(crypto.sha256(client_key))
        unproved = f"c=biws,r={nonce}"
        signed = f"{self._first_bare},{said},{unproved}"
        signature = mac(stored, signed.encode())
        proof = bytes([client_key[at] ^ signature[at] for at in range(len(client_key))])
        self._server_key = mac(salted, "Server Key".encode())
        self._signed = signed
        return f"{unproved},p={base64.encode(proof)}".encode()

    ## Checks the server's last message: its signature, which only a server that knows the
    ## password could make.
    def check(self, server_final: bytes) fails SqlError:
        # Before `answer`, there's no key to check it with, and an empty one anyone can sign with.
        if self._signed == "":
            fail SqlError.Failed(reason="the server sent its SCRAM proof before the exchange")
        said = server_final.decode() except InvalidValue(): ""
        wanted = base64.encode(mac(self._server_key, self._signed.encode()))
        if not crypto.equal(said, f"v={wanted}"):
            fail SqlError.Failed(reason="the server couldn't prove it knows the password")

## PBKDF2 with HMAC-SHA-256, for one 32-byte block: RFC 5802's `Hi`.
def salted_password(key: bytes, salt: bytes, rounds: int) -> bytes:
    mut round = mac(key, salt + bytes([0, 0, 0, 1]))
    mut total = list[int]()
    for each in round:
        total.append(each)
    for _ in range(rounds - 1):
        round = mac(key, round)
        for at in range(len(total)):
            total[at] = total[at] ^ round[at]
    return bytes(total)

## HMAC-SHA-256 of `data` under `key`, as bytes.
def mac(key: bytes, data: bytes) -> bytes:
    return unhex(crypto.hmac_sha256(key, data))

## Bytes from the lowercase hex `std.crypto`'s hashes give.
def unhex(hex: str) -> bytes:
    digits = hex.encode()
    mut out = list[int]()
    for at in range(len(digits) // 2):
        out.append(nibble(digits[2 * at]) * 16 + nibble(digits[2 * at + 1]))
    return bytes(out)

def nibble(digit: int) -> int:
    # `0` to `9`, then `a` to `f`.
    return digit - 48 if digit < 97 else digit - 87

## The messages that run one query with the extended protocol: parse the template's text, with
## `$1` for each value, bind the values, describe the rows it gives, run it, then sync. Each value
## is sent apart from the text, as a parameter, so it can never change what the text means: an
## int, a float or text as text, and bytes as they are.
export def query_messages(query: Template[SqlValue]) -> bytes:
    mut text = ""
    for at, part in enumerate(query.strings):
        text += part
        if at < len(query.values):
            text += f"${at + 1}"
    mut parse = PgWriter()
    parse.text("")
    parse.text(text)
    parse.int16(len(query.values))
    for value in query.values:
        parse.int32(type_of(value))
    mut bind = PgWriter()
    bind.text("")
    bind.text("")
    bind.int16(len(query.values))
    for value in query.values:
        # 1 for bytes as they are, 0 for everything else as text.
        bind.int16(1 if value is bytes else 0)
    bind.int16(len(query.values))
    for value in query.values:
        data = written_value(value)
        bind.int32(len(data))
        bind.bytes(data)
    # Every column comes back as text.
    bind.int16(0)
    mut describe = PgWriter()
    describe.byte(80)
    describe.text("")
    mut execute = PgWriter()
    execute.text("")
    execute.int32(0)
    return (
        parse.done(80) + bind.done(66) + describe.done(68) + execute.done(69) + PgWriter().done(83)
    )

## The number of Postgres's type for a value: `int8`, `float8`, `text`, `bytea` or `bool`.
def type_of(value: SqlValue) -> int:
    # A bool is what's none of the others.
    mut found = 16
    if value is int:
        found = 20
    if value is float:
        found = 701
    if value is str:
        found = 25
    if value is bytes:
        found = 17
    return found

## A value as its parameter's bytes.
def written_value(value: SqlValue) -> bytes:
    # A bool is what's none of the others.
    mut found = ("t" if value == True else "f").encode()
    if value is int:
        found = str(value).encode()
    if value is float:
        found = float_text(value).encode()
    if value is str:
        found = value.encode()
    if value is bytes:
        found = value
    return found

## A float as Postgres reads one: its digits, or its words for what isn't a number.
def float_text(value: float) -> str:
    if value.is_nan(): return "NaN"
    if value == 1e308 * 10.0: return "Infinity"
    if value == -1e308 * 10.0: return "-Infinity"
    return str(value)

## The rows a query gave, from its columns and each row as text, ready for `sql.rows_as`. Each
## cell is read by its column's type: ints and bools as ints, floats as floats, `bytea` as bytes,
## and everything else as text.
export def rows_of(
    names: list[str],
    types: list[int],
    rows: list[PgMessage],
) -> SqlRows fails SqlError:
    mut found = SqlRows(columns=names, kinds=[], at=[], ints=[], floats=[], texts=[], blobs=[])
    for each in rows:
        match each:
            case .Row(cells=cells, present=present):
                if len(cells) != len(names):
                    fail SqlError.Failed(
                        reason=f"the server sent a row of {len(cells)} cells for {len(names)} columns",
                    )
                for at, cell in enumerate(cells):
                    add_cell(ref found, types[at] if at < len(types) else 25, cell, present[at])?
            case _:
                pass
    return found

def add_cell(ref rows: SqlRows, kind: int, cell: bytes, there: bool) fails SqlError:
    if not there:
        rows.kinds.append(0)
        rows.at.append(0)
        return
    text = cell.decode() except InvalidValue(): fail SqlError.Failed(
        reason="the server sent a cell that isn't UTF-8",
    )
    # `bool`, then `int8`, `int2` and `int4`, `float4` and `float8`, and `bytea`.
    if kind == 16:
        rows.kinds.append(1)
        rows.at.append(len(rows.ints))
        # Postgres writes a bool as `t` or `f`, and anything else isn't one.
        if text != "t" and text != "f":
            fail SqlError.Failed(reason=f"the server sent `{text}` as a bool")
        rows.ints.append(1 if text == "t" else 0)
    elif kind == 20 or kind == 21 or kind == 23:
        rows.kinds.append(1)
        rows.at.append(len(rows.ints))
        rows.ints.append(
            int(text) else fail SqlError.Failed(reason=f"the server sent `{text}` as an int"),
        )
    elif kind == 700 or kind == 701:
        rows.kinds.append(2)
        rows.at.append(len(rows.floats))
        rows.floats.append(float_of(text)?)
    elif kind == 17:
        rows.kinds.append(4)
        rows.at.append(len(rows.blobs))
        rows.blobs.append(hex_bytes(text)?)
    else:
        rows.kinds.append(3)
        rows.at.append(len(rows.texts))
        rows.texts.append(text)

def float_of(text: str) -> float fails SqlError:
    if text == "NaN": return float("nan") except InvalidValue(): 0.0
    if text == "Infinity": return 1e308 * 10.0
    if text == "-Infinity": return -1e308 * 10.0
    return float(text) except InvalidValue(): fail SqlError.Failed(
        reason=f"the server sent `{text}` as a float",
    )

## `bytea` as Postgres writes it as text: `\x`, then two hex digits a byte.
def hex_bytes(text: str) -> bytes fails SqlError:
    digits = text.encode()
    if len(digits) < 2 or digits[0] != 92 or digits[1] != 120 or len(digits) % 2 != 0:
        fail SqlError.Failed(reason="the server sent bytes that aren't in hex")
    mut out = list[int]()
    for at in range(1, len(digits) // 2):
        high = hex_digit(digits[2 * at])?
        out.append(high * 16 + hex_digit(digits[2 * at + 1])?)
    return bytes(out)

def hex_digit(digit: int) -> int fails SqlError:
    # `0` to `9`, `a` to `f` and `A` to `F`.
    if digit >= 48 and digit <= 57: return digit - 48
    if digit >= 97 and digit <= 102: return digit - 87
    if digit >= 65 and digit <= 70: return digit - 55
    fail SqlError.Failed(reason="the server sent bytes that aren't in hex")

## A failure the server sent, as the `SqlError` it is: class `23`, a broken rule, is `Constraint`,
## a serialization failure or a deadlock is `Busy`, and anything else is `Failed`, each with the
## server's own message and code.
export def failure_from_fields(fields: dict[str, str]) -> SqlError:
    code = fields.get("C") else ""
    said = fields.get("M") else "the server failed with no message"
    reason = f"{said} ({code})" if code != "" else said
    if code.startswith("23"): return SqlError.Constraint(reason=reason)
    if code == "40001" or code == "40P01": return SqlError.Busy(reason=reason)
    return SqlError.Failed(reason=reason)

## What `postgres.connect` reads from its URL, `postgres://user@host:5432/database`, and the
## arguments beside it.
export struct PgSettings:
    host: str
    port: int
    user: str
    database: str
    pool_size: int
    wait: Duration
    tls: bool

## The settings in `url`, `postgres://user@host:port/database?pool_size=20&wait=5s`, with
## `pool_size`, `wait` and `tls` given beside it. `pool_size` and `wait` may be in the URL or an
## argument, not both, and are 10 and `30s` when neither has it. `tls` is `True` unless it's
## given. The port is 5432 and the database is the user's name unless the URL says. A URL with a
## password in it, `postgres://user:password@host/database`, has to be a `Secret`, as
## `env.secret("DATABASE_URL")?` reads one: a plain `str` with one is refused, so a
## password is never in text that could be printed or logged. A failure shows the URL with its
## password as `****`.
export def settings(
    url: str | Secret[str],
    pool_size: int? = None,
    wait: Duration? = None,
    tls: bool? = None,
) -> PgSettings fails SqlError:
    written = url_text(url)
    text = written[0]
    read = parse(text) except InvalidValue(): fail SqlError.Failed(
        reason=f"the database URL `{masked(text)}` isn't one, like `postgres://user@host:5432/database`",
    )
    if read.scheme != "postgres" and read.scheme != "postgresql":
        fail SqlError.Failed(reason=f"a database URL starts `postgres://`, not `{read.scheme}://`")
    who = read.user.split(":")
    if len(who) > 1 and not written[1]:
        fail SqlError.Failed(
            reason=f"the database URL `{masked(text)}` has a password in it, so it has to be a `Secret`, as `env.secret(\"DATABASE_URL\")?` reads one, and never a plain `str`, which could be printed",
        )
    user = unquote(who[0])
    if user == "":
        fail SqlError.Failed(reason="the database URL needs a user, as in `postgres://user@host`")
    if read.host == "": fail SqlError.Failed(reason="the database URL needs a host")
    mut database = unquote(read.path[1:] if read.path.startswith("/") else read.path)
    if database == "":
        database = user
    for name in read.query.keys():
        if name != "pool_size" and name != "wait":
            fail SqlError.Failed(
                reason=f"the database URL's `{name}` isn't a setting: `pool_size` and `wait` are",
            )
    mut size = 10
    if "pool_size" in read.query:
        if pool_size is not None: fail set_twice("pool_size")
        size = int(read.query["pool_size"]) except InvalidValue(): fail SqlError.Failed(
            reason="the database URL's `pool_size` isn't a whole number",
        )
    elif pool_size is not None:
        size = pool_size
    if size < 1: fail SqlError.Failed(reason=f"a pool needs at least one connection, not {size}")
    mut waiting = 30s
    if "wait" in read.query:
        if wait is not None: fail set_twice("wait")
        waiting = duration_of(read.query["wait"])?
    elif wait is not None:
        waiting = wait
    secure = tls else True
    return PgSettings(
        host=read.host,
        port=read.port if read.port > 0 else 5432,
        user=user,
        database=database,
        pool_size=size,
        wait=waiting,
        tls=secure,
    )

## A URL's text, and whether it came as a `Secret`, which only then may hold a password.
def url_text(url: str | Secret[str]) -> (str, bool):
    if url is str: return (url, False)
    return (url.expose_secret(), True)

## The password in a URL that came as a `Secret`, or `None` when it has none.
def password_in(url: str | Secret[str]) -> Secret[str]? fails SqlError:
    written = url_text(url)
    if not written[1]: return None
    read = parse(written[0]) except InvalidValue(): return None
    who = read.user.split(":")
    if len(who) < 2: return None
    return Secret.of(unquote(":".join(who[1:])))

## A URL as a failure shows it, with any password as `****`.
def masked(text: str) -> str:
    start = text.find("://") else -3
    rest = text[start + 3:]
    mut end = len(rest)
    for mark in ["/", "?", "#"]:
        found = rest.find(mark) else end
        end = min(end, found)
    authority = rest[:end]
    at = authority.rfind("@") else return text
    colon = authority[:at].find(":") else return text
    return text[:start + 3] + authority[:colon + 1] + "****" + rest[at:]

def set_twice(name: str) -> SqlError:
    return SqlError.Failed(
        reason=f"`{name}` is set in the database URL and as an argument: set it in one",
    )

## A wait written in a URL: whole milliseconds, seconds or minutes, like `500ms`, `5s` or `2m`.
def duration_of(text: str) -> Duration fails SqlError:
    wrong = SqlError.Failed(
        reason=f"the database URL's `wait` is like `5s`, `500ms` or `2m`, not `{text}`",
    )
    if text.endswith("ms"): return Duration.millis(int(text[:-2]) else fail wrong)
    if text.endswith("s"): return Duration.millis((int(text[:-1]) else fail wrong) * 1000)
    if text.endswith("m"): return Duration.minutes(int(text[:-1]) else fail wrong)
    fail wrong

## A pool of connections to the database at `url`, lent for a `with` block: `with
## postgres.connect(net, entropy, "postgres://app@db.internal/shop", password=secret)? as db:`.
## Each connection is TLS, its certificate checked against what the system trusts and the host,
## and a server that won't take TLS is refused rather than spoken to in the clear, since that's
## what someone in the middle would answer. `tls=False` connects in the clear, for a server on this
## machine or a private network. The URL is a `str`, or a `Secret` when it holds the password, as
## as `env.secret("DATABASE_URL")?` reads one: a plain one with a password is refused,
## at compile time when it's written in the source. Otherwise the password is `password=`. It goes
## through SCRAM-SHA-256, which never puts it on the
## wire and makes the server prove it knows it too. Given a password, a server that lets the client
## in with no proof, or asks for the password as it is, is refused, since anything on the way could
## be pretending to be it. `allow_weak_sign_in=True` lets those through, for a server set up that
## way. `entropy` makes SCRAM's nonce.
##
## The pool has up to `pool_size` connections, 10 unless the URL or an argument says, and
## `pool_size=1` for one. One connects now, so a wrong URL or password fails here, and the rest
## when they're first needed. `db.transaction()` and `db.borrow()` wait up to `wait`, `30s`
## unless it's set, for a connection to come free.
export def connect(
    net: Net,
    entropy: Entropy,
    url: str | Secret[str],
    password: Secret[str]? = None,
    pool_size: int? = None,
    wait: Duration? = None,
    tls: bool? = None,
    allow_weak_sign_in = False,
) -> with PgPool fails SqlError:
    found = settings(url, pool_size=pool_size, wait=wait, tls=tls)?
    mut secret = password
    in_url = password_in(url)?
    if in_url is not None:
        if password is not None: fail set_twice("password")
        secret = in_url
    # The first connects here, so a wrong URL or password fails with what went wrong.
    first = signed_in(net, entropy, found, secret, allow_weak_sign_in)?
    with pool[PgDatabase, SqlError](
        open=() => signed_in(net, entropy, found, secret, allow_weak_sign_in)?,
        size=found.pool_size,
        wait=found.wait,
        first=first,
    ) else fail SqlError.Failed(reason="the pool's tasks crashed") as connections:
        lend PgPool(_pool=connections) except:
            pass

## One connection to the database, signed in.
def signed_in(
    net: Net,
    entropy: Entropy,
    found: PgSettings,
    password: Secret[str]?,
    weak: bool,
) -> PgDatabase fails SqlError:
    conn = net._connect(found.host, found.port, tls=False, timeout=30s) except .NotFound(
    ) | .Refused() | .TimedOut() | .Closed | .Denied() | .Tls() | .Status() | .Other(
    ): fail SqlError.Failed(reason=f"couldn't connect to {found.host}:{found.port}")
    db = PgDatabase(_conn=conn)
    db._opened(entropy, found, password, weak) except failure:
        conn.close()
        fail failure
    return db

## Connections to a database, lent one block at a time, made by `postgres.connect`.
export struct PgPool:
    _pool: Pool[PgDatabase]

    ## A transaction for a `with` block, on a connection of its own: it commits when the block
    ## ends, and rolls back if the block fails or crashes. Waits up to the pool's `wait` for a
    ## connection, then fails with `Timeout`.
    def transaction(self) -> with PgTransaction fails SqlError | Timeout:
        with self.borrow()? as db:
            with db.transaction()? as tx:
                lend tx except:
                    pass

    ## A connection of its own for a `with` block, for queries that go together without a
    ## transaction. Waits up to the pool's `wait` for one, then fails with `Timeout`.
    def borrow(self) -> with PgDatabase fails SqlError | Timeout:
        borrowed = self._pool.borrowed() except failure:
            case .Timeout(waited):
                fail Timeout(waited=waited)
            case _:
                fail SqlError.Failed(reason=failure.message())
        lend borrowed.value except:
            borrowed.give_back(False)
        borrowed.give_back(True)

## A connection to a database, lent by `postgres.connect`.
export struct PgDatabase:
    _conn: Connection

    ## Runs a query that changes something, like an `insert`, and gives how many rows it changed.
    def execute(self, query: Template[SqlValue]) -> int fails SqlError:
        return changed(self._run(query)?.tag)

    ## Runs a query and gives each row it found as a `T`, a struct's fields by the columns' names.
    def query[T: Deserializable](self, query: Template[SqlValue]) -> list[T] fails SqlError:
        found = self._run(query)?
        return rows_as[T](rows_of(found.names, types=found.types, rows=found.rows)?)?

    ## A transaction for a `with` block: it commits when the block ends, and rolls back if the
    ## block fails.
    def transaction(self) -> with PgTransaction fails SqlError:
        _ = self._run(t"begin")?
        tx = PgTransaction(_db=self)
        lend tx except:
            _ = self._run(t"rollback") except .Constraint() | .Busy() | .Column() | .Failed(
            ): PgResult()
        kept = self._run(t"commit")?
        # A transaction that had a failure in it is rolled back by the commit, with no error.
        if kept.tag != "COMMIT":
            fail SqlError.Failed(
                reason=f"the transaction wasn't kept: the server answered the commit with `{kept.tag}`, as it does when something in it failed",
            )

    ## Sends a query, and reads what comes back up to the server's saying it's ready again. A
    ## failure is kept until then, so the connection is ready for the next query.
    def _run(self, query: Template[SqlValue]) -> PgResult fails SqlError:
        send(self._conn, query_messages(query))?
        mut reader = PgReader()
        mut found = PgResult()
        mut failed = False
        mut failure = SqlError.Failed(reason="")
        while True:
            message = next_message(self._conn, ref reader)?
            match message:
                case .Columns(names=names, types=types):
                    found.names = names
                    found.types = types
                case .Row(cells=_, present=_):
                    found.rows.append(message)
                case .Done(tag=tag):
                    found.tag = tag
                case .Failed(fields=fields):
                    failed = True
                    failure = failure_from_fields(fields)
                case .Ready(status=_):
                    if failed: fail failure
                    return found
                case _:
                    pass
        return found

    ## Says who's signing in, and answers whatever the server asks until it's ready. After SCRAM
    ## the server has to have proved it knows the password, or it isn't trusted.
    def _sign_in(
        self,
        entropy: Entropy,
        user: str,
        database: str,
        secret: Secret[str]?,
        weak: bool,
    ) fails SqlError:
        send(self._conn, startup(user, database=database))?
        mut reader = PgReader()
        mut scram = PgScram.started(Secret.of(""), nonce="", user="")
        mut signing = False
        mut proved = False
        while True:
            message = next_message(self._conn, ref reader)?
            match message:
                case .AuthOk:
                    if not proved and (signing or (secret is not None and not weak)):
                        fail SqlError.Failed(
                            reason="the server let us in without proving it knows the password: `allow_weak_sign_in=True` accepts that",
                        )
                case .AuthCleartext:
                    if not weak:
                        fail SqlError.Failed(
                            reason="the server asks for the password as it is, so it wasn't sent: `allow_weak_sign_in=True` sends it",
                        )
                    held = needed(secret)?
                    send(self._conn, cleartext(held))?
                case .AuthSasl(mechanisms=mechanisms):
                    if not ("SCRAM-SHA-256" in mechanisms):
                        fail SqlError.Failed(reason="the server doesn't offer SCRAM-SHA-256")
                    nonce = base64.encode(entropy.bytes(18))
                    scram = PgScram.started(needed(secret)?, nonce=nonce, user="")
                    signing = True
                    send(self._conn, sasl_first("SCRAM-SHA-256", data=scram.first()))?
                case .AuthSaslContinue(data=data):
                    send(self._conn, sasl_next(scram.answer(data)?))?
                case .AuthSaslFinal(data=data):
                    scram.check(data)?
                    proved = True
                case .AuthOther(code=code):
                    fail SqlError.Failed(
                        reason=f"the server signs in a way this doesn't speak, number {code}: use SCRAM-SHA-256 or a password",
                    )
                case .Failed(fields=fields):
                    fail failure_from_fields(fields)
                case .Ready(status=_):
                    return
                case _:
                    pass

    ## Asks for TLS, as every Postgres version takes it: the request, then one byte, `S` for yes.
    ## Exactly one byte is read, so nothing the server sent in the clear goes on into TLS.
    def _start_tls(self, host: str) fails SqlError:
        send(self._conn, ssl_request())?
        answer = self._conn.read(1) except error:
            fail SqlError.Failed(reason=f"the connection to the server failed: {error.message()}")
        if len(answer) == 0 or answer[0] != 83:
            fail SqlError.Failed(
                reason="the server doesn't take TLS: `tls=False` connects without it",
            )
        self._conn.start_tls(host) except error:
            fail SqlError.Failed(reason=f"TLS with the server failed: {error.message()}")

    ## Tells the server this is the end.
    def _goodbye(self):
        # Closing goes ahead whether or not the server hears it.
        self._conn.write(terminate()) except .NotFound() | .Refused() | .TimedOut(
        ) | .Closed | .Denied() | .Tls() | .Status() | .Other(): return

    ## Starts TLS when the settings ask for it, and signs in.
    def _opened(
        self,
        entropy: Entropy,
        found: PgSettings,
        password: Secret[str]?,
        weak: bool,
    ) fails SqlError:
        if found.tls:
            self._start_tls(found.host)?
        self._sign_in(
            entropy,
            user=found.user,
            database=found.database,
            secret=password,
            weak=weak,
        )?

    ## After a block that failed or crashed with it, as its pool asks: rolls back anything left
    ## open, and says whether the connection is fit to use again. It is only once the server has
    ## answered a query asked for here, so whatever an interrupted query left unread is passed
    ## over first, and the server is idle, in no transaction.
    def reset(self) -> bool:
        return self._settled() except .Constraint() | .Busy() | .Column() | .Failed(): False

    def _settled(self) -> bool fails SqlError:
        send(self._conn, simple_query("rollback"))?
        send(self._conn, simple_query(f"select '{RESET_MARK}'"))?
        mut reader = PgReader()
        mut marked = False
        while True:
            # A server that doesn't answer soon isn't kept waiting for: the connection's replaced.
            message = next_message(self._conn, ref reader, wait=Duration.millis(RESET_WAIT_MS))?
            match message:
                case .Row(cells=cells, present=_):
                    if len(cells) == 1 and cells[0] == RESET_MARK.encode():
                        marked = True
                case .Ready(status=status):
                    if marked: return status == "I"
                case _:
                    pass
        return False

    ## Says goodbye to the server and closes the connection, when its pool ends or replaces it.
    def close(self):
        self._goodbye()
        self._conn.close()

## A transaction, lent by `db.transaction()`. Its queries see what it's changed so far, and the
## rest of the program sees none of it until it's kept.
export struct PgTransaction:
    _db: PgDatabase

    ## Runs a query that changes something, like an `insert`, and gives how many rows it changed.
    def execute(self, query: Template[SqlValue]) -> int fails SqlError:
        return self._db.execute(query)?

    ## Runs a query and gives each row it found as a `T`.
    def query[T: Deserializable](self, query: Template[SqlValue]) -> list[T] fails SqlError:
        return self._db.query[T](query)?

## What one query gave.
struct PgResult:
    names = list[str]()
    types = list[int]()
    rows = list[PgMessage]()
    tag = ""

## The message asking for TLS: its length, 8, then the number Postgres knows it by.
def ssl_request() -> bytes:
    return bytes([0, 0, 0, 8, 4, 210, 22, 47])

## The password a server asked for, which has to have been given.
def needed(secret: Secret[str]?) -> Secret[str] fails SqlError:
    return secret else fail SqlError.Failed(
        reason="the server asks for a password, and `connect` wasn't given one",
    )

## The message that sends a password as it is.
def cleartext(secret: Secret[str]) -> bytes:
    return password(secret.expose_secret())

## How many rows a query's tag says it changed, like the 1 in `INSERT 0 1`, or 0 if it doesn't say.
def changed(tag: str) -> int:
    words = tag.split(" ")
    return int(words[len(words) - 1]) except InvalidValue(): 0

## What a reset asks the server for, to know it has read everything up to the server's answer:
## no query a program sends gives it back.
RESET_MARK = "fennec pool reset 7c1e"

## How long a reset waits for the server's answer before giving up on the connection, in
## milliseconds.
RESET_WAIT_MS = 2000

## A query in the simple protocol: `Q`, its length, and its text ending with a zero byte.
def simple_query(text: str) -> bytes:
    mut out = PgWriter()
    out.text(text)
    return out.done(81)

def send(conn: Connection, data: bytes) fails SqlError:
    conn.write(data) except error:
        fail SqlError.Failed(reason=f"the connection to the server failed: {error.message()}")

## What the server's sent next, waiting for at most `wait` when it's given.
def more_from(conn: Connection, wait: Duration?) -> bytes fails NetError:
    if wait is None: return conn.read(65536)?
    return conn.read(65536, timeout=wait)?

## The next whole message from the server, waiting for it, for at most `wait` when it's given.
def next_message(
    conn: Connection,
    ref reader: PgReader,
    wait: Duration? = None,
) -> PgMessage fails SqlError:
    while True:
        found = reader.next()?
        if found is not None: return found
        more = more_from(conn, wait) except error:
            fail SqlError.Failed(reason=f"the connection to the server failed: {error.message()}")
        if len(more) == 0: fail SqlError.Failed(reason="the server closed the connection")
        reader.feed(more)
    fail SqlError.Failed(reason="the server closed the connection")
