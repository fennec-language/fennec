from std.string import cut_input

## A file path, like `saves/slot1.json`. Its parts are separated by `/`. Every method only
## looks at the text; none of them touch the file system.
export struct Path:
    text: str

    ## `Path("saves") / "slot1.json"` is the same as `.join`.
    def /(self, part: str) -> Path:
        return self.join(part)

    ## This path with `part` added. A `part` that starts with `/` replaces the path.
    def join(self, part: str) -> Path:
        if part.startswith("/") or self.text == "": return Path(part)
        if self.text.endswith("/"): return Path(self.text + part)
        return Path(self.text + "/" + part)

    ## `part`, a path from outside like a request's, inside this one. A leading `/` is taken as
    ## this path's own top, and empty parts are passed over. It fails on anything that could lead
    ## out of it: a `..`, a `\\`, a control character, or a drive letter like `C:` first. It fails
    ## too on what Windows reads as other than its text: a name ending in `.` or a space, which
    ## Windows drops, so `.. ` is `..`, and a device's name, like `CON` or `nul.txt`. Unlike `/`,
    ## it can't replace the path. It only looks at the text: an `Fs` narrowed with `only` is what
    ## keeps a program out of other folders, links and all.
    def inside(self, part: str) -> Path fails InvalidValue:
        for c in part:
            if c.code() < 32 or c.code() == 127 or c == "\\":
                fail InvalidValue(
                    message=f"`{cut_input(part)}` can't be a path inside `{cut_input(self.text)}`",
                )
        kept = Path(part).parts()
        # On Windows, `C:` first is another drive's folder, wherever the path was joined.
        if len(kept) > 0 and is_drive(kept[0]):
            fail InvalidValue(message=f"`{cut_input(part)}` would leave `{cut_input(self.text)}`")
        for name in kept:
            # Windows drops a name's last dots and spaces, so `.. ` and `...` climb as `..` does.
            dropped = name.endswith(".") or name.endswith(" ")
            if name == ".." or (dropped and name.startswith("..")):
                fail InvalidValue(
                    message=f"`{cut_input(part)}` would leave `{cut_input(self.text)}`",
                )
            if dropped or is_device(name):
                fail InvalidValue(
                    message=f"`{cut_input(part)}` can't be a path inside `{cut_input(self.text)}`",
                )
        return self.join("/".join(kept))

    ## Whether the path starts at the root, `/`.
    def is_absolute(self) -> bool:
        return self.text.startswith("/")

    ## The names between the `/`s, leaving out empty ones and `.`.
    def parts(self) -> list[str]:
        return [part for part in self.text.split("/") if part != "" and part != "."]

    ## The last part: `fox.png` for `assets/fox.png`.
    def name(self) -> str:
        parts = self.parts()
        if len(parts) == 0: return ""
        return parts[-1]

    ## What follows the name's last `.`, without the dot: `png` for `fox.png`. Empty for
    ## names like `notes` and `.hidden`.
    def extension(self) -> str:
        pieces = self.name().split(".")
        if len(pieces) < 2 or (len(pieces) == 2 and pieces[0] == ""): return ""
        return pieces[-1]

    ## The name without its extension: `fox` for `fox.png`.
    def stem(self) -> str:
        name = self.name()
        extension = self.extension()
        if extension == "": return name
        return name[:len(name) - len(extension) - 1]

    ## The path without its last part: `assets` for `assets/fox.png`, and `.` for `fox.png`.
    def parent(self) -> Path:
        mut parts = self.parts()
        if len(parts) == 0: return self.rebuild([])
        # Going up from `..` is further up, not back down to here.
        if parts[len(parts) - 1] == "..":
            parts.append("..")
            return self.rebuild(parts)
        return self.rebuild(parts[:len(parts) - 1])

    ## The same path written simply: `a/./b/../c` becomes `a/c`. A `..` that would go above
    ## the start stays in a relative path and is dropped from an absolute one.
    def normalize(self) -> Path:
        mut kept = []
        for part in self.parts():
            if part != "..":
                kept.append(part)
            elif len(kept) > 0 and kept[-1] != "..":
                kept.pop()
            elif not self.is_absolute():
                kept.append("..")
        return self.rebuild(kept)

    ## `parts` joined by `/`, starting at the root when this path does.
    def rebuild(self, parts: list[str]) -> Path:
        text = "/".join(parts)
        if self.is_absolute(): return Path("/" + text)
        if text == "": return Path(".")
        return Path(text)

## Whether `name` starts as a Windows drive does: a letter, then `:`.
def is_drive(name: str) -> bool:
    if len(name) < 2 or name[1] != ":": return False
    letter = name[0].code()
    return (letter >= 65 and letter <= 90) or (letter >= 97 and letter <= 122)

## Whether Windows reads `name` as a device, like `CON`, `NUL` or `COM1`: alone or before any
## extension, in any case, with spaces before the extension dropped, so `nul.txt` and `CON .log`
## are devices too.
def is_device(name: str) -> bool:
    stem = name.split(".")[0].rstrip().upper()
    if stem == "CON" or stem == "PRN" or stem == "AUX" or stem == "NUL": return True
    if len(stem) != 4 or not (stem.startswith("COM") or stem.startswith("LPT")): return False
    last = stem[3]
    return "123456789¹²³".find(last) is not None
