# `Spot(name=name, x=at + shift, y=at + 1)`, a struct with a str and two ints, done OPS times on inputs that vary.
# `fennec-bench ops` counts its instructions per operation beside its Rust twin's.

OPS = 20_000

struct Spot:
    name: str
    x: int
    y: int

def main(stdout: Stdout, args: Args):
    # No arguments are given, so this is 0, but the compiler can't know it.
    shift = len(args)
    names = [f"spot-{i}" for i in range(shift, shift + 16)]
    mut total = 0
    for at in range(OPS):
        spot = Spot(name=names[(at + shift) % 16], x=at + shift, y=at + 1)
        total += spot.x + spot.y + len(spot.name)
    stdout.print(total)
    return
