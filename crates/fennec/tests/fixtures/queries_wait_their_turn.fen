# For the test that tasks using one SQLite database wait their turn at its connection parked: a
# server's handlers insert on one connection while one of them runs a slow query on it, for 70
# clients at once. Under `FENNEC_COUNTS`, no blocking thread may have waited for the connection,
# as only the handler whose turn it is runs.
from std import sqlite
from std.concurrent import Crashed
from std.net import NetError, Request, Response
from std.sql import SqlError
from std.sqlite import Database

CLIENTS = 70

# How many rows a query counted.
struct Counted:
    rows: int

# The slow query for `/slow`, or an insert for anything else.
def handled(db: Database, request: Request) -> Response:
    if request.path == "/slow":
        found = db.query[Counted](
            t"with recursive c(x) as (select 1 union all select x + 1 from c where x < 300000) select count(*) as rows from c",
        ) except why:
            return Response(status=500, body=f"{why}".encode())
        counted = found[0].rows if len(found) == 1 else 0
        return Response(status=200, body=f"counted {counted}".encode())
    _ = db.execute(t"insert into seen (path) values ({request.path})") except why:
        return Response(status=500, body=f"{why}".encode())
    return Response(status=201, body="inserted".encode())

# A client's request: what it was answered, or why it got no answer.
def asked(net: Net, port: int, number: int) -> str:
    path = "/slow" if number == 0 else f"/n{number}"
    got = net.post(f"http://127.0.0.1:{port}{path}", body="") except why:
        return why.message()
    return got.text()

def main(net: Net, fs: Fs, env: Env, stdout: Stdout) fails NetError | Crashed | SqlError | IoError:
    folder = env.get("TMPDIR") else "/tmp"
    mut answers = list[str]()
    mut rows = 0
    with net.listen(0)? as server:
        path = f"{folder}/fennec-queries-wait-their-turn-{server.port}.db"
        with sqlite.open(fs, path)? as db:
            _ = db.execute(t"create table seen (path text)")?
            port = server.port
            with launch(() => server.serve((request) => handled(db, request)))?:
                answers = [
                    asked(net, port=port, number=number) for number in parallel(range(CLIENTS + 1))
                ]
                server.close()
            for kept in db.query[Counted](t"select count(*) as rows from seen")?:
                rows = kept.rows
        for leftover in [path, f"{path}-wal", f"{path}-shm"]:
            if fs.exists(leftover)?:
                fs.remove(leftover)?
    stdout.print(answers[0])
    inserted = len([one for one in answers if one == "inserted"])
    stdout.print(f"{inserted} inserted, {rows} rows kept")
    for other in sorted(set([one for one in answers[1:] if one != "inserted"])):
        stdout.print("also:", other)
