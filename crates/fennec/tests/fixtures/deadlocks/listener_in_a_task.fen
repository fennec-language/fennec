# A task listening to a channel to `.Every` that nothing is sent to, while main waits for it at its
# block's end: both wait for good.
from std.concurrent import Crashed, Inbox, channel

def heard(hits: Inbox[int], stdout: Stdout):
    for hit in hits:
        stdout.print("heard", hit)

def main(stdout: Stdout) fails Crashed:
    with channel[int](size=4, to=.Every) as hits:
        listening = hits.inbox()
        with launch(() => heard(listening, stdout))?:
            stdout.print("launched")
