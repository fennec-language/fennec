# decision: Collections are values.

## Lists are values: a copy keeps its items when the original changes, and a `ref`
## parameter changes the caller's list.

struct Point:
    x: float
    y: float

def grow(ref items: list[int], n: int):
    for i in range(n):
        items.append(i * 10)

def doubled(items: list[int]) -> list[int]:
    mut out: list[int] = []
    for x in items:
        out.append(x * 2)
    return out

def nudge(ref points: list[Point]):
    for i in range(len(points)):
        points[i].x += 1.0

def both(items: list[int], ref others: list[int]) -> int:
    others.append(9)
    others[0] = 7
    return len(items) * 10 + items[0]

def spread(
    ref int_list: list[int],
    ref float_list: list[float],
    ref count_list: list[int],
    ref flag_list: list[bool],
    n: int,
) -> float:
    for i in range(n):
        int_list.append(i)
        float_list.append(float(i) / 2.0)
        count_list[0] += i
        flag_list.append(i % 2 == 0)
    return float_list[-1] * 2.0

def main(stdout: Stdout):
    mut items = [1, 2, 3]
    kept = items
    items[0] = 100
    items.append(4)
    stdout.print(items, kept, len(items), len(kept))

    mut shared = [7]
    alias = shared
    shared.append(8)
    stdout.print(shared, alias)

    grow(ref items, 3)
    stdout.print(items, doubled(items), items == kept, kept == [1, 2, 3])

    mut many: list[int] = []
    for i in range(1_000):
        many.append(i)
    total = sum(value for value in many)
    stdout.print(len(many), total, many[-1], many[500])

    mut points = [Point(x=0.0, y=1.0), Point(x=2.0, y=3.0)]
    before = points
    nudge(ref points)
    points.append(Point(x=9.0, y=9.0))
    stdout.print(points, before)

    mut order = [3, 1, 2]
    order.sort()
    last = order.pop()
    stdout.print(order, last, order + [5], items[1:3])

    mut walked = [1, 2, 3]
    as_it_was = walked
    for walk in as_it_was:
        walked.append(walk)
    stdout.print(walked)

    # A `ref` argument has its list to itself, so the other one is given a value made first, which
    # keeps its items.
    mut twice = [1, 2]
    given = twice
    stdout.print(both(given, ref twice), twice)

    # A call can give back more than fits in a machine's return registers.
    mut ints = [1]
    mut floats = [0.5]
    mut counts = [10]
    mut flags = [False]
    stdout.print(
        spread(ref ints, ref floats, ref counts, ref flags, 100),
        len(ints),
        floats[50],
        counts,
        flags[-1],
    )
