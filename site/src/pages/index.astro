---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import fennec from '../fennec.tmLanguage.json';
import data from '../data/benchmarks.json';

const base = import.meta.env.BASE_URL;
const themes = { light: 'vitesse-light', dark: 'vitesse-dark' } as const;
const { ci, builds, targets } = data;
const percents = ci.kernels.map((kernel) => (kernel.percent / targets.jit) * 100);
const low = Math.round(Math.min(...percents));
const high = Math.round(Math.max(...percents));

const program = `def fib(n: int) -> int:
    if n < 2: return n
    fib(n - 1) + fib(n - 2)

test "fib":
    assert fib(10) == 55

def main(stdout: Stdout):
    stdout.print(fib(35))`;

const pillars = [
  {
    title: 'Builds instantly',
    number: `${builds.one_function_s} s`,
    caption: 'to rebuild 2,800 lines after changing one function',
    body: `Compiled a function at a time and cached by content, so a change costs only what it touches. The first build of that code takes ${builds.first_s.toFixed(0)} s, which we still want much lower.`,
  },
  {
    title: 'Runs fast',
    number: `${low}–${high}%`,
    caption: "of its speed target today, in the JIT",
    body: `Native code with no garbage collector. No benchmark meets its target yet, and release builds, the fastest path, aren't built yet.`,
  },
  {
    title: 'Built for agents',
    number: `<${builds.tests_unchanged_s} s`,
    caption: 'to rerun tests when nothing they use changed',
    body: 'It reads like typed Python, the language models know best, with one way to do each thing and errors that say how to fix them.',
  },
];
---

<Base title="Fennec" description="Fennec is a safe, compiled language that builds instantly, runs fast and is built for agents. In progress, with real numbers.">
  <div class="glow" aria-hidden="true"></div>
  <section class="hero wrap">
    <div class="intro">
      <span class="pill">In progress · not released yet</span>
      <h1>The fast language agents write and people can read.</h1>
      <p class="lede">Compiled and safe, with no garbage collector. It reads like Python, and it's being built in the open, numbers included.</p>
      <div class="actions">
        <a class="button primary" href={`${base}playground/`}>Try it →</a>
        <a class="button" href={`${base}tour/`}>Take the tour</a>
      </div>
      <div class="install">
        <span>No release yet. Build from source:</span>
        <code>git clone https://github.com/fennec-language/fennec &amp;&amp; cd fennec &amp;&amp; cargo build --release -p fennec -p fennec-runtime</code>
      </div>
    </div>

    <div class="demo">
      <div class="window">
        <div class="window-bar">
          <span></span><span></span><span></span>
          <em>fib.fen</em>
        </div>
        <Code code={program} lang={fennec} themes={themes} />
      </div>
      <div class="meters">
        <div class="meter">
          <strong>{builds.fib_first_s} s</strong>
          <span>to build it</span>
        </div>
        <div class="meter">
          <strong>&lt;{builds.tests_unchanged_s} s</strong>
          <span>to retest, unchanged</span>
        </div>
        <div class="meter wide">
          <div class="meter-head">
            <strong>{low}–{high}%</strong>
            <span>of the speed target, across our benchmarks</span>
          </div>
          <div class="range" role="img" aria-label={`Today ${low} to ${high} percent of the speed target`}>
            <span class="range-fill" style={`left: ${low}%; width: ${high - low}%`}></span>
          </div>
          <span class="range-note">JIT today · a full bar means the target is met</span>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap pillars">
    {
      pillars.map((pillar) => (
        <article class="pillar">
          <h2>{pillar.title}</h2>
          <strong>{pillar.number}</strong>
          <em>{pillar.caption}</em>
          <p>{pillar.body}</p>
        </article>
      ))
    }
    <p class="more"><a href={`${base}benchmarks/`}>See every benchmark and how it's measured →</a></p>
  </section>

  <section class="wrap agents">
    <h2>Built for agents</h2>
    <div class="agent-grid">
      <article>
        <h3>Errors say how to fix them</h3>
        <pre><code>error: `area` gives back a float, so its
  return type has to be written
  = help: `def area(radius: float) -> float:`

$ fennec fix
fixed area.fen</code></pre>
        <p><code>fennec fix</code> applies the fixes it can make itself, and every error says what to do. Not every error has an automatic fix yet.</p>
      </article>
      <article>
        <h3>Only affected tests rerun</h3>
        <pre><code>$ fennec test
3 passed, 0 failed</code></pre>
        <p>Tests that passed and whose code hasn't changed are skipped, so an agent's loop stays fast.</p>
      </article>
      <article>
        <h3><code>fennec context</code> <span class="soon">coming</span></h3>
        <pre><code>$ fennec context some_kit</code></pre>
        <p>A kit's whole API, sized for a prompt, so a model reads real signatures instead of guessing.</p>
      </article>
    </div>
  </section>
</Base>

<script>
  // Everything is visible without this. The animation starts only once frames are being drawn.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const demo = document.querySelector('.demo');
    requestAnimationFrame(() => demo?.classList.add('play'));
    // Never leave the code hidden if the browser isn't advancing animations.
    setTimeout(() => demo?.classList.remove('play'), 2500);
  }
</script>

<style>
  .glow {
    position: absolute;
    inset: 0 0 auto 0;
    height: 620px;
    z-index: -1;
    background:
      radial-gradient(60% 70% at 78% 10%, color-mix(in srgb, var(--accent-bright) 22%, transparent), transparent 70%),
      radial-gradient(45% 55% at 12% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%);
    pointer-events: none;
  }

  .hero {
    display: grid;
    gap: 2.5rem;
    padding-top: 3.5rem;
    align-items: center;
  }

  @media (min-width: 940px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
      padding-top: 5rem;
    }
  }

  .intro,
  .demo {
    min-width: 0;
  }

  .pill {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 999px;
    padding: 0.2rem 0.75rem;
  }

  h1 {
    font-size: clamp(2.4rem, 5.6vw, 3.7rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin: 1rem 0;
    text-wrap: balance;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--muted);
    margin: 0 0 1.5rem;
    max-width: 34rem;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .install {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .install code {
    display: block;
    margin-top: 0.35rem;
    padding: 0.6rem 0.8rem;
    overflow-wrap: anywhere;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--code-bg);
    color: var(--text);
    font-size: 0.8rem;
  }

  .window {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--code-bg);
    overflow: hidden;
    box-shadow: 0 24px 60px -30px rgb(27 26 46 / 0.45);
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .window-bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border);
  }

  .window-bar em {
    margin-left: 0.6rem;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .window :global(pre.astro-code) {
    border: 0;
    border-radius: 0;
    margin: 0;
    font-size: 0.88rem;
  }

  .meters {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .meter {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: var(--radius);
    padding: 0.85rem 1.1rem;
  }

  .meter.wide {
    grid-column: 1 / -1;
  }

  .meter strong {
    display: block;
    font-size: 1.6rem;
    letter-spacing: -0.03em;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .meter span {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .meter-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .range {
    position: relative;
    height: 10px;
    margin: 0.6rem 0 0.4rem;
    border-radius: 999px;
    background: var(--surface-strong);
  }

  .range .range-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 999px;
    background: var(--accent-bright);
  }

  .range-note {
    font-size: 0.78rem;
  }

  .demo.play :global(.line) {
    animation: rise 0.4s ease-out backwards;
  }

  .demo.play :global(.line:nth-child(2)) { animation-delay: 0.08s; }
  .demo.play :global(.line:nth-child(3)) { animation-delay: 0.16s; }
  .demo.play :global(.line:nth-child(4)) { animation-delay: 0.24s; }
  .demo.play :global(.line:nth-child(5)) { animation-delay: 0.32s; }
  .demo.play :global(.line:nth-child(6)) { animation-delay: 0.4s; }
  .demo.play :global(.line:nth-child(7)) { animation-delay: 0.48s; }
  .demo.play :global(.line:nth-child(8)) { animation-delay: 0.56s; }
  .demo.play :global(.line:nth-child(9)) { animation-delay: 0.64s; }

  .demo.play .meter {
    animation: rise 0.5s ease-out 0.75s backwards;
  }

  .demo.play .meter:nth-child(2) { animation-delay: 0.9s; }
  .demo.play .meter:nth-child(3) { animation-delay: 1.05s; }

  .demo.play .range .range-fill {
    transform-origin: left;
    animation: grow 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 1.15s backwards;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes grow {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .pillars {
    display: grid;
    gap: 1rem;
    margin-top: 5rem;
  }

  @media (min-width: 800px) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pillar {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .pillar h2 {
    margin: 0;
    font-size: 1rem;
    color: var(--accent);
    letter-spacing: 0;
  }

  .pillar strong {
    display: block;
    margin-top: 0.5rem;
    font-size: clamp(2.2rem, 4.5vw, 2.9rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .pillar em {
    display: block;
    font-style: normal;
    font-weight: 600;
    font-size: 0.95rem;
    margin: 0.2rem 0 0.75rem;
  }

  .pillar p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .more {
    grid-column: 1 / -1;
    margin: 0.25rem 0 0;
  }

  .agents {
    margin-top: 5rem;
  }

  .agents > h2 {
    font-size: clamp(1.7rem, 4vw, 2.2rem);
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem;
  }

  .agent-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 800px) {
    .agent-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .agent-grid article {
    min-width: 0;
  }

  .agent-grid h3 {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
  }

  .agent-grid pre {
    margin: 0 0 0.6rem;
    padding: 0.7rem 0.85rem;
    font-size: 0.78rem;
    line-height: 1.5;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--code-bg);
  }

  .agent-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .soon {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
    vertical-align: middle;
  }
</style>
