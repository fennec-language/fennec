## `list`'s methods written in Fennec. Growing, shrinking and reading a slot are machine
## operations the engines provide.
extend list[T]:
    ## Adds every item of `more` to the end, in order.
    def extend(ref self, more: list[T]):
        for item in more:
            self.append(item)

    ## The item at `at`, counting from the end when it's negative as `self[at]` does, or `None`
    ## when there's no item there, where `self[at]` would stop the program.
    def get(self, at: int) -> T?:
        size = len(self)
        if at >= size or at < -size: return None
        return self[at]

    ## Reverses the items in place.
    def reverse(ref self):
        mut low = 0
        mut high = len(self) - 1
        while low < high:
            held = self[low]
            self[low] = self[high]
            self[high] = held
            low += 1
            high -= 1

    ## Swaps the items at `i` and `j`, in place, counting from the end when either is negative, as
    ## `self[at]` does. Each has to be there. It's how two items of one list change places, since
    ## `f(ref xs[i], ref xs[j])` is refused: `i` and `j` may be the same.
    def swap(ref self, i: int, j: int):
        held = self[i]
        self[i] = self[j]
        self[j] = held

## Methods for lists whose items can be compared with `==`.
extend list[T: Eq]:
    ## How many items equal `item`.
    def count(self, item: T) -> int:
        mut found = 0
        for each in self:
            if each == item:
                found += 1
        return found

    ## Where `item` first is, or None when it isn't there.
    def index(self, item: T) -> int?:
        for at, each in enumerate(self):
            if each == item: return at
        return None

extend list[T: Serializable]:
    def serialize(self, ref out: Serializer):
        out.sequence(self)

extend list[T: Deserializable]:
    def deserialize(ref src: Deserializer) -> list[T] fails ParseError:
        return src.sequence[T]()?

## `list`'s methods the engines provide. Each is declared here for its signature and its doc, and a
## test holds it to the checker's own.
extend list[T]:
    ## How many items it has.
    @intrinsic
    def len(self) -> int

    ## Adds `item` at the end.
    @intrinsic
    def append(ref self, item: T)

    ## Takes out the first item equal to `item`. One that isn't there stops the program.
    @intrinsic
    def remove(ref self, item: T)

    ## Puts `item` at `at`, moving the items from there on along by one.
    @intrinsic
    def insert(ref self, at: int, item: T)

    ## Takes out every item.
    @intrinsic
    def clear(ref self)

    ## Takes out every item `test` is true of, keeping the rest in order.
    @intrinsic
    def remove_where(ref self, test: (T) -> bool)

    ## Puts the items in order, smallest first, or by what `key` gives for each. Items that compare
    ## equal keep the order they had.
    @intrinsic
    def sort[K](ref self, key: ((T) -> K)? = None)

    ## Takes out the last item and gives it back, or `None` when there's none. `pop(at)` takes out
    ## the item at `at` instead, and a position that isn't there stops the program, as `items[at]`
    ## does.
    @intrinsic
    def pop(ref self, at: int? = None) -> T?

## `Buffer`'s methods the engines provide: the growable, counted run of slots a `list` is built on.
## Each is declared here for its signature and its doc, and a test holds it to the checker's own.
extend Buffer[T]:
    ## How many items it has.
    @intrinsic
    def len(self) -> int

    ## Adds `item` at the end.
    @intrinsic
    def push(ref self, item: T)

    ## Takes out the last item and gives it back. An empty buffer stops the program.
    @intrinsic
    def pop(ref self) -> T

    ## Adds every item of `more` at the end, in order.
    @intrinsic
    def extend(ref self, more: Buffer[T])

    ## Puts `item` at `at`, moving the items from there on along by one.
    @intrinsic
    def insert(ref self, at: int, item: T)

    ## Takes out the item at `at` and gives it back.
    @intrinsic
    def remove(ref self, at: int) -> T

    ## Makes room for at least `more` items past the ones it has, so adding them needn't grow it.
    @intrinsic
    def reserve(ref self, more: int)

    ## Keeps only the first `length` items.
    @intrinsic
    def truncate(ref self, length: int)

    ## How many items it has room for before it has to grow.
    @intrinsic
    def capacity(self) -> int

    ## Whether nothing else holds its block, so changing it changes no other buffer.
    @intrinsic
    def is_unique(self) -> bool
