from std.concurrent import Crashed

struct Holder:
    groups = dict[str, list[int]]()

def row(base: int) -> list[int]:
    return [base + turn for turn in range(8)]

def build() -> dict[str, list[int]]:
    mut groups = dict[str, list[int]]()
    groups["first"] = row(100)
    groups["second"] = row(200)
    return groups

def churn() -> list[list[int]]:
    mut made = list[list[int]]()
    for turn in range(5000):
        made.append(row(7000))
    return made

def reader(groups: dict[str, list[int]], clock: Clock, stdout: Stdout):
    clock.sleep(50ms)
    stdout.print("task", groups["first"], groups["second"])

def nothing():
    pass

def start(clock: Clock, stdout: Stdout) fails Crashed:
    groups = build()
    with launch(() => reader(groups, clock, stdout))?:
        pass

def main(clock: Clock, stdout: Stdout) fails Crashed:
    with launch(() => nothing())?:
        pass
    shared holder = Holder(groups=build())
    extra = churn()
    lock holder as current:
        stdout.print("lock", current.groups["first"], current.groups["second"])
    stdout.print(len(extra))
    start(clock, stdout)?
