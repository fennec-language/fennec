struct Unit:
    x: float
    health: float

def main(stdout: Stdout):
    mut units = [Unit(float(n % 100), health=10.0) for n in range(50_000)]
    for ref unit in parallel(units):
        unit.x += 2.0
        if unit.x > 50.0:
            unit.health -= 1.0
    stdout.print(sum(unit.health for unit in parallel(units)))
