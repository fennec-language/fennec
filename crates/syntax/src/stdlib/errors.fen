## A failure of the file system or a stream, with a case for each way a caller might handle
## differently, each saying what went wrong in `reason`. `message()` gives it.
##
## ```fennec
## assert fs.read_text("nowhere.txt") fails .NotFound()
## ```
export error IoError:
    ## Nothing is at the path.
    NotFound(reason: str)
    ## The system, or an `Fs` narrowed with `only`, won't let the program do that there.
    PermissionDenied(reason: str)
    ## Something is at the path already.
    AlreadyExists(reason: str)
    ## Any other failure, said in words.
    Other(reason: str)

    ## What went wrong, in words.
    ##
    ## ```fennec
    ## said = fs.read_text("nowhere.txt") except why:
    ##     why.message()
    ## assert "nowhere.txt" in said
    ## ```
    def message(self) -> str:
        return match self:
            case NotFound(reason) | PermissionDenied(reason):
                reason
            case AlreadyExists(reason) | Other(reason):
                reason

## A value that isn't what was asked for, like text that isn't a number, with `message` saying why.
## ```fennec
## n = int.parse("seven") except why:
##     stdout.print(why.message)
##     0
## assert n == 0
## ```
## ```output
## "seven" isn't an int
## ```
export error InvalidValue:
    message: str

## Text that isn't the format it was read as, with `message` saying why and `line` and `column`
## saying where.
## ```fennec
## from std import json
## items = json.loads[list[int]]("[1,\n x]") except why:
##     stdout.print(f"line {why.line}, column {why.column}")
##     list[int]()
## assert len(items) == 0
## ```
## ```output
## line 2, column 2
## ```
export error ParseError:
    message: str
    line: int
    column: int

## What `run` fails with, or `None` when it doesn't, for a test that needs the failure as a value:
## `problem = failure_of(() => Time.parse(text)?)`. `assert Time.parse(text) fails InvalidValue()` is
## the usual way to check one. It's only for tests: anywhere else, `except why:` names a failure
## where it happens.
##
## ```fennec
## problem = failure_of(() => int.parse("seven")?)
## assert problem is not None
## assert failure_of(() => int.parse("7")?) is None
## ```
export def failure_of[T, E](run: () -> T fails E) -> E?:
    _ = run() except why:
        return why
    return None
