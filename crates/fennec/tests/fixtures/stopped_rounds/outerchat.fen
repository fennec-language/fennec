# A task waits at its own block's end for a task that serves, when its own stop finds it there.
# Each round's handler works a while, then tells a third task what it was asked, on a channel.
from std.concurrent import Channel, Crashed, channel
from std.net import NetError, Request, Response, Server

def counted(turns: int) -> int:
    mut total = 0
    for turn in range(turns):
        total = (total + turn * 7) % 1000003
    return total

def answered(request: Request, said: Channel[str]) -> Response:
    total = counted(turns=20000000)
    said.send(request.path) except Closed():
        pass
    return Response(status=200, body=f"hello {request.path} {total}".encode())

def serving(server: Server, said: Channel[str], stdout: Stdout):
    server.serve((request) => answered(request, said=said))
    stdout.print("the server never said")

def logging(said: Channel[str], stdout: Stdout):
    while True:
        path = said.receive() else ""
        if path == "": break
        stdout.print("the logger heard", path)

def outer(net: Net, server: Server, stdout: Stdout) fails NetError | Crashed:
    port = server.port
    with channel[str](size=1) as said:
        with launch(() => logging(said, stdout=stdout))?:
            with launch(() => serving(server, said=said, stdout=stdout))?:
                for path in ["one", "two", "three"]:
                    got = net.get(f"http://127.0.0.1:{port}/{path}")?
                    stdout.print(got.text())
    stdout.print("outer never said")

def tried(net: Net, server: Server, stdout: Stdout):
    outer(net, server, stdout=stdout) except why:
        stdout.print("outer failed", f"{why}")

def main(net: Net, stdout: Stdout) fails NetError | Crashed:
    with net.listen(0)? as server:
        with launch(() => tried(net, server, stdout=stdout), stop_after=600ms)?:
            pass
    stdout.print("both are over")
