struct Pool:
    items: list[int]

    def add(ref self, item: int):
        self.items.append(item)

    def len(self) -> int:
        return len(self.items)

    def [](ref self, i: int) -> int:
        return self.items[i]

def main(stdout: Stdout):
    mut pool = Pool(items=[1])
    for ref item in pool:
        item += 1
        pool.add(item)
    stdout.print(len(pool))
