# Waiting calls from main with a nap before each, so the workers are asleep when the call's first
# job is pushed: the moment the proof's look at the pools' queues is for. Its test holds each woken
# worker 20 ms (FENNEC_TEST_SLOW_WAKE_MS) before it says it's awake. Never a deadlock.
# (From Fable 5.2's review of the phase 2 design.)
from std.concurrent import Channel, Closed, channel

def part(at: int, pipe: Channel[int]) -> int:
    if at == 0:
        got = pipe.receive() else -1
        return got
    pipe.send(at + 6) except Closed():
        return -100
    return 0

def pair(pipe: Channel[int]) -> int:
    got = [part(at, pipe=pipe) for at in parallel(range(2))]
    return sum(got)

def main(stdout: Stdout, clock: Clock):
    mut total = 0
    for turn in range(6):
        clock.sleep(30ms)
        with channel[int](size=1) as pipe:
            total += pair(pipe)
    stdout.print(total)
