struct Pool:
    items: list[int]

    def len(self) -> int:
        return self.items.len()

    def is_live(self, i: int) -> int:
        return i

    def [](mut self, i: int) -> int:
        return self.items[i]

def main(stdout: Stdout):
    mut pool = Pool(items=[1])
    for mut item in pool:
        item += 1
    stdout.print(pool.len())
