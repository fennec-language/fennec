## What `blake3(chunks)` and `sha256(chunks)` are written with: each chunk, text or `bytes`, is given
## to the hash in turn, so a file far bigger than memory hashes in a few kilobytes, as
## `blake3(file.chunks(1_000_000)?)` does. The checker sends a call here when what's hashed is a list
## or an iterator of chunks.
from std import crypto

def blake3_of_str_chunks(chunks: Iterator[str]) -> str:
    handle = crypto._start("blake3")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def blake3_of_str_list(chunks: list[str]) -> str:
    handle = crypto._start("blake3")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def blake3_of_bytes_chunks(chunks: Iterator[bytes]) -> str:
    handle = crypto._start("blake3")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def blake3_of_bytes_list(chunks: list[bytes]) -> str:
    handle = crypto._start("blake3")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def sha256_of_str_chunks(chunks: Iterator[str]) -> str:
    handle = crypto._start("sha256")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def sha256_of_str_list(chunks: list[str]) -> str:
    handle = crypto._start("sha256")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def sha256_of_bytes_chunks(chunks: Iterator[bytes]) -> str:
    handle = crypto._start("sha256")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

def sha256_of_bytes_list(chunks: list[bytes]) -> str:
    handle = crypto._start("sha256")
    for chunk in chunks:
        crypto._add(handle, chunk)
    return crypto._end(handle)

## Something that has to stay secret, like a password, a token or a key: `Secret[str]` or
## `Secret[bytes]`. Printing one, putting it in an f-string, making text of it with `str()`, and
## saving it are compile errors, and so is showing anything that holds one. What it holds comes out
## only through `expose_secret()`, so searching for that name finds every place a secret is read.
## `==` on two compares what they hold in constant time.
##
## ```fennec
## token = env.secret("API_TOKEN")?
## headers = {"authorization": f"Bearer {token.expose_secret()}"}
## ```
export struct Secret[T]:
    _value: T

    ## A secret holding `value`.
    def of(value: T) -> Secret[T]:
        return Secret(_value=value)

    ## What it holds, to use where it's needed, like a request's header. The name says a secret
    ## is being read, here and nowhere else.
    def expose_secret(self) -> T:
        return self._value

    ## Two secrets are equal when what they hold is, compared in time that depends only on
    ## their lengths, as `equal` compares, so how long it takes never says where they differ.
    def ==(self, other: Secret[T]) -> bool:
        return crypto.equal(self._value, other._value)

    ## However it's printed, as through a generic function's `T`, it shows only that it's there.
    def str(self, ref out: StrWriter):
        out.write("Secret(hidden)")
