from std.crypto import Secret

## A setting that has to be there, read from an environment variable that isn't set.
export error Missing:
    name: str

## The environment variables the program was started with, given to `main` or a test. Its
## methods written in Rust are `get(name)`, the variable's value or `None` when it isn't set, and
## `all()`, every variable by name. A test's `Env` is a fake holding only what the test set with
## `set(name, value)`. Only `main` and tests are given one: it can't be made.
export struct Env:
    _given: int

    ## A setting that has to be there and must never be printed, like a password or a token:
    ## `password = env.secret("DATABASE_PASSWORD")?`. A variable that isn't set fails with
    ## `Missing`, rather than becoming an empty secret nobody notices.
    def secret(self, name: str) -> Secret[str] fails Missing:
        value = self.get(name) else:
            fail Missing(name=name)
        return Secret.of(value)
