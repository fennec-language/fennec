# A stop that races a round: one round's handler is waiting to receive from a channel nobody
# sends to when the serving task's block ends and stops it.
from std.concurrent import Channel, Crashed, channel
from std.net import NetError, Request, Response, Server

def answered(request: Request, numbers: Channel[int], stdout: Stdout) -> Response:
    if request.path == "/slow":
        stdout.print("the slow one began")
        got = numbers.receive() else -1
        stdout.print("the slow one never said", got)
    return Response(status=200, body=f"hello {request.path}".encode())

def serving(server: Server, numbers: Channel[int], stdout: Stdout):
    server.serve((request) => answered(request, numbers=numbers, stdout=stdout))
    stdout.print("the server never said")

def main(net: Net, stdout: Stdout) fails NetError | Crashed:
    with channel[int](size=1) as numbers:
        with net.listen(0)? as server:
            port = server.port
            with net.connect("127.0.0.1", port)? as slow:
                slow.write("GET /slow HTTP/1.1\r\nhost: here\r\n\r\n")?
                with launch(() => serving(server, numbers=numbers, stdout=stdout), stop_after=100ms)?:
                    got = net.get(f"http://127.0.0.1:{port}/one")?
                    stdout.print(got.text())
    stdout.print("the server is over")
