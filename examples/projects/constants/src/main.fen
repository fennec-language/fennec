## Constants import like any other name, from the file that holds them.

from words import KEYWORDS, LENGTHS, LONGEST, is_keyword

GREETING = "names: " + str(LONGEST) + " letters at most"

def main(stdout: Stdout):
    stdout.print(GREETING)
    for word in ["if", "fox", "return"]:
        stdout.print(word, is_keyword(word), word in KEYWORDS)
    stdout.print(LENGTHS["while"], KEYWORDS.len())
