## What `main.fen` imports under other names.

enum Kind:
    Walker
    Flyer(height: float)

struct Enemy:
    name: str
    kind: Kind

def spawn(name: str, kind: Kind) -> Enemy:
    return Enemy(name, kind)

def describe(enemy: Enemy) -> str:
    match enemy.kind:
        case .Walker:
            return enemy.name + " walks"
        case .Flyer(height):
            return f"{enemy.name} flies at {height}"
