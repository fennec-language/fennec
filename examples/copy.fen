# `copy(value)` makes a separate value on purpose, so changing one doesn't reach the other.

struct Point:
    x: int
    y = 0.5

struct Shape:
    at: Point
    name: str
    tags: list[str]

def main(stdout: Stdout):
    original = Point(x=1)
    mut copied = copy(original)
    copied.x = 2
    stdout.print(original.x, copied.x, copied.y)
    one = Shape(at=original, name="one", tags=["t"])
    mut two = copy(one)
    two.at.x = 9
    two.name = "two"
    two.tags.append("u")
    stdout.print(one.at.x, one.name, one.tags, two.at.x, two.name, two.tags)
    mut list_a = [1, 2]
    mut list_b = copy(list_a)
    list_b.append(3)
    list_a[0] = 5
    stdout.print(list_a, list_b)
