## Expressions, from lowest precedence to highest: arrow functions and `match`; conditional
## expressions and `else` defaults; `or`; `and`; `not`; comparisons; `+ -`; `* / // %`; unary
## minus; `**`; then calls, attributes, indexing, `?` and `?.`. Mirrors
## `crates/syntax/src/parser/expr.rs`.

from span import Span, Diagnostic
from token import FPart, Tok, is_reserved
from lexer import byte_length, lex
from ast import Module, Item, FnDef, Generic, Param, TypeExpr, TypeDef, Field, Case, Interface, Import, TestDef, Stmt, StmtKind, Expr, ExprKind, CompKind, MatchArm, Pattern, FStrPart, Arg, UnaryOp, BinOp
from parser import Parser, is_field_word, is_name, describe

## What an expression made at its top, outside any parentheses.
enum Formed:
    Conditional
    Fallback
    Plain

## A one-line `if` and a fallback `else` in one expression, without parentheses saying which
## holds which: `int(text) else 80 if given else 8080` reads two ways.
def mixed_else(inner: Expr) -> Diagnostic:
    Diagnostic(
        message="a one-line `if` and a fallback `else` need parentheses to share an expression",
        span=inner.span,
        help="put this part in parentheses, or give the `if` or the fallback a line of its own",
    )

extend Parser:
    def expr(ref self) -> Expr fails Diagnostic:
        parsed, _ = self.expr_made()?
        parsed

    ## An expression, and whether this call made a one-line `if` or a fallback `else` of its own,
    ## rather than reading one inside parentheses.
    def expr_made(ref self) -> (Expr, Formed) fails Diagnostic:
        at_top = self.value_at_top
        self.value_at_top = False
        if self.at_match():
            return (self.match_expr()?, .Plain)
        lambda = self.lambda()?
        if lambda is not None:
            return (lambda, .Plain)
        value = self.or_expr()?
        if self.eat_keyword("if"):
            cond = self.or_expr()?
            if not self.eat_keyword("else"):
                fail Diagnostic(
                    message="a conditional expression needs `else`",
                    span=self.span(),
                    help="write `a if condition else b`",
                )
            otherwise, made = self.expr_made()?
            if made == .Fallback:
                fail mixed_else(otherwise)
            return (Expr(kind=.Cond(value, cond=cond, otherwise=otherwise), span=value.span.to(otherwise.span)), .Conditional)
        if self.eat_keyword("else"):
            mut default = Expr(kind=.Nothing, span=self.span())
            if self.at_leaving():
                default = self.leaving()?
            elif self.at_punct(":"):
                default = self.leaving_block(None)?
            elif self.eat_keyword("as"):
                failure = self.name("a name for the failure after `else as`")?
                if not self.at_punct(":"):
                    fail Diagnostic(
                        message="`else as` needs a block",
                        span=self.span(),
                        help="write `else as failure:` and the block under it, which leaves",
                    )
                default = self.leaving_block(failure)?
            else:
                inner, made = self.expr_made()?
                if made == .Conditional:
                    fail mixed_else(inner)
                default = inner
            return (Expr(kind=.Else(value, default=default), span=value.span.to(default.span)), .Fallback)
        if self.at_keyword("except"):
            if not at_top:
                fail Diagnostic(
                    message="`except` goes after a whole right side, a bare call or `return`",
                    span=self.span(),
                    help="give the call a line of its own, as `got = f() except why:`, and use `got` here",
                )
            handler = self.except_handler()?
            return (Expr(kind=.Else(value, default=handler, is_except=True), span=value.span.to(handler.span)), .Fallback)
        (value, .Plain)

    ## What follows `except`, written in as the same one-case `match` an `else` block is: any
    ## failure, `except why:` with a block of statements or of `case` arms, which becomes a
    ## `match why:` in the block, or one case, as `except InvalidValue(): 8080`, whose pattern is
    ## the case's.
    def except_handler(ref self) -> Expr fails Diagnostic:
        start = self.advance().span
        if self.peek_at(1) == .Punct(":"):
            match self.peek():
                case .Name(name):
                    if name[0] >= "A" and name[0] <= "Z":
                        fail Diagnostic(
                            message=f"`{name}` after `except` would name any failure",
                            span=self.span(),
                            help=f"write `except {name}():` to handle only `{name}`, or a lowercase name to handle any failure",
                        )
                    if name != "_":
                        at = self.advance().span
                        return self.named_handler(start, name, at)?
                case _: pass
        if self.at_punct(":"):
            fail Diagnostic(
                message="`except` names the failure it handles",
                span=self.span(),
                help="write `except why:` and use `why` in the block, or name one case, as `except InvalidValue(): 8080`",
            )
        pattern = self.pattern()?
        if not self.at_punct(":"):
            fail Diagnostic(
                message="`except` and its case need a `:`",
                span=self.span(),
                help="write the case, a `:` and what it gives, as `except InvalidValue(): 8080`",
            )
        arm_start = self.advance().span
        indented = self.at(.Newline)
        body = self.block()?
        # On the line, the case's statement has ended the line, and the statement it's in with it.
        self.block_ended = not indented or self.block_ended
        span = arm_start.to(self.prev_span())
        # The failure has a name nobody can write, as the one case's `match` is over it.
        arm = MatchArm(pattern=pattern, guard=None, body=body, span=span)
        self.handler_over(start, "except'failure", start, [arm])

    ## `except why:` and its block, of statements, or of `case` arms, which are a `match why:`
    ## in the block.
    def named_handler(ref self, start: Span, failure: str, at: Span) -> Expr fails Diagnostic:
        arms_follow = self.peek_at(1) == .Newline and self.peek_at(2) == .Indent and self.peek_at(3) == .Name("case")
        if not arms_follow:
            handler = self.leaving_block(failure)?
            return Expr(kind=handler.kind, span=start.to(handler.span))
        _ = self.advance()
        self.expect_block_start()?
        arms = self.arms()?
        self.handler_over(start, failure, at, arms)

    ## A handler whose block is a `match` over the failure, named `failure`, with these arms.
    ## The `match` over the failure covers only its arms, a span of its own: analyses tell
    ## expressions apart by span, and one that shared the handler's would hide both, as a way out
    ## of an arm did from a `with` source's cleanup.
    def handler_over(self, start: Span, failure: str, at: Span, arms: list[MatchArm]) -> Expr:
        span = start.to(self.prev_span())
        mut over = span
        if arms.len() > 0:
            over = arms[0].span.to(arms[arms.len() - 1].span)
        subject = Expr(kind=.Name(failure), span=at)
        matched = Expr(kind=.Match(subject, arms), span=over)
        leaving_match(start, [Stmt(kind=.Expr(matched), span=over)], span, failure=failure)

    def at_leaving(self) -> bool:
        self.peek() in [.Keyword("continue"), .Keyword("break"), .Keyword("return"), .Keyword("fail")]

    ## `continue`, `break`, `return` or `fail` after `else`, as a `match` with one case that leaves, which
    ## every engine and analysis already follows out of the expression.
    def leaving(ref self) -> Expr fails Diagnostic:
        start = self.span()
        word = self.peek()
        _ = self.advance()
        kind: StmtKind = match word:
            case .Keyword("continue"): .Continue
            case .Keyword("break"): .Break
            case .Keyword("fail"): .Fail(self.expr()?)
            case _:
                if self.at(.Newline) or self.at(.Eof) or self.at(.Dedent):
                    .Return(None)
                else:
                    .Return(self.expr()?)
        span = start.to(self.prev_span())
        leaving_match(start, [Stmt(kind=kind, span=span)], span)

    ## An `else:` block, which leaves or gives the value. It's the same `match` as `else return`,
    ## with more statements in its case, and the checker sees that it leaves or gives a value.
    def leaving_block(ref self, failure: str?) -> Expr fails Diagnostic:
        start = self.advance().span
        indented = self.at(.Newline)
        body = self.block()?
        self.block_ended = indented
        span = start.to(self.prev_span())
        leaving_match(start, body, span, failure=failure)

    ## `x => body` or `(a, b) => body`.
    def lambda(ref self) -> Expr? fails Diagnostic:
        start = self.span()
        mut params = []
        if is_name(self.peek()) and self.peek_at(1) == .Punct("=>"):
            params.append(self.name("a parameter")?)
            self.pos += 1
        elif self.at_punct("("):
            found = self.paren_params()
            if found is None:
                return None
            names, used = found
            params = names
            self.pos += used
        else:
            return None
        body = self.expr()?
        Expr(kind=.Lambda(params, body), span=start.to(body.span))

    ## Looks ahead for `(a, b) =>`, returning the names and how many tokens they take. A
    ## trailing comma is fine, as it is in `def` parameters.
    def paren_params(self) -> (list[str], int)?:
        mut params = []
        mut at = 1
        while True:
            match self.peek_at(at):
                case .Name(name): params.append(name)
                case .Punct(")"): break
                case _: return None
            at += 1
            if self.peek_at(at) == .Punct(")"):
                break
            if self.peek_at(at) != .Punct(","):
                return None
            at += 1
        if self.peek_at(at + 1) != .Punct("=>"):
            return None
        (params, at + 2)

    def or_expr(ref self) -> Expr fails Diagnostic:
        mut lhs = self.and_expr()?
        while self.eat_keyword("or"):
            lhs = binary(.Or, lhs=lhs, rhs=self.and_expr()?)
        lhs

    def and_expr(ref self) -> Expr fails Diagnostic:
        mut lhs = self.not_expr()?
        while self.eat_keyword("and"):
            lhs = binary(.And, lhs=lhs, rhs=self.not_expr()?)
        lhs

    def not_expr(ref self) -> Expr fails Diagnostic:
        start = self.span()
        if self.eat_keyword("not"):
            operand = self.not_expr()?
            return Expr(kind=.Unary(.Not, operand), span=start.to(operand.span))
        self.comparison()?

    ## Comparisons chain as in Python: `a < b <= c` means `a < b and b <= c`.
    def comparison(ref self) -> Expr fails Diagnostic:
        mut lhs = self.bit_or()?
        mut chain = None
        while True:
            op = comparison_op(self.peek(), second=self.peek_at(1))
            if op is None:
                break
            self.pos += 2 if op == .NotIn or op == .IsNot else 1
            rhs = self.bit_or()?
            pair = binary(op, lhs=lhs, rhs=rhs)
            if chain is None:
                chain = pair
            else:
                chain = binary(.And, lhs=chain, rhs=pair)
            lhs = rhs
        chain else lhs

    def bit_or(ref self) -> Expr fails Diagnostic:
        mut lhs = self.bit_xor()?
        while self.eat_punct("|"):
            lhs = binary(.BitOr, lhs=lhs, rhs=self.bit_xor()?)
        lhs

    def bit_xor(ref self) -> Expr fails Diagnostic:
        mut lhs = self.bit_and()?
        while self.eat_punct("^"):
            lhs = binary(.BitXor, lhs=lhs, rhs=self.bit_and()?)
        lhs

    def bit_and(ref self) -> Expr fails Diagnostic:
        mut lhs = self.shift()?
        while self.eat_punct("&"):
            lhs = binary(.BitAnd, lhs=lhs, rhs=self.shift()?)
        lhs

    def shift(ref self) -> Expr fails Diagnostic:
        mut lhs = self.sum()?
        while self.at_punct("<<") or self.at_punct(">>"):
            op = BinOp.ShiftLeft if self.advance().tok == .Punct("<<") else BinOp.ShiftRight
            lhs = binary(op, lhs=lhs, rhs=self.sum()?)
        lhs

    def sum(ref self) -> Expr fails Diagnostic:
        mut lhs = self.term()?
        while self.at_punct("+") or self.at_punct("-"):
            op = BinOp.Add if self.advance().tok == .Punct("+") else BinOp.Sub
            lhs = binary(op, lhs=lhs, rhs=self.term()?)
        lhs

    def term(ref self) -> Expr fails Diagnostic:
        mut lhs = self.unary()?
        while True:
            op = term_op(self.peek())
            if op is None:
                break
            _ = self.advance()
            lhs = binary(op, lhs=lhs, rhs=self.unary()?)
        lhs

    def unary(ref self) -> Expr fails Diagnostic:
        start = self.span()
        if self.eat_punct("-"):
            operand = self.unary()?
            return Expr(kind=.Unary(.Neg, operand), span=start.to(operand.span))
        if self.eat_punct("~"):
            operand = self.unary()?
            return Expr(kind=.Unary(.BitNot, operand), span=start.to(operand.span))
        base = self.postfix()?
        if self.eat_punct("**"):
            return binary(.Pow, lhs=base, rhs=self.unary()?)
        base

    def postfix(ref self) -> Expr fails Diagnostic:
        mut expr = self.atom()?
        while True:
            if self.eat_punct("("):
                args = self.call_args()?
                span = expr.span.to(self.expect_punct(")")?)
                expr = Expr(kind=.Call(expr, args), span=span)
            elif self.eat_punct("."):
                name = self.field_name("a name after `.`")?
                expr = Expr(kind=.Attr(expr, name, optional=False), span=expr.span.to(self.prev_span()))
            elif self.eat_punct("["):
                expr = self.index(expr)?
            elif self.eat_punct("?"):
                mut context = None
                if self.eat_keyword("from"):
                    context = self.postfix()?
                expr = Expr(kind=.Try(expr, context), span=expr.span.to(self.prev_span()))
            else:
                break
        expr

    ## `object[index]` or a slice `object[start:end]`, after the `[`.
    def index(ref self, object: Expr) -> Expr fails Diagnostic:
        mut start: Expr? = None
        if not self.at_punct(":"):
            first = self.expr()?
            start = first
            # `object[a, b]` indexes with the tuple `(a, b)`.
            if self.at_punct(","):
                mut items = [first]
                while self.eat_punct(",") and not self.at_punct("]"):
                    items.append(self.expr()?)
                mut span = self.prev_span()
                for item in items:
                    span = span.to(item.span)
                start = Expr(kind=.Tuple(items), span=span)
        is_slice = self.eat_punct(":")
        mut end = None
        if is_slice and not self.at_punct("]"):
            end = self.expr()?
        span = object.span.to(self.expect_punct("]")?)
        if is_slice:
            return Expr(kind=.Slice(object, start=start, end=end), span=span)
        if start is None:
            fail self.unexpected("an index")
        Expr(kind=.Index(object, index=start), span=span)

    ## Arguments up to (not including) `)`. A single argument followed by `for` is a generator
    ## expression, as in `sum(x * x for x in xs)`.
    def call_args(ref self) -> list[Arg] fails Diagnostic:
        mut args = []
        while not self.at_punct(")"):
            is_mut = self.eat_ref("an argument")
            mut name = None
            if not is_mut and self.peek_at(1) == .Punct("=") and (is_name(self.peek()) or is_field_word(self.peek())):
                name = self.field_name("an argument name")?
                self.pos += 1
            mut value = self.expr()?
            if args.len() == 0 and name is None and not is_mut and self.at_keyword("for"):
                value = self.comprehension(.Generator, elem=value, value=None)?
            args.append(Arg(name=name, is_mut=is_mut, value=value))
            if not self.eat_punct(","):
                break
        args

    ## The `for names in iter if cond` part of a comprehension, after its element.
    def comprehension(ref self, kind: CompKind, elem: Expr, value: Expr?) -> Expr fails Diagnostic:
        _ = self.advance()
        names = self.loop_names()?
        iter = self.or_expr()?
        mut cond = None
        if self.eat_keyword("if"):
            cond = self.or_expr()?
        span = elem.span.to(self.prev_span())
        Expr(kind=.Comprehension(kind, elem=elem, value=value, names=names, iter=iter, cond=cond), span=span)

    def atom(ref self) -> Expr fails Diagnostic:
        token = self.advance()
        span = token.span
        kind = match token.tok:
            case .Int(value): ExprKind.Int(value)
            case .Float(value): ExprKind.Float(value)
            case .Duration(nanos): ExprKind.Duration(nanos)
            case .Str(text): ExprKind.Str(text)
            case .FStr(parts): ExprKind.FStr(fstring_parts(parts)?)
            case .TStr(parts): return template(parts, span)?
            case .Name(name): ExprKind.Name(name)
            case .Keyword(word): self.keyword_atom(word, span)?
            case .Punct(text):
                if text == "(":
                    return self.parenthesized(span)?
                if text == "[":
                    return self.list(span)?
                if text == "{":
                    return self.braces(span)?
                if text != ".":
                    self.pos -= 1
                    fail Diagnostic(message=f"expected a value, found `{text}`", span=span)
                ExprKind.Variant(self.name("an enum case after `.`")?)
            case other:
                fail Diagnostic(message=f"expected a value, found {describe(other)}", span=span)
        Expr(kind=kind, span=span.to(self.prev_span()))

    ## `True`, `False` or `None`, after the keyword. Any other keyword can't start a value.
    def keyword_atom(ref self, word: str, span: Span) -> ExprKind fails Diagnostic:
        match word:
            case "True": .Bool(True)
            case "False": .Bool(False)
            case "None": .Nothing
            case _:
                if is_reserved(word):
                    self.pos -= 1
                    fail self.reserved(word)
                fail Diagnostic(message=f"expected a value, found `{word}`", span=span)

    ## `(expr)`, or a tuple: `()`, `(a,)`, `(a, b)`.
    def parenthesized(ref self, start: Span) -> Expr fails Diagnostic:
        mut items = []
        mut trailing_comma = False
        while not self.at_punct(")"):
            item = self.expr()?
            # `(x for x in xs)`: a generator, to keep and use later.
            if items.len() == 0 and self.at_keyword("for"):
                made = self.comprehension(.Generator, elem=item, value=None)?
                return Expr(kind=made.kind, span=start.to(self.expect_punct(")")?))
            items.append(item)
            trailing_comma = self.eat_punct(",")
            if not trailing_comma:
                break
        span = start.to(self.expect_punct(")")?)
        if items.len() == 1 and not trailing_comma:
            return items[0]
        Expr(kind=.Tuple(items), span=span)

    def list(ref self, start: Span) -> Expr fails Diagnostic:
        mut items = []
        while not self.at_punct("]"):
            item = self.expr()?
            if items.len() == 0 and self.at_keyword("for"):
                comprehension = self.comprehension(.List, elem=item, value=None)?
                return Expr(kind=comprehension.kind, span=start.to(self.expect_punct("]")?))
            items.append(item)
            if not self.eat_punct(","):
                break
        span = start.to(self.expect_punct("]")?)
        Expr(kind=.List(items), span=span)

    ## `{}` (an empty dict), `{k: v, ...}`, `{a, b}`, or a dict or set comprehension.
    def braces(ref self, start: Span) -> Expr fails Diagnostic:
        if self.at_punct("}"):
            return Expr(kind=.Dict([]), span=start.to(self.advance().span))
        first = self.expr()?
        is_dict = self.eat_punct(":")
        mut first_value = None
        if is_dict:
            first_value = self.expr()?
        if self.at_keyword("for"):
            kind = CompKind.Dict if is_dict else CompKind.Set
            comprehension = self.comprehension(kind, elem=first, value=first_value)?
            return Expr(kind=comprehension.kind, span=start.to(self.expect_punct("}")?))
        if first_value is not None:
            mut pairs = [(first, first_value)]
            while self.eat_punct(",") and not self.at_punct("}"):
                key = self.expr()?
                _ = self.expect_punct(":")?
                pairs.append((key, self.expr()?))
            return Expr(kind=.Dict(pairs), span=start.to(self.expect_punct("}")?))
        mut items = [first]
        while self.eat_punct(",") and not self.at_punct("}"):
            items.append(self.expr()?)
        Expr(kind=.Set(items), span=start.to(self.expect_punct("}")?))

## The comparison that `first` (and `second`, for `not in` and `is not`) start, if any.
def comparison_op(first: Tok, second: Tok) -> BinOp?:
    match first:
        case .Punct("=="): .Eq
        case .Punct("!="): .NotEq
        case .Punct("<"): .Lt
        case .Punct("<="): .LtEq
        case .Punct(">"): .Gt
        case .Punct(">="): .GtEq
        case .Keyword("in"): .In
        case .Keyword("not"): .NotIn if second == .Keyword("in") else None
        case .Keyword("is"): .IsNot if second == .Keyword("not") else .Is
        case _: None

def term_op(tok: Tok) -> BinOp?:
    match tok:
        case .Punct("*"): .Mul
        case .Punct("/"): .Div
        case .Punct("//"): .FloorDiv
        case .Punct("%"): .Mod
        case _: None

def binary(op: BinOp, lhs: Expr, rhs: Expr) -> Expr:
    Expr(kind=.Binary(op, lhs=lhs, rhs=rhs), span=lhs.span.to(rhs.span))

## Parses each `{expression}` of an f-string, from the source the lexer kept.
def fstring_parts(parts: list[FPart]) -> list[FStrPart] fails Diagnostic:
    mut parsed = []
    for part in parts:
        match part:
            case .Text(text): parsed.append(FStrPart.Text(text))
            case .Code(source, offset, spec):
                parsed.append(FStrPart.Code(interpolated(source, offset, "f-string")?, spec))
    parsed

## The expression written in an f-string's or template's `{}`, from the source the lexer kept.
def interpolated(source: str, offset: int, what: str) -> Expr fails Diagnostic:
    if source.strip() == "":
        fail Diagnostic(
            message=f"this {what} has an empty `{{}}`",
            span=Span(start=offset, end=offset + 1),
            help="put an expression inside, or write `{{` for a literal brace",
        )
    # Lexed on its own, a leading space would read as indentation.
    code = source.lstrip()
    skipped = byte_length(source[:source.len() - code.len()])
    mut parser = Parser.over(lex(code, offset + skipped)?)
    expr = parser.expr()?
    _ = parser.eat(.Newline)
    if not parser.at(.Eof):
        fail parser.unexpected("`}`")
    parser.check_old_mut()?
    expr

## A template string's parts, written in as the `Template` call that builds it, holding the
## text between each `{}` and each value apart. Mirrors `crates/syntax/src/parser/template.rs`.
def template(parts: list[FPart], span: Span) -> Expr fails Diagnostic:
    mut strings = list[str]()
    mut values = list[Expr]()
    mut expressions = list[str]()
    mut specs = list[str]()
    mut text = ""
    for part in parts:
        match part:
            case .Text(more): text += more
            case .Code(source, offset, spec):
                strings.append(text)
                text = ""
                values.append(interpolated(source, offset, "template")?)
                expressions.append(source)
                specs.append(spec else "")
    strings.append(text)
    mut made = Made(span=span)
    # The values come first, so what's said about them, like a list that mixes types, points at
    # nearly the whole string.
    values_list = Expr(kind=.List(values), span=made.next())
    callee = Expr(kind=.Name("Template"), span=made.next())
    strings_list = made.texts(strings)
    expressions_list = made.texts(expressions)
    specs_list = made.texts(specs)
    args = [
        Arg(name="strings", is_mut=False, value=strings_list),
        Arg(name="values", is_mut=False, value=values_list),
        Arg(name="expressions", is_mut=False, value=expressions_list),
        Arg(name="format_specs", is_mut=False, value=specs_list),
    ]
    Expr(kind=.Call(callee, args), span=span)

## Spans for the expressions a template string is written in as, which nothing's written for:
## first those starting where it starts, longest first, then those ending where it ends, then
## the empty ones at each end. None is the span of anything written in the string's `{}`s.
struct Made:
    span: Span
    at = 0

    def next(ref self) -> Span:
        start = self.span.start
        end = self.span.end
        inner = max(end - start - 1, 0)
        at = self.at
        self.at += 1
        if at < inner:
            return Span(start=start, end=start + inner - at)
        if at < 2 * inner:
            return Span(start=start + 1 + at - inner, end=end)
        if at == 2 * inner:
            return Span(start=start, end=start)
        Span(start=end, end=end)

    ## A list of text written in the source, as string literals.
    def texts(ref self, texts: list[str]) -> Expr:
        span = self.next()
        mut items = list[Expr]()
        for text in texts:
            items.append(Expr(kind=.Str(text), span=self.next()))
        Expr(kind=.List(items), span=span)

## Whether a statement leaves where it is: what an `else:` block has to end with.
def leaves_by(kind: StmtKind) -> bool:
    match kind:
        case .Continue | .Break | .Return(_) | .Fail(_): True
        case _: False

## What a default that leaves parses to: a `match` with one case, holding the statements that
## leave, which every engine and analysis already follows out of the expression.
def leaving_match(start: Span, body: list[Stmt], span: Span, failure: str? = None) -> Expr:
    pattern = Pattern.Bind(failure) if failure is not None else Pattern.Wildcard
    arm = MatchArm(pattern=pattern, guard=None, body=body, span=span)
    # Expressions are told apart by span, and nothing's written here, so it's empty.
    subject = Expr(kind=.Bool(False), span=Span(start=start.start, end=start.start))
    Expr(kind=.Match(subject, [arm]), span=span)
