# `head + body`, joining a 20-byte and a 30-byte str, done OPS times on inputs that vary.
# `fennec-bench ops` counts its instructions per operation beside its Rust twin's.

OPS = 20_000

def main(stdout: Stdout, args: Args):
    # No arguments are given, so this is 0, but the compiler can't know it.
    shift = len(args)
    heads = [f"HTTP/1.1 {200 + i} OK\r\n" for i in range(shift, shift + 16)]
    bodies = [f"{{\"id\": {i}, \"name\": \"fox-{i}\"}}" for i in range(shift, shift + 16)]
    mut total = 0
    for at in range(OPS):
        joined = heads[(at + shift) % 16] + bodies[(at + shift + 3) % 16]
        total += len(joined)
    stdout.print(total)
    return
