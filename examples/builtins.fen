# decision: `int(text)` and `float(text)` fail with `InvalidValue`

from std.math import PI, ceil, cos, floor, sin, sqrt

def square(n: int) -> int:
    return n * n

def main(stdout: Stdout):
    # Converting between numbers. `int` truncates toward zero.
    stdout.print(float(2), 0.5, int(2.9), int(-2.9), int(-9223372036854775808.0), 7)
    # Text is read as a number with `.parse`, which can fail with an `InvalidValue`: a conversion
    # like `int(2.9)` never fails.
    float_value = float.parse("2.5") except InvalidValue(): 0.0
    float_value2 = float.parse(" 1e3 ") except InvalidValue(): 0.0
    int_value = int.parse(" 42 ") except InvalidValue(): 0
    int_value2 = int.parse("4x2") except InvalidValue(): -1
    stdout.print(float_value, float_value2, int_value, int_value2)
    # `except why:` names the failure; its block gives a value in its place, or leaves.
    twelve = int.parse("twelve") except why:
        stdout.print(why.message)
        12
    stdout.print(twelve)

    # Rounding goes to the even neighbour on a tie, as in Python.
    stdout.print(abs(-3), abs(-2.5), abs(4))
    stdout.print(round(2.5), round(3.5), round(-2.5), round(3.14159, 2), round(1234.5, -2))
    # To any place, it's the same number wherever the program runs: far past the decimal point
    # one way, and to tens of millions of millions and beyond the other.
    stdout.print([round(0.12345678901234568, places) for places in [1, 5, 9, 15, 16, 17, 22]])
    stdout.print([
        round(1.2345678901234567e40, places) for places in [-22, -23, -33, -34, -37, -39, -40]
    ])
    stdout.print(floor(2.7), floor(-2.5), ceil(2.1), ceil(-2.5))
    stdout.print(sqrt(16), sqrt(2.25), sqrt(0), sin(0), cos(0), sin(PI / 2.0), cos(PI))

    # Walking through collections.
    stdout.print(reversed("fennec"), reversed([1, 2, 3]), reversed((1, 2)))
    no_numbers: set[int] = set()
    stdout.print(no_numbers, set([3, 1, 3, 2, 1]), len(set("hello")))
    stdout.print(
        range(3),
        range(2, 5),
        range(10, 0, -3),
        range(6, 0, -2),
        range(0, 10, 4),
        range(5, 5),
        range(5, 0),
    )
    stdout.print(sorted([3, 1, 2]), min(3, 1, 2), max([3, 1, 2]), sum([1, 2, 3]), sum([0.5, 1.5]))
    stdout.print(list("abc"), enumerate(["a", "b"]), zip([1, 2], ["a", "b"]))
    stdout.print(any([False, True]), all([True, False]), all([]), any([]))

    # Calls that return don't count toward the depth limit.
    stdout.print(sum(square(n) for n in range(2000)))
