# A program's own type takes the place of a standard library type of the same name.

struct Grid:
    cells: list[int]
    width: int

    def [](self, at: (int, int)) -> int:
        x, y = at
        self.cells[y * self.width + x]

struct Tree:
    label: str

    def describe(self) -> str:
        f"a tree called {self.label}"

struct Deque:
    items: list[int]

    def append(mut self, item: int):
        self.items.append(item)

    def len(self) -> int:
        self.items.len()

# `Duration`'s methods compile natively in the library and here, so both can't be kept.
struct Duration:
    ticks: int

    def as_millis(self) -> float:
        float(self.ticks) * 2.0

    def +(self, other: Duration) -> Duration:
        Duration(ticks=self.ticks + other.ticks)

def main(stdout: Stdout):
    grid = Grid(cells=[1, 2, 3, 4], width=2)
    stdout.print(grid[(1, 1)])
    stdout.print(Tree(label="oak").describe())
    mut queue = Deque(items=[])
    queue.append(5)
    queue.append(6)
    stdout.print(queue.len(), queue.items)
    both = Duration(ticks=2) + Duration(ticks=3)
    stdout.print(both.ticks, both.as_millis())
