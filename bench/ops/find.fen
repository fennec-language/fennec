# `line.find(": ")` on a header line of about 20 bytes, done OPS times on inputs that vary.
# `fennec-bench ops` counts its instructions per operation beside its Rust twin's.

OPS = 20_000

def main(stdout: Stdout, args: Args):
    # No arguments are given, so this is 0, but the compiler can't know it.
    shift = len(args)
    lines = [f"Header-{i}: value-{i * 7}" for i in range(shift, shift + 16)]
    mut total = 0
    for at in range(OPS):
        found = lines[(at + shift) % 16].find(": ") else -1
        total += found
    stdout.print(total)
    return
