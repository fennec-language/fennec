## Filling a `Table`, then freeing a slot in five and filling those again, as units come and go.

from std.collections import Id, Table

struct Unit:
    x: int
    hp: int

def main(stdout: Stdout):
    mut units = Table[Unit]()
    mut ids: list[Id[Unit]] = []
    for i in range(200_000):
        ids.append(units.add(Unit(x=i, hp=1)))
    for round in range(4):
        mut at = round
        while at < len(ids):
            _ = units.remove(ids[at])
            at += 5
        at = round
        while at < len(ids):
            ids[at] = units.add(Unit(x=at, hp=round))
            at += 5
    mut total = 0
    for unit in units.values():
        total += unit.x + unit.hp
    stdout.print(len(units), total)
