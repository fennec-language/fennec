## Lists, dicts and strings held as objects, read and changed where they are.

struct Shelf:
    items: list[int]
    counts: dict[str, int]
    name: str

def first(shelf: Shelf) -> int:
    return shelf.items[0]

def main(stdout: Stdout):
    mut shelf = Shelf(items=[3, 1, 2], counts={"a": 1}, name="oak")
    stdout.print(shelf.items[1], len(shelf.items), shelf.items[-1])
    stdout.print(shelf.counts["a"], len(shelf.counts), (shelf.counts.get("b") else 7))
    stdout.print(len(shelf.name), shelf.name[0], shelf.name.upper())

    shelf.items.append(9)
    shelf.items[0] = 4
    shelf.counts["b"] = 2
    stdout.print(shelf.items, shelf.counts, first(shelf))

    kept = shelf.items
    shelf.items.append(5)
    stdout.print(kept, shelf.items)

    grid = [[1, 2], [3, 4]]
    stdout.print(grid[1][0], len(grid[0]))
    for row in grid:
        stdout.print(row[1], len(row))

    dicts = [{"x": 1}, {"y": 2}]
    stdout.print(
        (dicts[1].get("y") else 0),
        (dicts[0].get("y") else 8),
        dicts[0]["x"],
        len(dicts[1]),
    )
    for key in dicts[0]:
        stdout.print(key)
    words = ["ab", "cde"]
    stdout.print(len(words[1]), words[1][2])
