# Property tests that fail on purpose, for tests/cli.rs: what each reports shows how inputs
# are generated and shrunk. Inputs come from a seed derived from each test's name, so these
# failures replay exactly.

error Oops:
    reason: str

struct Box:
    label = "box"
    size: int

enum Coin:
    Heads
    Tails(times: int)

test "ints stay below ten" for n: int:
    assert n < 10

test "floats are whole" for x: float:
    assert x == float(int(x))

test "floats stay small" for x: float:
    assert x < 2.0

test "words are short" for word: str:
    assert len(word) < 3

test "lists are short" for items: list[int]:
    assert len(items) < 2

test "grids are short" for grid: list[list[str]]:
    assert len(grid) < 3

test "flags and numbers" for pair: (bool, int):
    flag, number = pair
    assert flag or number < 500

test "maybe nothing" for pair: (int?, int):
    value, _ = pair
    assert value is None

test "boxes are small" for box: Box:
    assert box.size < 3

test "coins land heads" for coin: Coin:
    assert coin == Coin.Heads

test "big numbers are odd" for n: int:
    assert n < 100 or n % 2 == 1

test "failing with an error":
    fail Oops("broken")

test "a widget" for widget: Widget:
    pass

test "this one passes":
    assert True
