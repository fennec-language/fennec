# decision: JSON and TOML read into plain values.
# decision: Bad text fails with `ParseError`.

from std import json

struct Settings:
    volume = 0.8
    fullscreen = False
    keys = ["w", "a", "s", "d"]

struct Player:
    name: str
    level: int
    speed: float
    items: list[str]
    pet: str?
    alive: bool

def describe(text: str) -> str:
    numbers = json.loads[list[float]](text) else as why:
        match why:
            case ParseError(message=message):
                return f"couldn't read it: {message}"
    f"read {json.dumps(numbers)}"

struct Point:
    x: int
    y: int

## Why `run` fails, or "" if it doesn't.
def why_not[T](run: () -> T fails ParseError) -> str:
    _ = run() else as why:
        return why.message
    ""

test "arrays and objects may nest 500 deep, and no deeper"():
    too_deep = "arrays and objects nest more than 500 deep here, at line 1, column 501"
    # 500 deep is read, and only then found not to be a list of floats.
    assert (
        why_not(() => json.loads[list[float]]("[" * 500 + "]" * 500)?)
        == ("`[0]` should be a float, but it's a list")
    )
    assert why_not(() => json.loads[list[float]]("[" * 501 + "]" * 501)?) == too_deep
    objects = "{\"a\": " * 500 + "1" + "}" * 500
    assert why_not(() => json.loads[list[float]](objects)?).startswith(
        "the text should be a list[float]",
    )
    assert why_not(() => json.loads[list[float]]("{\"a\": " * 501 + "1" + "}" * 501)?).startswith(
        "arrays and objects nest more than 500 deep here",
    )

test "a value passed over counts toward how deep JSON may nest"():
    # The object around it is one deep, so 499 arrays inside it make 500.
    fits = "{\"x\": 1, \"y\": 2, \"z\": " + "[" * 499 + "]" * 499 + "}"
    assert json.loads[Point](fits, extra=.Ignore)? == Point(x=1, y=2)
    deeper = "{\"x\": 1, \"y\": 2, \"z\": " + "[" * 500 + "]" * 500 + "}"
    assert why_not(() => json.loads[Point](deeper, extra=.Ignore)?).startswith(
        "arrays and objects nest more than 500 deep here",
    )

def main(stdout: Stdout):
    text = "\n".join([
        "{",
        "  \"name\": \"Ash\",",
        "  \"level\": 7,",
        "  \"speed\": 2.5,",
        "  \"items\": [\"torch\", \"rope\"],",
        "  \"pet\": null,",
        "  \"alive\": true",
        "}",
    ])
    player = json.loads[Player](text)?
    stdout.print(player.name, "is level", player.level + 1, "and moves at", player.speed)
    for item in player.items:
        stdout.print("carries", item)
    stdout.print(player.pet is None, player.alive)

    stdout.print(json.dumps(player))
    stdout.print(json.dumps(Settings(), indent=2))
    stdout.print(json.dumps((1, "two", 3.0, None, (4, 5), {"6": [6], "7": []})))
    stdout.print(json.dumps("quotes \" and \\ and\nnew lines"))
    stdout.print(json.loads[str]("\"\\u00e9t\\u00e9\"")?)
    settings = json.loads[Settings](json.dumps(Settings()))?
    stdout.print(settings == json.loads[Settings](json.dumps(Settings(), indent=4))?)
    loud = json.loads[Settings]("{\"volume\": 1}")?
    stdout.print(loud.volume, loud.keys)

    stdout.print(describe("[1, 2.5e3, -0.5]"))
    stdout.print(describe("[1, \"two\"]"))
    stdout.print(describe("[1, 2,]"))
    stdout.print(describe("{\"a\": 1,\n \"b\" 2}"))
    stdout.print(describe("\"never ends"))
    stdout.print(describe("tru"))
    _ = json.loads[list[int]]("[\n  1,\n  oops\n]") else as why:
        stdout.print(f"the problem is on line {why.line}, column {why.column}")
        []
