from std import base64
from std.collections import Id
from std.intrinsics import id_key, new_tag, stop, text_byte, text_escape_at, text_of_code, text_part, text_plain_end, text_same_at, text_size, type_name
from std.io import Reader, Writer, read_all
from std.string import cut_input, quoted_input

## How field names are spelled in JSON, set with `names=`. `.SnakeCase` writes them as the
## program does. The keys of a dict are written as they are.
export enum JsonNames:
    SnakeCase
    CamelCase
    PascalCase
    KebabCase

## What reading does with a key no field has, set with `extra=`.
export enum JsonExtra:
    Error
    Ignore

## A field's name as `names` spells it. Leading underscores stay as they are.
def spelled_as(name: str, names: JsonNames) -> str:
    size = text_size(name)
    mut start = 0
    while text_byte(name, start) == 95:
        start += 1
    mut out = text_part(name, 0, start)
    mut word = 0
    mut at = start
    while at <= size:
        if at == size or text_byte(name, at) == 95:
            if at > start:
                part = text_part(name, start, at)
                match names:
                    case .SnakeCase:
                        return name
                    case .KebabCase:
                        out += "-" if word > 0 else ""
                        out += part
                    case .CamelCase:
                        out += capital(part) if word > 0 else part
                    case .PascalCase:
                        out += capital(part)
                word += 1
            start = at + 1
        at += 1
    return out

def capital(word: str) -> str:
    return word[:1].upper() + word[1:]

## A float as JSON writes it: an exponent has no `+` and no leading zeros.
def float_text(value: float) -> str:
    text = str(value)
    if value != value or value - value != 0.0: return text
    if (
        value != 0.0
        and not (value >= 0.0001 and value < 10000000000000000.0)
        and not (value <= -0.0001 and value > -10000000000000000.0)
    ):
        mut at = 0
        while text_byte(text, at) != 101:
            at += 1
        mut digits = at + 1
        negative = text_byte(text, digits) == 45
        if negative or text_byte(text, digits) == 43:
            digits += 1
        while text_byte(text, digits) == 48 and digits + 1 < text_size(text):
            digits += 1
        lead = text_part(text, 0, at)
        sign = "e-" if negative else "e"
        return f"{lead}{sign}{text_part(text, digits, text_size(text))}"
    return text

## How a byte JSON can't hold as it is gets written.
def escape_of(b: int) -> str:
    match b:
        case 34:
            return "\\\""
        case 92:
            return "\\\\"
        case 10:
            return "\\n"
        case 13:
            return "\\r"
        case 9:
            return "\\t"
        case 8:
            return "\\b"
        case 12:
            return "\\f"
        case _:
            digits = "0123456789abcdef"
            return f"\\u00{digits[b // 16]}{digits[b % 16]}"

## What a dict's key is, for deciding how to write it: JSON's object keys are text, and an int
## is written as its digits. Anything else makes the dict an array of `[key, value]` pairs.
struct JsonKey:
    text = ""
    fits = False

    def int(ref self, value: int):
        self.text = str(value)
        self.fits = True

    def float(ref self, value: float):
        pass

    def bool(ref self, value: bool):
        pass

    def text(ref self, value: str):
        self.text = value
        self.fits = True

    def bytes(ref self, value: bytes):
        pass

    def none(ref self):
        pass

    def value[T: Serializable](ref self, x: T):
        pass

    def sequence[T: Serializable](ref self, items: list[T]):
        pass

    def map[K: Serializable, V: Serializable](ref self, pairs: list[(K, V)]):
        pass

    def record(ref self, name: str, count: int):
        pass

    def field[T: Serializable](ref self, name: str, x: T):
        pass

    def renamed[T: Serializable](ref self, name: str, x: T):
        pass

    def items(ref self, name: str, count: int):
        pass

    def item[T: Serializable](ref self, x: T):
        pass

    def end_items(ref self):
        pass

    def end(ref self):
        pass

    def enum_case(ref self, name: str, case_name: str, at: int):
        pass

    def case_record(ref self, name: str, case_name: str, at: int, count: int):
        pass

    def member(ref self, name: str, at: int):
        self.fits = False

    def end_member(ref self):
        pass

    def table[T: Serializable](ref self, kind: str, tag: int, ids: list[Id[T]], items: list[T]):
        pass

    def exact(self) -> bool:
        return False

    def slots[T: Serializable](ref self, kind: str, tag: int, slots: list[int], items: list[T]):
        # Never asked for: `exact` says no.
        pass

    def id(ref self, kind: str, key: int, tag: int):
        pass

    def some[T: Serializable](ref self, x: T):
        pass

## Empty values for what a reader or a writer uses only now and then: an explained failure's path,
## `Id`s and `Table`s, tags and tuples. A reader or writer starts with these, shared, rather than
## making its own, and makes its own only the first time it writes one, as any shared value does
## when it's changed. So a plain read or write makes none: each would cost an allocation.
NO_PARTS = list[str]()
NO_FIELDS = list[(str, str)]()
NO_COUNTS = list[int]()
NO_SEEN = list[(str, str, int)]()
NO_TAGS = dict[str, int]()
NO_TUPLES = list[(str, int, int, int)]()
NO_TABLES = dict[str, dict[(int, int), int]]()

## Writes JSON into one growing text. What's added to it is put in a name first: added straight
## from a call or an operator, the text was copied whole each time, so writing grew with the
## square of what was written.
struct JsonWriter:
    _text = ""
    _names = JsonNames.SnakeCase
    _indent = -1
    _depth = 0
    _first = True
    ## Where each `Id` is in its `Table`, by the name of its type and its `id_key`, once
    ## `TableFinder` has been through what's written. Until then an `Id` asks for it.
    _tables = NO_TABLES
    _found = False
    _wants_tables = False
    _optional = False
    ## Whether a float JSON can't write, NaN or infinity, came up. Which one and where it is are
    ## found apart from writing, so writing what JSON can hold costs nothing more.
    _unwritable = False

    def written(self) -> str:
        return self._text

    def int(ref self, value: int):
        piece = str(value)
        self._text += piece

    def float(ref self, value: float):
        # NaN and infinity are the floats less themselves isn't 0.
        if value - value != 0.0:
            self._unwritable = True
            return
        piece = float_text(value)
        self._text += piece

    def bool(ref self, value: bool):
        piece = "true" if value else "false"
        self._text += piece

    def text(ref self, value: str):
        self._text += "\""
        size = text_size(value)
        mut start = 0
        # Each run of bytes written as they are is found in one go.
        mut at = text_escape_at(value, 0)
        while at < size:
            b = text_byte(value, at)
            if b == 194 and (text_byte(value, at + 1) < 128 or text_byte(value, at + 1) > 159):
                at = text_escape_at(value, at + 2)
            else:
                piece = text_part(value, start, at)
                self._text += piece
                if b == 194:
                    piece = escape_of(text_byte(value, at + 1))
                    self._text += piece
                    at += 1
                else:
                    piece = escape_of(b)
                    self._text += piece
                at += 1
                start = at
                at = text_escape_at(value, at)
        if start == 0:
            self._text += value
        else:
            piece = text_part(value, start, size)
            self._text += piece
        self._text += "\""

    def bytes(ref self, value: bytes):
        self.text(base64.encode(value))

    def none(ref self):
        self._text += "null"

    def value[T: Serializable](ref self, x: T):
        x.serialize(ref self)

    def _open(ref self, opening: str):
        self._text += opening
        self._depth += 1
        self._first = True
        self._optional = False

    def table[T: Serializable](ref self, kind: str, tag: int, ids: list[Id[T]], items: list[T]):
        self.sequence(items)

    def exact(self) -> bool:
        return False

    def slots[T: Serializable](ref self, kind: str, tag: int, slots: list[int], items: list[T]):
        # Never asked for: `exact` says no.
        pass

    def id(ref self, kind: str, key: int, tag: int):
        optional = self._optional
        self._optional = False
        if not self._found:
            self._wants_tables = True
            self._text += "0"
            return
        positions = self._tables.get(kind) else dict[(int, int), int]()
        position = positions.get((key, tag)) else -1
        if position < 0 and optional:
            self._text += "null"
        else:
            piece = str(position)
            self._text += piece

    def some[T: Serializable](ref self, x: T):
        self._optional = True
        x.serialize(ref self)
        self._optional = False

    def _close(ref self, closing: str):
        self._depth -= 1
        if self._indent >= 0 and not self._first:
            self._new_line()
        self._text += closing
        self._first = False

    def _entry(ref self):
        if self._first:
            self._first = False
        elif self._indent < 0:
            self._text += ", "
        else:
            self._text += ","
        if self._indent >= 0:
            self._new_line()

    ## A new line, indented as deep as what's being written, for output written with `indent`.
    ## It's apart so that output on one line, as most is, has none of its work.
    def _new_line(ref self):
        self._text += "\n"
        piece = " " * (self._indent * self._depth)
        self._text += piece

    def sequence[T: Serializable](ref self, items: list[T]):
        self._open("[")
        for item in items:
            self._entry()
            item.serialize(ref self)
        self._close("]")

    def map[K: Serializable, V: Serializable](ref self, pairs: list[(K, V)]):
        mut as_object = True
        if len(pairs) > 0:
            mut first = JsonKey()
            pairs[0][0].serialize(ref first)
            as_object = first.fits
        if as_object:
            self._open("{")
            for key, value in pairs:
                mut name = JsonKey()
                key.serialize(ref name)
                self._entry()
                self.text(name.text)
                self._text += ": "
                value.serialize(ref self)
            self._close("}")
        else:
            self._open("[")
            for key, value in pairs:
                self._entry()
                self._open("[")
                self._entry()
                key.serialize(ref self)
                self._entry()
                value.serialize(ref self)
                self._close("]")
            self._close("]")

    def record(ref self, name: str, count: int):
        self._open("{")

    def field[T: Serializable](ref self, name: str, x: T):
        # Written on one line with names as they are, as most output is, a field takes three pieces.
        if self._indent < 0 and self._names == .SnakeCase:
            if self._first:
                self._first = False
                piece = "\"" + name + "\": "
                self._text += piece
            else:
                piece = ", \"" + name + "\": "
                self._text += piece
            x.serialize(ref self)
            return
        self._entry()
        self._text += "\""
        match self._names:
            case .SnakeCase:
                self._text += name
            case _:
                piece = spelled_as(name, self._names)
                self._text += piece
        piece = "\": "
        self._text += piece
        x.serialize(ref self)

    def renamed[T: Serializable](ref self, name: str, x: T):
        self._entry()
        self.text(name)
        self._text += ": "
        x.serialize(ref self)

    def items(ref self, name: str, count: int):
        self._open("[")

    def item[T: Serializable](ref self, x: T):
        self._entry()
        x.serialize(ref self)

    def end_items(ref self):
        self._close("]")

    def end(ref self):
        self._close("}")

    def enum_case(ref self, name: str, case_name: str, at: int):
        self._text += "\""
        self._text += case_name
        self._text += "\""

    def case_record(ref self, name: str, case_name: str, at: int, count: int):
        self._open("{")
        self._entry()
        self._text += "\""
        self._text += case_name
        piece = "\": "
        self._text += piece
        self._open("{")

    def member(ref self, name: str, at: int):
        self._open("{")
        self._entry()
        self.text(name)
        self._text += ": "

    def end_member(ref self):
        self._close("}")

## `value` as JSON text, through its own `def serialize`.
## Native code runs `json.dumps` through this. Its options' defaults are `None` and `-1`, since the
## default a call leaves out is written into the program calling it, which may not import `JsonNames`.
export def native_dumps[T: Serializable](value: T, names: JsonNames? = None, indent = -1) -> str:
    spelled = names else JsonNames.SnakeCase
    mut out = JsonWriter(_names=spelled, _indent=indent)
    value.serialize(ref out)
    if out._unwritable:
        stop_at_unwritable(value)
    if not out._wants_tables: return out.written()
    # It holds `Id`s, so where each one's item is comes first, and every one's checked.
    tables = tables_in(value)
    mut again = JsonWriter(_names=spelled, _indent=indent, _tables=tables, _found=True)
    value.serialize(ref again)
    return again.written()

## Stops the program at the first float in `value` that JSON can't write, NaN or infinity, saying
## where it is. It's a bug in the program, as a NaN reaching `int()` is, and not a failure, since
## everything else `dumps` is given can be written.
def stop_at_unwritable[T: Serializable](value: T):
    mut finder = TableFinder(_floats=True)
    value.serialize(ref finder)
    problem = finder.problem()
    stop(problem if problem != "" else "JSON can't write NaN or infinity")

## Where each `Id` in `value` is in its `Table`, by the name of its type and its `id_key`. A value
## with an `Id` that can't be saved stops the program, saying why and where.
def tables_in[T: Serializable](value: T) -> dict[str, dict[(int, int), int]]:
    return found_tables(value, False).positions()

## What's found going through `value` for its `Table`s and `Id`s, saved slot for slot when `exact`
## is true. A value with an `Id` that can't be saved stops the program, saying why and where.
def found_tables[T: Serializable](value: T, exact: bool) -> TableFinder:
    mut finder = TableFinder(_exact=exact)
    value.serialize(ref finder)
    problem = finder.problem()
    if problem != "":
        stop(problem)
    return finder

## How deeply arrays and objects may nest, so bad input can't overflow the stack.
JSON_MOST_DEEP = 500

## What a read that went wrong gives back, with nothing to say yet: the text is read again to
## find what to say, so reading text that's fine pays for none of it.
def no_reason() -> ParseError:
    return ParseError(message="", line=0, column=0)

def article(name: str) -> str:
    first = text_byte(name, 0)
    if (
        first == 97
        or first == 101
        or first == 105
        or first == 111
        or first == 117
        or first == 65
        or first == 69
        or first == 73
        or first == 79
        or first == 85
    ):
        return f"an {name}"
    return f"a {name}"

def powers() -> list[float]:
    return [
        1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0, 100000000.0,
        1000000000.0, 10000000000.0, 100000000000.0, 1000000000000.0, 10000000000000.0,
        100000000000000.0, 1000000000000000.0, 10000000000000000.0, 100000000000000000.0,
        1000000000000000000.0, 10000000000000000000.0, 100000000000000000000.0,
        1000000000000000000000.0, 10000000000000000000000.0,
    ]

POWERS = powers()

## Which of `cases` is named `key`, as a place in it, or -1 for none.
def case_named(key: str, cases: list[(str, bool)]) -> int:
    mut at = 0
    for case_name, _ in cases:
        if case_name == key: return at
        at += 1
    return -1

## `text` as a JSON string, in quotes and escaped, for std's own code that writes JSON by hand.
def quoted(text: str) -> str:
    mut out = JsonWriter()
    out.text(text)
    return out.written()

## The `Id`s and `Table`s a read has seen, each with where it was, for checking once everything's
## been read that each `Id` is in the one `Table` of its type.
struct IdsSeen:
    ## What a message calls everything read: "the text", or "the data".
    _whole = "the text"
    _ids = NO_SEEN
    _tables = NO_SEEN

    def id(ref self, kind: str, at: str, position: int):
        self._ids.append((kind, at, position))

    def table(ref self, kind: str, at: str, count: int):
        self._tables.append((kind, at, count))

    ## What's wrong with the `Id`s and `Table`s read, or "" when nothing is.
    def problem(self) -> str:
        # Nearly always: nothing read was an `Id` or a `Table`, so there's nothing to check.
        if len(self._ids) == 0 and len(self._tables) == 0: return ""
        mut seen = dict[str, str]()
        for kind, at, _ in self._tables:
            if kind in seen:
                return f"{seen[kind]} and {at} are both a `Table[{kind}]`, so an Id can't say which it's in"
            seen[kind] = at
        for kind, at, position in self._ids:
            mut found = False
            for table_kind, table_at, count in self._tables:
                if table_kind != kind: continue
                found = True
                if position >= count:
                    items = "nothing" if count == 0 else (
                        f"only {count}" if count > 1 else "only 1"
                    )
                    return f"{at} is item {position} of {table_at}, which has {items}"
            if not found:
                return f"{at} is an Id, but {self._whole} has no `Table[{kind}]` for it to be in"
        return ""

## Goes through what's being saved for its `Table`s and `Id`s, writing nothing, so each `Id` can
## be written as where its item is, and one that can't be is said with where it is.
struct TableFinder:
    _positions = dict[str, dict[(int, int), int]]()
    _where = dict[str, str]()
    _ids = list[(str, int, int, bool, str)]()
    _tags = dict[str, int]()
    _path = list[str]()
    _problem = ""
    _optional = False
    ## Whether `Table`s are saved slot for slot, so an `Id` whose item has gone is saved as it is.
    _exact = False
    ## Whether a float JSON can't write, NaN or infinity, is the problem, said with where it is.
    _floats = False

    def exact(self) -> bool:
        return self._exact

    ## Where each `Id` is in its `Table`, by the name of its type, then its `id_key` and tag.
    def positions(self) -> dict[str, dict[(int, int), int]]:
        return self._positions

    ## Each `Table`'s tag, by the name of its items' type.
    def tags(self) -> dict[str, int]:
        return self._tags

    def int(ref self, value: int):
        pass

    def float(ref self, value: float):
        if self._floats and self._problem == "" and value - value != 0.0:
            here = place_text(self._path)
            self._problem = f"{here} is {value}, which JSON can't write: it has no NaN or infinity"

    def bool(ref self, value: bool):
        pass

    def text(ref self, value: str):
        pass

    def bytes(ref self, value: bytes):
        pass

    def none(ref self):
        pass

    def value[T: Serializable](ref self, x: T):
        x.serialize(ref self)

    def sequence[T: Serializable](ref self, items: list[T]):
        self._optional = False
        mut at = 0
        for item in items:
            self._path.append(f"[{at}]")
            item.serialize(ref self)
            _ = self._path.pop()
            at += 1

    def map[K: Serializable, V: Serializable](ref self, pairs: list[(K, V)]):
        self._optional = False
        for key, value in pairs:
            mut name = JsonKey()
            key.serialize(ref name)
            self._path.append(f"[{quoted(name.text)}]" if name.fits else "[...]")
            key.serialize(ref self)
            value.serialize(ref self)
            _ = self._path.pop()

    def record(ref self, name: str, count: int):
        self._optional = False

    def field[T: Serializable](ref self, name: str, x: T):
        self._path.append(name)
        x.serialize(ref self)
        _ = self._path.pop()

    def renamed[T: Serializable](ref self, name: str, x: T):
        self.field(name, x)

    def items(ref self, name: str, count: int):
        pass

    def item[T: Serializable](ref self, x: T):
        x.serialize(ref self)

    def end_items(ref self):
        pass

    def end(ref self):
        pass

    def enum_case(ref self, name: str, case_name: str, at: int):
        pass

    def case_record(ref self, name: str, case_name: str, at: int, count: int):
        self._optional = False

    def member(ref self, name: str, at: int):
        self._optional = False
        self._path.append(name)

    def end_member(ref self):
        _ = self._path.pop()

    def table[T: Serializable](ref self, kind: str, tag: int, ids: list[Id[T]], items: list[T]):
        here = place_text(self._path)
        if kind in self._where:
            if self._problem == "":
                self._problem = f"{self._where[kind]} and {here} are both a `Table[{kind}]`, so an Id can't say which it's in"
        else:
            self._where[kind] = here
            self._tags[kind] = tag
            mut positions = dict[(int, int), int]()
            mut at = 0
            for id in ids:
                positions[(id_key(id), tag)] = at
                at += 1
            self._positions[kind] = positions
        self.sequence(items)

    def slots[T: Serializable](ref self, kind: str, tag: int, slots: list[int], items: list[T]):
        here = place_text(self._path)
        if kind in self._where:
            if self._problem == "":
                self._problem = f"{self._where[kind]} and {here} are both a `Table[{kind}]`, so an Id can't say which it's in"
        else:
            self._where[kind] = here
            self._tags[kind] = tag
            self._positions[kind] = dict[(int, int), int]()
        self.sequence(items)

    def id(ref self, kind: str, key: int, tag: int):
        self._ids.append((kind, key, tag, self._optional, place_text(self._path)))
        self._optional = False

    def some[T: Serializable](ref self, x: T):
        self._optional = True
        x.serialize(ref self)
        self._optional = False

    ## What's wrong with saving the `Id`s and `Table`s gone through, or "" when nothing is.
    def problem(self) -> str:
        if self._problem != "": return self._problem
        for kind, key, tag, optional, at in self._ids:
            if kind not in self._positions:
                return f"{at} is an Id, but nothing saved with it is a `Table[{kind}]`"
            if optional: continue
            where = self._where.get(kind) else "its Table"
            if tag != (self._tags.get(kind) else 0):
                return f"{at} is an Id from another `Table[{kind}]` than {where}"
            # Saved slot for slot, an `Id` whose item has gone is saved as it is, still gone.
            positions = self._positions.get(kind) else dict[(int, int), int]()
            if not self._exact and (key, tag) not in positions:
                return f"{at} is an Id of something that's been taken out of {where}"
        return ""

## Where a path through a value is, as messages say it: "`units[0].target`", or "the value".
def place_text(path: list[str]) -> str:
    mut out = ""
    for part in path:
        if out != "" and text_byte(part, 0) != 91:
            out += "."
        out += part
    return "the value" if out == "" else f"`{out}`"

## No `Id`s or `Table`s seen, shared until a read sees one.
NO_IDS = IdsSeen()

## What a reader needs only now and then, apart from what every read needs. A reader has none
## until it first changes some of it, so letting go of a plain read's reader lets go of one empty
## field, not four. It's taken out of the reader to be changed and put back, with `_take`, so it's
## changed where it is, and nothing passing the reader on has to make it the reader's own.
struct ReaderRare:
    ## Where an explained read is, as a failure says it, and the fields of the struct it's in.
    path = NO_PARTS
    fields = NO_FIELDS
    ids = NO_IDS
    tags = NO_TAGS

NO_RARE = ReaderRare()

## Reads JSON a byte at a time, straight into what it's read as. The first read of a text says
## nothing about what's wrong; only a failed one is read again, keeping track of where it is.
struct JsonReader:
    _source: str
    _names = JsonNames.SnakeCase
    _extra = JsonExtra.Error
    _explain = False
    _at = 0
    _place = 0
    _first = True
    _depth = 0
    _in_key = False
    ## What only some reads need, made the first time one does: see `ReaderRare`.
    _rare: ReaderRare? = None
    ## Each object this one is inside: its `_hint`, then its `_seen`. One read at the top has
    ## nothing outside it, so a flat object never makes this list room.
    _outer = NO_COUNTS
    ## For each tuple being read, inside one another: its type, where its array starts, how many
    ## items it has, and how many have been read.
    _tuples = NO_TUPLES
    _owner = ""
    ## For the object being read, the field most likely to come next: the one after the last
    ## found, since text usually has them in order. Each object it's inside keeps its own here.
    _hint = 0
    ## The fields a struct being read has had so far, a bit each, and the same for those it's in.
    _seen = 0
    ## The case whose data is read next, as `Type.Case`, for what a failure in it says.
    _case_owner = ""

    def _space(ref self) -> int:
        mut at = self._at
        mut b = text_byte(self._source, at)
        while b == 32 or b == 10 or b == 13 or b == 9:
            at += 1
            b = text_byte(self._source, at)
        self._at = at
        return b

    ## What only some reads need, to look at: the reader's own, or an empty one.
    def _seen_rare(self) -> ReaderRare:
        return self._rare else NO_RARE

    ## What only some reads need, taken out of the reader to change, and put back after with
    ## `self._rare = ...`. Taken out, nothing else holds it, so it's changed where it is.
    def _take(ref self) -> ReaderRare:
        rare = self._rare else ReaderRare()
        self._rare = None
        return rare

    ## A step deeper into what an explained read is in, for what a failure says.
    def _push_path(ref self, part: str):
        mut rare = self._take()
        rare.path.append(part)
        self._rare = rare

    def _pop_path(ref self):
        mut rare = self._take()
        _ = rare.path.pop()
        self._rare = rare

    ## Where the reader is, as messages say it.
    def _where(self) -> str:
        if len(self._seen_rare().path) == 0: return "the text"
        return f"`{self._joined()}`"

    def _joined(self) -> str:
        mut out = ""
        for part in self._seen_rare().path:
            if out != "" and text_byte(part, 0) != 91:
                out += "."
            out += part
        return out

    ## What the next value is, for a message.
    def _found(ref self) -> str:
        b = self._space()
        if b == 123: return "an object"
        if b == 110: return "null"
        if b == 34: return "a str"
        if b == 91: return "a list"
        if b == 116 or b == 102: return "a bool"
        mut at = self._at
        mut c = text_byte(self._source, at)
        while c == 45 or c == 43 or (c >= 48 and c <= 57):
            at += 1
            c = text_byte(self._source, at)
        if c == 46 or c == 101 or c == 69: return "a float"
        return "an int"

    ## The error for a value that isn't what's wanted.
    def _misfit(ref self, wanted: str) -> ParseError:
        if not self._explain: return no_reason()
        found = self._found()
        return ParseError(
            message=f"{self._where()} should be {article(wanted)}, but it's {found}",
            line=0,
            column=0,
        )

    def int(ref self) -> int fails ParseError:
        mut at = self._at
        mut b = text_byte(self._source, at)
        while b == 32 or b == 10 or b == 13 or b == 9:
            at += 1
            b = text_byte(self._source, at)
        start = at
        negative = b == 45
        if negative:
            at += 1
            b = text_byte(self._source, at)
        if b < 48 or b > 57:
            self._at = start
            return self._int_otherwise()?
        leading = at
        mut value = 0
        while b >= 48 and b <= 57:
            value = value * 10 + b - 48 if at - leading < 18 else value
            at += 1
            b = text_byte(self._source, at)
        if text_byte(self._source, leading) == 48 and at - leading > 1: fail no_reason()
        if at - leading > 18 or b == 46 or b == 101 or b == 69:
            self._at = start
            return self._long_int()?
        self._at = at
        return -value if negative else value

    ## An int that isn't plain digits: the digits of a dict's key, or what isn't an int.
    def _int_otherwise(ref self) -> int fails ParseError:
        if self._in_key and text_byte(self._source, self._at) == 34:
            key = self.text()?
            n = int(key) except InvalidValue():
                if not self._explain: fail no_reason()
                fail ParseError(
                    message=f"{self._where()} has the key \"{cut_input(key)}\", which isn't an int",
                    line=0,
                    column=0,
                )
            # Two ways to write one key would merge into one entry.
            if str(n) == key: return n
            if not self._explain: fail no_reason()
            fail ParseError(
                message=f"{self._where()} has the key \"{key}\", which isn't how that int is written",
                line=0,
                column=0,
            )
        fail self._misfit("int")

    ## An int of too many digits for the quick way, or what's a float or isn't a number.
    def _long_int(ref self) -> int fails ParseError:
        start = self._at
        if self._number_end(start) < 0: fail self._misfit("int")
        end = self._number_end(start)
        n = int(text_part(self._source, start, end)) except InvalidValue(): fail no_reason()
        self._at = end
        return n

    ## Where the plain int starting here ends, or -1 if it's written as a float.
    def _number_end(self, start: int) -> int:
        mut at = start
        if text_byte(self._source, at) == 45:
            at += 1
        mut b = text_byte(self._source, at)
        while b >= 48 and b <= 57:
            at += 1
            b = text_byte(self._source, at)
        if b == 46 or b == 101 or b == 69: return -1
        return at

    def float(ref self) -> float fails ParseError:
        mut at = self._at
        mut b = text_byte(self._source, at)
        while b == 32 or b == 10 or b == 13 or b == 9:
            at += 1
            b = text_byte(self._source, at)
        start = at
        negative = b == 45
        if negative:
            at += 1
            b = text_byte(self._source, at)
        if b < 48 or b > 57:
            self._at = start
            fail self._misfit("float")
        leading = at
        mut digits = 0
        mut whole = 0
        while b >= 48 and b <= 57:
            whole = whole * 10 + b - 48 if digits < 18 else whole
            digits += 1
            at += 1
            b = text_byte(self._source, at)
        if text_byte(self._source, leading) == 48 and at - leading > 1: fail no_reason()
        mut places = 0
        if b == 46:
            at += 1
            b = text_byte(self._source, at)
            if b < 48 or b > 57: fail no_reason()
            while b >= 48 and b <= 57:
                whole = whole * 10 + b - 48 if digits < 18 else whole
                digits += 1
                places += 1
                at += 1
                b = text_byte(self._source, at)
        if b == 101 or b == 69 or digits > 15 or places > 22: return self._long_float(start)?
        self._at = at
        value = float(whole) / POWERS[places]
        return -value if negative else value

    ## A float the quick way can't be sure of, read by the runtime.
    def _long_float(ref self, start: int) -> float fails ParseError:
        mut at = start
        mut b = text_byte(self._source, at)
        while b == 45 or b == 43 or b == 46 or b == 101 or b == 69 or (b >= 48 and b <= 57):
            at += 1
            b = text_byte(self._source, at)
        x = float(text_part(self._source, start, at)) except InvalidValue(): fail no_reason()
        # A number too big for a float would come out as infinity, which isn't what it said.
        if x == 1e308 * 10.0 or x == -1e308 * 10.0:
            if not self._explain: fail no_reason()
            fail ParseError(message=f"{self._where()} is too big for a float", line=0, column=0)
        self._at = at
        return x

    def bool(ref self) -> bool fails ParseError:
        b = self._space()
        at = self._at
        if (
            b == 116
            and text_byte(self._source, at + 1) == 114
            and text_byte(self._source, at + 2) == 117
            and text_byte(self._source, at + 3) == 101
        ):
            self._at = at + 4
            return True
        if (
            b == 102
            and text_byte(self._source, at + 1) == 97
            and text_byte(self._source, at + 2) == 108
            and text_byte(self._source, at + 3) == 115
            and text_byte(self._source, at + 4) == 101
        ):
            self._at = at + 5
            return False
        fail self._misfit("bool")

    def text(ref self) -> str fails ParseError:
        mut at = self._at
        mut b = text_byte(self._source, at)
        while b == 32 or b == 10 or b == 13 or b == 9:
            at += 1
            b = text_byte(self._source, at)
        if b != 34:
            self._at = at
            fail self._misfit("str")
        at += 1
        start = at
        # The text up to its closing quote, or a backslash, found in one go.
        at = text_plain_end(self._source, at)
        b = text_byte(self._source, at)
        if b == 34:
            self._at = at + 1
            return text_part(self._source, start, at)
        if b == 92:
            self._at = start
            return self._unescaped()?
        fail no_reason()

    def bytes(ref self) -> bytes fails ParseError:
        if self._space() != 34: fail self._misfit("bytes")
        text = self.text()?
        return base64.decode(text) except InvalidValue(): fail self._not_base64()

    def _not_base64(self) -> ParseError:
        if not self._explain: return no_reason()
        return ParseError(
            message=f"{self._where()} should be bytes, written in base64",
            line=0,
            column=0,
        )

    ## The rest of a string with an escape in it, from just inside its opening quote.
    def _unescaped(ref self) -> str fails ParseError:
        mut out = ""
        mut at = self._at
        mut start = at
        while True:
            b = text_byte(self._source, at)
            if b == 34:
                out += text_part(self._source, start, at)
                self._at = at + 1
                return out
            if b < 32: fail no_reason()
            if b != 92:
                at += 1
            else:
                out += text_part(self._source, start, at)
                e = text_byte(self._source, at + 1)
                at += 2
                match e:
                    case 34:
                        out += "\""
                    case 92:
                        out += "\\"
                    case 47:
                        out += "/"
                    case 98:
                        out += "\x08"
                    case 102:
                        out += "\x0c"
                    case 110:
                        out += "\n"
                    case 114:
                        out += "\r"
                    case 116:
                        out += "\t"
                    case 117:
                        mut code = self._hex(at)
                        at += 4
                        if code >= 55296 and code < 56320:
                            if (
                                text_byte(self._source, at) != 92
                                or text_byte(self._source, at + 1) != 117
                            ):
                                fail no_reason()
                            low = self._hex(at + 2)
                            at += 6
                            if low < 56320 or low >= 57344: fail no_reason()
                            code = 65536 + (code - 55296) * 1024 + low - 56320
                        elif code < 0 or (code >= 56320 and code < 57344):
                            fail no_reason()
                        out += text_of_code(code)
                    case _:
                        fail no_reason()
                start = at

    ## The number in the four hex digits here, or -1 if they aren't.
    def _hex(self, at: int) -> int:
        mut code = 0
        for place in range(4):
            b = text_byte(self._source, at + place)
            if b >= 48 and b <= 57:
                code = code * 16 + b - 48
            elif b >= 97 and b <= 102:
                code = code * 16 + b - 87
            elif b >= 65 and b <= 70:
                code = code * 16 + b - 55
            else:
                return -1
        return code

    def none(ref self) -> bool fails ParseError:
        b = self._space()
        if b != 110: return False
        at = self._at
        if (
            text_byte(self._source, at + 1) != 117
            or text_byte(self._source, at + 2) != 108
            or text_byte(self._source, at + 3) != 108
        ):
            fail no_reason()
        self._at = at + 4
        return True

    def value[T: Deserializable](ref self) -> T fails ParseError:
        return T.deserialize(ref self)?

    def sequence[T: Deserializable](ref self) -> list[T] fails ParseError:
        if self._space() != 91: fail self._misfit(f"list[{type_name[T]()}]")
        self._at += 1
        self._depth += 1
        if self._depth > JSON_MOST_DEEP: fail no_reason()
        mut found = list[T]()
        if self._space() == 93:
            self._at += 1
            self._depth -= 1
            return found
        mut count = 0
        while True:
            if self._explain:
                self._push_path(f"[{count}]")
                count += 1
            found.append(T.deserialize(ref self)?)
            if self._explain:
                self._pop_path()
            b = self._space()
            self._at += 1
            if b == 93:
                self._depth -= 1
                return found
            if b != 44: fail no_reason()

    def map[K: Deserializable, V: Deserializable](ref self) -> list[(K, V)] fails ParseError:
        b = self._space()
        if b == 91: return self._pairs[K, V]()?
        if b != 123: fail self._misfit(f"dict[{type_name[K]()}, {type_name[V]()}]")
        self._at += 1
        self._depth += 1
        if self._depth > JSON_MOST_DEEP: fail no_reason()
        mut found = list[(K, V)]()
        if self._space() == 125:
            self._at += 1
            self._depth -= 1
            return found
        while True:
            start = self._at
            # A key is always in quotes.
            if self._space() != 34: fail self._misfit("a key in quotes")
            self._in_key = True
            key = K.deserialize(ref self)?
            self._in_key = False
            if self._space() != 58: fail no_reason()
            if self._explain:
                self._push_path(
                    f"[{cut_input(text_part(self._source, self._key_start(start), self._at))}]",
                )
            self._at += 1
            value = V.deserialize(ref self)?
            if self._explain:
                self._pop_path()
            found.append((key, value))
            c = self._space()
            self._at += 1
            if c == 125:
                self._depth -= 1
                return found
            if c != 44: fail no_reason()

    def _key_start(self, start: int) -> int:
        mut at = start
        mut b = text_byte(self._source, at)
        while b == 32 or b == 10 or b == 13 or b == 9:
            at += 1
            b = text_byte(self._source, at)
        return at

    ## A dict whose keys can't be an object's, as an array of `[key, value]` pairs.
    def _pairs[K: Deserializable, V: Deserializable](ref self) -> list[(K, V)] fails ParseError:
        self._at += 1
        mut found = list[(K, V)]()
        if self._space() == 93:
            self._at += 1
            return found
        mut count = 0
        while True:
            if self._explain:
                self._push_path(f"[{count}]")
                count += 1
            if self._space() != 91: fail self._misfit("[key, value] pair")
            self._at += 1
            if self._explain:
                self._push_path("[0]")
            key = K.deserialize(ref self)?
            if self._explain:
                self._pop_path()
            if self._space() != 44: fail self._not_a_pair()
            self._at += 1
            if self._explain:
                self._push_path("[1]")
            value = V.deserialize(ref self)?
            if self._explain:
                self._pop_path()
            if self._space() != 93: fail self._not_a_pair()
            self._at += 1
            if self._explain:
                self._pop_path()
            found.append((key, value))
            b = self._space()
            self._at += 1
            if b == 93: return found
            if b != 44: fail no_reason()

    def _not_a_pair(self) -> ParseError:
        if not self._explain: return no_reason()
        return ParseError(
            message=f"{self._where()} should be a [key, value] pair",
            line=0,
            column=0,
        )

    def record(ref self, name: str) fails ParseError:
        if self._space() != 123:
            mut wanted = name
            at = name.find(".")
            if at is not None:
                wanted = name[:at]
            fail self._misfit(wanted)
        self._at += 1
        self._first = True
        self._depth += 1
        if self._depth > JSON_MOST_DEEP: fail no_reason()
        if self._explain:
            self._owner = self._case_owner if self._case_owner != "" else name
            self._case_owner = ""
        if self._depth > 1:
            self._outer.append(self._hint)
            self._outer.append(self._seen)
        self._hint = 0
        self._seen = 0

    ## Leaves the object being read, back to the one it's inside, if any.
    def _left(ref self):
        self._depth -= 1
        if self._depth > 0:
            self._seen = self._outer.pop() else 0
            self._hint = self._outer.pop() else 0
        else:
            self._seen = 0
            self._hint = 0

    def next_field(ref self, fields: list[(str, str)]) -> bool fails ParseError:
        if self._explain:
            mut rare = self._take()
            rare.fields = fields
            self._rare = rare
        b = self._space()
        if self._first:
            self._first = False
            if b == 125:
                self._at += 1
                self._left()
                return False
            if self._explain and self._extra == .Error:
                self._unknown_first(fields)?
        else:
            if self._explain:
                self._pop_path()
            if b == 125:
                self._at += 1
                self._left()
                return False
            if b != 44: fail no_reason()
            self._at += 1
        if not self._explain and self._names == .SnakeCase:
            at = self._key_in_place(fields)
            if at >= 0:
                self._place = at
                self._hint = at + 1
                if self._seen_again(at): fail self._twice(at, fields)
                return True
        key = self.text()?
        if self._space() != 58: fail no_reason()
        self._at += 1
        return self._named(key, fields)?

    ## Which of `fields` the key ahead is, read where it is in the text with no `str` made for it,
    ## trying the likeliest first, and steps past it and its `:`. -1, and nothing taken, when it
    ## isn't a plain match: then the key's read as usual.
    def _key_in_place(ref self, fields: list[(str, str)]) -> int:
        b = self._space()
        if b != 34: return -1
        start = self._at + 1
        count = len(fields)
        mut place = self._hint
        mut tries = 0
        while tries < count:
            if place >= count:
                place = 0
            saved = fields[place][0]
            size = text_size(saved)
            if (
                size > 0
                and text_byte(self._source, start + size) == 34
                and text_same_at(self._source, start, saved)
            ):
                mut at = start + size + 1
                mut c = text_byte(self._source, at)
                while c == 32 or c == 10 or c == 13 or c == 9:
                    at += 1
                    c = text_byte(self._source, at)
                if c != 58: return -1
                self._at = at + 1
                return place
            place += 1
            tries += 1
        return -1

    ## Notes that field `at` of a struct has come, and says whether it had come before: which one
    ## to believe would be a guess, so the caller fails with `_twice`. It can't fail itself, so the
    ## usual read, of each field once, makes no failure's room. A struct of more fields than a
    ## word has bits doesn't check past those.
    def _seen_again(ref self, at: int) -> bool:
        if at >= 62: return False
        bit = 1 << at
        if self._seen & bit != 0: return True
        self._seen = self._seen | bit
        return False

    ## The failure for field `at` of a struct coming twice.
    def _twice(self, at: int, fields: list[(str, str)]) -> ParseError:
        if not self._explain: return no_reason()
        return ParseError(message=f"{self._where()} has `{fields[at][0]}` twice", line=0, column=0)

    def _named(ref self, key: str, fields: list[(str, str)]) -> bool fails ParseError:
        at = self._place_of(key, fields)
        if at >= 0:
            self._place = at
            if self._seen_again(at): fail self._twice(at, fields)
            if self._explain:
                self._push_path(key)
            return True
        match self._extra:
            case .Ignore:
                self._skip(self._depth)?
                self._first = False
                if self._explain:
                    self._push_path(key)
                return self.next_field(fields)?
            case .Error:
                fail self._unknown(key, fields)

    ## Which of `fields` a key is, as a place in it, or -1 for none.
    def _place_of(self, key: str, fields: list[(str, str)]) -> int:
        mut at = 0
        for saved, own in fields:
            if (
                saved == key
                and not (
                    saved == own
                    and self._names != .SnakeCase
                    and spelled_as(own, self._names) != key
                )
            ):
                return at
            at += 1
        if self._names != .SnakeCase:
            at = 0
            for saved, own in fields:
                if saved == own and spelled_as(own, self._names) == key: return at
                at += 1
        return -1

    ## Fails on the first key in the object ahead that no field has, before any field's value is
    ## read. Only a read that's explaining a failure does this.
    def _unknown_first(ref self, fields: list[(str, str)]) fails ParseError:
        start = self._at
        while True:
            key = self.text()?
            if self._place_of(key, fields) < 0: fail self._unknown(key, fields)
            _ = self._space()
            self._at += 1
            self._skip(self._depth)?
            b = self._space()
            self._at += 1
            if b != 44: break
        self._at = start

    def _unknown(self, key: str, fields: list[(str, str)]) -> ParseError:
        if not self._explain: return no_reason()
        owner = f"`{self._owner}`"
        where = self._where()
        for saved, own in fields:
            if spelled_as(own, self._names) == key:
                if saved == "":
                    return ParseError(
                        message=f"{owner} doesn't save `{own}`, which has `@skip`, but {where} has it",
                        line=0,
                        column=0,
                    )
                return ParseError(
                    message=f"{owner} saves `{own}` as \"{saved}\", but {where} has \"{key}\"",
                    line=0,
                    column=0,
                )
        return ParseError(
            message=f"{owner} has no field \"{key}\", but {where} has one",
            line=0,
            column=0,
        )

    def field_at(self) -> int:
        return self._place

    def missing(self, name: str) -> ParseError:
        if not self._explain: return no_reason()
        mut wire = name
        for saved, own in self._seen_rare().fields:
            if saved == name and saved == own:
                wire = spelled_as(own, self._names)
        joined = self._joined()
        if joined == "": return ParseError(message=f"`{wire}` is missing", line=0, column=0)
        if text_byte(wire, 0) == 91:
            return ParseError(message=f"`{joined}{wire}` is missing", line=0, column=0)
        return ParseError(message=f"`{joined}.{wire}` is missing", line=0, column=0)

    def here(self, message: str) -> ParseError:
        if not self._explain: return no_reason()
        return ParseError(message=f"{self._where()} {message}", line=0, column=0)

    def saw_id(ref self, kind: str, position: int):
        at = self._where() if self._explain else ""
        mut rare = self._take()
        rare.ids.id(kind, at, position)
        self._rare = rare

    def saw_table(ref self, kind: str, count: int):
        at = self._where() if self._explain else ""
        mut rare = self._take()
        rare.ids.table(kind, at, count)
        self._rare = rare

    def tag(ref self, kind: str) -> int:
        found = self._seen_rare().tags.get(kind) else 0
        if found > 0: return found
        made = new_tag()
        mut rare = self._take()
        rare.tags[kind] = made
        self._rare = rare
        return made

    ## A null is a value, not a field left out: one in a field that isn't optional fails, saying
    ## so, rather than taking its default, as SQL's null does.
    def none_next(ref self) -> bool:
        return False

    def exact(self) -> bool:
        return False

    def ordered(ref self, name: str) -> bool fails ParseError:
        return False

    def end_ordered(ref self):
        pass

    def map_count(ref self) -> int fails ParseError:
        return -1

    def end_map(ref self):
        pass

    def items(ref self, name: str, count: int) fails ParseError:
        if self._space() != 91: fail self._misfit(name)
        self._tuples.append((name, self._at, count, 0))
        self._at += 1
        self._depth += 1
        if self._depth > JSON_MOST_DEEP: fail no_reason()

    def item[T: Deserializable](ref self) -> T fails ParseError:
        top = self._tuples.pop() else fail no_reason()
        name, start, count, read = top
        b = self._space()
        if read == count or b == 93 or (read > 0 and b != 44): fail self._tuple_misfit(name, start)
        if read > 0:
            self._at += 1
        self._tuples.append((name, start, count, read + 1))
        if self._explain:
            self._push_path(f"[{read}]")
        found = T.deserialize(ref self)?
        if self._explain:
            self._pop_path()
        return found

    def end_items(ref self) fails ParseError:
        top = self._tuples.pop() else fail no_reason()
        name, start, _, _ = top
        if self._space() != 93: fail self._tuple_misfit(name, start)
        self._at += 1
        self._depth -= 1

    ## A tuple's array of the wrong length, said of the whole array, as for any other misfit.
    def _tuple_misfit(ref self, name: str, start: int) -> ParseError:
        self._at = start
        return self._misfit(name)

    def at_item(self, at: int, message: str) -> ParseError:
        if not self._explain: return no_reason()
        return ParseError(message=f"`{self._joined()}[{at}]` {message}", line=0, column=0)

    def rule(self, message: str) -> ParseError:
        if not self._explain: return no_reason()
        return ParseError(message=f"in {self._where()}, {message}", line=0, column=0)

    def enum_case(ref self, name: str, cases: list[(str, bool)]) -> int fails ParseError:
        b = self._space()
        if b == 34: return self._plain_case(name, cases)?
        if b != 123: fail self._misfit(name)
        start = self._at
        self._at += 1
        if self._space() != 34:
            self._at = start
            fail self._misfit(name)
        mut at = -1 if self._explain else self._case_in_place(cases)
        mut key = ""
        if at < 0:
            key = self.text()?
            at = case_named(key, cases)
        if self._space() != 58: fail no_reason()
        self._at += 1
        if self._space() != 123:
            self._at = start
            fail self._misfit(name)
        if at < 0: fail self._no_case(name, key)
        case_name, has_data = cases[at]
        if not has_data:
            self._at += 1
            if self._space() != 125: fail self._no_field(f"{name}.{case_name}")
            self._at += 1
            self.end_case()?
        elif self._explain:
            self._case_owner = f"{name}.{case_name}"
        return at

    ## The error for a case with no data that the text gives a field.
    def _no_field(ref self, owner: str) -> ParseError:
        if not self._explain: return no_reason()
        key = self.text() except ParseError(): return no_reason()
        return ParseError(
            message=f"`{owner}` has no field \"{cut_input(key)}\", but {self._where()} has one",
            line=0,
            column=0,
        )

    def _plain_case(ref self, name: str, cases: list[(str, bool)]) -> int fails ParseError:
        mut at = -1 if self._explain else self._case_in_place(cases)
        mut key = ""
        if at < 0:
            key = self.text()?
            at = case_named(key, cases)
        if at < 0: fail self._no_case(name, key)
        case_name, has_data = cases[at]
        if has_data:
            if not self._explain: fail no_reason()
            fail ParseError(
                message=f"{self._where()} is `{name}.{case_name}`, which needs its fields",
                line=0,
                column=0,
            )
        return at

    ## Which of `cases` the string ahead names, read where it is with no `str` made for it, and
    ## steps past it. -1, and nothing taken, when it isn't plainly one of them.
    def _case_in_place(ref self, cases: list[(str, bool)]) -> int:
        start = self._at + 1
        mut at = 0
        for case_name, _ in cases:
            size = text_size(case_name)
            if (
                text_byte(self._source, start + size) == 34
                and text_same_at(self._source, start, case_name)
            ):
                self._at = start + size + 1
                return at
            at += 1
        return -1

    def _no_case(self, name: str, key: str) -> ParseError:
        if not self._explain: return no_reason()
        return ParseError(
            message=f"{self._where()} is \"{key}\", which isn't a case of `{name}`",
            line=0,
            column=0,
        )

    def end_case(ref self) fails ParseError:
        if self._space() != 125: fail no_reason()
        self._at += 1

    def member(ref self, names: list[str]) -> int fails ParseError:
        union = " | ".join(names)
        if self._space() != 123: fail self._misfit(union)
        start = self._at
        self._at += 1
        if self._space() != 34:
            self._at = start
            fail self._misfit(union)
        key = self.text()?
        if self._space() != 58: fail no_reason()
        self._at += 1
        mut at = 0
        for name in names:
            if name == key:
                self._depth += 1
                if self._depth > JSON_MOST_DEEP: fail no_reason()
                if self._explain:
                    self._push_path(key)
                return at
            at += 1
        if not self._explain: fail no_reason()
        fail ParseError(
            message=f"{self._where()} is \"{key}\", which is none of `{union}`",
            line=0,
            column=0,
        )

    def end_member(ref self) fails ParseError:
        if self._space() != 125: fail no_reason()
        self._at += 1
        self._depth -= 1
        if self._explain:
            self._pop_path()

    ## What comes after everything's been read has to be nothing.
    def finish(ref self) fails ParseError:
        if self._space() != -1: fail no_reason()

    ## What's next, for a message about the text itself: "`x`", or "the end of the text".
    def _next_char(self) -> str:
        b = text_byte(self._source, self._at)
        if b < 0: return "the end of the text"
        if b == 10: return "the end of the line"
        mut size = 1
        if b >= 240:
            size = 4
        elif b >= 224:
            size = 3
        elif b >= 192:
            size = 2
        c = text_part(self._source, self._at, self._at + size)
        return f"`{c}`"

    ## A failure saying what's wrong with the text here, by line and column.
    def _bad(self, message: str) -> ParseError:
        return self._bad_at(message, self._at)

    def _bad_at(self, message: str, place: int) -> ParseError:
        mut line = 1
        mut column = 1
        mut at = 0
        while at < place:
            b = text_byte(self._source, at)
            if b == 10:
                line += 1
                column = 1
            elif b < 128 or b >= 192:
                column += 1
            at += 1
        return ParseError(
            message=f"{message}, at line {line}, column {column}",
            line=line,
            column=column,
        )

    ## Goes past one value inside `depth` arrays and objects, saying what's wrong with it if
    ## anything is. An array or object starting here is `depth + 1` deep.
    def _skip(ref self, depth: int) fails ParseError:
        b = self._space()
        if (b == 123 or b == 91) and depth >= JSON_MOST_DEEP:
            fail self._bad(f"arrays and objects nest more than {JSON_MOST_DEEP} deep here")
        if b == 123:
            self._skip_object(depth)?
        elif b == 91:
            self._skip_array(depth)?
        elif b == 34:
            self._skip_string()?
        elif b == 45 or (b >= 48 and b <= 57):
            self._skip_number()?
        elif b >= 97 and b <= 122:
            self._skip_word()?
        else:
            fail self._bad(f"expected a value, but found {self._next_char()}")

    def _skip_word(ref self) fails ParseError:
        start = self._at
        mut at = start
        mut b = text_byte(self._source, at)
        while (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57):
            at += 1
            b = text_byte(self._source, at)
        word = text_part(self._source, start, at)
        if word != "true" and word != "false" and word != "null":
            fail self._bad(
                f"{quoted_input(word)} isn't a JSON value; the words JSON knows are true, false and null",
            )
        self._at = at

    def _skip_object(ref self, depth: int) fails ParseError:
        self._at += 1
        if self._space() == 125:
            self._at += 1
            return
        while True:
            if self._space() != 34:
                fail self._bad(f"expected a key in double quotes, but found {self._next_char()}")
            self._skip_string()?
            if self._space() != 58:
                fail self._bad(f"expected `:` after the key, but found {self._next_char()}")
            self._at += 1
            self._skip(depth + 1)?
            b = self._space()
            if b == 125:
                self._at += 1
                return
            if b != 44:
                fail self._bad(
                    f"expected `,` or `}}` after the value, but found {self._next_char()}",
                )
            self._at += 1

    def _skip_array(ref self, depth: int) fails ParseError:
        self._at += 1
        if self._space() == 93:
            self._at += 1
            return
        while True:
            self._skip(depth + 1)?
            b = self._space()
            if b == 93:
                self._at += 1
                return
            if b != 44:
                fail self._bad(
                    f"expected `,` or `]` after the value, but found {self._next_char()}",
                )
            self._at += 1

    def _skip_string(ref self) fails ParseError:
        start = self._at
        self._at += 1
        while True:
            b = text_byte(self._source, self._at)
            if b == 34:
                self._at += 1
                return
            if b < 0: fail self._bad_at("this string never ends", start)
            if b < 32:
                fail self._bad(
                    "a string can't hold a line break or control character; write `\\n` or `\\t`",
                )
            self._at += 1
            if b == 92:
                self._skip_escape()?

    def _skip_escape(ref self) fails ParseError:
        at = self._at
        b = text_byte(self._source, at)
        if b < 0: fail self._bad("this string never ends")
        self._at = at + 1
        if b == 117:
            self._skip_unicode()?
        elif (
            b != 34
            and b != 92
            and b != 47
            and b != 98
            and b != 102
            and b != 110
            and b != 114
            and b != 116
        ):
            self._at = at
            fail self._bad(f"`\\{self._next_char()[1:-1]}` isn't a JSON escape")

    def _skip_unicode(ref self) fails ParseError:
        start = self._at
        high = self._hex(start)
        if high < 0: fail self._bad("`\\u` needs 4 hex digits")
        self._at = start + 4
        if high < 55296 or high >= 56320:
            if high >= 56320 and high < 57344: fail self._bad("this `\\u` escape isn't a character")
            return
        if text_byte(self._source, self._at) != 92 or text_byte(self._source, self._at + 1) != 117:
            self._at = start
            fail self._bad("this `\\u` escape is half of a pair, so another `\\u` must follow it")
        self._at += 2
        low = self._hex(self._at)
        if low < 0: fail self._bad("`\\u` needs 4 hex digits")
        if low < 56320 or low >= 57344:
            self._at = start
            fail self._bad("these `\\u` escapes aren't a valid pair")
        self._at += 4

    def _skip_number(ref self) fails ParseError:
        start = self._at
        if text_byte(self._source, start) == 45:
            self._at += 1
        whole = self._at
        self._digits()
        if self._at == whole: fail self._bad(f"expected a digit, but found {self._next_char()}")
        if self._at - whole > 1 and text_byte(self._source, whole) == 48:
            self._at = start
            fail self._bad("a number can't start with 0 unless it is 0")
        mut is_float = False
        if text_byte(self._source, self._at) == 46:
            is_float = True
            self._at += 1
            place = self._at
            self._digits()
            if self._at == place:
                fail self._bad(f"expected a digit after `.`, but found {self._next_char()}")
        b = text_byte(self._source, self._at)
        if b == 101 or b == 69:
            is_float = True
            self._at += 1
            sign = text_byte(self._source, self._at)
            if sign == 43 or sign == 45:
                self._at += 1
            place = self._at
            self._digits()
            if self._at == place:
                fail self._bad(f"expected a digit in the exponent, but found {self._next_char()}")
        if not is_float:
            number = text_part(self._source, start, self._at)
            _ = int(number) except InvalidValue(): fail self._bad_at(
                f"{quoted_input(number)} is too big for an int",
                start,
            )

    def _digits(ref self):
        mut b = text_byte(self._source, self._at)
        while b >= 48 and b <= 57:
            self._at += 1
            b = text_byte(self._source, self._at)

    ## Goes over the whole text, saying what's wrong with it if anything is.
    def _whole(ref self) fails ParseError:
        self._skip(0)?
        if self._space() != -1:
            fail self._bad(
                f"expected the end of the text after the value, but found {self._next_char()}",
            )

## `text` read as a `T`, through its own `def deserialize`.
## Native code runs `json.loads` through this, with `None` for the options' defaults, as `native_dumps`.
export def native_loads[T: Deserializable](
    text: str,
    names: JsonNames? = None,
    extra: JsonExtra? = None,
) -> T fails ParseError:
    spelled = names else JsonNames.SnakeCase
    keys = extra else JsonExtra.Error
    mut src = JsonReader(_source=text, _names=spelled, _extra=keys)
    return read_value[T](ref src) except ParseError(): explained[T](text, spelled, keys)?

def read_value[T: Deserializable](ref src: JsonReader) -> T fails ParseError:
    value = T.deserialize(ref src)?
    src.finish()?
    found = src._seen_rare().ids.problem()
    if found != "":
        if not src._explain: fail no_reason()
        fail ParseError(message=found, line=0, column=0)
    return value

## Fails with what's wrong with text that failed to read: first anything wrong with it as JSON,
## then what doesn't fit the type, found by reading it again keeping track of where it is.
def explained[T: Deserializable](
    text: str,
    names: JsonNames,
    extra: JsonExtra,
) -> T fails ParseError:
    mut check = JsonReader(_source=text)
    check._whole()?
    mut src = JsonReader(_source=text, _names=names, _extra=extra, _explain=True)
    return read_value[T](ref src)?

## Writes `value` as JSON to `out`, any `Writer` from `std.io`, as `dumps` gives it.
export def dump[T: Serializable, W: Writer](
    value: T,
    ref out: W,
    names: JsonNames? = None,
    indent = -1,
) fails IoError:
    out.write_text(native_dumps(value, names=names, indent=indent))?

## Reads what's left in `src`, any `Reader` from `std.io`, as JSON for a `T`, as `loads` does,
## with the same `names=` and `extra=`.
export def load[T: Deserializable, R: Reader](
    ref src: R,
    names: JsonNames? = None,
    extra: JsonExtra? = None,
) -> T fails ParseError | IoError:
    data = read_all(ref src)?
    text = data.decode() except InvalidValue(): fail ParseError(
        message="the JSON isn't UTF-8 text",
        line=1,
        column=1,
    )
    return native_loads[T](text, names=names, extra=extra)?
