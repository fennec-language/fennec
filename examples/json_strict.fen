# JSON and TOML refuse what they'd otherwise have to guess at. A number too big to hold, a field
# given twice and a dict key that only looks like an int each fail to load, rather than loading
# as something the text didn't say.
from std import json, toml

struct Point:
    x: int
    y = 0

def said[T](found: Result[T, ParseError]) -> str:
    match found:
        case Ok(_):
            return "loaded"
        case Err(_):
            return "refused"

test "a float that's too big to hold is refused"():
    assert said(json.loads[float]("1e400")) == "refused"
    assert said(json.loads[float]("-1e400")) == "refused"
    assert said(json.loads[float]("1e300")) == "loaded"

test "a float that's too big in TOML is refused"():
    assert said(toml.loads[dict[str, float]]("a = 1e400\n")) == "refused"

test "a field given twice is refused"():
    assert said(json.loads[Point]("{\"x\": 1, \"x\": 2}")) == "refused"
    assert said(json.loads[Point]("{\"x\": 1, \"y\": 2}")) == "loaded"

test "a dict's int keys are written one way"():
    assert said(json.loads[dict[int, int]]("{\"1\": 2}")) == "loaded"
    assert said(json.loads[dict[int, int]]("{\"-1\": 2}")) == "loaded"
    assert said(json.loads[dict[int, int]]("{\"+1\": 2}")) == "refused"
    assert said(json.loads[dict[int, int]]("{\"01\": 2}")) == "refused"
    assert said(json.loads[dict[int, int]]("{\" 1\": 2}")) == "refused"

test "a dict's key is in quotes"():
    assert said(json.loads[dict[int, int]]("{1: 2}")) == "refused"

def main(stdout: Stdout):
    stdout.print("run with `fennec test`")
