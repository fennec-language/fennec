# A crash inside the second copy: the sum overflows, and the message names the same place.
def scan(starts: list[int], order: list[int]) -> int:
    mut total = 0
    for at in range(starts[0], starts[1]):
        total += order[at] * 1000000000000
    return total

def main(stdout: Stdout):
    stdout.print(scan([0, 3], order=[5, 6, 7]))
    stdout.print(scan([0, 3], order=[5, 6000000, 7000000]))
