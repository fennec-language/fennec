# A generator holds its lists across each `yield` while the caller changes its own.
def sums(starts: list[int], order: list[int]) -> Iterator[int]:
    for cell in range(len(starts) - 1):
        mut added = 0
        for at in range(starts[cell], starts[cell + 1]):
            added += order[at]
        yield added

def main(stdout: Stdout):
    mut starts = [0, 2, 4, 6]
    mut order = [1, 2, 3, 4, 5, 6]
    for added in sums(starts, order=order):
        stdout.print(added)
        starts[2] = 50000000
        starts[3] = 50000000
        _ = order.pop()
        _ = order.pop()
        _ = order.pop()
    stdout.print(starts, order)
