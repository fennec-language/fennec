# A format is a type with a `Serializer`'s methods. Each call is compiled for the format it's
# given, so nothing is looked up as it runs, and one `def serialize` serves every format.
from std.collections import Id

struct Shown:
    parts = list[str]()

    def int(ref self, value: int):
        self.parts.append(str(value))

    def float(ref self, value: float):
        self.parts.append(str(value))

    def bool(ref self, value: bool):
        self.parts.append("yes" if value else "no")

    def text(ref self, value: str):
        self.parts.append(f"'{value}'")

    def bytes(ref self, value: bytes):
        self.parts.append("bytes")

    def none(ref self):
        self.parts.append("nothing")

    def value[T: Serializable](ref self, x: T):
        x.serialize(ref self)

    def sequence[T: Serializable](ref self, items: list[T]):
        self.parts.append("(")
        for item in items:
            item.serialize(ref self)
        self.parts.append(")")

    def map[K: Serializable, V: Serializable](ref self, pairs: list[(K, V)]):
        for key, value in pairs:
            key.serialize(ref self)
            self.parts.append("=")
            value.serialize(ref self)

    def record(ref self, name: str, count: int):
        self.parts.append(f"{name}/{count}")

    def field[T: Serializable](ref self, name: str, x: T):
        self.parts.append(f"{name}:")
        x.serialize(ref self)

    def renamed[T: Serializable](ref self, name: str, x: T):
        self.parts.append(f"as {name}:")
        x.serialize(ref self)

    def end(ref self):
        self.parts.append(".")

    def items(ref self, name: str, count: int):
        self.parts.append("[")

    def item[T: Serializable](ref self, x: T):
        x.serialize(ref self)

    def end_items(ref self):
        self.parts.append("]")

    def enum_case(ref self, name: str, case_name: str, at: int):
        self.parts.append(f"{name}.{case_name}")

    def case_record(ref self, name: str, case_name: str, at: int, count: int):
        self.parts.append(f"{name}.{case_name}/{count}")

    def member(ref self, name: str, at: int):
        pass

    def end_member(ref self):
        pass

    def table[T: Serializable](ref self, kind: str, tag: int, ids: list[Id[T]], items: list[T]):
        self.sequence(items)

    def exact(self) -> bool:
        return False

    def slots[T: Serializable](ref self, kind: str, tag: int, slots: list[int], items: list[T]):
        # Never asked for: `exact` says no.
        pass

    def id(ref self, kind: str, key: int, tag: int):
        self.parts.append(f"Id[{kind}]")

    def some[T: Serializable](ref self, x: T):
        x.serialize(ref self)

    def shown(self) -> str:
        return " ".join(self.parts)

# Another format takes the same types, and counts instead of writing.
struct Counted:
    total = 0

    def int(ref self, value: int):
        self.total += 1

    def float(ref self, value: float):
        self.total += 1

    def bool(ref self, value: bool):
        self.total += 1

    def text(ref self, value: str):
        self.total += 1

    def bytes(ref self, value: bytes):
        self.total += 1

    def none(ref self):
        self.total += 1

    def value[T: Serializable](ref self, x: T):
        x.serialize(ref self)

    def sequence[T: Serializable](ref self, items: list[T]):
        for item in items:
            item.serialize(ref self)

    def map[K: Serializable, V: Serializable](ref self, pairs: list[(K, V)]):
        for key, value in pairs:
            value.serialize(ref self)

    def record(ref self, name: str, count: int):
        pass

    def field[T: Serializable](ref self, name: str, x: T):
        x.serialize(ref self)

    def renamed[T: Serializable](ref self, name: str, x: T):
        x.serialize(ref self)

    def end(ref self):
        pass

    def items(ref self, name: str, count: int):
        pass

    def item[T: Serializable](ref self, x: T):
        x.serialize(ref self)

    def end_items(ref self):
        pass

    def enum_case(ref self, name: str, case_name: str, at: int):
        self.total += 1

    def case_record(ref self, name: str, case_name: str, at: int, count: int):
        self.total += 1

    def member(ref self, name: str, at: int):
        pass

    def end_member(ref self):
        pass

    def table[T: Serializable](ref self, kind: str, tag: int, ids: list[Id[T]], items: list[T]):
        self.sequence(items)

    def exact(self) -> bool:
        return False

    def slots[T: Serializable](ref self, kind: str, tag: int, slots: list[int], items: list[T]):
        # Never asked for: `exact` says no.
        pass

    def id(ref self, kind: str, key: int, tag: int):
        self.total += 1

    def some[T: Serializable](ref self, x: T):
        x.serialize(ref self)

struct Spot:
    x: int
    label: str

enum Order:
    Hold
    Move(x: int)

# `def serialize` and `def deserialize` are generated from the fields.
struct Squad:
    spots: list[Spot]
    @serialize(name="points")
    scores: dict[str, int]
    ready: bool
    pace: float
    order: Order

def shown[T: Serializable](x: T) -> str:
    mut out = Shown()
    out.value(x)
    return out.shown()

test "plain values write themselves":
    assert shown(3) == "3"
    assert shown(1.5) == "1.5"
    assert shown(True) == "yes"
    assert shown("hi") == "'hi'"
    assert shown(bytes([1, 2])) == "bytes"

test "collections write their items":
    assert shown([1, 2]) == "( 1 2 )"
    assert shown({"a": 1}) == "'a' = 1"
    assert shown({2}) == "( 2 )"

test "a struct writes its fields in order":
    assert shown(Spot(x=1, label="a")) == "Spot/2 x: 1 label: 'a' ."

test "an enum writes its case, with its data if it has any":
    assert shown(Order.Hold) == "Order.Hold"
    assert shown(Order.Move(x=4)) == "Order.Move/1 x: 4 . ."

def main(stdout: Stdout):
    squad = Squad(
        spots=[Spot(x=1, label="a"), Spot(x=2, label="b")],
        scores={"ash": 3},
        ready=True,
        pace=0.5,
        order=.Move(x=4),
    )
    stdout.print(shown(squad))
    mut counted = Counted()
    squad.serialize(ref counted)
    stdout.print(counted.total)
    stdout.print(shown(bytes([1, 2])))

    # What might be missing is saved as what it holds, or as nothing.
    maybes: list[int?] = [1, None]
    stdout.print(shown(maybes))
