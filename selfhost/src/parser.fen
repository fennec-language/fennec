## Tokens to a syntax tree, by recursive descent. Mirrors `crates/syntax/src/parser.rs`:
## the parser's state, its token helpers and the declarations. Statements, expressions and
## `match` patterns extend `Parser` in `parser/stmt.fen`, `parser/expr.fen` and
## `parser/pattern.fen`, as in the Rust parser.

from span import Span, Diagnostic
from token import FPart, Tok, Token, is_reserved
from lexer import byte_length, lex
from ast import Annotation, Module, Item, FnDef, Generic, Param, TypeExpr, TypeDef, Field, Case, Interface, Extension, Import, TestDef, Stmt, StmtKind, Expr, ExprKind, CompKind, MatchArm, Pattern, FStrPart, Arg, UnaryOp, BinOp, is_plain_value

## Parses a whole `.fen` file, where only declarations may sit at the top level.
def parse(source: str) -> Module fails Diagnostic:
    mut parser = Parser.over(lex(source, 0)?)
    parser.module()?

## Tokens to a syntax tree, by recursive descent: declarations first, then statements,
## expressions, and `match` patterns.
struct Parser:
    tokens: list[Token]
    ## Stands in for every token past the end.
    eof: Token
    ## Each `mut` written where the language now says `ref`, and what it was on. Parsing goes on
    ## past them, so the one error they give can fix every one in the file.
    old_mut: list[Span]
    old_mut_on: list[str]
    ## Each `pub` written, the old spelling, and whether it was on a top-level name, where it's
    ## `export`: a method comes with its type. Like `old_mut`, they give one error.
    old_pub: list[Span]
    old_pub_top: list[bool]
    pos = 0
    ## Set when an expression ended with an indented block (a `match`), so the statement
    ## holding it has no line ending of its own to consume.
    block_ended = False
    ## Set just before the value a statement is written with: the whole right side of an
    ## assignment, a bare call or what `return` gives. Only there may `except` follow it, so the
    ## next expression takes it and what it holds sees it unset.
    value_at_top = False

    def over(tokens: list[Token]) -> Parser:
        end = tokens[-1].span if tokens.len() > 0 else Span(start=0, end=0)
        Parser(tokens=tokens, eof=Token(tok=.Eof, span=end), old_mut=[], old_mut_on=[], old_pub=[], old_pub_top=[])

    def current(self) -> Token:
        if self.pos < self.tokens.len():
            return self.tokens[self.pos]
        self.eof

    def peek(self) -> Tok:
        self.current().tok

    def peek_at(self, ahead: int) -> Tok:
        at = self.pos + ahead
        if at < self.tokens.len():
            return self.tokens[at].tok
        self.eof.tok

    def span(self) -> Span:
        self.current().span

    def prev_span(self) -> Span:
        if self.pos > 0 and self.pos <= self.tokens.len():
            return self.tokens[self.pos - 1].span
        self.span()

    def advance(ref self) -> Token:
        token = self.current()
        if self.pos < self.tokens.len():
            self.pos += 1
        token

    def at(self, tok: Tok) -> bool:
        self.peek() == tok

    def at_punct(self, text: str) -> bool:
        self.peek() == .Punct(text)

    def at_keyword(self, word: str) -> bool:
        self.peek() == .Keyword(word)

    ## Whether the next token is the soft keyword `word`.
    def at_soft(self, word: str) -> bool:
        self.peek() == .Name(word)

    def eat(ref self, tok: Tok) -> bool:
        found = self.at(tok)
        if found:
            self.pos += 1
        found

    def eat_punct(ref self, text: str) -> bool:
        self.eat(.Punct(text))

    ## Skips `pub`, the old spelling of `export`, before a declaration or field. On a top-level
    ## name it's `export`, and anywhere else it goes.
    def eat_pub(ref self, top_level: bool) -> Span?:
        if self.at_soft("pub") and (is_name(self.peek_at(1)) or is_keyword_tok(self.peek_at(1))):
            span = self.advance().span
            self.old_pub.append(span)
            self.old_pub_top.append(top_level)
            return span
        None

    ## Skips `export` on a method or field, which comes with its type.
    def eat_export(ref self) -> Span?:
        if not self.at_keyword("export"):
            return None
        span = self.advance().span
        self.old_pub.append(span)
        self.old_pub_top.append(False)
        span

    ## Fails at the first `pub`, saying how many more there are.
    def check_old_pub(self) fails Diagnostic:
        if self.old_pub.len() == 0:
            return
        others = self.old_pub.len() - 1
        more = "" if others == 0 else (" and in 1 other place" if others == 1 else f" and in {others} other places")
        mut top = False
        for at_top in self.old_pub_top:
            top = top or at_top
        fail Diagnostic(
            message="`pub` is written `export` now" if top else "a field or method has no `export` of its own",
            span=self.old_pub[0],
            help=f"`export` marks a top-level name other kits can use, and a type's fields and methods come with it. `fennec fix` mends it here{more}",
        )

    def eat_keyword(ref self, word: str) -> bool:
        self.eat(.Keyword(word))

    ## `ref` on `what`: a loop, a parameter, an argument or a `with` name. `mut` there was the old
    ## spelling. It's kept as `ref` so parsing can go on, and the file fails with one error at
    ## the end, which `fennec fix` mends everywhere it was written.
    def eat_ref(ref self, what: str) -> bool:
        if self.at_keyword("mut"):
            self.old_mut.append(self.advance().span)
            self.old_mut_on.append(what)
            return True
        self.eat_keyword("ref")

    ## Fails at the first `mut` that should be `ref`, saying how many more there are. It comes
    ## before any later mistake, since it's earlier in the file.
    def check_old_mut(self) fails Diagnostic:
        if self.old_mut.len() == 0:
            return
        others = self.old_mut.len() - 1
        more = "" if others == 0 else (" and in 1 other place" if others == 1 else f" and in {others} other places")
        fail Diagnostic(
            message=f"{self.old_mut_on[0]} is written `ref`, not `mut`",
            span=self.old_mut[0],
            help=f"`mut` is only for a new local name. `fennec fix` writes `ref` here{more}",
        )

    def expect_punct(ref self, text: str) -> Span fails Diagnostic:
        if not self.at_punct(text):
            fail self.unexpected(f"`{text}`")
        self.advance().span

    def unexpected(self, expected: str) -> Diagnostic:
        Diagnostic(message=f"expected {expected}, found {describe(self.peek())}", span=self.span())

    def name(ref self, what: str) -> str fails Diagnostic:
        match self.peek():
            case .Name(name):
                _ = self.advance()
                return name
            case .Keyword(word):
                if is_reserved(word):
                    fail self.reserved(word)
                fail Diagnostic(
                    message=f"expected {what}, found {describe(self.peek())}",
                    span=self.span(),
                    help=f"{describe(self.peek())} is a keyword, so it can't be a name",
                )
            case _: pass
        fail self.unexpected(what)

    def reserved(self, word: str) -> Diagnostic:
        Diagnostic(
            message=f"`{word}` is part of Fennec's design but isn't supported yet",
            span=self.span(),
            help="see what's coming at https://fennec-lang.dev/roadmap/",
        )

    ## The start of an indented block: a line break, then a deeper indent.
    def expect_block_start(ref self) fails Diagnostic:
        if not (self.eat(.Newline) and self.eat(.Indent)):
            fail Diagnostic(
                message="expected an indented block",
                span=self.span(),
                help="indent the body 4 spaces more than the line ending in `:`",
            )

    def end_line(ref self) fails Diagnostic:
        block_ended = self.block_ended
        self.block_ended = False
        if block_ended or self.eat(.Newline) or self.at(.Eof) or self.at(.Dedent):
            return
        fail self.unexpected("the end of the line")

    def module(ref self) -> Module fails Diagnostic:
        mut items = []
        while True:
            while self.eat(.Newline):
                pass
            if self.at(.Eof):
                break
            item = self.item() else as problem:
                self.check_old_mut()?
                self.check_old_pub()?
                fail problem
            items.append(item)
        self.check_old_mut()?
        self.check_old_pub()?
        Module(items=items)

    def item(ref self) -> Item fails Diagnostic:
        annotations = self.annotations()?
        if annotations.len() > 0:
            _ = self.eat_pub(True)
            _ = self.eat_keyword("export")
            if not self.at_keyword("def"):
                fail Diagnostic(message="an annotation goes above a field or a `def`", span=annotations[0].span)
            return .Function(copy(self.function()?, annotations=annotations))
        # Inside a kit everything is visible: `export` matters only between kits.
        _ = self.eat_pub(True)
        _ = self.eat_keyword("export")
        match self.peek():
            case .Keyword(word):
                if word == "def":
                    return .Function(self.function()?)
                if word == "from" or word == "import":
                    return .Import(self.import_names()?)
            case .Name(word):
                if self.is_declaration(word):
                    return self.declaration(word)?
            case _: pass
        stmt = self.stmt()?
        constant(stmt)?

    def is_declaration(self, word: str) -> bool:
        if word in ["struct", "shared", "enum", "error", "interface", "extend"]:
            return is_name(self.peek_at(1))
        if word == "type":
            return is_name(self.peek_at(1)) and self.peek_at(2) == .Punct("=")
        if word == "test" or word == "bench":
            return is_str(self.peek_at(1))
        False

    def declaration(ref self, word: str) -> Item fails Diagnostic:
        start = self.advance().span
        match word:
            case "struct": .Struct(self.type_def(start, is_enum=False)?)
            case "shared": .Struct(copy(self.type_def(start, is_enum=False)?, shared=True))
            case "error": .Error(self.error_def(start)?)
            case "enum": .Enum(self.type_def(start, is_enum=True)?)
            case "interface": self.interface(start)?
            case "extend": self.extension(start)?
            case "type":
                name = self.name("a type name")?
                _ = self.expect_punct("=")?
                ty = self.type_expr()?
                span = start.to(self.prev_span())
                self.end_line()?
                .TypeAlias(name, ty, span)
            case _: self.test(start, word == "bench")?

    ## Whether the line starts with a case: a name, and then `(` or nothing.
    def at_case(self) -> bool:
        if not is_name(self.peek()):
            return False
        match self.peek_at(1):
            case .Punct(text): text == "("
            case .Newline | .Dedent | .Eof: True
            case _: False

    ## An error: fields, like a struct's, or cases, like an enum's, each failing its own way:
    ## `NotFound(path: str)`. A line that's a name and then `(` or nothing is a case.
    def error_def(ref self, start: Span) -> TypeDef fails Diagnostic:
        type_def = self.type_body(start, is_enum=False, is_error=True)?
        if type_def.fields.len() > 0 and type_def.cases.len() > 0:
            fail Diagnostic(
                message=f"`{type_def.name}` has both fields and cases",
                span=type_def.fields[0].span,
                help="an error has fields, like `path: str`, or cases, like `NotFound(path: str)`, not both",
            )
        type_def

    def type_def(ref self, start: Span, is_enum: bool) -> TypeDef fails Diagnostic:
        self.type_body(start, is_enum=is_enum, is_error=False)?

    ## A struct's, enum's or error's name and body. An error's body may have cases.
    def type_body(ref self, start: Span, is_enum: bool, is_error: bool) -> TypeDef fails Diagnostic:
        name = self.name("a type name")?
        generics = self.generic_params()?
        span = start.to(self.prev_span())
        _ = self.expect_punct(":")?
        self.expect_block_start()?
        mut type_def = TypeDef(name=name, generics=generics, span=span)
        while not self.eat(.Dedent) and not self.at(.Eof):
            # Enum cases, fields and methods come with their type and have no `export` of their own.
            if not is_enum or self.peek_at(1) == .Keyword("def"):
                _ = self.eat_pub(False) else self.eat_export()
            mut annotations = []
            if not is_enum:
                annotations = self.annotations()?
            if annotations.len() > 0:
                _ = self.eat_pub(False) else self.eat_export()
            if self.at_keyword("def"):
                type_def.methods.append(copy(self.function()?, annotations=annotations))
            elif annotations.len() == 0 and self.eat_keyword("pass"):
                self.end_line()?
            elif is_enum or (is_error and self.at_case()):
                type_def.cases.append(self.enum_case()?)
            else:
                field = self.field(True)?
                default_comes_last(type_def.fields, field)?
                type_def.fields.append(copy(field, annotations=annotations))
                self.end_line()?
        type_def

    ## The annotations above a field or a `def`, each on its own line.
    def annotations(ref self) -> list[Annotation] fails Diagnostic:
        mut found = []
        while self.at_punct("@"):
            start = self.advance().span
            name = self.name("an annotation's name")?
            mut args = []
            if self.eat_punct("("):
                args = self.call_args()?
                _ = self.expect_punct(")")?
            span = start.to(self.prev_span())
            self.end_line()?
            found.append(Annotation(name=name, args=args, span=span))
        found

    ## A field's name, which may be any word, keywords included.
    def field_name(ref self, what: str) -> str fails Diagnostic:
        match self.peek():
            case .Keyword(word):
                if not is_reserved(word):
                    _ = self.advance()
                    return word
            case _: pass
        self.name(what)?

    ## `name: type`, `name = default`, or both, with a `where` rule when `rules` allows.
    def field(ref self, rules: bool) -> Field fails Diagnostic:
        start = self.span()
        name = self.field_name("a field name")?
        mut ty = None
        if self.eat_punct(":"):
            ty = self.type_expr()?
        mut default = None
        if self.eat_punct("="):
            default = self.expr()?
        mut rule = None
        if rules and self.at_soft("where"):
            _ = self.advance()
            rule = self.expr()?
        if ty is None and default is None:
            fail Diagnostic(
                message=f"field `{name}` needs a type or a default",
                span=start,
                help=f"write `{name}: int`, or a default like `{name} = 0`",
            )
        Field(name=name, ty=ty, default=default, rule=rule, span=start.to(self.prev_span()))

    def enum_case(ref self) -> Case fails Diagnostic:
        start = self.span()
        name = self.name("an enum case")?
        mut fields = []
        if self.eat_punct("("):
            while not self.at_punct(")"):
                field = self.field(False)?
                default_comes_last(fields, field)?
                fields.append(field)
                if not self.eat_punct(","):
                    break
            _ = self.expect_punct(")")?
        span = start.to(self.prev_span())
        self.end_line()?
        Case(name=name, fields=fields, span=span)

    def interface(ref self, start: Span) -> Item fails Diagnostic:
        name = self.name("an interface name")?
        _ = self.expect_punct(":")?
        self.expect_block_start()?
        mut methods = []
        while not self.eat(.Dedent) and not self.at(.Eof):
            if not self.eat_keyword("pass"):
                methods.append(self.signature()?)
            self.end_line()?
        .Interface(Interface(name=name, methods=methods, span=start.to(self.prev_span())))

    ## `extend Name:` and its methods. A field is an error: an extension adds methods only.
    def extension(ref self, start: Span) -> Item fails Diagnostic:
        name = self.name("a type name")?
        generics = self.generic_params()?
        span = start.to(self.prev_span())
        _ = self.expect_punct(":")?
        self.expect_block_start()?
        mut methods = []
        while not self.eat(.Dedent) and not self.at(.Eof):
            _ = self.eat_pub(False) else self.eat_export()
            if self.at_keyword("def"):
                methods.append(self.function()?)
            elif self.eat_keyword("pass"):
                self.end_line()?
            else:
                fail Diagnostic(
                    message="an extension adds methods only",
                    span=self.span(),
                    help=f"declare fields where `{name}` is declared",
                )
        .Extend(Extension(name=name, generics=generics, methods=methods, span=span))

    def test(ref self, start: Span, bench: bool) -> Item fails Diagnostic:
        mut name = ""
        match self.advance().tok:
            case .Str(text): name = text
            case _: fail self.unexpected("a test name")
        mut capabilities = []
        if not bench and self.eat_punct("("):
            while not self.at_punct(")"):
                capabilities.append(self.param()?)
                if not self.eat_punct(","):
                    break
            _ = self.expect_punct(")")?
        mut inputs = []
        if not bench and self.eat_keyword("for"):
            inputs.append(self.param()?)
            while self.eat_punct(","):
                inputs.append(self.param()?)
        span = start.to(self.prev_span())
        _ = self.expect_punct(":")?
        body = self.block()?
        .Test(TestDef(name=name, capabilities=capabilities, inputs=inputs, body=body, bench=bench, span=span))

    ## `import a.b`, or `from a.b import x, y`, each maybe renamed with `as`.
    def import_names(ref self) -> Import fails Diagnostic:
        start = self.span()
        is_from = self.eat_keyword("from")
        if not is_from:
            _ = self.advance()
        mut module = [self.name("a module name")?]
        while self.eat_punct("."):
            module.append(self.name("a module name")?)
        mut names = []
        mut aliases = []
        mut alias = None
        if is_from:
            if not self.eat_keyword("import"):
                fail self.unexpected("`import`")
            names.append(self.name("a name to import")?)
            aliases.append(self.import_alias()?)
            while self.eat_punct(","):
                names.append(self.name("a name to import")?)
                aliases.append(self.import_alias()?)
        else:
            alias = self.import_alias()?
        span = start.to(self.prev_span())
        self.end_line()?
        Import(module=module, names=names, aliases=aliases, alias=alias, span=span)

    ## `as name` after something imported, if it's there.
    def import_alias(ref self) -> str? fails Diagnostic:
        if self.eat_keyword("as"):
            return self.name("a name to import it as")?
        None

    ## `[T, U: Shape & Eq]` after a function or type name.
    def generic_params(ref self) -> list[Generic] fails Diagnostic:
        mut generics = []
        if not self.eat_punct("["):
            return generics
        while True:
            start = self.span()
            name = self.name("a type parameter")?
            mut bounds = []
            if self.eat_punct(":"):
                bounds.append(self.type_expr()?)
                while self.eat_punct("&"):
                    bounds.append(self.type_expr()?)
            generics.append(Generic(name=name, bounds=bounds, span=start.to(self.prev_span())))
            if not self.eat_punct(","):
                break
        _ = self.expect_punct("]")?
        generics

    ## `def name(params) -> ret:` and its body, or the signature alone, which only std's
    ## `@intrinsic` functions may be.
    def function(ref self) -> FnDef fails Diagnostic:
        mut function = self.signature()?
        bodiless = (self.at(.Newline) and self.peek_at(1) != .Indent) or self.at(.Eof) or self.at(.Dedent)
        if bodiless:
            self.end_line()?
            return function
        _ = self.expect_punct(":")?
        function.body = self.block()?
        function

    ## `def name(params) -> ret`, without a body. Operators, indexing, `in` and `from` are defined as
    ## `def +`, `def []`, `def []=`, `def in` and `def from`.
    def signature(ref self) -> FnDef fails Diagnostic:
        start = self.advance().span
        mut name = ""
        match self.peek():
            case .Name(text): name = text
            case .Keyword("in"): name = "in"
            # `def from(x: int) -> u8`, which `u8.from(x)` calls.
            case .Keyword("from"): name = "from"
            case .Punct(text):
                if text in ["+", "-", "*", "/", "//", "%", "==", "<"]:
                    name = text
                elif text == "[" and self.peek_at(1) == .Punct("]"):
                    self.pos += 1
                    name = "[]"
            case _: pass
        if name == "":
            fail self.unexpected("a function name")
        _ = self.advance()
        if name == "[]" and self.eat_punct("="):
            name = "[]="
        generics = self.generic_params()?
        _ = self.expect_punct("(")?
        mut params = []
        mut seen_default = False
        while not self.at_punct(")"):
            param = self.param()?
            if param.default is None and seen_default:
                fail no_default_after_defaults(param.name, param.span)
            seen_default = param.default is not None
            params.append(param)
            if not self.eat_punct(","):
                break
        _ = self.expect_punct(")")?
        # `def [](ref self, i)` is the `ref` form, which a type can have beside `def [](self, i)`.
        if name == "[]" and params.len() > 0 and params[0].is_self and params[0].is_mut:
            name = "[]mut"
        mut ret = None
        mut arrow = None
        if self.eat_punct("->"):
            arrow = self.prev_span()
            if self.at_keyword("with"):
                # `-> with Transaction`: a source, which lends one to its caller's `with` block.
                lend_at = self.advance().span
                lent = self.type_expr()?
                ret = TypeExpr(name="with", args=[lent], optional=False, span=lend_at.to(self.prev_span()))
            else:
                ret = self.type_expr()?
        # `fails` is a word only here, after the parameters and any return type.
        mut fails = None
        if self.at_fails():
            fails = self.fails_type()?
        FnDef(
            name=name,
            generics=generics,
            params=params,
            ret=ret,
            arrow=arrow,
            fails=fails,
            body=[],
            span=start.to(self.prev_span()),
        )

    def param(ref self) -> Param fails Diagnostic:
        start = self.span()
        is_mut = self.eat_ref("a parameter")
        name = self.name("a parameter name")?
        if name == "self":
            return Param(name=name, ty=None, is_mut=is_mut, is_self=True, default=None, span=start.to(self.prev_span()))
        # `limit=8` takes its type from the literal.
        if self.eat_punct("="):
            given = self.param_default(name, is_mut)?
            return Param(name=name, ty=None, is_mut=is_mut, is_self=False, default=given, span=start.to(self.prev_span()))
        if not self.eat_punct(":"):
            fail Diagnostic(
                message=f"parameter `{name}` needs a type",
                span=self.prev_span(),
                help=f"write it with its type, like `{name}: int`, or give it a default, like `{name}=8`",
            )
        ty = self.type_expr()?
        mut default = None
        if self.eat_punct("="):
            default = self.param_default(name, is_mut)?
        Param(name=name, ty=ty, is_mut=is_mut, is_self=False, default=default, span=start.to(self.prev_span()))

    ## A parameter's default: a plain value, known without running anything.
    def param_default(ref self, name: str, is_mut: bool) -> Expr fails Diagnostic:
        value = self.expr()?
        if is_mut:
            fail Diagnostic(
                message=f"`ref` parameter `{name}` can't have a default",
                span=value.span,
                help="a `ref` parameter changes what the caller passes, so a call has to pass something",
            )
        if not is_plain_value(value):
            fail Diagnostic(
                message="a parameter's default has to be a plain value",
                span=value.span,
                help="write a number, string, `True`, `False` or `None`, and work anything else out in the function",
            )
        value

    ## Whether `fails` comes next. It's a word only after a function's parameters and any
    ## return type.
    def at_fails(self) -> bool:
        self.peek() == .Name("fails")

    ## `fails LoadError`, or `fails ParseError | RangeError`: the errors after `fails`. Several
    ## are one written type named `|`.
    def fails_type(ref self) -> TypeExpr fails Diagnostic:
        _ = self.advance()
        self.type_expr()?

    ## A type, or several joined by `|`: a union, like `Circle | Square`, or the errors after
    ## `fails` or in `Result[int, A | B]`. Either is one written type named `|`.
    def type_expr(ref self) -> TypeExpr fails Diagnostic:
        first = self.member_type()?
        if not self.at_punct("|"):
            return first
        mut members = [first]
        while self.eat_punct("|"):
            members.append(self.member_type()?)
        TypeExpr(name="|", args=members, optional=False, span=first.span.to(self.prev_span()))

    ## One type with no `|` around it, unless it's in parentheses, as in `(Circle | Square)?`.
    def member_type(ref self) -> TypeExpr fails Diagnostic:
        start = self.span()
        # `shared Scores`: a value many tasks can reach, each inside a `lock`. A `?` after it
        # makes the shared value optional: `shared Scores?` is `(shared Scores)?`.
        if self.at_soft("shared") and (is_name(self.peek_at(1)) or self.peek_at(1) == .Punct("(")):
            _ = self.advance()
            held = self.member_type()?
            span = start.to(self.prev_span())
            return TypeExpr(name="shared", args=[copy(held, optional=False)], optional=held.optional, span=span)
        mut args = []
        mut name = ""
        size = array_size(self.peek())
        if self.eat_keyword("None"):
            name = "None"
        elif size is not None:
            # An array's size: `16` in `array[float, 16]`.
            _ = self.advance()
            name = f"{size}"
        elif self.eat_punct("("):
            while not self.at_punct(")"):
                args.append(self.type_expr()?)
                if not self.eat_punct(","):
                    break
            _ = self.expect_punct(")")?
            # `(Circle | Square)?`: a union in parentheses is the union, so it can be optional, as
            # is `(shared Scores)?`.
            if args.len() == 1 and (args[0].name == "|" or args[0].name == "shared") and not self.at_punct("->"):
                optional = self.eat_punct("?")
                return copy(args[0], optional=optional, span=start.to(self.prev_span()))
            # `(int, str) -> bool`: a function type, its return type last. One that can fail
            # says so, as in `(str) -> int fails ParseError`, which is written in as its own
            # `fails` type holding the return type and the errors.
            if self.eat_punct("->"):
                returns = self.type_expr()?
                if self.at_fails():
                    errors = self.fails_type()?
                    span = returns.span.to(errors.span)
                    args.append(TypeExpr(name="fails", args=[returns, errors], optional=False, span=span))
                else:
                    args.append(returns)
                return TypeExpr(name="->", args=args, optional=False, span=start.to(self.prev_span()))
            name = "tuple"
        else:
            # `physics.Body`, a type from a module imported whole.
            name = self.name("a type")?
            while self.eat_punct("."):
                name += "." + self.name("a type")?
        if self.eat_punct("["):
            args.append(self.type_expr()?)
            while self.eat_punct(","):
                args.append(self.type_expr()?)
            _ = self.expect_punct("]")?
        optional = self.eat_punct("?")
        TypeExpr(name=name, args=args, optional=optional, span=start.to(self.prev_span()))

## The number a token is, when it can be an array's size in a type.
def array_size(tok: Tok) -> int?:
    match tok:
        case .Int(value): value
        case _: None

## Whether a token is a keyword that can name a field, like `type`.
def is_field_word(tok: Tok) -> bool:
    match tok:
        case .Keyword(word): not is_reserved(word)
        case _: False

def is_name(tok: Tok) -> bool:
    match tok:
        case .Name(_): True
        case _: False

def is_keyword_tok(tok: Tok) -> bool:
    match tok:
        case .Keyword(_): True
        case _: False

def is_str(tok: Tok) -> bool:
    match tok:
        case .Str(_): True
        case _: False

## How an error message names a token.
def describe(tok: Tok) -> str:
    match tok:
        case .Name(name): f"`{name}`"
        case .Int(_): "a number"
        case .Float(_): "a number"
        case .Duration(_): "a duration"
        case .Str(_): "a string"
        case .FStr(_) | .TStr(_): "a string"
        case .Keyword(word): f"`{word}`"
        case .Punct(text): f"`{text}`"
        case .Newline: "the end of the line"
        case .Indent: "an indented line"
        case .Dedent: "the end of the block"
        case .Eof: "the end of the file"

## A statement at the top level of a file, which has to be a constant: `NAME = value`.
def constant(stmt: Stmt) -> Item fails Diagnostic:
    match stmt.kind:
        case .Assign(target, op, value, declare_mut, ty):
            if declare_mut:
                fail Diagnostic(
                    message="there's no `mut` at the top level of a file, so there's no state shared between functions",
                    span=stmt.span,
                    help="make it a constant by leaving out `mut`, or keep the state in `main` and pass it on",
                )
            if op is None:
                match target.kind:
                    case .Name(name): return .Const(name, ty, value, stmt.span)
                    case _: fail Diagnostic(message="a constant is one name, like `LIMIT = 10`", span=target.span)
        case _: pass
    fail Diagnostic(
        message="only declarations and constants can go at the top level of a file",
        span=stmt.span,
        help="put this code inside `def main(stdout: Stdout):`",
    )

## A field with no default after one with a default. Fields, like parameters, put the ones with
## defaults last, so a value given by position never lands in a defaulted one.
def default_comes_last(earlier: list[Field], field: Field) fails Diagnostic:
    if field.default is None and any(other.default is not None for other in earlier):
        fail no_default_after_defaults(field.name, field.span)

def no_default_after_defaults(name: str, span: Span) -> Diagnostic:
    Diagnostic(
        message=f"`{name}` has no default, so it has to come before the ones that do",
        span=span,
        help="put the fields and parameters with defaults after all the ones without",
    )
