# `json.dumps(order)` of a struct with two ints and a str, done OPS times on inputs that vary.
# `fennec-bench ops` counts its instructions per operation beside its Rust twin's.

from std import json

OPS = 20_000

struct Order:
    user: int
    item: str
    quantity: int

def main(stdout: Stdout, args: Args):
    # No arguments are given, so this is 0, but the compiler can't know it.
    shift = len(args)
    orders = [Order(user=i, item=f"arrow-{i}", quantity=i + 1) for i in range(shift, shift + 16)]
    mut total = 0
    for at in range(OPS):
        text = json.dumps(orders[(at + shift) % 16])
        total += len(text)
    stdout.print(total)
    return
