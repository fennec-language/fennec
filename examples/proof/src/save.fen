## Saving a battle to JSON and loading it back. JSON holds the whole world as it is: the
## `Table`s with their slots, every `Id`, the enums, and the map's grid. So every `Id` that
## was saved finds the same unit once it's loaded. The map's links come from its grid, so
## they're left out with `@skip` and loading works them out again.

from std import json

import map
from units import Item, World

## The world as JSON text.
def dumps(world: World) -> str:
    return json.dumps(world)

## A world from JSON text that `dumps` wrote.
def loads(text: str) -> World fails ParseError:
    mut world = json.loads[World](text)?
    world.field = map.Map.of(world.field.tiles)
    return world

test "a saved world loads back the same":
    mut world = World(field=map.Map.drawn(["...", "^~."]))
    a = world.spawn("ash", .Red, .Soldier, (0, 0))
    b = world.spawn("vex", .Blue, .Archer, (2, 0))
    c = world.spawn("kit", .Red, .Medic, (1, 0))
    _ = world.form_squad("first", [a, c], (0, 1))
    world.units[a].target = b
    world.units[b].health = 20
    world.units[c].items = [Item(name="bandage", heals=15)]
    text = dumps(world)
    loaded = loads(text)?
    assert dumps(loaded) == text
    assert len(loaded.units) == 3 and len(loaded.squads) == 1
    # The loaded world's `Id`s find the same units. Those from before the load are another
    # `Table`'s, so the loaded ones are taken in order.
    ids = loaded.units.ids()
    ash = ids[0]
    vex = ids[1]
    kit = ids[2]
    assert loaded.units[ash].target == vex
    assert loaded.units[kit].following == ash
    assert loaded.units[kit].items == [Item(name="bandage", heals=15)]
    assert loaded.field.drawing() == ["...", "^~."]
    # The links weren't saved, but loading worked them out again.
    assert "links" not in text
    assert loaded.field.next_to((0, 0)) == world.field.next_to((0, 0))
