## Statements and blocks. Mirrors `crates/syntax/src/parser/stmt.rs`.

from ast import Arg, BinOp, Case, CompKind, Expr, ExprKind, FStrPart, Field, FnDef, Generic, Import, Interface, Item, MatchArm, Module, Param, Pattern, Stmt, StmtKind, TestDef, TypeDef, TypeExpr, UnaryOp, WithName
from parser import Parser, is_name
from parser.expr import leaving_match
from span import Diagnostic, Span
from token import Tok, is_reserved

extend Parser:
    ## The body after a `:`: an indented block, or one simple statement on the same line.
    def block(ref self) -> list[Stmt] fails Diagnostic:
        if not self.at(.Newline): return [self.simple_stmt()?]
        self.expect_block_start()?
        mut stmts = []
        while not self.eat(.Dedent) and not self.at(.Eof):
            stmts.append(self.stmt()?)
        return stmts

    def stmt(ref self) -> Stmt fails Diagnostic:
        if self.at_keyword("if"): return self.if_stmt()?
        if self.at_keyword("while"): return self.while_stmt()?
        if self.at_keyword("for"): return self.for_stmt()?
        if self.at_keyword("with"): return self.with_stmt(False)?
        # `lend value`, or `lend value else:` with a block, in a `with` source.
        if self.at_soft("lend") and starts_value(self.peek_at(1)): return self.lend_stmt()?
        # `lock scores as ref current:`, where a name follows `lock`.
        if self.at_soft("lock") and is_name(self.peek_at(1)): return self.with_stmt(True)?
        if self.at_keyword("except"):
            fail Diagnostic(
                message="`except` goes after the call it handles",
                span=self.span(),
                help="write it on the call's line, as `x = f() except why:`, with the block under it",
            )
        if self.at_keyword("def"):
            function = self.function()?
            return Stmt(kind=.Def(function), span=function.span)
        return self.simple_stmt()?

    def simple_stmt(ref self) -> Stmt fails Diagnostic:
        start = self.span()
        kind = match self.peek():
            case .Keyword(word):
                self.keyword_stmt(word)?
            case .Name(word):
                if self.is_python_only(word): fail python_only(word, start)
                # `shared scores = Scores()`: a plain value made `shared`, written out.
                if word == "shared" and is_name(self.peek_at(1)) and self.peek_at(2) == .Punct("="):
                    declared = self.shared_declaration()?
                    return self.finished(declared, start)?
                self.expr_or_assign()?
            case _:
                self.expr_or_assign()?
        span = start.to(self.prev_span())
        self.end_line()?
        return Stmt(kind=kind, span=span)

    ## A simple statement that starts with the keyword `word`.
    def keyword_stmt(ref self, word: str) -> StmtKind fails Diagnostic:
        if word == "mut": return self.mut_declaration()?
        if word == "ref": return self.ref_declaration()?
        if word not in ["return", "fail", "yield", "assert", "break", "continue", "pass"]:
            return self.expr_or_assign()?
        _ = self.advance()
        match word:
            case "return":
                if self.at(.Newline) or self.at(.Eof) or self.at(.Dedent): return .Return(None)
                self.value_at_top = True
                return .Return(self.expr()?)
            case "fail":
                return .Fail(self.expr()?)
            case "yield":
                return .Yield(self.expr()?)
            case "assert":
                return self.asserted()?
            case "break":
                return .Break
            case "continue":
                return .Continue
            case _:
                return .Pass

    ## `raise x`, `try:` and `except x:` at the start of a statement: Python habits Fennec
    ## catches with a pointer to what to write instead.
    def is_python_only(self, word: str) -> bool:
        return (
            word in ["raise", "try", "except", "finally"]
            and not (self.peek_at(1) in [.Punct("="), .Punct("."), .Punct("("), .Punct("[")])
        )

    ## `lend value`, or `lend value else:` and the block that runs when the caller's fails.
    def lend_stmt(ref self) -> Stmt fails Diagnostic:
        start = self.advance().span
        value = self.or_expr()?
        mut otherwise = list[Stmt]()
        if self.eat_keyword("else") or self.eat_keyword("except"):
            _ = self.expect_punct(":")?
            otherwise = self.block()?
        else:
            self.end_line()?
        return Stmt(kind=.Lend(value, otherwise=otherwise), span=start.to(self.prev_span()))

    ## `shared name = value`, written in as `name: shared = value`: a type of `shared` with
    ## nothing in its brackets, which takes the value's type.
    def shared_declaration(ref self) -> StmtKind fails Diagnostic:
        word = self.advance().span
        at = self.span()
        name = self.name("a name after `shared`")?
        target = Expr(kind=.Name(name), span=at)
        _ = self.expect_punct("=")?
        self.value_at_top = True
        value = self.expr()?
        ty = TypeExpr(name="shared", args=[], optional=False, span=word)
        return .Assign(target, None, value, declare_mut=False, ty=ty)

    ## `ref unit = units[at]`, written in as `unit: ref = units[at]`: a type of `ref` with
    ## nothing in its brackets, which names the place for the rest of the block.
    def ref_declaration(ref self) -> StmtKind fails Diagnostic:
        word = self.advance().span
        at = self.span()
        message = "`ref` declares a name for a place, like `ref unit = units[at]`"
        if not is_name(self.peek()): fail Diagnostic(message=message, span=at)
        name = self.name("a name after `ref`")?
        target = Expr(kind=.Name(name), span=at)
        if self.peek() != .Punct("="): fail Diagnostic(message=message, span=word.to(at))
        _ = self.advance()
        value = self.expr()?
        ty = TypeExpr(name="ref", args=[], optional=False, span=word)
        return .Assign(target, None, value, declare_mut=False, ty=ty)

    ## A simple statement's end: its line, and its span from `start`.
    def finished(ref self, kind: StmtKind, start: Span) -> Stmt fails Diagnostic:
        span = start.to(self.prev_span())
        self.end_line()?
        return Stmt(kind=kind, span=span)

    def mut_declaration(ref self) -> StmtKind fails Diagnostic:
        _ = self.advance()
        target = self.expr()?
        if not is_name_expr(target):
            fail Diagnostic(
                message="`mut` declares a new name, like `mut count = 0`",
                span=target.span,
            )
        mut ty: TypeExpr? = None
        if self.eat_punct(":"):
            ty = self.type_expr()?
        _ = self.expect_punct("=")?
        value = self.assigned()?
        return .Assign(target, None, value, declare_mut=True, ty=ty)

    ## An expression on its own, or an assignment. `a, b = pair` unpacks a tuple.
    def expr_or_assign(ref self) -> StmtKind fails Diagnostic:
        self.value_at_top = True
        mut target = self.expr()?
        if is_name_expr(target) and self.eat_punct(":"):
            ty = self.type_expr()?
            _ = self.expect_punct("=")?
            value = self.assigned()?
            return .Assign(target, None, value, declare_mut=False, ty=ty)
        if self.at_punct(","):
            mut items = [target]
            while self.eat_punct(","):
                items.append(self.expr()?)
            mut span = self.prev_span()
            for item in items:
                span = span.to(item.span)
            target = Expr(kind=.Tuple(items), span=span)
        if not starts_assignment(self.peek()): return .Expr(target)
        op = assignment_op(self.advance().tok)
        if not is_assignable(target, op is None):
            fail Diagnostic(message="this can't be assigned to", span=target.span)
        value = self.assigned()? if op is None else self.expr()?
        return .Assign(target, op, value, declare_mut=False, ty=None)

    ## What `name = ...` is given: a value, or a `lock` block whose last line is the value, written
    ## in as the one case of a `match` over nothing, as an `else:` block is. An `if` over several
    ## lines gives no value.
    def assigned(ref self) -> Expr fails Diagnostic:
        if self.at_soft("lock") and is_name(self.peek_at(1)):
            start = self.span()
            locked = self.with_stmt(True)?
            self.block_ended = True
            return leaving_match(start, [locked], start.to(self.prev_span()))
        if self.at_keyword("if"):
            fail Diagnostic(
                message="`if` doesn't give a value over several lines",
                span=self.span(),
                help="write it on one line, `x = a if condition else b`, or use `x = match`, whose cases each give a value",
            )
        self.value_at_top = True
        return self.expr()?

    def if_stmt(ref self) -> Stmt fails Diagnostic:
        start = self.advance().span
        mut branches = [self.condition_and_block()?]
        mut otherwise = None
        while True:
            if self.eat_keyword("elif"):
                branches.append(self.condition_and_block()?)
            elif self.eat_keyword("else"):
                _ = self.expect_punct(":")?
                otherwise = self.block()?
                break
            else:
                break
        return Stmt(kind=.If(branches, otherwise), span=start.to(self.prev_span()))

    ## What `assert` checks: a condition, or `value fails Pattern`, written in as a `match` with one
    ## case and nothing in it, which nothing else parses to.
    def asserted(ref self) -> StmtKind fails Diagnostic:
        value = self.expr()?
        if not self.at_fails(): return .Assert(value)
        _ = self.advance()
        at = self.span()
        pattern = self.pattern()?
        arm = MatchArm(pattern=pattern, guard=None, body=[], span=at.to(self.prev_span()))
        return .Assert(Expr(kind=.Match(value, arms=[arm]), span=value.span.to(self.prev_span())))

    def condition_and_block(ref self) -> (Expr, list[Stmt]) fails Diagnostic:
        cond = self.expr()?
        if self.at_fails():
            fail Diagnostic(
                message="`fails` checks a failure only in `assert`",
                span=self.span(),
                help="to act on a failure, handle it with `except why:`, and tell failures apart with `case` arms under it",
            )
        _ = self.expect_punct(":")?
        return (cond, self.block()?)

    def while_stmt(ref self) -> Stmt fails Diagnostic:
        start = self.advance().span
        cond, body = self.condition_and_block()?
        return Stmt(kind=.While(cond, body), span=start.to(self.prev_span()))

    ## `for x in xs:`, `for ref x in xs:`, `for at, x in enumerate(xs):`, or with `ref` before
    ## the second name, `for at, ref x in enumerate(xs):`, which changes each item where it is.
    def for_stmt(ref self) -> Stmt fails Diagnostic:
        start = self.advance().span
        ref_first = self.eat_ref("a loop's name")
        mut names = [self.name("a loop variable")?]
        mut ref_second = False
        while self.eat_punct(","):
            if ref_first:
                fail Diagnostic(
                    message="`ref` goes before the name whose item changes",
                    span=start,
                    help="write it before the second name, like `for at, ref item in enumerate(items):`",
                )
            if len(names) == 1 and self.eat_ref("a loop's name"):
                ref_second = True
            names.append(self.name("a loop variable")?)
        if not self.eat_keyword("in"): fail self.unexpected("`in`")
        is_mut = ref_first or ref_second
        iter, body = self.condition_and_block()?
        return Stmt(kind=.For(names, is_mut, iter, body), span=start.to(self.prev_span()))

    ## `name` or `a, b`, then `in`.
    def loop_names(ref self) -> list[str] fails Diagnostic:
        mut names = [self.name("a loop variable")?]
        while self.eat_punct(","):
            names.append(self.name("a loop variable")?)
        if not self.eat_keyword("in"): fail self.unexpected("`in`")
        return names

    ## `with game as ref current:`, or several at once: `with a as ref x, b as ref y:`, or
    ## `with a, b as x, y:`, or one source's tuple split: `with conn.split() as reader, writer:`.
    ## `with a as x:`, or, for `lock`, `lock a as ref x:`, which takes `shared` values.
    def with_stmt(ref self, lock: bool) -> Stmt fails Diagnostic:
        start = self.advance().span
        mut items = [self.expr()?]
        while self.eat_punct(","):
            items.append(self.expr()?)
        mut names = list[WithName]()
        if self.eat_keyword("as"):
            while True:
                at = self.span()
                is_mut = self.eat_ref("a `with` name")
                name = self.name("a name after `as`")?
                names.append(WithName(name=name, is_mut=is_mut, span=at.to(self.prev_span())))
                if not self.eat_punct(","): break
                # `with a as ref x, b as ref y:`: the next value comes with its own name.
                if len(names) == len(items) and not self.at_with_name():
                    items.append(self.expr()?)
                    if not self.eat_keyword("as"): fail self.unexpected("`as` and a name for it")
        held = len(items)
        mut value = items[0]
        if held > 1:
            mut span = items[0].span
            for item in items:
                span = span.to(item.span)
            value = Expr(kind=.Tuple(items), span=span)
        # One value with several names splits what a source lends: `with conn.split() as r, w:`.
        if len(names) > 0 and len(names) != held and (held != 1 or lock):
            mut span = value.span
            for name in names:
                span = span.to(name.span)
            keyword = "lock" if lock else "with"
            example = "lock a, b as ref x, ref y:" if lock else "with a as ref x, b as ref y:"
            fail Diagnostic(
                message=f"this `{keyword}` holds {held} values but names {len(names)}",
                span=span,
                help=f"give each value its own name: `{example}`",
            )
        if lock and len(names) == 0:
            fail Diagnostic(
                message="a `lock` names what it holds, for the block",
                span=value.span,
                help="write `lock scores as current:` to read it, or `lock scores as ref current:` to change it",
            )
        _ = self.expect_punct(":")?
        body = self.block()?
        return Stmt(
            kind=.With(value, names=names, body=body, lock=lock),
            span=start.to(self.prev_span()),
        )

    ## Whether a name after `as` comes next, as in `with a, b as x, y:`, rather than another
    ## value: `ref` or `mut`, or a name and then `,` or `:`.
    def at_with_name(self) -> bool:
        if self.at_keyword("ref") or self.at_keyword("mut"): return True
        return (
            is_name(self.peek())
            and (self.peek_at(1) == .Punct(",") or self.peek_at(1) == .Punct(":"))
        )

def is_name_expr(expr: Expr) -> bool:
    match expr.kind:
        case .Name(_):
            return True
        case _:
            return False

## Whether `target` can go on the left of `=`, or of `+=` and the rest when not `plain`.
def is_assignable(target: Expr, plain: bool) -> bool:
    match target.kind:
        case .Name(_):
            return True
        case .Index(_, _):
            return True
        case .Attr(_, _, optional):
            return not optional
        case .Tuple(items):
            return plain and all(is_name_expr(item) for item in items)
        case _:
            return False

## The operator `+=` and the rest apply, or None for a plain `=`.
def assignment_op(tok: Tok) -> BinOp?:
    match tok:
        case .Punct("+="):
            return .Add
        case .Punct("-="):
            return .Sub
        case .Punct("*="):
            return .Mul
        case .Punct("/="):
            return .Div
        case .Punct("&="):
            return .BitAnd
        case .Punct("|="):
            return .BitOr
        case .Punct("^="):
            return .BitXor
        case .Punct("<<="):
            return .ShiftLeft
        case .Punct(">>="):
            return .ShiftRight
        case _:
            return None

## Whether a token makes what's before it the target of an assignment.
def starts_assignment(tok: Tok) -> bool:
    return tok == .Punct("=") or assignment_op(tok) is not None

def python_only(word: str, span: Span) -> Diagnostic:
    mut help = "Fennec has no exceptions: pass errors up with `?`, give a default with `else`, or handle them with `match`"
    if word == "raise":
        help = "Fennec has no exceptions: write `fail SomeError(...)`, which returns the error"
    elif word == "try" or word == "finally":
        help = "a failure is handled at the call: pass it up with `?`, or put `except` after the call, as `x = f() except why:`"
    return Diagnostic(message=f"Fennec doesn't have `{word}`", span=span, help=help)

## Whether a value can start with this token, so `lend` before it starts a `lend`.
def starts_value(tok: Tok) -> bool:
    match tok:
        case .Name(_):
            return True
        case .Int(_):
            return True
        case .Float(_):
            return True
        case .Duration(_):
            return True
        case .Str(_):
            return True
        case .FStr(_) | .TStr(_):
            return True
        case .Keyword(word):
            return word in ["True", "False", "None", "not"]
        case .Punct(text):
            return text in ["(", "[", "{", ".", "-"]
        case _:
            return False
