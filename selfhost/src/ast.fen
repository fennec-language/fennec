## The syntax tree the parser produces. Mirrors `crates/syntax/src/ast.rs`.

from span import Span

## A parsed `.fen` file.
struct Module:
    items: list[Item]

enum Item:
    Function(function: FnDef)
    Struct(type_def: TypeDef)
    Enum(type_def: TypeDef)
    Error(type_def: TypeDef)
    Interface(interface: Interface)
    ## `extend Parser:`: methods for a type declared elsewhere in the kit.
    Extend(extension: Extension)
    TypeAlias(name: str, ty: TypeExpr, span: Span)
    ## `NAME = value` at the top level of a file: a name that never changes.
    Const(name: str, ty: TypeExpr?, value: Expr, span: Span)
    Import(imported: Import)
    Test(test: TestDef)

struct FnDef:
    name: str
    ## Type parameters, like `T` in `def first[T](items: list[T]) -> T`.
    generics: list[Generic]
    params: list[Param]
    ret: TypeExpr?
    ## Where the `->` is, when there is one.
    arrow: Span?
    ## Empty only for a `def` written without one, which std's `@intrinsic` functions are.
    body: list[Stmt]
    span: Span
    ## The error it says it can fail with: `LoadError` in `-> float fails LoadError`.
    fails: TypeExpr? = None
    ## What's written above it, like `@intrinsic`.
    annotations = list[Annotation]()

## A type parameter, with the interfaces its types have to fit: `T`, or `T: Shape & Eq`.
struct Generic:
    name: str
    bounds: list[TypeExpr]
    span: Span

## Whether an expression is a plain value written out: a number, string, bool or `None`.
def is_plain_value(expr: Expr) -> bool:
    match expr.kind:
        case .Int(_) | .Float(_) | .Duration(_) | .Str(_) | .Bool(_) | .Nothing:
            return True
        case .Unary(op, operand):
            match operand.kind:
                case .Int(_) | .Float(_):
                    return op == .Neg
                case _:
                    return False
        # An enum case, like `Mode.fast`, or an empty collection.
        case .Attr(object, _, optional):
            match object.kind:
                case .Name(_):
                    return not optional
                case _:
                    return False
        case .List(items):
            return len(items) == 0
        case .Dict(pairs):
            return len(pairs) == 0
        # A type made with its type arguments, like `Packed[int]()`.
        case .Call(callee, args):
            match callee.kind:
                case .Index(object, _):
                    match object.kind:
                        case .Name(_):
                            return all(not arg.is_mut and is_plain_value(arg.value) for arg in args)
                        case _:
                            return False
                case _:
                    return False
        case _:
            return False

struct Param:
    name: str
    ## Missing only for `self`.
    ty: TypeExpr?
    is_mut: bool
    is_self: bool
    ## The plain value it has when a call leaves it out, which is passed by name if at all.
    default: Expr?
    span: Span

## A written type, like `int`, `list[str]`, `(int, int)` or `Enemy?`.
struct TypeExpr:
    name: str
    args: list[TypeExpr]
    optional: bool
    span: Span

## A struct, an error, or an enum. Enums have cases; structs and errors have fields.
struct TypeDef:
    name: str
    ## Type parameters, like `T` in `struct Deque[T]:`.
    generics: list[Generic]
    span: Span
    fields = list[Field]()
    cases = list[Case]()
    methods = list[FnDef]()
    ## Whether it's a `shared` type: a counted handle to one cell, whose methods lock it.
    shared = False

struct Field:
    name: str
    ty: TypeExpr?
    default: Expr?
    ## The `where` rule a value of this field must follow.
    rule: Expr?
    span: Span
    ## What's written above it, like `@skip`: data, never a change to the field.
    annotations = list[Annotation]()

## `@name` or `@name(args)` above a field.
struct Annotation:
    name: str
    args: list[Arg]
    span: Span

## A name after a `with`'s `as`.
struct WithName:
    name: str
    is_mut: bool
    span: Span

struct Case:
    name: str
    fields: list[Field]
    span: Span

struct Interface:
    name: str
    methods: list[FnDef]
    span: Span

## Methods added to a type outside its declaration. `span` covers `extend Name[T]`.
struct Extension:
    name: str
    ## A generic type's parameters, like `T` in `extend list[T: Eq]:`.
    generics: list[Generic]
    methods: list[FnDef]
    span: Span

struct Import:
    module: list[str]
    names: list[str]
    ## The name each of `names` is bound under, when `as` renames it. One per name.
    aliases: list[str?]
    ## The name a whole module is bound under, from `import game.physics as physics`.
    alias: str?
    span: Span

## `test "name":`, a test that names its capabilities `test "name"(fs: Fs):`, a property test
## `test "name" for items: list[int]:`, or `bench "name":`.
struct TestDef:
    name: str
    capabilities: list[Param]
    inputs: list[Param]
    body: list[Stmt]
    bench: bool
    span: Span

struct Stmt:
    kind: StmtKind
    span: Span

enum StmtKind:
    Expr(expr: Expr)
    ## `name = value`, `mut name = value`, `a, b = pair`, `target op= value`, and
    ## `name: type = value`, which declares a name with its type written.
    Assign(target: Expr, op: BinOp?, value: Expr, declare_mut: bool, ty: TypeExpr?)
    If(branches: list[(Expr, list[Stmt])], otherwise: list[Stmt]?)
    While(cond: Expr, body: list[Stmt])
    For(names: list[str], is_mut: bool, iter: Expr, body: list[Stmt])
    Return(value: Expr?)
    Fail(value: Expr)
    Yield(value: Expr)
    Assert(value: Expr)
    ## `with value as name:`, or `with a, b as ref x, ref y:`, whose `value` is the tuple of
    ## what it holds and which names each one.
    ## With `lock`, `lock value as ref name:`, which reaches a `shared` value: `name` is what it
    ## holds, for the block.
    With(value: Expr, names: list[WithName], body: list[Stmt], lock: bool)
    Def(function: FnDef)
    Break
    Continue
    Pass
    ## `lend value`, in a function that gives back `with T`: the caller's `with` block runs
    ## here. `otherwise` is the `else:` block, which runs when the caller's block fails.
    Lend(value: Expr, otherwise: list[Stmt])

struct Expr:
    kind: ExprKind
    span: Span

enum ExprKind:
    Int(value: int)
    Float(value: float)
    Str(text: str)
    FStr(parts: list[FStrPart])
    Bool(value: bool)
    ## The `None` literal. An enum case can't be called `None`.
    Nothing
    Name(name: str)
    ## `.Circle`: an enum case of whatever enum has a case with this name.
    Variant(name: str)
    List(items: list[Expr])
    Tuple(items: list[Expr])
    Dict(pairs: list[(Expr, Expr)])
    Set(items: list[Expr])
    ## `[elem for a, b in iter if cond]`, generator expressions, and set and dict comprehensions.
    Comprehension(
        kind: CompKind,
        elem: Expr,
        value: Expr?,
        names: list[str],
        iter: Expr,
        cond: Expr?,
    )
    Unary(op: UnaryOp, operand: Expr)
    Binary(op: BinOp, lhs: Expr, rhs: Expr)
    ## `then if cond else otherwise`.
    Cond(then: Expr, cond: Expr, otherwise: Expr)
    ## `value else default`: the value, or the default if it's None or an error.
    ## `value except why:` is the same, handling only a failure: `is_except` says which was written.
    Else(value: Expr, default: Expr, is_except: bool = False)
    ## `value?`, passing an error or None up; `value? from Context(...)` wraps the error.
    Try(value: Expr, context: Expr?)
    Call(callee: Expr, args: list[Arg])
    Attr(object: Expr, name: str, optional: bool)
    Index(object: Expr, index: Expr)
    Slice(object: Expr, start: Expr?, end: Expr?)
    ## `x => body` or `(a, b) => body`.
    Lambda(params: list[str], body: Expr)
    Match(subject: Expr, arms: list[MatchArm])
    ## A duration literal, like `30s`, in nanoseconds: a `Duration` from `std.time`. It comes
    ## last so the cases before it keep the numbers the embedding gives them.
    Duration(nanos: int)
    ## A file's bytes, read when the program was loaded: what `embed_file("path")` becomes.
    Bytes(data: bytes)

enum CompKind:
    List
    ## A generator expression passed straight to a call, like `sum(x for x in xs)`.
    Generator
    Set
    Dict

struct MatchArm:
    pattern: Pattern
    ## `if condition` after the pattern: the arm is taken only when it's true.
    guard: Expr?
    body: list[Stmt]
    span: Span

enum Pattern:
    Wildcard
    Bind(name: str)
    ## `ref clicks` in `case .Button(ref clicks):`: a name for the field itself.
    RefBind(name: str)
    Literal(expr: Expr)
    ## `.Circle(radius)` (`dotted`), or `NotFound(path)`, `Ok(value)`, `Err(error)`. Written
    ## by name, as `IoError(reason=r)`, `fields` names each of `args`.
    Variant(name: str, dotted: bool, args: list[Pattern], fields: list[str])
    Tuple(items: list[Pattern])
    ## `.Int(_) | .Float(_)`: any of the alternatives, each binding the same names.
    Or(alternatives: list[Pattern])

enum FStrPart:
    Text(text: str)
    Code(expr: Expr, spec: str?)

## A call argument: `value`, `name=value` or `ref name`.
struct Arg:
    name: str?
    is_mut: bool
    value: Expr

enum UnaryOp:
    Neg
    Not
    BitNot

    def symbol(self) -> str:
        match self:
            case .Neg:
                return "-"
            case .Not:
                return "not"
            case .BitNot:
                return "~"

enum BinOp:
    Add
    Sub
    Mul
    Div
    FloorDiv
    Mod
    Pow
    Eq
    NotEq
    Lt
    LtEq
    Gt
    GtEq
    And
    Or
    In
    NotIn
    Is
    IsNot
    BitAnd
    BitOr
    BitXor
    ShiftLeft
    ShiftRight

    def symbol(self) -> str:
        match self:
            case .Add:
                return "+"
            case .Sub:
                return "-"
            case .Mul:
                return "*"
            case .Div:
                return "/"
            case .FloorDiv:
                return "//"
            case .Mod:
                return "%"
            case .Pow:
                return "**"
            case .Eq:
                return "=="
            case .NotEq:
                return "!="
            case .Lt:
                return "<"
            case .LtEq:
                return "<="
            case .Gt:
                return ">"
            case .GtEq:
                return ">="
            case .And:
                return "and"
            case .Or:
                return "or"
            case .In:
                return "in"
            case .NotIn:
                return "not in"
            case .Is:
                return "is"
            case .IsNot:
                return "is not"
            case .BitAnd:
                return "&"
            case .BitOr:
                return "|"
            case .BitXor:
                return "^"
            case .ShiftLeft:
                return "<<"
            case .ShiftRight:
                return ">>"
