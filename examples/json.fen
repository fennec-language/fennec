from std.json import loads, dumps, ParseError

struct Settings:
    volume = 0.8
    fullscreen = False
    keys = ["w", "a", "s", "d"]

def describe(text: str):
    match loads(text):
        case Ok(value): f"read {dumps(value)}"
        case ParseError(message): f"couldn't read it: {message}"

def main(stdout: Stdout):
    text = "\n".join([
        "{",
        "  \"name\": \"Ash\",",
        "  \"level\": 7,",
        "  \"speed\": 2.5,",
        "  \"items\": [\"torch\", \"rope\"],",
        "  \"pet\": null,",
        "  \"alive\": true",
        "}",
    ])
    player = loads(text)?
    stdout.print(player["name"], "is level", player["level"] + 1, "and moves at", player["speed"])
    for item in player["items"]:
        stdout.print("carries", item)
    stdout.print(player["pet"] is None, player["alive"])

    stdout.print(dumps(player))
    stdout.print(dumps(Settings(), indent=2))
    stdout.print(dumps([1, "two", 3.0, None, (4, 5), {"6": [], "7": {}}]))
    stdout.print(dumps("quotes \" and \\ and\nnew lines"))
    stdout.print(loads(dumps(Settings()))? == loads(dumps(Settings(), indent=4))?)

    stdout.print(describe("[1, 2.5e3, -0.5, \"\\u00e9\"]"))
    stdout.print(describe("[1, 2,]"))
    stdout.print(describe("{\"a\": 1,\n \"b\" 2}"))
    stdout.print(describe("\"never ends"))
    stdout.print(describe("tru"))
    match loads("[\n  1,\n  oops\n]"):
        case ParseError(_, line, column): stdout.print(f"the problem is on line {line}, column {column}")
        case Ok(value): stdout.print(value)
