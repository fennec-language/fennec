## A failure of the file system or a stream, with a case for each way a caller might handle
## differently, each saying what went wrong in `reason`. `message()` gives it.
export error IoError:
    ## Nothing is at the path.
    NotFound(reason: str)
    ## The system, or an `Fs` narrowed with `only`, won't let the program do that there.
    PermissionDenied(reason: str)
    ## Something is at the path already.
    AlreadyExists(reason: str)
    ## Any other failure, said in words.
    Other(reason: str)

    ## What went wrong, in words.
    def message(self) -> str:
        return match self:
            case NotFound(reason) | PermissionDenied(reason):
                reason
            case AlreadyExists(reason) | Other(reason):
                reason

export error InvalidValue:
    message: str

export error ParseError:
    message: str
    line: int
    column: int

## What `run` fails with, or `None` when it doesn't, for a test that needs the failure as a value:
## `problem = failure_of(() => Time.parse(text)?)`. `assert Time.parse(text) fails ParseError()` is
## the usual way to check one. It's only for tests: anywhere else, `else as why:` names a failure
## where it happens.
export def failure_of[T, E](run: () -> T fails E) -> E?:
    run() except why:
        return why
    return None
