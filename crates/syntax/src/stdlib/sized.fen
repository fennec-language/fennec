        if whole < 0: return u16(0)
        if whole > 65535: return u16(65535)
        return u16(whole)

extend u32:
    ## The `int` `x` as a u32, or an `InvalidValue` when it doesn't fit. Convert another size
    ## with `int(x)` first.
    def from(x: int) -> u32 fails InvalidValue:
        if x < 0 or x > 4294967295:
            fail InvalidValue(message=f"{x} doesn't fit in u32, which holds 0 to 4294967295")
        return u32(x)

    ## The u32 `text` writes, or an `InvalidValue` when it isn't a whole number or doesn't fit.
    def parse(text: str) -> u32 fails InvalidValue:
        return u32.from(int(text)?)?

    ## `self + other`, wrapping round past either end, as a u32's bits do.
    def wrapping_add(self, other: u32) -> u32:
        return u32((int(self) + int(other)) % 4294967296)

    ## `self - other`, wrapping round past either end, as a u32's bits do.
    def wrapping_sub(self, other: u32) -> u32:
        return u32((int(self) - int(other)) % 4294967296)

    ## `self * other`, wrapping round past the end, as a u32's bits do.
    def wrapping_mul(self, other: u32) -> u32:
        # In two halves of `other`, so no product is past what an `int` holds.
        (a, b) = (int(self), int(other))
        high = a * (b >> 16) % 4294967296
        return u32((high * 65536 + a * (b & 65535)) % 4294967296)

    ## `self + other`, or the nearest end of u32 when it's past one.
    def saturating_add(self, other: u32) -> u32:
        whole = int(self) + int(other)
        if whole < 0: return u32(0)
        if whole > 4294967295: return u32(4294967295)
        return u32(whole)

    ## `self - other`, or the nearest end of u32 when it's past one.
    def saturating_sub(self, other: u32) -> u32:
        whole = int(self) - int(other)
        if whole < 0: return u32(0)
        if whole > 4294967295: return u32(4294967295)
        return u32(whole)

    ## `self * other`, or the largest u32 when it's past it.
    def saturating_mul(self, other: u32) -> u32:
        (a, b) = (int(self), int(other))
        # Checked by division first, so no product is past what an `int` holds.
        if a != 0 and b > 4294967295 // a: return u32(4294967295)
        return u32(a * b)

extend u64:
    ## The `int` `x` as a u64, or an `InvalidValue` when it's negative. Convert another size
    ## with `int(x)` first.
    def from(x: int) -> u64 fails InvalidValue:
        if x < 0:
            fail InvalidValue(
                message=f"{x} doesn't fit in u64, which holds 0 to 18446744073709551615",
            )
        return u64(x)

    ## The u64 `text` writes, or an `InvalidValue` when it isn't a whole number or doesn't fit.
    ## What's past the largest `int` is read a digit at a time.
    def parse(text: str) -> u64 fails InvalidValue:
        n = int(text) except problem:
            if not text.isdigit(): fail problem
            top = u64(9223372036854775807) * 2 + 1
            mut value = u64(0)
            for c in text:
                digit = u64(c.code() - 48)
                # Checked before it's multiplied, so it never goes past the top.
                if value > (top - digit) // 10:
                    fail InvalidValue(
                        message=f"{text} doesn't fit in u64, which holds 0 to 18446744073709551615",
                    )
                value = value * 10 + digit
            return value
        return u64.from(n)?

    ## `self + other`, wrapping round past the end, as a u64's bits do.
    def wrapping_add(self, other: u64) -> u64:
        top = u64(9223372036854775807) * 2 + 1
        if self > top - other: return self - (top - other) - 1
        return self + other

    ## `self - other`, wrapping round past 0, as a u64's bits do.
    def wrapping_sub(self, other: u64) -> u64:
        top = u64(9223372036854775807) * 2 + 1
        if other > self: return top - (other - self) + 1
        return self - other

    ## `self * other`, wrapping round past the end, as a u64's bits do.
    def wrapping_mul(self, other: u64) -> u64:
        # In 32-bit halves, so no product or sum is past what a u64 holds.
        low = u64(4294967295)
        (a_low, a_high) = (self & low, self >> 32)
        (b_low, b_high) = (other & low, other >> 32)
        crossed = ((a_high * b_low) & low) + ((a_low * b_high) & low)
        return (a_low * b_low).wrapping_add((crossed & low) << 32)

    ## `self + other`, or the largest u64 when it's past it.
    def saturating_add(self, other: u64) -> u64:
        top = u64(9223372036854775807) * 2 + 1
        if self > top - other: return top
        return self + other

    ## `self - other`, or 0 when it's below it.
    def saturating_sub(self, other: u64) -> u64:
        if other > self: return u64(0)
        return self - other

    ## `self * other`, or the largest u64 when it's past it.
    def saturating_mul(self, other: u64) -> u64:
        top = u64(9223372036854775807) * 2 + 1
        # Checked by division first, so no product is past the top.
        if self != 0 and other > top // self: return top
        return self * other
