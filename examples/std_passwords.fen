# A password is kept as `hash_password` gives it: Argon2id, stretched through 19 MiB under a fresh
# salt, written with its settings so they can be raised later. `check_password` says whether a
# password is the one a stored hash was made from, and refuses a stored hash that isn't one, or
# whose settings are below OWASP's floor or past what's worth the memory.
from std.crypto import PasswordError, Secret, check_password, hash_password

test "a hash checks its own password and no other"(entropy: Entropy):
    stored = hash_password(Secret.of("correct horse battery staple"), entropy)
    assert stored.startswith("$argon2id$v=19$m=19456,t=2,p=1$")
    assert check_password(Secret.of("correct horse battery staple"), stored)?
    assert not check_password(Secret.of("correct horse battery stapler"), stored)?
    assert not check_password(Secret.of(""), stored)?

test "the same password hashes differently each time, under its own salt"(entropy: Entropy):
    first = hash_password(Secret.of("hunter2"), entropy)
    second = hash_password(Secret.of("hunter2"), entropy)
    assert first != second
    assert (
        check_password(Secret.of("hunter2"), first)?
        and check_password(Secret.of("hunter2"), second)?
    )

test "a stored hash that isn't one fails, saying why":
    assert check_password(Secret.of("pw"), "hunter2") fails PasswordError()
    assert check_password(Secret.of("pw"), "$2b$12$abcdefghijklmnopqrstuv") fails PasswordError()

test "settings below OWASP's floor or past the memory worth spending are refused":
    salt_and_hash = "c2FsdHNhbHRzYWx0c2FsdA$AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    weak = f"$argon2id$v=19$m=4096,t=3,p=1${salt_and_hash}"
    assert check_password(Secret.of("pw"), weak) fails PasswordError()
    huge = f"$argon2id$v=19$m=4194304,t=2,p=1${salt_and_hash}"
    assert check_password(Secret.of("pw"), huge) fails PasswordError()

def main(entropy: Entropy, stdout: Stdout):
    stored = hash_password(Secret.of("correct horse battery staple"), entropy)
    stdout.print(stored.startswith("$argon2id$v=19$m=19456,t=2,p=1$"), len(stored))
    for tried in ["correct horse battery staple", "correct horse"]:
        right = check_password(Secret.of(tried), stored) except why:
            stdout.print(f"can't check: {why.message()}")
            return
        stdout.print(tried, right)
    _ = check_password(
        Secret.of("pw"),
        "$argon2id$v=19$m=4096,t=3,p=1$c2FsdHNhbHRzYWx0c2FsdA$AAAA",
    ) except why:
        stdout.print(why.message())
        False
