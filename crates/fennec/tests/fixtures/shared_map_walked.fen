# A map in a cell walked by one name while another changes it: the walk goes through what it read
# under the lock, and each change takes the lock again.

from std.collections import Id, Table

struct Log:
    map = Table[str]()

    def add(ref self, name: str):
        self.map.add(name)

    def drop(ref self, id: Id[str]):
        self.map.remove(id)

def length(log: shared Log) -> int:
    lock log as held:
        return len(held.map)

def adding(log: shared Log, name: str):
    lock log as ref held:
        held.add(name)

def through_names(log: shared Log, other: shared Log, ref said: list[str]):
    mut walked = list[(Id[str], str)]()
    lock log as held:
        walked = [(id, name) for id, name in held.map.items()]
    for id, name in walked:
        lock other as ref changing:
            changing.drop(id)
        said.append(f"{name} {length(log)} {length(other)}")
    mut names = list[str]()
    lock log as held:
        names = [name for name in held.map.values()]
    for name in names:
        adding(other, name=name + "!")
        said.append(f"{name} {length(log)}")

def main(stdout: Stdout):
    shared log = Log()
    adding(log, name="a")
    adding(log, name="b")
    adding(log, name="c")
    mut said = list[str]()
    through_names(log, log, ref said)
    stdout.print(said, length(log))
    second = log
    adding(log, name="x")
    adding(log, name="y")
    mut more = list[str]()
    through_names(log, second, ref more)
    stdout.print(more, length(log))
