## `bytes`'s methods written in Fennec.
extend bytes:
    def serialize(self, ref out: Serializer):
        out.bytes(self)

    def deserialize(ref src: Deserializer) -> bytes fails ParseError:
        return src.bytes()?

## `bytes`' methods the engines provide. Each is declared here for its signature and its doc, and a
## test holds it to the checker's own.
extend bytes:
    ## How many bytes there are.
    @intrinsic
    def len(self) -> int

    ## The bytes read as UTF-8 text. Bytes that aren't UTF-8 fail with an `InvalidValue`.
    @intrinsic
    def decode(self) -> str fails InvalidValue

    ## Each byte as two lower-case hex digits, with `sep` between each two when it's given.
    @intrinsic
    def hex(self, sep: str? = None) -> str
