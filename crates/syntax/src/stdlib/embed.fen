## What `embed_folder("path")` gives: the files under a folder, baked into the program when it's
## built, each by its path from the folder, always written with `/`, in sorted path order. It
## can't be changed, and nothing is copied when the program starts.
export struct EmbeddedFolder:
    _paths: list[str]
    _files: list[bytes]

    ## How many files it holds.
    def len(self) -> int:
        self._paths.len()

    ## The file at `path`, like `"css/app.css"`, or `None` when it holds none there.
    def get(self, path: str) -> bytes?:
        mut low = 0
        mut high = self._paths.len()
        while low < high:
            middle = (low + high) // 2
            if self._paths[middle] < path:
                low = middle + 1
            else:
                high = middle
        if low < self._paths.len() and self._paths[low] == path: return self._files[low]
        None

    ## Each file's path, in order.
    def keys(self) -> list[str]:
        self._paths

    ## Each file's bytes, in the order of their paths.
    def values(self) -> list[bytes]:
        self._files

    ## Each file's path and bytes, in order.
    def items(self) -> list[(str, bytes)]:
        [(self._paths[at], self._files[at]) for at in range(self._paths.len())]
