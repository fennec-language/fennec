# An interface says whether a method changes its value, and a method that does fits only `ref self`.

interface Source:
    def next(ref self) -> int

struct Count:
    left = 2

    def next(ref self) -> int:
        self.left -= 1
        return self.left

def two(ref source: Source) -> int:
    return source.next() + source.next()

def main(stdout: Stdout):
    mut counter = Count()
    kept = counter
    stdout.print(two(ref counter), counter.left, kept.left)
