## A failure of the file system or a stream, with a case for each way a caller might handle
## differently. Each but `Other` holds the path it was at, and `message()` says it in words.
##
## ```fennec
## assert fs.read_text("nowhere.txt") fails .NotFound(path="nowhere.txt")
## ```
export error IoError:
    ## Nothing is at the path.
    NotFound(path: str)
    ## Something won't let the program do that at the path: the system, said in `reason` as "the
    ## system won't allow it", or an `Fs` narrowed with `only` or `read_only`, saying why in its own
    ## words.
    PermissionDenied(path: str, reason: str)
    ## Something is at the path already.
    AlreadyExists(path: str)
    ## Any other failure, said in words.
    Other(reason: str)

    ## What went wrong, in words, with the path it was at.
    ##
    ## ```fennec
    ## said = fs.read_text("nowhere.txt") except why:
    ##     why.message()
    ## assert said == "nothing is at `nowhere.txt`"
    ## ```
    def message(self) -> str:
        return match self:
            case .NotFound(path):
                f"nothing is at `{path}`" if path != "" else "nothing is there"
            case .PermissionDenied(path, reason):
                f"`{path}`: {reason}" if path != "" else reason
            case .AlreadyExists(path):
                f"something is at `{path}` already" if path != "" else "something is there already"
            case .Other(reason):
                reason

## A value that isn't what was asked for, like text that isn't a number, with `message` saying why.
## ```fennec
## n = int.parse("seven") except why:
##     stdout.print(why.message)
##     0
## assert n == 0
## ```
## ```output
## "seven" isn't an int
## ```
export error InvalidValue:
    message: str

    ## Its `message`, which printing it prints.
    ## ```fennec
    ## n = int.parse("seven") except why:
    ##     stdout.print(f"not a number: {why}")
    ##     0
    ## assert n == 0
    ## ```
    ## ```output
    ## not a number: "seven" isn't an int
    ## ```
    def message(self) -> str:
        return self.message

## Text that isn't the format it was read as, with `message` saying why and `line` and `column`
## saying where.
## ```fennec
## from std import json
## items = json.loads[list[int]]("[1,\n x]") except why:
##     stdout.print(f"line {why.line}, column {why.column}")
##     list[int]()
## assert len(items) == 0
## ```
## ```output
## line 2, column 2
## ```
export error ParseError:
    message: str
    line: int
    column: int

    ## Its `message`, which printing it prints.
    ## ```fennec
    ## from std import json
    ## items = json.loads[list[int]]("[1, x]") except why:
    ##     stdout.print(why)
    ##     list[int]()
    ## assert len(items) == 0
    ## ```
    ## ```output
    ## `x` isn't a JSON value; the words JSON knows are true, false and null, at line 1, column 5
    ## ```
    def message(self) -> str:
        return self.message

## What `run` fails with, or `None` when it doesn't, for a test that needs the failure as a value:
## `problem = failure_of(() => Time.parse(text)?)`. `assert Time.parse(text) fails InvalidValue()` is
## the usual way to check one. It's only for tests: anywhere else, `except why:` names a failure
## where it happens.
##
## ```fennec
## problem = failure_of(() => int.parse("seven")?)
## assert problem is not None
## assert failure_of(() => int.parse("7")?) is None
## ```
export def failure_of[T, E](run: () -> T fails E) -> E?:
    _ = run() except why:
        return why
    return None
