from std.collections import Id
from std.intrinsics import stop, text_byte, text_of_code, text_part, text_size, type_name
from std.json import _IdsSeen, _article, _base64, _escaped, _float_text, _from_base64, _tables_in

## How deeply arrays and inline tables may nest, so bad input can't overflow the stack.
_MOST_DEEP = 500

## A value of a TOML document.
enum _Toml:
    Text(text: str)
    Int(n: int)
    Float(x: float)
    Bool(b: bool)
    List(items: list[_Toml])
    Table(table: _Table)
    ## An array of tables, from `[[name]]` headers.
    Tables(tables: list[_Table])

## A table, with how it came to exist while the document is read.
struct _Table:
    keys = list[str]()
    values = list[_Toml]()
    ## Defined by its own `[name]` header.
    header = False
    ## Made by a dotted key like `a.b = 1`.
    dotted = False
    ## Written whole on one line, so it's a value: nothing can add to it.
    inline = False

    def place_of(self, key: str) -> int:
        mut at = 0
        for name in self.keys:
            if name == key: return at
            at += 1
        -1

    def add(mut self, key: str, value: _Toml):
        self.keys.append(key)
        self.values.append(value)

def _joined(keys: list[str]) -> str:
    ".".join(keys)

## Reads a TOML document into its values.
struct _Parser:
    source: str
    at = 0

    def byte(self) -> int:
        text_byte(self.source, self.at)

    def starts(self, word: str) -> bool:
        for place in range(text_size(word)):
            if text_byte(self.source, self.at + place) != text_byte(word, place): return False
        True

    ## What's next, for a message: "`x`", or "the end of the text".
    def found(self) -> str:
        b = self.byte()
        if b < 0: return "the end of the text"
        if b == 10: return "the end of the line"
        mut size = 1
        if b >= 240:
            size = 4
        elif b >= 224:
            size = 3
        elif b >= 192:
            size = 2
        c = text_part(self.source, self.at, self.at + size)
        f"`{c}`"

    def bad(self, message: str) -> ParseError:
        self.bad_at(message, self.at)

    def bad_at(self, message: str, place: int) -> ParseError:
        mut line = 1
        mut column = 1
        mut at = 0
        while at < place:
            b = text_byte(self.source, at)
            if b == 10:
                line += 1
                column = 1
            elif b < 128 or b >= 192:
                column += 1
            at += 1
        ParseError(message=f"{message}, at line {line}, column {column}", line=line, column=column)

    def skip_spaces(mut self):
        while self.byte() == 32 or self.byte() == 9:
            self.at += 1

    def skip_comment(mut self):
        if self.byte() == 35:
            while self.byte() >= 0 and self.byte() != 10:
                self.at += 1

    ## Skips spaces, line breaks and comments, as between the items of a multi-line array.
    def skip_blank_lines(mut self):
        while True:
            b = self.byte()
            while b == 32 or b == 9 or b == 10 or b == 13 or b == 11 or b == 12:
                self.at += 1
                b = self.byte()
            if b != 35: return
            self.skip_comment()

    ## After a header or key/value pair, only spaces and a comment can come before the line ends.
    def end_of_line(mut self) fails ParseError:
        self.skip_spaces()
        self.skip_comment()
        if self.byte() == 13:
            self.at += 1
        if self.byte() == 10:
            self.at += 1
        elif self.byte() >= 0:
            fail self.bad(f"expected the end of the line, but found {self.found()}")

    def document(mut self) -> _Table fails ParseError:
        mut root = _Table()
        mut current = list[str]()
        while True:
            self.skip_blank_lines()
            b = self.byte()
            if b < 0: return root
            if b == 91:
                current = self.header(mut root)?
            else:
                at = self.at
                keys = self.key_path()?
                value = self.after_key(0)?
                _insert(mut root, current, 0, keys, value, (self, at))?
            self.end_of_line()?

    ## `= value`, after a key.
    def after_key(mut self, depth: int) -> _Toml fails ParseError:
        self.skip_spaces()
        if self.byte() != 61: fail self.bad(f"expected `=` after the key, but found {self.found()}")
        self.at += 1
        self.skip_spaces()
        self.value(depth)?

    ## `[a.b]` or `[[a.b]]`. Gives back the path of the table it starts.
    def header(mut self, mut root: _Table) -> list[str] fails ParseError:
        at = self.at
        self.at += 1
        array = self.byte() == 91
        if array:
            self.at += 1
        self.skip_spaces()
        keys = self.key_path()?
        self.skip_spaces()
        closing = "]]" if array else "]"
        if not self.starts(closing):
            fail self.bad(f"expected `{closing}` to end the header, but found {self.found()}")
        self.at += text_size(closing)
        _define(mut root, keys, 0, array, (self, at))?
        keys

    ## A key, or several joined by dots: `name`, `"quoted key"`, `kit.version`.
    def key_path(mut self) -> list[str] fails ParseError:
        mut keys = list[str]()
        while True:
            keys.append(self.simple_key()?)
            self.skip_spaces()
            if self.byte() != 46: return keys
            self.at += 1
            self.skip_spaces()

    def simple_key(mut self) -> str fails ParseError:
        b = self.byte()
        if b == 34: return self.basic_string()?
        if b == 39: return self.literal_string()?
        start = self.at
        mut c = b
        while (
            (c >= 97 and c <= 122)
            or (c >= 65 and c <= 90)
            or (c >= 48 and c <= 57)
            or c == 95
            or c == 45
        ):
            self.at += 1
            c = self.byte()
        if self.at == start: fail self.bad(f"expected a key, but found {self.found()}")
        text_part(self.source, start, self.at)

    def value(mut self, depth: int) -> _Toml fails ParseError:
        if depth > _MOST_DEEP:
            fail self.bad(f"arrays and tables nest more than {_MOST_DEEP} deep here")
        b = self.byte()
        if self.starts("\"\"\""): return .Text(text=self.multi_line(34)?)
        if self.starts("'''"): return .Text(text=self.multi_line(39)?)
        if b == 34: return .Text(text=self.basic_string()?)
        if b == 39: return .Text(text=self.literal_string()?)
        if b == 91: return self.array(depth)?
        if b == 123: return self.inline_table(depth)?
        if b >= 48 and b <= 57 and self.is_date_or_time(): return .Text(text=self.date_or_time()?)
        if (b >= 48 and b <= 57) or b == 43 or b == 45 or b == 105 or b == 110:
            return self.number()?
        if b == 116 or b == 102:
            at = self.at
            mut c = b
            while (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57):
                self.at += 1
                c = self.byte()
            word = text_part(self.source, at, self.at)
            if word == "true": return .Bool(b=True)
            if word == "false": return .Bool(b=False)
            fail self.bad_at(f"`{word}` isn't a TOML value", at)
        fail self.bad(f"expected a value, but found {self.found()}")

    ## `"text"`, with backslash escapes, on one line.
    def basic_string(mut self) -> str fails ParseError:
        start = self.at
        self.at += 1
        mut out = ""
        while True:
            b = self.byte()
            if b == 34:
                self.at += 1
                return out
            if b == 92:
                out += self.escape()?
            elif b == 10 or b == 13 or b < 0:
                fail self.bad_at(
                    "this string never ends on its line; use `\"\"\"` for text over several lines",
                    start,
                )
            else:
                out += self.plain_char()?

    ## `'text'`, taken exactly as written, on one line.
    def literal_string(mut self) -> str fails ParseError:
        start = self.at
        self.at += 1
        mut out = ""
        while True:
            b = self.byte()
            if b == 39:
                self.at += 1
                return out
            if b == 10 or b == 13 or b < 0:
                fail self.bad_at(
                    "this string never ends on its line; use `'''` for text over several lines",
                    start,
                )
            out += self.plain_char()?

    ## `"""text"""` or `'''text'''`. A line break right after the opening quotes is dropped.
    def multi_line(mut self, quote: int) -> str fails ParseError:
        start = self.at
        self.at += 3
        if self.starts("\r\n"):
            self.at += 2
        elif self.byte() == 10:
            self.at += 1
        mut out = ""
        while True:
            b = self.byte()
            if b == quote:
                mut quotes = 0
                while self.byte() == quote:
                    quotes += 1
                    self.at += 1
                if quotes >= 3:
                    if quotes > 5: fail self.bad("too many quotes end this string")
                    for _ in range(quotes - 3):
                        out += text_of_code(quote)
                    return out
                for _ in range(quotes):
                    out += text_of_code(quote)
            elif b == 92 and quote == 34:
                mut after = self.at + 1
                while text_byte(self.source, after) == 32 or text_byte(self.source, after) == 9:
                    after += 1
                if text_byte(self.source, after) == 10 or text_byte(self.source, after) == 13:
                    self.at = after
                    mut c = self.byte()
                    while c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12:
                        self.at += 1
                        c = self.byte()
                else:
                    out += self.escape()?
            elif b == 10 or b == 13:
                out += text_of_code(b)
                self.at += 1
            elif b < 0:
                fail self.bad_at("this string never ends", start)
            else:
                out += self.plain_char()?

    ## A character inside a string, which can't be a control character other than a tab.
    def plain_char(mut self) -> str fails ParseError:
        b = self.byte()
        if (
            (b < 32 and b != 9)
            or b == 127
            or (b == 194 and text_byte(self.source, self.at + 1) < 160)
        ):
            fail self.bad("a string can't hold a control character; write an escape like `\\u0007`")
        mut size = 1
        if b >= 240:
            size = 4
        elif b >= 224:
            size = 3
        elif b >= 192:
            size = 2
        part = text_part(self.source, self.at, self.at + size)
        self.at += size
        part

    def escape(mut self) -> str fails ParseError:
        at = self.at
        self.at += 1
        b = self.byte()
        if b < 0: fail self.bad_at("this string never ends", at)
        if b == 117 or b == 85:
            self.at += 1
            return self.hex_char(4 if b == 117 else 8)?
        self.at += 1
        match b:
            case 98:
                "\x08"
            case 116:
                "\t"
            case 110:
                "\n"
            case 102:
                "\x0c"
            case 114:
                "\r"
            case 101:
                "\x1b"
            case 34:
                "\""
            case 92:
                "\\"
            case _:
                self.at -= 1
                other = self.found()
                self.at += 1
                fail self.bad_at(f"`\\{other[1:-1]}` isn't a TOML escape", at)

    def hex_char(mut self, digits: int) -> str fails ParseError:
        start = self.at
        mut code = 0
        for _ in range(digits):
            b = self.byte()
            if b >= 48 and b <= 57:
                code = code * 16 + b - 48
            elif b >= 97 and b <= 102:
                code = code * 16 + b - 87
            elif b >= 65 and b <= 70:
                code = code * 16 + b - 55
            else:
                fail self.bad(f"`\\u` needs {digits} hex digits")
            self.at += 1
        if code > 1114111 or (code >= 55296 and code < 57344):
            hex = _hex_upper(code)
            fail self.bad_at(f"`{hex}` isn't a character", start)
        text_of_code(code)

    def array(mut self, depth: int) -> _Toml fails ParseError:
        self.at += 1
        mut items = list[_Toml]()
        while True:
            self.skip_blank_lines()
            if self.byte() == 93:
                self.at += 1
                return .List(items=items)
            items.append(self.value(depth + 1)?)
            self.skip_blank_lines()
            if self.byte() == 93:
                self.at += 1
                return .List(items=items)
            if self.byte() != 44:
                fail self.bad(f"expected `,` or `]` after the value, but found {self.found()}")
            self.at += 1

    ## `{ name = "fennec", version = "0.1" }`.
    def inline_table(mut self, depth: int) -> _Toml fails ParseError:
        self.at += 1
        mut table = _Table()
        self.skip_blank_lines()
        if self.byte() == 125:
            self.at += 1
            table.inline = True
            return .Table(table=table)
        while True:
            self.skip_blank_lines()
            at = self.at
            if depth >= _MOST_DEEP:
                fail self.bad(f"arrays and tables nest more than {_MOST_DEEP} deep here")
            keys = self.key_path()?
            item = self.after_key(depth)?
            _insert(mut table, list[str](), 0, keys, item, (self, at))?
            self.skip_blank_lines()
            if self.byte() == 125:
                self.at += 1
                table.inline = True
                return .Table(table=table)
            if self.byte() != 44:
                fail self.bad(f"expected `,` or `}}` after the value, but found {self.found()}")
            self.at += 1

    def digit_at(self, place: int) -> bool:
        b = text_byte(self.source, self.at + place)
        b >= 48 and b <= 57

    ## Whether a value starts like a date (`1979-05-27`) or a time (`07:32`).
    def is_date_or_time(self) -> bool:
        date = (
            self.digit_at(0)
            and self.digit_at(1)
            and self.digit_at(2)
            and self.digit_at(3)
            and text_byte(self.source, self.at + 4) == 45
        )
        date or (
            self.digit_at(0) and self.digit_at(1) and text_byte(self.source, self.at + 2) == 58
        )

    ## Reads exactly `width` digits making a number from `low` to `high`.
    def field(mut self, width: int, low: int, high: int) -> bool:
        mut n = 0
        for place in range(width):
            if not self.digit_at(place): return False
            n = n * 10 + text_byte(self.source, self.at + place) - 48
        self.at += width
        n >= low and n <= high

    ## A date, a time, or both, with an optional offset. Kept as written.
    def date_or_time(mut self) -> str fails ParseError:
        start = self.at
        if text_byte(self.source, self.at + 4) == 45:
            if not self.field(4, 0, 9999) or self.byte() != 45:
                fail self.bad_at("this isn't a valid date", start)
            self.at += 1
            if not self.field(2, 1, 12) or self.byte() != 45:
                fail self.bad_at("this isn't a valid date", start)
            self.at += 1
            if not self.field(2, 1, 31): fail self.bad_at("this isn't a valid date", start)
            b = self.byte()
            next_digit = self.digit_at(1)
            if not (b == 84 or b == 116 or (b == 32 and next_digit)):
                return text_part(self.source, start, self.at)
            self.at += 1
        if not self.field(2, 0, 23) or self.byte() != 58:
            fail self.bad_at("this isn't a valid time", start)
        self.at += 1
        if not self.field(2, 0, 59): fail self.bad_at("this isn't a valid time", start)
        if self.byte() == 58:
            self.at += 1
            if not self.field(2, 0, 60): fail self.bad_at("this isn't a valid time", start)
        if self.byte() == 46:
            self.at += 1
            place = self.at
            while self.digit_at(0):
                self.at += 1
            if self.at == place: fail self.bad_at("this isn't a valid time", start)
        b = self.byte()
        if b == 90 or b == 122:
            self.at += 1
        elif b == 43 or b == 45:
            self.at += 1
            if not self.field(2, 0, 23) or self.byte() != 58:
                fail self.bad_at("this isn't a valid time offset", start)
            self.at += 1
            if not self.field(2, 0, 59): fail self.bad_at("this isn't a valid time offset", start)
        text_part(self.source, start, self.at)

    def number(mut self) -> _Toml fails ParseError:
        at = self.at
        mut b = self.byte()
        while (
            (b >= 97 and b <= 122)
            or (b >= 65 and b <= 90)
            or (b >= 48 and b <= 57)
            or b == 95
            or b == 43
            or b == 45
            or b == 46
        ):
            self.at += 1
            b = self.byte()
        token = text_part(self.source, at, self.at)
        lead = text_byte(token, 0)
        signed = lead == 43 or lead == 45
        negative = lead == 45
        unsigned = text_part(token, 1 if signed else 0, text_size(token))
        unknown = f"`{token}` isn't a number TOML knows"
        if unsigned == "inf": return .Float(x=-1e308 * 10.0 if negative else 1e308 * 10.0)
        if unsigned == "nan": return .Float(x=1e308 * 10.0 - 1e308 * 10.0)
        if text_size(unsigned) >= 2 and text_byte(unsigned, 0) == 48:
            kind = text_byte(unsigned, 1)
            radix = 16 if kind == 120 else (8 if kind == 111 else (2 if kind == 98 else 10))
            if radix != 10:
                digits = text_part(unsigned, 2, text_size(unsigned))
                if signed or not _digits_ok(digits, radix): fail self.bad_at(unknown, at)
                n = _radix_int(digits, radix)
                if n < 0: fail self.bad_at(f"`{token}` is too big for an int", at)
                return .Int(n=n)
        if _has_any(unsigned, 46, 101, 69):
            if not _float_ok(unsigned): fail self.bad_at(unknown, at)
            match float(_without_underscores(token)):
                case Ok(x):
                    return .Float(x=x)
                case Err(_):
                    fail self.bad_at(unknown, at)
        if not _whole_ok(unsigned): fail self.bad_at(unknown, at)
        match int(_without_underscores(token)):
            case Ok(n):
                .Int(n=n)
            case Err(_):
                fail self.bad_at(f"`{token}` is too big for an int", at)

def _hex_upper(code: int) -> str:
    digits = "0123456789ABCDEF"
    mut out = ""
    mut rest = code
    while rest > 0:
        out = digits[rest % 16] + out
        rest = rest // 16
    out

def _has_any(text: str, a: int, b: int, c: int) -> bool:
    for at in range(text_size(text)):
        byte = text_byte(text, at)
        if byte == a or byte == b or byte == c: return True
    False

def _without_underscores(text: str) -> str:
    mut out = ""
    mut start = 0
    size = text_size(text)
    for at in range(size):
        if text_byte(text, at) == 95:
            out += text_part(text, start, at)
            start = at + 1
    out + text_part(text, start, size)

def _digit_value(b: int) -> int:
    if b >= 48 and b <= 57: return b - 48
    if b >= 97 and b <= 122: return b - 87
    if b >= 65 and b <= 90: return b - 55
    99

## Digits in a radix, with each underscore between two digits.
def _digits_ok(digits: str, radix: int) -> bool:
    size = text_size(digits)
    if size == 0 or text_byte(digits, 0) == 95 or text_byte(digits, size - 1) == 95: return False
    for at in range(size):
        b = text_byte(digits, at)
        if b == 95:
            if text_byte(digits, at + 1) == 95: return False
        elif _digit_value(b) >= radix:
            return False
    True

## The whole part of a decimal number: no leading zeros.
def _whole_ok(digits: str) -> bool:
    _digits_ok(digits, 10) and (digits == "0" or text_byte(digits, 0) != 48)

## `3.14`, `5e+22` or `6.626e-34`, without its sign.
def _float_ok(text: str) -> bool:
    size = text_size(text)
    mut end = size
    mut exponent = -1
    for at in range(size):
        b = text_byte(text, at)
        if (b == 101 or b == 69) and exponent < 0:
            exponent = at
            end = at
    if exponent >= 0:
        mut digits = exponent + 1
        while text_byte(text, digits) == 43 or text_byte(text, digits) == 45:
            digits += 1
        if not _digits_ok(text_part(text, digits, size), 10): return False
    mut dot = -1
    for at in range(end):
        if text_byte(text, at) == 46 and dot < 0:
            dot = at
    if dot < 0: return _whole_ok(text_part(text, 0, end))
    _whole_ok(text_part(text, 0, dot)) and _digits_ok(text_part(text, dot + 1, end), 10)

## An int in a radix, or -1 if it's too big.
def _radix_int(digits: str, radix: int) -> int:
    mut value = 0
    for at in range(text_size(digits)):
        b = text_byte(digits, at)
        if b != 95:
            digit = _digit_value(b)
            if value > (9223372036854775807 - digit) // radix: return -1
            value = value * radix + digit
    value

## The error for a key that has a value, or a table somewhere a dotted key can't add to.
def _no_table(parser: _Parser, key: str, at: int, dotted: bool, inner_dotted: bool) -> ParseError:
    if dotted and not inner_dotted:
        return parser.bad_at(
            f"`{key}` is a table defined elsewhere, so a dotted key can't add to it",
            at,
        )
    parser.bad_at(f"`{key}` already has a value, so it can't hold a table", at)

## Adds `keys = value` under the table a header named, making the tables that dotted keys name.
def _insert(
    mut table: _Table,
    path: list[str],
    step: int,
    keys: list[str],
    value: _Toml,
    where: (_Parser, int),
) fails ParseError:
    parser, at = where
    if step < path.len():
        key = path[step]
        place = table.place_of(key)
        match table.values[place]:
            case .Table(inner):
                mut child = inner
                _insert(mut child, path, step + 1, keys, value, where)?
                table.values[place] = .Table(table=child)
            case .Tables(tables):
                mut children = tables
                mut last = children[children.len() - 1]
                _insert(mut last, path, step + 1, keys, value, where)?
                children[children.len() - 1] = last
                table.values[place] = .Tables(tables=children)
            case _:
                fail parser.bad_at("this table can't be found again", at)
        return
    _insert_dotted(mut table, keys, 0, value, where)?

def _insert_dotted(
    mut table: _Table,
    keys: list[str],
    step: int,
    value: _Toml,
    where: (_Parser, int),
) fails ParseError:
    parser, at = where
    key = keys[step]
    if step == keys.len() - 1:
        if table.place_of(key) >= 0: fail parser.bad_at(f"`{_joined(keys)}` is defined twice", at)
        table.add(key, value)
        return
    mut place = table.place_of(key)
    if place < 0:
        table.add(key, .Table(table=_Table(dotted=True)))
        place = table.values.len() - 1
    match table.values[place]:
        case .Table(inner):
            if inner.inline: fail _no_table(parser, key, at, False, False)
            if not inner.dotted: fail _no_table(parser, key, at, True, False)
            mut child = inner
            _insert_dotted(mut child, keys, step + 1, value, where)?
            table.values[place] = .Table(table=child)
        case .Tables(_):
            fail _no_table(parser, key, at, True, False)
        case _:
            fail _no_table(parser, key, at, False, False)

## Starts the table a header names, going through what its path names on the way.
def _define(
    mut table: _Table,
    keys: list[str],
    step: int,
    array: bool,
    where: (_Parser, int),
) fails ParseError:
    parser, at = where
    key = keys[step]
    place = table.place_of(key)
    if step < keys.len() - 1:
        mut held = place
        if held < 0:
            table.add(key, .Table(table=_Table()))
            held = table.values.len() - 1
        match table.values[held]:
            case .Table(inner):
                if inner.inline: fail _no_table(parser, key, at, False, False)
                mut child = inner
                _define(mut child, keys, step + 1, array, where)?
                table.values[held] = .Table(table=child)
            case .Tables(tables):
                mut children = tables
                mut last = children[children.len() - 1]
                _define(mut last, keys, step + 1, array, where)?
                children[children.len() - 1] = last
                table.values[held] = .Tables(tables=children)
            case _:
                fail _no_table(parser, key, at, False, False)
        return
    name = _joined(keys)
    if place < 0:
        if array:
            table.add(key, .Tables(tables=[_Table(header=True)]))
        else:
            table.add(key, .Table(table=_Table(header=True)))
        return
    shown = f"[[{name}]]" if array else f"[{name}]"
    match table.values[place]:
        case .Tables(tables):
            if not array:
                fail parser.bad_at(
                    f"`{name}` is already defined as something else, so it can't be `{shown}`",
                    at,
                )
            mut children = tables
            children.append(_Table(header=True))
            table.values[place] = .Tables(tables=children)
        case .Table(inner):
            if array or inner.inline:
                fail parser.bad_at(
                    f"`{name}` is already defined as something else, so it can't be `{shown}`",
                    at,
                )
            if inner.header or inner.dotted:
                fail parser.bad_at(f"the table `[{name}]` is defined twice", at)
            mut child = inner
            child.header = True
            table.values[place] = .Table(table=child)
        case _:
            fail parser.bad_at(
                f"`{name}` is already defined as something else, so it can't be `{shown}`",
                at,
            )

## Where a reader is in a table it's reading.
struct _Frame:
    table: _Table
    owner: str
    at = 0

## Reads what a TOML document holds, once it's been read.
struct TomlReader:
    _here: _Toml
    _frames = list[_Frame]()
    _path = list[str]()
    _fields = list[(str, str)]()
    _place = 0
    _in_key = False
    _ids = _IdsSeen()

    def _where(self) -> str:
        if self._path.len() == 0: return "the text"
        f"`{self._dotted()}`"

    def _dotted(self) -> str:
        mut out = ""
        for part in self._path:
            if out != "" and text_byte(part, 0) != 91:
                out += "."
            out += part
        out

    def _found(self) -> str:
        match self._here:
            case .Text(_):
                "a str"
            case .Int(_):
                "an int"
            case .Float(_):
                "a float"
            case .Bool(_):
                "a bool"
            case .List(_):
                "a list"
            case .Tables(_):
                "a list"
            case .Table(_):
                "a table"

    def _misfit(self, wanted: str) -> ParseError:
        ParseError(
            message=f"{self._where()} should be {_article(wanted)}, but it's {self._found()}",
            line=0,
            column=0,
        )

    def int(mut self) -> int fails ParseError:
        match self._here:
            case .Int(n):
                n
            case .Text(text):
                if self._in_key:
                    match int(text):
                        case Ok(n):
                            return n
                        case Err(_):
                            fail ParseError(
                                message=f"{self._where()} has the key \"{text}\", which isn't an int",
                                line=0,
                                column=0,
                            )
                fail self._misfit("int")
            case _:
                fail self._misfit("int")

    def float(mut self) -> float fails ParseError:
        match self._here:
            case .Float(x):
                x
            case .Int(n):
                float(n)
            case _:
                fail self._misfit("float")

    def bool(mut self) -> bool fails ParseError:
        match self._here:
            case .Bool(b):
                b
            case _:
                fail self._misfit("bool")

    def text(mut self) -> str fails ParseError:
        match self._here:
            case .Text(text):
                text
            case _:
                fail self._misfit("str")

    def bytes(mut self) -> bytes fails ParseError:
        match self._here:
            case .Text(text):
                _from_base64(text) else fail ParseError(
                    message=f"{self._where()} should be bytes, written in base64",
                    line=0,
                    column=0,
                )
            case _:
                fail self._misfit("bytes")

    def none(mut self) -> bool fails ParseError:
        False

    def value[T: Deserializable](mut self) -> T fails ParseError:
        T.deserialize(mut self)?

    def sequence[T: Deserializable](mut self) -> list[T] fails ParseError:
        mut found = list[T]()
        match self._here:
            case .List(items):
                mut count = 0
                for item in items:
                    self._path.append(f"[{count}]")
                    count += 1
                    self._here = item
                    found.append(T.deserialize(mut self)?)
                    _ = self._path.pop()
            case .Tables(tables):
                mut count = 0
                for table in tables:
                    self._path.append(f"[{count}]")
                    count += 1
                    self._here = .Table(table=table)
                    found.append(T.deserialize(mut self)?)
                    _ = self._path.pop()
            case _:
                fail self._misfit(f"list[{type_name[T]()}]")
        found

    def map[K: Deserializable, V: Deserializable](mut self) -> list[(K, V)] fails ParseError:
        mut found = list[(K, V)]()
        match self._here:
            case .Table(table):
                mut at = 0
                for key in table.keys:
                    self._here = .Text(text=key)
                    self._in_key = True
                    read = K.deserialize(mut self)?
                    self._in_key = False
                    self._path.append(f"[\"{key}\"]")
                    self._here = table.values[at]
                    found.append((read, V.deserialize(mut self)?))
                    _ = self._path.pop()
                    at += 1
            case _:
                fail self._misfit(f"dict[{type_name[K]()}, {type_name[V]()}]")
        found

    def record(mut self, name: str) fails ParseError:
        match self._here:
            case .Table(table):
                self._frames.append(_Frame(table=table, owner=name))
            case _:
                mut wanted = name
                at = name.find(".")
                if at is not None:
                    wanted = name[:at]
                fail self._misfit(wanted)

    def next_field(mut self, fields: list[(str, str)]) -> bool fails ParseError:
        self._fields = fields
        top = self._frames.len() - 1
        frame = self._frames[top]
        if frame.at > 0:
            _ = self._path.pop()
        if frame.at >= frame.table.keys.len():
            _ = self._frames.pop()
            return False
        key = frame.table.keys[frame.at]
        self._frames[top].at = frame.at + 1
        mut at = 0
        for saved, own in fields:
            if saved == key:
                self._place = at
                self._path.append(key)
                self._here = frame.table.values[frame.at]
                return True
            at += 1
        owner = f"`{frame.owner}`"
        where = self._where()
        for saved, own in fields:
            if own == key:
                if saved == "":
                    fail ParseError(
                        message=f"{owner} doesn't save `{own}`, which has `@skip`, but {where} has it",
                        line=0,
                        column=0,
                    )
                fail ParseError(
                    message=f"{owner} saves `{own}` as \"{saved}\", but {where} has \"{key}\"",
                    line=0,
                    column=0,
                )
        fail ParseError(
            message=f"{owner} has no field \"{key}\", but {where} has one",
            line=0,
            column=0,
        )

    def field_at(self) -> int:
        self._place

    def missing(self, name: str) -> ParseError:
        joined = self._dotted()
        if joined == "": return ParseError(message=f"`{name}` is missing", line=0, column=0)
        ParseError(message=f"`{joined}.{name}` is missing", line=0, column=0)

    def rule(self, message: str) -> ParseError:
        ParseError(message=f"in {self._where()}, {message}", line=0, column=0)

    def here(self, message: str) -> ParseError:
        ParseError(message=f"{self._where()} {message}", line=0, column=0)

    def saw_id(mut self, kind: str, position: int):
        self._ids.id(kind, self._where(), position)

    def saw_table(mut self, kind: str, count: int):
        self._ids.table(kind, self._where(), count)

    def at_item(self, at: int, message: str) -> ParseError:
        ParseError(message=f"`{self._dotted()}[{at}]` {message}", line=0, column=0)

    def case(mut self, name: str, cases: list[(str, bool)]) -> int fails ParseError:
        match self._here:
            case .Text(key):
                mut at = 0
                for case, has_data in cases:
                    if case == key:
                        if has_data:
                            fail ParseError(
                                message=f"{self._where()} is `{name}.{case}`, which needs its fields",
                                line=0,
                                column=0,
                            )
                        return at
                    at += 1
                fail ParseError(
                    message=f"{self._where()} is \"{key}\", which isn't a case of `{name}`",
                    line=0,
                    column=0,
                )
            case .Table(table):
                if table.keys.len() != 1: fail self._misfit(name)
                key = table.keys[0]
                inner = table.values[0]
                match inner:
                    case .Table(fields):
                        mut at = 0
                        for case, has_data in cases:
                            if case == key:
                                if not has_data and fields.keys.len() > 0:
                                    fail ParseError(
                                        message=f"`{name}.{case}` has no field \"{fields.keys[0]}\", but {self._where()} has one",
                                        line=0,
                                        column=0,
                                    )
                                self._here = inner
                                return at
                            at += 1
                        fail ParseError(
                            message=f"{self._where()} is \"{key}\", which isn't a case of `{name}`",
                            line=0,
                            column=0,
                        )
                    case _:
                        fail self._misfit(name)
            case _:
                fail self._misfit(name)

    def end_case(mut self) fails ParseError:
        pass

## `text` read as a `T`, through its own `def deserialize`.
def native_loads[T: Deserializable](text: str) -> T fails ParseError:
    mut parser = _Parser(source=text)
    root = parser.document()?
    mut src = TomlReader(_here=.Table(table=root))
    value = T.deserialize(mut src)?
    found = src._ids.problem()
    if found != "": fail ParseError(message=found, line=0, column=0)
    value

## Builds what's being written as a document's values, then writes them out.
struct TomlWriter:
    _done = _Toml.Bool(b=False)
    _tables = list[_Table]()
    _wraps = list[str]()
    _after_case = False
    ## Where each `Id` is in its `Table`, as `JsonWriter` keeps it.
    _id_tables: dict[str, dict[int, int]] = {}
    _found = False
    _wants_tables = False
    _optional = False

    def int(mut self, value: int):
        self._done = .Int(n=value)

    def float(mut self, value: float):
        self._done = .Float(x=value)

    def bool(mut self, value: bool):
        self._done = .Bool(b=value)

    def text(mut self, value: str):
        self._done = .Text(text=value)

    def bytes(mut self, value: bytes):
        self._done = .Text(text=_base64(value))

    def none(mut self):
        assert False

    def value[T: Serializable](mut self, x: T):
        x.serialize(mut self)

    def sequence[T: Serializable](mut self, items: list[T]):
        self._optional = False
        mut built = list[_Toml]()
        for item in items:
            item.serialize(mut self)
            built.append(self._done)
        self._done = .List(items=built)

    def map[K: Serializable, V: Serializable](mut self, pairs: list[(K, V)]):
        mut table = _Table()
        for key, value in pairs:
            key.serialize(mut self)
            name = _key_text(self._done)
            value.serialize(mut self)
            table.add(name, self._done)
        self._done = .Table(table=table)

    def record(mut self, name: str, count: int):
        self._optional = False
        self._tables.append(_Table())
        self._wraps.append("")

    def field[T: Serializable](mut self, name: str, x: T):
        x.serialize(mut self)
        self._tables[self._tables.len() - 1].add(name, self._done)

    def renamed[T: Serializable](mut self, name: str, x: T):
        self.field(name, x)

    def end(mut self):
        if self._after_case:
            self._after_case = False
            return
        table = self._tables.pop()
        wrap = self._wraps.pop()
        self._done = .Table(table=table)
        if wrap != "":
            mut outer = _Table()
            outer.add(wrap, self._done)
            self._done = .Table(table=outer)
            self._after_case = True

    def case(mut self, name: str, case: str):
        self._done = .Text(text=case)

    def case_record(mut self, name: str, case: str, count: int):
        self._tables.append(_Table())
        self._wraps.append(case)

    def table[T: Serializable](mut self, kind: str, ids: list[Id[T]], items: list[T]):
        self.sequence(items)

    def id(mut self, kind: str, key: int):
        optional = self._optional
        self._optional = False
        if not self._found:
            self._wants_tables = True
            self._done = .Int(n=0)
            return
        positions = self._id_tables.get(kind) else dict[int, int]()
        position = positions.get(key) else -1
        if position < 0 and optional:
            stop(
                "TOML has no None, so an optional Id whose item has gone can't be saved; leave it out",
            )
        self._done = .Int(n=position)

    def some[T: Serializable](mut self, x: T):
        self._optional = True
        x.serialize(mut self)
        self._optional = False

def _key_text(key: _Toml) -> str:
    match key:
        case .Text(text):
            text
        case .Int(n):
            str(n)
        case _:
            ""

## A string in double quotes, with the escapes TOML shares with JSON.
def _quoted(text: str) -> str:
    mut out = "\""
    size = text_size(text)
    mut start = 0
    mut at = 0
    while at < size:
        b = text_byte(text, at)
        if b < 32 or b == 34 or b == 92 or b == 127:
            out += text_part(text, start, at)
            out += _escaped(b)
            at += 1
            start = at
        elif b == 194 and text_byte(text, at + 1) < 160:
            out += text_part(text, start, at)
            out += _escaped(text_byte(text, at + 1))
            at += 2
            start = at
        else:
            at += 1
    out += text_part(text, start, size)
    out + "\""

def _table_key(key: str) -> str:
    size = text_size(key)
    if size == 0: return _quoted(key)
    for at in range(size):
        b = text_byte(key, at)
        if not (
            (b >= 97 and b <= 122)
            or (b >= 65 and b <= 90)
            or (b >= 48 and b <= 57)
            or b == 95
            or b == 45
        ):
            return _quoted(key)
    key

## A value written on one line: inside an array or inline table, or after `key =`.
def _one_line(value: _Toml) -> str:
    match value:
        case .Text(text):
            _quoted(text)
        case .Int(n):
            str(n)
        case .Float(x):
            _float_text(x)
        case .Bool(b):
            "true" if b else "false"
        case .List(items):
            "[" + ", ".join([_one_line(item) for item in items]) + "]"
        case .Tables(tables):
            "[" + ", ".join([_one_line(.Table(table=table)) for table in tables]) + "]"
        case .Table(table):
            _inline(table)

def _inline(table: _Table) -> str:
    if table.keys.len() == 0: return "{}"
    mut parts = list[str]()
    mut at = 0
    for key in table.keys:
        parts.append(f"{_table_key(key)} = {_one_line(table.values[at])}")
        at += 1
    "{ " + ", ".join(parts) + " }"

## The tables a list holds, if it's a non-empty list of nothing else.
def _all_tables(items: list[_Toml]) -> list[_Table]?:
    if items.len() == 0: return None
    mut tables = list[_Table]()
    for item in items:
        match item:
            case .Table(table):
                tables.append(table)
            case _:
                return None
    tables

## A table's plain keys under its header, then its tables and arrays of tables.
## `text`, followed by a table, and the tables it holds, as TOML text under the header `path`.
def _write_table(text: str, path: list[str], table: _Table, array: bool) -> str:
    mut out = text
    mut plain = list[int]()
    mut nested = list[int]()
    mut at = 0
    for value in table.values:
        match value:
            case .Table(_):
                nested.append(at)
            case .Tables(_):
                nested.append(at)
            case .List(items):
                if _all_tables(items) is None:
                    plain.append(at)
                else:
                    nested.append(at)
            case _:
                plain.append(at)
        at += 1
    if path.len() > 0 and (array or plain.len() > 0 or nested.len() == 0):
        if out != "":
            out += "\n"
        name = ".".join([_table_key(key) for key in path])
        out += f"[[{name}]]\n" if array else f"[{name}]\n"
    for place in plain:
        out += f"{_table_key(table.keys[place])} = {_one_line(table.values[place])}\n"
    for place in nested:
        mut under = list[str]()
        for key in path:
            under.append(key)
        under.append(table.keys[place])
        match table.values[place]:
            case .Table(inner):
                out = _write_table(out, under, inner, False)
            case .Tables(tables):
                for inner in tables:
                    out = _write_table(out, under, inner, True)
            case .List(items):
                for inner in _all_tables(items) else list[_Table]():
                    out = _write_table(out, under, inner, True)
            case _:
                pass
    out

## `value` as TOML text, through its own `def serialize`.
def native_dumps[T: Serializable](value: T) -> str:
    mut out = TomlWriter()
    value.serialize(mut out)
    if out._wants_tables:
        out = TomlWriter(_id_tables=_tables_in(value), _found=True)
        value.serialize(mut out)
    mut text = ""
    match out._done:
        case .Table(table):
            text = _write_table(text, list[str](), table, False)
        case _:
            assert False
    text
