## A channel whose `with` block ends by an `else return` or an `else fail` is closed and freed as
## at any other end, so a task still holding a Sender for it is told `Closed` when it sends, rather
## than its message going nowhere.
from std.concurrent import Crashed, Inbox, Sender, Timeout, channel

## Hands a task its reply channel's sender, waits a moment for an answer, and gives up by
## `else return`.
def gives_up(helper: Sender[Sender[int]]) -> int:
    with channel[int](size=1) as reply:
        helper.send(reply.sender()) else return -1
        # A plain block. The one-line case and a `case` arm are in channel_dropped_by_an_except_*.
        answered = reply.receive_within(10ms) except why:
            if why.waited > 0ms:
                return -2
            return -3
        got = answered else return -2
        return got
    -3

## The same, giving up by `else fail`.
def fails_out(helper: Sender[Sender[int]]) -> int fails Timeout:
    with channel[int](size=1) as reply:
        helper.send(reply.sender()) else return -1
        answered = reply.receive_within(10ms)?
        got = answered else fail Timeout(waited=10ms)
        return got
    -3

## Takes a sender, waits for the go, which comes once its receiver's block has ended, then sends
## on it, and says how that went.
def answers_late(inbox: Inbox[Sender[int]], said: Sender[str]):
    for reply in inbox:
        _ = inbox.receive() else return
        reply.send(5) else:
            said.send("closed") else return
            continue
        said.send("sent") else return

def main(stdout: Stdout) fails Crashed:
    with channel[str](size=4) as said, channel[int](size=1) as go:
        told = said.sender()
        with launch((inbox) => answers_late(inbox, told))? as helper:
            stdout.print("gave up", gives_up(helper))
            helper.send(go.sender()) else:
                stdout.print("no helper")
            _ = fails_out(helper) else as why:
                stdout.print("failed out")
                0
            helper.send(go.sender()) else:
                stdout.print("no helper")
        for _ in range(2):
            stdout.print(said.receive() else "nothing said")
