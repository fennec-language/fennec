## Plain-text dumps of the token stream and the syntax tree, in exactly the text
## `fennec dev tokens` and `fennec dev tree` print, so the two front ends can be compared
## line by line. Mirrors `crates/syntax/src/dump.rs` and `dump/tree.rs`.

from ast import Annotation, Arg, BinOp, Case, CompKind, Expr, ExprKind, Extension, FStrPart, Field, FnDef, Generic, Import, Interface, Item, MatchArm, Module, Param, Pattern, Stmt, StmtKind, TestDef, TypeDef, TypeExpr, UnaryOp
from check.checker import check
from lexer import lex
from parser import parse
from span import Diagnostic, Span
from token import FPart, Tok

## Every token in `source`, one per line, or the error that stopped the lexer.
def dump_tokens(source: str) -> str:
    tokens = lex(source, 0) except diagnostic:
        return dump_error(diagnostic)
    return "".join(
        f"{token.span.start}..{token.span.end} {describe_tok(token.tok)}\n" for token in tokens
    )

## What the checker finds in `source`, checked against the standard library's modules:
## every diagnostic, or the parse error that stopped it first. Nothing when it checks.
def dump_check(source: str, library: list[Module]) -> str:
    module = parse(source) except diagnostic:
        return dump_error(diagnostic)
    return "".join(dump_error(diagnostic) for diagnostic in check(module, library))

## A diagnostic as the dumps show it: its span and message, then its help on a second line.
def dump_error(diagnostic: Diagnostic) -> str:
    span = diagnostic.span
    text = f"error {span.start}..{span.end} {diagnostic.message}\n"
    help = diagnostic.help
    if help is None: return text
    return text + f"help {help}\n"

def describe_tok(tok: Tok) -> str:
    match tok:
        case .Name(text):
            return f"name {text}"
        case .Int(value):
            return f"int {value}"
        case .Float(value):
            return f"float {value}"
        case .Duration(nanos):
            return f"duration {nanos}"
        case .Str(text):
            return f"str {quoted(text)}"
        case .FStr(parts):
            return "fstr " + " | ".join([describe_fpart(part) for part in parts])
        case .TStr(parts):
            return "tstr " + " | ".join([describe_fpart(part) for part in parts])
        case .Keyword(word):
            return f"keyword {word}"
        case .Punct(text):
            return f"punct {text}"
        case .Newline:
            return "newline"
        case .Indent:
            return "indent"
        case .Dedent:
            return "dedent"
        case .Eof:
            return "eof"

def describe_fpart(part: FPart) -> str:
    match part:
        case .Text(text):
            return f"text {quoted(text)}"
        case .Code(source, offset, spec):
            if spec is None: return f"expr {offset} {quoted(source)}"
            return f"expr {offset} {quoted(source)} spec {quoted(spec)}"

## A string in double quotes, with backslashes, quotes and line breaks escaped.
def quoted(text: str) -> str:
    mut out = "\""
    for c in text:
        out += match c:
            case "\\":
                "\\\\"
            case "\"":
                "\\\""
            case "\n":
                "\\n"
            case "\t":
                "\\t"
            case "\r":
                "\\r"
            case "\0":
                "\\0"
            case _:
                c
    return out + "\""

## The syntax tree of `source`, one node per line, or the error that stopped the parser.
def dump_tree(source: str) -> str:
    module = parse(source) except diagnostic:
        return dump_error(diagnostic)
    mut tree = Tree()
    tree.write_module(module)
    return "".join(line + "\n" for line in tree.lines)

## The syntax tree as indented text: one node per line, its children two spaces deeper, and
## its span at the end as `@start..end`.
struct Tree:
    lines = list[str]()
    ## Two spaces for each level of nesting.
    indent = ""

    def line(ref self, label: str):
        self.lines.append(self.indent + label)

    def spanned(ref self, label: str, span: Span):
        self.line(f"{label} @{span.start}..{span.end}")

    ## A line for a node whose children follow, one level deeper, until `close`.
    def open(ref self, label: str, span: Span?):
        if span is None:
            self.line(label)
        else:
            self.spanned(label, span)
        self.indent += "  "

    def close(ref self):
        self.indent = self.indent[2:]

    def write_module(ref self, module: Module):
        self.open("module", None)
        for item in module.items:
            self.write_item(item)
        self.close()

    def write_item(ref self, item: Item):
        match item:
            case .Function(function):
                self.write_function(function)
            case .Struct(type_def):
                self.write_type_def("shared" if type_def.shared else "struct", type_def)
            case .Enum(type_def):
                self.write_type_def("enum", type_def)
            case .Error(type_def):
                self.write_type_def("error", type_def)
            case .Interface(interface):
                self.open(f"interface {interface.name}", interface.span)
                for method in interface.methods:
                    self.write_function(method)
                self.close()
            case .Extend(extension):
                self.open(f"extend {extension.name}", extension.span)
                self.write_generics(extension.generics)
                for method in extension.methods:
                    self.write_function(method)
                self.close()
            case .TypeAlias(name, ty, span):
                self.open(f"type-alias {name}", span)
                self.write_type_expr(ty)
                self.close()
            case .Const(name, ty, value, span):
                self.open(f"const {name}", span)
                if ty is not None:
                    self.write_type_expr(ty)
                self.write_expr(value)
                self.close()
            case .Import(imported):
                mut label = "import " + ".".join(imported.module)
                if imported.alias is not None:
                    label += " as " + imported.alias
                if len(imported.names) > 0:
                    label += ": " + ", ".join(bound_names(imported))
                self.spanned(label, imported.span)
            case .Test(test):
                word = "bench" if test.bench else "test"
                self.open(f"{word} {quoted(test.name)}", test.span)
                for capability in test.capabilities:
                    self.write_param(capability)
                for input in test.inputs:
                    self.write_param(input)
                self.write_stmts(test.body)
                self.close()

    def write_function(ref self, function: FnDef):
        self.open(f"def {function.name}", function.span)
        self.write_annotations(function.annotations)
        self.write_generics(function.generics)
        for param in function.params:
            self.write_param(param)
        ret = function.ret
        if ret is not None:
            self.open("returns", function.arrow)
            self.write_type_expr(ret)
            self.close()
        fails = function.fails
        if fails is not None:
            self.open("fails", None)
            self.write_type_expr(fails)
            self.close()
        self.write_stmts(function.body)
        self.close()

    ## Type parameters, each with the interfaces it's bound to.
    def write_generics(ref self, generics: list[Generic]):
        for generic in generics:
            self.open(f"generic {generic.name}", generic.span)
            for bound in generic.bounds:
                self.write_type_expr(bound)
            self.close()

    def write_param(ref self, param: Param):
        mut label = f"param {param.name}"
        if param.is_mut:
            label += " mut"
        if param.is_self:
            label += " self"
        self.open(label, param.span)
        ty = param.ty
        if ty is not None:
            self.write_type_expr(ty)
        default = param.default
        if default is not None:
            self.write_expr(default)
        self.close()

    def write_type_expr(ref self, ty: TypeExpr):
        self.open(f"type {ty.name}" + ("?" if ty.optional else ""), ty.span)
        for arg in ty.args:
            self.write_type_expr(arg)
        self.close()

    def write_type_def(ref self, kind: str, type_def: TypeDef):
        self.open(f"{kind} {type_def.name}", type_def.span)
        self.write_generics(type_def.generics)
        for field in type_def.fields:
            self.write_field(field)
        for case_name in type_def.cases:
            self.write_case(case_name)
        for method in type_def.methods:
            self.write_function(method)
        self.close()

    def write_annotations(ref self, annotations: list[Annotation]):
        for annotation in annotations:
            self.open(f"annotation {annotation.name}", annotation.span)
            for arg in annotation.args:
                self.write_arg(arg)
            self.close()

    def write_field(ref self, field: Field):
        self.open(f"field {field.name}", field.span)
        self.write_annotations(field.annotations)
        ty = field.ty
        if ty is not None:
            self.write_type_expr(ty)
        self.labelled("default", field.default)
        self.labelled("where", field.rule)
        self.close()

    ## A line saying what `expr` is for, with `expr` under it, when there is one.
    def labelled(ref self, label: str, expr: Expr?):
        if expr is None: return
        self.open(label, None)
        self.write_expr(expr)
        self.close()

    def write_case(ref self, case_name: Case):
        self.open(f"case {case_name.name}", case_name.span)
        for field in case_name.fields:
            self.write_field(field)
        self.close()

    def write_stmts(ref self, stmts: list[Stmt]):
        for stmt in stmts:
            self.write_stmt(stmt)

    def write_stmt(ref self, stmt: Stmt):
        span = stmt.span
        match stmt.kind:
            case .Expr(expr):
                self.open("expr", span)
                self.write_expr(expr)
            case .Assign(target, op, value, declare_mut, ty):
                mut label = "assign"
                if op is not None:
                    label += f" {op.symbol()}="
                if declare_mut:
                    label += " mut"
                self.open(label, span)
                self.write_expr(target)
                if ty is not None:
                    self.write_type_expr(ty)
                self.write_expr(value)
            case .If(branches, otherwise):
                self.open("if", span)
                for cond, body in branches:
                    self.open("branch", None)
                    self.write_expr(cond)
                    self.write_stmts(body)
                    self.close()
                if otherwise is not None:
                    self.open("else", None)
                    self.write_stmts(otherwise)
                    self.close()
            case .While(cond, body):
                self.open("while", span)
                self.write_expr(cond)
                self.write_stmts(body)
            case .For(names, is_mut, iter, body):
                self.open("for" + (" mut " if is_mut else " ") + ", ".join(names), span)
                self.write_expr(iter)
                self.write_stmts(body)
            case .Return(value):
                self.open("return", span)
                if value is not None:
                    self.write_expr(value)
            case .Fail(value):
                self.open("fail", span)
                self.write_expr(value)
            case .Yield(value):
                self.open("yield", span)
                self.write_expr(value)
            case .Assert(value):
                self.open("assert", span)
                self.write_expr(value)
            case .Lend(value, otherwise):
                self.open("lend", span)
                self.write_expr(value)
                self.write_stmts(otherwise)
            case .With(value, names, body, lock):
                mut label = "lock" if lock else "with"
                for at, held in enumerate(names):
                    label += (
                        (" as " if at == 0 else ", ") + ("mut " if held.is_mut else "") + held.name
                    )
                self.open(label, span)
                self.write_expr(value)
                self.write_stmts(body)
            case .Def(function):
                self.write_function(function)
                return
            case .Break:
                self.spanned("break", span)
                return
            case .Continue:
                self.spanned("continue", span)
                return
            case .Pass:
                self.spanned("pass", span)
                return
        self.close()

    def write_exprs(ref self, exprs: list[Expr]):
        for expr in exprs:
            self.write_expr(expr)

    def write_expr(ref self, expr: Expr):
        span = expr.span
        match expr.kind:
            case .Int(value):
                self.spanned(f"int {value}", span)
            case .Float(value):
                self.spanned(f"float {value}", span)
            case .Duration(nanos):
                self.spanned(f"duration {nanos}", span)
            case .Bytes(data):
                self.spanned(f"bytes {len(data)}", span)
            case .Str(text):
                self.spanned(f"str {quoted(text)}", span)
            case .Bool(value):
                self.spanned(f"bool {value}", span)
            case .Nothing:
                self.spanned("none", span)
            case .Name(name):
                self.spanned(f"name {name}", span)
            case .Variant(name):
                self.spanned(f"variant {name}", span)
            case .FStr(parts):
                self.open("fstr", span)
                for part in parts:
                    self.write_fstring_part(part)
                self.close()
            case .List(items):
                self.group("list", span, items)
            case .Tuple(items):
                self.group("tuple", span, items)
            case .Set(items):
                self.group("set", span, items)
            case .Dict(pairs):
                self.open("dict", span)
                for key, value in pairs:
                    self.open("pair", None)
                    self.write_expr(key)
                    self.write_expr(value)
                    self.close()
                self.close()
            case .Comprehension(kind, elem, value, names, iter, cond):
                self.open(f"comprehension {comprehension_kind(kind)} " + ", ".join(names), span)
                self.write_expr(elem)
                self.labelled("value", value)
                self.labelled("in", iter)
                self.labelled("if", cond)
                self.close()
            case _:
                self.write_compound(expr)

    ## A node holding a list of expressions.
    def group(ref self, label: str, span: Span, items: list[Expr]):
        self.open(label, span)
        self.write_exprs(items)
        self.close()

    def write_fstring_part(ref self, part: FStrPart):
        match part:
            case .Text(text):
                self.line(f"text {quoted(text)}")
            case .Code(expr, spec):
                self.labelled("code" if spec is None else f"code spec {quoted(spec)}", expr)

    ## Expressions built from operators, calls and blocks.
    def write_compound(ref self, expr: Expr):
        span = expr.span
        match expr.kind:
            case .Unary(op, operand):
                self.open("unary " + op.symbol(), span)
                self.write_expr(operand)
            case .Binary(op, lhs, rhs):
                self.open(f"binary {op.symbol()}", span)
                self.write_expr(lhs)
                self.write_expr(rhs)
            case .Cond(then, cond, otherwise):
                self.open("cond", span)
                self.write_exprs([then, cond, otherwise])
            case .Else(value, default, is_except):
                self.open("except" if is_except else "else", span)
                self.write_exprs([value, default])
            case .Try(value, context):
                self.open("try", span)
                self.write_expr(value)
                self.labelled("from", context)
            case .Call(callee, args):
                self.open("call", span)
                self.write_expr(callee)
                for arg in args:
                    self.write_arg(arg)
            case .Attr(object, name, optional):
                self.open("attr " + ("?." if optional else ".") + name, span)
                self.write_expr(object)
            case .Index(object, index):
                self.open("index", span)
                self.write_exprs([object, index])
            case .Slice(object, start, end):
                self.open("slice", span)
                self.write_expr(object)
                self.labelled("start", start)
                self.labelled("end", end)
            case .Lambda(params, body):
                self.open("lambda " + ", ".join(params), span)
                self.write_expr(body)
            case .Match(subject, arms):
                self.open("match", span)
                self.write_expr(subject)
                for arm in arms:
                    self.write_arm(arm)
            case _:
                return
        self.close()

    def write_arg(ref self, arg: Arg):
        mut label = "arg"
        if arg.is_mut:
            label += " mut"
        name = arg.name
        if name is not None:
            label += f" {name}="
        self.labelled(label, arg.value)

    def write_arm(ref self, arm: MatchArm):
        self.open("arm", arm.span)
        self.write_pattern(arm.pattern)
        self.labelled("guard", arm.guard)
        self.write_stmts(arm.body)
        self.close()

    def write_pattern(ref self, pattern: Pattern):
        match pattern:
            case .Wildcard:
                self.line("pattern _")
            case .Bind(name):
                self.line(f"pattern bind {name}")
            case .RefBind(name):
                self.line(f"pattern bind ref {name}")
            case .Literal(expr):
                self.labelled("pattern literal", expr)
            case .Variant(name, dotted, args, fields):
                by = "" if len(fields) == 0 else " by " + ", ".join(fields)
                self.write_patterns("pattern " + ("." if dotted else "") + name + by, args)
            case .Tuple(items):
                self.write_patterns("pattern tuple", items)
            case .Or(alternatives):
                self.write_patterns("pattern or", alternatives)

    def write_patterns(ref self, label: str, patterns: list[Pattern]):
        self.open(label, None)
        for pattern in patterns:
            self.write_pattern(pattern)
        self.close()

def comprehension_kind(kind: CompKind) -> str:
    match kind:
        case .List:
            return "list"
        case .Generator:
            return "generator"
        case .Set:
            return "set"
        case .Dict:
            return "dict"

## Each imported name, written `name as alias` when `as` renames it.
def bound_names(imported: Import) -> list[str]:
    mut shown = []
    for at in range(len(imported.names)):
        name = imported.names[at]
        alias = imported.aliases[at]
        if alias is not None and alias != name:
            shown.append(name + " as " + alias)
        else:
            shown.append(name)
    return shown
