# `embed` gives a file's bytes, read when the program is built, so the program holds them and
# takes no `Fs` capability to have them. A kit can embed anything inside its own folder, not
# only what's in src.
from levels.first import size

NAME = embed_file("../assets/name.txt")
START = NAME[0:3]

def main(stdout: Stdout):
    stdout.print(size())
    stdout.print(len(NAME))
    stdout.print(len(START))
    stdout.print(len(embed_file("levels/first.bin")) == size())

test "the name is all there":
    assert len(NAME) == 6
