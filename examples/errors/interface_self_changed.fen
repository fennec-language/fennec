interface Source:
    def next(self) -> int

struct Count:
    left = 2

    def next(ref self) -> int:
        self.left -= 1
        return self.left

def two(source: Source) -> int:
    return source.next() + source.next()

def main(stdout: Stdout):
    counter = Count()
    stdout.print(two(counter), counter.left)
