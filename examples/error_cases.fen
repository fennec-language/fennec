# decision: A function that can fail says so with `fails Name`, and every exit is visible.

# One error can list several cases, each failing its own way. A case is made like an enum's,
# `fail`ed like any error, and told apart by name in a `match` on what `else as why:` names. Where
# the function says what it fails with, a leading dot is enough.

error DialError:
    NotFound(host: str)
    Refused(host: str, port: int)
    Closed

def connect(host: str, port: int) -> int fails DialError:
    if host == "": fail .NotFound(host)
    if port == 0: fail .Closed
    if port < 0: fail .Refused(host, port)
    return port

def described(host: str, port: int) -> str:
    connected = connect(host, port) except why:
        case .Refused(host, port):
            return f"refused by {host}:{port}"
        case .NotFound(host):
            return f"no host called \"{host}\""
        case _:
            return f"failed: {why}"
    return f"connected on {connected}"

def main(stdout: Stdout):
    stdout.print(described("db", 5432))
    stdout.print(described("db", -1))
    stdout.print(described("db", 0))
    stdout.print(described("", 80))
