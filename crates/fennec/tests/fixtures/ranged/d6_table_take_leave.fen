# The same, with the item put back on the way out of the loop as well as on the way round.
from std.collections import Id, Table

struct Unit:
    health: int
    bag: dict[str, int]

def scan(ref units: Table[Unit], ids: list[Id[Unit]], starts: list[int], order: list[int]) -> int:
    mut total = 0
    for at in range(starts[0], starts[1]):
        mut unit = units[ids[at]]
        unit.health += order[at]
        if unit.health > 25:
            unit.bag["over"] = at
            units[ids[at]] = unit
            break
        units[ids[at]] = unit
        total += 1
    return total

def main(stdout: Stdout):
    mut units = Table[Unit]()
    mut ids = list[Id[Unit]]()
    for health in [1, 2, 3, 4, 5, 6]:
        ids.append(units.add(Unit(health=health, bag={})))
    stdout.print(scan(ref units, ids=ids, starts=[0, 6], order=[10, 11, 12, 30, 14, 15]))
    for unit in units:
        stdout.print(unit.health, unit.bag)
