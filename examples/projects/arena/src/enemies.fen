## Enemies and where they come from.

from std.math import Vec3

## How much of a threat an enemy is.
pub enum Rank:
    Grunt
    Boss

    ## The rank's name, as a message shows it.
    pub def label(self) -> str:
        match self:
            case .Grunt:
                "grunt"
            case .Boss:
                "boss"

## One enemy in the arena.
pub struct Enemy:
    ## What messages call it.
    name: str
    ## Where it stands.
    position: Vec3
    ## How strong it is.
    rank = Rank.Grunt
    ## What it has left before it's beaten.
    health = 100

    ## A line saying who it is, where it is and how healthy.
    pub def describe(self) -> str:
        f"{self.name} ({self.rank.label()}) at {self.position.x} with {self.health} health"

## A new enemy of the lowest rank.
pub def spawn(name: str, position: Vec3, health: int) -> Enemy:
    Enemy(name=name, position=position, health=health)

def wave(size: int) -> list[Enemy]:
    [spawn(f"grunt {at + 1}", Vec3(x=float(at)), 100) for at in range(size)]

test "a wave has as many enemies as asked":
    assert wave(4).len() == 4
