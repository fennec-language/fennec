# `std.url`: URLs as RFC 3986 writes them, `scheme://user@host:port/path?query#fragment`, taken
# apart into a `Url` and put back together. `quote` and `unquote` write and read the `%41`
# escapes URLs use for bytes they can't hold as they are, and `encode_query` and `decode_query`
# write and read a query's `name=value` pairs as HTML forms send them, with `+` for a space.

from std.intrinsics import stop
from std.string import cut_input, quoted_input

## A URL taken apart. `path`, `query` and `fragment` hold their text with its escapes read,
## and printing a `Url` writes it back with what needs escaping escaped. A part that wasn't
## given is "", with `port` 0 when none was given, and a URL with no `scheme` or `host`, like
## `/search?q=fox`, is relative.
export struct Url:
    scheme = ""
    ## Who's named before an `@`, like `user:password`, as it's written.
    user = ""
    ## A name or an address. An IPv6 address is held without its `[` and `]`.
    host = ""
    port = 0
    path = ""
    ## The query's parameters by name, in the order the URL has them. A name given twice
    ## keeps its first value, and `query_all` gives every one. It isn't the last, so a value
    ## tacked onto the end of a URL can't take the place of the one written before it.
    query = dict[str, str]()
    fragment = ""
    ## Whether it was written with `//`, which `mailto:a@b` wasn't, and its path as it was written:
    ## decoding one loses whether a `/` was a `%2F`.
    _authority = False
    _raw_path = ""
    ## Its query as it was written, so `query_all` still has the values `query` doesn't keep.
    _raw_query = ""

    ## Every value the query gives `name`, in the order the URL has them, where `query` keeps
    ## only the first: `?tag=a&tag=b` gives `["a", "b"]`. A name it doesn't have gives none.
    def query_all(self, name: str) -> list[str]:
        # As it was written, unless the query has been changed since.
        if self._raw_query != "" and decode_query(self._raw_query) == self.query:
            return [value for given, value in query_pairs(self._raw_query) if given == name]
        if name in self.query: return [self.query[name]]
        return []

    ## `host`, then `:port` when a port was given: what the URL says to connect to.
    def address(self) -> str:
        host = f"[{self.host}]" if self.host.find(":") is not None else self.host
        return f"{host}:{self.port}" if self.port > 0 else host

    ## Written so it reads back as the same URL, never as another: a host or scheme that would
    ## change what it says stops the program, as a bug in the program that set it, and the rest
    ## is escaped or led in so its parts stay where they are.
    def str(self, ref out: StrWriter):
        if self.scheme != "":
            if not is_scheme(self.scheme):
                stop(
                    f"a Url's scheme can't be {quoted_input(self.scheme)}: it's a letter, then letters, digits, `+`, `-` or `.`",
                )
            out.write(self.scheme + ":")
        authority = self.host != "" or self._authority
        if authority:
            out.write("//")
            if self.user != "":
                # `%` stays, so what parse read is written as it was.
                out.write(quoted(self.user, keep="!$&'()*+,;=:%") + "@")
            refused = host_refused(self.host)
            if refused != "":
                stop(f"a Url's host can't be {quoted_input(self.host)}: {refused}")
            out.write(self.address())
        # As it was written, unless the path has been changed since.
        mut path = quoted(self.path, keep="/:@!$&'()*+,;=")
        if self._raw_path != "" and unquote(self._raw_path) == self.path:
            path = self._raw_path
        if authority:
            # After a host, a path starts with `/`, or the two would run together.
            if path != "" and not path.startswith("/"):
                path = "/" + path
        elif path.startswith("//"):
            # Written as it is, it would be read as a host.
            path = "/." + path
        elif self.scheme == "" and (path[:path.find("/") else len(path)]).find(":") is not None:
            # Written as it is, the part before its `:` would be read as a scheme.
            path = "./" + path
        out.write(path)
        # As it was written, repeated names and all, unless the query has been changed since.
        if self._raw_query != "" and decode_query(self._raw_query) == self.query:
            out.write("?" + self._raw_query)
        elif len(self.query) > 0:
            out.write("?" + encode_query(self.query))
        if self.fragment != "":
            out.write("#" + quoted(self.fragment, keep="/?:@!$&'()*+,;="))

## The parts of `text`, an absolute URL like `https://example.com/a?b=1` or a relative one like
## `/a?b=1`. Text that can't be a URL fails with an `InvalidValue` saying why. What's refused is
## what a browser, or whatever reads the URL next, could take for a different URL, so that a check
## of what `parse` gives is a check of where the URL leads:
## - a space or a control character anywhere, tab, CR and LF included, which a browser strips;
## - a `\` before the query, which a browser reads as `/`;
## - `http:`, `https:`, `ws:`, `wss:` or `ftp:` not followed by `//` and a host, and `//` with
##   no host after it, since a browser finds a host whatever the slashes;
## - a host holding `@`, `%`, `\`, `[`, `]`, `/`, `?` or `#`, or a character a browser maps to
##   ASCII, like `。`, `＠` or a fullwidth letter;
## - a host a browser reads as an IPv4 address but that isn't written as one plainly, like
##   `127.1`, `0x7f.1`, `0177.0.0.1` or `2130706433`;
## - brackets around anything but an IPv6 address, a zone like `%25en0` included;
## - a port that isn't a number from 1 to 65535, or a host longer than 253 characters.
export def parse(text: str) -> Url fails InvalidValue:
    for c in text:
        if c == " " or c.code() < 32 or c.code() == 127:
            fail InvalidValue(
                message=f"{quoted_input(text)} isn't a URL: it can't hold a space or a control character",
            )
    mut rest = text
    mut found = Url()
    at_hash = rest.find("#")
    if at_hash is not None:
        found = copy(found, fragment=unquote(rest[at_hash + 1:]))
        rest = rest[:at_hash]
    at_question = rest.find("?")
    if at_question is not None:
        raw_query = rest[at_question + 1:]
        found = copy(found, query=decode_query(raw_query), _raw_query=raw_query)
        rest = rest[:at_question]
    # A browser reads `\` as `/`, so `http://evil.com\@good.com/` would be evil.com to it and
    # good.com here, and `/\evil.com` another site to it and a path here.
    if rest.find("\\") is not None:
        fail InvalidValue(
            message=f"{quoted_input(text)} isn't a URL: it can't hold `\\` before its query, since a browser reads it as `/`",
        )
    colon = rest.find(":")
    slash = rest.find("/") else len(rest)
    if colon is not None and colon < slash and colon > 0 and is_scheme(rest[:colon]):
        found = copy(found, scheme=rest[:colon].lower())
        rest = rest[colon + 1:]
    special = found.scheme in SPECIAL_SCHEMES
    # A browser reads `http:evil.com`, `http:/evil.com` and `http:///evil.com` all as a link to
    # evil.com, whatever the slashes, so a host that isn't after `//` would be another host to it.
    if special and not rest.startswith("//"):
        fail InvalidValue(
            message=f"{quoted_input(text)} isn't a URL: `{found.scheme}:` is followed by `//` and a host",
        )
    if rest.startswith("//"):
        rest = rest[2:]
        end = rest.find("/") else len(rest)
        mut authority = rest[:end]
        rest = rest[end:]
        at_sign = authority.find("@")
        if at_sign is not None:
            found = copy(found, user=authority[:at_sign])
            authority = authority[at_sign + 1:]
        host, port = host_and_port(authority, text)?
        # Against a page's own URL, a browser reads `///evil.com` as a link to evil.com too.
        if host == "" and (special or found.scheme == ""):
            fail InvalidValue(message=f"{quoted_input(text)} isn't a URL: its host is empty")
        found = copy(found, host=host, port=port, _authority=True)
    return copy(found, path=unquote(rest), _raw_path=rest)

## The schemes a browser reads with a host whatever the slashes after them, as WHATWG's URL
## standard has it. `file` is left out: `file:///etc/hosts` has no host.
SPECIAL_SCHEMES = ["http", "https", "ws", "wss", "ftp"]

## Whether text can be a URL's scheme: a letter, then letters, digits, `+`, `-` or `.`.
def is_scheme(text: str) -> bool:
    mut first = True
    for c in text:
        letter = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z")
        if first and not letter: return False
        if not letter and not (c >= "0" and c <= "9") and c != "+" and c != "-" and c != ".":
            return False
        first = False
    return not first

## Whether `text`, what's between a URL's brackets, is an IPv6 address: hex digits, `:` and the
## `.` of an IPv4 address at its end, with at least one `:`. A zone, like `%25en0`, isn't taken.
def is_ipv6(text: str) -> bool:
    if text.find(":") is None: return False
    for c in text:
        if not (c.isdigit() or c == ":" or c == "." or (c.lower() >= "a" and c.lower() <= "f")):
            return False
    return True

## Why `host`, a name, would be another host to whatever reads it next, or "" if it wouldn't.
## An IPv6 address, which holds `:`, is one when it's all hex digits, `:` and `.`.
def host_refused(host: str) -> str:
    if host.find(":") is not None:
        if is_ipv6(host): return ""
        return f"`{cut_input(host)}` isn't an IPv6 address"
    for refused in ["@", "%", "\\", "[", "]", "/", "?", "#"]:
        if host.find(refused) is not None: return f"its host can't hold `{refused}`"
    for c in host:
        if c == " " or c.code() < 32 or c.code() == 127:
            return "its host can't hold a space or a control character"
        if is_mapped_punctuation(c.code()):
            return f"its host can't hold `{c}`, which a browser reads as ASCII punctuation or a letter"
    # The most a name may be, as DNS has it.
    if len(host) > 253: return "its host is longer than 253 characters"
    if ends_in_a_number(host) and not is_ipv4(host):
        return f"its host `{cut_input(host)}` is an IPv4 address in a form a browser reads as another: write it as four numbers from 0 to 255, like 127.0.0.1"
    return ""

## Whether a browser reads `host` as an IPv4 address: its last part, or the one before a last
## dot, is digits, or `0x` and hex digits. Then `127.1`, `0x7f.1`, `0177.0.0.1` and `2130706433`
## are all 127.0.0.1 to it, and to C's `inet_aton`, so a check of the host as written isn't one
## of where it leads.
def ends_in_a_number(host: str) -> bool:
    mut parts = host.split(".")
    if len(parts) > 1 and parts[-1] == "":
        parts = parts[:-1]
    last = parts[-1]
    if last != "" and is_digits(last): return True
    return last.lower().startswith("0x") and is_hex(last[2:])

## Whether `host` is an IPv4 address written plainly: four numbers from 0 to 255, in decimal, with
## no leading zero.
def is_ipv4(host: str) -> bool:
    parts = host.split(".")
    if len(parts) != 4: return False
    for part in parts:
        if part == "" or not is_digits(part) or len(part) > 3: return False
        if len(part) > 1 and part.startswith("0"): return False
        number = int(part) except InvalidValue(): 256
        if number > 255: return False
    return True

def is_digits(text: str) -> bool:
    for c in text:
        if c < "0" or c > "9": return False
    return text != ""

def is_hex(text: str) -> bool:
    for c in text:
        if not ((c >= "0" and c <= "9") or (c.lower() >= "a" and c.lower() <= "f")): return False
    return True

## Whether a browser's IDNA mapping turns character `code` into ASCII: an ideographic or small
## full stop, a one-dot leader, or a fullwidth letter, digit or mark. In a host, `evil。com` is
## evil.com to a browser and `a＠b` holds an `@`, so a check of the host as written isn't one of
## where it leads.
def is_mapped_punctuation(code: int) -> bool:
    # U+3002, U+2024 and U+FF61; U+FE50 to U+FE6B; and U+FF01 to U+FF5E.
    return (
        code == 12_290
        or code == 8_228
        or code == 65_377
        or (code >= 65_104 and code <= 65_131)
        or (code >= 65_281 and code <= 65_374)
    )

## An authority's host, lower case unless it's an IPv6 address, and its port, 0 for none.
def host_and_port(authority: str, text: str) -> (str, int) fails InvalidValue:
    mut host = authority
    mut port_text = ""
    if authority.startswith("["):
        close = authority.find("]")
        if close is None:
            fail InvalidValue(
                message=f"{quoted_input(text)} isn't a URL: its IPv6 address has no `]`",
            )
        host = authority[1:close]
        # Only an IPv6 address goes in brackets: a name there would be connected to as a name,
        # past a check that took it for an address.
        if host == "":
            fail InvalidValue(message=f"{quoted_input(text)} isn't a URL: its brackets are empty")
        if not is_ipv6(host):
            fail InvalidValue(
                message=f"{quoted_input(text)} isn't a URL: `{cut_input(host)}` in brackets isn't an IPv6 address",
            )
        after = authority[close + 1:]
        if after != "":
            if not after.startswith(":"):
                fail InvalidValue(
                    message=f"{quoted_input(text)} isn't a URL: `{cut_input(after)}` follows its IPv6 address",
                )
            port_text = after[1:]
    else:
        colon = authority.find(":")
        if colon is not None:
            host = authority[:colon]
            port_text = authority[colon + 1:]
        refused = host_refused(host)
        if refused != "": fail InvalidValue(message=f"{quoted_input(text)} isn't a URL: {refused}")
        host = host.lower()
    if port_text == "": return (host, 0)
    port = int(port_text) except InvalidValue(): 0
    if not port_text.isdigit() or port < 1 or port > 65_535:
        fail InvalidValue(
            message=f"{quoted_input(text)} isn't a URL: its port `{cut_input(port_text)}` isn't from 1 to 65535",
        )
    return (host, port)

## `text` with each byte URLs can't hold as it is written as `%` and two hex digits, like `%20`
## for a space. Letters, digits and `-._~` are left as they are, and so is anything in `keep`.
export def quote(text: str, keep = "") -> str:
    return quoted(text, keep=keep)

def quoted(text: str, keep: str) -> str:
    raw = text.encode()
    mut out = list[int]()
    for b in raw:
        if is_unreserved(b) or (b < 128 and keep.find(text_of_byte(b)) is not None):
            out.append(b)
        else:
            out.append(37)
            out.append(hex_char(b >> 4))
            out.append(hex_char(b & 15))
    return bytes(out).decode() except InvalidValue(): text

## `text` with each `%` and two hex digits read as the byte they write. One that doesn't, like
## `%zz`, stays as it is, and so does text whose bytes aren't UTF-8 once read.
export def unquote(text: str) -> str:
    return decoded(text, plus=False)

## `params` as a query, `name=value` pairs joined by `&`, each part escaped as an HTML form
## sends it, with `+` for a space: `{"q": "red fox"}` is `q=red+fox`.
export def encode_query(params: dict[str, str]) -> str:
    return "&".join([
        form_quoted(name) + "=" + form_quoted(value) for name,
        value in params.items()
    ])

## A query's pairs, with their escapes read and `+` read as a space, in the order the query
## has them. A name with no `=` has the value "", and a name given twice keeps its first value,
## as `Url.query` does.
export def decode_query(text: str) -> dict[str, str]:
    mut found = dict[str, str]()
    for name, value in query_pairs(text):
        if name not in found:
            found[name] = value
    return found

## Every pair in a query, repeated names and all, in the order it has them.
def query_pairs(text: str) -> list[(str, str)]:
    mut found = list[(str, str)]()
    for pair in text.split("&"):
        if pair == "": continue
        equals = pair.find("=")
        if equals is None:
            found.append((decoded(pair, plus=True), ""))
        else:
            found.append((decoded(pair[:equals], plus=True), decoded(pair[equals + 1:], plus=True)))
    return found

def form_quoted(text: str) -> str:
    return quoted(text, keep=" ").replace(" ", "+")

def decoded(text: str, plus: bool) -> str:
    if text.find("%") is None and (not plus or text.find("+") is None): return text
    raw = text.encode()
    mut out = list[int]()
    mut at = 0
    while at < len(raw):
        b = raw[at]
        if b == 43 and plus:
            out.append(32)
            at += 1
        elif (
            b == 37
            and at + 2 < len(raw)
            and hex_value(raw[at + 1]) >= 0
            and hex_value(raw[at + 2]) >= 0
        ):
            out.append(hex_value(raw[at + 1]) * 16 + hex_value(raw[at + 2]))
            at += 3
        else:
            out.append(b)
            at += 1
    return bytes(out).decode() except InvalidValue(): text

def is_unreserved(b: int) -> bool:
    return (
        (b >= 65 and b <= 90)
        or (b >= 97 and b <= 122)
        or (b >= 48 and b <= 57)
        or b == 45
        or b == 46
        or b == 95
        or b == 126
    )

def hex_char(n: int) -> int:
    return n + 48 if n < 10 else n + 55

def hex_value(b: int) -> int:
    if b >= 48 and b <= 57: return b - 48
    if b >= 97 and b <= 102: return b - 87
    if b >= 65 and b <= 70: return b - 55
    return -1

def text_of_byte(b: int) -> str:
    return bytes([b]).decode() except InvalidValue(): ""
