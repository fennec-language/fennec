## Vectors, quaternions and matrices for games and graphics, and the math functions.
##
## Matrices are column-major and multiply column vectors, as in GLSL, WGSL and glTF, so a matrix
## goes to a GPU as it is: `Mat4`'s fields are its four columns. Rotations are right-handed, and
## `Mat4.perspective` maps depth to 0 through 1, as Vulkan, Metal, D3D and WebGPU take it. Each
## formula is the one glam uses, so the two give the same numbers.
from std import math

## Infinity, bigger than every other float: `-INFINITY` is smaller than all of them.
export INFINITY = 1e309

## NaN, the float that isn't a number, as a sum with no answer gives. Every NaN is the same float,
## so it equals itself, and `float.parse("nan")` gives it too.
export NAN = INFINITY - INFINITY

## A 2D vector, or a point in 2D.
export struct Vec2:
    x = 0.0
    y = 0.0

    def zero() -> Vec2:
        return Vec2()

    def +(self, other: Vec2) -> Vec2:
        return Vec2(x=self.x + other.x, y=self.y + other.y)

    def -(self, other: Vec2) -> Vec2:
        return Vec2(x=self.x - other.x, y=self.y - other.y)

    ## Every part times `scale`.
    def *(self, scale: float) -> Vec2:
        return Vec2(x=self.x * scale, y=self.y * scale)

    ## Each part times the same part of `other`.
    def mul(self, other: Vec2) -> Vec2:
        return Vec2(x=self.x * other.x, y=self.y * other.y)

    ## The vector pointing the other way.
    def negated(self) -> Vec2:
        return Vec2(x=-self.x, y=-self.y)

    def dot(self, other: Vec2) -> float:
        return self.x * other.x + self.y * other.y

    def length_squared(self) -> float:
        return self.dot(self)

    def length(self) -> float:
        return math.sqrt(self.dot(self))

    ## The same direction with length 1, or zero for the zero vector, which has no direction.
    def normalize(self) -> Vec2:
        length = self.length()
        if length == 0.0: return Vec2()
        return self * (1.0 / length)

    def distance(self, other: Vec2) -> float:
        return (self - other).length()

    ## The point `amount` of the way to `other`: `self` at 0 and `other` at 1.
    def lerp(self, other: Vec2, amount: float) -> Vec2:
        return self * (1.0 - amount) + other * amount

    ## The smaller of each part.
    def min(self, other: Vec2) -> Vec2:
        return Vec2(x=min(self.x, other.x), y=min(self.y, other.y))

    ## The larger of each part.
    def max(self, other: Vec2) -> Vec2:
        return Vec2(x=max(self.x, other.x), y=max(self.y, other.y))

    def abs(self) -> Vec2:
        return Vec2(x=abs(self.x), y=abs(self.y))

## A 3D vector, or a point in 3D.
export struct Vec3:
    x = 0.0
    y = 0.0
    z = 0.0

    def zero() -> Vec3:
        return Vec3()

    def +(self, other: Vec3) -> Vec3:
        return Vec3(x=self.x + other.x, y=self.y + other.y, z=self.z + other.z)

    def -(self, other: Vec3) -> Vec3:
        return Vec3(x=self.x - other.x, y=self.y - other.y, z=self.z - other.z)

    ## Every part times `scale`.
    def *(self, scale: float) -> Vec3:
        return Vec3(x=self.x * scale, y=self.y * scale, z=self.z * scale)

    ## Each part times the same part of `other`.
    def mul(self, other: Vec3) -> Vec3:
        return Vec3(x=self.x * other.x, y=self.y * other.y, z=self.z * other.z)

    ## The vector pointing the other way.
    def negated(self) -> Vec3:
        return Vec3(x=-self.x, y=-self.y, z=-self.z)

    def dot(self, other: Vec3) -> float:
        return self.x * other.x + self.y * other.y + self.z * other.z

    ## The vector at right angles to both, by the right-hand rule.
    def cross(self, other: Vec3) -> Vec3:
        return Vec3(
            x=self.y * other.z - other.y * self.z,
            y=self.z * other.x - other.z * self.x,
            z=self.x * other.y - other.x * self.y,
        )

    def length_squared(self) -> float:
        return self.dot(self)

    def length(self) -> float:
        return math.sqrt(self.dot(self))

    ## The same direction with length 1, or zero for the zero vector, which has no direction.
    def normalize(self) -> Vec3:
        length = self.length()
        if length == 0.0: return Vec3()
        return self * (1.0 / length)

    def distance(self, other: Vec3) -> float:
        return (self - other).length()

    ## The point `amount` of the way to `other`: `self` at 0 and `other` at 1.
    def lerp(self, other: Vec3, amount: float) -> Vec3:
        return self * (1.0 - amount) + other * amount

    ## The smaller of each part.
    def min(self, other: Vec3) -> Vec3:
        return Vec3(x=min(self.x, other.x), y=min(self.y, other.y), z=min(self.z, other.z))

    ## The larger of each part.
    def max(self, other: Vec3) -> Vec3:
        return Vec3(x=max(self.x, other.x), y=max(self.y, other.y), z=max(self.z, other.z))

    def abs(self) -> Vec3:
        return Vec3(x=abs(self.x), y=abs(self.y), z=abs(self.z))

    ## This vector with a fourth part, `w`: 1 for a point and 0 for a direction.
    def extend(self, w: float) -> Vec4:
        return Vec4(x=self.x, y=self.y, z=self.z, w=w)

## A 4D vector: a point or direction in 3D with its `w`, or a column of a `Mat4`.
export struct Vec4:
    x = 0.0
    y = 0.0
    z = 0.0
    w = 0.0

    def zero() -> Vec4:
        return Vec4()

    def +(self, other: Vec4) -> Vec4:
        return Vec4(x=self.x + other.x, y=self.y + other.y, z=self.z + other.z, w=self.w + other.w)

    def -(self, other: Vec4) -> Vec4:
        return Vec4(x=self.x - other.x, y=self.y - other.y, z=self.z - other.z, w=self.w - other.w)

    ## Every part times `scale`.
    def *(self, scale: float) -> Vec4:
        return Vec4(x=self.x * scale, y=self.y * scale, z=self.z * scale, w=self.w * scale)

    ## Each part times the same part of `other`.
    def mul(self, other: Vec4) -> Vec4:
        return Vec4(x=self.x * other.x, y=self.y * other.y, z=self.z * other.z, w=self.w * other.w)

    ## The vector pointing the other way.
    def negated(self) -> Vec4:
        return Vec4(x=-self.x, y=-self.y, z=-self.z, w=-self.w)

    def dot(self, other: Vec4) -> float:
        return self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w

    def length_squared(self) -> float:
        return self.dot(self)

    def length(self) -> float:
        return math.sqrt(self.dot(self))

    ## The same direction with length 1, or zero for the zero vector, which has no direction.
    def normalize(self) -> Vec4:
        length = self.length()
        if length == 0.0: return Vec4()
        return self * (1.0 / length)

    def distance(self, other: Vec4) -> float:
        return (self - other).length()

    ## The point `amount` of the way to `other`: `self` at 0 and `other` at 1.
    def lerp(self, other: Vec4, amount: float) -> Vec4:
        return self * (1.0 - amount) + other * amount

    ## The smaller of each part.
    def min(self, other: Vec4) -> Vec4:
        return Vec4(
            x=min(self.x, other.x),
            y=min(self.y, other.y),
            z=min(self.z, other.z),
            w=min(self.w, other.w),
        )

    ## The larger of each part.
    def max(self, other: Vec4) -> Vec4:
        return Vec4(
            x=max(self.x, other.x),
            y=max(self.y, other.y),
            z=max(self.z, other.z),
            w=max(self.w, other.w),
        )

    def abs(self) -> Vec4:
        return Vec4(x=abs(self.x), y=abs(self.y), z=abs(self.z), w=abs(self.w))

    ## The first three parts.
    def xyz(self) -> Vec3:
        return Vec3(x=self.x, y=self.y, z=self.z)

## A rotation in 3D, as a unit quaternion. `Quat()` turns nothing.
export struct Quat:
    x = 0.0
    y = 0.0
    z = 0.0
    w = 1.0

    def identity() -> Quat:
        return Quat()

    ## A turn of `angle` radians about `axis`, which has length 1: counterclockwise, looking from
    ## the axis's tip back toward where it starts.
    def from_axis_angle(axis: Vec3, angle: float) -> Quat:
        half = angle * 0.5
        turned = axis * math.sin(half)
        return Quat(x=turned.x, y=turned.y, z=turned.z, w=math.cos(half))

    def from_rotation_x(angle: float) -> Quat:
        half = angle * 0.5
        return Quat(x=math.sin(half), w=math.cos(half))

    def from_rotation_y(angle: float) -> Quat:
        half = angle * 0.5
        return Quat(y=math.sin(half), w=math.cos(half))

    def from_rotation_z(angle: float) -> Quat:
        half = angle * 0.5
        return Quat(z=math.sin(half), w=math.cos(half))

    ## Turning by `roll` about Z, then `pitch` about X, then `yaw` about Y, as a camera or a
    ## character turns.
    def from_euler(yaw: float, pitch: float, roll: float) -> Quat:
        return Quat.from_rotation_y(yaw) * Quat.from_rotation_x(pitch) * Quat.from_rotation_z(roll)

    ## Turning by `other`, then by this.
    def *(self, other: Quat) -> Quat:
        return Quat(
            x=self.w * other.x + self.x * other.w + self.y * other.z - self.z * other.y,
            y=self.w * other.y - self.x * other.z + self.y * other.w + self.z * other.x,
            z=self.w * other.z + self.x * other.y - self.y * other.x + self.z * other.w,
            w=self.w * other.w - self.x * other.x - self.y * other.y - self.z * other.z,
        )

    ## `point` turned by this rotation.
    def rotate(self, point: Vec3) -> Vec3:
        axis = Vec3(x=self.x, y=self.y, z=self.z)
        squared = axis.dot(axis)
        stretched = point * (self.w * self.w - squared) + axis * (point.dot(axis) * 2.0)
        return stretched + axis.cross(point) * (self.w * 2.0)

    def dot(self, other: Quat) -> float:
        return self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w

    def length(self) -> float:
        return math.sqrt(self.dot(self))

    ## The same rotation with length 1, which rounding drifts from after many turns.
    def normalize(self) -> Quat:
        length = self.length()
        if length == 0.0: return Quat()
        return self._scaled(1.0 / length)

    ## The same turn the other way.
    def conjugate(self) -> Quat:
        return Quat(x=-self.x, y=-self.y, z=-self.z, w=self.w)

    ## The rotation that undoes this one, which for a unit quaternion is its conjugate.
    def inverse(self) -> Quat:
        return self.conjugate()

    ## Part of the way from this rotation to `other`, the short way round, along a straight line
    ## made unit length again: quicker than `slerp`, but not at an even speed.
    def lerp(self, other: Quat, amount: float) -> Quat:
        if self.dot(other) < 0.0: return self._between(other._scaled(-1.0), amount)
        return self._between(other, amount)

    ## Part of the way from this rotation to `other`, the short way round, at an even speed.
    def slerp(self, other: Quat, amount: float) -> Quat:
        mut toward = other
        mut cosine = self.dot(other)
        if cosine < 0.0:
            toward = other._scaled(-1.0)
            cosine = -cosine
        # Nearly the same rotation: the angle's sine is too small to divide by.
        if cosine > 1.0 - 2.220446049250313e-16: return self._between(toward, amount)
        angle = math.acos(min(max(cosine, -1.0), 1.0))
        start = math.sin(angle * (1.0 - amount))
        end = math.sin(angle * amount)
        return self._scaled(start)._plus(toward._scaled(end))._scaled(1.0 / math.sin(angle))

    def _scaled(self, scale: float) -> Quat:
        return Quat(x=self.x * scale, y=self.y * scale, z=self.z * scale, w=self.w * scale)

    def _plus(self, other: Quat) -> Quat:
        return Quat(x=self.x + other.x, y=self.y + other.y, z=self.z + other.z, w=self.w + other.w)

    def _between(self, other: Quat, amount: float) -> Quat:
        return self._scaled(1.0 - amount)._plus(other._scaled(amount)).normalize()

## A 3x3 matrix, by its columns: a rotation and scale in 3D, or a 2D transform. `Mat3()` is the
## identity.
export struct Mat3:
    x_axis = Vec3(x=1.0)
    y_axis = Vec3(y=1.0)
    z_axis = Vec3(z=1.0)

    def identity() -> Mat3:
        return Mat3()

    ## The rotation `rotation` makes.
    def from_quat(rotation: Quat) -> Mat3:
        x2 = rotation.x + rotation.x
        y2 = rotation.y + rotation.y
        z2 = rotation.z + rotation.z
        xx = rotation.x * x2
        xy = rotation.x * y2
        xz = rotation.x * z2
        yy = rotation.y * y2
        yz = rotation.y * z2
        zz = rotation.z * z2
        wx = rotation.w * x2
        wy = rotation.w * y2
        wz = rotation.w * z2
        return Mat3(
            x_axis=Vec3(x=1.0 - (yy + zz), y=xy + wz, z=xz - wy),
            y_axis=Vec3(x=xy - wz, y=1.0 - (xx + zz), z=yz + wx),
            z_axis=Vec3(x=xz + wy, y=yz - wx, z=1.0 - (xx + yy)),
        )

    ## `other` first, then this.
    def *(self, other: Mat3) -> Mat3:
        return Mat3(
            x_axis=self.mul_vec3(other.x_axis),
            y_axis=self.mul_vec3(other.y_axis),
            z_axis=self.mul_vec3(other.z_axis),
        )

    ## This matrix times the column `vector`.
    def mul_vec3(self, vector: Vec3) -> Vec3:
        return self.x_axis * vector.x + self.y_axis * vector.y + self.z_axis * vector.z

    ## Rows made columns.
    def transpose(self) -> Mat3:
        return Mat3(
            x_axis=Vec3(x=self.x_axis.x, y=self.y_axis.x, z=self.z_axis.x),
            y_axis=Vec3(x=self.x_axis.y, y=self.y_axis.y, z=self.z_axis.y),
            z_axis=Vec3(x=self.x_axis.z, y=self.y_axis.z, z=self.z_axis.z),
        )

    def determinant(self) -> float:
        return self.x_axis.dot(self.y_axis.cross(self.z_axis))

    ## The matrix that undoes this one, or `None` when it squashes space flat and nothing can.
    def inverse(self) -> Mat3?:
        first = self.y_axis.cross(self.z_axis)
        second = self.z_axis.cross(self.x_axis)
        third = self.x_axis.cross(self.y_axis)
        determinant = self.x_axis.dot(first)
        if determinant == 0.0: return None
        scale = 1.0 / determinant
        return Mat3(x_axis=first * scale, y_axis=second * scale, z_axis=third * scale).transpose()

## A 4x4 matrix, by its columns: a transform in 3D, a camera's view or a projection. `Mat4()` is
## the identity.
export struct Mat4:
    x_axis = Vec4(x=1.0)
    y_axis = Vec4(y=1.0)
    z_axis = Vec4(z=1.0)
    w_axis = Vec4(w=1.0)

    def identity() -> Mat4:
        return Mat4()

    ## Moving by `offset`.
    def translation(offset: Vec3) -> Mat4:
        return Mat4(w_axis=offset.extend(1.0))

    ## The rotation `rotation` makes.
    def rotation(rotation: Quat) -> Mat4:
        turned = Mat3.from_quat(rotation)
        return Mat4(
            x_axis=turned.x_axis.extend(0.0),
            y_axis=turned.y_axis.extend(0.0),
            z_axis=turned.z_axis.extend(0.0),
        )

    ## Stretching by `factors` along each axis.
    def scaling(factors: Vec3) -> Mat4:
        return Mat4(x_axis=Vec4(x=factors.x), y_axis=Vec4(y=factors.y), z_axis=Vec4(z=factors.z))

    ## Scaling, then rotating, then moving: how a model is placed in a scene.
    def from_scale_rotation_translation(scale: Vec3, rotation: Quat, translation: Vec3) -> Mat4:
        turned = Mat3.from_quat(rotation)
        return Mat4(
            x_axis=turned.x_axis.extend(0.0) * scale.x,
            y_axis=turned.y_axis.extend(0.0) * scale.y,
            z_axis=turned.z_axis.extend(0.0) * scale.z,
            w_axis=translation.extend(1.0),
        )

    ## A camera's view from `eye` toward `target`, with `up` as up: right-handed, looking down -Z.
    def look_at(eye: Vec3, target: Vec3, up: Vec3) -> Mat4:
        forward = (target - eye).normalize()
        side = forward.cross(up).normalize()
        upward = side.cross(forward)
        return Mat4(
            x_axis=Vec4(x=side.x, y=upward.x, z=-forward.x),
            y_axis=Vec4(x=side.y, y=upward.y, z=-forward.y),
            z_axis=Vec4(x=side.z, y=upward.z, z=-forward.z),
            w_axis=Vec4(x=-eye.dot(side), y=-eye.dot(upward), z=eye.dot(forward), w=1.0),
        )

    ## A perspective projection: `fov_y` radians from the bottom of the view to its top, width
    ## over height `aspect`, and depth from `near` to `far` mapped to 0 through 1.
    def perspective(fov_y: float, aspect: float, near: float, far: float) -> Mat4:
        half = 0.5 * fov_y
        height = math.cos(half) / math.sin(half)
        depth = far / (near - far)
        return Mat4(
            x_axis=Vec4(x=height / aspect),
            y_axis=Vec4(y=height),
            z_axis=Vec4(z=depth, w=-1.0),
            w_axis=Vec4(z=depth * near),
        )

    ## `other` first, then this.
    def *(self, other: Mat4) -> Mat4:
        return Mat4(
            x_axis=self.mul_vec4(other.x_axis),
            y_axis=self.mul_vec4(other.y_axis),
            z_axis=self.mul_vec4(other.z_axis),
            w_axis=self.mul_vec4(other.w_axis),
        )

    ## This matrix times the column `vector`.
    def mul_vec4(self, vector: Vec4) -> Vec4:
        first = self.x_axis * vector.x + self.y_axis * vector.y
        return first + self.z_axis * vector.z + self.w_axis * vector.w

    ## Where `point` goes: moved, turned and scaled, with no divide by `w`.
    def transform_point(self, point: Vec3) -> Vec3:
        turned = self.z_axis * point.z + (self.y_axis * point.y + self.x_axis * point.x)
        return (self.w_axis + turned).xyz()

    ## Where the direction `vector` points: turned and scaled, but not moved.
    def transform_vector(self, vector: Vec3) -> Vec3:
        return (self.z_axis * vector.z + (self.y_axis * vector.y + self.x_axis * vector.x)).xyz()

    ## Rows made columns.
    def transpose(self) -> Mat4:
        return Mat4(
            x_axis=Vec4(x=self.x_axis.x, y=self.y_axis.x, z=self.z_axis.x, w=self.w_axis.x),
            y_axis=Vec4(x=self.x_axis.y, y=self.y_axis.y, z=self.z_axis.y, w=self.w_axis.y),
            z_axis=Vec4(x=self.x_axis.z, y=self.y_axis.z, z=self.z_axis.z, w=self.w_axis.z),
            w_axis=Vec4(x=self.x_axis.w, y=self.y_axis.w, z=self.z_axis.w, w=self.w_axis.w),
        )

    def determinant(self) -> float:
        first = self.x_axis
        second = self.y_axis
        third = self.z_axis
        fourth = self.w_axis
        zw = third.z * fourth.w - third.w * fourth.z
        yw = third.y * fourth.w - third.w * fourth.y
        yz = third.y * fourth.z - third.z * fourth.y
        xw = third.x * fourth.w - third.w * fourth.x
        xz = third.x * fourth.z - third.z * fourth.x
        xy = third.x * fourth.y - third.y * fourth.x
        along_x = first.x * (second.y * zw - second.z * yw + second.w * yz)
        along_y = first.y * (second.x * zw - second.z * xw + second.w * xz)
        along_z = first.z * (second.x * yw - second.y * xw + second.w * xy)
        along_w = first.w * (second.x * yz - second.y * xz + second.z * xy)
        return along_x - along_y + along_z - along_w

    ## The matrix that undoes this one, or `None` when it squashes space flat and nothing can.
    def inverse(self) -> Mat4?:
        first = self.x_axis
        second = self.y_axis
        third = self.z_axis
        fourth = self.w_axis
        # Two-by-two determinants of pairs of columns, numbered as glam numbers them.
        coef00 = third.z * fourth.w - fourth.z * third.w
        coef02 = second.z * fourth.w - fourth.z * second.w
        coef03 = second.z * third.w - third.z * second.w
        coef04 = third.y * fourth.w - fourth.y * third.w
        coef06 = second.y * fourth.w - fourth.y * second.w
        coef07 = second.y * third.w - third.y * second.w
        coef08 = third.y * fourth.z - fourth.y * third.z
        coef10 = second.y * fourth.z - fourth.y * second.z
        coef11 = second.y * third.z - third.y * second.z
        coef12 = third.x * fourth.w - fourth.x * third.w
        coef14 = second.x * fourth.w - fourth.x * second.w
        coef15 = second.x * third.w - third.x * second.w
        coef16 = third.x * fourth.z - fourth.x * third.z
        coef18 = second.x * fourth.z - fourth.x * second.z
        coef19 = second.x * third.z - third.x * second.z
        coef20 = third.x * fourth.y - fourth.x * third.y
        coef22 = second.x * fourth.y - fourth.x * second.y
        coef23 = second.x * third.y - third.x * second.y
        fac0 = Vec4(x=coef00, y=coef00, z=coef02, w=coef03)
        fac1 = Vec4(x=coef04, y=coef04, z=coef06, w=coef07)
        fac2 = Vec4(x=coef08, y=coef08, z=coef10, w=coef11)
        fac3 = Vec4(x=coef12, y=coef12, z=coef14, w=coef15)
        fac4 = Vec4(x=coef16, y=coef16, z=coef18, w=coef19)
        fac5 = Vec4(x=coef20, y=coef20, z=coef22, w=coef23)
        vec0 = Vec4(x=second.x, y=first.x, z=first.x, w=first.x)
        vec1 = Vec4(x=second.y, y=first.y, z=first.y, w=first.y)
        vec2 = Vec4(x=second.z, y=first.z, z=first.z, w=first.z)
        vec3 = Vec4(x=second.w, y=first.w, z=first.w, w=first.w)
        even = Vec4(x=1.0, y=-1.0, z=1.0, w=-1.0)
        odd = Vec4(x=-1.0, y=1.0, z=-1.0, w=1.0)
        column0 = (vec1.mul(fac0) - vec2.mul(fac1) + vec3.mul(fac2)).mul(even)
        column1 = (vec0.mul(fac0) - vec2.mul(fac3) + vec3.mul(fac4)).mul(odd)
        column2 = (vec0.mul(fac1) - vec1.mul(fac3) + vec3.mul(fac5)).mul(even)
        column3 = (vec0.mul(fac2) - vec1.mul(fac4) + vec2.mul(fac5)).mul(odd)
        products = first.mul(Vec4(x=column0.x, y=column1.x, z=column2.x, w=column3.x))
        determinant = products.x + products.y + products.z + products.w
        if determinant == 0.0: return None
        scale = 1.0 / determinant
        return Mat4(
            x_axis=column0 * scale,
            y_axis=column1 * scale,
            z_axis=column2 * scale,
            w_axis=column3 * scale,
        )

## How `sum` adds a list of floats, written out here so the order is plain: the sum of `items`,
## then `start`, with item `at` going into running total `at % 8`, and the eight added pairwise
## at the end, `((0 + 1) + (2 + 3)) + ((4 + 5) + (6 + 7))`. A sum one item at a time adds in the
## same order, so the two give the same bits, on every platform and engine. Eight totals lose less
## to rounding than one does on a long sum, and the eight adds of a round don't wait on each
## other, so the compiler can do them at once with no change to the order. `sum` is the way to
## call it.
def fixed_sum(items: list[float], start = 0.0) -> float:
    n = len(items)
    mut a0 = 0.0
    mut a1 = 0.0
    mut a2 = 0.0
    mut a3 = 0.0
    mut a4 = 0.0
    mut a5 = 0.0
    mut a6 = 0.0
    mut a7 = 0.0
    mut at = 0
    while at + 8 <= n:
        a0 += items[at]
        a1 += items[at + 1]
        a2 += items[at + 2]
        a3 += items[at + 3]
        a4 += items[at + 4]
        a5 += items[at + 5]
        a6 += items[at + 6]
        a7 += items[at + 7]
        at += 8
    # The last few, each into the total its place says, as above.
    left = n - at
    if left > 0:
        a0 += items[at]
    if left > 1:
        a1 += items[at + 1]
    if left > 2:
        a2 += items[at + 2]
    if left > 3:
        a3 += items[at + 3]
    if left > 4:
        a4 += items[at + 4]
    if left > 5:
        a5 += items[at + 5]
    if left > 6:
        a6 += items[at + 6]
    return start + (((a0 + a1) + (a2 + a3)) + ((a4 + a5) + (a6 + a7)))

## The sum of `a[at] * b[at]` at each place, added in the order `sum` adds floats in, so it's
## `sum(a[at] * b[at] for at in range(a.len()))` to the bit. `a` and `b` have to be the same length.
export def dot(a: list[float], b: list[float]) -> float:
    assert len(a) == len(b)
    n = len(a)
    mut a0 = 0.0
    mut a1 = 0.0
    mut a2 = 0.0
    mut a3 = 0.0
    mut a4 = 0.0
    mut a5 = 0.0
    mut a6 = 0.0
    mut a7 = 0.0
    mut at = 0
    while at + 8 <= n:
        a0 += a[at] * b[at]
        a1 += a[at + 1] * b[at + 1]
        a2 += a[at + 2] * b[at + 2]
        a3 += a[at + 3] * b[at + 3]
        a4 += a[at + 4] * b[at + 4]
        a5 += a[at + 5] * b[at + 5]
        a6 += a[at + 6] * b[at + 6]
        a7 += a[at + 7] * b[at + 7]
        at += 8
    # The last few, each into the total its place says, as above.
    left = n - at
    if left > 0:
        a0 += a[at] * b[at]
    if left > 1:
        a1 += a[at + 1] * b[at + 1]
    if left > 2:
        a2 += a[at + 2] * b[at + 2]
    if left > 3:
        a3 += a[at + 3] * b[at + 3]
    if left > 4:
        a4 += a[at + 4] * b[at + 4]
    if left > 5:
        a5 += a[at + 5] * b[at + 5]
    if left > 6:
        a6 += a[at + 6] * b[at + 6]
    # Added to 0.0 last, as `sum` adds its start.
    return 0.0 + (((a0 + a1) + (a2 + a3)) + ((a4 + a5) + (a6 + a7)))

## The value `amount` of the way from `start` to `end`: `lerp(0.0, 10.0, 0.5)` is `5.0`.
export def lerp(start: float, end: float, amount: float) -> float:
    return start + (end - start) * amount
