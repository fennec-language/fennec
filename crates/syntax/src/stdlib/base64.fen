# `std.base64`: bytes as text, in base64 as RFC 4648 sets it out. `encode` and `decode` use the
# standard alphabet, with `=` filling out the last four characters, as JSON, TOML and email do.
# `url_encode` and `url_decode` use the one that's safe in URLs and file names, with `-` and `_`
# for `+` and `/`, and no `=`.
from std.intrinsics import bytes_text, text_byte, text_size
from std.string import quoted_input

## `data` as standard base64 text, like `aGk=` for `b"hi"`.
export def encode(data: bytes) -> str:
    written(data, url=False)

## `data` as base64 text that's safe in a URL or a file name, like `aGk` for `b"hi"`.
export def url_encode(data: bytes) -> str:
    written(data, url=True)

## The bytes standard base64 text stands for. Text that isn't fails with an `InvalidValue`
## saying where.
export def decode(text: str) -> bytes fails InvalidValue:
    read_back(text, url=False)?

## The bytes URL-safe base64 text stands for, with or without `=` at its end.
export def url_decode(text: str) -> bytes fails InvalidValue:
    read_back(text, url=True)?

## The digit for six bits, 0 to 63.
def digit(n: int, url: bool) -> int:
    if n < 26: return n + 65
    if n < 52: return n + 71
    if n < 62: return n - 4
    if n == 62: return 45 if url else 43
    95 if url else 47

## The six bits a digit stands for, or -1 for a byte that isn't one.
def bits_of(b: int, url: bool) -> int:
    if b >= 65 and b <= 90: return b - 65
    if b >= 97 and b <= 122: return b - 71
    if b >= 48 and b <= 57: return b + 4
    if b == (45 if url else 43): return 62
    if b == (95 if url else 47): return 63
    -1

def written(data: bytes, url: bool) -> str:
    size = data.len()
    mut out = list[int]()
    mut at = 0
    while at + 2 < size:
        n = data[at] * 65_536 + data[at + 1] * 256 + data[at + 2]
        out.append(digit(n >> 18, url=url))
        out.append(digit((n >> 12) & 63, url=url))
        out.append(digit((n >> 6) & 63, url=url))
        out.append(digit(n & 63, url=url))
        at += 3
    left = size - at
    if left > 0:
        n = data[at] * 65_536 + (data[at + 1] * 256 if left == 2 else 0)
        out.append(digit(n >> 18, url=url))
        out.append(digit((n >> 12) & 63, url=url))
        if left == 2:
            out.append(digit((n >> 6) & 63, url=url))
        if not url:
            out.append(61)
            if left == 1:
                out.append(61)
    bytes_text(bytes(out), 0, out.len())

def read_back(text: str, url: bool) -> bytes fails InvalidValue:
    size = text_size(text)
    mut end = size
    while end > 0 and size - end < 2 and text_byte(text, end - 1) == 61:
        end -= 1
    if (end < size or not url) and size % 4 != 0:
        fail not_base64(text, "its length with `=` isn't a multiple of 4")
    if end % 4 == 1: fail not_base64(text, "it has a digit too many at its end")
    mut out = list[int]()
    mut at = 0
    while at < end:
        mut n = 0
        mut count = 0
        while count < 4 and at + count < end:
            b = text_byte(text, at + count)
            bits = bits_of(b, url=url)
            if bits < 0: fail not_base64(text, f"character {at + count + 1} isn't a base64 digit")
            n = n * 64 + bits
            count += 1
        # A short last group stands for fewer bytes: 2 digits for 1, 3 for 2.
        n = n << (6 * (4 - count))
        # Digits that hold more bits than the bytes they stand for: `aGl=` isn't what `hi` is
        # written as, and two texts for one value would let a check be passed around.
        if (count == 2 and n & 65535 != 0) or (count == 3 and n & 255 != 0):
            fail not_base64(text, "its last digit has bits that stand for nothing")
        out.append(n >> 16)
        if count > 2:
            out.append((n >> 8) & 255)
        if count > 3:
            out.append(n & 255)
        at += count
    bytes(out)

def not_base64(text: str, why: str) -> InvalidValue:
    InvalidValue(message=f"{quoted_input(text)} isn't base64: {why}")
