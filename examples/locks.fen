# `shared T`: one value many tasks can reach, each inside a `lock`. `lock x as s:` reads it,
# `lock x as ref s:` changes it, and two locked in one `lock` can never be taken in opposite
# orders.
struct Account:
    owner: str
    balance = 0

struct Bank:
    accounts: dict[str, shared Account]
    audit: shared list[str]

def transfer(bank: Bank, from_id: str, to_id: str, amount: int) -> bool:
    source = bank.accounts[from_id]
    target = bank.accounts[to_id]
    lock source, target as ref payer, ref payee:
        if payer.balance < amount: return False
        payer.balance -= amount
        payee.balance += amount
    lock bank.audit as ref log:
        log.append(f"{from_id} -> {to_id}: {amount}")
    return True

def balance(account: shared Account) -> int:
    lock account as current:
        return current.balance

test "a transfer moves money"():
    shared ana = Account(owner="ana", balance=10)
    shared bob = Account(owner="bo")
    shared log = list[str]()
    bank = Bank(accounts={"ana": ana, "bo": bob}, audit=log)
    assert transfer(bank, from_id="ana", to_id="bo", amount=4)
    assert not transfer(bank, from_id="bo", to_id="ana", amount=9)
    assert balance(ana) == 6 and balance(bob) == 4

def main(stdout: Stdout):
    shared ana = Account(owner="ana", balance=10)
    shared bob = Account(owner="bo")
    shared log = list[str]()
    bank = Bank(accounts={"ana": ana, "bo": bob}, audit=log)
    stdout.print(
        transfer(bank, from_id="ana", to_id="bo", amount=4),
        transfer(bank, from_id="bo", to_id="ana", amount=9),
    )
    stdout.print(balance(ana), balance(bob))
    lock log as lines:
        stdout.print(lines)
