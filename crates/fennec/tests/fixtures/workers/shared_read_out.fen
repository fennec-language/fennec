## Values made under a `shared` value's read lock that hold its strings, read after the lock is let go.

struct Note:
    id: str

struct Notes:
    items = list[Note]()
    tags = list[list[str]]()

    def add(ref self, note: Note):
        self.items.append(note)
        self.tags.append([note.id, note.id + " again"])

    def all(self) -> list[Note]:
        return [note for note in self.items]

    def all_tags(self) -> list[list[str]]:
        return [tags for tags in self.tags]

    def direct(self) -> list[Note]:
        return self.items

def main(stdout: Stdout):
    shared notes = Notes()
    for n in parallel([1, 2, 3, 4]):
        lock notes as ref held:
            held.add(Note(id=f"note {n}, long enough to live on the heap"))
    mut every = list[Note]()
    mut all_tags = list[list[str]]()
    mut direct = list[Note]()
    lock notes as held:
        every = held.all()
        all_tags = held.all_tags()
        direct = held.direct()
    for note in every:
        stdout.print(note.id)
    for tags in all_tags:
        stdout.print(tags[1])
    for note in direct:
        stdout.print(note.id, len(note.id))
