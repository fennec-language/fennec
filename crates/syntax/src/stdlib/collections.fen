from std.intrinsics import id_at, id_key, id_of_key, id_tag, table_of_slots, table_slots, table_tag, table_tagged, type_name

## A double-ended queue: adding or removing at either end is quick however long it gets.
## For breadth-first searches, event queues and undo histories.
export struct Deque[T]:
    ## The items sit in a ring that starts at `head`. Slots outside it hold stale items.
    slots: list[T] = []
    head = 0
    count = 0

    ## A deque holding `items`, first to last.
    def of(items: list[T]) -> Deque[T]:
        return Deque(slots=items, count=len(items))

    def len(self) -> int:
        return self.count

    ## The item at a position, counting from the front, which `for ref` changes where it is.
    def [](ref self, at: int) -> T:
        assert 0 <= at and at < self.count
        return self.slots[(self.head + at) % len(self.slots)]

    ## `item in deque`, looking from the front.
    def in(self, item: T) -> bool:
        for at in range(self.count):
            if self.slots[(self.head + at) % len(self.slots)] == item: return True
        return False

    ## Prints its items: `Deque([1, 2])`.
    def str(self, ref out: StrWriter):
        out.write("Deque(")
        out.value(list(self))
        out.write(")")

    ## Adds an item at the back.
    def append(ref self, item: T):
        self.make_room(item)
        self.slots[(self.head + self.count) % len(self.slots)] = item
        self.count += 1

    ## Adds an item at the front.
    def appendleft(ref self, item: T):
        self.make_room(item)
        self.head = (self.head - 1) % len(self.slots)
        self.slots[self.head] = item
        self.count += 1

    ## Removes the item at the back and gives it back, or None when the deque is empty.
    def pop(ref self) -> T?:
        if self.count == 0: return None
        self.count -= 1
        return self.slots[(self.head + self.count) % len(self.slots)]

    ## Removes the item at the front and gives it back, or None when the deque is empty.
    def popleft(ref self) -> T?:
        if self.count == 0: return None
        item = self.slots[self.head]
        self.head = (self.head + 1) % len(self.slots)
        self.count -= 1
        return item

    ## The item at the front, or None when the deque is empty.
    def first(self) -> T?:
        if self.count == 0: return None
        return self.slots[self.head]

    ## The item at the back, or None when the deque is empty.
    def last(self) -> T?:
        if self.count == 0: return None
        return self.slots[(self.head + self.count - 1) % len(self.slots)]

    def clear(ref self):
        self.slots = []
        self.head = 0
        self.count = 0

    ## The items, front to back.
    def items(self) -> list[T]:
        return [self.slots[(self.head + at) % len(self.slots)] for at in range(self.count)]

    def iter(self) -> Iterator[T]:
        for at in range(self.count):
            yield self.slots[(self.head + at) % len(self.slots)]

    ## Makes room for one more item, doubling the slots when they're full. `filler` fills
    ## the new slots.
    def make_room(ref self, filler: T):
        if self.count < len(self.slots): return
        mut slots = self.items()
        for _ in range(len(slots) + 1):
            slots.append(filler)
        self.slots = slots
        self.head = 0

## Deques of items that can be compared are equal when they hold equal items in the same
## order, whatever room each has spare.
extend Deque[T: Eq]:
    def ==(self, other: Deque[T]) -> bool:
        return self.items() == other.items()

## A binary min-heap: `pop` gives back the smallest item. Items are compared with `<`, so
## they can be numbers, strings, tuples, or structs with `def <`. For the largest first,
## push negated numbers, or use a `PriorityQueue` with negated priorities.
export struct Heap[T: Ordered]:
    items: list[T] = []

    ## A heap holding `items`.
    def of(items: list[T]) -> Heap[T]:
        mut heap = Heap(items=items)
        for at in range(len(items) // 2 - 1, -1, -1):
            heap.sift_down(at)
        return heap

    def len(self) -> int:
        return len(self.items)

    def push(ref self, item: T):
        self.items.append(item)
        mut at = len(self.items) - 1
        while at > 0:
            parent = (at - 1) // 2
            if not self.items[at] < self.items[parent]: break
            self.swap(at, parent)
            at = parent

    ## Removes the smallest item and gives it back, or None when the heap is empty.
    def pop(ref self) -> T?:
        last = self.items.pop() else return None
        if len(self.items) == 0: return last
        smallest = self.items[0]
        self.items[0] = last
        self.sift_down(0)
        return smallest

    ## The smallest item, or None when the heap is empty.
    def peek(self) -> T?:
        if len(self.items) == 0: return None
        return self.items[0]

    def clear(ref self):
        self.items = []

    ## Moves the item at `start` down until it's no bigger than the items below it.
    def sift_down(ref self, start: int):
        mut at = start
        while True:
            left = 2 * at + 1
            if left >= len(self.items): break
            mut child = left
            if left + 1 < len(self.items) and self.items[left + 1] < self.items[left]:
                child = left + 1
            if not self.items[child] < self.items[at]: break
            self.swap(at, child)
            at = child

    def swap(ref self, a: int, b: int):
        item = self.items[a]
        self.items[a] = self.items[b]
        self.items[b] = item

## A queue where items come out lowest priority first, and items with the same priority
## come out in the order they went in. For highest first, negate the priorities.
export struct PriorityQueue[T, P: Ordered]:
    ## Each item's priority and the order it was pushed in, smallest first. Items wait in
    ## `waiting` by that order, so they needn't have an order themselves.
    heap: Heap[(P, int)] = Heap()
    waiting: dict[int, T] = {}
    pushed = 0

    def len(self) -> int:
        return len(self.heap)

    def push(ref self, item: T, priority: P):
        self.heap.push((priority, self.pushed))
        self.waiting[self.pushed] = item
        self.pushed += 1

    ## Removes the item with the lowest priority and gives it back, or None when the queue
    ## is empty.
    def pop(ref self) -> T?:
        entry = self.heap.pop()
        if entry is None: return None
        priority, order = entry
        return self.waiting.pop(order)

    ## The item with the lowest priority, or None when the queue is empty.
    def peek(self) -> T?:
        entry = self.heap.peek()
        if entry is None: return None
        priority, order = entry
        return self.waiting[order]

## Counts how many times each item appears. Items keep the order they were first counted in.
export struct Counter[T: Hashable]:
    counts: dict[T, int] = {}

    ## A counter of `items`.
    def of(items: list[T]) -> Counter[T]:
        mut counter = Counter()
        counter.update(items)
        return counter

    ## How many different items it has counted.
    def len(self) -> int:
        return len(self.counts)

    ## Prints its items: `Counter({"x": 2})`.
    def str(self, ref out: StrWriter):
        out.write("Counter(")
        out.value(self.counts)
        out.write(")")

    ## Counts one more `item`.
    def add(ref self, item: T):
        self.counts[item] = (self.counts.get(item) else 0) + 1

    ## Counts each of `items`.
    def update(ref self, items: list[T]):
        for item in items:
            self.add(item)

    ## How many times `item` was counted: 0 if never.
    def [](self, item: T) -> int:
        return self.counts.get(item) else 0

    ## `item in counter`: whether `item` was counted at all.
    def in(self, item: T) -> bool:
        return item in self.counts

    def []=(ref self, item: T, count: int):
        self.counts[item] = count

    ## How many items were counted in all.
    def total(self) -> int:
        return sum(self.counts.values())

    ## The `n` most common items and their counts, most common first. Ties keep the order
    ## the items were first counted in.
    def most_common(self, n: int) -> list[(T, int)]:
        pairs = self.counts.items()
        counts = self.counts.values()
        ranked = sorted(range(len(pairs)), key=at => -counts[at])
        return [pairs[at] for at in ranked[:n]]

    ## Each item and its count, in the order they were first counted.
    def items(self) -> list[(T, int)]:
        return self.counts.items()

    def iter(self) -> Iterator[T]:
        for item in self.counts:
            yield item

## Many small lists stored as one: every item in a single list, and a table of where each
## inner list starts. However many lists it holds, that's two blocks of memory, where a
## `list[list[T]]` needs one for each inner list. For graphs, mesh faces and grouped data,
## the layout written by hand as compressed sparse rows. Lists are added whole at the end
## and read back by position. They can't grow in the middle, which is the price of being
## dense.
export struct Packed[T]:
    _items: list[T] = []
    ## Where each list starts in `_items`, and one more for where the last one ends.
    _starts: list[int] = [0]

    ## A packed copy of `lists`.
    def of(lists: list[list[T]]) -> Packed[T]:
        mut packed = Packed()
        for items in lists:
            packed.append(items)
        return packed

    ## How many lists it holds.
    def len(self) -> int:
        return len(self._starts) - 1

    ## Prints its items: `Packed([[1, 2], [3]])`.
    def str(self, ref out: StrWriter):
        out.write("Packed(")
        out.value(list(self))
        out.write(")")

    ## The items of the list at `at`, read in place, with no copy: `for x in packed[at]:`.
    ## `list(packed[at])` makes a copy. One past the end stops the program, like a list.
    def [](self, at: int) -> Iterator[T]:
        assert 0 <= at and at < len(self)
        for spot in range(self._starts[at], self._starts[at + 1]):
            yield self._items[spot]

    ## How many items the list at `at` holds, without reading them.
    def len_of(self, at: int) -> int:
        assert 0 <= at and at < len(self)
        return self._starts[at + 1] - self._starts[at]

    ## How many items all the lists hold together.
    def item_count(self) -> int:
        return len(self._items)

    ## Adds `items` as a new list at the end.
    def append(ref self, items: list[T]):
        self._items.extend(items)
        self._starts.append(len(self._items))

    ## Starts a new, empty list at the end, for `push` to add to.
    def start_list(ref self):
        self._starts.append(len(self._items))

    ## Adds `item` to the end of the last list. With no list yet, it starts one.
    def push(ref self, item: T):
        if len(self) == 0:
            self.start_list()
        self._items.append(item)
        self._starts[-1] = len(self._items)

    ## Every item of every list, in order, as one list.
    def items(self) -> list[T]:
        return self._items

    ## The lists, as a `list[list[T]]`.
    def lists(self) -> list[list[T]]:
        return [list(self[at]) for at in range(len(self))]

    def iter(self) -> Iterator[list[T]]:
        for at in range(len(self)):
            yield list(self[at])

## Moving a node under itself or one of its descendants.
export error TreeCycle:
    message: str

## A node of a `Tree`: its value and its links. `tree[id]` gives the value, so programs only
## name this type to write the type of an ID: `type NodeId = Id[TreeNode[Node]]`.
export struct TreeNode[T]:
    value: T
    parent: Id[TreeNode[T]]? = None
    children: list[Id[TreeNode[T]]] = []

## Values with parents and children, kept in sync. Nodes are reached by the IDs `add` gives
## back, so a tree holds no references, and copying one gives an independent tree. An ID of
## a removed node stops the program, like an index out of range.
export struct Tree[T]:
    _nodes: Table[TreeNode[T]] = Table[TreeNode[T]]()
    _roots: list[Id[TreeNode[T]]] = []

    ## How many nodes the tree has.
    def len(self) -> int:
        return len(self._nodes)

    ## Adds a node as the last child of `parent`, or as a root when it has none.
    def add(ref self, value: T, parent: Id[TreeNode[T]]? = None) -> Id[TreeNode[T]]:
        id = self._nodes.add(TreeNode(value=value, parent=parent))
        if parent is None:
            self._roots.append(id)
        else:
            self._nodes[parent].children.append(id)
        return id

    def [](self, id: Id[TreeNode[T]]) -> T:
        return self._nodes[id].value

    def []=(ref self, id: Id[TreeNode[T]], value: T):
        self._nodes[id].value = value

    ## The value of a node, or None when it's been removed.
    def get(self, id: Id[TreeNode[T]]) -> T?:
        node = self._nodes.get(id)
        if node is None: return None
        return node.value

    ## The node's parent, or None for a root.
    def parent(self, id: Id[TreeNode[T]]) -> Id[TreeNode[T]]?:
        return self._nodes[id].parent

    ## The node `levels` above this one, or None when the tree isn't that deep here.
    def up(self, id: Id[TreeNode[T]], levels: int) -> Id[TreeNode[T]]?:
        mut at = id
        for _ in range(levels):
            above = self._nodes[at].parent
            if above is None: return None
            at = above
        return at

    ## The node's children, in the order they were added.
    def children(self, id: Id[TreeNode[T]]) -> list[Id[TreeNode[T]]]:
        return self._nodes[id].children

    ## The nodes with no parent, in the order they became roots.
    def roots(self) -> list[Id[TreeNode[T]]]:
        return self._roots

    ## The nodes above this one, nearest first.
    def ancestors(self, id: Id[TreeNode[T]]) -> list[Id[TreeNode[T]]]:
        mut found = []
        mut above = self._nodes[id].parent
        while above is not None:
            found.append(above)
            above = self._nodes[above].parent
        return found

    ## The nodes below this one, depth first: each node before its children, and children in
    ## order.
    def descendants(self, id: Id[TreeNode[T]]) -> list[Id[TreeNode[T]]]:
        mut found = []
        mut waiting = reversed(self._nodes[id].children)
        while True:
            at = waiting.pop() else break
            found.append(at)
            for child in reversed(self._nodes[at].children):
                waiting.append(child)
        return found

    ## Moves a node, with everything below it, to be the last child of `parent`.
    def move(ref self, id: Id[TreeNode[T]], parent: Id[TreeNode[T]]):
        if id == parent or id in self.ancestors(parent):
            fail TreeCycle(message="a node can't move under itself or its descendants")
        self._unlink(id)
        self._nodes[id].parent = parent
        self._nodes[parent].children.append(id)

    ## Makes a node a root, with everything below it staying below it.
    def make_root(ref self, id: Id[TreeNode[T]]):
        self._unlink(id)
        self._nodes[id].parent = None
        self._roots.append(id)

    ## Removes a node and everything below it.
    def remove(ref self, id: Id[TreeNode[T]]):
        doomed = self.descendants(id)
        self._unlink(id)
        self._nodes.remove(id)
        for at in doomed:
            self._nodes.remove(at)

    ## Takes a node out of its parent's children, or out of the roots.
    def _unlink(ref self, id: Id[TreeNode[T]]):
        parent = self._nodes[id].parent
        if parent is None:
            self._roots.remove(id)
        else:
            self._nodes[parent].children.remove(id)

## One node of a `SortedMap`'s B-tree: keys in order, their values, and for a node that isn't
## a leaf, the children between and around them.
struct SortedNode[K, V]:
    keys: list[K] = []
    values: list[V] = []
    children: list[int] = []

## Keys kept in order, each with a value: a B-tree, so finding, adding and removing a key
## take time that grows with the log of the size, and walking the keys gives them in order.
## Keys are compared with `<`. Its nodes live in a list, reached by position, so the map is
## a plain value: copying one gives an independent map.
export struct SortedMap[K: Ordered, V]:
    _nodes: list[SortedNode[K, V]] = []
    _root = -1
    _count = 0
    ## Nodes that were merged away, to be used again.
    _free: list[int] = []

    ## A map of `items`, each a key and its value. A key given twice keeps its last value.
    def of(items: list[(K, V)]) -> SortedMap[K, V]:
        mut found = SortedMap()
        for key, value in items:
            found[key] = value
        return found

    def len(self) -> int:
        return self._count

    ## Prints its items: `SortedMap({1: "a", 2: "b"})`.
    def str(self, ref out: StrWriter):
        out.write("SortedMap(")
        out.value({key: value for key, value in self.items()})
        out.write(")")

    ## The value of `key`, or None when it has none.
    def get(self, key: K) -> V?:
        node, i = self._slot(key)
        if node < 0: return None
        return self._nodes[node].values[i]

    ## `key in map`: whether `key` has a value.
    def in(self, key: K) -> bool:
        node, _ = self._slot(key)
        return node >= 0

    ## The value of `key`. A key with no value stops the program, like a dict.
    def [](self, key: K) -> V:
        node, i = self._slot(key)
        assert node >= 0
        return self._nodes[node].values[i]

    def []=(ref self, key: K, value: V):
        self.set(key, value)

    ## Gives `key` the value `value`, replacing any it had.
    def set(ref self, key: K, value: V):
        if self._root < 0:
            self._root = self._new_node(SortedNode(keys=[key], values=[value]))
            self._count = 1
            return
        if len(self._nodes[self._root].keys) == SortedMap._most():
            old = self._root
            self._root = self._new_node(SortedNode(children=[old]))
            self._split(self._root, 0)
        mut at = self._root
        while True:
            i = SortedMap._position(self._nodes[at].keys, key)
            if i < len(self._nodes[at].keys) and self._nodes[at].keys[i] == key:
                self._nodes[at].values[i] = value
                return
            if len(self._nodes[at].children) == 0:
                self._nodes[at].keys.insert(i, key)
                self._nodes[at].values.insert(i, value)
                self._count += 1
                return
            mut next = i
            child = self._nodes[at].children[i]
            if len(self._nodes[child].keys) == SortedMap._most():
                self._split(at, i)
                middle = self._nodes[at].keys[i]
                if middle == key:
                    self._nodes[at].values[i] = value
                    return
                if middle < key:
                    next = i + 1
            at = self._nodes[at].children[next]

    ## Removes `key` and gives back its value, or None when it had none.
    def remove(ref self, key: K) -> V?:
        if key not in self: return None
        mut taken: list[V] = []
        mut wanted = key
        mut at = self._root
        while True:
            i = SortedMap._position(self._nodes[at].keys, wanted)
            found = i < len(self._nodes[at].keys) and self._nodes[at].keys[i] == wanted
            leaf = len(self._nodes[at].children) == 0
            if found and leaf:
                if len(taken) == 0:
                    taken.append(self._nodes[at].values[i])
                self._nodes[at].keys.pop(i)
                self._nodes[at].values.pop(i)
                break
            if found:
                # The key moves down to a child that can spare one, or into a merged child.
                if len(taken) == 0:
                    taken.append(self._nodes[at].values[i])
                left = self._nodes[at].children[i]
                right = self._nodes[at].children[i + 1]
                if len(self._nodes[left].keys) > SortedMap._fewest():
                    near_key, near_value = self._last_of(left)
                    self._nodes[at].keys[i] = near_key
                    self._nodes[at].values[i] = near_value
                    wanted = near_key
                    at = left
                elif len(self._nodes[right].keys) > SortedMap._fewest():
                    near_key, near_value = self._first_of(right)
                    self._nodes[at].keys[i] = near_key
                    self._nodes[at].values[i] = near_value
                    wanted = near_key
                    at = right
                else:
                    self._merge(at, i)
                    at = self._shrunk_root(at, left)
                continue
            at = self._fill(at, i)
        self._count -= 1
        if len(self._nodes[self._root].keys) == 0 and len(self._nodes[self._root].children) == 0:
            self._release(self._root)
            self._root = -1
        return taken[0]

    ## The smallest key and its value, or None when the map is empty.
    def first(self) -> (K, V)?:
        if self._root < 0: return None
        return self._first_of(self._root)

    ## The largest key and its value, or None when the map is empty.
    def last(self) -> (K, V)?:
        if self._root < 0: return None
        return self._last_of(self._root)

    ## The largest key that's at most `key`, and its value, or None when there's none.
    def floor(self, key: K) -> (K, V)?:
        mut best: list[(K, V)] = []
        mut at = self._root
        while at >= 0:
            node = self._nodes[at]
            i = SortedMap._position(node.keys, key)
            if i < len(node.keys) and node.keys[i] == key: return (node.keys[i], node.values[i])
            if i > 0:
                best = [(node.keys[i - 1], node.values[i - 1])]
            if len(node.children) == 0: break
            at = node.children[i]
        if len(best) == 0: return None
        return best[0]

    ## The smallest key that's at least `key`, and its value, or None when there's none.
    def ceiling(self, key: K) -> (K, V)?:
        mut best: list[(K, V)] = []
        mut at = self._root
        while at >= 0:
            node = self._nodes[at]
            i = SortedMap._position(node.keys, key)
            if i < len(node.keys):
                if node.keys[i] == key: return (node.keys[i], node.values[i])
                best = [(node.keys[i], node.values[i])]
            if len(node.children) == 0: break
            at = node.children[i]
        if len(best) == 0: return None
        return best[0]

    ## Each key and its value, from the smallest key.
    def items(self) -> list[(K, V)]:
        mut found = []
        if self._root >= 0:
            self._walk(self._root, ref found)
        return found

    ## The keys and values from `low` up to, but not including, `high`, in order.
    def between(self, low: K, high: K) -> list[(K, V)]:
        mut found = []
        if self._root >= 0:
            self._walk_between(self._root, low, high, ref found)
        return found

    def keys(self) -> list[K]:
        return [key for key, _ in self.items()]

    def values(self) -> list[V]:
        return [value for _, value in self.items()]

    ## The keys from the smallest, walking down the tree with a trail of where each node on
    ## the way got to.
    def iter(self) -> Iterator[K]:
        mut trail: list[(int, int)] = []
        self._descend(self._root, ref trail)
        while len(trail) > 0:
            at, spot = trail[-1]
            node = self._nodes[at]
            # Most keys are in leaves, which give theirs all at once.
            if len(node.children) == 0 or spot == len(node.keys):
                if len(node.children) == 0:
                    for key in node.keys:
                        yield key
                trail.pop()
                continue
            trail[-1] = (at, spot + 1)
            yield node.keys[spot]
            self._descend(node.children[spot + 1], ref trail)

    def clear(ref self):
        self._nodes = []
        self._root = -1
        self._count = 0
        self._free = []

    ## Half the most keys a node holds, so every node but the root is at least half full.
    def _degree() -> int:
        return 16

    def _most() -> int:
        return 2 * SortedMap._degree() - 1

    def _fewest() -> int:
        return SortedMap._degree() - 1

    ## Where `key` is or would go among `keys`: the first place whose key isn't below it.
    def _position(keys: list[K], key: K) -> int:
        mut low = 0
        mut high = len(keys)
        while low < high:
            middle = (low + high) // 2
            if keys[middle] < key:
                low = middle + 1
            else:
                high = middle
        return low

    ## The node holding `key` and where it is in it, or -1 for both when it isn't there.
    def _slot(self, key: K) -> (int, int):
        mut at = self._root
        while at >= 0:
            node = self._nodes[at]
            i = SortedMap._position(node.keys, key)
            if i < len(node.keys) and node.keys[i] == key: return (at, i)
            if len(node.children) == 0: break
            at = node.children[i]
        return (-1, -1)

    def _new_node(ref self, node: SortedNode[K, V]) -> int:
        at = self._free.pop() else:
            self._nodes.append(node)
            return len(self._nodes) - 1
        self._nodes[at] = node
        return at

    def _release(ref self, at: int):
        self._nodes[at] = SortedNode()
        self._free.append(at)

    ## Splits the full child `i` of `parent` in two, moving its middle key up into `parent`.
    def _split(ref self, parent: int, i: int):
        child = self._nodes[parent].children[i]
        full = self._nodes[child]
        half = SortedMap._degree()
        right = SortedNode(
            keys=full.keys[half:],
            values=full.values[half:],
            children=full.children[half:] if len(full.children) > 0 else [],
        )
        right_at = self._new_node(right)
        self._nodes[parent].keys.insert(i, full.keys[half - 1])
        self._nodes[parent].values.insert(i, full.values[half - 1])
        self._nodes[parent].children.insert(i + 1, right_at)
        self._nodes[child].keys = full.keys[:half - 1]
        self._nodes[child].values = full.values[:half - 1]
        if len(full.children) > 0:
            self._nodes[child].children = full.children[:half]

    ## Merges child `i + 1` of `parent` into child `i`, with the key between them.
    def _merge(ref self, parent: int, i: int):
        left = self._nodes[parent].children[i]
        right = self._nodes[parent].children[i + 1]
        moved = self._nodes[right]
        self._nodes[left].keys.append(self._nodes[parent].keys.pop(i))
        self._nodes[left].values.append(self._nodes[parent].values.pop(i))
        self._nodes[left].keys.extend(moved.keys)
        self._nodes[left].values.extend(moved.values)
        self._nodes[left].children.extend(moved.children)
        self._nodes[parent].children.pop(i + 1)
        self._release(right)

    ## When merging emptied the root, the merged child takes its place.
    def _shrunk_root(ref self, at: int, child: int) -> int:
        if at == self._root and len(self._nodes[at].keys) == 0:
            self._release(at)
            self._root = child
        return child

    ## Makes sure child `i` of `at` has a key to spare before going down into it, by taking
    ## one from a sibling or merging with one. Gives back the node to go down into.
    def _fill(ref self, at: int, i: int) -> int:
        child = self._nodes[at].children[i]
        if len(self._nodes[child].keys) > SortedMap._fewest(): return child
        fewest = SortedMap._fewest()
        siblings = len(self._nodes[at].children)
        if i > 0 and len(self._nodes[self._nodes[at].children[i - 1]].keys) > fewest:
            left = self._nodes[at].children[i - 1]
            self._nodes[child].keys.insert(0, self._nodes[at].keys[i - 1])
            self._nodes[child].values.insert(0, self._nodes[at].values[i - 1])
            self._nodes[at].keys[i - 1] = self._nodes[left].keys.pop(-1)
            self._nodes[at].values[i - 1] = self._nodes[left].values.pop(-1)
            if len(self._nodes[left].children) > 0:
                self._nodes[child].children.insert(0, self._nodes[left].children.pop(-1))
            return child
        if i + 1 < siblings and len(self._nodes[self._nodes[at].children[i + 1]].keys) > fewest:
            right = self._nodes[at].children[i + 1]
            self._nodes[child].keys.append(self._nodes[at].keys[i])
            self._nodes[child].values.append(self._nodes[at].values[i])
            self._nodes[at].keys[i] = self._nodes[right].keys.pop(0)
            self._nodes[at].values[i] = self._nodes[right].values.pop(0)
            if len(self._nodes[right].children) > 0:
                self._nodes[child].children.append(self._nodes[right].children.pop(0))
            return child
        if i + 1 < siblings:
            self._merge(at, i)
            return self._shrunk_root(at, child)
        left = self._nodes[at].children[i - 1]
        self._merge(at, i - 1)
        return self._shrunk_root(at, left)

    def _first_of(self, at: int) -> (K, V):
        mut node = self._nodes[at]
        while len(node.children) > 0:
            node = self._nodes[node.children[0]]
        return (node.keys[0], node.values[0])

    def _last_of(self, at: int) -> (K, V):
        mut node = self._nodes[at]
        while len(node.children) > 0:
            node = self._nodes[node.children[-1]]
        return (node.keys[-1], node.values[-1])

    ## Goes down the first children from `at` to a leaf, adding each node to `trail`.
    def _descend(self, start: int, ref trail: list[(int, int)]):
        mut at = start
        while at >= 0:
            trail.append((at, 0))
            children = self._nodes[at].children
            if len(children) == 0: return
            at = children[0]

    def _walk(self, at: int, ref found: list[(K, V)]):
        node = self._nodes[at]
        for i in range(len(node.keys)):
            if len(node.children) > 0:
                self._walk(node.children[i], ref found)
            found.append((node.keys[i], node.values[i]))
        if len(node.children) > 0:
            self._walk(node.children[-1], ref found)

    ## Like `_walk`, leaving out the children that can't hold a key in the range.
    def _walk_between(self, at: int, low: K, high: K, ref found: list[(K, V)]):
        node = self._nodes[at]
        leaf = len(node.children) == 0
        start = SortedMap._position(node.keys, low)
        for i in range(start, len(node.keys)):
            if not leaf:
                self._walk_between(node.children[i], low, high, ref found)
            if not node.keys[i] < high: return
            found.append((node.keys[i], node.values[i]))
        if not leaf:
            self._walk_between(node.children[-1], low, high, ref found)

## Sorted maps of values that can be compared are equal when they hold equal keys with equal
## values, however their trees are shaped.
extend SortedMap[K: Ordered, V: Eq]:
    def ==(self, other: SortedMap[K, V]) -> bool:
        return len(self) == len(other) and self.items() == other.items()

## Items kept in order, each once: a `SortedMap` with no values, so finding, adding and
## removing an item take time that grows with the log of the size. Items are compared with
## `<`, and copying a set gives an independent set.
export struct SortedSet[T: Ordered]:
    _items: SortedMap[T, bool] = SortedMap[T, bool]()

    ## Equal when they hold the same items.
    def ==(self, other: SortedSet[T]) -> bool:
        return self._items == other._items

    ## A set of `items`.
    def of(items: list[T]) -> SortedSet[T]:
        mut found = SortedSet()
        for item in items:
            found.add(item)
        return found

    def len(self) -> int:
        return len(self._items)

    ## Prints its items: `SortedSet([1, 3])`.
    def str(self, ref out: StrWriter):
        out.write("SortedSet(")
        out.value(list(self))
        out.write(")")

    def add(ref self, item: T):
        self._items[item] = True

    ## Removes `item` if it's there.
    def discard(ref self, item: T):
        if item in self._items:
            self._items.remove(item)

    ## Removes `item`. One that isn't there stops the program, like a set.
    def remove(ref self, item: T):
        assert self._items.remove(item) is not None

    ## `item in set`.
    def in(self, item: T) -> bool:
        return item in self._items

    ## The smallest item, or None when the set is empty.
    def first(self) -> T?:
        found = self._items.first()
        if found is None: return None
        item, _ = found
        return item

    ## The largest item, or None when the set is empty.
    def last(self) -> T?:
        found = self._items.last()
        if found is None: return None
        item, _ = found
        return item

    ## The largest item that's at most `item`, or None when there's none.
    def floor(self, item: T) -> T?:
        found = self._items.floor(item)
        if found is None: return None
        near, _ = found
        return near

    ## The smallest item that's at least `item`, or None when there's none.
    def ceiling(self, item: T) -> T?:
        found = self._items.ceiling(item)
        if found is None: return None
        near, _ = found
        return near

    ## The items from `low` up to, but not including, `high`, in order.
    def between(self, low: T, high: T) -> list[T]:
        return [item for item, _ in self._items.between(low, high)]

    ## The items, smallest first.
    def items(self) -> list[T]:
        return self._items.keys()

    def iter(self) -> Iterator[T]:
        for item in self._items:
            yield item

    def clear(ref self):
        self._items.clear()

    ## The items in either set.
    def union(self, other: SortedSet[T]) -> SortedSet[T]:
        mut found = self
        for item in other.items():
            found.add(item)
        return found

    ## The items in both sets.
    def intersection(self, other: SortedSet[T]) -> SortedSet[T]:
        return SortedSet.of([item for item in self.items() if item in other])

    ## The items of this set that aren't in `other`.
    def difference(self, other: SortedSet[T]) -> SortedSet[T]:
        return SortedSet.of([item for item in self.items() if item not in other])

    ## Whether every item is in `other`.
    def is_subset(self, other: SortedSet[T]) -> bool:
        return all(item in other for item in self.items())

## A fixed-size table of cells, `width` across and `height` down, for boards, tile maps and
## images. A cell is reached by its column and row, `grid[(x, y)]`, from `(0, 0)` at the top
## left. A position outside the grid stops the program, like an index out of range; `get`
## gives None for one instead. The cells are stored row by row in one list.
export struct Grid[T]:
    width: int
    height: int
    _cells: list[T] = []

    ## A grid with every cell set to `value`.
    def filled(width: int, height: int, value: T) -> Grid[T]:
        assert width >= 0 and height >= 0
        return Grid(width=width, height=height, _cells=[value for _ in range(width * height)])

    ## A grid of `rows`, which all have to be the same length.
    def of(rows: list[list[T]]) -> Grid[T]:
        width = len(rows[0]) if len(rows) > 0 else 0
        mut cells = []
        for row in rows:
            assert len(row) == width
            cells.extend(row)
        return Grid(width=width, height=len(rows), _cells=cells)

    ## How many cells it has.
    def len(self) -> int:
        return self.width * self.height

    ## The cell at a position, row by row, which `for ref` changes where it is.
    def [](ref self, at: int) -> T:
        return self._cells[at]

    ## Prints its items: `Grid([[1, 2], [3, 4]])`.
    def str(self, ref out: StrWriter):
        out.write("Grid(")
        out.value(self.rows())
        out.write(")")

    ## Whether `(x, y)` is a cell of the grid.
    def contains(self, at: (int, int)) -> bool:
        x, y = at
        return 0 <= x and x < self.width and 0 <= y and y < self.height

    def [](self, at: (int, int)) -> T:
        return self._cells[self._spot(at)]

    def []=(ref self, at: (int, int), value: T):
        spot = self._spot(at)
        self._cells[spot] = value

    ## The cell at `(x, y)`, or None when that's outside the grid.
    def get(self, at: (int, int)) -> T?:
        if not self.contains(at): return None
        return self[at]

    ## Sets every cell to `value`.
    def fill(ref self, value: T):
        self._cells = [value for _ in range(len(self))]

    ## The cells that share an edge with `(x, y)`, up, right, down and left, leaving out
    ## any outside the grid.
    def neighbors(self, at: (int, int)) -> list[(int, int)]:
        x, y = at
        return [
            near for near in [(x, y - 1), (x + 1, y), (x, y + 1), (x - 1, y)] if self.contains(near)
        ]

    ## The cells that share an edge or a corner with `(x, y)`, clockwise from the top left,
    ## leaving out any outside the grid.
    def neighbors8(self, at: (int, int)) -> list[(int, int)]:
        x, y = at
        around = [
            (x - 1, y - 1),
            (x, y - 1),
            (x + 1, y - 1),
            (x + 1, y),
            (x + 1, y + 1),
            (x, y + 1),
            (x - 1, y + 1),
            (x - 1, y),
        ]
        return [near for near in around if self.contains(near)]

    ## Every position, row by row from the top left.
    def positions(self) -> list[(int, int)]:
        return [(at % self.width, at // self.width) for at in range(len(self))]

    ## The cells of row `y`, from the left.
    def row(self, y: int) -> list[T]:
        assert 0 <= y and y < self.height
        return self._cells[y * self.width:(y + 1) * self.width]

    ## The cells of column `x`, from the top.
    def column(self, x: int) -> list[T]:
        assert 0 <= x and x < self.width
        return [self._cells[y * self.width + x] for y in range(self.height)]

    ## The rows, from the top.
    def rows(self) -> list[list[T]]:
        return [self.row(y) for y in range(self.height)]

    ## Every cell, row by row from the top left.
    def iter(self) -> Iterator[T]:
        for cell in self._cells:
            yield cell

    def _spot(self, at: (int, int)) -> int:
        assert self.contains(at)
        x, y = at
        return y * self.width + x

## The collections save in their natural shape, so what's written doesn't change when how they're
## stored does: a `SortedMap` as an object, or as `[key, value]` pairs when its keys aren't text
## or ints, a `SortedSet` or a `Deque` as an array, and a `Grid` as an array of rows.
## A node `shortest_path` has reached, and what it cost to: the cheapest comes out of its heap
## first.
struct Reached:
    cost: float
    place: int

    def <(self, other: Reached) -> bool:
        return self.cost < other.cost

## An edge of a `Graph`: the node it starts at, the node it ends at, and its value.
export struct Edge[N, E]:
    ## The node it starts at.
    from_id: Id[N]
    ## The node it ends at.
    to_id: Id[N]
    ## What the edge holds: a weight, a label or anything else.
    value: E

## Nodes and the directed edges between them, reached by the IDs `add_node` gives back, as a
## `Table`'s are: a graph holds no references, and copying one gives an independent graph. A
## node's edges out and in are linked through flat lists by its place, so adding one never
## searches and walking them never allocates. An ID from another graph stops the program, like
## an index out of range.
export struct Graph[N, E]:
    _nodes: Table[N] = Table[N]()
    _ids: list[Id[N]] = []
    ## For each edge: where it starts and ends, its value, and the next edge out of and into the
    ## same nodes, or -1.
    _starts: list[int] = []
    _ends: list[int] = []
    _values: list[E] = []
    _next_out: list[int] = []
    _next_in: list[int] = []
    ## For each node: its first and last edges out and in, or -1.
    _first_out: list[int] = []
    _last_out: list[int] = []
    _first_in: list[int] = []
    _last_in: list[int] = []

    ## How many nodes it has.
    def len(self) -> int:
        return len(self._ids)

    ## How many edges it has.
    def edge_count(self) -> int:
        return len(self._starts)

    ## Adds a node with no edges, giving back its ID.
    def add_node(ref self, node: N) -> Id[N]:
        id = self._nodes.add(node)
        self._ids.append(id)
        self._first_out.append(-1)
        self._last_out.append(-1)
        self._first_in.append(-1)
        self._last_in.append(-1)
        return id

    def [](self, id: Id[N]) -> N:
        return self._nodes[id]

    def []=(ref self, id: Id[N], node: N):
        self._nodes[id] = node

    ## Every node's ID, in the order they were added.
    def nodes(self) -> list[Id[N]]:
        return self._ids

    ## Adds an edge from one node to another, holding `edge`. Two nodes can have several edges
    ## between them, and a node can have one to itself.
    def add_edge(ref self, from_id: Id[N], to_id: Id[N], edge: E):
        start = self._place(from_id)
        end = self._place(to_id)
        at = len(self._starts)
        self._starts.append(start)
        self._ends.append(end)
        self._values.append(edge)
        self._next_out.append(-1)
        self._next_in.append(-1)
        if self._last_out[start] < 0:
            self._first_out[start] = at
        else:
            self._next_out[self._last_out[start]] = at
        self._last_out[start] = at
        if self._last_in[end] < 0:
            self._first_in[end] = at
        else:
            self._next_in[self._last_in[end]] = at
        self._last_in[end] = at

    ## The edges starting at a node, in the order they were added.
    def edges_from(self, id: Id[N]) -> list[Edge[N, E]]:
        mut found = list[Edge[N, E]]()
        mut at = self._first_out[self._place(id)]
        while at >= 0:
            found.append(self._edge(at))
            at = self._next_out[at]
        return found

    ## The edges ending at a node, in the order they were added.
    def edges_to(self, id: Id[N]) -> list[Edge[N, E]]:
        mut found = list[Edge[N, E]]()
        mut at = self._first_in[self._place(id)]
        while at >= 0:
            found.append(self._edge(at))
            at = self._next_in[at]
        return found

    ## Every node, each before every node its edges lead to, or None when edges go round in a
    ## cycle and there's no such order. Nodes with no edges in come first, in the order they were
    ## added, then each node as soon as everything before it is in.
    def topological_order(self) -> list[Id[N]]?:
        count = len(self._ids)
        mut waiting = [0 for _ in range(count)]
        for end in self._ends:
            waiting[end] += 1
        mut ready = list[int]()
        for place in range(count):
            if waiting[place] == 0:
                ready.append(place)
        mut next = 0
        while next < len(ready):
            place = ready[next]
            next += 1
            mut at = self._first_out[place]
            while at >= 0:
                end = self._ends[at]
                waiting[end] -= 1
                if waiting[end] == 0:
                    ready.append(end)
                at = self._next_out[at]
        if len(ready) < count: return None
        return [self._ids[place] for place in ready]

    ## The cheapest way from one node to another, by `cost` of each edge, as the nodes along it,
    ## both ends included, or None when no edges lead there. Costs can't be below zero: a
    ## negative one stops the program.
    def shortest_path(self, from_id: Id[N], to_id: Id[N], cost: (E) -> float) -> list[Id[N]]?:
        start = self._place(from_id)
        end = self._place(to_id)
        count = len(self._ids)
        mut best = [-1.0 for _ in range(count)]
        mut came_from = [-1 for _ in range(count)]
        mut done = [False for _ in range(count)]
        mut waiting = Heap[Reached]()
        best[start] = 0.0
        waiting.push(Reached(cost=0.0, place=start))
        while True:
            reached = waiting.pop() else break
            place = reached.place
            if done[place]: continue
            done[place] = True
            if place == end: break
            mut at = self._first_out[place]
            while at >= 0:
                step = cost(self._values[at])
                # A cost below zero would make a path found already cheaper later.
                assert step >= 0.0 and not step.is_nan()
                next = self._ends[at]
                total = reached.cost + step
                if not done[next] and (best[next] < 0.0 or total < best[next]):
                    best[next] = total
                    came_from[next] = place
                    waiting.push(Reached(cost=total, place=next))
                at = self._next_out[at]
        if not done[end]: return None
        mut path = [self._ids[end]]
        mut at = end
        while at != start:
            at = came_from[at]
            path.append(self._ids[at])
        return reversed(path)

    def _edge(self, at: int) -> Edge[N, E]:
        return Edge(
            from_id=self._ids[self._starts[at]],
            to_id=self._ids[self._ends[at]],
            value=self._values[at],
        )

    ## Where a node is in the graph's own lists: its slot in the `Table`, since nothing's ever
    ## taken out of it. An ID from another graph stops the program.
    def _place(self, id: Id[N]) -> int:
        assert id_tag(id) == table_tag(self._nodes)
        return id_key(id) >> 32

extend SortedMap[K: Ordered & Serializable, V: Serializable]:
    def serialize(self, ref out: Serializer):
        out.map(self.items())

extend SortedMap[K: Ordered & Deserializable, V: Deserializable]:
    def deserialize(ref src: Deserializer) -> SortedMap[K, V] fails ParseError:
        return SortedMap.of(src.map[K, V]()?)

extend SortedSet[T: Ordered & Serializable]:
    def serialize(self, ref out: Serializer):
        out.sequence(self.items())

extend SortedSet[T: Ordered & Deserializable]:
    def deserialize(ref src: Deserializer) -> SortedSet[T] fails ParseError:
        return SortedSet.of(src.sequence[T]()?)

extend Deque[T: Serializable]:
    def serialize(self, ref out: Serializer):
        out.sequence(self.items())

extend Deque[T: Deserializable]:
    def deserialize(ref src: Deserializer) -> Deque[T] fails ParseError:
        return Deque.of(src.sequence[T]()?)

## A `Packed` saves as its lists, one list of items each.
extend Packed[T: Serializable]:
    def serialize(self, ref out: Serializer):
        out.sequence(self.lists())

extend Packed[T: Deserializable]:
    def deserialize(ref src: Deserializer) -> Packed[T] fails ParseError:
        return Packed.of(src.sequence[list[T]]()?)

extend Grid[T: Serializable]:
    def serialize(self, ref out: Serializer):
        out.sequence(self.rows())

extend Grid[T: Deserializable]:
    ## Rows that aren't all as long as the first fail, saying which.
    def deserialize(ref src: Deserializer) -> Grid[T] fails ParseError:
        rows = src.sequence[list[T]]()?
        if len(rows) > 0:
            width = len(rows[0])
            mut at = 0
            for row in rows:
                if len(row) != width:
                    cells = "cell" if len(row) == 1 else "cells"
                    fail src.at_item(at, f"has {len(row)} {cells}, but the first row has {width}")
                at += 1
        return Grid.of(rows)

## A `Table` saves as a list of its items, in order, and an `Id` as where its item is in that
## list. Loading makes a new `Table`, so every `Id` loaded with it finds its item there. One that
## finds nothing can't be saved, unless it's optional, and then it's saved as missing.
extend Id[T]:
    def serialize(self, ref out: Serializer):
        out.id(type_name[T](), id_key(self), id_tag(self))

    def deserialize(ref src: Deserializer) -> Id[T] fails ParseError:
        kind = type_name[T]()
        if src.exact():
            # Its slot and its generation.
            slot = src.value[int]()?
            generation = src.value[int]()?
            if slot < 0 or generation < 0 or generation > 4294967295:
                fail src.here("is out of range")
            src.saw_id(kind, slot)
            return id_of_key[T]((slot << 32) | generation, src.tag(kind))
        position = src.value[int]()?
        if position < 0: fail src.here("is out of range")
        src.saw_id(kind, position)
        return id_at[T](position, src.tag(kind))

extend Table[T]:
    ## Puts `value` at `id` and gives `True` when `id` is live, or gives `False` and changes
    ## nothing when it's gone: for an `Id` that may be stale, where `table[id] = value` would stop
    ## the program.
    def update(ref self, id: Id[T], value: T) -> bool:
        if self.get(id) is None: return False
        self[id] = value
        return True

extend Table[T: Serializable]:
    def serialize(self, ref out: Serializer):
        if out.exact():
            out.slots(type_name[T](), table_tag(self), table_slots(self), self.values())
            return
        mut ids = list[Id[T]]()
        mut items = list[T]()
        for id, item in self.items():
            ids.append(id)
            items.append(item)
        out.table(type_name[T](), table_tag(self), ids, items)

extend Table[T: Deserializable]:
    def deserialize(ref src: Deserializer) -> Table[T] fails ParseError:
        kind = type_name[T]()
        if src.exact():
            slots = src.value[list[int]]()?
            items = src.value[list[T]]()?
            mut live = 0
            for word in slots:
                # A generation fits in 32 bits, and one taken out is stored as -1 less it.
                if word > 4294967295 or word < -4294967296:
                    fail src.here("has a slot past the last generation")
                if word >= 0:
                    live += 1
            if live != len(items):
                used = "1 slot" if live == 1 else f"{live} slots"
                fail src.here(f"has {used} in use but {len(items)} items")
            src.saw_table(kind, len(slots))
            return table_of_slots[T](src.tag(kind), slots, items)
        items = src.value[list[T]]()?
        mut table = table_tagged[T](src.tag(kind))
        for item in items:
            _ = table.add(item)
        src.saw_table(kind, len(items))
        return table
