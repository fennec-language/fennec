# A task stopped while the pieces of its comprehension wait in calls to the runtime: each piece
# lets go of what its call was given. The call is a read with `timeout=`, whose `Duration` is a
# block made for the call, as in `stopped_in_a_wait.fen`, but here the read is a piece's, on
# another thread than its task's, and the task's stop is passed on to it.
from std.concurrent import Channel, Closed, Crashed, channel
from std.net import NetError

error Refused:
    why: str

# Waits for bytes that never come, on a connection to itself, saying first that it's about to.
def waits(number: int, net: Net, ready: Channel[int]) -> int fails NetError | Closed:
    with net.listen(0)? as server:
        with net.connect("127.0.0.1", server.port)? as client:
            ready.send(number)?
            data = client.read(65536, timeout=5000ms)?
            return len(data)

def waiting(number: int, net: Net, ready: Channel[int]) -> int:
    heard = waits(number, net=net, ready=ready) except why:
        return len(f"{why}")
    return heard

def all_waiting(net: Net, ready: Channel[int]) -> int:
    heard = [waiting(number, net=net, ready=ready) for number in parallel(range(4))]
    return len(heard)

# Launches the task, and once every piece has said it's about to wait, leaves the block by a
# failure, which stops the task and its pieces.
def stopped(net: Net) fails Refused | Crashed | Closed:
    with channel[int](size=4) as ready:
        with launch(() => all_waiting(net, ready=ready))?:
            for _ in range(4):
                _ = ready.receive() else 0
            fail Refused(why="leaving this way stops the task")

def once(net: Net) -> str:
    stopped(net) except why:
        return f"{why}"
    return "it wasn't stopped"

def inside(net: Net, out: Channel[str]):
    out.send(once(net)) except Closed():
        return
    return

def main(stdout: Stdout, net: Net) fails Closed | Crashed:
    stdout.print(once(net))
    with channel[str](size=1) as out:
        with launch(() => inside(net, out=out))?:
            stdout.print(out.receive() else "nothing")
    return
