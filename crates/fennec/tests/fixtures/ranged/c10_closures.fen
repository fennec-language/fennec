# Arrow functions made and called inside the loop written twice.
def applied(run: (int) -> int, value: int) -> int:
    return run(value)

def scan(starts: list[int], order: list[int]) -> int:
    mut total = 0
    for at in range(starts[0], starts[1]):
        value = order[at]
        total += applied(more => value + more + at, value=1)
        double = () => value * 2
        ranked = sorted(order, key=item => abs(item - value))
        total += ranked[0] + ranked[1] + double()
    return total

def main(stdout: Stdout):
    stdout.print(scan([0, 4], order=[5, 6, 7, 8]))
