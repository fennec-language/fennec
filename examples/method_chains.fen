## Methods called on what other calls give back, with the type known from the checker.

struct Vector:
    x: int

    def add(self, other: Vector) -> Vector:
        return Vector(x=self.x + other.x)

    def bump(ref self) -> int:
        self.x += 1
        return self.x

enum Kind:
    Count(n: int)
    Empty

    def n(self) -> int:
        match self:
            case .Count(n):
                return n
            case .Empty:
                return 0

struct Tree:
    left: Tree?
    value: int

    def itself(self) -> Tree:
        return self

    def val(self) -> int:
        return self.value

def make() -> Vector:
    return Vector(x=1)

def tree() -> Tree:
    return Tree(left=None, value=7)

def main(stdout: Stdout):
    stdout.print(
        make().add(make()).add(Vector(x=5)).x,
        make().x,
        Kind.Count(n=3).n(),
        Kind.Empty.n(),
    )
    stdout.print(tree().itself().val(), tree().itself().itself().value)
    mut value = make()
    stdout.print(value.bump(), value.add(value).x, value.x, ({1: 2}.get(1) else 5), len({"a": 1}))
