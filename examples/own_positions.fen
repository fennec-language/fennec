# A type gets `for ref` by defining `def len` and the `ref` form of `def []`, which returns
# the item as a place. Positions that can be empty are skipped by `def is_live`, and a form
# that touches only its own item can run in parallel. The loop changes each item where it is.
from std.collections import Deque, Grid

struct Unit:
    health = 10
    tags = list[str]()

struct Units:
    _items = list[Unit]()
    _live = list[bool]()

    def add(ref self, unit: Unit):
        self._items.append(unit)
        self._live.append(True)

    def remove(ref self, i: int):
        self._live[i] = False

    def len(self) -> int:
        return len(self._items)

    def is_live(self, i: int) -> bool:
        return self._live[i]

    def [](ref self, i: int) -> Unit:
        return self._items[i]

struct Squad:
    units = Units()

## Heals units until one reaches `full`, and says how many it healed.
def heal_until(ref units: Units, full: int) -> int:
    mut healed = 0
    for ref unit in units:
        unit.health += 5
        healed += 1
        if unit.health >= full: return healed
    return healed

def main(stdout: Stdout):
    mut units = Units()
    for health in [1, 2, 3, 4]:
        units.add(Unit(health=health))
    units.remove(1)

    # The removed unit is skipped, and the others change where they are.
    for ref unit in units:
        unit.health += 100
        unit.tags.append("hit")
    stdout.print(units[0].health, units[1].health, units[2].tags)

    # A `mut` name's item is a place too.
    units[1].health = 7
    units[0].health = 50
    stdout.print(units[0].health, units[1].health)

    # `continue` and `break` both keep what the item has so far.
    for ref unit in units:
        unit.health += 1
        if unit.health == 51: continue
        unit.health = 0
        break
    stdout.print(units[0].health, units[1].health, units[2].health, units[3].health)

    # So does `return`.
    stdout.print(heal_until(ref units, 5), units[0].health, units[2].health)

    # Each item is its own, so the iterations can run at once.
    for ref unit in parallel(units):
        unit.health *= 2
    stdout.print(units[0].health, units[1].health, units[2].health, units[3].health)

    # Through a field of something else.
    mut squad = Squad(units=units)
    for ref unit in squad.units:
        unit.health = 1
    stdout.print(squad.units[0].health, squad.units[1].health)

    # The standard library's ring and grid have positions too.
    mut queue = Deque[int]()
    for i in range(5):
        queue.append(i)
    _ = queue.popleft()
    queue.append(9)
    for ref item in queue:
        item *= 2
    stdout.print(queue[0], queue[4], len(queue))
    queue[1] = 77
    stdout.print(queue[1], queue.popleft())

    mut grid = Grid.filled(width=2, height=2, value=1)
    for ref cell in grid:
        cell += 4
    grid[(1, 1)] = 8
    stdout.print(grid[(0, 1)], grid[(1, 1)])
