# An echo server run from `main`, asked five lines and a stop by a launched task: six rounds.
# For the test that what a round leaves is found wherever the server runs.
from std.concurrent import Crashed
from std.net import NetError

def asked(net: Net, port: int, line: str) -> str fails NetError:
    with net.connect("127.0.0.1", port)? as conn:
        conn.write(f"{line}\n")?
        return conn.read_line()? else ""

def clients(net: Net, port: int, stdout: Stdout) fails NetError:
    for line in ["a", "b", "c", "d", "e", "stop"]:
        stdout.print(asked(net, port=port, line=line)?)

# The server in `main`, with its clients in a task of their own.
def main(net: Net, stdout: Stdout) fails NetError | Crashed:
    with net.listen(0)? as server:
        port = server.port
        with launch(() => clients(net, port=port, stdout=stdout)?)?:
            for conn in parallel(server):
                line = conn.read_line()? else ""
                if line == "stop": break
                conn.write(f"{line}, as a text long enough for a block of its own\n")?
