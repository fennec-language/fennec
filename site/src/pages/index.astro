---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import fennec from '../fennec.tmLanguage.json';
import score from '../data/scoreboard.json';

const base = import.meta.env.BASE_URL;
const themes = { light: 'vitesse-light', dark: 'vitesse-dark' } as const;
const scout = (name: string) => `${base}brand/scout/scout-${name}.webp`;

// Every sample and every line of output below was run with fennec on main; see the PR that added
// this page for the run. A change here needs the same check.
const samples = {
  hero: `struct Player:
    name: str
    health = 100 where health >= 0

def main(stdout: Stdout):
    mut players = [Player(name="Ana"), Player(name="Bo", health=40)]
    for ref player in players:
        player.health -= 25
    alive = [player.name for player in players if player.health > 50]
    stdout.print(alive)`,
  fix: `def port_of(text: str) -> int fails InvalidValue:
    return int.parse(text)`,
  caps: `from metrics import average, report

def main(stdout: Stdout, net: Net):
    times = [16.0, 17.0, 15.0]
    stdout.print(average(times))
    report(net, times)?`,
  dice: `from std.random import Random

def main(stdout: Stdout, entropy: Entropy):
    mut dice = Random(seed=entropy.seed())
    rolls = [dice.randint(1, high=6) for _ in range(5)]
    stdout.print(rolls)`,
  values: `def step(ref particles: list[Particle], dt: float):
    for ref particle in particles:
        particle.position += particle.velocity * dt

def main(stdout: Stdout):
    mut particles = [Particle(position=0.0, velocity=2.0), Particle(position=1.0, velocity=-1.0)]
    before = particles
    step(ref particles, dt=0.5)
    stdout.print(before[0].position, particles[0].position)`,
  fails: `error ConfigError:
    Missing(key: str)

def port_of(settings: dict[str, str]) -> int fails ConfigError | InvalidValue:
    text = settings.get("port") else fail ConfigError.Missing(key="port")
    return int.parse(text)?

def main(stdout: Stdout):
    port = port_of({"port": "eighty"}) except InvalidValue() | ConfigError.Missing(): 8080
    stdout.print(port)`,
};

const programs = [...score.programs].sort((a, b) => b.instructions - a.instructions);
const low = Math.min(...programs.map((p) => p.instructions));
const high = Math.max(...programs.map((p) => p.instructions));
// The same programs by clock in CI on Linux, both machines: the range a careful reader would check.
const clocks = programs.flatMap((p) => [p.ci_clock.linux_arm, p.ci_clock.linux_x86]);
const clockLow = Math.min(...clocks);
const clockHigh = Math.max(...clocks);
// Bars run from 0 to 150%, with Rust at 100%.
const scale = 150;
const at = (v: number) => `${(Math.min(v, scale) / scale) * 100}%`;

const wardrobe = [
  { art: 'explorer', name: 'Explorer', job: 'The tour and the docs', href: 'tour/' },
  { art: 'director', name: 'Director', job: 'Record and replay any run' },
  { art: 'inspector', name: 'Inspector', job: 'Checks that stay on' },
  { art: 'detective', name: 'Detective', job: 'Errors that come with their fix', href: 'reference/' },
  { art: 'racer', name: 'Racer', job: 'Native speed, measured', href: 'benchmarks/' },
  { art: 'courier', name: 'Courier', job: 'Kits and kit.lock', href: 'den/' },
  { art: 'conductor', name: 'Conductor', job: 'Tasks, channels and locks' },
];
---

<Base title="Fennec" description="Fennec reads like Python and compiles to native code through LLVM, with no garbage collector and every safety check left on. Its compiler tells people and coding agents what's wrong and how to fix it.">
  <section class="hero">
    <picture class="hero-art">
      <img src={scout('hero-night')} alt="Scout, Fennec's fennec fox, on a dune at night with a laptop" width="1792" height="768" fetchpriority="high" />
    </picture>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">A compiled language, built in the open</span>
        <h1>Fast enough for games. <em>Strict enough for agents.</em></h1>
        <p class="lede">
          Fennec reads like Python and compiles to native code through LLVM, with <b>no garbage collector</b> and <b>every safety check left on</b>. Its compiler tells people and coding agents exactly what's wrong and how to fix it, every dependency reaches only what it was handed, and a run can be recorded and replayed exactly.
        </p>
        <div class="actions">
          <a class="button primary" href="#install">Install</a>
          <a class="button" href={`${base}tour/`}>Take the tour</a>
          <a class="button" href={`${base}benchmarks/`}>Benchmarks</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap console-band" aria-label="Fennec, running">
    <div class="console">
      <div class="console-tabs" role="tablist">
        <button role="tab" aria-selected="true" aria-controls="p-run" id="t-run">run</button>
        <button role="tab" aria-selected="false" aria-controls="p-check" id="t-check" tabindex="-1">check --json</button>
        <button role="tab" aria-selected="false" aria-controls="p-lock" id="t-lock" tabindex="-1">kit.lock</button>
        <button role="tab" aria-selected="false" aria-controls="p-replay" id="t-replay" tabindex="-1">replay</button>
      </div>
      <div class="pane" id="p-run" role="tabpanel" aria-labelledby="t-run">
        <div class="file">hero.fen</div>
        <Code code={samples.hero} lang={fennec} themes={themes} defaultColor={false} />
        <pre class="term"><span class="p">$</span> <span class="c">fennec run hero.fen</span>
["Ana"]</pre>
      </div>
      <div class="pane" id="p-check" role="tabpanel" aria-labelledby="t-check" hidden>
        <div class="file">fix.fen</div>
        <Code code={samples.fix} lang={fennec} themes={themes} defaultColor={false} />
        <pre class="term"><span class="p">$</span> <span class="c">fennec check fix.fen</span>
<span class="err">error: this can fail, and a failure passes up only with `?`</span>
 --&gt; fix.fen:2:12
  |
2 |     return int.parse(text)
  |            ^^^^^^^^^^^^^^^
  |
  = <span class="help">help: write `?` after it: `fennec fix` makes this change</span>

<span class="p">$</span> <span class="c">fennec check --json fix.fen</span>
{`{"diagnostics":[{"rule":"check","severity":"error","file":"fix.fen",
 "line":2,"column":12,"end_line":2,"end_column":27,
 "message":"this can fail, and a failure passes up only with \`?\`",
 "help":"write \`?\` after it: \`fennec fix\` makes this change",`}
 <span class="hl">{`"fixes":[{"file":"fix.fen","line":2,"column":27,
   "end_line":2,"end_column":27,"text":"?"}]`}</span>{`, ...}],
 "errors":1,"hints":0,"fixable":1}`}</pre>
      </div>
      <div class="pane" id="p-lock" role="tabpanel" aria-labelledby="t-lock" hidden>
        <div class="file">game/src/main.fen</div>
        <Code code={samples.caps} lang={fennec} themes={themes} defaultColor={false} />
        <pre class="term"><span class="p">$</span> <span class="c">fennec check</span>
<span class="err">error: `metrics` would now receive a `Net` here, which kit.lock doesn't list for it</span>
 --&gt; src/main.fen:6:12
  |
6 |     report(net, times)?
  |            ^^^

<span class="p">$</span> <span class="c">fennec update --accept</span>
kit.lock: `metrics` now holds `Net`, first handed over at src/main.fen:6:12

<span class="p">$</span> <span class="c">cat kit.lock</span>
<span class="hl">holds metrics path:../metrics Net</span></pre>
      </div>
      <div class="pane" id="p-replay" role="tabpanel" aria-labelledby="t-replay" hidden>
        <div class="file">dice.fen</div>
        <Code code={samples.dice} lang={fennec} themes={themes} defaultColor={false} />
        <pre class="term"><span class="p">$</span> <span class="c">fennec run --record run.log dice.fen</span>
<span class="hl">[2, 2, 3, 4, 3]</span>
<span class="p">$</span> <span class="c">fennec replay run.log</span>
<span class="hl">[2, 2, 3, 4, 3]</span></pre>
      </div>
    </div>
  </section>

  <section class="proof">
    <div class="wrap proof-grid">
      <div class="cell">
        <div class="big">{Math.round(low)}–{Math.round(high)}<small>%</small></div>
        <p>of Rust's speed by instructions on an Apple M5, across eight real programs. By clock on Linux in CI, {Math.round(clockLow)}–{Math.round(clockHigh)}%.</p>
        <span class="src">Scoreboard and CI · {score.date}</span>
      </div>
      <div class="cell">
        <div class="big">0</div>
        <p>safety checks turned off in release builds. There's no switch to turn them off.</p>
        <span class="src">The language · Checks</span>
      </div>
      <div class="cell">
        <div class="big">No GC</div>
        <p>A name holds its own value, freed when it's done, so memory stays flat and timing predictable.</p>
        <span class="src">The language · Four rules</span>
      </div>
      <div class="cell">
        <div class="big">1.1<small> MB</small></div>
        <p>for a native hello-world, with one runtime linked in.</p>
        <span class="src">The language · Building</span>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Part of the harness</span>
        <h2>The language is the one check that runs on every line.</h2>
        <p>More code is written by agents every month, and reviewed by people with less time. Fennec builds the checks into the language, so they hold whoever wrote the code.</p>
      </div>
      <div class="rows">
        <div class="row">
          <div class="row-copy">
            <h3>Errors an agent can act on</h3>
            <p>Every error says what's wrong and what to write instead. <code>--json</code> gives the same, with the edit as data, and <code>fennec fix</code> applies it.</p>
            <ul>
              <li>A call that can fail says so with <code>?</code> or <code>except</code>.</li>
              <li>Arguments that could be swapped and still compile must be named.</li>
              <li>A copy changed and never read is an error.</li>
            </ul>
          </div>
          <div class="readouts">
            <div class="readout">
              <div class="cap"><span>fennec check notmut.fen</span><span>text</span></div>
              <pre class="term"><span class="err">error: `target` isn't mut</span>
 --&gt; notmut.fen:7:5
  |
7 |     target.health -= 10
  |     ^^^^^^^^^^^^^
  |
  = <span class="help">help: to change `units`: write to `units[0].health`, or name the place with `ref target = units[0]`</span></pre>
            </div>
            <div class="readout">
              <div class="cap"><span>fennec check --json fix.fen</span><span>json</span></div>
              <pre class="term wrapjson">{`{"diagnostics":[{"rule":"check","severity":"error","file":"fix.fen","line":2,"column":12,"end_line":2,"end_column":27,"message":"this can fail, and a failure passes up only with \`?\`","help":"write \`?\` after it: \`fennec fix\` makes this change","also":null,"also_is":null,`}<span class="hl">{`"fixes":[{"file":"fix.fen","line":2,"column":27,"end_line":2,"end_column":27,"text":"?"}]`}</span>{`,"hint":null}],"errors":1,"hints":0,"fixable":1}`}</pre>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="row-copy">
            <h3>Dependencies hold only what you hand them</h3>
            <p>The compiler works out which capabilities each dependency can reach: the network, files, processes. <code>kit.lock</code> records it, and when a change would hand a kit more, the build stops until a person accepts it.</p>
            <ul>
              <li>Nothing to declare: holds are worked out, never written.</li>
              <li>Only <code>fennec update --accept</code> widens them. No tool or fix does it for you.</li>
              <li>A kit pointed at another source holds nothing until it's accepted again.</li>
            </ul>
          </div>
          <div class="readouts">
            <div class="readout">
              <div class="cap"><span>fennec check</span><span>the build stops</span></div>
              <pre class="term"><span class="err">error: `metrics` would now receive a `Net` here, which kit.lock doesn't list for it</span>
 --&gt; src/main.fen:6:12
  |
6 |     report(net, times)?
  |            ^^^
  |
  = <span class="help">help: a dependency receiving a capability is a change a person accepts: `fennec update --accept` shows what each kit would now hold and records it in kit.lock, to be reviewed with this change. Nothing here is fixed for you</span></pre>
            </div>
            <div class="readout">
              <div class="cap"><span>kit.lock</span><span>reviewed with the change</span></div>
              <pre class="term"># What this kit builds with, by hash, and what each kit it depends on holds. Only `fennec update` changes it.
<span class="hl">holds metrics path:../metrics Net</span></pre>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="row-copy">
            <h3>A run, replayed exactly</h3>
            <p>Time, randomness, files and the network all come in through capabilities, so <code>fennec run --record</code> can keep what came in and <code>fennec replay</code> plays it back. Floats give the same bits on every machine.</p>
            <ul>
              <li>A parallel float sum gives the same bits on every run, at any thread count.</li>
              <li>Tasks waiting only on each other stop the program with a report of who waits for what, and a recorded run replays to the same report.</li>
            </ul>
          </div>
          <div class="readout">
            <div class="cap"><span>dice.fen</span><span>record · replay</span></div>
            <pre class="term"><span class="p">$</span> <span class="c">fennec run --record run.log dice.fen</span>
<span class="hl">[2, 2, 3, 4, 3]</span>
<span class="p">$</span> <span class="c">fennec replay run.log</span>
<span class="hl">[2, 2, 3, 4, 3]</span></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">The language</span>
        <h2>Small rules, held everywhere.</h2>
        <p>A name holds its own value. <code>mut</code> lets a name change, and <code>ref</code> lets a loop, a function or a local name change yours. A failure is passed up with <code>?</code> or handled with <code>except</code>, and <code>else</code> is only for a value that may be missing.</p>
      </div>
      <div class="lang">
        <div class="card">
          <div class="card-head">
            <h3>Values, not references</h3>
            <p><code>before</code> is its own value, so changing <code>particles</code> never changes it. Nothing is shared by accident, and there's no garbage collector.</p>
          </div>
          <Code code={samples.values} lang={fennec} themes={themes} defaultColor={false} />
          <pre class="term"><span class="p">$</span> <span class="c">fennec run values.fen</span>
0.0 1.0</pre>
        </div>
        <div class="card">
          <div class="card-head">
            <h3>Failures you can see</h3>
            <p>A signature says how a function fails. <code>?</code> marks every line it can leave from, and <code>except</code> has to cover every case.</p>
          </div>
          <Code code={samples.fails} lang={fennec} themes={themes} defaultColor={false} />
          <pre class="term"><span class="p">$</span> <span class="c">fennec run fails.fen</span>
8080</pre>
        </div>
      </div>
      <p class="more"><a href={`${base}tour/`}>The whole language, in the tour →</a></p>
    </div>
  </section>

  <section class="band">
    <div class="wrap speed">
      <div>
        <div class="head">
          <span class="eyebrow">Speed, measured</span>
          <h2>Close to Rust on real programs, and where it isn't.</h2>
          <p>{score.note}</p>
        </div>
        <span class="label">Apple M5 · by instructions</span>
        <div class="bars">
          {
            programs.map((p) => (
              <div class="bar-row">
                <span class="name">
                  {p.name}
                  {p.detail && <small> · {p.detail}</small>}
                </span>
                <span class="track">
                  <span class={`fill${p.instructions < 100 ? ' under' : ''}`} style={`width: ${at(p.instructions)}`} />
                  <span class="ref" style={`left: ${at(100)}`} />
                </span>
                <span class="val">{p.instructions.toFixed(1)}%</span>
              </div>
            ))
          }
          <div class="axis">
            <span />
            <span class="ticks">
              {[0, 50, 100, 150].map((t) => (
                <span style={`left: ${at(t)}`}>{t}%</span>
              ))}
            </span>
            <span />
          </div>
        </div>
        <div class="legend">
          <span><i class="k" />Level with Rust or faster</span>
          <span><i class="k under" />Behind Rust</span>
          <span><i class="k ref" />Rust = 100%</span>
          <span class="src">Scoreboard · Apple M5 · {score.date}</span>
        </div>
      </div>
      <aside class="aside">
        <div><b>Physics: 82.6%</b><span>Its bounds and overflow checks stay on. Speed never comes from dropping a check.</span></div>
        <div><b>HTTP: about {score.ci.api_handler_linux}% of Rust per request</b><span>api_handler, by clock on Linux today. The runtime's allocation and copies are being worked on.</span></div>
        <div><b>On Linux in CI, by clock: {Math.round(clockLow)}–{Math.round(clockHigh)}%</b><span>The same eight programs on Linux Arm and x86-64. The x86-64 machine is slower than the Mac here: from {Math.round(Math.min(...programs.map((p) => p.ci_clock.linux_x86)))}% to {Math.round(Math.max(...programs.map((p) => p.ci_clock.linux_x86)))}%.</span></div>
        <a class="button" href={`${base}benchmarks/`}>Every benchmark →</a>
      </aside>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Trust</span>
        <h2>Safe by construction, and checkable by anyone.</h2>
      </div>
      <div class="trust">
        <div><span class="tag built">Built</span><h3>Checks stay on</h3><p>Overflow, bounds, missing keys and division by zero are checked unless the compiler proves they can't fail. There's no unchecked mode.</p></div>
        <div><span class="tag built">Built</span><h3>Nothing unsafe to reach for</h3><p>No <code>unsafe</code>, no garbage collector, no global state and no lifetimes to write. Every borrow lives in a block you can see.</p></div>
        <div><span class="tag built">Built</span><h3>Deadlocks can't compile</h3><p>Lock order is checked across the whole program, and a crash inside <code>lock … as ref</code> puts every change back.</p></div>
        <div><span class="tag built">Built</span><h3>Injection can't be written</h3><p>A <code>str</code> is never a <code>Template</code>, so SQL, HTML and shell commands can't be built by joining strings.</p></div>
        <div><span class="tag built">Built</span><h3>Reproducible releases</h3><p>A release's archives are the same bytes wherever they're built. CI builds each platform twice and compares them.</p></div>
        <div><span class="tag soon">At first release</span><h3>Signed toolchains</h3><p>The launcher checks each toolchain against its signed manifest, pinned by hash in <code>kit.lock</code>. The release keys come with the first release.</p></div>
      </div>
    </div>
  </section>

  <section class="band scout-band">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Meet Scout</span>
        <h2>One fennec fox, dressed for what Fennec does.</h2>
        <p>Scout is Fennec's mascot. You'll find him across the docs, in the outfit that fits the page.</p>
      </div>
      <div class="wardrobe">
        {
          wardrobe.map((w) => (
            <figure>
              <div class="art"><img src={scout(w.art)} alt={`Scout as the ${w.name}`} width="400" height="400" loading="lazy" /></div>
              <figcaption>
                <b>{w.href ? <a href={`${base}${w.href}`}>{w.name}</a> : w.name}</b>
                <span>{w.job}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band" id="install">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Install · at first release</span>
        <h2>One command on your PATH. Every project pinned.</h2>
        <p><code>fennec</code> is a small launcher. It runs the toolchain each project asks for, and fetches one only when it's missing.</p>
      </div>
      <div class="install">
        <div class="readouts">
          <div class="readout">
            <div class="cap"><span>terminal</span><span>macOS · Linux</span></div>
            <pre class="term"><span class="p">$</span> <span class="c">curl -fsSL https://fennec-lang.dev/install.sh | sh</span>
<span class="p">$</span> <span class="c">fennec new hello</span>
<span class="p">$</span> <span class="c">cd hello &amp;&amp; fennec run</span></pre>
          </div>
          <div class="readout">
            <div class="cap"><span>kit.toml</span><span>the pin</span></div>
            <pre class="term">name = "hello"
version = "0.1.0"
<span class="hl">fennec = "0.4.2"</span></pre>
          </div>
          <p class="note">There's no release yet. Until then, build it from source, with Rust installed: <code>git clone https://github.com/fennec-language/fennec &amp;&amp; cd fennec &amp;&amp; .github/scripts/install.sh</code></p>
        </div>
        <ul class="facts">
          <li><b>Pinned per project</b><span>The version in <code>kit.toml</code> is the one that runs, and only <code>fennec update</code> moves it.</span></li>
          <li><b>Fetched when missing, then checked</b><span>A missing toolchain is downloaded and checked against the signed manifest's hash in <code>kit.lock</code>. <code>--offline</code> never fetches.</span></li>
          <li><b>Nothing runs when a kit is fetched</b><span>Kits have no install or build scripts. Fetching takes only <code>kit.toml</code> and <code>src</code>.</span></li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.console-tabs [role="tab"]'));
  function select(tab: HTMLButtonElement) {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const pane = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (pane) pane.hidden = !on;
    }
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (event) => {
      const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      const next = tabs[(i + step + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });
</script>

<style>
