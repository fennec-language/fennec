## A program's declarations: its functions, methods, types and aliases, together with the
## standard library's. Function bodies are looked at later, one function at a time.
## Mirrors `crates/check/src/program.rs`.

from ast import Extension, FnDef, Generic, Import, Interface, Item, Module, TestDef, TypeDef, TypeExpr
from check.types import Type, optional_type
from span import Diagnostic, Span

enum TypeKind:
    StructKind
    EnumKind
    ErrorKind

struct TypeInfo:
    kind: TypeKind
    type_def: TypeDef
    ## Whether it comes from the standard library rather than the program.
    prelude: bool

struct FnEntry:
    function: FnDef
    ## The type a method belongs to.
    owner: str?
    prelude: bool
    ## The type parameters of the functions a nested function is defined in.
    inherited = list[Generic]()
    ## For a method from an extension of a generic type, the type's parameters as the
    ## extension names them.
    extension = list[Generic]()

## How deeply type aliases may refer to each other, which also stops an alias naming itself.
def alias_depth() -> int:
    16

## The interfaces every type that can fits automatically.
def built_in_interfaces() -> list[str]:
    ["Eq", "Hashable", "Ordered", "Format"]

def built_in_types() -> list[str]:
    [
        "int", "float", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "bool", "str",
        "LiteralStr", "bytes", "None", "nothing", "list", "array", "SoaList",
        "Iterator", "set", "dict", "tuple", "Id", "Table", "Stdout", "Fs", "Clock", "Args", "Stdin",
        "Process", "Entropy", "Net", "Env", "Result", "->",
    ]

## Every declaration in a program, keyed the way the signature table is: `name` for a
## function, `Type.name` for a method.
struct Program:
    types = dict[str, TypeInfo]()
    functions = dict[str, FnEntry]()
    tests = list[TestDef]()
    interfaces = dict[str, Interface]()
    ## Imported standard library modules, by the name they're used under: `json` after
    ## `from std import json`, `std.json` after `import std.json`.
    modules = list[str]()
    aliases = dict[str, TypeExpr]()
    ## Standard library types a program's own type of the same name replaced, which the
    ## library's own declarations still mean, as the Rust checker keeps them apart.
    shadowed = dict[str, TypeInfo]()
    ## Problems found while adding declarations, like methods that can't be added.
    problems = list[Diagnostic]()

    def add(ref self, module: Module, prelude: bool):
        for item in module.items:
            match item:
                case .Function(function):
                    self.functions[function.name] = FnEntry(
                        function=function,
                        owner=None,
                        prelude=prelude,
                    )
                case .Struct(type_def):
                    self.add_type(type_def, .StructKind, prelude)
                case .Enum(type_def):
                    self.add_type(type_def, .EnumKind, prelude)
                case .Error(type_def):
                    self.add_type(type_def, .ErrorKind, prelude)
                case .TypeAlias(name, ty, _):
                    self.aliases[name] = ty
                case .Const(_, _, _, _):
                    pass
                case .Test(test):
                    self.tests.append(test)
                case .Interface(interface):
                    self.interfaces[interface.name] = interface
                case .Import(imported):
                    if not prelude:
                        self.add_import(imported)
                case .Extend(_):
                    pass
        # Extensions come last, so the type they extend is known wherever it's declared.
        for item in module.items:
            match item:
                case .Extend(extension):
                    self.add_extension(extension, prelude)
                case _:
                    pass

    def add_import(ref self, imported: Import):
        if imported.module.len() == 1 and imported.module[0] == "std":
            for at in range(imported.names.len()):
                self.modules.append(imported.aliases[at] else imported.names[at])
        elif (
            imported.module.len() == 2 and imported.module[0] == "std" and imported.names.len() == 0
        ):
            self.modules.append(imported.alias else ".".join(imported.module))

    def add_type(ref self, type_def: TypeDef, kind: TypeKind, prelude: bool):
        # A program's own type replaces a standard library type of the same name, methods too,
        # where the program names it. The library's own declarations still mean theirs.
        if not prelude and type_def.name in self.types and self.types[type_def.name].prelude:
            self.shadowed[type_def.name] = self.types[type_def.name]
        if not prelude:
            methods = f"{type_def.name}."
            functions = self.functions
            for key in functions.keys():
                if self.functions[key].prelude and key.startswith(methods):
                    _ = self.functions.pop(key)
        for method in type_def.methods:
            self.add_method(type_def.name, method, prelude, [])
        self.types[type_def.name] = TypeInfo(kind=kind, type_def=type_def, prelude=prelude)

    ## Adds an extension's methods to its type, once every type is known. Mirrors
    ## `crates/check/src/extend.rs`.
    def add_extension(ref self, extension: Extension, prelude: bool):
        name = extension.name
        if name in self.types:
            if self.types[name].prelude and not prelude:
                self.problems.append(
                    not_own(name, why="is from the standard library", extension=extension),
                )
                return
        elif name in built_in_types() and not prelude:
            self.problems.append(not_own(name, why="is built in", extension=extension))
            return
        elif (
            name
            in [
                "int", "float", "bool", "bytes", "str", "list", "dict", "set", "Optional", "Id",
                "Table", "i8", "i16", "i32", "u8", "u16", "u32", "u64", "f32",
            ]
        ):
            # The standard library gives built-in types methods, like `str`'s `def *`.
            pass
        elif self.is_interface(name):
            self.problems.append(
                Diagnostic(
                    message=f"`{name}` is an interface, so it can't be extended",
                    span=extension.span,
                    help=f"declare its methods in `interface {name}:`",
                ),
            )
            return
        else:
            self.problems.append(unknown_type(name, extension.span))
            return
        problem = self.wrong_params(extension)
        if problem is not None:
            self.problems.append(problem)
            # A user type's extension still adds its methods, with the declaration's parameters.
            if name in self.types:
                for method in extension.methods:
                    self.add_method(name, method, prelude, [])
            return
        for generic in extension.generics:
            for bound in generic.bounds:
                if not self.is_interface(bound.name):
                    self.problems.append(
                        Diagnostic(
                            message=f"`{bound.name}` isn't an interface",
                            span=bound.span,
                            help="a type parameter can be bound to an interface, like `T: Ordered` or `T: Shape`",
                        ),
                    )
        for method in extension.methods:
            self.add_method(name, method, prelude, extension.generics)

    ## An extension that doesn't name its type's parameters as the type declares them.
    def wrong_params(self, extension: Extension) -> Diagnostic?:
        name = extension.name
        written = [generic.name for generic in extension.generics]
        mut declared = self.type_params(name)
        if name == "list" or name == "set" or name == "Optional" or name == "Id" or name == "Table":
            if written.len() == 1: return None
            declared = ["T"]
        if name == "dict":
            if written.len() == 2: return None
            declared = ["K", "V"]
        if written == declared: return None
        if declared.len() == 0:
            return Diagnostic(
                message=f"`{name}` isn't generic, so its extension takes no type parameters",
                span=extension.span,
                help=f"write `extend {name}:`",
            )
        params = ", ".join(declared)
        Diagnostic(
            message=f"`{name}` is generic, so its extension names its type parameters",
            span=extension.span,
            help=f"write `extend {name}[{params}]:`",
        )

    ## Adds one method to a type, unless the type already has a method of that name.
    def add_method(
        ref self,
        type_name: str,
        method: FnDef,
        prelude: bool,
        extension: list[Generic],
    ):
        key = f"{type_name}.{method.name}"
        if key in self.functions:
            self.problems.append(
                Diagnostic(
                    message=f"`{type_name}` already has a method called `{method.name}`",
                    span=method.span,
                    help="rename one of them",
                ),
            )
            return
        self.functions[key] = FnEntry(
            function=method,
            owner=type_name,
            prelude=prelude,
            extension=extension,
        )

    ## Whether a name is an interface: one the program declares, or a built-in one.
    def is_interface(self, name: str) -> bool:
        name in self.interfaces or name in built_in_interfaces()

    ## A type's type parameters, in order: `T` for `Deque[T]`.
    def type_params(self, name: str) -> list[str]:
        if name not in self.types: return []
        [generic.name for generic in self.types[name].type_def.generics]

    ## The type parameters in scope in a function: its type's, then the functions it's
    ## defined in, then its own.
    def generics_of(self, entry: FnEntry) -> list[Generic]:
        mut generics = []
        owner = entry.owner
        if entry.extension.len() > 0:
            generics += entry.extension
        elif owner is not None and owner in self.types:
            generics += self.types[owner].type_def.generics
        # In a method, `Self` is the type it belongs to.
        if owner is not None:
            generics.append(Generic(name="Self", bounds=[], span=entry.function.span))
        generics + entry.inherited + entry.function.generics

    ## The types as the standard library's own declarations see them: its own, where a
    ## program's type of the same name replaced one.
    def std_types(self) -> dict[str, TypeInfo]:
        mut seen = self.types
        for name, info in self.shadowed.items():
            seen[name] = info
        seen

    ## The type a written type means, with these type parameters in scope.
    def resolve_in(self, written: TypeExpr, generics: list[str]) -> Type fails Diagnostic:
        self.resolve_within(written, generics, alias_depth())?

    def resolve_within(self, written: TypeExpr, generics: list[str], depth: int) -> Type fails Diagnostic:
        name = self.through_module(written.name)
        if self.is_interface(name): fail interface_as_type(name, written.span)
        # `fails ParseError | RangeError`: one of several errors.
        if name == "|":
            mut names = []
            for error in written.args:
                match self.resolve_within(error, generics, depth)?:
                    case .Named(error_name):
                        names.append(error_name)
                    case _:
                        pass
            return .Errors(sorted(names))
        # `(str) -> int fails ParseError`: a function that gives back a result.
        if name == "fails" and written.args.len() == 2:
            returns = self.resolve_within(written.args[0], generics, depth)?
            return .Result(returns, error=self.resolve_within(written.args[1], generics, depth)?)
        # `with Transaction`: what a source lends.
        if name == "with" and written.args.len() == 1:
            lent = self.resolve_within(written.args[0], generics, depth)?
            return .Generic("with", [lent])
        # `shared Scores`: what it holds is any type. Written with nothing in its brackets, it's
        # `shared name = value`, which takes the value's type.
        if name == "shared" and written.args.len() == 1:
            held = self.resolve_within(written.args[0], generics, depth)?
            return .Generic("shared", [held])
        if name == "shared" and written.args.len() == 0:
            return .Unknown
        # `ref unit = units[at]`, which takes the place's type.
        if name == "ref" and written.args.len() == 0:
            return .Unknown
        builtin = name in built_in_types()
        if (
            not builtin
            and name not in generics
            and name not in self.types
            and name not in self.aliases
        ):
            fail unknown_type(name, written.span)
        wanted = self.type_arg_count(name, written.args.len())
        if written.args.len() != wanted: fail wrong_type_args(written, wanted)
        mut args = []
        # An array's size is a number, not a type.
        types = written.args[:1] if name == "array" else written.args
        for arg in types:
            args.append(self.resolve_within(arg, generics, depth)?)
        mut ty = Type.Unknown
        if builtin:
            ty = builtin_type(name, args)
        elif name in generics:
            ty = .Param(name)
        elif name in self.types and args.len() > 0:
            ty = .Generic(name, args)
        elif name in self.types:
            ty = .Named(name)
        else:
            if depth == 0:
                fail Diagnostic(
                    message=f"the type alias `{name}` refers to itself",
                    span=written.span,
                )
            ty = self.resolve_within(self.aliases[name], generics, depth - 1)?
        optional_type(ty) if written.optional else ty

    ## `Deque` for `std.collections.Deque` or `collections.Deque`, through an imported module.
    def through_module(self, name: str) -> str:
        parts = name.split(".")
        if parts.len() < 2: return name
        member = parts[-1]
        path = ".".join(parts[:-1])
        if path in self.modules and member in self.types: return member
        name

    ## How many types a type takes in brackets. A tuple takes however many it's given, and
    ## a function type at least its return type.
    def type_arg_count(self, name: str, given: int) -> int:
        if name == "->": return max(given, 1)
        if name in ["list", "set", "SoaList", "Iterator", "Id", "Table"]: return 1
        if name in ["dict", "Result", "array"]: return 2
        if name == "tuple": return given
        self.type_params(name).len()

def builtin_type(name: str, args: list[Type]) -> Type:
    match name:
        case "int":
            .Int
        case "float":
            .Float
        case "bool":
            .Bool
        case "str":
            .Str
        case "bytes":
            .Bytes
        case "None":
            .NoneType
        case "nothing":
            .Unit
        case "list":
            .List(args[0])
        case "SoaList":
            .List(args[0])
        # The self-hosted checker has no fixed-size arrays of its own yet, so it reads one as a list.
        case "array":
            .List(args[0])
        # The self-hosted checker has no generators of its own yet, so it reads one as a list.
        case "Iterator":
            .List(args[0])
        case "set":
            .Set(args[0])
        case "dict":
            .Dict(args[0], args[1])
        case "Result":
            .Result(args[0], error=args[1])
        case "tuple":
            .Tuple(args)
        case "->":
            .Arrow(args[:-1], args[-1])
        case "Id":
            .Id(args[0])
        case "Table":
            .Table(args[0])
        case _:
            .Named(name)

## An interface written where a type goes, as in `list[Shape]`.
def interface_as_type(name: str, span: Span) -> Diagnostic:
    Diagnostic(
        message=f"`{name}` is an interface, not a type",
        span=span,
        help=f"take a type parameter that fits it, like `def f[T: {name}](items: list[T])`, or use an enum for a mix of types",
    )

def wrong_type_args(written: TypeExpr, wanted: int) -> Diagnostic:
    name = written.name
    mut example = name
    if name == "dict":
        example = "dict[str, int]"
    elif name == "Result":
        example = "Result[int, IoError]"
    elif name in ["list", "set", "SoaList"]:
        example = f"{name}[int]"
    elif name in ["Id", "Table"]:
        example = f"{name}[Enemy]"
    mut message = f"`{name}` doesn't take types in brackets"
    if wanted == 1:
        message = f"`{name}` needs 1 type in brackets"
    elif wanted > 1:
        message = f"`{name}` needs {wanted} types in brackets"
    Diagnostic(message=message, span=written.span, help=f"write it like `{example}`")

def unknown_type(name: str, span: Span) -> Diagnostic:
    mut help = f"declare it, like `struct {name}:`, or check the spelling"
    if name in ["double", "f16"]:
        help = "write `float`, or `f32` for 32 bits"
    elif name in ["usize", "isize", "long"]:
        help = "write `int`"
    elif name in ["string", "String"]:
        help = "write `str`"
    elif name in ["boolean", "Bool"]:
        help = "write `bool`"
    elif name in ["List", "Dict", "Set"]:
        help = f"write `{name.lower()}`"
    elif name == "Optional":
        help = "write `?` after the type, like `Enemy?`"
    elif name == "Self":
        help = "`Self` means the type a method belongs to, so it goes in a method of a type or an interface"
    Diagnostic(message=f"`{name}` isn't a type", span=span, help=help)

## An extension of a type that isn't one of the program's own.
def not_own(name: str, why: str, extension: Extension) -> Diagnostic:
    Diagnostic(
        message=f"`{name}` {why}, so it can't be extended",
        span=extension.span,
        help=f"an extension adds methods to one of this kit's own types; write a function that takes a `{name}` instead",
    )
