---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Not found" description="Nothing is at this path.">
  <section class="lost">
    <img src={`${base}brand/scout/scout-404.webp`} alt="Scout lost on a desert dune at night, holding his map upside down, his footprints going in a circle" width="1536" height="864" />
    <div class="wrap copy">
      <span class="code">404</span>
      <h1>Nothing is at this path.</h1>
      <p>Scout checked the map. The page may have moved, or the link may be wrong.</p>
      <div class="actions">
        <a class="button primary" href={base}>Back home</a>
        <a class="button" href={`${base}tour/`}>Take the tour</a>
        <a class="button" href={`${base}reference/`}>The language</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    position: relative;
    min-height: min(82vh, 720px);
    display: flex;
    align-items: flex-start;
    overflow: hidden;
    background: #14132b;
    color: #fff6ea;
    border-bottom: 1px solid var(--border);
  }

  .lost img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
  }

  .copy {
    position: relative;
    width: 100%;
    padding-block: 5rem 4rem;
    display: grid;
    gap: 1rem;
    max-width: var(--max);
  }

  .copy > * {
    max-width: min(30rem, 40vw);
  }

  @media (max-width: 700px) {
    .copy > * {
      max-width: none;
    }
  }

  .code {
    font: 600 0.8rem var(--font-mono);
    letter-spacing: 0.1em;
    color: #f59a3e;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 650;
  }

  p {
    margin: 0;
    color: #d9d3e3;
    font-size: 1.05rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    max-width: none;
  }

  .actions .button:not(.primary) {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.2);
    color: #fff6ea;
  }

  /* On a phone, Scout goes below the words, never behind them. */
  @media (max-width: 700px) {
    .lost {
      flex-direction: column;
    }
    .lost img {
      position: static;
      order: 2;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-position: 50% 60%;
    }
    .copy {
      padding-block: 3rem 1.5rem;
    }
  }
</style>
