# Thousands of random changes to two lists and two dicts in a `shared` value, under `lock ... as ref`,
# each case failing at a random step or not at all: a failure must leave them exactly as they were
# before the lock, a dict's keys in the same order, and a case that ends must leave what the same
# changes make of plain ones. An append, a pop, an item set and a dict's put or pop there are made in
# place and undone from the lock's log; the other changes copy the list.
error Boom:
    step: int

struct Holder:
    words: list[str]
    numbers: list[int]
    counts: dict[str, int]
    names: dict[int, str]

struct Random:
    state: int

    def below(ref self, limit: int) -> int:
        self.state = (self.state * 1103515245 + 12345) % 2147483648
        if limit <= 0: return 0
        return (self.state // 65536) % limit

## One random change to both lists, as a method changes a shared value's fields through `ref`. With
## `boom`, it crashes once the change is made.
def change(
    ref words: list[str],
    ref numbers: list[int],
    ref counts: dict[str, int],
    ref names: dict[int, str],
    ref random: Random,
    boom: bool,
) fails Boom:
    what = random.below(8)
    if what == 0:
        words.append(f"w{random.below(100)}")
        numbers.append(random.below(100))
    elif what == 1:
        if len(words) > 0:
            _ = words.pop()
        if len(numbers) > 0:
            _ = numbers.pop()
    elif what == 2:
        words.extend([f"e{random.below(10)}", "x"])
        numbers.extend([random.below(10)])
    elif what == 3:
        words.insert(random.below(len(words) + 1), "i")
        numbers.insert(random.below(len(numbers) + 1), 7)
    elif what == 4:
        if len(words) > 0:
            words[random.below(len(words))] = f"s{random.below(10)}"
        if len(numbers) > 0:
            numbers[random.below(len(numbers))] = random.below(1000)
    elif what == 5:
        if random.below(4) == 0:
            words.clear()
            numbers.clear()
    elif what == 6:
        words.sort()
        numbers.sort()
    else:
        for _ in range(random.below(5)):
            words.append("loop")
            numbers.append(1)
            if len(numbers) > 3:
                _ = numbers.pop()
    if len(words) > 60:
        words.clear()
    # And a change to each dict: a key put, new or not, or one taken out, so that what's put back
    # is in the order it was.
    key = f"k{random.below(12)}"
    if random.below(3) == 0:
        if key in counts:
            _ = counts.pop(key)
    else:
        counts[key] = random.below(1000)
    number = random.below(12)
    if random.below(3) == 0:
        if number in names:
            _ = names.pop(number)
    else:
        names[number] = f"a name long enough to be held in a block of its own, {random.below(100)}"
    if boom: fail Boom(step=len(words))

## A case's changes under the lock, failing at step `crash_at` when it's one of them: inside the
## change at that step, or just before it, by turns.
def changed(holder: shared Holder, seed: int, steps: int, crash_at: int) fails Boom:
    mut random = Random(state=seed)
    lock holder as ref held:
        for step in range(steps):
            if step == crash_at and seed % 2 == 0: fail Boom(step=step)
            if random.below(3) == 0:
                # Straight on the held value, not through a call.
                held.words.append("direct")
                held.numbers.append(random.below(9))
                if len(held.words) > 1:
                    _ = held.words.pop()
                held.numbers[random.below(len(held.numbers))] = random.below(9)
                held.counts[f"d{random.below(4)}"] = random.below(9)
                held.names[
                    random.below(4)
                ] = "direct, and long enough to be held in a block of its own"
                if "d0" in held.counts:
                    _ = held.counts.pop("d0")
            change(
                ref held.words,
                ref held.numbers,
                ref held.counts,
                ref held.names,
                ref random,
                boom=step == crash_at,
            )?

## The same changes made to plain lists, for what a case that doesn't crash leaves.
def modeled(
    ref words: list[str],
    ref numbers: list[int],
    ref counts: dict[str, int],
    ref names: dict[int, str],
    seed: int,
    steps: int,
):
    mut random = Random(state=seed)
    for _ in range(steps):
        if random.below(3) == 0:
            words.append("direct")
            numbers.append(random.below(9))
            if len(words) > 1:
                _ = words.pop()
            numbers[random.below(len(numbers))] = random.below(9)
            counts[f"d{random.below(4)}"] = random.below(9)
            names[random.below(4)] = "direct, and long enough to be held in a block of its own"
            if "d0" in counts:
                _ = counts.pop("d0")
        change(ref words, ref numbers, ref counts, ref names, ref random, boom=False) except Boom(
        ): return

def ran(holder: shared Holder, seed: int, steps: int, crash_at: int) -> bool:
    _ = changed(holder, seed=seed, steps=steps, crash_at=crash_at) except Boom():
        return False
    return True

def main(stdout: Stdout):
    shared holder = Holder(words=["a", "b"], numbers=[1, 2, 3], counts={"k0": 0}, names={0: "zero"})
    mut words = ["a", "b"]
    mut numbers = [1, 2, 3]
    mut counts = {"k0": 0}
    mut names = {0: "zero"}
    mut picker = Random(state=12345)
    mut wrong = 0
    mut crashed = 0
    mut kept = 0
    for trial in range(3000):
        seed = picker.below(1000000)
        steps = 1 + picker.below(30)
        crash_at = picker.below(steps * 2)
        if ran(holder, seed=seed, steps=steps, crash_at=crash_at):
            kept += 1
            modeled(ref words, ref numbers, ref counts, ref names, seed=seed, steps=steps)
        else:
            crashed += 1
        lock holder as held:
            # A dict is compared in order too.
            if (
                held.words != words
                or held.numbers != numbers
                or held.counts.items() != counts.items()
                or held.names.items() != names.items()
            ):
                wrong += 1
                if wrong < 4:
                    stdout.print("case", trial, held.words, words, held.numbers, numbers)
                    stdout.print(
                        held.counts.items(),
                        counts.items(),
                        held.names.items(),
                        names.items(),
                    )
                # Back in step with what the shared value holds, to find the next.
                words = list(held.words)
                numbers = list(held.numbers)
                counts = {key: value for key, value in held.counts.items()}
                names = {key: value for key, value in held.names.items()}
    stdout.print("wrong", wrong, "crashed", crashed > 1000, "kept", kept > 1000)
