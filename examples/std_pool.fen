# decision: A database connects as a pool, and a keeper lends each connection for one block.
#
# `pool[T](open=..., size=10, wait=30s)` keeps each value in a task of its own, a keeper, and
# `take()` lends one to a `with` block, first come first served. One value opens up front, so a
# pool that can't open any fails at its `with`, and the rest open when they're first needed. A
# block that fails or crashes hands its value back to be `reset()`, and one that can't be reset
# is closed and opened again when it's next needed, so the pool never shrinks. A borrower waits
# up to `wait`, or a `take(wait=)` of its own, for a value to come free, then fails with
# `PoolError.Timeout`.
from std.concurrent import Crashed, Pool, PoolError, pool
from std.time import Duration

## A pretend connection: its number, in the order they were opened, and whether a reset works.
struct Link:
    number: int
    resets = True

    def reset(self) -> bool:
        self.resets

    def close(self):
        pass

## Why opening a link failed.
error Refused:
    why: str

    def message(self) -> str:
        self.why

## What a block with a link did wrong.
error Broke:
    pass

## How many links have been opened, and how many blocks were served one.
struct Tally:
    opened = 0
    served = 0

## A new link, numbered by how many have been opened, all of them failing their reset if
## `fragile` says.
def opened(tally: shared Tally, fragile: bool) -> Link fails Refused:
    lock tally as ref counts:
        counts.opened += 1
        Link(number=counts.opened, resets=not fragile)

## The number of links opened so far.
def opens(tally: shared Tally) -> int:
    lock tally as counts:
        counts.opened

## A block that fails with the link it took.
def broken(link: Link) fails Broke:
    if link.number > 0: fail Broke()

test "a value goes back and is lent again"():
    shared count = Tally()
    with pool[Link, Refused](open=() => opened(count, fragile=False), size=1)? as links:
        with links.take()? as first:
            assert first.number == 1
        with links.take()? as again:
            assert again.number == 1
    assert opens(count) == 1

test "only one opens up front, and the rest when they're needed"():
    shared count = Tally()
    with pool[Link, Refused](open=() => opened(count, fragile=False), size=3)? as links:
        assert opens(count) == 1
        with links.take()? as first:
            with links.take()? as second:
                assert first.number != second.number
        assert opens(count) == 2

test "a failed block's value is reset and lent again"():
    shared count = Tally()
    with pool[Link, Refused](open=() => opened(count, fragile=False), size=1)? as links:
        assert borrowed_and_broken(links) fails Broke()
        with links.take()? as again:
            assert again.number == 1

test "a value that can't be reset is replaced"():
    shared count = Tally()
    with pool[Link, Refused](open=() => opened(count, fragile=True), size=1)? as links:
        assert borrowed_and_broken(links) fails Broke()
        with links.take()? as again:
            assert again.number == 2

test "a borrower waits up to wait, then fails"():
    shared count = Tally()
    with pool[Link, Refused](open=() => opened(count, fragile=False), size=1)? as links:
        # The first takes the only link, waiting as long as the pool's tasks take to start; the
        # second asks for one with a short wait, and none can come free while the first is held.
        with links.take()? as _:
            problem = failure_of(() => taken_number(links, wait=20ms))
            assert problem is not None
            assert problem.message() == "no value came free in 0.02s"

test "a pool that can't open one fails at its with"():
    assert pool_that_cant_open() fails Open(reason="the server's away")

test "many tasks share a few values"():
    shared count = Tally()
    with pool[Link, Refused](open=() => opened(count, fragile=False), size=3)? as links:
        for _ in parallel(range(12)):
            served_once(links, count) else continue
    assert opens(count) <= 3
    lock count as counts:
        assert counts.served == 12

## Takes a link, and counts that it was served.
def served_once(links: Pool[Link], tally: shared Tally) fails PoolError:
    with links.take()? as _:
        lock tally as ref counts:
            counts.served += 1

## Takes a link and fails with it.
def borrowed_and_broken(links: Pool[Link]) fails PoolError | Broke:
    with links.take()? as link:
        broken(link)?

## The number of the link `take()` lends, waiting up to `wait` for it.
def taken_number(links: Pool[Link], wait: Duration) -> int fails PoolError:
    with links.take(wait=wait)? as link:
        return link.number
    0

## A pool whose links can't be opened.
def pool_that_cant_open() fails PoolError | Crashed:
    with pool[Link, Refused](open=() => refused())? as _:
        pass

def refused() -> Link fails Refused:
    fail Refused(why="the server's away")

def main(stdout: Stdout) fails PoolError | Crashed:
    shared count = Tally()
    with pool[Link, Refused](open=() => opened(count, fragile=False), size=2)? as links:
        with links.take()? as first:
            with links.take()? as second:
                stdout.print("two at once:", first.number, second.number)
        with links.take()? as again:
            stdout.print("then one of them again:", again.number)
    stdout.print("opened", opens(count))
