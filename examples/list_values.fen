# decision: Collections are values.

## Lists are values: a copy keeps its items when the original changes, and a `mut`
## parameter changes the caller's list.

struct Point:
    x: float
    y: float

def grow(mut items: list[int], n: int):
    for i in range(n):
        items.append(i * 10)

def doubled(items: list[int]) -> list[int]:
    mut out: list[int] = []
    for x in items:
        out.append(x * 2)
    out

def nudge(mut points: list[Point]):
    for i in range(points.len()):
        points[i].x += 1.0

def both(items: list[int], mut others: list[int]) -> int:
    others.append(9)
    others[0] = 7
    items.len() * 10 + items[0]

def spread(
    mut int_list: list[int],
    mut float_list: list[float],
    mut count_list: list[int],
    mut flag_list: list[bool],
    n: int,
) -> float:
    for i in range(n):
        int_list.append(i)
        float_list.append(float(i) / 2.0)
        count_list[0] += i
        flag_list.append(i % 2 == 0)
    float_list[-1] * 2.0

def main(stdout: Stdout):
    mut items = [1, 2, 3]
    kept = items
    items[0] = 100
    items.append(4)
    stdout.print(items, kept, items.len(), kept.len())

    mut shared = [7]
    alias = shared
    shared.append(8)
    stdout.print(shared, alias)

    grow(mut items, 3)
    stdout.print(items, doubled(items), items == kept, kept == [1, 2, 3])

    mut many: list[int] = []
    for i in range(1_000):
        many.append(i)
    total = sum(value for value in many)
    stdout.print(many.len(), total, many[-1], many[500])

    mut points = [Point(x=0.0, y=1.0), Point(x=2.0, y=3.0)]
    before = points
    nudge(mut points)
    points.append(Point(x=9.0, y=9.0))
    stdout.print(points, before)

    mut order = [3, 1, 2]
    order.sort()
    last = order.pop()
    stdout.print(order, last, order + [5], items[1:3])

    mut walked = [1, 2, 3]
    for walk in walked:
        walked.append(walk)
    stdout.print(walked)

    # Passed both ways, the argument without `mut` keeps its items.
    mut twice = [1, 2]
    stdout.print(both(twice, mut twice), twice)

    # A call can give back more than fits in a machine's return registers.
    mut ints = [1]
    mut floats = [0.5]
    mut counts = [10]
    mut flags = [False]
    stdout.print(
        spread(mut ints, mut floats, mut counts, mut flags, 100),
        ints.len(),
        floats[50],
        counts,
        flags[-1],
    )
