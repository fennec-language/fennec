# A function failing with more than one type of error, and what each error turns into as it goes
# up: through `?`, through `return`, through a plain copy, shown, and matched by its type.

error Short:
    why: str

error Coded:
    code: int

error Held:
    items: list[int]
    table: dict[str, int]

def short(n: int) -> int fails Short:
    if n > 1: fail Short(why="too big")
    n

def coded(n: int) -> int fails Coded:
    if n > 1: fail Coded(code=n)
    n

def held(n: int) -> int fails Held:
    if n > 1: fail Held(items=[n, n], table={"k": n})
    n

def short_or_coded(n: int) -> int fails Coded | Short:
    first = short(n)?
    second = coded(n + 1)?
    first + second

def any_of_three(n: int) -> int fails Coded | Held | Short:
    first = short_or_coded(n)?
    second = held(n + 2)?
    first + second

def by_return(n: int) -> int fails Coded | Short:
    if n > 5: return short(n)?
    coded(n)?

def by_copy(n: int) -> str:
    answer = short_or_coded(n) if n > 0 else short(n)
    value = answer else as error:
        return f"{error}"
    f"{value}"

def in_a_loop(n: int) -> int fails Coded | Held | Short:
    for step in range(3):
        value = short_or_coded(n + step)?
        if value > 100: return held(value)?
    if n > 9: return coded(n)?
    n

def check_short(n: int) fails Short:
    if n > 1: fail Short(why="no")

def check_coded(n: int) fails Coded:
    if n > 1: fail Coded(code=n)

def nothing_back(n: int) fails Coded | Short:
    check_short(n - 1)?
    check_coded(n)?

def main(stdout: Stdout):
    for n in [-1, 0, 1, 2]:
        match any_of_three(n):
            case Ok(value):
                stdout.print(value)
            case Err(error):
                stdout.print(error)
        stdout.print(by_return(n) else -1, by_copy(n))
    for n in [0, 1, 2]:
        value = short_or_coded(n) else as why:
            match why:
                case Short(why):
                    stdout.print(f"short {why}")
                    continue
                case Coded(code):
                    stdout.print(f"coded {code}")
                    continue
        stdout.print(value)
    for n in [-5, -4, 0, 1, 20]:
        result = in_a_loop(n)
        stdout.print(result)
        value = result else as error:
            stdout.print(error)
            stdout.print(f"{error}")
            stdout.print([error])
            kept = error
            stdout.print(kept)
            continue
        stdout.print(value)
    match nothing_back(2):
        case Ok(_):
            stdout.print("fine")
        case Err(error):
            stdout.print(error)
    match by_return(6):
        case Ok(value):
            stdout.print(value)
        case Err(error):
            stdout.print(error)
