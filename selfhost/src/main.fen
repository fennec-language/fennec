## Fennec's front end, written in Fennec.
##
## This mirrors the Rust front end in `crates/syntax`, file for file: `lexer.fen` turns source
## text into tokens, `parser.fen` turns tokens into the syntax tree in `ast.fen`, and
## `dump.fen` prints both in the same text as `fennec dev tokens` and `fennec dev tree`, so
## the two front ends can be compared line by line.

from ast import FnDef, Item, Module
from dump import dump_check, dump_tokens, dump_tree
from parser import parse
import parser.expr
import parser.pattern
# Statements, expressions and patterns extend `Parser` from these files, which a kit loads
# only when something imports them.
import parser.stmt
from span import Diagnostic

## Whether a function or method is declared `@intrinsic`.
def declared_intrinsic(function: FnDef) -> bool:
    return any(annotation.name == "intrinsic" for annotation in function.annotations)

## A standard library file as the checker reads it: without what it declares `@intrinsic`, a method
## or function the engines provide, which the checker knows from its own tables. An `extend` left
## with no methods goes too. As `without_engine_declarations` in `crates/syntax/src/stdlib.rs`.
def without_engine_declarations(module: Module) -> Module:
    mut kept = list[Item]()
    for item in module.items:
        match item:
            case .Function(function):
                if not declared_intrinsic(function):
                    kept.append(item)
            case .Extend(extension):
                methods = [method for method in extension.methods if not declared_intrinsic(method)]
                if len(methods) > 0:
                    kept.append(.Extend(copy(extension, methods=methods)))
            case .Struct(type_def):
                methods = [method for method in type_def.methods if not declared_intrinsic(method)]
                kept.append(.Struct(copy(type_def, methods=methods)))
            case .Enum(type_def):
                methods = [method for method in type_def.methods if not declared_intrinsic(method)]
                kept.append(.Enum(copy(type_def, methods=methods)))
            case .Error(type_def):
                methods = [method for method in type_def.methods if not declared_intrinsic(method)]
                kept.append(.Error(copy(type_def, methods=methods)))
            case _:
                kept.append(item)
    return Module(items=kept)

## The standard library as the checker reads it: under each module's name, a line for each
## function, and for each method of a type or an `extend`, so a test can hold both front ends to
## reading the same std.
def dump_library(names: list[str], library: list[Module]) -> str:
    mut out = ""
    for name, module in zip(names, library):
        out += f"-- {name}\n"
        for item in module.items:
            match item:
                case .Function(function):
                    out += f"{function.name}\n"
                case .Extend(extension):
                    for method in extension.methods:
                        out += f"{extension.name}.{method.name}\n"
                case .Struct(type_def):
                    for method in type_def.methods:
                        out += f"{type_def.name}.{method.name}\n"
                case .Enum(type_def):
                    for method in type_def.methods:
                        out += f"{type_def.name}.{method.name}\n"
                case .Error(type_def):
                    for method in type_def.methods:
                        out += f"{type_def.name}.{method.name}\n"
                case _:
                    pass
    return out

## Reads its work from standard input: one `tokens <path>`, `tree <path>` or `check <path>`
## line per file to dump. `std <module> <path>` lines name the standard library's sources, by
## module, which `check` checks against, and a `library` line dumps them as the checker reads them.
def main(stdout: Stdout, fs: Fs, stdin: Stdin):
    mut library = []
    mut names = list[str]()
    for line in stdin.lines():
        if line == "library":
            stdout.print("== library")
            stdout.write(dump_library(names, library))
            continue
        space = line.find(" ")
        if space is None: continue
        mode = line[:space]
        mut path = line[space + 1:]
        mut module_name = ""
        if mode == "std":
            gap = path.find(" ") else continue
            module_name = path[:gap]
            path = path[gap + 1:]
        source = fs.read_text(path)?
        if mode == "std":
            module = parse(source) except Diagnostic():
                continue
            # `std.intrinsics`' own functions are the machine operations std's code calls, so they
            # stay. Every other module's engine declarations are left out, as Rust leaves them.
            if module_name == "intrinsics":
                library.append(module)
            else:
                library.append(without_engine_declarations(module))
            names.append(module_name)
            continue
        stdout.print(f"== {path}")
        if mode == "tokens":
            stdout.write(dump_tokens(source))
        elif mode == "tree":
            stdout.write(dump_tree(source))
        elif mode == "check":
            stdout.write(dump_check(source, library))
