# A waiting call of many ranges. Each works a little first; the first then fails, and every other
# waits to receive on a channel nobody sends to. The ranges the failure kept from starting never
# run, so which ranges are left waiting is the run's own.
from std.concurrent import Channel, channel

error Boom:
    at: int

def works(rounds: int) -> int:
    mut total = 7
    for at in range(rounds):
        total = (total * 1103515245 + 12345 + at) % 2147483648
    return total

def part(at: int, pipe: Channel[int]) -> int fails Boom:
    if at == 0:
        _ = works(200000)
        fail Boom(at=at)
    _ = works(2000000)
    got = pipe.receive() else -1
    return got

def all_parts(pipe: Channel[int]) -> int fails Boom:
    got = [part(at, pipe=pipe)? for at in parallel(range(64))]
    return sum(got)

def main(stdout: Stdout):
    with channel[int](size=1) as pipe:
        total = all_parts(pipe) except why:
            stdout.print("the call failed:", why)
            return
        stdout.print(total)
