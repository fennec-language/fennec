# As n3, the outer bucket list out of range and the inner one in range.
def both(starts: list[int], order: list[int], other_starts: list[int], other: list[int], most: int) -> int:
    mut added = 0
    for at in range(starts[0], starts[1]):
        added += order[at]
        for inner in range(other_starts[0], other_starts[1]):
            if other[inner] > most: break
            added += other[inner]
    return added

def main(stdout: Stdout):
    stdout.print(both([0, 3], order=[1, 2], other_starts=[0, 3], other=[5, 6, 70], most=50))
