struct Pool:
    items: list[int]
    head = 0

    def len(self) -> int:
        return self.items.len()

    def [](mut self, i: int) -> int:
        return self.items[(self.head + i) % self.items.len()]

def main(stdout: Stdout):
    mut pool = Pool(items=[1])
    for mut item in parallel(pool):
        item += 1
    stdout.print(pool.len())
