## `std.pack`: a compact binary format for anything that saves, through the same `serialize` and
## `deserialize` as JSON and TOML. Fields go in the order they're written, with no names. The
## bytes start with `FPK2`, a number for the type's shape, and the type's layout: each field's
## name and what it holds, and each case's name, once for the whole value. Loading into a type of
## the same shape reads the fields in order, passing over the layout. Loading into another, like
## the next version of a program's type, reads them by name: a field the data has and the type
## doesn't is passed over, a field the type has and the data doesn't takes its default, and one
## with no default fails the load, naming it. A case or a union's member is found by its name too.
##
## ```fennec
## from std import pack
##
## data = pack.dumps(world)
## back = pack.loads[World](data)?
## ```
##
## Loading checks every length against what's left and against `Limits` before it takes
## anything, so bytes that aren't what `dumps` wrote fail with a `ParseError` rather than nesting
## too deep or asking for more than they hold.
##
## A `Table` is saved as JSON saves it, as its items in order, with each `Id` as where its item is,
## and loading makes a new `Table`. With `exact=True` it's saved slot for slot instead: the slots
## taken out, their generations, and each `Id` as its slot and generation. Loading then gives the
## same slots, so a replay's later `add`s hand out the same `Id`s, and an `Id` whose item had gone
## is still gone. Either way an `Id` has to be in a `Table` saved with it, one of each type.

from std.intrinsics import bytes_builder, bytes_push, bytes_push_bytes, bytes_push_text, bytes_push_word, bytes_set, bytes_text, float_bits, float_of_bits, layout, new_tag, pack_lock, shape_hash, shape_locked, text_byte, text_size, type_name
from std.io import Reader, Writer, read_all
from std.json import IdsSeen, found_tables

## How far a load may go. Bytes that ask for more fail to load.
export struct Limits:
    ## How deeply lists, dicts, structs and cases may nest.
    depth = 64
    ## The most bytes one text or `bytes` may hold, and the most items a load may read in all.
    length = 16_000_000
    ## The most items a load may read that take no bytes, like a struct with nothing saved in it.
    ## Each of those is made from nothing, so bytes could ask for far more memory than they are.
    empty = 65536

## `value` as bytes, which `loads` reads back into the same type. With `exact`, its `Table`s are
## saved slot for slot.
export def dumps[T: Serializable](value: T, exact = False) -> bytes:
    mut out = PackWriter(_exact=exact)
    out._header(shape_hash[T](), layout_unless_locked[T]())
    value.serialize(ref out)
    if not out._wants_tables: return out._done()
    # It holds `Id`s, so where each one's item is comes first, and every one's checked.
    found = found_tables(value, exact)
    mut again = PackWriter(_exact=exact, _tables=found.positions(), _tags=found.tags(), _found=True)
    again._header(shape_hash[T](), layout_unless_locked[T]())
    value.serialize(ref again)
    return again._done()

## A `T` from bytes `dumps` wrote for a `T`, or for an earlier version of it, read by its fields'
## names. It fails if a field it needs isn't there, if they end too soon or go on past it, or if
## they go past `limits`.
export def loads[T: Deserializable](data: bytes, limits: Limits? = None) -> T fails ParseError:
    held = limits else Limits()
    mut src = PackReader(
        _data=data,
        _most_deep=held.depth,
        _longest=held.length,
        _most_empty=held.empty,
    )
    if not src._header(shape_hash[T](), type_name[T]())?:
        mut layout = data[src._layout_at:src._layout_end]
        if len(src._locked) > 0:
            layout = src._locked
        return by_name[T](src, layout=layout, at=src._layout_at)?
    return read_value[T](ref src) except ParseError():
        # Read again keeping track of where it is, which a load that works never pays for.
        mut again = PackReader(
            _data=data,
            _most_deep=held.depth,
            _longest=held.length,
            _most_empty=held.empty,
            _explain=True,
        )
        _ = again._header(shape_hash[T](), type_name[T]())?
        read_value[T](ref again)?

## Values one after another, as a file or a stream holds them. Each type's layout goes once,
## before the first value of it, and each value after it says which layout it has, by where that
## is among the layouts so far, and how long it is. So a stream of small values costs a byte or two
## each beyond the values themselves.
##
## ```fennec
## mut out = pack.Packer()
## for entry in entries:
##     out.add(entry)
## fs.write_bytes(path, out.bytes())?
## ```
##
## The bytes start with `FPKS`, or `FPKT` with `Table`s slot for slot. Then each record starts
## with a varint: 0, then a layout's shape number and its text; or which layout a value has, then
## the value's length and the value. A layout's place `at` is written as `at + 1`, passing over 70,
## the `F` that starts `FPKS`: so what another `Packer` wrote can follow, as a file run after run
## adds to, and its header starts a new set of layouts.
## The first byte of what a `Packer` writes, `F`, which no record starts with but a header.
HEADER = 70

export struct Packer:
    _exact = False
    _out = bytes_builder()
    ## The number for the shape of each layout written, in order.
    _shapes = list[int]()
    ## How much of what's written `take` has given already.
    _taken = 0

    ## A packer that saves `Table`s slot for slot, as `dumps(value, exact=True)` does.
    def exact() -> Packer:
        return Packer(_exact=True)

    ## Adds `value`, after its type's layout if it's the first value of its type.
    def add[T: Serializable](ref self, value: T):
        if len(self._out) == 0:
            for b in [HEADER, 80, 75, 84 if self._exact else 83]:
                bytes_push(ref self._out, b)
        shape = shape_hash[T]()
        mut at = -1
        for seen, known in enumerate(self._shapes):
            if known == shape:
                at = seen
        mut head = PackWriter()
        if at < 0:
            at = len(self._shapes)
            self._shapes.append(shape)
            head._varint(0)
            head._word(shape)
            head.text(layout[T]())
        body = packed(value, self._exact)
        head._varint(at + 1 if at + 1 < HEADER else at + 2)
        head._varint(len(body))
        bytes_push_bytes(ref self._out, head._done())
        bytes_push_bytes(ref self._out, body)

    ## Everything added so far, as a file holds it.
    def bytes(self) -> bytes:
        return self._out[0:len(self._out)]

    ## What's been added since the last `take`, to send on a stream.
    def take(ref self) -> bytes:
        part = self._out[self._taken:len(self._out)]
        self._taken = len(self._out)
        return part

## Reads what a `Packer` wrote, a value at a time: in order when it was written from the type it's
## read as, and by its layout's names when it was written from another shape of it, like an
## earlier version of the program's type.
##
## ```fennec
## mut src = pack.Unpacker.of(fs.read_bytes(path)?)
## while True:
##     entry = src.next[Entry]()? else break
## ```
export struct Unpacker:
    _data = bytes(list[int]())
    _at = 0
    ## Whether more may come, through `feed`, so a value cut off at the end waits for it.
    _streaming = False
    ## Whether a header has been read, which has to come first.
    _started = False
    _exact = False
    _limits = Limits()
    ## Each layout read so far, and the number for its shape.
    _shapes = list[int]()
    _layouts = list[bytes]()

    ## Reads `data`, all a `Packer` wrote: bytes that end partway through a value fail.
    def of(data: bytes, limits: Limits? = None) -> Unpacker:
        return Unpacker(_data=data, _limits=limits else Limits())

    ## Reads a stream, given to it with `feed` as it comes: a value that's only partly come waits for
    ## the rest.
    def stream(limits: Limits? = None) -> Unpacker:
        return Unpacker(_streaming=True, _limits=limits else Limits())

    ## Gives it more of the stream.
    def feed(ref self, more: bytes):
        self._data = self._data[self._at:len(self._data)] + more
        self._at = 0

    def _fail(self, at: int, message: str) -> ParseError:
        return ParseError(message=f"{message}, at byte {at}", line=0, column=0)

    ## A varint at `at`, and where what's after it starts, or -1 there if the bytes end first.
    def _varint(self, at: int) -> (int, int) fails ParseError:
        mut n = 0
        mut shift = 0
        mut place = at
        while place < len(self._data):
            b = self._data[place]
            if shift > 63 or (shift == 63 and b > 1): fail self._fail(at, "a number is too long")
            n = n | ((b & 127) << shift)
            place += 1
            if b < 128: return (n, place)
            shift += 7
        return (0, -1)

    ## `None` when what's left ends partway, on a stream that has more to come, and a failure in
    ## bytes that are all there are.
    def _cut_off(self) -> bool fails ParseError:
        if self._streaming: return True
        fail self._fail(len(self._data), "the data ends too soon")

    ## The next value, as a `T`, or `None` when there's no more: at the end of the bytes, or on a
    ## stream until more is fed. It fails if the next value isn't one a `T` loads from.
    def next[T: Deserializable](ref self) -> T? fails ParseError:
        while True:
            at = self._at
            left = len(self._data) - at
            if left == 0: return None
            if not self._started and self._data[at] != HEADER:
                fail self._fail(at, "these aren't values a `pack.Packer` wrote")
            tag, after = self._varint(at)?
            if after < 0:
                _ = self._cut_off()?
                return None
            if tag == HEADER:
                # What a `Packer` wrote starts here, with layouts of its own.
                if left < 4:
                    _ = self._cut_off()?
                    return None
                mode = self._data[at + 3]
                if (
                    self._data[at + 1] != 80
                    or self._data[at + 2] != 75
                    or (mode != 83 and mode != 84)
                ):
                    fail self._fail(at, "these aren't values a `pack.Packer` wrote")
                self._exact = mode == 84
                self._started = True
                self._shapes = list[int]()
                self._layouts = list[bytes]()
                self._at = at + 4
                continue
            if tag == 0:
                # A layout, for the values after it that say its place.
                if after + 8 > len(self._data):
                    _ = self._cut_off()?
                    return None
                mut shape = 0
                for place in range(8):
                    shape = shape | (self._data[after + place] << (8 * place))
                size, start = self._varint(after + 8)?
                if start < 0 or size > len(self._data) - start:
                    _ = self._cut_off()?
                    return None
                self._shapes.append(shape)
                self._layouts.append(self._data[start:start + size])
                self._at = start + size
                continue
            place = tag - 1 if tag < HEADER else tag - 2
            if place >= len(self._layouts):
                fail self._fail(at, f"a value has layout {place}, which hasn't come")
            size, start = self._varint(after)?
            if start < 0 or size > len(self._data) - start:
                _ = self._cut_off()?
                return None
            body = self._data[start:start + size]
            self._at = start + size
            if self._shapes[place] == shape_hash[T]():
                return in_order[T](body, self._exact, self._limits)?
            held = self._limits
            raw = PackReader(
                _data=body,
                _exact=self._exact,
                _most_deep=held.depth,
                _longest=held.length,
                _most_empty=held.empty,
                _items_left=held.length,
            )
            return by_name[T](raw, layout=self._layouts[place], at=0)?
        return None

## `value` with no header, as a `Packer` writes it after its layout.
def packed[T: Serializable](value: T, exact: bool) -> bytes:
    mut out = PackWriter(_exact=exact)
    value.serialize(ref out)
    if not out._wants_tables: return out._done()
    # It holds `Id`s, so where each one's item is comes first, and every one's checked.
    found = found_tables(value, exact)
    mut again = PackWriter(_exact=exact, _tables=found.positions(), _tags=found.tags(), _found=True)
    value.serialize(ref again)
    return again._done()

## A `T` from `body`, a value with no header written from a `T`, read in order.
def in_order[T: Deserializable](body: bytes, exact: bool, held: Limits) -> T fails ParseError:
    mut src = PackReader(
        _data=body,
        _exact=exact,
        _most_deep=held.depth,
        _longest=held.length,
        _most_empty=held.empty,
        _items_left=held.length,
    )
    return read_value[T](ref src) except ParseError():
        # Read again keeping track of where it is, which a load that works never pays for.
        mut again = PackReader(
            _data=body,
            _exact=exact,
            _most_deep=held.depth,
            _longest=held.length,
            _most_empty=held.empty,
            _items_left=held.length,
            _explain=True,
        )
        read_value[T](ref again)?

## `T`'s layout to write beside a value, or "" when the kit's `pack.lock` has it, which a reader
## finds there instead. A value is then as small as it was before layouts.
def layout_unless_locked[T]() -> str:
    if shape_locked[T](): return ""
    return layout[T]()

## The layout `pack.lock` holds for the shape number `shape`, or nothing.
def locked_layout(shape: int) -> bytes:
    wanted = shape_text(shape)
    for line in pack_lock().split("\n"):
        if line.startswith(wanted + " "):
            # The type's name, then its layout.
            rest = line[len(wanted) + 1:]
            space = rest.find(" ") else return bytes([])
            return rest[space + 1:].encode()
    return bytes([])

## A shape's number as `pack.lock` writes it: 16 hex digits, the highest first.
def shape_text(shape: int) -> str:
    digits = "0123456789abcdef"
    mut out = ""
    for at in range(16):
        out += digits[(shape >> (60 - 4 * at)) & 15]
    return out

## A `T` from data saved from another shape of it, by the names in `layout`, the one saved with it,
## which starts at byte `at`.
def by_name[T: Deserializable](raw: PackReader, layout: bytes, at: int) -> T fails ParseError:
    mut src = PackByName(_raw=raw, _layout=layout, _layout_at=at)
    src._read_layout()?
    value = src.value[T]()?
    if src._raw._at != len(src._raw._data): fail src._raw._fail("there's more after the value")
    problem = src._raw._ids.problem()
    if problem != "": fail ParseError(message=problem, line=0, column=0)
    return value

def read_value[T: Deserializable](ref src: PackReader) -> T fails ParseError:
    value = T.deserialize(ref src)?
    if src._at != len(src._data): fail src._fail("there's more after the value")
    problem = src._ids.problem()
    if problem != "": fail ParseError(message=problem if src._explain else "", line=0, column=0)
    return value

## The bits a varint takes, 7 at a time, with the top 7 cleared after an arithmetic shift so it
## goes down as an unsigned number would.
LOW_57 = 144115188075855871

## The top bit of an int cleared, for a shift by 1 that goes down as an unsigned number would.
LOW_63 = 9223372036854775807

## Writes what a value's `serialize` gives it as bytes.
export struct PackWriter:
    ## What's written so far, in a builder with room to grow.
    _out = bytes_builder()
    _exact = False
    ## Where each `Id` is in its `Table`, by the name of its type and then its `id_key` and tag,
    ## and each `Table`'s tag, once what's written has been gone through. Until then an `Id` asks
    ## for them.
    _tables = dict[str, dict[(int, int), int]]()
    _tags = dict[str, int]()
    _found = False
    _wants_tables = False
    ## Whether what's being written is in an optional, and where its byte that says it's there is,
    ## for an `Id` that's saved as missing.
    _optional = False
    _some_at = 0

    ## The bytes written, at their exact size, which is all anything but this writer sees of them.
    def _done(self) -> bytes:
        return self._out[0:len(self._out)]

    ## The header: `FPK2` and the shape's number, then the layout. With no layout, as when the
    ## kit's `pack.lock` has it, it's `FPK1` and the number alone, as before layouts.
    def _header(ref self, shape: int, layout: str):
        # `FPK2`, or `FPKX` for `Table`s slot for slot, and `FPK1` and `FPKE` with no layout.
        mut mode = 88 if self._exact else 50
        if layout == "":
            mode = 69 if self._exact else 49
        for b in [70, 80, 75, mode]:
            bytes_push(ref self._out, b)
        self._word(shape)
        if layout != "":
            self.text(layout)

    ## A whole word, low byte first.
    def _word(ref self, bits: int):
        bytes_push_word(ref self._out, bits)

    ## A number as unsigned, 7 bits a byte, low first, with the top bit of each saying more come.
    def _varint(ref self, n: int):
        mut rest = n
        while rest < 0 or rest >= 128:
            bytes_push(ref self._out, (rest & 127) | 128)
            rest = (rest >> 7) & LOW_57
        bytes_push(ref self._out, rest)

    def int(ref self, value: int):
        # Zigzag: small numbers either side of 0 take one byte.
        self._varint((value << 1) ^ (value >> 63))

    def float(ref self, value: float):
        self._word(float_bits(value))

    def bool(ref self, value: bool):
        bytes_push(ref self._out, 1 if value else 0)

    def text(ref self, value: str):
        self._varint(text_size(value))
        bytes_push_text(ref self._out, value)

    def bytes(ref self, value: bytes):
        self._varint(len(value))
        bytes_push_bytes(ref self._out, value)

    def none(ref self):
        bytes_push(ref self._out, 0)

    def some[T: Serializable](ref self, x: T):
        self._some_at = len(self._out)
        bytes_push(ref self._out, 1)
        self._optional = True
        x.serialize(ref self)
        self._optional = False

    def value[T: Serializable](ref self, x: T):
        x.serialize(ref self)

    def sequence[T: Serializable](ref self, items: list[T]):
        self._optional = False
        self._varint(len(items))
        for item in items:
            item.serialize(ref self)

    def map[K: Serializable, V: Serializable](ref self, pairs: list[(K, V)]):
        self._optional = False
        self._varint(len(pairs))
        for key, value in pairs:
            key.serialize(ref self)
            value.serialize(ref self)

    def record(ref self, name: str, count: int):
        self._optional = False

    def field[T: Serializable](ref self, name: str, x: T):
        x.serialize(ref self)

    def renamed[T: Serializable](ref self, name: str, x: T):
        x.serialize(ref self)

    def end(ref self):
        pass

    ## A tuple's items go one after another, with nothing to say how many: its type says.
    def items(ref self, name: str, count: int):
        self._optional = False

    def item[T: Serializable](ref self, x: T):
        x.serialize(ref self)

    def end_items(ref self):
        pass

    def enum_case(ref self, name: str, case_name: str, at: int):
        self._varint(at)

    def case_record(ref self, name: str, case_name: str, at: int, count: int):
        self._optional = False
        self._varint(at)

    def member(ref self, name: str, at: int):
        self._optional = False
        self._varint(at)

    def end_member(ref self):
        pass

    def table[T: Serializable](ref self, kind: str, tag: int, ids: list[Id[T]], items: list[T]):
        self.sequence(items)

    def exact(self) -> bool:
        return self._exact

    def slots[T: Serializable](ref self, kind: str, tag: int, slots: list[int], items: list[T]):
        self.sequence(slots)
        self.sequence(items)

    def id(ref self, kind: str, key: int, tag: int):
        optional = self._optional
        self._optional = False
        if not self._found:
            self._wants_tables = True
            return
        if self._exact:
            if tag == (self._tags.get(kind) else 0):
                self.int(key >> 32)
                self.int(key & 4294967295)
                return
        else:
            positions = self._tables.get(kind) else dict[(int, int), int]()
            position = positions.get((key, tag)) else -1
            if position >= 0:
                self.int(position)
                return
        # Going through it found nothing wrong, so it's optional: it's saved as missing.
        if optional:
            bytes_set(ref self._out, self._some_at, 0)

## Reads bytes `PackWriter` wrote, for a value's `deserialize`.
export struct PackReader:
    _data: bytes
    _at = 0
    _depth = 0
    _most_deep = 64
    _longest = 16_000_000
    ## How many more items this load may read.
    _items_left = 16_000_000
    ## How many items that took no bytes it may read, and how many it has.
    _most_empty = 65536
    _empty_read = 0
    ## The next field of each struct being read, innermost last, and the one just read.
    _next = list[int]()
    _field = 0
    _exact = False
    ## Each `Id` and `Table` read, checked once everything has been.
    _ids = IdsSeen(_whole="the data")
    ## The tag each `Table` of a type gets, new for each load.
    _tags = dict[str, int]()
    ## Whether to keep track of where it is, for a message, and where.
    _explain = False
    _path = list[str]()
    ## Where the layout the data was saved with starts and ends, in a version that has one.
    _layout_at = 0
    _layout_end = 0
    ## The layout `pack.lock` has for data written without one.
    _locked = bytes([])

    def _fail(self, message: str) -> ParseError:
        return self._fail_at(self._at, message)

    ## The error for what starts at byte `at`.
    def _fail_at(self, at: int, message: str) -> ParseError:
        return ParseError(message=f"{message}, at byte {at}", line=0, column=0)

    ## Reads the header, and gives whether the data was saved from a type of the same shape, to
    ## read in order. One saved from another shape is read by its layout's names. Data from the
    ## first version, `FPK1`, has no layout, so it loads only into the same shape.
    def _header(ref self, shape: int, name: str) -> bool fails ParseError:
        self._items_left = self._longest
        if len(self._data) < 12: fail self._fail("these aren't bytes `std.pack` wrote")
        for at, b in enumerate([70, 80, 75]):
            if self._data[at] != b: fail self._fail("these aren't bytes `std.pack` wrote")
        mode = self._data[3]
        # `1` and `E` have no layout; `2` and `X` do. `E` and `X` hold `Table`s slot for slot.
        if mode != 49 and mode != 69 and mode != 50 and mode != 88:
            fail self._fail("these aren't bytes `std.pack` wrote")
        self._exact = mode == 69 or mode == 88
        self._at = 4
        saved = self._word()?
        same = saved == shape
        if mode == 50 or mode == 88:
            # The layout is held to what the data holds, not to the limit on one text: it's read
            # only for data from another shape, a word at a time, as deep as `Limits.depth` allows.
            n = self._varint()?
            if n < 0 or n > len(self._data) - self._at: fail self._fail("the data ends too soon")
            self._layout_at = self._at
            self._layout_end = self._at + n
            self._at += n
            return same
        if not same:
            # Written with no layout, it's read by the one the kit's `pack.lock` has for it.
            self._locked = locked_layout(saved)
            if len(self._locked) > 0: return False
            self._at = 4
            fail self._fail(f"this was packed from a different `{name}`")
        return True

    def _byte(ref self) -> int fails ParseError:
        if self._at >= len(self._data): fail self._fail("the data ends too soon")
        b = self._data[self._at]
        self._at += 1
        return b

    def _word(ref self) -> int fails ParseError:
        if self._at + 8 > len(self._data): fail self._fail("the data ends too soon")
        mut bits = 0
        for at in range(8):
            bits = bits | (self._data[self._at + at] << (8 * at))
        self._at += 8
        return bits

    def _varint(ref self) -> int fails ParseError:
        # Most take one byte, read here with no call.
        at = self._at
        if at < len(self._data):
            b = self._data[at]
            if b < 128:
                self._at = at + 1
                return b
        first = self._byte()?
        mut n = first & 127
        mut shift = 7
        while True:
            b = self._byte()?
            if shift == 63 and b > 1: fail self._fail("a number is too long")
            n = n | ((b & 127) << shift)
            if b < 128: return n
            shift += 7
            if shift > 63: fail self._fail("a number is too long")
        return n

    ## A count of what follows, which may be no more than the limit.
    def _length(ref self) -> int fails ParseError:
        start = self._at
        # Most are under 128 and take one byte, read here with no call.
        if start < len(self._data):
            b = self._data[start]
            if b < 128 and b <= self._longest:
                self._at = start + 1
                return b
        n = self._varint()?
        if n < 0 or n > self._longest:
            fail self._fail_at(start, f"a length is over the limit of {self._longest}")
        return n

    ## The next `n` bytes, which have to be there.
    def _run(ref self) -> bytes fails ParseError:
        n = self._length()?
        if n > len(self._data) - self._at: fail self._fail("the data ends too soon")
        part = self._data[self._at:self._at + n]
        self._at += n
        return part

    def _deeper(ref self) fails ParseError:
        self._depth += 1
        if self._depth > self._most_deep:
            fail self._fail(f"it nests deeper than the limit of {self._most_deep}")

    ## Counts an item that took no bytes against the limit on those.
    def _took_nothing(ref self) fails ParseError:
        self._empty_read += 1
        if self._empty_read > self._most_empty:
            fail self._fail(
                f"it holds more than the limit of {self._most_empty} items that take no bytes",
            )

    ## Counts `n` items against the limit on items, before any is read.
    def _items(ref self, n: int) fails ParseError:
        self._items_left -= n
        if self._items_left < 0:
            fail self._fail(f"it holds more than the limit of {self._longest} items")

    def int(ref self) -> int fails ParseError:
        z = self._varint()?
        return ((z >> 1) & LOW_63) ^ (0 - (z & 1))

    def float(ref self) -> float fails ParseError:
        return float_of_bits(self._word()?)

    def bool(ref self) -> bool fails ParseError:
        b = self._byte()?
        if b > 1: fail self._fail_at(self._at - 1, "a bool should be 0 or 1")
        return b == 1

    def text(ref self) -> str fails ParseError:
        start = self._at
        n = self._length()?
        if n > len(self._data) - self._at: fail self._fail("the data ends too soon")
        # Made straight from the bytes, which bytes that aren't UTF-8 never come out empty from.
        text = bytes_text(self._data, self._at, self._at + n)
        if n > 0 and text_size(text) == 0: fail self._fail_at(start, "a text isn't UTF-8")
        self._at += n
        return text

    def bytes(ref self) -> bytes fails ParseError:
        return self._run()?

    def none(ref self) -> bool fails ParseError:
        b = self._byte()?
        if b > 1: fail self._fail_at(self._at - 1, "an optional should start with 0 or 1")
        return b == 0

    def value[T: Deserializable](ref self) -> T fails ParseError:
        return T.deserialize(ref self)?

    def sequence[T: Deserializable](ref self) -> list[T] fails ParseError:
        n = self._length()?
        self._items(n)?
        self._deeper()?
        mut found = list[T]()
        for at in range(n):
            if self._explain:
                self._path.append(f"[{at}]")
            before = self._at
            found.append(T.deserialize(ref self)?)
            if self._at == before:
                self._took_nothing()?
            if self._explain:
                _ = self._path.pop()
        self._depth -= 1
        return found

    def map[K: Deserializable, V: Deserializable](ref self) -> list[(K, V)] fails ParseError:
        n = self._length()?
        self._items(n)?
        self._deeper()?
        mut found = list[(K, V)]()
        for at in range(n):
            if self._explain:
                self._path.append(f"[{at}]")
            before = self._at
            key = K.deserialize(ref self)?
            value = V.deserialize(ref self)?
            found.append((key, value))
            if self._at == before:
                self._took_nothing()?
            if self._explain:
                _ = self._path.pop()
        self._depth -= 1
        return found

    def record(ref self, name: str) fails ParseError:
        self._deeper()?
        self._next.append(0)
        if self._explain:
            self._path.append("")

    def next_field(ref self, fields: list[(str, str)]) -> bool fails ParseError:
        at = self._next[len(self._next) - 1]
        # Fields that aren't saved come last, with no name in the text.
        if at < len(fields) and fields[at][0] != "":
            self._next[len(self._next) - 1] = at + 1
            self._field = at
            if self._explain:
                self._path[len(self._path) - 1] = fields[at][0]
            return True
        _ = self._next.pop()
        self._depth -= 1
        if self._explain:
            _ = self._path.pop()
        return False

    ## Where the reader is, as messages say it.
    def _where(self) -> str:
        mut out = ""
        for part in self._path:
            if out != "" and text_byte(part, 0) != 91:
                out += "."
            out += part
        return "the data" if out == "" else f"`{out}`"

    def field_at(self) -> int:
        return self._field

    def missing(self, name: str) -> ParseError:
        return self._fail(f"`{name}` is missing")

    def rule(self, message: str) -> ParseError:
        return self._fail(message)

    def at_item(self, at: int, message: str) -> ParseError:
        return self._fail(f"item {at} {message}")

    def here(self, message: str) -> ParseError:
        return self._fail(f"{self._where()} {message}")

    def saw_id(ref self, kind: str, position: int):
        self._ids.id(kind, self._where() if self._explain else "", position)

    def saw_table(ref self, kind: str, count: int):
        self._ids.table(kind, self._where() if self._explain else "", count)

    def tag(ref self, kind: str) -> int:
        found = self._tags.get(kind) else 0
        if found > 0: return found
        made = new_tag()
        self._tags[kind] = made
        return made

    def none_next(ref self) -> bool:
        return False

    def ordered(ref self, name: str) -> bool fails ParseError:
        # Read again for a message, it goes through `record`, which keeps track of names.
        if self._explain: return False
        self._deeper()?
        return True

    def end_ordered(ref self):
        self._depth -= 1

    def map_count(ref self) -> int fails ParseError:
        # Read again for a message, it goes through `map`, which keeps track of where it is.
        if self._explain: return -1
        n = self._length()?
        self._items(n)?
        self._deeper()?
        return n

    def items(ref self, name: str, count: int) fails ParseError:
        self._deeper()?

    def item[T: Deserializable](ref self) -> T fails ParseError:
        return T.deserialize(ref self)?

    def end_items(ref self) fails ParseError:
        self._depth -= 1

    def end_map(ref self):
        self._depth -= 1

    def exact(self) -> bool:
        return self._exact

    def enum_case(ref self, name: str, cases: list[(str, bool)]) -> int fails ParseError:
        start = self._at
        at = self._varint()?
        if at < 0 or at >= len(cases): fail self._fail_at(start, f"`{name}` has no case {at}")
        return at

    def end_case(ref self) fails ParseError:
        pass

    def member(ref self, names: list[str]) -> int fails ParseError:
        start = self._at
        at = self._varint()?
        if at < 0 or at >= len(names):
            union = " | ".join(names)
            fail self._fail_at(start, f"`{union}` has no member {at}")
        self._deeper()?
        return at

    def end_member(ref self) fails ParseError:
        self._depth -= 1

## The letters a layout writes what a value is with: see `layout` in `std.intrinsics`.
INT = 105
FLOAT = 102
BOOL = 98
TEXT = 115
BYTES = 121
LIST = 108
MAP = 109
OPTIONAL = 111
TUPLE = 116
STRUCT = 83
ENUM = 69
UNION = 117
SAME = 114
TABLE = 84
ID = 73
OWN = 79
UNKNOWN = 63
## Not written: a case of an enum, with its fields, as the layout is read.
CASE = 99

## Reads bytes saved from another shape of a type, like the one an earlier version of a program
## had: each value as the layout saved with it says it was written, and each field by its name.
struct PackByName:
    _raw: PackReader
    ## The layout the data was saved with, and where it was.
    _layout: bytes
    _layout_at = 0
    ## What each value in the layout is, as the letter it's written with, what it holds, in order,
    ## and their names: a struct's fields, an enum's cases and a union's members.
    _kinds = list[int]()
    _kids = list[list[int]]()
    _names = list[list[str]]()
    ## Where the layout is being read.
    _at = 0
    ## What the next value read was saved as.
    _expect = 0
    ## Each struct, case or tuple being read, innermost last, and the next of what it holds.
    _open = list[int]()
    _next = list[int]()
    ## How many of each struct's fields the data has had so far.
    _matched = list[int]()
    _field = 0
    ## The case just read, whose fields come next.
    _case = -1
    ## Whether a `Table` saved slot for slot has had its slots read, so its items come next.
    _slots_read = False
    _path = list[str]()

    def _bad_layout(self) -> ParseError:
        return self._raw._fail_at(
            self._layout_at,
            "the layout saved with the data isn't one `std.pack` writes",
        )

    ## The next word of the layout.
    def _word(ref self) -> str fails ParseError:
        start = self._at
        end = len(self._layout)
        mut at = start
        while at < end and self._layout[at] != 32:
            at += 1
        word = bytes_text(self._layout, start, at)
        if text_size(word) == 0: fail self._bad_layout()
        self._at = at + 1
        return word

    ## The next word of the layout, as a count.
    def _count(ref self) -> int fails ParseError:
        word = self._word()?
        mut n = 0
        for at in range(text_size(word)):
            digit = text_byte(word, at) - 48
            if digit < 0 or digit > 9 or n > 100000000: fail self._bad_layout()
            n = n * 10 + digit
        return n

    def _read_layout(ref self) fails ParseError:
        # The first is an int, which the slots of a `Table` saved slot for slot are read as.
        self._made(INT)
        self._at = 0
        mut open = list[int]()
        self._expect = self._node(ref open, 0)?
        if self._at < len(self._layout): fail self._bad_layout()

    def _made(ref self, kind: int) -> int:
        self._kinds.append(kind)
        self._kids.append(list[int]())
        self._names.append(list[str]())
        return len(self._kinds) - 1

    ## Reads a value's layout, and gives where it is. `open` holds the structs and enums it's in,
    ## outermost first, which a type inside itself names by where they are.
    def _node(ref self, ref open: list[int], depth: int) -> int fails ParseError:
        if depth > self._raw._most_deep: fail self._bad_layout()
        word = self._word()?
        if text_size(word) != 1: fail self._bad_layout()
        kind = text_byte(word, 0)
        if kind == SAME:
            at = self._count()?
            if at >= len(open): fail self._bad_layout()
            return open[at]
        node = self._made(kind)
        if kind == LIST or kind == OPTIONAL or kind == TABLE:
            self._kid(node, "", ref open, depth)?
        elif kind == MAP:
            self._kid(node, "", ref open, depth)?
            self._kid(node, "", ref open, depth)?
        elif kind == TUPLE:
            for _ in range(self._count()?):
                self._kid(node, "", ref open, depth)?
        elif kind == STRUCT or kind == UNION:
            n = self._count()?
            if kind == STRUCT:
                open.append(node)
            for _ in range(n):
                name = self._word()?
                self._kid(node, name, ref open, depth)?
            if kind == STRUCT:
                _ = open.pop()
        elif kind == ENUM:
            n = self._count()?
            open.append(node)
            for _ in range(n):
                name = self._word()?
                case_name = self._made(CASE)
                for _ in range(self._count()?):
                    field = self._word()?
                    self._kid(case_name, field, ref open, depth + 1)?
                self._kids[node].append(case_name)
                self._names[node].append(name)
            _ = open.pop()
        elif kind == OWN:
            self._names[node].append(self._word()?)
        elif (
            kind != INT
            and kind != FLOAT
            and kind != BOOL
            and kind != TEXT
            and kind != BYTES
            and kind != ID
            and kind != UNKNOWN
        ):
            fail self._bad_layout()
        return node

    def _kid(ref self, node: int, name: str, ref open: list[int], depth: int) fails ParseError:
        kid = self._node(ref open, depth + 1)?
        self._kids[node].append(kid)
        self._names[node].append(name)

    def _kind(self) -> int:
        return self._kinds[self._expect]

    ## What a value was saved as, in words.
    def _saved_as(self, node: int) -> str:
        kind = self._kinds[node]
        if kind == INT or kind == ID: return "an int"
        if kind == FLOAT: return "a float"
        if kind == BOOL: return "a bool"
        if kind == TEXT: return "text"
        if kind == BYTES: return "bytes"
        if kind == LIST or kind == TABLE: return "a list"
        if kind == MAP: return "a dict"
        if kind == OPTIONAL: return "an optional"
        if kind == TUPLE: return "a tuple"
        if kind == STRUCT: return "a struct"
        if kind == ENUM: return "an enum"
        if kind == UNION: return "a union"
        if kind == OWN: return f"a `{self._names[node][0]}`"
        return "something that can't be loaded"

    def _was(self, wanted: str) -> ParseError:
        return self._raw._fail(
            f"{self._where()} was saved as {self._saved_as(self._expect)}, not {wanted}",
        )

    ## Where the reader is, as messages say it.
    def _where(self) -> str:
        mut out = ""
        for part in self._path:
            if out != "" and text_byte(part, 0) != 91:
                out += "."
            out += part
        return "the data" if out == "" else f"`{out}`"

    ## Passes over a value the type it's loaded into doesn't have, as the layout says it was saved.
    def _skip(ref self, node: int) fails ParseError:
        self._raw._deeper()?
        kind = self._kinds[node]
        if kind == INT:
            _ = self._raw._varint()?
        elif kind == FLOAT:
            _ = self._raw._word()?
        elif kind == BOOL:
            _ = self._raw.bool()?
        elif kind == TEXT or kind == BYTES:
            _ = self._raw._run()?
        elif kind == LIST or kind == MAP:
            n = self._raw._length()?
            self._raw._items(n)?
            for _ in range(n):
                for kid in self._kids[node]:
                    self._skip(kid)?
        elif kind == OPTIONAL:
            if not self._raw.none()?:
                self._skip(self._kids[node][0])?
        elif kind == TUPLE or kind == STRUCT or kind == CASE:
            for kid in self._kids[node]:
                self._skip(kid)?
        elif kind == ENUM or kind == UNION:
            start = self._raw._at
            at = self._raw._varint()?
            if at < 0 or at >= len(self._kids[node]):
                fail self._raw._fail_at(start, f"{self._where()} has no case {at}")
            self._skip(self._kids[node][at])?
        elif kind == TABLE:
            if self._raw._exact:
                self._skip_list(0)?
            self._skip_list(self._kids[node][0])?
        elif kind == ID:
            _ = self._raw._varint()?
            if self._raw._exact:
                _ = self._raw._varint()?
        else:
            what = self._saved_as(node)
            fail self._raw._fail(
                f"{self._where()} isn't in the type now, and holds {what}, which saves itself its own way, so where it ends can't be found",
            )
        self._raw._depth -= 1

    def _skip_list(ref self, item: int) fails ParseError:
        n = self._raw._length()?
        self._raw._items(n)?
        for _ in range(n):
            self._skip(item)?

    def int(ref self) -> int fails ParseError:
        kind = self._kind()
        if kind != INT and kind != ID: fail self._was("an int")
        return self._raw.int()?

    def float(ref self) -> float fails ParseError:
        kind = self._kind()
        # An int field that's a float now reads as one.
        if kind == INT: return float(self._raw.int()?)
        if kind != FLOAT: fail self._was("a float")
        return self._raw.float()?

    def bool(ref self) -> bool fails ParseError:
        if self._kind() != BOOL: fail self._was("a bool")
        return self._raw.bool()?

    def text(ref self) -> str fails ParseError:
        if self._kind() != TEXT: fail self._was("text")
        return self._raw.text()?

    def bytes(ref self) -> bytes fails ParseError:
        if self._kind() != BYTES: fail self._was("bytes")
        return self._raw.bytes()?

    ## Whether an optional value is missing. A value that wasn't optional when it was saved is
    ## there; one that was and is there is read as what it holds.
    def none(ref self) -> bool fails ParseError:
        if self._kind() != OPTIONAL: return False
        if self._raw.none()?: return True
        self._expect = self._kids[self._expect][0]
        return False

    ## A field that was optional when it was saved may be missing, and takes its default.
    def none_next(ref self) -> bool:
        return self._kind() == OPTIONAL

    def value[T: Deserializable](ref self) -> T fails ParseError:
        # A type that saves itself its own way reads it its own way, in order.
        if self._kind() == OWN: return T.deserialize(ref self._raw)?
        return T.deserialize(ref self)?

    def sequence[T: Deserializable](ref self) -> list[T] fails ParseError:
        node = self._expect
        kind = self._kinds[node]
        # Slot for slot, a `Table`'s slots come first, as ints, then its items.
        mut item = 0
        if kind == LIST:
            item = self._kids[node][0]
        elif kind == TABLE and self._raw._exact and not self._slots_read:
            self._slots_read = True
        elif kind == TABLE:
            self._slots_read = False
            item = self._kids[node][0]
        else:
            fail self._was("a list")
        n = self._raw._length()?
        self._raw._items(n)?
        self._raw._deeper()?
        mut found = list[T]()
        for at in range(n):
            self._path.append(f"[{at}]")
            self._expect = item
            before = self._raw._at
            found.append(self.value[T]()?)
            if self._raw._at == before:
                self._raw._took_nothing()?
            _ = self._path.pop()
        self._raw._depth -= 1
        self._expect = node
        return found

    def map[K: Deserializable, V: Deserializable](ref self) -> list[(K, V)] fails ParseError:
        node = self._expect
        if self._kinds[node] != MAP: fail self._was("a dict")
        n = self._raw._length()?
        self._raw._items(n)?
        self._raw._deeper()?
        mut found = list[(K, V)]()
        for at in range(n):
            self._path.append(f"[{at}]")
            self._expect = self._kids[node][0]
            before = self._raw._at
            key = self.value[K]()?
            self._expect = self._kids[node][1]
            value = self.value[V]()?
            found.append((key, value))
            if self._raw._at == before:
                self._raw._took_nothing()?
            _ = self._path.pop()
        self._raw._depth -= 1
        self._expect = node
        return found

    def map_count(ref self) -> int fails ParseError:
        return -1

    def end_map(ref self):
        pass

    def record(ref self, name: str) fails ParseError:
        mut node = self._expect
        if self._case >= 0:
            node = self._case
            self._case = -1
        elif self._kinds[node] != STRUCT:
            fail self._was(f"a `{name}`")
        self._raw._deeper()?
        self._open.append(node)
        self._next.append(0)
        self._matched.append(0)
        self._path.append("")

    ## The next field the data has that the type has too, by its name. Those it doesn't have any
    ## more are passed over.
    def next_field(ref self, fields: list[(str, str)]) -> bool fails ParseError:
        top = len(self._open) - 1
        node = self._open[top]
        while self._next[top] < len(self._kids[node]):
            at = self._next[top]
            self._next[top] = at + 1
            name = self._names[node][at]
            self._path[len(self._path) - 1] = name
            for found, field in enumerate(fields):
                if field[0] != "" and field[0] == name:
                    self._field = found
                    self._expect = self._kids[node][at]
                    self._matched[top] += 1
                    return True
            self._skip(self._kids[node][at])?
        # The fields the data didn't have are made from their defaults, so they count too.
        self._raw._items(len(fields) - self._matched[top])?
        _ = self._open.pop()
        _ = self._next.pop()
        _ = self._matched.pop()
        _ = self._path.pop()
        self._raw._depth -= 1
        return False

    def field_at(self) -> int:
        return self._field

    def missing(self, name: str) -> ParseError:
        return self._raw._fail(f"`{name}` isn't in the data, and has no default")

    def rule(self, message: str) -> ParseError:
        return self._raw._fail(message)

    def at_item(self, at: int, message: str) -> ParseError:
        return self._raw._fail(f"item {at} {message}")

    def here(self, message: str) -> ParseError:
        return self._raw._fail(f"{self._where()} {message}")

    def saw_id(ref self, kind: str, position: int):
        self._raw._ids.id(kind, self._where(), position)

    def saw_table(ref self, kind: str, count: int):
        self._raw._ids.table(kind, self._where(), count)

    def tag(ref self, kind: str) -> int:
        return self._raw.tag(kind)

    ## Fields are read by name, never in order.
    def ordered(ref self, name: str) -> bool fails ParseError:
        return False

    def end_ordered(ref self):
        pass

    def items(ref self, name: str, count: int) fails ParseError:
        node = self._expect
        if self._kinds[node] != TUPLE: fail self._was("a tuple")
        saved = len(self._kids[node])
        if saved != count:
            fail self._raw._fail(
                f"{self._where()} was saved as a tuple of {saved} items, not {count}",
            )
        self._raw._deeper()?
        self._open.append(node)
        self._next.append(0)
        self._matched.append(0)

    def item[T: Deserializable](ref self) -> T fails ParseError:
        top = len(self._open) - 1
        at = self._next[top]
        self._next[top] = at + 1
        self._expect = self._kids[self._open[top]][at]
        return self.value[T]()?

    def end_items(ref self) fails ParseError:
        _ = self._open.pop()
        _ = self._next.pop()
        _ = self._matched.pop()
        self._raw._depth -= 1

    def exact(self) -> bool:
        return self._raw._exact

    ## A case by its name, which may be at another place among the cases now.
    def enum_case(ref self, name: str, cases: list[(str, bool)]) -> int fails ParseError:
        node = self._expect
        if self._kinds[node] != ENUM: fail self._was(f"a `{name}`")
        start = self._raw._at
        at = self._raw._varint()?
        if at < 0 or at >= len(self._kids[node]):
            fail self._raw._fail_at(start, f"`{name}` has no case {at}")
        saved = self._names[node][at]
        case_name = self._kids[node][at]
        for found, each in enumerate(cases):
            if each[0] == saved:
                if each[1]:
                    self._case = case_name
                else:
                    # It has no fields now: those it was saved with are passed over.
                    for kid in self._kids[case_name]:
                        self._skip(kid)?
                return found
        fail self._raw._fail_at(
            start,
            f"{self._where()} was saved as `{name}.{saved}`, a case `{name}` doesn't have now",
        )

    def end_case(ref self) fails ParseError:
        pass

    ## A union's member by its type's name, which may be at another place among the members now.
    def member(ref self, names: list[str]) -> int fails ParseError:
        node = self._expect
        union = " | ".join(names)
        if self._kinds[node] != UNION: fail self._was(f"a `{union}`")
        start = self._raw._at
        at = self._raw._varint()?
        if at < 0 or at >= len(self._kids[node]):
            fail self._raw._fail_at(start, f"`{union}` has no member {at}")
        saved = self._names[node][at]
        for found, name in enumerate(names):
            if name == saved:
                self._raw._deeper()?
                self._expect = self._kids[node][at]
                return found
        fail self._raw._fail_at(
            start,
            f"{self._where()} was saved as a `{saved}`, which isn't one of `{union}` now",
        )

    def end_member(ref self) fails ParseError:
        self._raw._depth -= 1

## Writes `value` to `out`, any `Writer` from `std.io`, as `dumps` gives it.
export def dump[T: Serializable, W: Writer](value: T, ref out: W, exact = False) fails IoError:
    out.write(dumps(value, exact=exact))?

## Reads what's left in `src`, any `Reader` from `std.io`, as a `T`, as `loads` does.
export def load[T: Deserializable, R: Reader](
    ref src: R,
    limits: Limits? = None,
) -> T fails ParseError | IoError:
    data = read_all(ref src)?
    return loads[T](data, limits=limits)?
