## The n-body simulation from the Benchmarks Game: five planets, floats in structs, a tight
## double loop.

from std.math import sqrt

struct Body:
    x: float
    y: float
    z: float
    vx: float
    vy: float
    vz: float
    mass: float

def energy(bodies: list[Body]) -> float:
    mut total = 0.0
    for i in range(bodies.len()):
        a = bodies[i]
        total += 0.5 * a.mass * (a.vx * a.vx + a.vy * a.vy + a.vz * a.vz)
        for j in range(i + 1, bodies.len()):
            b = bodies[j]
            dx = a.x - b.x
            dy = a.y - b.y
            dz = a.z - b.z
            total -= a.mass * b.mass / sqrt(dx * dx + dy * dy + dz * dz)
    total

def advance(mut bodies: list[Body], dt: float):
    count = bodies.len()
    for i in range(count):
        for j in range(i + 1, count):
            dx = bodies[i].x - bodies[j].x
            dy = bodies[i].y - bodies[j].y
            dz = bodies[i].z - bodies[j].z
            squared = dx * dx + dy * dy + dz * dz
            magnitude = dt / (squared * sqrt(squared))
            mass_i = bodies[i].mass
            mass_j = bodies[j].mass
            bodies[i].vx -= dx * mass_j * magnitude
            bodies[i].vy -= dy * mass_j * magnitude
            bodies[i].vz -= dz * mass_j * magnitude
            bodies[j].vx += dx * mass_i * magnitude
            bodies[j].vy += dy * mass_i * magnitude
            bodies[j].vz += dz * mass_i * magnitude
    for i in range(count):
        bodies[i].x += dt * bodies[i].vx
        bodies[i].y += dt * bodies[i].vy
        bodies[i].z += dt * bodies[i].vz

def main(stdout: Stdout):
    pi = 3.141592653589793
    solar_mass = 4.0 * pi * pi
    days = 365.24
    mut bodies = [
        Body(x=0.0, y=0.0, z=0.0, vx=0.0, vy=0.0, vz=0.0, mass=solar_mass),
        Body(
            x=4.84143144246472090e+00,
            y=-1.16032004402742839e+00,
            z=-1.03622044471123109e-01,
            vx=1.66007664274403694e-03 * days,
            vy=7.69901118419740425e-03 * days,
            vz=-6.90460016972063023e-05 * days,
            mass=9.54791938424326609e-04 * solar_mass,
        ),
        Body(
            x=8.34336671824457987e+00,
            y=4.12479856412430479e+00,
            z=-4.03523417114321381e-01,
            vx=-2.76742510726862411e-03 * days,
            vy=4.99852801234917238e-03 * days,
            vz=2.30417297573763929e-05 * days,
            mass=2.85885980666130812e-04 * solar_mass,
        ),
        Body(
            x=1.28943695621391310e+01,
            y=-1.51111514016986312e+01,
            z=-2.23307578892655734e-01,
            vx=2.96460137564761618e-03 * days,
            vy=2.37847173959480950e-03 * days,
            vz=-2.96589568540237556e-05 * days,
            mass=4.36624404335156298e-05 * solar_mass,
        ),
        Body(
            x=1.53796971148509165e+01,
            y=-2.59193146099879641e+01,
            z=1.79258772950371181e-01,
            vx=2.68067772490389322e-03 * days,
            vy=1.62824170038242295e-03 * days,
            vz=-9.51592254519715870e-05 * days,
            mass=5.15138902046611451e-05 * solar_mass,
        ),
    ]
    mut px = 0.0
    mut py = 0.0
    mut pz = 0.0
    for body in bodies:
        px += body.vx * body.mass
        py += body.vy * body.mass
        pz += body.vz * body.mass
    bodies[0].vx = -px / solar_mass
    bodies[0].vy = -py / solar_mass
    bodies[0].vz = -pz / solar_mass
    stdout.print(f"{energy(bodies):.9f}")
    for _ in range(200_000):
        advance(mut bodies, 0.01)
    stdout.print(f"{energy(bodies):.9f}")
