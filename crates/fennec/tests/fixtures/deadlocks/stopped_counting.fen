# A task is stopped while it's busy counting, and only then comes to a receive nobody sends to.
# Its launcher has been waiting at the block's end, with no time limit left, since the hard stop.
# Never a deadlock: the stopped task's receive ends at once. (From Fable 5.2's review.)
from std.concurrent import Channel, Crashed, channel

def counted(turns: int) -> int:
    mut total = 0
    for turn in range(turns):
        total = (total + turn * 7) % 1000003
    return total

def worker(numbers: Channel[int], stdout: Stdout):
    total = counted(turns=30000000)
    stdout.print("counted", total > 0)
    got = numbers.receive() else -1
    stdout.print("never said", got)

def main(stdout: Stdout) fails Crashed:
    with channel[int](size=1) as numbers:
        with launch(() => worker(numbers, stdout=stdout), stop_after=5ms)?:
            pass
    stdout.print("the block is over")
