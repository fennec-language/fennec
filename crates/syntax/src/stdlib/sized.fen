## The sized integers' functions written in Fennec: making one from a number or text that came
## from outside, which fails cleanly when it doesn't fit, where `u8(x)` stops the program; and
## arithmetic that wraps round or stops at the ends, for when that's what's meant.

extend i8:
    ## The `int` `x` as an i8, or an `InvalidValue` when it doesn't fit. Convert another size
    ## with `int(x)` first.
    def from(x: int) -> i8 fails InvalidValue:
        if x < -128 or x > 127:
            fail InvalidValue(message=f"{x} doesn't fit in i8, which holds -128 to 127")
        return i8(x)

    ## The i8 `text` writes, or an `InvalidValue` when it isn't a whole number or doesn't fit.
    def parse(text: str) -> i8 fails InvalidValue:
        return i8.from(int(text)?)?

    ## `self + other`, wrapping round past either end, as an i8's bits do.
    def wrapping_add(self, other: i8) -> i8:
        return i8((int(self) + int(other) + 128) % 256 - 128)

    ## `self - other`, wrapping round past either end, as an i8's bits do.
    def wrapping_sub(self, other: i8) -> i8:
        return i8((int(self) - int(other) + 128) % 256 - 128)

    ## `self * other`, wrapping round past either end, as an i8's bits do.
    def wrapping_mul(self, other: i8) -> i8:
        return i8((int(self) * int(other) + 128) % 256 - 128)

    ## `self + other`, or the nearest end of i8 when it's past one.
    def saturating_add(self, other: i8) -> i8:
        whole = int(self) + int(other)
        if whole < -128: return i8(-128)
        if whole > 127: return i8(127)
        return i8(whole)

    ## `self - other`, or the nearest end of i8 when it's past one.
    def saturating_sub(self, other: i8) -> i8:
        whole = int(self) - int(other)
        if whole < -128: return i8(-128)
        if whole > 127: return i8(127)
        return i8(whole)

    ## `self * other`, or the nearest end of i8 when it's past one.
    def saturating_mul(self, other: i8) -> i8:
        whole = int(self) * int(other)
        if whole < -128: return i8(-128)
        if whole > 127: return i8(127)
        return i8(whole)

