# A web backend shaped like the ones people write first, with its own scripted load in the same
# program: signing up and signing in, notes kept for each user, a JSON API and an HTML page.
#
# Each connection is a task of its own. A password is stretched with HMAC-SHA256 under a salt of
# its own before it's kept, and signing in gives a token signed with HMAC under the server's key,
# which every other request carries. Notes are kept in SQLite. The search page is HTML made from a
# template, with everything users wrote in it escaped.
#
# The load is a crowd of scripted clients. Each signs up, signs in, writes notes, lists them and
# searches them, and tries a few things it shouldn't. The summary is the same on any number of
# threads.
#
# Two things in `std.net` don't fit this yet, so the program speaks HTTP itself. `server.serve`
# can't be stopped from inside a program, so the server reads its requests in a loop over
# `parallel(server)` that ends when the program asks it to. And `net.get` and `net.post` hold
# their thread while they wait, which starves the server when clients in `parallel` rounds call
# it, so the clients write their requests over a connection of their own.

from std import html, json, sqlite
from std.concurrent import Crashed
from std.crypto import Secret, equal, hmac_sha256
from std.html import Html, HtmlError
from std.net import Connection, NetError, Request, Response, Server
from std.sql import SqlError
from std.sqlite import Database
from std.url import decode_query, encode_query, unquote

CLIENTS = 32
NOTES = 12
STRETCH = 1_000
TOKEN_LIFE = 3_600
MOST_BODY = 65_536
NAME_LETTERS = "abcdefghijklmnopqrstuvwxyz0123456789"
SEARCHES = ["fox", "<b>", "&", "river", "nothing like this"]
WORDS = [
    "fox",
    "den",
    "river",
    "<b>bold</b>",
    "fish & chips",
    "\"quoted\"",
    "it's",
    "<script>alert(1)</script>",
    "moss",
    "stone",
]

# What signing up and signing in send.
struct Credentials:
    name: str
    password: str

# A note, as it's sent and as it's listed.
struct Note:
    title: str
    body: str

# What signing in gives back.
struct Signed:
    token: str

# Who signed up, as signing up answers.
struct Account:
    name: str

# What a client is told went wrong.
struct Problem:
    error: str

# What the database keeps of a password.
struct Stored:
    salt: str
    hash: str

# What every request's task reaches: the database and the key tokens are signed with.
struct App:
    db: Database
    key: Secret[str]

# What the server saw go wrong with connections, shared by their tasks.
struct Stats:
    dropped = list[str]()

# HTTP/1.1 this program can't read, from either side.
error HttpError:
    reason: str

def seconds_now(clock: Clock) -> int:
    return clock.time().nanos // 1_000_000_000

# A password stretched under `salt`: HMAC-SHA256 again and again, so that each guess at it costs
# as much. std has no password hash yet, so this stands in for one.
def stretched(password: Secret[str], salt: str) -> str:
    mut digest = hmac_sha256(salt, password.expose_secret())
    for _ in range(STRETCH - 1):
        digest = hmac_sha256(password.expose_secret(), digest)
    return digest

# A token saying who signed in and until when, signed under the server's key.
def signed_token(key: Secret[str], name: str, expires: int) -> str:
    claim = f"{name}.{expires}"
    return f"{claim}.{hmac_sha256(key.expose_secret(), claim)}"

# Who a request's token says it's from, or `None` if the server didn't sign it or it's run out.
def signed_in(key: Secret[str], clock: Clock, request: Request) -> str?:
    header = request.headers.get("authorization") else return None
    parts = header.removeprefix("Bearer ").split(".")
    if len(parts) != 3: return None
    expires = int.parse(parts[1]) except InvalidValue(): return None
    if expires < seconds_now(clock): return None
    if not equal(hmac_sha256(key.expose_secret(), f"{parts[0]}.{parts[1]}"), parts[2]): return None
    return parts[0]

def good_name(name: str) -> bool:
    if len(name) < 3 or len(name) > 20: return False
    return all(letter in NAME_LETTERS for letter in name)

# An answer of JSON, as `json.dumps` wrote it.
def answer(status: int, text: str) -> Response:
    return Response(status=status, headers={"content-type": "application/json"}, body=text.encode())

def problem(status: int, error: str) -> Response:
    return answer(status, text=json.dumps(Problem(error=error)))

def sign_up(app: App, entropy: Entropy, request: Request) -> Response fails SqlError:
    wanted = json.loads[Credentials](request.text()) except why:
        return problem(400, error=why.message)
    if not good_name(wanted.name):
        return problem(400, error="a name is 3 to 20 lowercase letters and digits")
    if len(wanted.password) < 8: return problem(400, error="a password has at least 8 characters")
    salt = entropy.bytes(16).hex()
    hash = stretched(Secret.of(wanted.password), salt=salt)
    added = app.db.execute(
        t"insert into users (name, salt, hash) values ({wanted.name}, {salt}, {hash}) on conflict (name) do nothing",
    )?
    if added == 0: return problem(409, error=f"{wanted.name} is taken")
    return answer(201, text=json.dumps(Account(name=wanted.name)))

def sign_in(app: App, clock: Clock, request: Request) -> Response fails SqlError:
    given = json.loads[Credentials](request.text()) except why:
        return problem(400, error=why.message)
    found = app.db.query[Stored](t"select salt, hash from users where name = {given.name}")?
    # A name nobody has takes as long to refuse as a wrong password.
    kept = found[0] if len(found) > 0 else Stored(salt="nobody", hash="")
    tried = stretched(Secret.of(given.password), salt=kept.salt)
    if len(found) == 0 or not equal(tried, kept.hash):
        return problem(401, error="that name and password don't match")
    token = signed_token(app.key, name=given.name, expires=seconds_now(clock) + TOKEN_LIFE)
    return answer(200, text=json.dumps(Signed(token=token)))

def add_note(app: App, owner: str, request: Request) -> Response fails SqlError:
    note = json.loads[Note](request.text()) except why:
        return problem(400, error=why.message)
    if note.title == "": return problem(400, error="a note needs a title")
    _ = app.db.execute(
        t"insert into notes (owner, title, body) values ({owner}, {note.title}, {note.body})",
    )?
    return answer(201, text=json.dumps(note))

def notes_of(app: App, owner: str) -> Response fails SqlError:
    found = app.db.query[Note](t"select title, body from notes where owner = {owner} order by id")?
    return answer(200, text=json.dumps(found))

# The page of what a search found, with everything a user wrote in it escaped.
def results_page(owner: str, words: str, found: list[Note]) -> Html fails HtmlError:
    rows = [html.render(t"<li><b>{note.title}</b> {note.body}</li>")? for note in found]
    listed = html.join(rows)
    count = len(found)
    return html.render(
        t"<h1>{owner}'s notes with “{words}”</h1><p>{count} found</p><ul>{listed}</ul>",
    )?

# A page of the owner's notes that have the words asked for, in their title or body.
def search(app: App, owner: str, request: Request) -> Response fails SqlError | HtmlError:
    words = request.query.get("q") else ""
    found = app.db.query[Note](
        t"select title, body from notes where owner = {owner} and (instr(lower(title), lower({words})) > 0 or instr(lower(body), lower({words})) > 0) order by id",
    )?
    made = results_page(owner, words=words, found=found)?
    return Response(
        status=200,
        headers={"content-type": "text/html; charset=utf-8"},
        body=made.text().encode(),
    )

# Answers one request. A failure here is the server's, and its client gets a 500.
def respond(
    app: App,
    clock: Clock,
    entropy: Entropy,
    request: Request,
) -> Response fails SqlError | HtmlError:
    match request.path:
        case "/signup" if request.method == "POST":
            return sign_up(app, entropy, request)?
        case "/signin" if request.method == "POST":
            return sign_in(app, clock, request)?
        case _:
            pass
    owner = signed_in(app.key, clock, request) else return problem(401, error="sign in first")
    match request.path:
        case "/notes" if request.method == "POST":
            return add_note(app, owner, request)?
        case "/notes" if request.method == "GET":
            return notes_of(app, owner)?
        case "/search" if request.method == "GET":
            return search(app, owner, request)?
        case _:
            return problem(404, error="there's nothing here")

# The headers and the body that follow a request's or a response's first line.
def rest_of(conn: Connection) -> (dict[str, str], bytes) fails NetError | HttpError:
    mut headers = dict[str, str]()
    while True:
        header = conn.read_line()? else fail HttpError(reason="the headers didn't end")
        if header == "": break
        colon = header.find(":") else fail HttpError(reason="a header has no `:`")
        headers[header[:colon].strip().lower()] = header[colon + 1:].strip()
    length = int.parse(headers.get("content-length") else "0") except InvalidValue():
        fail HttpError(reason="its length isn't a number")
    if length < 0 or length > MOST_BODY: fail HttpError(reason="its body is too big")
    mut body = bytes([])
    while len(body) < length:
        more = conn.read(length - len(body))?
        if len(more) == 0: fail HttpError(reason="its body ended early")
        body = body + more
    return (headers, body)

# The next request on a connection, read as HTTP/1.1.
def request_from(conn: Connection) -> Request fails NetError | HttpError:
    line = conn.read_line()? else fail HttpError(reason="the client sent nothing")
    pieces = line.split(" ")
    if len(pieces) != 3 or pieces[2] != "HTTP/1.1":
        fail HttpError(reason="that isn't an HTTP/1.1 request line")
    headers, body = rest_of(conn)?
    target = pieces[1]
    question = target.find("?") else len(target)
    query = decode_query(target[question + 1:]) if question < len(target) else dict[str, str]()
    return Request(
        method=pieces[0],
        path=unquote(target[:question]),
        query=query,
        headers=headers,
        body=body,
    )

def reason(status: int) -> str:
    match status:
        case 200:
            return "OK"
        case 201:
            return "Created"
        case 204:
            return "No Content"
        case 400:
            return "Bad Request"
        case 401:
            return "Unauthorized"
        case 404:
            return "Not Found"
        case 409:
            return "Conflict"
        case _:
            return "Internal Server Error"

def written(conn: Connection, response: Response) fails NetError:
    mut head = f"HTTP/1.1 {response.status} {reason(response.status)}\r\n"
    for name, value in response.headers.items():
        head += f"{name}: {value}\r\n"
    head += f"content-length: {len(response.body)}\r\nconnection: close\r\n\r\n"
    conn.write(head)?
    conn.write(response.body)?

# Answers a connection's one request. Gives whether the program asked the server to stop.
def answered(
    conn: Connection,
    app: App,
    clock: Clock,
    entropy: Entropy,
    stop: Secret[str],
) -> bool fails NetError:
    request = request_from(conn) except why:
        case HttpError(reason):
            written(conn, problem(400, error=reason))?
            return False
        case _:
            fail why
    if request.path == "/stop":
        asked = Secret.of((request.headers.get("authorization") else "").removeprefix("Bearer "))
        if asked == stop:
            written(conn, Response(status=204))?
            return True
    made = respond(app, clock, entropy, request) except why:
        problem(500, error=f"{why}")
    written(conn, made)?
    return False

# Answers each connection's request, each in a task of its own, until the program asks it to stop.
def serving(
    server: Server,
    app: App,
    clock: Clock,
    entropy: Entropy,
    stop: Secret[str],
    stats: shared Stats,
):
    for conn in parallel(server):
        stopping = answered(conn, app, clock, entropy, stop) except why:
            lock stats as ref current:
                current.dropped.append(f"{why}")
            False
        if stopping: break

# What one client saw.
struct Visit:
    name: str
    statuses = dict[int, int]()
    listed = 0
    found = 0
    escaped = 0
    trail = 0
    failed = ""

    def saw(ref self, answer: Answer):
        self.statuses[answer.status] = (self.statuses.get(answer.status) else 0) + 1

def mixed(hash: int, value: int) -> int:
    return (hash * 31 + value) % 1_000_000_007

def text_mixed(hash: int, text: str) -> int:
    mut mixed_in = hash
    for byte in text.encode():
        mixed_in = mixed(mixed_in, value=byte)
    return mixed_in

def word(at: int) -> str:
    return WORDS[at % len(WORDS)]

# What a client was answered: the status, and the body as text.
struct Answer:
    status: int
    text: str

# One request on a connection of its own, as HTTP/1.1, signed in with `token` when there's one.
def asked(net: Net, port: int, request: Request, token: str) -> Answer fails NetError | HttpError:
    with net.connect("127.0.0.1", port)? as conn:
        mut head = f"{request.method} {request.path} HTTP/1.1\r\nhost: 127.0.0.1\r\n"
        if token != "":
            head += f"authorization: Bearer {token}\r\n"
        head += f"content-length: {len(request.body)}\r\nconnection: close\r\n\r\n"
        conn.write(head)?
        conn.write(request.body)?
        line = conn.read_line()? else fail HttpError(reason="the server sent nothing")
        status = int.parse(line.split(" ")[1]) except InvalidValue():
            fail HttpError(reason="that isn't a status line")
        _, body = rest_of(conn)?
        text = body.decode() except InvalidValue(): ""
        return Answer(status=status, text=text)

def posted(
    net: Net,
    port: int,
    path: str,
    body: str,
    token = "",
) -> Answer fails NetError | HttpError:
    return asked(net, port, Request(method="POST", path=path, body=body.encode()), token=token)?

def got(net: Net, port: int, path: str, token = "") -> Answer fails NetError | HttpError:
    return asked(net, port, Request(method="GET", path=path), token=token)?

# One scripted client: signs up, signs in, writes notes, lists and searches them, and tries what
# it shouldn't.
def visit(net: Net, port: int, number: int) -> Visit fails NetError | HttpError | ParseError:
    credentials = Credentials(name=f"user{number}", password=f"correct horse {number} battery")
    signing_up = json.dumps(credentials)
    mut visit = Visit(name=credentials.name)
    visit.saw(posted(net, port, path="/signup", body=signing_up)?)
    if number % 5 == 0:
        visit.saw(posted(net, port, path="/signup", body=signing_up)?)
    if number % 3 == 0:
        wrong = Credentials(name=credentials.name, password="not the password")
        visit.saw(posted(net, port, path="/signin", body=json.dumps(wrong))?)
    signed = posted(net, port, path="/signin", body=signing_up)?
    visit.saw(signed)
    token = json.loads[Signed](signed.text)?.token
    for at in range(NOTES):
        note = Note(
            title=f"{word(number + at)} {at}",
            body=f"{word(number * 3 + at)} and {word(at * 7)}",
        )
        visit.saw(posted(net, port, path="/notes", body=json.dumps(note), token=token)?)
    listed = got(net, port, path="/notes", token=token)?
    visit.saw(listed)
    for note in json.loads[list[Note]](listed.text)?:
        visit.listed += 1
        visit.trail = text_mixed(visit.trail, text=note.title + note.body)
    for words in SEARCHES:
        query = encode_query({"q": words})
        page = got(net, port, path=f"/search?{query}", token=token)?
        visit.saw(page)
        visit.found += page.text.count("<li>")
        visit.escaped += page.text.count("&lt;")
        visit.trail = text_mixed(visit.trail, text=page.text)
    # No token, and a token changed by hand, get nothing.
    visit.saw(got(net, port, path="/notes")?)
    visit.saw(got(net, port, path="/notes", token=f"{token}0")?)
    return visit

def client(net: Net, port: int, number: int) -> Visit:
    return visit(net, port=port, number=number) except why:
        Visit(name=f"user{number}", failed=f"{why}")

# Runs the server while the clients visit, then stops it. Gives what each client saw.
def run_load(
    net: Net,
    server: Server,
    app: App,
    clock: Clock,
    entropy: Entropy,
    stats: shared Stats,
) -> list[Visit] fails NetError | HttpError | Crashed:
    port = server.port
    stop = Secret.of(entropy.bytes(32).hex())
    with launch(() => serving(server, app, clock, entropy, stop, stats))?:
        visits = [client(net, port=port, number=number) for number in parallel(range(CLIENTS))]
        _ = posted(net, port, path="/stop", body="", token=stop.expose_secret())?
        return visits

def made(db: Database) fails SqlError:
    _ = db.execute(
        t"create table if not exists users (name text primary key, salt text, hash text)",
    )?
    _ = db.execute(
        t"create table if not exists notes (id integer primary key, owner text, title text, body text)",
    )?
    _ = db.execute(t"delete from users")?
    _ = db.execute(t"delete from notes")?

# How much the database kept.
struct Kept:
    users: int
    notes: int
    owners: int

# The summary: what the clients saw, then what the database kept.
def report(visits: list[Visit], db: Database, dropped: list[str]) -> list[str] fails SqlError:
    failed = [one for one in visits if one.failed != ""]
    mut lines = [f"{len(visits)} clients, {len(failed)} failed, {len(dropped)} dropped"]
    for one in failed:
        lines.append(f"  {one.name}: {one.failed}")
    mut statuses = dict[int, int]()
    for one in visits:
        for status, count in one.statuses.items():
            statuses[status] = (statuses.get(status) else 0) + count
    lines.append(", ".join([f"{status}: {statuses[status]}" for status in sorted(statuses.keys())]))
    lines.append(f"notes listed: {sum(one.listed for one in visits)}")
    lines.append(f"search results: {sum(one.found for one in visits)}")
    lines.append(f"escaped: {sum(one.escaped for one in visits)}")
    mut trail = 0
    for one in visits:
        trail = mixed(trail, value=one.trail)
    lines.append(f"trail: {trail}")
    for kept in db.query[Kept](
        t"select (select count(*) from users) as users, count(*) as notes, count(distinct owner) as owners from notes",
    )?:
        lines.append(f"kept: {kept.users} users, {kept.notes} notes from {kept.owners}")
    return lines

def main(
    net: Net,
    fs: Fs,
    env: Env,
    clock: Clock,
    entropy: Entropy,
    stdout: Stdout,
) fails NetError | HttpError | SqlError | IoError | Crashed:
    shared stats = Stats()
    folder = env.get("TMPDIR") else "/tmp"
    mut lines = list[str]()
    with net.listen(0)? as server:
        path = f"{folder}/fennec-web-backend-{server.port}.db"
        with sqlite.open(fs, path)? as db:
            made(db)?
            app = App(db=db, key=Secret.of(entropy.bytes(32).hex()))
            visits = run_load(net, server, app, clock, entropy, stats)?
            dropped = lock stats as current:
                current.dropped
            lines = report(visits, db=db, dropped=dropped)?
        for leftover in [path, f"{path}-wal", f"{path}-shm"]:
            if fs.exists(leftover)?:
                fs.remove(leftover)?
    for line in lines:
        stdout.print(line)
