# The same from inside a launched task, whose join parks, with main waiting at the block's end.
# Never a deadlock. (From Fable 5.2's review of the phase 2 design.)
from std.concurrent import Channel, Closed, Crashed, channel

def part(at: int, half: int, pipe: Channel[int]) -> int:
    if at < half:
        got = pipe.receive() else -1
        return got
    pipe.send(at) except Closed():
        return -100
    return 0

def all_parts(pipe: Channel[int]) -> int:
    got = [part(at, half=8, pipe=pipe) for at in parallel(range(16))]
    return sum(got)

def in_task(out: Channel[int]):
    mut total = 0
    for turn in range(50):
        with channel[int](size=1) as pipe:
            total += all_parts(pipe)
    out.send(total) except Closed():
        return
    return

def main(stdout: Stdout) fails Crashed:
    with channel[int](size=1) as out:
        with launch(() => in_task(out))?:
            pass
        stdout.print(out.receive() else -1)
