## `std.postgres`: a Postgres database over the network, written in Fennec on `std.net`, under
## `std.sql`. Queries are templates, and each value goes to the server apart from the query's
## text, as a parameter. Rows read into any type that loads, by the columns' names.
##
## ```fennec
## with postgres.connect(net, entropy, host="localhost", user="hoard", database="hoard", password=secret)? as db:
##     _ = db.execute(t"insert into entries values ({path}, {size})")?
##     rows = db.query[Entry](t"select path, size from entries where size > {least}")?
##     with db.transaction()? as tx:
##         _ = tx.execute(t"delete from entries where path = {path}")?
## ```
##
## A connection runs one query at a time, so one task uses a `PgDatabase` at a time: tasks in
## `parallel` each connect for themselves. There's no TLS yet, so it's for a server on this machine
## or a private network.
##
## Underneath, `startup`, `password` and `terminate` give the bytes a client sends, and a `PgReader`
## is fed the bytes a server sends and gives back each whole message, with no network of their
## own, so the same code runs against a socket or against bytes a test wrote.

from std import base64, crypto
from std.crypto import Secret
from std.intrinsics import bytes_text
from std.net import Connection
from std.sql import SqlError, SqlRows, SqlValue, rows_as

## The protocol's version, 3.0, as a startup message gives it.
PROTOCOL = 196608

## The longest message a reader takes, so a server can't make it hold more than this.
LONGEST = 1073741824

## A message a Postgres server sends.
export enum PgMessage:
    ## The client is in.
    AuthOk
    ## The server wants the password as it is.
    AuthCleartext
    ## The server wants SASL, with one of these mechanisms, like `SCRAM-SHA-256`.
    AuthSasl(mechanisms: list[str])
    ## The server's next SASL message.
    AuthSaslContinue(data: bytes)
    ## The server's last SASL message, which proves it knows the password too.
    AuthSaslFinal(data: bytes)
    ## A way to sign in this client doesn't speak, by its number.
    AuthOther(code: int)
    ## One of the server's settings, like `server_version`.
    Setting(name: str, value: str)
    ## What cancels this connection's query from another connection.
    BackendKey(process: int, secret: int)
    ## Ready for the next query: `I` idle, `T` in a transaction, `E` in a failed one.
    Ready(status: str)
    ## A failure, by its fields' codes: `C` the SQLSTATE, `M` the message, `S` how bad.
    Failed(fields: dict[str, str])
    ## A notice, by its fields' codes, as a failure's.
    Notice(fields: dict[str, str])
    ## The columns rows will have: each one's name and its type's number.
    Columns(names: list[str], types: list[int])
    ## A row's cells, as text. A cell that's null has `False` in `present` and empty bytes.
    Row(cells: list[bytes], present: list[bool])
    ## A query finished, saying what it did, like `INSERT 0 1`.
    Done(tag: str)
    ParseComplete
    BindComplete
    NoData
    EmptyQuery
    ## Any other message, by its type byte.
    Other(kind: int)

## The startup message: the protocol's version, then who's signing in and to which database.
export def startup(user: str, database: str) -> bytes:
    mut out = PgWriter()
    out.int32(PROTOCOL)
    for name, value in [("user", user), ("database", database)]:
        out.text(name)
        out.text(value)
    out.byte(0)
    out.done(-1)

## The password, as it is, for a server that asks for it that way.
export def password(text: str) -> bytes:
    mut out = PgWriter()
    out.text(text)
    out.done(112)

## The first SASL message: the mechanism chosen, then its first message.
export def sasl_first(mechanism: str, data: bytes) -> bytes:
    mut out = PgWriter()
    out.text(mechanism)
    out.int32(data.len())
    out.bytes(data)
    out.done(112)

## A later SASL message.
export def sasl_next(data: bytes) -> bytes:
    mut out = PgWriter()
    out.bytes(data)
    out.done(112)

## Says the client is done, before it closes the connection.
export def terminate() -> bytes:
    PgWriter().done(88)

## Writes a message's body, then gives the message: its type byte, unless it's the startup
## message, which has none, then its length, then the body.
struct PgWriter:
    _body = list[int]()

    def byte(ref self, value: int):
        self._body.append(value)

    def int16(ref self, n: int):
        self._body.append((n >> 8) & 255)
        self._body.append(n & 255)

    def int32(ref self, n: int):
        for shift in [24, 16, 8, 0]:
            self._body.append((n >> shift) & 255)

    def bytes(ref self, data: bytes):
        for each in data:
            self._body.append(each)

    ## Text, then the zero byte that ends it.
    def text(ref self, text: str):
        self.bytes(text.encode())
        self._body.append(0)

    ## The message of type `kind`, or the startup message for -1.
    def done(self, kind: int) -> bytes:
        size = self._body.len() + 4
        mut head = list[int]() if kind < 0 else [kind]
        for shift in [24, 16, 8, 0]:
            head.append((size >> shift) & 255)
        bytes(head + self._body)

## Reads a server's messages from the bytes it's sent so far: `feed` takes more, and `next` gives
## the next whole message, or `None` until there's enough for one.
export struct PgReader:
    _data = bytes([])
    _at = 0

    ## Adds bytes the server sent.
    def feed(ref self, more: bytes):
        self._data = self._data[self._at:self._data.len()] + more
        self._at = 0

    ## The next whole message, or `None` until there's enough for one. A message that isn't what a
    ## server sends fails with `SqlError.Failed`.
    def next(ref self) -> PgMessage? fails SqlError:
        if self._data.len() - self._at < 5: return None
        kind = self._data[self._at]
        size = int32_at(self._data, self._at + 1)
        if size < 4 or size > LONGEST:
            fail .Failed(reason=f"the server sent a message {size} bytes long")
        if self._data.len() - self._at < 1 + size: return None
        body = self._data[self._at + 5:self._at + 1 + size]
        self._at += 1 + size
        message(kind, body)?

## The message of type `kind` with `body`.
def message(kind: int, body: bytes) -> PgMessage fails SqlError:
    mut part = PgBody(_data=body)
    # `R`, `S`, `K`, `Z`, `E`, `N`, `T`, `D`, `C`, `1`, `2`, `n`, `I`
    if kind == 82: return authentication(ref part)?
    if kind == 83:
        name = part.text()?
        return .Setting(name=name, value=part.text()?)
    if kind == 75:
        process = part.int32()?
        return .BackendKey(process=process, secret=part.int32()?)
    if kind == 90: return .Ready(status=bytes_text(body, 0, 1) if body.len() == 1 else "")
    if kind == 69: return .Failed(fields=part.fields()?)
    if kind == 78: return .Notice(fields=part.fields()?)
    if kind == 84: return columns(ref part)?
    if kind == 68: return row(ref part)?
    if kind == 67: return PgMessage.Done(tag=part.text()?)
    if kind == 49: return .ParseComplete
    if kind == 50: return .BindComplete
    if kind == 110: return .NoData
    if kind == 73: return .EmptyQuery
    .Other(kind=kind)

def authentication(ref part: PgBody) -> PgMessage fails SqlError:
    code = part.int32()?
    if code == 0: return .AuthOk
    if code == 3: return .AuthCleartext
    if code == 10:
        mut mechanisms = list[str]()
        while True:
            mechanism = part.text()?
            if mechanism == "": break
            mechanisms.append(mechanism)
        return .AuthSasl(mechanisms=mechanisms)
    if code == 11: return .AuthSaslContinue(data=part.rest())
    if code == 12: return .AuthSaslFinal(data=part.rest())
    .AuthOther(code=code)

def columns(ref part: PgBody) -> PgMessage fails SqlError:
    count = part.int16()?
    mut names = list[str]()
    mut types = list[int]()
    for _ in range(count):
        names.append(part.text()?)
        # The table and column it's from, then its type, size, modifier and format.
        _ = part.int32()?
        _ = part.int16()?
        types.append(part.int32()?)
        _ = part.int16()?
        _ = part.int32()?
        _ = part.int16()?
    .Columns(names=names, types=types)

def row(ref part: PgBody) -> PgMessage fails SqlError:
    count = part.int16()?
    mut cells = list[bytes]()
    mut present = list[bool]()
    for _ in range(count):
        size = part.int32()?
        present.append(size >= 0)
        cells.append(part.take(size)? if size >= 0 else bytes([]))
    .Row(cells=cells, present=present)

## The body of one message, read from its start.
struct PgBody:
    _data: bytes
    _at = 0

    def _short(self) -> SqlError:
        SqlError.Failed(reason="the server sent a message that ends too soon")

    def int16(ref self) -> int fails SqlError:
        if self._data.len() - self._at < 2: fail self._short()
        n = (self._data[self._at] << 8) | self._data[self._at + 1]
        self._at += 2
        n - 65536 if n >= 32768 else n

    def int32(ref self) -> int fails SqlError:
        if self._data.len() - self._at < 4: fail self._short()
        n = int32_at(self._data, self._at)
        self._at += 4
        n

    def take(ref self, size: int) -> bytes fails SqlError:
        if size < 0 or self._data.len() - self._at < size: fail self._short()
        taken = self._data[self._at:self._at + size]
        self._at += size
        taken

    ## Text up to the zero byte that ends it.
    def text(ref self) -> str fails SqlError:
        mut end = self._at
        while end < self._data.len() and self._data[end] != 0:
            end += 1
        if end >= self._data.len(): fail self._short()
        text = bytes_text(self._data, self._at, end)
        if text == "" and end > self._at:
            fail SqlError.Failed(reason="the server sent text that isn't UTF-8")
        self._at = end + 1
        text

    ## What's left.
    def rest(ref self) -> bytes:
        taken = self._data[self._at:self._data.len()]
        self._at = self._data.len()
        taken

    ## A failure's or a notice's fields: each a one-letter code and its text, ended by a zero byte.
    def fields(ref self) -> dict[str, str] fails SqlError:
        mut found = dict[str, str]()
        while self._at < self._data.len() and self._data[self._at] != 0:
            code = bytes_text(self._data, self._at, self._at + 1)
            self._at += 1
            found[code] = self.text()?
        found

## The signed int32 at `at`, high byte first.
def int32_at(data: bytes, at: int) -> int:
    n = (data[at] << 24) | (data[at + 1] << 16) | (data[at + 2] << 8) | data[at + 3]
    n - 4294967296 if n >= 2147483648 else n

## Signing in with SCRAM-SHA-256 (RFC 5802 and 7677), with no network of its own: `first` gives
## the client's first message, `answer` reads the server's first and gives the client's proof that
## it knows the password, and `check` reads the server's last, which proves the server knows it
## too. The password never crosses the network.
export struct PgScram:
    _password: Secret[str]
    _first_bare: str
    _nonce: str
    _server_key = bytes([])
    _signed = ""

    ## Starts signing in with the password `secret`, and `nonce`, text the server never saw before,
    ## which a driver makes from 18 or more bytes of `Entropy`. Postgres takes the user from the
    ## startup message, so `user` is usually left empty.
    def started(secret: Secret[str], nonce: str, user = "") -> PgScram:
        PgScram(_password=secret, _first_bare=f"n={user},r={nonce}", _nonce=nonce)

    ## The client's first message, with no channel binding.
    def first(self) -> bytes:
        f"n,,{self._first_bare}".encode()

    ## The client's last message, answering the server's first: the server's nonce, which has to
    ## start with ours, and the proof.
    def answer(ref self, server_first: bytes) -> bytes fails SqlError:
        said = server_first.decode() else fail SqlError.Failed(
            reason="the server's SCRAM message isn't text",
        )
        mut nonce = ""
        mut salt = bytes([])
        mut rounds = 0
        for part in said.split(","):
            if part.startswith("r="):
                nonce = part[2:part.len()]
            if part.startswith("s="):
                salt = base64.decode(part[2:part.len()]) else fail SqlError.Failed(
                    reason="the server's SCRAM salt isn't base64",
                )
            if part.startswith("i="):
                rounds = int(part[2:part.len()]) else fail SqlError.Failed(
                    reason="the server's SCRAM rounds aren't a number",
                )
        if not nonce.startswith(self._nonce) or nonce == self._nonce:
            fail SqlError.Failed(reason="the server's SCRAM nonce doesn't extend ours")
        if salt.len() == 0 or rounds < 4096:
            fail SqlError.Failed(reason="the server's SCRAM salt or rounds are too weak")
        salted = salted_password(self._password.expose_secret().encode(), salt, rounds)
        client_key = mac(salted, "Client Key".encode())
        stored = unhex(crypto.sha256(client_key))
        unproved = f"c=biws,r={nonce}"
        signed = f"{self._first_bare},{said},{unproved}"
        signature = mac(stored, signed.encode())
        proof = bytes([client_key[at] ^ signature[at] for at in range(client_key.len())])
        self._server_key = mac(salted, "Server Key".encode())
        self._signed = signed
        f"{unproved},p={base64.encode(proof)}".encode()

    ## Checks the server's last message: its signature, which only a server that knows the
    ## password could make.
    def check(self, server_final: bytes) fails SqlError:
        said = server_final.decode() else ""
        wanted = base64.encode(mac(self._server_key, self._signed.encode()))
        if not crypto.equal(said, f"v={wanted}"):
            fail SqlError.Failed(reason="the server couldn't prove it knows the password")

## PBKDF2 with HMAC-SHA-256, for one 32-byte block: RFC 5802's `Hi`.
def salted_password(key: bytes, salt: bytes, rounds: int) -> bytes:
    mut round = mac(key, salt + bytes([0, 0, 0, 1]))
    mut total = list[int]()
    for each in round:
        total.append(each)
    for _ in range(rounds - 1):
        round = mac(key, round)
        for at in range(total.len()):
            total[at] = total[at] ^ round[at]
    bytes(total)

## HMAC-SHA-256 of `data` under `key`, as bytes.
def mac(key: bytes, data: bytes) -> bytes:
    unhex(crypto.hmac_sha256(key, data))

## Bytes from the lowercase hex `std.crypto`'s hashes give.
def unhex(hex: str) -> bytes:
    digits = hex.encode()
    mut out = list[int]()
    for at in range(digits.len() // 2):
        out.append(nibble(digits[2 * at]) * 16 + nibble(digits[2 * at + 1]))
    bytes(out)

def nibble(digit: int) -> int:
    # `0` to `9`, then `a` to `f`.
    digit - 48 if digit < 97 else digit - 87

## The messages that run one query with the extended protocol: parse the template's text, with
## `$1` for each value, bind the values, describe the rows it gives, run it, then sync. Each value
## is sent apart from the text, as a parameter, so it can never change what the text means: an
## int, a float or text as text, and bytes as they are.
export def query_messages(query: Template[SqlValue]) -> bytes:
    mut text = ""
    for at, part in enumerate(query.strings):
        text += part
        if at < query.values.len():
            text += f"${at + 1}"
    mut parse = PgWriter()
    parse.text("")
    parse.text(text)
    parse.int16(query.values.len())
    for value in query.values:
        parse.int32(type_of(value))
    mut bind = PgWriter()
    bind.text("")
    bind.text("")
    bind.int16(query.values.len())
    for value in query.values:
        # 1 for bytes as they are, 0 for everything else as text.
        bind.int16(1 if value is bytes else 0)
    bind.int16(query.values.len())
    for value in query.values:
        data = written_value(value)
        bind.int32(data.len())
        bind.bytes(data)
    # Every column comes back as text.
    bind.int16(0)
    mut describe = PgWriter()
    describe.byte(80)
    describe.text("")
    mut execute = PgWriter()
    execute.text("")
    execute.int32(0)
    parse.done(80) + bind.done(66) + describe.done(68) + execute.done(69) + PgWriter().done(83)

## The number of Postgres's type for a value: `int8`, `float8`, `text`, `bytea` or `bool`.
def type_of(value: SqlValue) -> int:
    # A bool is what's none of the others.
    mut found = 16
    if value is int:
        found = 20
    if value is float:
        found = 701
    if value is str:
        found = 25
    if value is bytes:
        found = 17
    found

## A value as its parameter's bytes.
def written_value(value: SqlValue) -> bytes:
    # A bool is what's none of the others.
    mut found = ("t" if value == True else "f").encode()
    if value is int:
        found = str(value).encode()
    if value is float:
        found = float_text(value).encode()
    if value is str:
        found = value.encode()
    if value is bytes:
        found = value
    found

## A float as Postgres reads one: its digits, or its words for what isn't a number.
def float_text(value: float) -> str:
    if value.is_nan(): return "NaN"
    if value == 1e308 * 10.0: return "Infinity"
    if value == -1e308 * 10.0: return "-Infinity"
    str(value)

## The rows a query gave, from its columns and each row as text, ready for `sql.rows_as`. Each
## cell is read by its column's type: ints and bools as ints, floats as floats, `bytea` as bytes,
## and everything else as text.
export def rows_of(
    names: list[str],
    types: list[int],
    rows: list[PgMessage],
) -> SqlRows fails SqlError:
    mut found = SqlRows(columns=names, kinds=[], at=[], ints=[], floats=[], texts=[], blobs=[])
    for each in rows:
        match each:
            case .Row(cells=cells, present=present):
                if cells.len() != names.len():
                    fail SqlError.Failed(
                        reason=f"the server sent a row of {cells.len()} cells for {names.len()} columns",
                    )
                for at, cell in enumerate(cells):
                    add_cell(ref found, types[at] if at < types.len() else 25, cell, present[at])?
            case _:
                pass
    found

def add_cell(ref rows: SqlRows, kind: int, cell: bytes, there: bool) fails SqlError:
    if not there:
        rows.kinds.append(0)
        rows.at.append(0)
        return
    text = cell.decode() else fail SqlError.Failed(reason="the server sent a cell that isn't UTF-8")
    # `bool`, then `int8`, `int2` and `int4`, `float4` and `float8`, and `bytea`.
    if kind == 16:
        rows.kinds.append(1)
        rows.at.append(rows.ints.len())
        rows.ints.append(1 if text == "t" else 0)
    elif kind == 20 or kind == 21 or kind == 23:
        rows.kinds.append(1)
        rows.at.append(rows.ints.len())
        rows.ints.append(
            int(text) else fail SqlError.Failed(reason=f"the server sent `{text}` as an int"),
        )
    elif kind == 700 or kind == 701:
        rows.kinds.append(2)
        rows.at.append(rows.floats.len())
        rows.floats.append(float_of(text)?)
    elif kind == 17:
        rows.kinds.append(4)
        rows.at.append(rows.blobs.len())
        rows.blobs.append(hex_bytes(text)?)
    else:
        rows.kinds.append(3)
        rows.at.append(rows.texts.len())
        rows.texts.append(text)

def float_of(text: str) -> float fails SqlError:
    if text == "NaN": return 0.0 / 0.0
    if text == "Infinity": return 1e308 * 10.0
    if text == "-Infinity": return -1e308 * 10.0
    float(text) else fail SqlError.Failed(reason=f"the server sent `{text}` as a float")

## `bytea` as Postgres writes it as text: `\x`, then two hex digits a byte.
def hex_bytes(text: str) -> bytes fails SqlError:
    digits = text.encode()
    if digits.len() < 2 or digits[0] != 92 or digits[1] != 120 or digits.len() % 2 != 0:
        fail SqlError.Failed(reason="the server sent bytes that aren't in hex")
    mut out = list[int]()
    for at in range(1, digits.len() // 2):
        high = hex_digit(digits[2 * at])?
        out.append(high * 16 + hex_digit(digits[2 * at + 1])?)
    bytes(out)

def hex_digit(digit: int) -> int fails SqlError:
    # `0` to `9`, `a` to `f` and `A` to `F`.
    if digit >= 48 and digit <= 57: return digit - 48
    if digit >= 97 and digit <= 102: return digit - 87
    if digit >= 65 and digit <= 70: return digit - 55
    fail SqlError.Failed(reason="the server sent bytes that aren't in hex")

## A failure the server sent, as the `SqlError` it is: class `23`, a broken rule, is `Constraint`,
## a serialization failure or a deadlock is `Busy`, and anything else is `Failed`, each with the
## server's own message and code.
export def failure_of(fields: dict[str, str]) -> SqlError:
    code = fields.get("C") else ""
    said = fields.get("M") else "the server failed with no message"
    reason = f"{said} ({code})" if code != "" else said
    if code.startswith("23"): return SqlError.Constraint(reason=reason)
    if code == "40001" or code == "40P01": return SqlError.Busy(reason=reason)
    SqlError.Failed(reason=reason)

## Connects to the database, signs in, and lends a `PgDatabase` for a `with` block, closing it at the
## end. `password` is needed if the server asks for one: it's sent with SCRAM-SHA-256, which
## never puts it on the wire, or as it is if the server asks for that. `entropy` makes SCRAM's nonce.
export def connect(
    net: Net,
    entropy: Entropy,
    host: str,
    user: str,
    database: str,
    password: Secret[str]? = None,
    port = 5432,
) -> with PgDatabase fails SqlError:
    db = PgDatabase(_conn=opened(net, host=host, port=port)?)
    db._sign_in(entropy, user=user, database=database, secret=password)?
    lend db else:
        db._close()
    db._close()

## A connection to a database, lent by `postgres.connect`.
export struct PgDatabase:
    _conn: Connection

    ## Runs a query that changes something, like an `insert`, and gives how many rows it changed.
    def execute(self, query: Template[SqlValue]) -> int fails SqlError:
        changed(self._run(query)?.tag)

    ## Runs a query and gives each row it found as a `T`, a struct's fields by the columns' names.
    def query[T: Deserializable](self, query: Template[SqlValue]) -> list[T] fails SqlError:
        found = self._run(query)?
        rows_as[T](rows_of(found.names, types=found.types, rows=found.rows)?)?

    ## A transaction for a `with` block: it commits when the block ends, and rolls back if the
    ## block fails.
    def transaction(self) -> with PgTransaction fails SqlError:
        _ = self._run(t"begin")?
        tx = PgTransaction(_db=self)
        lend tx else:
            _ = self._run(t"rollback") else PgResult()
        _ = self._run(t"commit")?

    ## Sends a query, and reads what comes back up to the server's saying it's ready again. A
    ## failure is kept until then, so the connection is ready for the next query.
    def _run(self, query: Template[SqlValue]) -> PgResult fails SqlError:
        send(self._conn, query_messages(query))?
        mut reader = PgReader()
        mut found = PgResult()
        mut failed = False
        mut failure = SqlError.Failed(reason="")
        while True:
            message = next_message(self._conn, ref reader)?
            match message:
                case .Columns(names=names, types=types):
                    found.names = names
                    found.types = types
                case .Row(cells=_, present=_):
                    found.rows.append(message)
                case .Done(tag=tag):
                    found.tag = tag
                case .Failed(fields=fields):
                    failed = True
                    failure = failure_of(fields)
                case .Ready(status=_):
                    if failed: fail failure
                    return found
                case _:
                    pass
        found

    ## Says who's signing in, and answers whatever the server asks until it's ready. After SCRAM
    ## the server has to have proved it knows the password, or it isn't trusted.
    def _sign_in(
        self,
        entropy: Entropy,
        user: str,
        database: str,
        secret: Secret[str]?,
    ) fails SqlError:
        send(self._conn, startup(user, database=database))?
        mut reader = PgReader()
        mut scram = PgScram.started(Secret.of(""), nonce="", user="")
        mut signing = False
        mut proved = False
        while True:
            message = next_message(self._conn, ref reader)?
            match message:
                case .AuthOk:
                    if signing and not proved:
                        fail SqlError.Failed(
                            reason="the server let us in without proving it knows the password",
                        )
                case .AuthCleartext:
                    held = needed(secret)?
                    send(self._conn, cleartext(held))?
                case .AuthSasl(mechanisms=mechanisms):
                    if not ("SCRAM-SHA-256" in mechanisms):
                        fail SqlError.Failed(reason="the server doesn't offer SCRAM-SHA-256")
                    nonce = base64.encode(entropy.bytes(18))
                    scram = PgScram.started(needed(secret)?, nonce=nonce, user="")
                    signing = True
                    send(self._conn, sasl_first("SCRAM-SHA-256", data=scram.first()))?
                case .AuthSaslContinue(data=data):
                    send(self._conn, sasl_next(scram.answer(data)?))?
                case .AuthSaslFinal(data=data):
                    scram.check(data)?
                    proved = True
                case .AuthOther(code=code):
                    fail SqlError.Failed(
                        reason=f"the server signs in a way this doesn't speak, number {code}: use SCRAM-SHA-256 or a password",
                    )
                case .Failed(fields=fields):
                    fail failure_of(fields)
                case .Ready(status=_):
                    return
                case _:
                    pass

    def _close(self):
        # Closing goes ahead whether or not the server hears it's the end.
        match self._conn.write(terminate()):
            case Ok(_):
                pass
            case Err(_):
                pass
        self._conn.close()

## A transaction, lent by `db.transaction()`. Its queries see what it's changed so far, and the
## rest of the program sees none of it until it's kept.
export struct PgTransaction:
    _db: PgDatabase

    ## Runs a query that changes something, like an `insert`, and gives how many rows it changed.
    def execute(self, query: Template[SqlValue]) -> int fails SqlError:
        self._db.execute(query)?

    ## Runs a query and gives each row it found as a `T`.
    def query[T: Deserializable](self, query: Template[SqlValue]) -> list[T] fails SqlError:
        self._db.query[T](query)?

## What one query gave.
struct PgResult:
    names = list[str]()
    types = list[int]()
    rows = list[PgMessage]()
    tag = ""

## A connection to the server.
def opened(net: Net, host: str, port: int) -> Connection fails SqlError:
    match net.connect(host, port):
        case Ok(conn):
            return conn
        case Err(error):
            fail SqlError.Failed(reason=f"couldn't connect to {host}:{port}: {error.message()}")

## The password a server asked for, which has to have been given.
def needed(secret: Secret[str]?) -> Secret[str] fails SqlError:
    secret else fail SqlError.Failed(
        reason="the server asks for a password, and `connect` wasn't given one",
    )

## The message that sends a password as it is.
def cleartext(secret: Secret[str]) -> bytes:
    password(secret.expose_secret())

## How many rows a query's tag says it changed, like the 1 in `INSERT 0 1`, or 0 if it doesn't say.
def changed(tag: str) -> int:
    words = tag.split(" ")
    int(words[words.len() - 1]) else 0

def send(conn: Connection, data: bytes) fails SqlError:
    match conn.write(data):
        case Ok(_):
            pass
        case Err(error):
            fail SqlError.Failed(reason=f"the connection to the server failed: {error.message()}")

## The next whole message from the server, waiting for it.
def next_message(conn: Connection, ref reader: PgReader) -> PgMessage fails SqlError:
    while True:
        found = reader.next()?
        if found is not None: return found
        match conn.read(65536):
            case Ok(more):
                if more.len() == 0: fail SqlError.Failed(reason="the server closed the connection")
                reader.feed(more)
            case Err(error):
                fail SqlError.Failed(
                    reason=f"the connection to the server failed: {error.message()}",
                )
    fail SqlError.Failed(reason="the server closed the connection")
