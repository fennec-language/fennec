from std.string import quoted_input

## A length of time, to the nanosecond. Written like `1.5s`, `16ms` or `1h30min`, or made with
## `Duration.seconds(0.5)`, `Duration.millis(16)` or `Duration(nanos=...)`. It prints the way
## it's written, as `16.666667ms` or `1h30min5s`.
##
## ```fennec
## from std.time import Duration
## assert Duration.seconds(0.5) == 500ms
## assert str(1h30min) == "1h30min"
## ```
export struct Duration:
    nanos = 0

    ## ```fennec
    ## from std.time import Duration
    ## assert Duration.seconds(1.5) == 1500ms
    ## ```
    def seconds(seconds: float) -> Duration:
        return Duration(nanos=round(seconds * 1_000_000_000.0))

    ## ```fennec
    ## from std.time import Duration
    ## assert Duration.millis(16) == 16ms
    ## ```
    def millis(millis: int) -> Duration:
        return Duration(nanos=millis * 1_000_000)

    ## ```fennec
    ## from std.time import Duration
    ## assert Duration.micros(1000) == 1ms
    ## ```
    def micros(micros: int) -> Duration:
        return Duration(nanos=micros * 1_000)

    ## ```fennec
    ## from std.time import Duration
    ## assert Duration.minutes(90) == 1h30min
    ## ```
    def minutes(minutes: int) -> Duration:
        return Duration(nanos=minutes * 60_000_000_000)

    ## ```fennec
    ## from std.time import Duration
    ## assert Duration.hours(2) == 120min
    ## ```
    def hours(hours: int) -> Duration:
        return Duration(nanos=hours * 3_600_000_000_000)

    ## The same length, forward: `abs(d)` calls it, as `abs` does for a number.
    ##
    ## ```fennec
    ## assert abs(1s - 3s) == 2s
    ## ```
    def abs(self) -> Duration:
        return Duration(nanos=-self.nanos if self.nanos < 0 else self.nanos)

    ## As it's written: under a second in its largest unit, like `16.5ms`, and from a second up
    ## in hours, minutes and seconds, leaving out those that are 0, like `1h30min` or `90.5s`.
    ##
    ## ```fennec
    ## from std.time import Duration
    ## assert str(Duration.micros(16500)) == "16.5ms"
    ## assert str(Duration.seconds(5405.0)) == "1h30min5s"
    ## ```
    def str(self, ref out: StrWriter):
        if self.nanos == 0:
            out.write("0s")
            return
        if self.nanos < 0:
            out.write("-")
        size = -self.nanos if self.nanos < 0 else self.nanos
        if size < 1_000:
            out.write(f"{size}ns")
        elif size < 1_000_000:
            out.write(Time._decimal(size, unit=1_000, places=3) + "us")
        elif size < 1_000_000_000:
            out.write(Time._decimal(size, unit=1_000_000, places=6) + "ms")
        else:
            hours = size // 3_600_000_000_000
            minutes = size % 3_600_000_000_000 // (60_000_000_000)
            rest = size % (60_000_000_000)
            if hours > 0:
                out.write(f"{hours}h")
            if minutes > 0:
                out.write(f"{minutes}min")
            if rest > 0:
                out.write(Time._decimal(rest, unit=1_000_000_000, places=9) + "s")

    ## The duration in seconds, for moving things by `speed * dt.as_seconds()`.
    ##
    ## ```fennec
    ## assert (1500ms).as_seconds() == 1.5
    ## ```
    def as_seconds(self) -> float:
        return float(self.nanos) / 1_000_000_000.0

    ## The duration in milliseconds.
    ## ```fennec
    ## assert (2s).as_millis() == 2000.0
    ## ```
    def as_millis(self) -> float:
        return float(self.nanos) / 1_000_000.0

    ## ```fennec
    ## assert 1min + 30s == 90s
    ## ```
    def +(self, other: Duration) -> Duration:
        return Duration(nanos=self.nanos + other.nanos)

    ## ```fennec
    ## assert 1min - 15s == 45s
    ## ```
    def -(self, other: Duration) -> Duration:
        return Duration(nanos=self.nanos - other.nanos)

    ## ```fennec
    ## assert 16ms * 3 == 48ms
    ## ```
    def *(self, times: int) -> Duration:
        return Duration(nanos=self.nanos * times)

    ## ```fennec
    ## assert 16ms < 1s
    ## ```
    def <(self, other: Duration) -> bool:
        return self.nanos < other.nanos

## A moment, read from a `Clock`. Subtract two to get the `Duration` between them.
##
## ```fennec
## start = clock.now()
## clock.sleep(1s)
## assert clock.now() - start == 1s
## ```
export struct Instant:
    ## Nanoseconds since the clock started.
    nanos = 0

    ## ```fennec
    ## start = clock.now()
    ## clock.sleep(250ms)
    ## assert clock.now() - start == 250ms
    ## ```
    def -(self, earlier: Instant) -> Duration:
        return Duration(nanos=self.nanos - earlier.nanos)

    ## ```fennec
    ## deadline = clock.now() + 5s
    ## assert clock.now() < deadline
    ## ```
    def +(self, later: Duration) -> Instant:
        return Instant(nanos=self.nanos + later.nanos)

    ## ```fennec
    ## before = clock.now()
    ## clock.sleep(1ms)
    ## assert before < clock.now()
    ## ```
    def <(self, other: Instant) -> bool:
        return self.nanos < other.nanos

## A moment in UTC, to the nanosecond, as `clock.time()` reads it, for saving and showing:
## `clock.now()` is the one for measuring, since this one can jump when the system's clock is
## set. It prints as RFC 3339 text, like `2026-11-06T21:55:56Z`, which `Time.parse` reads back.
##
## ```fennec
## from std.time import Time
## moment = Time.utc(year=2026, month=11, day=6, hour=21)?
## assert str(moment) == "2026-11-06T21:00:00Z"
## ```
export struct Time:
    ## Nanoseconds since 1970-01-01T00:00:00Z, negative before it. An `int` holds the years from
    ## 1678 to 2261.
    nanos = 0

    ## The moment of a date and a time of day in UTC, like
    ## `Time.utc(year=2026, month=11, day=6, hour=21)`. Fails on a date the calendar doesn't
    ## have, like February 30th, on a time of day past `23:59:59`, and on a year outside 1678 to
    ## 2261.
    ##
    ## ```fennec
    ## from std.time import Time
    ## assert Time.utc(year=2026, month=11, day=6)?.iso() == "2026-11-06T00:00:00Z"
    ## assert Time.utc(year=2026, month=2, day=30) fails InvalidValue()
    ## ```
    def utc(
        year: int,
        month: int,
        day: int,
        hour = 0,
        minute = 0,
        second = 0,
    ) -> Time fails InvalidValue:
        if year < 1678 or year > 2261:
            fail InvalidValue(message=f"a `Time` holds the years from 1678 to 2261, not {year}")
        if month < 1 or month > 12:
            fail InvalidValue(message=f"a month is from 1 to 12, not {month}")
        if day < 1 or day > Time._days_in_month(year, month=month):
            fail InvalidValue(message=f"{year}-{Time._padded(month, width=2)} has no day {day}")
        if hour < 0 or hour > 23 or minute < 0 or minute > 59 or second < 0 or second > 59:
            fail InvalidValue(
                message=f"{hour}:{Time._padded(minute, width=2)}:{Time._padded(second, width=2)} isn't a time of day",
            )
        days = Time._days_from_date(year, month=month, day=day)
        return Time(
            nanos=days * 86_400_000_000_000 + (hour * 3600 + minute * 60 + second) * 1_000_000_000,
        )

    ## The moment RFC 3339 text says, like `2026-11-06T21:55:56Z` or
    ## `2026-11-06T23:55:56.25+02:00`. `t` and `z` may be lowercase, and a space may stand for the
    ## `T`. Digits past nanoseconds are left off. A moment outside the years from 1678 to 2261 in
    ## UTC fails, even when its offset is what takes it there. Text that isn't one fails with an
    ## `InvalidValue`, as `int.parse` and the other parses do.
    ##
    ## ```fennec
    ## from std.time import Time
    ## assert Time.parse("2026-11-06T23:55:56.25+02:00")?.iso() == "2026-11-06T21:55:56.25Z"
    ## assert Time.parse("yesterday") fails InvalidValue()
    ## ```
    def parse(text: str) -> Time fails InvalidValue:
        if len(text) < 20: fail Time._not_rfc3339(text)
        for at, wanted in [(4, "-"), (7, "-"), (13, ":"), (16, ":")]:
            if text[at] != wanted: fail Time._not_rfc3339(text)
        if text[10] != "T" and text[10] != "t" and text[10] != " ": fail Time._not_rfc3339(text)
        year = Time._digits_at(text, at=0, count=4)?
        month = Time._digits_at(text, at=5, count=2)?
        day = Time._digits_at(text, at=8, count=2)?
        hour = Time._digits_at(text, at=11, count=2)?
        minute = Time._digits_at(text, at=14, count=2)?
        second = Time._digits_at(text, at=17, count=2)?
        mut at = 19
        mut fraction = 0
        if text[at] == ".":
            at += 1
            mut places = 0
            while at < len(text) and text[at].isdigit():
                if places < 9:
                    fraction = fraction * 10 + (int(text[at]) else 0)
                    places += 1
                at += 1
            if places == 0: fail Time._not_rfc3339(text)
            while places < 9:
                fraction *= 10
                places += 1
        if at >= len(text): fail Time._not_rfc3339(text)
        mut offset = 0
        sign = text[at]
        if sign == "Z" or sign == "z":
            at += 1
        elif sign == "+" or sign == "-":
            if at + 6 > len(text) or text[at + 3] != ":": fail Time._not_rfc3339(text)
            hours = Time._digits_at(text, at=at + 1, count=2)?
            minutes = Time._digits_at(text, at=at + 4, count=2)?
            if hours > 23 or minutes > 59: fail Time._not_rfc3339(text)
            offset = (hours * 60 + minutes) * 60_000_000_000
            if sign == "-":
                offset = -offset
            at += 6
        else:
            fail Time._not_rfc3339(text)
        if at != len(text): fail Time._not_rfc3339(text)
        found = Time.utc(year, month=month, day=day, hour=hour, minute=minute, second=second)?
        moment = found.nanos + fraction - offset
        # The date written is inside the years a `Time` holds, but an offset can take the moment
        # past either end, where `iso` would write a year `parse` refuses.
        first = Time._days_from_date(1678, month=1, day=1) * 86_400_000_000_000
        past = Time._days_from_date(2262, month=1, day=1) * 86_400_000_000_000
        if moment < first or moment >= past:
            fail InvalidValue(
                message=f"{quoted_input(text)} is outside the years from 1678 to 2261 in UTC, which a `Time` holds",
            )
        return Time(nanos=moment)

    ## The year, like 2026.
    ##
    ## ```fennec
    ## from std.time import Time
    ## assert Time.parse("2026-11-06T21:55:56Z")?.year() == 2026
    ## ```
    def year(self) -> int:
        year, _, _ = Time._date_of_days(self.days())
        return year

    ## The month, from 1 for January to 12 for December.
    ##
    ## ```fennec
    ## from std.time import Time
    ## assert Time.parse("2026-11-06T21:55:56Z")?.month() == 11
    ## ```
    def month(self) -> int:
        _, month, _ = Time._date_of_days(self.days())
        return month

    ## The day of the month, from 1.
    ##
    ## ```fennec
    ## from std.time import Time
    ## assert Time.parse("2026-11-06T21:55:56Z")?.day() == 6
    ## ```
    def day(self) -> int:
        _, _, day = Time._date_of_days(self.days())
        return day

    ## The hour of the day, from 0 to 23.
    ## ```fennec
    ## from std.time import Time
    ## assert Time.parse("2026-11-06T21:55:56Z")?.hour() == 21
    ## ```
    def hour(self) -> int:
        return self.nanos % 86_400_000_000_000 // 3_600_000_000_000

    ## The minute of the hour, from 0 to 59.
    ## ```fennec
    ## from std.time import Time
    ## assert Time.parse("2026-11-06T21:55:56Z")?.minute() == 55
    ## ```
    def minute(self) -> int:
        return self.nanos % 3_600_000_000_000 // (60_000_000_000)

    ## The second of the minute, from 0 to 59.
    ## ```fennec
    ## from std.time import Time
    ## assert Time.parse("2026-11-06T21:55:56Z")?.second() == 56
    ## ```
    def second(self) -> int:
        return self.nanos % (60_000_000_000) // 1_000_000_000

    ## The nanoseconds past the second, from 0 to 999,999,999.
    ##
    ## ```fennec
    ## from std.time import Time
    ## assert Time.parse("2026-11-06T21:55:56.25Z")?.nanosecond() == 250_000_000
    ## ```
    def nanosecond(self) -> int:
        return self.nanos % 1_000_000_000

    ## The day of the week, from 0 for Monday to 6 for Sunday, as Python counts them.
    ##
    ## ```fennec
    ## from std.time import Time
    ## assert Time.parse("2026-11-06T21:55:56Z")?.weekday() == 4
    ## ```
    def weekday(self) -> int:
        # 1970-01-01 was a Thursday.
        return (self.days() + 3) % 7

    ## The day of the year, from 1 for January 1st.
    ##
    ## ```fennec
    ## from std.time import Time
    ## assert Time.parse("2026-11-06T21:55:56Z")?.day_of_year() == 310
    ## ```
    def day_of_year(self) -> int:
        return self.days() - Time._days_from_date(self.year(), month=1, day=1) + 1

    ## Whole days since 1970-01-01, negative before it.
    ##
    ## ```fennec
    ## from std.time import Time
    ## assert Time.parse("1970-01-02T12:00:00Z")?.days() == 1
    ## assert Time.parse("2026-11-06T21:55:56Z")?.days() == 20763
    ## ```
    def days(self) -> int:
        return self.nanos // 86_400_000_000_000

    ## RFC 3339 text in UTC, like `2026-11-06T21:55:56Z`, with as many digits of a fraction of a
    ## second as it needs, like `2026-11-06T21:55:56.25Z`.
    ##
    ## ```fennec
    ## from std.time import Time
    ## assert Time.parse("2026-11-06T21:55:56.250Z")?.iso() == "2026-11-06T21:55:56.25Z"
    ## ```
    def iso(self) -> str:
        year, month, day = Time._date_of_days(self.days())
        mut text = f"{Time._padded(year, width=4)}-{Time._padded(month, width=2)}-{Time._padded(day, width=2)}"
        text += f"T{Time._padded(self.hour(), width=2)}:{Time._padded(self.minute(), width=2)}:{Time._padded(self.second(), width=2)}"
        if self.nanosecond() != 0:
            text += "." + Time._without_trailing_zeros(Time._padded(self.nanosecond(), width=9))
        return text + "Z"

    ## The moment as `pattern` lays it out, its directives as C's `strftime` has them: `%Y`
    ## the year, `%m` the month, `%d` the day, `%H`, `%M` and `%S` the hour, minute and second,
    ## `%f` the microseconds, `%j` the day of the year, `%a` and `%A` the day's name short and
    ## whole, `%b` and `%B` the month's, `%y` the year's last two digits, `%z` the offset, which
    ## is `+0000`, `%Z` the zone, which is `UTC`, and `%%` a `%`. Anything else is written as
    ## it is.
    ##
    ## ```fennec
    ## from std.time import Time
    ## moment = Time.parse("2026-11-06T21:55:56Z")?
    ## assert moment.format("%Y-%m-%d %H:%M") == "2026-11-06 21:55"
    ## assert moment.format("%a %d %b") == "Fri 06 Nov"
    ## ```
    def format(self, pattern: str) -> str:
        mut out = StrWriter()
        mut at = 0
        while at < len(pattern):
            if pattern[at] != "%" or at + 1 == len(pattern):
                out.write(pattern[at])
                at += 1
                continue
            code = pattern[at + 1]
            out.write(self.directive(code) else "%" + code)
            at += 2
        return out.text()

    ## What a `format` directive writes, without its `%`.
    ##
    ## ```fennec
    ## from std.time import Time
    ## assert Time.parse("2026-11-06T21:55:56Z")?.directive("B") == "November"
    ## ```
    def directive(self, code: str) -> str?:
        if code == "Y": return Time._padded(self.year(), width=4)
        if code == "y": return Time._padded(self.year() % 100, width=2)
        if code == "m": return Time._padded(self.month(), width=2)
        if code == "d": return Time._padded(self.day(), width=2)
        if code == "H": return Time._padded(self.hour(), width=2)
        if code == "M": return Time._padded(self.minute(), width=2)
        if code == "S": return Time._padded(self.second(), width=2)
        if code == "f": return Time._padded(self.nanosecond() // 1_000, width=6)
        if code == "j": return Time._padded(self.day_of_year(), width=3)
        if code == "a": return Time._day_name(self.weekday())[0:3]
        if code == "A": return Time._day_name(self.weekday())
        if code == "b": return Time._month_name(self.month())[0:3]
        if code == "B": return Time._month_name(self.month())
        if code == "z": return "+0000"
        if code == "Z": return "UTC"
        if code == "%": return "%"
        return None

    ## Writes it as RFC 3339 text, as `iso` does.
    ## ```fennec
    ## from std.time import Time
    ## moment = Time.parse("2026-11-06T21:55:56Z")?
    ## assert f"at {moment}" == "at 2026-11-06T21:55:56Z"
    ## ```
    def str(self, ref out: StrWriter):
        out.write(self.iso())

    ## The time from `earlier` to this moment.
    ## ```fennec
    ## from std.time import Time
    ## start = Time.parse("2026-11-06T21:00:00Z")?
    ## end = Time.parse("2026-11-06T22:30:00Z")?
    ## assert end - start == 1h30min
    ## ```
    def -(self, earlier: Time) -> Duration:
        return Duration(nanos=self.nanos - earlier.nanos)

    ## The moment `later` after this one.
    ## ```fennec
    ## from std.time import Time
    ## start = Time.parse("2026-11-06T23:30:00Z")?
    ## assert (start + 1h).iso() == "2026-11-07T00:30:00Z"
    ## ```
    def +(self, later: Duration) -> Time:
        return Time(nanos=self.nanos + later.nanos)

    ## Whether this moment is before `other`.
    ## ```fennec
    ## from std.time import Time
    ## assert Time.parse("2026-01-01T00:00:00Z")? < Time.parse("2026-11-06T00:00:00Z")?
    ## ```
    def <(self, other: Time) -> bool:
        return self.nanos < other.nanos

    ## The days from 1970-01-01 to a date of the Gregorian calendar, counted back before it too,
    ## negative before 1970. Howard Hinnant's `days_from_civil`.
    def _days_from_date(year: int, month: int, day: int) -> int:
        shifted = year - 1 if month <= 2 else year
        era = shifted // 400
        of_era = shifted - era * 400
        of_year = (153 * (month - 3 if month > 2 else month + 9) + 2) // 5 + day - 1
        of_cycle = of_era * 365 + of_era // 4 - of_era // 100 + of_year
        return era * 146_097 + of_cycle - 719_468

    ## The date `days` after 1970-01-01, as its year, month and day: `days_from_date` turned around.
    def _date_of_days(days: int) -> (int, int, int):
        shifted = days + 719_468
        era = shifted // 146_097
        of_cycle = shifted - era * 146_097
        of_era = (of_cycle - of_cycle // 1_460 + of_cycle // 36_524 - of_cycle // 146_096) // 365
        of_year = of_cycle - (365 * of_era + of_era // 4 - of_era // 100)
        shifted_month = (5 * of_year + 2) // 153
        day = of_year - (153 * shifted_month + 2) // 5 + 1
        month = shifted_month + 3 if shifted_month < 10 else shifted_month - 9
        return (of_era + era * 400 + (1 if month <= 2 else 0), month, day)

    ## How many days a month of a year has.
    def _days_in_month(year: int, month: int) -> int:
        if month == 2:
            leap = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
            return 29 if leap else 28
        return 30 if month == 4 or month == 6 or month == 9 or month == 11 else 31

    ## `n` written with zeros before it to at least `width` digits.
    def _padded(n: int, width: int) -> str:
        text = str(n)
        return "0" * (width - len(text)) + text

    ## `text` with the zeros at its end taken off.
    def _without_trailing_zeros(text: str) -> str:
        mut end = len(text)
        while end > 1 and text[end - 1] == "0":
            end -= 1
        return text[0:end]

    ## `size` in `unit`s, with as many of its `places` decimals as it needs: 1,500 in thousands is
    ## `1.5`.
    def _decimal(size: int, unit: int, places: int) -> str:
        whole = str(size // unit)
        part = size % unit
        if part == 0: return whole
        return whole + "." + Time._without_trailing_zeros(Time._padded(part, width=places))

    ## The number of `count` digits at `at` in RFC 3339 text.
    def _digits_at(text: str, at: int, count: int) -> int fails InvalidValue:
        part = text[at:at + count]
        if len(part) != count or not part.isdigit(): fail Time._not_rfc3339(text)
        return int(part) except InvalidValue(): 0

    ## The error for text that isn't RFC 3339.
    def _not_rfc3339(text: str) -> InvalidValue:
        return InvalidValue(
            message=f"{quoted_input(text)} isn't an RFC 3339 time, like `2026-11-06T21:55:56Z`",
        )

    ## The name of the day of the week `weekday` counts, from 0 for Monday.
    def _day_name(weekday: int) -> str:
        return ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"][
            weekday
        ]

    ## The name of a month, from 1 for January.
    def _month_name(month: int) -> str:
        return [
            "January", "February", "March", "April", "May", "June", "July", "August", "September",
            "October", "November", "December",
        ][month - 1]

## A `Time` saves as its RFC 3339 text, as APIs and files write a time, and a `Duration` as its
## nanoseconds. An `Instant` is a reading of a clock that only measures, so it doesn't save.
extend Time:
    ## Writes it as its RFC 3339 text, for `json.dumps`, `pack.dumps` and the rest, which call it.
    ## ```fennec
    ## from std import json
    ## from std.time import Time
    ## assert json.dumps(Time.parse("2026-11-06T21:55:56Z")?) == "\"2026-11-06T21:55:56Z\""
    ## ```
    def serialize(self, ref out: Serializer):
        out.text(self.iso())

    ## Reads it from RFC 3339 text, for `json.loads`, `pack.loads` and the rest, which call it.
    ## ```fennec
    ## from std import json
    ## from std.time import Time
    ## moment = json.loads[Time]("\"2026-11-06T21:55:56Z\"")?
    ## assert moment.year() == 2026
    ## ```
    def deserialize(ref src: Deserializer) -> Time fails ParseError:
        text = src.text()?
        return Time.parse(text) except InvalidValue(): fail src.here(
            f"is {quoted_input(text)}, which isn't an RFC 3339 time",
        )

extend Duration:
    ## Writes it as its nanoseconds, for `json.dumps`, `pack.dumps` and the rest, which call it.
    ## ```fennec
    ## from std import json
    ## assert json.dumps(1500ms) == "1500000000"
    ## ```
    def serialize(self, ref out: Serializer):
        out.int(self.nanos)

    ## Reads it from its nanoseconds, for `json.loads`, `pack.loads` and the rest, which call it.
    ## ```fennec
    ## from std import json
    ## from std.time import Duration
    ## assert json.loads[Duration]("1500000000")? == 1500ms
    ## ```
    def deserialize(ref src: Deserializer) -> Duration fails ParseError:
        return Duration(nanos=src.int()?)
