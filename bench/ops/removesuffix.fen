# `text.removesuffix("ms")` of a time like `111ms`, done OPS times on inputs that vary.
# `fennec-bench ops` counts its instructions per operation beside its Rust twin's.

OPS = 20_000

def main(stdout: Stdout, args: Args):
    # No arguments are given, so this is 0, but the compiler can't know it.
    shift = len(args)
    texts = [f"{i * 3}ms" for i in range(shift, shift + 16)]
    mut total = 0
    for at in range(OPS):
        trimmed = texts[(at + shift) % 16].removesuffix("ms")
        total += len(trimmed)
    stdout.print(total)
    return
