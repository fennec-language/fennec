# Types that contain themselves, like syntax trees and linked lists. They're values like
# any other: copies share memory until one of them changes, and nothing can tell.

enum Expr:
    Num(value: int)
    Var(slot: int)
    Add(left: Expr, right: Expr)
    Mul(left: Expr, right: Expr)
    Neg(inner: Expr)
    Let(slot: int, value: Expr, body: Expr)

    def size(self) -> int:
        match self:
            case .Add(left_node, right_node):
                return 1 + left_node.size() + right_node.size()
            case .Mul(left_node, right_node):
                return 1 + left_node.size() + right_node.size()
            case .Neg(inner):
                return 1 + inner.size()
            case .Let(_, value, body):
                return 1 + value.size() + body.size()
            case _:
                return 1

struct Env:
    left_node: int
    right_node: int

def lookup(env: Env, slot: int) -> int:
    return env.left_node if slot == 0 else env.right_node

def bind(env: Env, slot: int, value: int) -> Env:
    return Env(left_node=value, right_node=env.right_node) if slot == 0 else Env(
        left_node=env.left_node,
        right_node=value,
    )

def eval(expr: Expr, env: Env) -> int:
    match expr:
        case .Num(n):
            return n
        case .Var(slot):
            return lookup(env, slot)
        case .Add(left_node, right_node):
            return eval(left_node, env) + eval(right_node, env)
        case .Mul(left_node, right_node):
            return eval(left_node, env) * eval(right_node, env)
        case .Neg(inner):
            return -eval(inner, env)
        case .Let(slot, value, body):
            return eval(body, bind(env, slot=slot, value=eval(value, env)))

def simplify(expr: Expr) -> Expr:
    match expr:
        case .Add(.Num(0), right):
            return simplify(right)
        case .Add(left, .Num(0)):
            return simplify(left)
        case .Mul(.Num(1), right):
            return simplify(right)
        case .Mul(.Num(0), _):
            return .Num(0)
        case .Neg(.Neg(inner)):
            return simplify(inner)
        case .Add(left_node, right_node):
            return .Add(simplify(left_node), right=simplify(right_node))
        case .Mul(left_node, right_node):
            return .Mul(simplify(left_node), right=simplify(right_node))
        case .Neg(inner):
            return .Neg(simplify(inner))
        case .Let(slot, value, body):
            return .Let(slot, value=simplify(value), body=simplify(body))
        case other:
            return other

def build(depth: int, seed: int) -> Expr:
    if depth == 0: return Expr.Var(seed % 2) if seed % 4 == 0 else .Num(seed % 10)
    left = build(depth - 1, seed=seed * 3 + 1)
    right = build(depth - 1, seed=seed * 7 + 2)
    match seed % 5:
        case 0:
            return .Add(left, right=right)
        case 1:
            return .Mul(.Num(1), right=.Add(left, right=.Num(0)))
        case 2:
            return .Add(.Neg(.Neg(left)), right=right)
        case 3:
            return .Let(seed % 2, value=left, body=right)
        case _:
            return .Mul(left, right=.Neg(right))

enum Chain:
    End
    Link(value: int, rest: Chain)

def count_down(n: int) -> Chain:
    mut chain = Chain.End
    for i in range(n):
        chain = .Link(i, chain)
    return chain

def total(chain: Chain) -> int:
    mut summed = 0
    mut at = chain
    while True:
        match at:
            case .Link(value, rest):
                summed += value
                at = rest
            case .End:
                break
    return summed

struct Program:
    name: str
    body: Expr
    runs: int

def main(stdout: Stdout):
    env = Env(left_node=3, right_node=-2)
    small = Expr.Let(0, value=.Add(.Num(2), right=.Var(1)), body=.Mul(.Var(0), right=.Neg(.Num(5))))
    stdout.print(small)
    stdout.print(eval(small, env), small.size())

    tree = build(12, seed=1)
    simpler = simplify(tree)
    stdout.print(tree.size(), simpler.size(), eval(tree, env), eval(simpler, env))
    stdout.print(simplify(simpler) == simpler, tree == simpler, build(12, seed=1) == tree)

    # A copy shares the tree; changing one changes nothing else.
    mut program = Program(name="calc", body=small, runs=0)
    saved = program
    program.runs += 1
    program.body = .Add(program.body, right=.Num(1))
    stdout.print(program.runs, saved.runs, eval(program.body, env), eval(saved.body, env))
    stdout.print(saved.body == small, program.body == small)

    chain = count_down(1000)
    stdout.print(total(chain), total(.Link(5, chain)) - total(chain))
    match chain:
        case .Link(first, .Link(second, _)):
            stdout.print(first, second)
        case _:
            stdout.print("short")
