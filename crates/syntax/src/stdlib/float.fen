## `float`'s methods written in Fennec.
extend float:
    ## The float `text` writes, as `"1.5"`, `".5"`, `"-2e3"` or `"inf"`, with space around it. One too big
    ## to hold is infinity, and `"nan"` and `"inf"` read as NaN and infinity, as Python's and Rust's
    ## do. Anything else fails, saying what it was given.
    ##
    ## ```fennec
    ## assert float.parse("-2e3")? == -2000.0
    ## assert float.parse("1,5") fails InvalidValue()
    ## ```
    def parse(text: str) -> float fails InvalidValue:
        return float(text)?

    ## Writes the float for `json.dumps`, `pack.dumps` and the rest, which call it.
    ## ```fennec
    ## from std import json
    ## assert json.dumps(1.5) == "1.5"
    ## ```
    def serialize(self, ref out: Serializer):
        out.float(self)

    ## Reads a float for `json.loads`, `pack.loads` and the rest, which call it.
    ## ```fennec
    ## from std import json
    ## assert json.loads[float]("1.5")? == 1.5
    ## ```
    def deserialize(ref src: Deserializer) -> float fails ParseError:
        return src.float()?

## `float`'s methods the compiler gives. Each is declared here for its signature and its doc, and a
## test holds it to the checker's own.
extend float:
    ## The number without its sign: `abs(-1.5)` calls it, and is 1.5.
    @intrinsic
    def abs(self) -> float

    ## Whether it's NaN, the one float not equal to itself.
    @intrinsic
    def is_nan(self) -> bool
