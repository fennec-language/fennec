from std.concurrent import Crashed

struct Tally:
    name = "none yet"
    total = 0

# Waiting inside a lock is refused when the program is checked, so the only way a task in a lock
# could be parked is a long loop's turn.
def names(counts: shared Tally):
    lock counts as ref current:
        current.name = "a name that is long enough to need a block of its own"

def runs_long(counts: shared Tally):
    lock counts as ref current:
        mut total = 0
        mut turn = 0
        while turn < 300000000:
            turn += 1
            total += turn % 3
        current.total = total

def main(stdout: Stdout) fails Crashed:
    shared counts = Tally()
    with launch(() => names(counts))?:
        with launch(() => names(counts))?:
            pass
    with launch(() => runs_long(counts))?:
        with launch(() => runs_long(counts))?:
            pass
    lock counts as current:
        stdout.print(current.name, current.total)
