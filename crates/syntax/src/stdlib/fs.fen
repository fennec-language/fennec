from std.intrinsics import bytes_builder, bytes_push_bytes

## What `fs.metadata(path)` finds out about a file or folder: its size in bytes, and whether
## it's a file or a folder. A folder's size depends on the system.
export struct Metadata:
    size: int
    is_file: bool
    is_dir: bool

## The file system: what reads and writes files and folders, given to `main` or a test. Its
## methods written in Rust are `read_text(path)`, `write_text(path, text)`, `read_bytes`,
## `write_bytes`, `exists`, `list_dir`, `walk`, `make_dir`, `remove` and `metadata`. Each takes a
## `Path` or a `str` and fails with an `IoError`. Only `main` and tests are given one: it can't be
## made.
export struct Fs:
    _given: int

    ## A new file at `path` to write, in place of any file there, lent for a `with` block:
    ## `with fs.create("save.txt")? as file:`. What's written goes to the file when the block
    ## ends, all at once, and a failure writing it is the `with` line's. A block that fails writes
    ## nothing, so there's never half a file.
    def create(self, path: str) -> with File fails IoError:
        file = File.to_write(path)
        lend file
        self.write_bytes(path, file.written())?

    ## The file at `path` to read, lent for a `with` block: `with fs.open("save.txt")? as file:`.
    def open(self, path: str) -> with File fails IoError:
        data = self.read_bytes(path)?
        lend File.to_read(path, data)

## A file lent by `fs.create`, for writing, or by `fs.open`, for reading, for the length of a
## `with` block, which ends with it closed. It's `shared`, so what the block writes is still there
## for `fs.create` to write out when the block ends.
export shared File:
    _path: str
    _writing = False
    _data = bytes([])
    _parts = list[bytes]()

    ## A file to write at `path`, as `fs.create` lends one. Nothing reaches the disk but through
    ## `fs.create`.
    def to_write(path: str) -> File:
        File(_path=path, _writing=True)

    ## A file to read, holding `data`, as `fs.open` lends one.
    def to_read(path: str, data: bytes) -> File:
        File(_path=path, _data=data)

    ## Where it is, as it was asked for.
    def path(self) -> str:
        self._path

    ## Writes `text`, as its UTF-8 bytes.
    def write_text(ref self, text: str) fails IoError:
        self.write_bytes(text.encode())?

    ## Writes `text`, then a line break.
    def write_line(ref self, text: str) fails IoError:
        self.write_bytes(text.encode())?
        self.write_bytes("\n".encode())?

    def write_bytes(ref self, data: bytes) fails IoError:
        if not self._writing: fail IoError(reason=f"{self._path} was opened to read, not to write")
        self._parts.append(data)

    ## Everything written so far, in order.
    def written(self) -> bytes:
        mut all = bytes_builder()
        for part in self._parts:
            bytes_push_bytes(ref all, part)
        all

    ## All that's in it, as text.
    def read_text(self) -> str fails IoError:
        data = self.read_bytes()?
        data.decode() else fail IoError(reason=f"{self._path} isn't UTF-8 text")

    def read_bytes(self) -> bytes fails IoError:
        if self._writing: fail IoError(reason=f"{self._path} was made to write, not to read")
        self._data

    ## Its lines, without their line breaks.
    def lines(self) -> list[str] fails IoError:
        self.read_text()?.lines()
