## Chained method calls on small structs, each making a new value: the Mandelbrot set again, written
## the way someone would write it with a complex number type.

struct Complex:
    re: float
    im: float

    def plus(self, other: Complex) -> Complex:
        Complex(re=self.re + other.re, im=self.im + other.im)

    def times(self, other: Complex) -> Complex:
        Complex(
            re=self.re * other.re - self.im * other.im,
            im=self.re * other.im + self.im * other.re,
        )

    def norm(self) -> float:
        self.re * self.re + self.im * self.im

def iterations(c: Complex, limit: int) -> int:
    mut z = Complex(re=0.0, im=0.0)
    for i in range(limit):
        if z.norm() > 4.0: return i
        z = z.times(z).plus(c)
    limit

def main(stdout: Stdout):
    size = 200
    mut total = 0
    for y in range(size):
        ci = 2.0 * float(y) / float(size) - 1.0
        for x in range(size):
            cr = 2.0 * float(x) / float(size) - 1.5
            total += iterations(Complex(re=cr, im=ci), 100)
    stdout.print(total)
