# A function failing with more than one type of error, and what each error turns into as it goes
# up: through `?`, through `return`, through a plain copy, shown, and matched by its type.

error Short:
    why: str

error Coded:
    code: int

error Held:
    items: list[int]
    table: dict[str, int]

def short(n: int) -> int fails Short:
    if n > 1: fail Short(why="too big")
    return n

def coded(n: int) -> int fails Coded:
    if n > 1: fail Coded(code=n)
    return n

def held(n: int) -> int fails Held:
    if n > 1: fail Held(items=[n, n], table={"k": n})
    return n

def short_or_coded(n: int) -> int fails Coded | Short:
    first = short(n)?
    second = coded(n + 1)?
    return first + second

def any_of_three(n: int) -> int fails Coded | Held | Short:
    first = short_or_coded(n)?
    second = held(n + 2)?
    return first + second

def by_return(n: int) -> int fails Coded | Short:
    if n > 5: return short(n)?
    return coded(n)?

def by_copy(n: int) -> str:
    if n > 0:
        value = short_or_coded(n) except error:
            return f"{error}"
        return f"{value}"
    value = short(n) except error:
        return f"{error}"
    return f"{value}"

def in_a_loop(n: int) -> int fails Coded | Held | Short:
    for step in range(3):
        value = short_or_coded(n + step)?
        if value > 100: return held(value)?
    if n > 9: return coded(n)?
    return n

def check_short(n: int) fails Short:
    if n > 1: fail Short(why="no")

def check_coded(n: int) fails Coded:
    if n > 1: fail Coded(code=n)

def nothing_back(n: int) fails Coded | Short:
    check_short(n - 1)?
    check_coded(n)?

## Prints what a call gave, or what it failed with.
def shown(stdout: Stdout, run: () -> int fails Coded | Held | Short):
    value = run() except error:
        stdout.print(error)
        return
    stdout.print(value)

def main(stdout: Stdout):
    for n in [-1, 0, 1, 2]:
        shown(stdout, () => any_of_three(n)?)
        by_return_value = by_return(n) except Coded() | Short(): -1
        stdout.print(by_return_value, by_copy(n))
    for n in [0, 1, 2]:
        value = short_or_coded(n) except why:
            case Short(why):
                stdout.print(f"short {why}")
                continue
            case Coded(code):
                stdout.print(f"coded {code}")
                continue
        stdout.print(value)
    for n in [-5, -4, 0, 1, 20]:
        value = in_a_loop(n) except error:
            stdout.print(error)
            stdout.print(f"{error}")
            stdout.print([error])
            kept = error
            stdout.print(kept)
            continue
        stdout.print(value)
    nothing_back(2) except failure:
        stdout.print(failure)
    value = by_return(6) except error:
        stdout.print(error)
        return
    stdout.print(value)
