## Tests that can move out of a loop, characters, and division with nothing negative.

def pick(flag: bool, n: int) -> int:
    mut total = 0
    for i in range(n):
        total += i if flag else -i
        if not flag:
            total += 1
        elif i == 2:
            break
    total

def both(flag: bool, other: bool) -> str:
    mut out = ""
    for i in range(3):
        out += "y" if flag else "n"
        if other:
            out += "o"
    out

def shadow(flag: bool) -> int:
    mut n = 0
    for i in range(3):
        n += 1 if flag else 2
        flag2 = i > 0
        if flag2:
            n += 10
    n

def early(flag: bool) -> int:
    for i in range(5):
        if flag: return i
    -1

def chars(text: str) -> int:
    mut n = 0
    for char in text:
        if char == "a":
            n += 1
        elif char == "é":
            n += 10
        elif char != "b":
            n += 100
    n

def main(stdout: Stdout):
    stdout.print(
        pick(True, 5),
        pick(False, 5),
        both(True, other=False),
        both(False, other=True),
        shadow(True),
        early(True),
        early(False),
    )
    stdout.print(chars("abécé"), chars("aaa"), chars(""))
    mut kept = ""
    for char in "héllo wörld":
        kept += char
        same = char
        shout = same + "!"
        stdout.print(same, shout, same == "é", char == kept[-1])
    for i in range(0, 12, 5):
        stdout.print(i % 3, i // 3, i % 4, i // 4)
    picked = "x" if len0() > 0 else "y"
    stdout.print(picked, picked == "y", picked + "z")
    mut alternative = "p" if picked == "y" else "q"
    alternative += "r"
    stdout.print(alternative)
    for n in range(-3, 3):
        stdout.print(n % 3, n // 3)

def len0() -> int:
    "".len()
