# `dict` and `set` have methods written in Fennec, on what the engines provide.

struct Tile:
    x: int
    y: int

def main(stdout: Stdout):
    mut stock = {"bolt": 3, "nut": 5}
    stock.update({"nut": 7, "gear": 1})
    stdout.print(stock)
    stock.update({})
    stdout.print(stock.setdefault("bolt", 100), stock.setdefault("cog", 2), stock)
    # `remove` takes a key that may not be there, where `pop` fails like `stock[key]`.
    stdout.print(stock.remove("cog"), stock.remove("cog"), stock.remove("wheel") else 0, stock)

    mut groups: dict[int, list[str]] = {}
    for word in ["a", "bb", "c", "dd"]:
        mut words = groups.setdefault(len(word), [])
        words.append(word)
        groups[len(word)] = words
    stdout.print(groups)

    evens = {2, 4, 6}
    small = {1, 2, 3, 4}
    stdout.print(evens.union(small), small.union(evens))
    stdout.print(evens.intersection(small), small.intersection(evens))
    stdout.print(evens.difference(small), small.difference(evens))
    stdout.print({2, 4}.is_subset(evens), evens.is_subset({2, 4}), evens.is_subset(evens))
    stdout.print(evens.is_superset({2, 4}), {2, 4}.is_superset(evens))
    stdout.print(evens.is_disjoint({1, 3}), evens.is_disjoint(small), evens.is_disjoint(set()))

    mut seen = {1}
    seen.update({1, 2})
    seen.update(set())
    none: set[int] = set()
    stdout.print(seen, none.union(none), none.is_subset(evens), evens)

    # They work for any items a set can hold, and don't change what they're called on.
    here = {Tile(x=0, y=0), Tile(x=1, y=0)}
    there = {Tile(x=1, y=0)}
    stdout.print(here.difference(there), here.intersection(there), len(here.union(there)))
    names = {"ash", "kit"}
    stdout.print(names.union({"vex"}), names)
