# decision: `Secret[str]` in `std.crypto` holds text that can't be printed, logged or saved.
#
# A `Secret` holds a password, a token or a key. Printing one, putting it in an f-string, making
# text of it with `str()` and saving it are compile errors, as `examples/errors/secret_*.fen`
# show, and so is showing anything that holds one. What it holds comes out only through
# `expose_secret()`, so searching for that name finds every place a secret is read. `==` on two
# secrets compares them in constant time.
from std.crypto import Secret
from std.net import Certificate

struct Login:
    name: str
    password: Secret[str]

## Prints whatever it's given, as generic code does, knowing nothing of secrets.
def shown[T](value: T, stdout: Stdout):
    stdout.print(value)

## Whether a password is right. `==` on secrets takes as long wherever they differ, so its
## timing never says how much of a guess was right.
def accepts(login: Login, typed: str) -> bool:
    return login.password == Secret.of(typed)

def main(stdout: Stdout):
    login = Login(name="ana", password=Secret.of("hunter2"))
    stdout.print(login.name, accepts(login, typed="hunter2"), accepts(login, typed="hunter3"))
    # Through a `T`, it shows only that it's there.
    shown(login.password, stdout)
    shown([login.password], stdout)
    key = Secret.of(bytes([1, 2, 3]))
    stdout.print(len(key.expose_secret()))
    stdout.print(key == Secret.of(bytes([1, 2, 3])), key != Secret.of(bytes([1, 2])))
    # A struct holding one compares it in constant time too.
    stdout.print(login == Login(name="ana", password=Secret.of("hunter2")))
    # A server's private key is a secret too, beside the chain of certificates it goes with.
    certificate = Certificate(
        chain="-----BEGIN CERTIFICATE-----",
        key=Secret.of("-----BEGIN PRIVATE KEY-----"),
    )
    stdout.print(len(certificate.chain))
    shown(certificate.key, stdout)
