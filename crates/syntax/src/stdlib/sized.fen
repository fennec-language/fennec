    ## The u16 `text` writes, or an `InvalidValue` when it isn't a whole number or doesn't fit.
    def parse(text: str) -> u16 fails InvalidValue:
        return u16.from(int(text)?)?

    ## `self + other`, wrapping round past either end, as a u16's bits do.
    def wrapping_add(self, other: u16) -> u16:
        return u16((int(self) + int(other)) % 65536)

    ## `self - other`, wrapping round past either end, as a u16's bits do.
    def wrapping_sub(self, other: u16) -> u16:
