# `std.string`: wrapping and indenting text, as Python's `textwrap` does, and the sets of
# characters Python's `string` names. Most of what's done to text is a method of `str`.
from std.intrinsics import stop

## `text` as an error quotes what it was given: whole, in backticks, or past 40 characters, its first
## 20 and `…` in backticks, then how long it was, as in "`12345678901234567890…` (5,000
## characters)". Text from outside can be as long as it likes, and this way it can't make a
## message as long as itself. Its control characters are written as escapes. For std's own
## messages, not exported.
def quoted_input(text: str) -> str:
    if text.len() <= 40: return f"`{escaped(text)}`"
    return f"`{escaped(text[0:20])}…` ({text.len():,} characters)"

## `text` as a message names a key or a part of a path from outside: whole, or past 40
## characters, its first 20 and `…`, with its control characters written as escapes.
def cut_input(text: str) -> str:
    if text.len() <= 40: return escaped(text)
    return escaped(text[0:20]) + "…"

## `text` with each control character written as an escape, as `\n` or `\u{1b}`, so text from
## outside can't break a message's line, or send a terminal or a log its codes.
def escaped(text: str) -> str:
    mut plain = True
    for c in text:
        code = c.code()
        if code < 32 or (code >= 127 and code < 160):
            plain = False
            break
    if plain: return text
    hex = "0123456789abcdef"
    mut out = ""
    for c in text:
        code = c.code()
        if c == "\n":
            out += "\\n"
        elif c == "\r":
            out += "\\r"
        elif c == "\t":
            out += "\\t"
        elif code < 32 or (code >= 127 and code < 160):
            out += "\\u{" + hex[code // 16] + hex[code % 16] + "}"
        else:
            out += c
    return out

export ASCII_LOWERCASE = "abcdefghijklmnopqrstuvwxyz"
export ASCII_UPPERCASE = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
export ASCII_LETTERS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
export DIGITS = "0123456789"
export HEX_DIGITS = "0123456789abcdefABCDEF"
export OCT_DIGITS = "01234567"
export PUNCTUATION = "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"
export WHITESPACE = " \t\n\r\x0b\x0c"

## `text`'s words in lines of at most `width` characters, as many on each line as fit. Words
## are what's between spaces, tabs and line breaks, and a word longer than `width` is broken
## across lines. Text with no words gives no lines. A `width` under 1 can't hold any text, so
## it's a bug in the program, as Python says too.
export def wrap(text: str, width: int) -> list[str]:
    if width < 1:
        stop(f"a width of {width} can't hold any text: wrap takes 1 or more")
    mut lines = list[str]()
    mut line = ""
    for word in text.split():
        mut rest = word
        while rest.len() > width:
            if line != "":
                lines.append(line)
                line = ""
            lines.append(rest[:width])
            rest = rest[width:]
        if rest == "": continue
        if line == "":
            line = rest
        elif line.len() + 1 + rest.len() <= width:
            line = line + " " + rest
        else:
            lines.append(line)
            line = rest
    if line != "":
        lines.append(line)
    lines

## `text` wrapped to `width`, as `wrap` does it, with its lines joined by line breaks.
export def fill(text: str, width: int) -> str:
    "\n".join(wrap(text, width=width))

## `text` with the spaces and tabs every line starts with taken off, so text indented to sit
## inside code can be written flush. Lines of only spaces and tabs don't count, and come out
## empty.
export def dedent(text: str) -> str:
    lines = text.split("\n")
    mut common = ""
    mut first = True
    for line in lines:
        if line.strip() == "": continue
        lead = line[:line.len() - line.lstrip().len()]
        if first:
            common = lead
            first = False
        else:
            mut size = 0
            while size < lead.len() and size < common.len() and lead[size] == common[size]:
                size += 1
            common = common[:size]
    cut = common.len()
    "\n".join(["" if line.strip() == "" else line[cut:] for line in lines])

## `text` with `prefix` before each line that isn't empty or only spaces and tabs.
export def indent(text: str, prefix: str) -> str:
    "\n".join([line if line.strip() == "" else prefix + line for line in text.split("\n")])
