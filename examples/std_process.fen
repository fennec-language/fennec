# `std.process` runs other programs through the `Process` capability. Arguments are always a
# list, so nothing in them is read by a shell. `input=` is what the program reads from its
# standard input, `cwd=` the folder it runs in, and `env=` variables it gets on top of this
# program's own. In a test, `Process` is a fake that runs nothing and gives back what the test
# scripted.
from std.process import Output, ProcessError

## The commits since `tag`, one a line, newest first.
def changes(process: Process, tag: str) -> list[str] fails ProcessError:
    found = process.run("git", ["log", "--format=%s", f"{tag}..HEAD"])?
    if not found.ok(): return []
    [line for line in found.stdout.split("\n") if line != ""]

def notes(process: Process, tag: str) -> str:
    lines = changes(process, tag) else []
    if lines.len() == 0: return "nothing new"
    "\n".join([f"- {line}" for line in lines])

test "the release notes list each commit"(process: Process):
    process.script("git", Output(stdout="Add Tree\nFix a typo\n"))
    assert notes(process, "v0.1") == "- Add Tree\n- Fix a typo"
    assert process.ran() == [["git", "log", "--format=%s", "v0.1..HEAD"]]

test "a failing program is its status, not an error"(process: Process):
    process.script("git", Output(status=128, stderr="fatal: bad revision"))
    assert notes(process, "nope") == "nothing new"

test "a program nothing scripted can't run"(process: Process):
    match process.run("cargo", ["build"]):
        case Err(ProcessError(program=program, message=message)):
            assert program == "cargo"
            assert message.startswith("the test's fake Process has nothing scripted for `cargo`")
        case Ok(_):
            assert False
    assert process.ran() == [["cargo", "build"]]

test "an argument with spaces or quotes is one argument"(process: Process):
    process.script("echo", Output(stdout="ok"))
    _ = process.run("echo", ["a b", "'c'", "$(rm -rf /)"])?
    assert process.ran() == [["echo", "a b", "'c'", "$(rm -rf /)"]]

## How many lines of `text` say `word`, as grep counts them.
def count_lines(process: Process, text: str, word: str) -> int:
    found = process.run("grep", ["-c", word], input=text, env={"LC_ALL": "C"}) else Output()
    int(found.stdout.strip()) else 0

test "grep is given the text to read"(process: Process):
    process.script("grep", Output(stdout="2\n"))
    assert count_lines(process, text="a fox\na dog\nfoxes\n", word="fox") == 2
    assert process.ran() == [["grep", "-c", "fox"]]

def main(stdout: Stdout, process: Process):
    # A program that isn't installed fails with a `ProcessError` value.
    match process.run("fennec-no-such-program", []):
        case Err(ProcessError(program=program)):
            stdout.print(f"couldn't run {program}")
        case Ok(_):
            stdout.print("ran")
