## Building a long string piece by piece, then scanning it.

def main(stdout: Stdout, clock: Clock, args: Args):
    started = clock.now()
    mut text = ""
    for i in range(2_000_000):
        text += "fennec " if i % 3 == 0 else "fox "
    mut spaces = 0
    for c in text:
        if c == " ":
            spaces += 1
    stdout.print(text.len(), spaces)
    if args.len() > 0:
        stdout.print("kernel-ns", (clock.now() - started).nanos)
