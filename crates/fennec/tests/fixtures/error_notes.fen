error Missing:
    path: str

error Broken:
    code: int
    why: str

def load(path: str) -> int fails Missing:
    if path == "": fail Missing(path="(none)")
    return len(path)

def parse(n: int) -> int fails Broken:
    if n > 3: fail Broken(code=n, why="too long")
    return n

def both(path: str) -> int fails Missing | Broken:
    return parse(load(path)?)?

def noted(path: str) -> int fails Missing | Broken:
    n = both(path) except problem:
        mut kept = problem
        kept.add_note(f"while loading {path}")
        kept.add_note("second line\nand a third")
        fail kept
    return n

## Prints what `noted` gave, or the notes on what it failed with and the failure.
def shown(stdout: Stdout, path: str):
    n = noted(path) except problem:
        stdout.print(problem.notes(), problem)
        return
    stdout.print(n)

def main(stdout: Stdout) fails Missing | Broken:
    _ = load("") except missing:
        mut m = missing
        stdout.print(m.notes(), m)
        m.add_note("first")
        copy = m
        m.add_note("second")
        stdout.print(m.notes(), copy.notes(), m == copy, m)
        stdout.print(f"{m}", str(m))
        0
    shown(stdout, "long name")
    stdout.print(noted("ab")?)
    stdout.print(noted("a long one")?)
