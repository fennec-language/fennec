## `std.sqlite`: a SQLite database in a file, through the `Fs` it's in, with `std.sql`'s queries.
##
## ```fennec
## from std import sqlite
##
## with sqlite.open(fs, ".hoard/index.db")? as db:
##     db.execute(t"create table if not exists entries (path text primary key, hash text)")?
##     with db.transaction()? as tx:
##         tx.execute(t"insert into entries values ({path}, {hash})")?
##     rows = db.query[Entry](t"select path, hash from entries where path = {path}")?
## ```
##
## A database is opened in WAL mode, so reads go on while something writes, and every commit is
## on the disk before it's done, as `fs.create`'s files are. Tasks in a `parallel` loop may share
## one: each query runs whole, one at a time, and each transaction has a connection of its own.
## In a task, the database's waits pause only that task.
##
## A transaction takes the database's one writer when it starts, so two never undo each other's
## work, and another writer waits up to 5 seconds for it before failing with `Busy`.
##
## In a test, each path is a database of the test's own, fresh for each test, in a temporary
## folder that's gone when the test ends. It's a WAL file as a real one is, so a test sees what a
## program would. `--real` uses the paths themselves.

from std.sql import SqlError, SqlRows, SqlValue, rows_as

## The database at `path`, made if it isn't there, lent for a `with` block:
## `with sqlite.open(fs, "index.db")? as db:`. It's closed when the block ends.
export def open(fs: Fs, path: str) -> with Database fails SqlError:
    db = opened(fs, path)?
    lend db else:
        db._close()
    db._close()

def opened(fs: Fs, path: str) -> Database fails SqlError:
    fs._sqlite_open(path) else as err:
        fail .Failed(reason=err.reason)

## A SQLite database, lent by `sqlite.open`. Its methods written in Rust, each private to it, run
## what the methods below give them.
export struct Database:
    _handle: int

    ## Runs a query that changes something, like an `insert`, and gives how many rows it changed.
    def execute(self, query: Template[SqlValue]) -> int fails SqlError:
        sent = statement(query)
        self._execute(sent.text, sent.kinds, sent.ints, sent.floats, sent.texts, sent.blobs)?

    ## Runs a query and gives each row it found as a `T`: a struct's fields by the columns' names,
    ## or one column's value as an `int`, `str` or the like.
    def query[T: Deserializable](self, query: Template[SqlValue]) -> list[T] fails SqlError:
        sent = statement(query)
        rows = self._query(sent.text, sent.kinds, sent.ints, sent.floats, sent.texts, sent.blobs)?
        rows_as[T](rows)?

    ## A transaction, lent for a `with` block: `with db.transaction()? as tx:`. What it changes is
    ## kept when the block ends, and none of it if the block fails.
    def transaction(self) -> with Transaction fails SqlError:
        tx = self._begin()?
        lend tx else:
            tx._rollback()
        tx._commit()?

## A transaction, lent by `db.transaction()`. Its queries see what it's changed so far, and the
## rest of the program sees none of it until it's kept.
export struct Transaction:
    _handle: int

    ## Runs a query that changes something, like an `insert`, and gives how many rows it changed.
    def execute(self, query: Template[SqlValue]) -> int fails SqlError:
        sent = statement(query)
        self._execute(sent.text, sent.kinds, sent.ints, sent.floats, sent.texts, sent.blobs)?

    ## Runs a query and gives each row it found as a `T`, as `Database.query` does.
    def query[T: Deserializable](self, query: Template[SqlValue]) -> list[T] fails SqlError:
        sent = statement(query)
        rows = self._query(sent.text, sent.kinds, sent.ints, sent.floats, sent.texts, sent.blobs)?
        rows_as[T](rows)?

## A query as SQLite takes it: the template's text with a `?` for each value, and the values
## apart, each in the list of its kind, with `kinds` saying which: 0 for an `int`, 1 a `float`, 2
## a `str` and 3 `bytes`.
struct SqliteStatement:
    text: str
    kinds: list[int]
    ints: list[int]
    floats: list[float]
    texts: list[str]
    blobs: list[bytes]

def statement(query: Template[SqlValue]) -> SqliteStatement:
    mut text = ""
    for at, part in enumerate(query.strings):
        text += part
        if at < query.values.len():
            text += "?"
    mut sent = SqliteStatement(text=text, kinds=[], ints=[], floats=[], texts=[], blobs=[])
    # Each `is` on its own, with no `else`, so each narrows the value to one type.
    for value in query.values:
        if value is int:
            sent.kinds.append(0)
            sent.ints.append(value)
        if value is bool:
            sent.kinds.append(0)
            sent.ints.append(1 if value else 0)
        if value is float:
            sent.kinds.append(1)
            sent.floats.append(value)
        if value is str:
            sent.kinds.append(2)
            sent.texts.append(value)
        if value is bytes:
            sent.kinds.append(3)
            sent.blobs.append(value)
    sent
