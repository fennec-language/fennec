struct Pool:
    items: list[int]
    head = 0

    def len(self) -> int:
        return len(self.items)

    def [](ref self, i: int) -> int:
        return self.items[(self.head + i) % len(self.items)]

def main(stdout: Stdout):
    mut pool = Pool(items=[1])
    for ref item in parallel(pool):
        item += 1
    stdout.print(len(pool))
