## `in` and `not in` on a list or set written out of constants, strings or ints, which only that
## test reads: each item compared, none made, and the answers are what a made one gives.
def is_keyword(word: str) -> bool:
    word in {"def", "if", "else", "return", "a keyword much longer than eight bytes", ""}

def is_two_char(text: str) -> bool:
    text in ["->", "=>", "==", "!=", "<=", ">="]

def is_small_prime(n: int) -> bool:
    n not in [2, 3, 5, 7, 11, 13]

def main(stdout: Stdout):
    long = "a keyword much longer than eight bytes"
    for word in ["def", "de", "deff", "", long, f"{long}!", "else", "return"]:
        stdout.print(word, is_keyword(word), is_two_char(word))
    for text in ["->", "=", "<=", ">=>"]:
        stdout.print(text, is_two_char(text))
    stdout.print([n for n in range(15) if is_small_prime(n)])
