# Each sized integer's and int's wrapping and saturating add, sub and mul, worked out natively,
# checked against the standard library's own Fennec for it (sized.fen, int.fen), copied here as plain
# functions that nothing works out natively: every pair of edge values and a spread between.

def i8_wrapping_add(left: i8, right: i8) -> i8:
    return i8((int(left) + int(right) + 128) % 256 - 128)

def i8_wrapping_sub(left: i8, right: i8) -> i8:
    return i8((int(left) - int(right) + 128) % 256 - 128)

def i8_wrapping_mul(left: i8, right: i8) -> i8:
    return i8((int(left) * int(right) + 128) % 256 - 128)

def i8_saturating_add(left: i8, right: i8) -> i8:
    whole = int(left) + int(right)
    if whole < -128: return i8(-128)
    if whole > 127: return i8(127)
    return i8(whole)

def i8_saturating_sub(left: i8, right: i8) -> i8:
    whole = int(left) - int(right)
    if whole < -128: return i8(-128)
    if whole > 127: return i8(127)
    return i8(whole)

def i8_saturating_mul(left: i8, right: i8) -> i8:
    whole = int(left) * int(right)
    if whole < -128: return i8(-128)
    if whole > 127: return i8(127)
    return i8(whole)

def check_i8(stdout: Stdout) -> int:
    mut values = [-128, -128 + 1, -1 if -128 < 0 else 1, 0, 1, 2, 127 - 1, 127]
    mut seed = 7
    for _ in range(24):
        seed = (seed * 1103515245 + 12345) % 2147483648
        values.append(seed % 256 + (-128))
    mut wrong = 0
    for x in values:
        for y in values:
            (a, b) = (i8(x), i8(y))
            got = [a.wrapping_add(b), a.wrapping_sub(b), a.wrapping_mul(b), a.saturating_add(b), a.saturating_sub(b), a.saturating_mul(b)]
            wanted = [i8_wrapping_add(a, right=b), i8_wrapping_sub(a, right=b), i8_wrapping_mul(a, right=b), i8_saturating_add(a, right=b), i8_saturating_sub(a, right=b), i8_saturating_mul(a, right=b)]
            if got != wanted:
                stdout.print("i8 differs at", x, y, got, wanted)
                wrong += 1
    return wrong

def i16_wrapping_add(left: i16, right: i16) -> i16:
    return i16((int(left) + int(right) + 32768) % 65536 - 32768)

def i16_wrapping_sub(left: i16, right: i16) -> i16:
    return i16((int(left) - int(right) + 32768) % 65536 - 32768)

def i16_wrapping_mul(left: i16, right: i16) -> i16:
    return i16((int(left) * int(right) + 32768) % 65536 - 32768)

def i16_saturating_add(left: i16, right: i16) -> i16:
    whole = int(left) + int(right)
    if whole < -32768: return i16(-32768)
    if whole > 32767: return i16(32767)
    return i16(whole)

def i16_saturating_sub(left: i16, right: i16) -> i16:
    whole = int(left) - int(right)
    if whole < -32768: return i16(-32768)
    if whole > 32767: return i16(32767)
    return i16(whole)

def i16_saturating_mul(left: i16, right: i16) -> i16:
    whole = int(left) * int(right)
    if whole < -32768: return i16(-32768)
    if whole > 32767: return i16(32767)
    return i16(whole)

def check_i16(stdout: Stdout) -> int:
    mut values = [-32768, -32768 + 1, -1 if -32768 < 0 else 1, 0, 1, 2, 32767 - 1, 32767]
    mut seed = 7
    for _ in range(24):
        seed = (seed * 1103515245 + 12345) % 2147483648
        values.append(seed % 65536 + (-32768))
    mut wrong = 0
    for x in values:
        for y in values:
            (a, b) = (i16(x), i16(y))
            got = [a.wrapping_add(b), a.wrapping_sub(b), a.wrapping_mul(b), a.saturating_add(b), a.saturating_sub(b), a.saturating_mul(b)]
            wanted = [i16_wrapping_add(a, right=b), i16_wrapping_sub(a, right=b), i16_wrapping_mul(a, right=b), i16_saturating_add(a, right=b), i16_saturating_sub(a, right=b), i16_saturating_mul(a, right=b)]
            if got != wanted:
                stdout.print("i16 differs at", x, y, got, wanted)
                wrong += 1
    return wrong

def i32_wrapping_add(left: i32, right: i32) -> i32:
    return i32((int(left) + int(right) + 2147483648) % 4294967296 - 2147483648)

def i32_wrapping_sub(left: i32, right: i32) -> i32:
    return i32((int(left) - int(right) + 2147483648) % 4294967296 - 2147483648)

def i32_wrapping_mul(left: i32, right: i32) -> i32:
    return i32((int(left) * int(right) + 2147483648) % 4294967296 - 2147483648)

def i32_saturating_add(left: i32, right: i32) -> i32:
    whole = int(left) + int(right)
    if whole < -2147483648: return i32(-2147483648)
    if whole > 2147483647: return i32(2147483647)
    return i32(whole)

def i32_saturating_sub(left: i32, right: i32) -> i32:
    whole = int(left) - int(right)
    if whole < -2147483648: return i32(-2147483648)
    if whole > 2147483647: return i32(2147483647)
    return i32(whole)

def i32_saturating_mul(left: i32, right: i32) -> i32:
    whole = int(left) * int(right)
    if whole < -2147483648: return i32(-2147483648)
    if whole > 2147483647: return i32(2147483647)
    return i32(whole)

def check_i32(stdout: Stdout) -> int:
    mut values = [-2147483648, -2147483648 + 1, -1 if -2147483648 < 0 else 1, 0, 1, 2, 2147483647 - 1, 2147483647]
    mut seed = 7
    for _ in range(24):
        seed = (seed * 1103515245 + 12345) % 2147483648
        values.append(seed % 4294967296 + (-2147483648))
    mut wrong = 0
    for x in values:
        for y in values:
            (a, b) = (i32(x), i32(y))
            got = [a.wrapping_add(b), a.wrapping_sub(b), a.wrapping_mul(b), a.saturating_add(b), a.saturating_sub(b), a.saturating_mul(b)]
            wanted = [i32_wrapping_add(a, right=b), i32_wrapping_sub(a, right=b), i32_wrapping_mul(a, right=b), i32_saturating_add(a, right=b), i32_saturating_sub(a, right=b), i32_saturating_mul(a, right=b)]
            if got != wanted:
                stdout.print("i32 differs at", x, y, got, wanted)
                wrong += 1
    return wrong

def u8_wrapping_add(left: u8, right: u8) -> u8:
    return u8((int(left) + int(right)) % 256)

def u8_wrapping_sub(left: u8, right: u8) -> u8:
    return u8((int(left) - int(right)) % 256)

def u8_wrapping_mul(left: u8, right: u8) -> u8:
    return u8((int(left) * int(right)) % 256)

def u8_saturating_add(left: u8, right: u8) -> u8:
    whole = int(left) + int(right)
    if whole < 0: return u8(0)
    if whole > 255: return u8(255)
    return u8(whole)

def u8_saturating_sub(left: u8, right: u8) -> u8:
    whole = int(left) - int(right)
    if whole < 0: return u8(0)
    if whole > 255: return u8(255)
    return u8(whole)

def u8_saturating_mul(left: u8, right: u8) -> u8:
    whole = int(left) * int(right)
    if whole < 0: return u8(0)
    if whole > 255: return u8(255)
    return u8(whole)

def check_u8(stdout: Stdout) -> int:
    mut values = [0, 0 + 1, -1 if 0 < 0 else 1, 0, 1, 2, 255 - 1, 255]
    mut seed = 7
    for _ in range(24):
        seed = (seed * 1103515245 + 12345) % 2147483648
        values.append(seed % 256 + (0))
    mut wrong = 0
    for x in values:
        for y in values:
            (a, b) = (u8(x), u8(y))
            got = [a.wrapping_add(b), a.wrapping_sub(b), a.wrapping_mul(b), a.saturating_add(b), a.saturating_sub(b), a.saturating_mul(b)]
            wanted = [u8_wrapping_add(a, right=b), u8_wrapping_sub(a, right=b), u8_wrapping_mul(a, right=b), u8_saturating_add(a, right=b), u8_saturating_sub(a, right=b), u8_saturating_mul(a, right=b)]
            if got != wanted:
                stdout.print("u8 differs at", x, y, got, wanted)
                wrong += 1
    return wrong

def u16_wrapping_add(left: u16, right: u16) -> u16:
    return u16((int(left) + int(right)) % 65536)

def u16_wrapping_sub(left: u16, right: u16) -> u16:
    return u16((int(left) - int(right)) % 65536)

def u16_wrapping_mul(left: u16, right: u16) -> u16:
    return u16((int(left) * int(right)) % 65536)

def u16_saturating_add(left: u16, right: u16) -> u16:
    whole = int(left) + int(right)
    if whole < 0: return u16(0)
    if whole > 65535: return u16(65535)
    return u16(whole)

def u16_saturating_sub(left: u16, right: u16) -> u16:
    whole = int(left) - int(right)
    if whole < 0: return u16(0)
    if whole > 65535: return u16(65535)
    return u16(whole)

def u16_saturating_mul(left: u16, right: u16) -> u16:
    whole = int(left) * int(right)
    if whole < 0: return u16(0)
    if whole > 65535: return u16(65535)
    return u16(whole)

def check_u16(stdout: Stdout) -> int:
    mut values = [0, 0 + 1, -1 if 0 < 0 else 1, 0, 1, 2, 65535 - 1, 65535]
    mut seed = 7
    for _ in range(24):
        seed = (seed * 1103515245 + 12345) % 2147483648
        values.append(seed % 65536 + (0))
    mut wrong = 0
    for x in values:
        for y in values:
            (a, b) = (u16(x), u16(y))
            got = [a.wrapping_add(b), a.wrapping_sub(b), a.wrapping_mul(b), a.saturating_add(b), a.saturating_sub(b), a.saturating_mul(b)]
            wanted = [u16_wrapping_add(a, right=b), u16_wrapping_sub(a, right=b), u16_wrapping_mul(a, right=b), u16_saturating_add(a, right=b), u16_saturating_sub(a, right=b), u16_saturating_mul(a, right=b)]
            if got != wanted:
                stdout.print("u16 differs at", x, y, got, wanted)
                wrong += 1
    return wrong

def u32_wrapping_add(left: u32, right: u32) -> u32:
    return u32((int(left) + int(right)) % 4294967296)

def u32_wrapping_sub(left: u32, right: u32) -> u32:
    return u32((int(left) - int(right)) % 4294967296)

def u32_wrapping_mul(left: u32, right: u32) -> u32:
    # In two halves of `right`, so no product is past what an `int` holds.
    (a, b) = (int(left), int(right))
    high = a * (b >> 16) % 4294967296
    return u32((high * 65536 + a * (b & 65535)) % 4294967296)

def u32_saturating_add(left: u32, right: u32) -> u32:
    whole = int(left) + int(right)
    if whole < 0: return u32(0)
    if whole > 4294967295: return u32(4294967295)
    return u32(whole)

def u32_saturating_sub(left: u32, right: u32) -> u32:
    whole = int(left) - int(right)
    if whole < 0: return u32(0)
    if whole > 4294967295: return u32(4294967295)
    return u32(whole)

def u32_saturating_mul(left: u32, right: u32) -> u32:
    (a, b) = (int(left), int(right))
    # Checked by division first, so no product is past what an `int` holds.
    if a != 0 and b > 4294967295 // a: return u32(4294967295)
    return u32(a * b)

def check_u32(stdout: Stdout) -> int:
    mut values = [0, 0 + 1, -1 if 0 < 0 else 1, 0, 1, 2, 4294967295 - 1, 4294967295]
    mut seed = 7
    for _ in range(24):
        seed = (seed * 1103515245 + 12345) % 2147483648
        values.append(seed % 4294967296 + (0))
    mut wrong = 0
    for x in values:
        for y in values:
            (a, b) = (u32(x), u32(y))
            got = [a.wrapping_add(b), a.wrapping_sub(b), a.wrapping_mul(b), a.saturating_add(b), a.saturating_sub(b), a.saturating_mul(b)]
            wanted = [u32_wrapping_add(a, right=b), u32_wrapping_sub(a, right=b), u32_wrapping_mul(a, right=b), u32_saturating_add(a, right=b), u32_saturating_sub(a, right=b), u32_saturating_mul(a, right=b)]
            if got != wanted:
                stdout.print("u32 differs at", x, y, got, wanted)
                wrong += 1
    return wrong

## u64's, against the standard library's own way of writing them in Fennec.
def u64_wrapping_add(a: u64, b: u64) -> u64:
    top = u64(9223372036854775807) * 2 + 1
    if a > top - b: return a - (top - b) - 1
    return a + b

def u64_wrapping_sub(a: u64, b: u64) -> u64:
    top = u64(9223372036854775807) * 2 + 1
    if b > a: return top - (b - a) + 1
    return a - b

def u64_wrapping_mul(a: u64, b: u64) -> u64:
    low = u64(4294967295)
    (a_low, a_high) = (a & low, a >> 32)
    (b_low, b_high) = (b & low, b >> 32)
    crossed = ((a_high * b_low) & low) + ((a_low * b_high) & low)
    return u64_wrapping_add(a_low * b_low, (crossed & low) << 32)

def u64_saturating_add(a: u64, b: u64) -> u64:
    top = u64(9223372036854775807) * 2 + 1
    if a > top - b: return top
    return a + b

def u64_saturating_sub(a: u64, b: u64) -> u64:
    if b > a: return u64(0)
    return a - b

def u64_saturating_mul(a: u64, b: u64) -> u64:
    top = u64(9223372036854775807) * 2 + 1
    if a != u64(0) and b > top // a: return top
    return a * b

def check_u64(stdout: Stdout) -> int:
    top = u64(9223372036854775807) * 2 + 1
    mut values = [u64(0), u64(1), u64(2), u64(4294967295), u64(4294967296), u64(9223372036854775807), top - u64(1), top]
    mut seed = u64(7)
    for _ in range(24):
        seed = u64_wrapping_add(u64_wrapping_mul(seed, u64(6364136223846793005)), u64(1442695040888963407))
        values.append(seed)
    mut wrong = 0
    for a in values:
        for b in values:
            got = [a.wrapping_add(b), a.wrapping_sub(b), a.wrapping_mul(b), a.saturating_add(b), a.saturating_sub(b), a.saturating_mul(b)]
            wanted = [u64_wrapping_add(a, b), u64_wrapping_sub(a, b), u64_wrapping_mul(a, b), u64_saturating_add(a, b), u64_saturating_sub(a, b), u64_saturating_mul(a, b)]
            if got != wanted:
                stdout.print("u64 differs at", a, b, got, wanted)
                wrong += 1
    return wrong

## int's, against the standard library's own Fennec for them (int.fen): wrapping through its 64 bits
## as a u64, saturating by compares.
def int_bits(value: int) -> u64:
    if value >= 0: return u64(value)
    return u64(value - (-9223372036854775807 - 1)) + u64(9223372036854775807) + 1

def int_of_bits(bits: u64) -> int:
    if bits <= u64(9223372036854775807): return int(bits)
    return int(bits - u64(9223372036854775807) - 1) + (-9223372036854775807 - 1)

def int_wrapping_add(left: int, right: int) -> int:
    return int_of_bits(u64_wrapping_add(int_bits(left), int_bits(right)))

def int_wrapping_sub(left: int, right: int) -> int:
    return int_of_bits(u64_wrapping_sub(int_bits(left), int_bits(right)))

def int_wrapping_mul(left: int, right: int) -> int:
    return int_of_bits(u64_wrapping_mul(int_bits(left), int_bits(right)))

def int_saturating_add(left: int, right: int) -> int:
    if right > 0 and left > 9223372036854775807 - right: return 9223372036854775807
    if right < 0 and left < -9223372036854775807 - 1 - right: return -9223372036854775807 - 1
    return left + right

def int_saturating_sub(left: int, right: int) -> int:
    if right < 0 and left > 9223372036854775807 + right: return 9223372036854775807
    if right > 0 and left < -9223372036854775807 - 1 + right: return -9223372036854775807 - 1
    return left - right

def int_saturating_mul(left: int, right: int) -> int:
    nearest = 9223372036854775807 if (left < 0) == (right < 0) else -9223372036854775807 - 1
    if left == -1:
        if right == -9223372036854775807 - 1: return nearest
        return -right
    wrapped = int_wrapping_mul(left, right=right)
    if left != 0 and wrapped // left != right: return nearest
    return wrapped

def check_int(stdout: Stdout) -> int:
    least = -9223372036854775807 - 1
    mut values = [least, least + 1, -4294967296, -4294967295, -3037000500, -2, -1, 0, 1, 2, 3037000499, 3037000500, 4294967295, 4294967296, 9223372036854775806, 9223372036854775807]
    mut seed = u64(11)
    for _ in range(16):
        seed = u64_wrapping_add(u64_wrapping_mul(seed, u64(6364136223846793005)), u64(1442695040888963407))
        values.append(int_of_bits(seed))
        values.append(int_of_bits(seed >> 31) - 4294967296)
    mut wrong = 0
    for a in values:
        for b in values:
            got = [a.wrapping_add(b), a.wrapping_sub(b), a.wrapping_mul(b), a.saturating_add(b), a.saturating_sub(b), a.saturating_mul(b)]
            wanted = [int_wrapping_add(a, right=b), int_wrapping_sub(a, right=b), int_wrapping_mul(a, right=b), int_saturating_add(a, right=b), int_saturating_sub(a, right=b), int_saturating_mul(a, right=b)]
            if got != wanted:
                stdout.print("int differs at", a, b, got, wanted)
                wrong += 1
    return wrong

def main(stdout: Stdout):
    stdout.print("i8", check_i8(stdout))
    stdout.print("i16", check_i16(stdout))
    stdout.print("i32", check_i32(stdout))
    stdout.print("u8", check_u8(stdout))
    stdout.print("u16", check_u16(stdout))
    stdout.print("u32", check_u32(stdout))
    stdout.print("u64", check_u64(stdout))
    stdout.print("int", check_int(stdout))
    return
