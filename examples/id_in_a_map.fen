# `id in map`: whether an `Id` still names something. An `Id` from a slot that's been used again doesn't.
from std.game import IdMap

struct Unit:
    health = 1

def main(stdout: Stdout):
    mut units = IdMap[Unit]()
    first = units.insert(Unit())
    second = units.insert(Unit(health=2))
    stdout.print(first in units, second not in units)
    gone = units.remove(first)
    stdout.print(first in units, second in units, first not in units, gone is None)
    third = units.insert(Unit(health=3))
    stdout.print(first in units, third in units)
