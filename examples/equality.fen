from std.game import IdMap

enum Light:
    Red
    Green

enum Coin:
    Heads
    Tails

def square(n: int):
    n * n

def cube(n: int):
    n * n * n

def main(stdout: Stdout):
    # Sets and dicts are equal when they hold the same things, in any order.
    stdout.print({1, 2} == {2, 1}, {1, 2} == {1, 3}, {1} == {1, 2})
    stdout.print({"a": 1, "b": 2} == {"b": 2, "a": 1}, {"a": 1} == {"a": 2}, {"a": 1} == {"a": 1, "b": 2})

    mut left = IdMap[str]()
    mut right = IdMap[str]()
    left.insert("ash")
    right.insert("ash")
    stdout.print(left == right)
    right.insert("kit")
    stdout.print(left == right)

    # Types, functions and capabilities are equal only to themselves.
    stdout.print(Light == Light, Light == Coin, square == square, square == cube)
    stdout.print(len == len, len == max, stdout == stdout)
    double = n => n * 2
    stdout.print(double == double, double == (n => n * 2))
