# A list in a `shared` value changed where it is, under its lock, with its own value read while it
# changes, and with something else still holding the list as it was, which mustn't see the change.

struct Row:
    tags: list[int]
    name = "a row"

struct Queue:
    items = [1, 2, 3]
    total = 0
    rows = [Row(tags=[1, 2, 3]), Row(tags=[4])]
    kept = list[int]()

    def reading_itself(ref self):
        self.items.append(len(self.items))
        self.items.insert(len(self.items), self.total)
        self.items.extend(self.items)
        self.rows[0].tags.append(len(self.rows[0].tags))
        self.rows[self.total % 2].tags.append(self.rows[1].tags[0])
        self.total += self.items.pop() else 0

    def through_a_call(ref self):
        grow(ref self.items, len(self.items))
        grow(ref self.rows[1].tags, len(self.rows[0].tags))

    def keeping_it(ref self) -> list[int]:
        self.kept = self.items
        self.items.append(100)
        self.kept.append(200)
        return self.kept

    def handing_out(self) -> list[int]:
        return self.items

    def row_kept(ref self) -> Row:
        row = self.rows[0]
        self.rows[0].tags.append(300)
        self.rows[0].name += " changed"
        return row

def grow(ref numbers: list[int], by: int):
    numbers.append(by)
    numbers[0] += by

def main(stdout: Stdout):
    shared queue = Queue()
    lock queue as ref held:
        held.reading_itself()
        stdout.print(held.items, held.total, held.rows[0].tags, held.rows[1].tags)
    lock queue as ref held:
        held.through_a_call()
        stdout.print(held.items, held.rows[1].tags)
    lock queue as ref held:
        out = held.keeping_it()
        stdout.print(out, held.items, held.kept)
    mut mine = list[int]()
    lock queue as held:
        mine = held.handing_out()
    lock queue as ref held:
        held.reading_itself()
        stdout.print(mine, held.items)
    lock queue as ref held:
        row = held.row_kept()
        stdout.print(row.tags, row.name, held.rows[0].tags, held.rows[0].name)
    lock queue as ref held:
        before = held.items
        held.items.append(len(held.items))
        held.items.extend(before)
        held.total += len(before)
        stdout.print(held.items, held.total)
    second = queue
    lock second as ref held:
        held.reading_itself()
    lock queue as held:
        stdout.print(held.items, held.total)
