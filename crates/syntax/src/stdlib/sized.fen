    ## with `int(x)` first.
    def from(x: int) -> i32 fails InvalidValue:
        if x < -2147483648 or x > 2147483647:
            fail InvalidValue(
                message=f"{x} doesn't fit in i32, which holds -2147483648 to 2147483647",
            )
        return i32(x)

    ## The i32 `text` writes, or an `InvalidValue` when it isn't a whole number or doesn't fit.
    def parse(text: str) -> i32 fails InvalidValue:
        return i32.from(int(text)?)?

    ## `self + other`, wrapping round past either end, as an i32's bits do.
    def wrapping_add(self, other: i32) -> i32:
        return i32((int(self) + int(other) + 2147483648) % 4294967296 - 2147483648)

    ## `self - other`, wrapping round past either end, as an i32's bits do.
    def wrapping_sub(self, other: i32) -> i32:
        return i32((int(self) - int(other) + 2147483648) % 4294967296 - 2147483648)

    ## `self * other`, wrapping round past either end, as an i32's bits do.
    def wrapping_mul(self, other: i32) -> i32:
        return i32((int(self) * int(other) + 2147483648) % 4294967296 - 2147483648)

    ## `self + other`, or the nearest end of i32 when it's past one.
    def saturating_add(self, other: i32) -> i32:
        whole = int(self) + int(other)
        if whole < -2147483648: return i32(-2147483648)
        if whole > 2147483647: return i32(2147483647)
        return i32(whole)

    ## `self - other`, or the nearest end of i32 when it's past one.
    def saturating_sub(self, other: i32) -> i32:
        whole = int(self) - int(other)
        if whole < -2147483648: return i32(-2147483648)
        if whole > 2147483647: return i32(2147483647)
        return i32(whole)

    ## `self * other`, or the nearest end of i32 when it's past one.
    def saturating_mul(self, other: i32) -> i32:
        whole = int(self) * int(other)
        if whole < -2147483648: return i32(-2147483648)
        if whole > 2147483647: return i32(2147483647)
        return i32(whole)

extend u8:
    ## The `int` `x` as a u8, or an `InvalidValue` when it doesn't fit. Convert another size
    ## with `int(x)` first.
    def from(x: int) -> u8 fails InvalidValue:
        if x < 0 or x > 255:
            fail InvalidValue(message=f"{x} doesn't fit in u8, which holds 0 to 255")
        return u8(x)

    ## The u8 `text` writes, or an `InvalidValue` when it isn't a whole number or doesn't fit.
    def parse(text: str) -> u8 fails InvalidValue:
        return u8.from(int(text)?)?

    ## `self + other`, wrapping round past either end, as a u8's bits do.
    def wrapping_add(self, other: u8) -> u8:
        return u8((int(self) + int(other)) % 256)

    ## `self - other`, wrapping round past either end, as a u8's bits do.
    def wrapping_sub(self, other: u8) -> u8:
        return u8((int(self) - int(other)) % 256)

    ## `self * other`, wrapping round past either end, as a u8's bits do.
    def wrapping_mul(self, other: u8) -> u8:
        return u8((int(self) * int(other)) % 256)

    ## `self + other`, or the nearest end of u8 when it's past one.
    def saturating_add(self, other: u8) -> u8:
        whole = int(self) + int(other)
        if whole < 0: return u8(0)
        if whole > 255: return u8(255)
        return u8(whole)

    ## `self - other`, or the nearest end of u8 when it's past one.
    def saturating_sub(self, other: u8) -> u8:
        whole = int(self) - int(other)
        if whole < 0: return u8(0)
        if whole > 255: return u8(255)
        return u8(whole)

    ## `self * other`, or the nearest end of u8 when it's past one.
    def saturating_mul(self, other: u8) -> u8:
        whole = int(self) * int(other)
        if whole < 0: return u8(0)
        if whole > 255: return u8(255)
        return u8(whole)

