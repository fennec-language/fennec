## What the words mean. A leading-dot case takes its enum from the type expected where
## it's written, here the return type and a field.

from tokens import Tok

enum ExprKind:
    Int(value: int)
    Name(text: str)
    Negative(inner: Expr)

struct Expr:
    kind: ExprKind

def literal(tok: Tok) -> ExprKind:
    match tok:
        case .Int(value):
            return .Int(value)
        case .Name(text):
            return .Name(text)

def show(expr: Expr) -> str:
    match expr.kind:
        case .Int(value):
            return str(value)
        case .Name(text):
            return text
        case .Negative(inner):
            return "-" + show(inner)

test "the return type picks the enum":
    assert literal(.Int(2)) == .Int(2)
    assert show(Expr(.Negative(Expr(.Name("x"))))) == "-x"
