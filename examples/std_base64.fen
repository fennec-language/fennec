# `std.base64` writes bytes as text and reads them back, as RFC 4648 sets out. `encode` and
# `decode` use the standard alphabet, with `=` filling out the last four characters, as JSON,
# TOML and email do. `url_encode` and `url_decode` use the one that's safe in URLs and file
# names, with `-` and `_` for `+` and `/`, and no `=`.
from std import base64

## A token for a link: random bytes would go here, written so a URL can hold them.
def token(seed: bytes) -> str:
    base64.url_encode(seed)

test "RFC 4648's examples come out as it says, and read back"():
    for text, written in [
        ("", ""),
        ("f", "Zg=="),
        ("fo", "Zm8="),
        ("foo", "Zm9v"),
        ("foob", "Zm9vYg=="),
        ("fooba", "Zm9vYmE="),
        ("foobar", "Zm9vYmFy"),
    ]:
        assert base64.encode(text.encode()) == written
        assert base64.decode(written)? == text.encode()

test "the URL-safe alphabet has no + / or ="():
    data = bytes([251, 255, 191])
    assert base64.encode(data) == "+/+/"
    assert base64.url_encode(data) == "-_-_"
    assert token(bytes([0, 16])) == "ABA"
    assert base64.url_decode("ABA")? == bytes([0, 16])
    assert base64.url_decode("ABA=")? == bytes([0, 16])

test "text that isn't base64 says why"():
    mut problem = failure_of(() => base64.decode("Zm9v!A=="))
    assert problem is not None
    assert problem.message == "`Zm9v!A==` isn't base64: character 5 isn't a base64 digit"
    problem = failure_of(() => base64.decode("Zg"))
    assert problem is not None
    assert problem.message == "`Zg` isn't base64: its length with `=` isn't a multiple of 4"

test "any bytes come back as they were" for numbers: list[int]:
    data = bytes([n % 256 for n in numbers])
    assert base64.decode(base64.encode(data))? == data
    assert base64.url_decode(base64.url_encode(data))? == data

def main(stdout: Stdout):
    stdout.print(base64.encode("Fennec 🦊".encode()), token(bytes([255, 238, 221])))
    stdout.print(base64.decode("RmVubmVj") else bytes([]))
