## A page made by `render`, safe to send: each value in it went where it can't change what the
## page does. One `Html` inside another's template goes in as it is, so pages are built from
## pieces. It's never loaded from saved data, which would let text in that `render` never saw.
export struct Html:
    _text = ""

    ## The page as text, to send.
    def text(self) -> str:
        return self._text

    def str(self, ref out: StrWriter):
        out.write(self._text)

## What a page's template can hold: text, numbers and yes-or-no, each escaped, and pieces made
## by `render`.
export type HtmlValue = str | int | float | bool | Html

## Why a page couldn't be made. Each names the value by how it's written in its `{}`.
export error HtmlError:
    ## A value where escaping can't keep it from changing what the page does: inside a
    ## `<script>` or `<style>`, an `on...` or `style` attribute, an attribute without quotes, a
    ## tag's or an attribute's name, or a comment, or one that would make a link anything but
    ## `http`, `https`, `mailto` or relative.
    Misplaced(expression: str, reason: str)
    ## A value with a format spec, like `{price:.2f}`, which isn't applied yet.
    Formatted(expression: str)
    ## The template ends inside a tag, an attribute or a comment, so it can't go into another.
    Unfinished(reason: str)

    def message(self) -> str:
        match self:
            case .Misplaced(expression, reason):
                return f"`{{{expression}}}` can't go there: {reason}"
            case .Formatted(expression):
                return f"`{{{expression}}}` has a format spec, which a page doesn't apply yet: format it first"
            case .Unfinished(reason):
                return reason

## A page from a template string: `html.render(t"<p>Hello, {name}</p>")`. Each value is put in
## for where it is in the page, found from the text written around it:
## - Between tags and in a quoted attribute, `& < > " '` are escaped, so it stays text.
## - Inside a `<script>` or `<style>`, an `on...`, `style` or `srcdoc` attribute, an attribute
##   without quotes, a tag's or an attribute's name, or a comment, escaping isn't enough, so
##   the page fails with `Misplaced`. A value for a script goes in a `data-` attribute instead.
## - In a link's attribute, like `href` or `src`, a value that would make the link anything but
##   `http`, `https`, `mailto` or relative, like `javascript:`, fails with `Misplaced` too. To
##   show something else instead, check the URL before rendering.
## An `Html` between tags goes in as it is.
export def render(page: Template[HtmlValue]) -> Html fails HtmlError:
    mut scan = PageScan()
    mut out = ""
    for at, piece in enumerate(page.strings):
        for c in piece:
            scan.step(c)
        if scan.refused != "":
            fail misplaced(
                scan.refused,
                reason="a refresh's `url=` has to be `http`, `https` or relative",
            )
        out += piece
        if at < len(page.values):
            expression = page.expressions[at]
            if page.format_specs[at] != "": fail .Formatted(expression=expression)
            out += scan.put(page.values[at], expression)?
    if scan.spot != .Text: fail .Unfinished(reason=f"the template ends {where(scan.spot)}")
    return Html(_text=out)

## Pieces of a page one after another, like the rows of a list made in a loop.
export def join(pieces: list[Html]) -> Html:
    mut out = ""
    for piece in pieces:
        out += piece._text
    return Html(_text=out)

## `text` with `& < > " '` escaped, so it reads as text between tags and in a quoted attribute.
export def escape(text: str) -> str:
    mut out = ""
    for c in text:
        match c:
            case "&":
                out += "&amp;"
            case "<":
                out += "&lt;"
            case ">":
                out += "&gt;"
            case "\"":
                out += "&quot;"
            case "'":
                out += "&#39;"
            case _:
                out += c
    return out

## Where in a page the text written so far has reached, as a browser reads it.
enum PageSpot:
    Text
    ## Just after `<`.
    TagOpen
    ## Just after `</`.
    EndTagOpen
    TagName
    BeforeAttribute
    AttributeName
    AfterAttributeName
    BeforeValue
    DoubleQuoted
    SingleQuoted
    Unquoted
    ## Just after `<!`, before it's known whether it's a comment.
    MarkupOpen
    Comment
    ## `<!DOCTYPE ...>`, `<?...>` and the like.
    Declaration
    ## Inside a `<script>` or `<style>`, read as code until its end tag.
    RawText

## Where `spot` is, in words.
def where(spot: PageSpot) -> str:
    match spot:
        case .Text:
            return "between tags"
        case .TagOpen | .EndTagOpen | .TagName:
            return "in a tag's name"
        case .BeforeAttribute | .AttributeName | .AfterAttributeName | .BeforeValue:
            return "inside a tag"
        case .DoubleQuoted | .SingleQuoted | .Unquoted:
            return "inside an attribute"
        case .MarkupOpen | .Comment | .Declaration:
            return "inside a comment"
        case .RawText:
            return "inside a `<script>` or `<style>`"

## The attributes whose value is a URL that a browser follows or loads.
LINKS = [
    "action", "archive", "background", "cite", "classid", "codebase", "data", "formaction", "href",
    "icon", "longdesc", "manifest", "ping", "poster", "profile", "src", "srcset", "usemap",
    "xlink:href",
]

## SVG's animation elements, whose `to`, `from`, `by` and `values` set another attribute as the
## page runs: `<set attributeName="href" to="...">` makes a link of its value, so those four are
## held to what a link is.
ANIMATIONS = ["set", "animate", "animatemotion", "animatetransform", "animatecolor"]
ANIMATED = ["to", "from", "by", "values"]

## Reads a page's text a character at a time, keeping where it's reached.
struct PageScan:
    spot = PageSpot.Text
    ## The tag being read, in lower case, and whether it's an end tag.
    tag = ""
    closing = False
    ## The attribute being read, in lower case, and its value so far.
    attribute = ""
    value = ""
    ## The element a `RawText` ends with, and what's been read toward its end tag.
    raw = ""
    ending = ""
    ## The last characters of a comment, to find its `-->`, or of `<!`, to find `<!--`.
    tail = ""
    ## How many characters a comment has had, as `<!-->` and `<!--->` end it at once.
    said = 0
    ## Inside a `<script>`: whether a `<!--` has been read, and a `<script` after it, which a
    ## browser reads as the script's escaped and double-escaped states. In the second, `</script>`
    ## doesn't end the script, so a value after it is still in the script.
    escaped = False
    double = False
    ## The last characters read inside a `<script>` or `<style>`, in lower case, to find those.
    recent = ""
    ## For a `<meta>`: whether its `http-equiv` is `refresh`, wherever in the tag it is, its
    ## `content` as written, and the first value put in that `content`. A refresh's `url=` is
    ## checked as a link once the tag ends, when both are known.
    refresh = False
    content = ""
    in_content = ""
    ## A value that turned out, once its tag ended, to be somewhere it can't go.
    refused = ""

    def step(ref self, c: str):
        match self.spot:
            case .Text:
                if c == "<":
                    self.spot = .TagOpen
            case .TagOpen:
                if c == "/":
                    self.spot = .EndTagOpen
                elif c == "!":
                    self.spot = .MarkupOpen
                    self.tail = ""
                elif c == "?":
                    self.spot = .Declaration
                elif is_letter(c):
                    self.start_tag(c, False)
                else:
                    self.spot = .Text
            case .EndTagOpen:
                if is_letter(c):
                    self.start_tag(c, True)
                elif c == ">":
                    self.spot = .Text
                else:
                    self.spot = .Declaration
            case .TagName:
                if is_space(c):
                    self.spot = .BeforeAttribute
                elif c == "/":
                    self.spot = .BeforeAttribute
                elif c == ">":
                    self.end_tag()
                else:
                    self.tag += c.lower()
            case .BeforeAttribute:
                if c == ">":
                    self.end_tag()
                elif not is_space(c) and c != "/":
                    self.spot = .AttributeName
                    self.attribute = c.lower()
            case .AttributeName:
                if c == "=":
                    self.spot = .BeforeValue
                elif is_space(c):
                    self.spot = .AfterAttributeName
                elif c == "/":
                    self.spot = .BeforeAttribute
                elif c == ">":
                    self.end_tag()
                else:
                    self.attribute += c.lower()
            case .AfterAttributeName:
                if c == "=":
                    self.spot = .BeforeValue
                elif c == ">":
                    self.end_tag()
                elif c == "/":
                    self.spot = .BeforeAttribute
                elif not is_space(c):
                    self.spot = .AttributeName
                    self.attribute = c.lower()
            case .BeforeValue:
                self.value = ""
                if c == "\"":
                    self.spot = .DoubleQuoted
                elif c == "'":
                    self.spot = .SingleQuoted
                elif c == ">":
                    self.end_tag()
                elif not is_space(c):
                    self.spot = .Unquoted
                    self.value = c
            case .DoubleQuoted:
                if c == "\"":
                    self.value_ended()
                    self.spot = .BeforeAttribute
                else:
                    self.value += c
            case .SingleQuoted:
                if c == "'":
                    self.value_ended()
                    self.spot = .BeforeAttribute
                else:
                    self.value += c
            case .Unquoted:
                if is_space(c):
                    self.value_ended()
                    self.spot = .BeforeAttribute
                elif c == ">":
                    self.value_ended()
                    self.end_tag()
                else:
                    self.value += c
            case .MarkupOpen:
                self.tail += c
                if self.tail == "--":
                    self.spot = .Comment
                    self.tail = ""
                    self.said = 0
                elif c == ">":
                    self.spot = .Text
                elif not "--".startswith(self.tail):
                    self.spot = .Declaration
            case .Comment:
                self.said += 1
                self.tail = (self.tail + c)[-4:]
                # `-->` ends it, and so do `--!>`, and `>` or `->` straight after `<!--`, as a
                # browser reads them.
                ends = self.tail.endswith("-->") or self.tail.endswith("--!>")
                if (
                    ends
                    or (c == ">" and (self.said == 1 or (self.said == 2 and self.tail == "->")))
                ):
                    self.spot = .Text
            case .Declaration:
                if c == ">":
                    self.spot = .Text
            case .RawText:
                self.read_raw(c)

    def start_tag(ref self, c: str, closing: bool):
        self.spot = .TagName
        self.tag = c.lower()
        self.closing = closing
        self.refresh = False
        self.content = ""
        self.in_content = ""

    ## An attribute's value has ended: a `<meta>` keeps what it needs of it.
    def value_ended(ref self):
        if self.tag != "meta": return
        if self.attribute == "http-equiv":
            self.refresh = self.value.strip().lower() == "refresh"
        elif self.attribute == "content":
            self.content = self.value

    ## A tag's `>`: a `<script>` or `<style>` starts text read as code, until its end tag. A
    ## `<meta>` refresh with a value in its `content` has its `url=` checked as a link.
    def end_tag(ref self):
        if (
            self.tag == "meta"
            and self.refresh
            and self.in_content != ""
            and not refreshes_safely(self.content)
        ):
            self.refused = self.in_content
        if not self.closing and (self.tag == "script" or self.tag == "style"):
            self.spot = .RawText
            self.raw = self.tag
            self.ending = ""
            self.escaped = False
            self.double = False
            self.recent = ""
        else:
            self.spot = .Text

    ## A character inside a `<script>` or `<style>`, watching for `</script` or `</style`
    ## followed by a space, `/` or `>`, in any case.
    def read_raw(ref self, c: str):
        if self.raw == "script" and self.read_escapes(c): return
        wanted = "</" + self.raw
        if len(self.ending) == len(wanted):
            if is_space(c) or c == "/" or c == ">":
                self.closing = True
                self.tag = self.raw
                if c == ">":
                    self.spot = .Text
                else:
                    self.spot = .BeforeAttribute
                return
            self.ending = ""
        grown = self.ending + c.lower()
        if wanted.startswith(grown):
            self.ending = grown
        else:
            self.ending = "<" if c == "<" else ""

    ## Keeps a `<script>`'s escaped and double-escaped states, as WHATWG's tokenizer does, and
    ## says whether `c` was taken by them: a `</script>` in the double-escaped state only goes
    ## back to the escaped one, without ending the script.
    def read_escapes(ref self, c: str) -> bool:
        before = self.recent
        self.recent = (before + c.lower())[-10:]
        delimiter = is_space(c) or c == "/" or c == ">"
        if not self.escaped:
            if self.recent.endswith("<!--"):
                self.escaped = True
            return False
        if self.recent.endswith("-->"):
            self.escaped = False
            self.double = False
            return False
        if not self.double:
            if delimiter and before.endswith("<script"):
                self.double = True
            return False
        if delimiter and before.endswith("</script"):
            self.double = False
        self.ending = ""
        return True

    ## What a value becomes where the text has reached, or why it can't go there.
    def put(ref self, value: HtmlValue, expression: str) -> str fails HtmlError:
        match self.spot:
            case .Text:
                text = text_of(value)
                return text if value is Html else escape(text)
            case .DoubleQuoted | .SingleQuoted:
                name = self.attribute
                if name.startswith("on"):
                    fail misplaced(
                        expression,
                        reason="an `on...` attribute runs its value as a script",
                    )
                if name == "style":
                    fail misplaced(expression, reason="a `style` attribute reads its value as CSS")
                if name == "srcdoc":
                    fail misplaced(
                        expression,
                        reason="a `srcdoc` attribute reads its value as a page",
                    )
                if self.tag == "meta" and name == "http-equiv":
                    fail misplaced(
                        expression,
                        reason="a `<meta>`'s `http-equiv` says what the page does, so it's written in the template",
                    )
                if self.tag == "meta" and name == "content" and self.in_content == "":
                    self.in_content = expression
                text = text_of(value)
                linked = name in LINKS or (self.tag in ANIMATIONS and name in ANIMATED)
                if linked and not followed(self.value, next=text):
                    fail misplaced(
                        expression,
                        reason="a link has to be `http`, `https`, `mailto` or relative",
                    )
                self.value += text
                return escape(text)
            case .Unquoted | .BeforeValue:
                fail misplaced(
                    expression,
                    reason="an attribute's value without quotes ends at a space; put it in quotes",
                )
            case .RawText:
                fail misplaced(
                    expression,
                    reason="text inside a `<script>` or `<style>` is code; pass it in a `data-` attribute",
                )
            case .MarkupOpen | .Comment | .Declaration:
                fail misplaced(expression, reason="a comment would end at its first `-->`")
            case _:
                fail misplaced(
                    expression,
                    reason="it would be part of a tag's or an attribute's name",
                )

def misplaced(expression: str, reason: str) -> HtmlError:
    return HtmlError.Misplaced(expression=expression, reason=reason)

## A value's text, before escaping.
def text_of(value: HtmlValue) -> str:
    # Text is what's none of the others.
    mut found = ""
    if value is Html:
        found = value._text
    if value is str:
        found = value
    if value is int:
        found = str(value)
    if value is float:
        found = str(value)
    if value is bool:
        found = "True" if value else "False"
    return found

## Whether a link whose value so far is `before`, with `next` after it, is one a browser can follow
## safely: relative, or `http`, `https` or `mailto`. Once the value so far has a `:`, `/`, `?`
## or `#`, its scheme is settled by what came before, and nothing after can change it.
def followed(before: str, next: str) -> bool:
    for c in before:
        if c == ":" or c == "/" or c == "?" or c == "#": return True
    # A browser passes over spaces and control characters at the start, and tabs and line breaks
    # anywhere in a URL, so they're passed over here too.
    mut scheme = ""
    for c in before + next:
        if c == ":":
            lowered = scheme.lower()
            return lowered == "http" or lowered == "https" or lowered == "mailto"
        if c == "/" or c == "?" or c == "#": return True
        if c == "\t" or c == "\n" or c == "\r": continue
        if scheme == "" and c <= " ": continue
        scheme += c
    return True

## Whether a `<meta>` refresh's `content`, like `5; url=/next`, goes somewhere a browser can go
## safely: `http`, `https` or relative. A refresh can't be a `mailto:`, which `followed` allows.
def refreshes_safely(content: str) -> bool:
    mut at = 0
    while at < len(content) and content[at] != ";" and content[at] != ",":
        at += 1
    mut url = content[at + 1:].strip()
    if url.lower().startswith("url"):
        rest = url[3:].strip()
        if rest.startswith("="):
            url = rest[1:].strip()
    if url.startswith("'") or url.startswith("\""):
        url = url[1:]
    if not followed("", next=url): return False
    return not url.strip().lower().startswith("mailto:")

def is_letter(c: str) -> bool:
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z")

def is_space(c: str) -> bool:
    return c == " " or c == "\t" or c == "\n" or c == "\r" or c == "\x0c"
