## Comprehensions that call helper functions: spectral norm written with comprehensions, the way the
## plain version's loops would often be written.

from std.math import sqrt

def a(i: int, j: int) -> float:
    1.0 / float((i + j) * (i + j + 1) // 2 + i + 1)

def row(v: list[float], i: int, transpose: bool) -> float:
    mut total = 0.0
    mut j = 0
    for x in v:
        total += (a(j, i) if transpose else a(i, j)) * x
        j += 1
    total

def times(v: list[float], transpose: bool) -> list[float]:
    [row(v, i, transpose) for i in range(v.len())]

def times_transposed(v: list[float]) -> list[float]:
    times(times(v, False), True)

def main(stdout: Stdout):
    n = 100
    mut u = [1.0 for _ in range(n)]
    mut v = [0.0 for _ in range(n)]
    for _ in range(300):
        v = times_transposed(u)
        u = times_transposed(v)
    mut vbv = 0.0
    mut vv = 0.0
    for i in range(n):
        vbv += u[i] * v[i]
        vv += v[i] * v[i]
    stdout.print(f"{sqrt(vbv / vv):.9f}")
