# decision: `Table` and `Id[T]` are the way to point at things.

from std.collections import Id, Table
from std.math import Vec3

type EnemyId = Id[Enemy]

struct Enemy:
    position: Vec3
    velocity = Vec3.zero
    health = 100

    def take_damage(ref self, amount: int):
        self.health -= amount

struct World:
    enemies = Table[Enemy]()
    player = Vec3.zero

error TargetGone:
    target: EnemyId

error OutOfRange:
    distance: float

# A game's update loop walks its `Table` in place, so it makes nothing and can be `@hot`.
@hot
def step(ref world: World, dt: float):
    for ref enemy in world.enemies:
        enemy.position += enemy.velocity * dt

## Deals 10 damage to `target`, failing if it's gone or more than 5 away from the player.
export def attack(ref world: World, target: EnemyId) fails OutOfRange | TargetGone:
    mut enemy = world.enemies.get(target)
    if enemy is None: fail TargetGone(target)
    distance = (enemy.position - world.player).length()
    if distance > 5.0: fail OutOfRange(distance)
    enemy.take_damage(10)
    world.enemies[target] = enemy

def main(stdout: Stdout):
    mut world = World()
    near = world.enemies.add(Enemy(position=Vec3(x=3.0, y=4.0), velocity=Vec3(x=-1.0)))
    far = world.enemies.add(Enemy(position=Vec3(x=10.0)))

    attack(ref world, near) except why:
        stdout.print(why)
    attack(ref world, far) except why:
        stdout.print(why)
    stdout.print(world.enemies[near].health)

    step(ref world, 2.0)
    stdout.print(world.enemies[near].position)

    _ = world.enemies.modify(far, foe => foe.take_damage(25))
    stdout.print(world.enemies[far].health)

    _ = world.enemies.remove(near)
    attack(ref world, near) except why:
        stdout.print(why)
    stdout.print(len(world.enemies), world.enemies.get(near))

    weakest = min(world.enemies.values(), key=enemy => enemy.health)
    stdout.print(weakest.health)

test "attacking a distant enemy fails":
    mut world = World()
    far = world.enemies.add(Enemy(position=Vec3(x=10.0, y=0.0, z=0.0)))
    assert attack(ref world, far) fails OutOfRange(distance=10.0)

test "attacking a removed enemy fails":
    mut world = World()
    id = world.enemies.add(Enemy(position=Vec3.zero))
    _ = world.enemies.remove(id)
    assert attack(ref world, id) fails TargetGone(id)

test "update replaces a live enemy, and leaves a removed one's Id alone"():
    mut world = World()
    id = world.enemies.add(Enemy(position=Vec3.zero))
    moved = Enemy(position=Vec3(x=1.0, y=0.0, z=0.0))
    assert world.enemies.update(id, moved)
    assert world.enemies[id].position.x == 1.0
    _ = world.enemies.remove(id)
    assert not world.enemies.update(id, moved)
    assert len(world.enemies) == 0
