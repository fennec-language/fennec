---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import fennec from '../fennec.tmLanguage.json';

const base = import.meta.env.BASE_URL;
const themes = { light: 'vitesse-light', dark: 'vitesse-dark' } as const;

const hero = `struct Enemy {
  position: Vec3
  velocity: Vec3
  health: i32
}

error CombatError {
  TargetGone(target: Id<Enemy>)
  OutOfRange(distance: f32)
}

noalloc fn step(inout world: World, dt: f32) {
  for enemy in world.enemies.iterMut() {
    enemy.position += enemy.velocity * dt
  }
}

fn attack(inout world: World, target: Id<Enemy>) -> Result<Void, CombatError> {
  const enemy = world.enemies.get(target) ?? return Err(.TargetGone(target))
  const distance = (enemy.position - world.player).length()
  if distance > 5.0 {
    return Err(.OutOfRange(distance))
  }
  world.enemies.modify(target, enemy => enemy.health -= 10)
  Ok()
}

test "attacking a distant enemy fails" {
  let world = World.empty()
  const far = world.enemies.insert(Enemy.at(Vec3(x: 10.0, y: 0.0, z: 0.0)))
  assert attack(inout world, far) == Err(.OutOfRange(10.0))
}`;

const pillars = [
  {
    title: 'Instant iteration',
    body: 'Development builds skip the slow parts. Your code runs through an interpreter and a fast compiler, while dependencies are built once and cached for every project.',
  },
  {
    title: 'Full speed when it ships',
    body: 'Release builds go through a heavy optimizing compiler. The goal is to land within a few percent of hand-tuned native code, and a benchmark suite holds us to it.',
  },
  {
    title: 'Safe by default',
    body: 'No null, no data races, no unchecked memory access. Unsafe code exists only at the boundary with C, in marked files, with a written reason.',
  },
  {
    title: 'Readable and fast by default',
    body: 'Mutation is marked where it happens. Allocations and copies are visible in the code. The obvious way to write something is also the fast way.',
  },
  {
    title: 'Written well by AI',
    body: 'A familiar, TypeScript-shaped syntax with one way to do each thing, guardrails for the mistakes models make, and errors that tell a model how to fix them.',
  },
  {
    title: 'Made for games',
    body: 'No garbage collector and no hidden allocation. Mark a function noalloc and the compiler proves it never allocates, so your frame loop stays smooth.',
  },
];

const readable = [
  {
    code: `applyDamage(inout player, 10)   // player changes
describe(player)                // guaranteed not to`,
    title: 'You can see what changes',
    body: 'Values are immutable unless you say otherwise. A function that mutates its argument says inout in its signature, and so does every call to it.',
  },
  {
    code: `const total = hits.map(hit => hit.damage).sum()   // no allocation
const names = players.map(p => p.name).toList()    // allocates, and says so`,
    title: 'You can see what costs',
    body: 'Iterator chains compile down to plain loops. Building a new collection, copying heap data and allocating are always visible in the code.',
  },
  {
    code: `noalloc fn update(inout world: World, dt: f32) {
  world.particles.removeWhere(p => p.life <= 0.0)
}`,
    title: 'You can prove what matters',
    body: 'noalloc is checked through every call, so a stray allocation in the frame loop is a compile error, not a stutter you find in profiling.',
  },
];
---

<Base title="Fennec" description="Fennec is a safe, compiled language for games and tools: fast to iterate on, fast when it ships, and designed for people and AI to write readable, fast code by default.">
  <section class="hero wrap">
    <img class="hero-logo" src={`${base}brand/fennec-logo-480.webp`} alt="Fennec logo: a geometric fennec fox head with large ears" width="168" height="168" />
    <span class="pill">Early design: no compiler yet</span>
    <h1>Fennec</h1>
    <p class="tagline">Fast to write. Fast to build. Fast to run.</p>
    <p class="lede">
      A safe, compiled language for games and tools. Designed so that the easy way to write something is also the readable way and
      the fast way, for people and for the AI they work with.
    </p>
    <div class="actions">
      <a class="button primary" href={`${base}tour/`}>Take the tour →</a>
      <a class="button" href={`${base}why/`}>Why Fennec</a>
    </div>
  </section>

  <section class="wrap sample">
    <div class="window">
      <div class="window-bar">
        <span></span><span></span><span></span>
        <em>combat.fen · proposed syntax</em>
      </div>
      <Code code={hero} lang={fennec} themes={themes} />
    </div>
  </section>

  <section class="wrap section">
    <h2>What makes it Fennec</h2>
    <div class="grid">
      {
        pillars.map((pillar) => (
          <article class="card">
            <h3>{pillar.title}</h3>
            <p>{pillar.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap section">
    <h2>Read it, and you know what it does</h2>
    <p class="section-lede">Most bugs and most slowdowns hide in code that does more than it looks like it does. Fennec puts it on the page.</p>
    <div class="rows">
      {
        readable.map((row) => (
          <div class="row">
            <div class="row-text">
              <h3>{row.title}</h3>
              <p>{row.body}</p>
            </div>
            <Code code={row.code} lang={fennec} themes={themes} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap section">
    <h2>Two speeds, on purpose</h2>
    <p class="section-lede">
      Developing and shipping are different jobs. Fennec doesn't make one build do both.
    </p>
    <div class="speeds">
      <div class="card">
        <span class="label">While you work</span>
        <h3>Optimized for your time</h3>
        <p>Changed code runs in an interpreter right away, hot functions get compiled in the background, and dependencies come prebuilt from a shared cache with a size cap.</p>
      </div>
      <div class="card">
        <span class="label">When you ship</span>
        <h3>Optimized for runtime</h3>
        <p>Every generic specialized, everything inlined across modules, and aliasing guarantees from the language passed to the optimizer. Slower to build, as fast as it gets to run.</p>
      </div>
    </div>
    <p><a href={`${base}speed/`}>How the two speeds work →</a></p>
  </section>

  <section class="wrap section">
    <div class="status card">
      <h2>Where things stand</h2>
      <p>
        Fennec is in early design. This site describes where the language is going, and the syntax will change as real programs push on
        it. The first milestone is a parser, type checker and interpreter that can run the examples on this site.
      </p>
      <div class="actions">
        <a class="button" href={`${base}roadmap/`}>See the roadmap</a>
        <a class="button" href="https://github.com/seashell86/fennec">Follow on GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 3.5rem;
    padding-bottom: 2.5rem;
  }

  .hero-logo {
    width: 168px;
    height: 168px;
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: clamp(3rem, 9vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 1rem 0 0.5rem;
  }

  .tagline {
    font-size: clamp(1.25rem, 3.4vw, 1.6rem);
    font-weight: 600;
    margin: 0 0 1rem;
    color: var(--accent);
  }

  .lede {
    max-width: 640px;
    font-size: 1.15rem;
    color: var(--muted);
    margin: 0 0 1.75rem;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .sample {
    max-width: 900px;
  }

  .window {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--code-bg);
    overflow: hidden;
    box-shadow: 0 18px 50px -24px rgb(27 26 46 / 0.35);
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .window-bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border);
  }

  .window-bar em {
    margin-left: 0.6rem;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .window :global(pre.astro-code) {
    border: 0;
    border-radius: 0;
    margin: 0;
  }

  .section {
    margin-top: 5rem;
  }

  .section h2 {
    font-size: clamp(1.7rem, 4vw, 2.2rem);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 0.75rem;
  }

  .section-lede {
    color: var(--muted);
    max-width: 640px;
    margin: 0 0 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .card {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
  }

  .card h3 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }

  .card p {
    margin: 0;
    color: var(--muted);
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .row {
      grid-template-columns: 5fr 7fr;
      gap: 2.5rem;
    }
  }

  .row h3 {
    margin: 0 0 0.4rem;
    font-size: 1.2rem;
  }

  .row p {
    margin: 0;
    color: var(--muted);
  }

  .row :global(pre.astro-code) {
    margin: 0;
  }

  .speeds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .label {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .status {
    text-align: center;
    padding: 2.5rem 1.5rem;
  }

  .status p {
    max-width: 620px;
    margin: 0 auto 1.5rem;
  }
</style>
