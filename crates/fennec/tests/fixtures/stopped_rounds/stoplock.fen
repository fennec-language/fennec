# A round's handler takes a lock, then sleeps, when the serving task's block ends and stops it: a
# lock is never held across a wait, so a lock's wait always ends, and the sleep is cut short.
from std.concurrent import Crashed
from std.net import NetError, Request, Response, Server

struct Tally:
    seen: int

def answered(request: Request, tally: shared Tally, clock: Clock, stdout: Stdout) -> Response:
    if request.path == "/slow":
        lock tally as ref held:
            held.seen += 1
        stdout.print("the slow one counted")
        clock.sleep(2h)
        stdout.print("the slow one never said")
    return Response(status=200, body=f"hello {request.path}".encode())

def serving(server: Server, tally: shared Tally, clock: Clock, stdout: Stdout):
    server.serve((request) => answered(request, tally=tally, clock=clock, stdout=stdout))
    stdout.print("the server never said")

def main(net: Net, clock: Clock, stdout: Stdout) fails NetError | Crashed:
    shared tally = Tally(seen=0)
    with net.listen(0)? as server:
        port = server.port
        with net.connect("127.0.0.1", port)? as slow:
            slow.write("GET /slow HTTP/1.1\r\nhost: here\r\n\r\n")?
            with launch(() => serving(server, tally=tally, clock=clock, stdout=stdout), stop_after=100ms)?:
                got = net.get(f"http://127.0.0.1:{port}/one")?
                stdout.print(got.text())
    lock tally as held:
        stdout.print("the server is over", held.seen)
