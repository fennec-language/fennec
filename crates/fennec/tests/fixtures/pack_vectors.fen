# The test vectors of docs/pack.md, in the order its table lists them: the header `pack.dumps`
# writes ahead of each value.
from std import pack
from std.collections import Deque
from std.time import Time

struct Point:
    x: int
    y: int

struct Note:
    text: str
    @serialize(name="when")
    at: int
    @skip
    seen = 0

enum Shape:
    Dot
    Circle(radius: float)

struct Node:
    name: str
    children: list[Node]

struct Pair[T]:
    first: T
    second: T

struct Cell:
    held: int | str

struct Chain[T]:
    value: T
    links: list[Chain[T]]

## Saves itself its own way, so it's shaped by its name alone.
struct Money:
    cents: int

    def serialize(self, ref out: Serializer):
        out.int(self.cents)

    def deserialize(ref src: Deserializer) -> Self fails ParseError:
        return Money(cents=src.int()?)

## The header `pack.dumps` wrote before `data`'s value: its shape hash as the bytes hold it, low
## byte first, and its layout.
def header(data: bytes) -> str:
    magic = data[0:4].decode() except why:
        return why.message
    mut length = 0
    mut shift = 0
    mut at = 12
    while True:
        byte = data[at]
        length += (byte & 127) << shift
        at += 1
        if byte < 128: break
        shift += 7
    layout = data[at:at + length].decode() except why:
        return why.message
    return f"{magic} {data[4:12].hex()} {layout}"

def main(stdout: Stdout):
    stdout.print(header(pack.dumps(7)))
    stdout.print(header(pack.dumps("fox")))
    stdout.print(header(pack.dumps(True)))
    stdout.print(header(pack.dumps(1.5)))
    stdout.print(header(pack.dumps(f32(1.5))))
    stdout.print(header(pack.dumps(bytes([1, 2]))))
    stdout.print(header(pack.dumps([1, 2])))
    stdout.print(header(pack.dumps({"a": 1})))
    stdout.print(header(pack.dumps((1, "a"))))
    stdout.print(header(pack.dumps(Cell(held="a"))))
    stdout.print(header(pack.dumps(Point(x=1, y=2))))
    stdout.print(header(pack.dumps(Note(text="hi", at=3))))
    stdout.print(header(pack.dumps(Shape.Circle(radius=1.0))))
    stdout.print(header(pack.dumps(Node(name="root", children=[]))))
    stdout.print(header(pack.dumps(Pair[int](first=1, second=2))))
    stdout.print(header(pack.dumps(Chain[int](value=1, links=[]))))
    stdout.print(header(pack.dumps(Deque.of([1, 2]))))
    stdout.print(header(pack.dumps(Time(nanos=0))))
    stdout.print(header(pack.dumps(Money(cents=5))))
