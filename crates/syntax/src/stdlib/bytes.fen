## `bytes`'s methods written in Fennec.
extend bytes:
    ## Writes the bytes for `json.dumps`, `pack.dumps` and the rest, which call it. JSON writes them as
    ## base64 text.
    ## ```fennec
    ## from std import json
    ## assert json.dumps("hi".encode()) == "\"aGk=\""
    ## ```
    def serialize(self, ref out: Serializer):
        out.bytes(self)

    ## Reads bytes for `json.loads`, `pack.loads` and the rest, which call it.
    ## ```fennec
    ## from std import json
    ## assert json.loads[bytes]("\"aGk=\"")? == "hi".encode()
    ## ```
    def deserialize(ref src: Deserializer) -> bytes fails ParseError:
        return src.bytes()?

## `bytes`' methods the compiler gives. Each is declared here for its signature and its doc, and a
## test holds it to the checker's own.
extend bytes:
    ## How many bytes there are.
    @intrinsic
    def len(self) -> int

    ## The bytes read as UTF-8 text. Bytes that aren't UTF-8 fail with an `InvalidValue`.
    @intrinsic
    def decode(self) -> str fails InvalidValue

    ## Each byte as two lower-case hex digits, with `sep` between each two, given by position, as
    ## `data.hex(":")`. With none, as `data.hex()`, the digits run together.
    @intrinsic
    def hex(self, sep: str) -> str
