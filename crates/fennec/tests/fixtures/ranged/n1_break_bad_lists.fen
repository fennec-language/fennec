# A bucket loop left by `break` inside a loop over the buckets, with a bucket list that's in range
# and then one that isn't: past the end in the test's read, the first read of a turn.
def scan(starts: list[int], order: list[int], wanted: int) -> int:
    mut total = 0
    for cell in range(len(starts) - 1):
        for at in range(starts[cell], starts[cell + 1]):
            if order[at] == wanted:
                total += order[at] * 100
                break
            total += order[at]
    return total

def main(stdout: Stdout):
    stdout.print(scan([0, 2, 5], order=[1, 2, 3, 4, 5], wanted=4))
    stdout.print(scan([0, 2, 5], order=[1, 2, 3, 4, 5], wanted=9))
    stdout.print(scan([0, 2, 7], order=[1, 2, 3, 4, 5], wanted=3))
    stdout.print(scan([0, 2, 7], order=[1, 2, 3, 4, 5], wanted=9))
