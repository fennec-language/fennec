# A constant is worked out once and kept for the whole run, whatever kind of value it is: a string
# worked out into a block, an optional that holds a list, an optional string, one of each that's
# missing, and a tuple holding them. Each is read more than once, and the run ends holding nothing
# but what it keeps.

def joined(count: int) -> str:
    mut text = "a text long enough for a block of its own"
    for at in range(count):
        text += f" {at}"
    return text

def numbers(count: int) -> list[int]?:
    if count > 100:
        return None
    return [count, count + 1]

def named(count: int) -> str?:
    if count > 100:
        return None
    return joined(count)

TEXT = joined(3)
NUMBERS = numbers(2)
NO_NUMBERS = numbers(200)
NAMED = named(2)
NOT_NAMED = named(200)
SHORT = named(0) else "nothing"
PAIR = (joined(1), numbers(5), named(1))

def size(round: int) -> int:
    counted = NUMBERS else []
    name = NAMED else ""
    return len(TEXT) + len(counted) + len(name) + round

def main(stdout: Stdout):
    for round in range(2):
        stdout.print(TEXT)
        stdout.print(NUMBERS, NO_NUMBERS, NAMED, NOT_NAMED)
        stdout.print(SHORT, PAIR)
    stdout.print([size(round) for round in [1, 2, 3]])
    return
