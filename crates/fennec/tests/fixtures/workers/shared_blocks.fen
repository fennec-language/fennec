# `shared` values holding blocks, changed from every worker: by method, by `with`, read, given
# strings and lists from outside, handing them back, through what holds a handle, and with a
# constant and a long literal stored inside. What crosses a lock's edge is copied, and everything
# a value holds has to stay readable from every thread, or these come out wrong.

DEFAULTS = ["one with a really rather long string in it", "two"]

struct Point:
    x: int
    name: str

struct Unit:
    x: int

shared Log:
    lines = list[str]()
    count = 0
    name = "a log with a long enough name to have a block"
    seen = {"start": 0}

    def add(mut self, line: str):
        self.lines.append(line)
        self.count += 1
        self.seen[line] = self.count

    def size(self) -> int:
        self.lines.len()

shared Board:
    points = [Point(x=0, name="the very first point on this board")]
    best = Point(x=0, name="the best point on this board so far")

    def put(mut self, point: Point):
        self.points.append(point)
        if point.x > self.best.x:
            self.best = point

    def top(self) -> Point:
        self.best

shared Table:
    rows = list[str]()
    kept = list[str]()

    def fill(mut self):
        self.rows = DEFAULTS
        self.kept.append("a literal that is much too long to fit inside a header")

    def rows_now(self) -> list[str]:
        self.rows

shared Grid:
    cells = [[1, 2], [3, 4]]
    maybe: int? = None

    def bump(mut self, row: int, by: list[int]):
        self.cells[row].append(by[0])
        self.cells[row][0] += by.len()
        self.maybe = self.cells[row].len()

shared Box:
    items = [1, 2, 3]
    total = 0

shared Purse:
    notes = list[str]()
    total = 0
    biggest = Point(x=0, name="the biggest note so far in this purse")

struct Holder:
    box: Box
    name: str

def touch(holder: Holder, n: int) -> int:
    with holder.box as mut held:
        held.items[0] = n
        held.total += 1
    holder.box.total * 0 + holder.name.len()

def units_of(count: int) -> list[Unit]:
    [Unit(n) for n in range(count)]

def logs(stdout: Stdout):
    log = Log()
    mut units = units_of(4000)
    for mut unit in parallel(units):
        log.add(f"unit number {unit.x} with a long line of text here")
        unit.x = log.size() % 1 + unit.x
    stdout.print(log.count, log.lines.len(), log.size(), log.seen.len())
    stdout.print(log.name, sum(unit.x for unit in parallel(units)))

def boards(stdout: Stdout):
    board = Board()
    mut units = units_of(3000)
    for mut unit in parallel(units):
        board.put(Point(x=unit.x, name=f"point {unit.x} with a long enough name"))
        kept = board.top()
        unit.x = kept.x % 1 + unit.x
    stdout.print(board.points.len(), board.top().x, board.best.name)
    stdout.print(sum(unit.x for unit in parallel(units)))

def tables(stdout: Stdout):
    table = Table()
    mut units = units_of(2000)
    for mut unit in parallel(units):
        table.fill()
        unit.x += table.rows_now().len()
    stdout.print(table.rows, table.kept.len(), DEFAULTS.len())
    stdout.print(sum(unit.x for unit in parallel(units)))

def grids(stdout: Stdout):
    grid = Grid()
    given = [5, 6, 7]
    mut units = units_of(2000)
    for mut unit in parallel(units):
        grid.bump(unit.x % 2, given)
        unit.x += given.len()
    stdout.print(grid.cells[0].len(), grid.cells[1].len(), grid.cells[0][0], grid.maybe, given)
    stdout.print(sum(unit.x for unit in parallel(units)))

def holders(stdout: Stdout):
    one = Box()
    two = Box()
    held = [
        Holder(box=one, name="the first holder of them all, quite long"),
        Holder(box=two, name="b"),
    ]
    mut units = units_of(2000)
    for mut unit in parallel(units):
        unit.x += touch(held[unit.x % 2], unit.x)
    stdout.print(one.total, two.total, held[0].box.total)
    stdout.print(sum(unit.x for unit in parallel(units)))
    mut both = 0
    with one, two as x, y:
        both = x.items.len() + y.items.len()
    stdout.print(both)

def passed_along(from_purse: Purse, to_purse: Purse, n: int):
    with from_purse, to_purse as mut source, mut target:
        made = f"a note made here, long enough to be a block {n}"
        source.notes.append(made)
        source.total += 1
        target.notes = [note for note in source.notes if note.len() % 2 == 0]
        target.total += source.notes.len() % 1
        if n > source.biggest.x:
            source.biggest = Point(x=n, name=f"the biggest note, number {n}, in this purse")
            target.biggest = source.biggest
        source.notes = [made]

def read_across(mine: Purse, other: Purse) -> int:
    mut seen = 0
    with mine, other as mut held, looked:
        held.notes = looked.notes
        seen = held.notes.len() % 1
    seen

def purses(stdout: Stdout):
    one = Purse()
    two = Purse()
    mut units = units_of(2000)
    for mut unit in parallel(units):
        if unit.x % 2 == 0:
            passed_along(one, two, unit.x)
        else:
            passed_along(two, one, unit.x)
        unit.x += read_across(one, two)
    stdout.print(one.total + two.total, one.biggest.x, two.biggest.x, one.biggest.name)
    # How many there are depends on the order the bodies ran in; what each one says doesn't.
    damaged = [note for note in one.notes + two.notes if note[0:6] != "a note"]
    stdout.print(damaged, sum(unit.x for unit in parallel(units)))

def main(stdout: Stdout):
    logs(stdout)
    purses(stdout)
    boards(stdout)
    tables(stdout)
    grids(stdout)
    holders(stdout)
